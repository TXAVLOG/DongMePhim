{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".astro"
  ],
  "compilerOptions": {
    "types": [
      "./worker-configuration.d.ts",
      "node",
      "astro/client"
    ],
    "paths": {
      "@components/*": [
        "./src/frontend/components/*"
      ],
      "@layouts/*": [
        "./src/frontend/layouts/*"
      ],
      "@styles/*": [
        "./src/frontend/styles/*"
      ],
      "@templates/*": [
        "./src/frontend/templates/*"
      ],
      "@services/*": [
        "./src/backend/services/*"
      ],
      "@apptypes/*": [
        "./src/backend/types/*"
      ],
      "@lib/*": [
        "./src/backend/lib/*"
      ],
      "@data/*": [
        "./src/backend/data/*"
      ]
    }
  }
}