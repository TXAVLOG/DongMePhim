{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-18",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "webfilm",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"10 6 * * *",
			"*/15 5-16 * * *",
			"0 17 * * *",
			"0 0 * * *",
			"15 18 * * *"
		]
	}
}