---
interface Props {
  activeTab: string;
}

const { activeTab } = Astro.props;

const tabs = [
  { id: 'general', href: '/admin/cai-dat', label: 'Chung', icon: 'settings' },
  { id: 'api-ser', href: '/admin/cai-dat/api-ser', label: 'API Security', icon: 'security' },
  { id: 'app-mobile', href: '/admin/cai-dat/app-mobile', label: 'App Mobile', icon: 'smartphone' },
  { id: 'smtp', href: '/admin/cai-dat/smtp', label: 'SMTP Mail', icon: 'mail' },
  { id: 'telegram', href: '/admin/cai-dat/telegram', label: 'Telegram', icon: 'send' },
  { id: 'dang-ky', href: '/admin/cai-dat/dang-ky', label: 'Đăng nhập & Đăng ký', icon: 'login' },
  { id: 'social', href: '/admin/cai-dat/social', label: 'Mạng xã hội', icon: 'share' },
  { id: 'payment', href: '/admin/cai-dat/thanh-toan', label: 'Cấu hình Thanh toán', icon: 'payments' },
  { id: 'turnstile', href: '/admin/cai-dat/turnstile', label: 'Turnstile Captcha', icon: 'verified_user' },
  { id: 'quang-cao', href: '/admin/cai-dat/quang-cao', label: 'Cấu hình Quảng cáo', icon: 'featured_video' },
];
---

<div class="lg:col-span-1 flex flex-col gap-2">
  {tabs.map((tab) => (
    <a
      href={tab.href}
      class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${
        activeTab === tab.id
          ? 'sidebar-active text-primary font-bold'
          : 'hover:bg-white/5 text-text-dim'
      }`}
    >
      <span class="material-symbols-outlined">{tab.icon}</span>
      <span>{tab.label}</span>
    </a>
  ))}
</div>
