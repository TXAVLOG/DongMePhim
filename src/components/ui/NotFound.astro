---
// src/components/ui/NotFound.astro
import { Button } from './Button';
---

<main class="min-h-[70vh] flex items-center justify-center relative px-gutter py-24 select-none overflow-hidden w-full">
  <!-- Background Cinematic Glows -->
  <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute w-[400px] h-[400px] rounded-full bg-primary/10 blur-[80px] top-1/4 left-1/4"></div>
      <div class="absolute w-[500px] h-[500px] rounded-full bg-secondary-container/10 blur-[100px] bottom-1/4 right-1/4"></div>
  </div>
  
  <!-- 404 Card -->
  <div class="relative z-10 max-w-xl w-full text-center glass-card bg-surface-card/60 border border-glass-stroke rounded-[32px] p-8 sm:p-12 shadow-[0_0_50px_rgba(0,0,0,0.4)] backdrop-blur-2xl space-y-8 flex flex-col items-center">
    
    <!-- Spilled Cinema Reel / Popcorn Visual -->
    <div class="relative w-32 h-32 flex items-center justify-center">
      <!-- Pulse Glow -->
      <span class="absolute w-24 h-24 rounded-full bg-red-500/20 blur-[20px] animate-ping" style="animation-duration: 3s;"></span>
      <!-- Movie reel / Popcorn icon -->
      <div class="relative z-10 w-24 h-24 rounded-full bg-[#1c1d24] border border-glass-stroke flex items-center justify-center shadow-xl group">
        <span class="material-symbols-outlined text-5xl text-red-500 transition-transform duration-700 group-hover:rotate-[180deg]">movie_filter</span>
      </div>
      <!-- Spilled popcorn small bits -->
      <span class="absolute top-4 left-4 w-3.5 h-3.5 rounded bg-amber-200 border border-amber-300 opacity-80 blur-[0.5px]"></span>
      <span class="absolute bottom-6 left-2 w-3.5 h-3.5 rounded bg-amber-100 border border-amber-300 opacity-90 rotate-12"></span>
      <span class="absolute bottom-2 right-4 w-4 h-4 rounded bg-amber-200 border border-amber-300 opacity-80 -rotate-45"></span>
    </div>

    <!-- Typography -->
    <div class="space-y-3">
      <h1 class="text-7xl sm:text-8xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-amber-400">404</h1>
      <h2 class="text-2xl font-bold text-white tracking-tight">Cắt! Cảnh quay này không tồn tại</h2>
      <p class="text-on-surface-variant/80 text-sm leading-relaxed max-w-md mx-auto">
        Ốp! Đường dẫn bạn truy cập đã bị cắt khỏi bộ phim hoặc đã chuyển sang một phòng chiếu khác. Hãy chọn lối thoát bên dưới.
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 w-full">
      <a href="/tphim" class="flex-1">
        <Button variant="premium" className="w-full rounded-2xl py-3.5 gap-2 justify-center font-bold text-sm uppercase tracking-wider text-white">
          <span class="material-symbols-outlined text-sm">home</span>
          Về Trang Chủ
        </Button>
      </a>
      <button onclick="window.history.back()" class="flex-grow bg-white/5 border border-glass-stroke text-white font-bold rounded-2xl py-3.5 px-6 text-sm hover:bg-white/10 active:scale-95 transition-all flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Quay lại trang trước
      </button>
    </div>

    <!-- Quick Helpful Links -->
    <div class="border-t border-glass-stroke pt-6 w-full flex justify-center gap-6 text-xs font-label-caps text-on-surface-variant/60 font-semibold">
      <a href="/phim-bo" class="hover:text-primary transition-colors">Phim Bộ</a>
      <span>•</span>
      <a href="/phim-le" class="hover:text-secondary-container transition-colors">Phim Lẻ</a>
      <span>•</span>
      <a href="/lich-chieu" class="hover:text-primary transition-colors">Lịch Chiếu</a>
    </div>

  </div>
</main>
