---
import { MovieService } from '../../services/MovieService';
import Txaicon from './txaicon.astro';

interface Props {
  title: string;
  slug: string;
  poster: string;
  year?: number;
  quality?: string;
  status?: string;
  class?: string;
  aspect?: string;
  movie?: any;
}

const { title, slug, poster, year, quality, status, class: className, aspect = "aspect-[2/3]", movie: propMovie } = Astro.props;

// Fetch full movie details server-side for rich hover popup only if not provided as a prop
const movie = propMovie || await MovieService.getMovieBySlug(slug);

const getLangBadge = (lang?: string) => {
  if (!lang) return 'P.Đề';
  const lower = lang.toLowerCase();
  if (lower.includes('thuyết minh') && (lower.includes('vietsub') || lower.includes('phụ đề'))) return 'P.Đề + T.Minh';
  if (lower.includes('thuyết minh') || lower.includes('t.minh') || lower.includes('tm')) return 'T.Minh';
  if (lower.includes('lồng tiếng') || lower.includes('lt')) return 'L.Tiếng';
  return 'P.Đề';
};
---

<div class={`relative group w-full ${className || ''}`}>
  <!-- Regular Card (Default view - poster box) -->
  <a href={`/phim/${slug}`} class={`relative block w-full ${aspect} rounded-xl overflow-hidden glass-card border border-glass-stroke movie-card-hover transition-all duration-300 cursor-pointer`}>
    <img 
      src={poster} 
      alt={title} 
      class="w-full h-full object-cover"
      loading="lazy"
    />
    
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-100 transition-opacity"></div>
    
    <!-- Top Right Gold 4K Badge -->
    {quality === '4K' && (
      <div class="absolute top-2 right-2 z-20">
        <span class="bg-amber-500 text-slate-950 text-[11px] px-2 py-0.5 rounded font-black shadow-sm tracking-wider">4K</span>
      </div>
    )}

    <!-- Episode Progress Badge -->
    {movie?.type === 'series' && movie?.episodeCurrent && (
      <div class="absolute top-2 left-2 z-20">
        <span class="bg-black/60 text-white text-[11px] px-2 py-0.5 rounded backdrop-blur-sm border border-white/10 font-semibold shadow-sm">
          {(() => {
            let cur = movie.episodeCurrent.trim().replace(/^[tT]ập\s+/, '');
            if (cur.toLowerCase() === 'full' || cur.toLowerCase() === 'hoàn thành') {
              return 'Full';
            }
            if (movie.episodeTotal) {
              let tot = movie.episodeTotal.trim().replace(/^[tT]ập\s+/, '');
              return `Tập ${cur}/${tot}`;
            }
            return `Tập ${cur}`;
          })()}
        </span>
      </div>
    )}
    
    <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-all duration-300 group-hover:opacity-100 bg-black/20">
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/95 text-on-primary backdrop-blur-md transform scale-50 transition-transform duration-300 group-hover:scale-100 shadow-xl shadow-primary/20">
        <span class="material-symbols-outlined ml-0.5 text-xl" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
      </div>
    </div>
    
    <!-- Centered Language/Subtitle Badge inside the bottom of poster -->
    <div class="absolute bottom-2 left-1/2 -translate-x-1/2 z-20">
      <span class="bg-[#141416]/80 text-zinc-300 text-[10px] font-bold px-3 py-1 rounded border border-white/10 shadow-sm backdrop-blur-sm whitespace-nowrap">
        {getLangBadge(movie?.lang || quality)}
      </span>
    </div>
  </a>

  <!-- Text Titles below the Poster container (centered, matches Image 1) -->
  <div class="mt-2.5 px-1 space-y-0.5 text-center">
    <h3 class="font-bold text-sm text-white line-clamp-1 group-hover:text-primary transition-colors" data-txatooltip={title}>
      {title}
    </h3>
    <p class="text-[11px] text-zinc-500 truncate font-medium" data-txatooltip={movie?.originalTitle || ''}>
      {movie?.originalTitle || movie?.title || ''}
    </p>
  </div>

  <!-- Hover Popover details card (Netflix style, desktop only) -->
  <div class="pointer-events-none absolute left-1/2 top-1/2 z-50 w-[300px] -translate-x-1/2 -translate-y-1/2 scale-75 rounded-2xl border border-glass-stroke bg-[#141416]/95 backdrop-blur-md opacity-0 shadow-[0_0_40px_rgba(109,40,217,0.3),_0_20px_50px_rgba(0,0,0,0.85)] transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:pointer-events-auto group-hover:scale-100 group-hover:opacity-100 group-hover:visible group-hover:delay-[600ms] hidden lg:block overflow-hidden">
    <!-- Movie Banner Image in Popover -->
    <div class="relative w-full aspect-video bg-black/40">
      <img src={movie?.bannerUrl || poster} alt={title} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#141416] via-[#141416]/20 to-transparent"></div>
      
      <!-- Top Left Quality badge in popover -->
      <div class="absolute top-3 left-3 flex gap-1">
        {quality && <span class="bg-primary text-on-primary text-[9px] px-1.5 py-0.5 rounded font-bold shadow-sm">{quality}</span>}
        {movie?.lang && <span class="bg-white/10 text-white text-[9px] px-1.5 py-0.5 rounded shadow-sm backdrop-blur-md">{movie.lang}</span>}
      </div>
    </div>

    <!-- Popover Info Area -->
    <div class="p-4 space-y-3.5">
      <div>
        <h4 class="font-bold text-white text-base leading-tight font-outfit line-clamp-1">{title}</h4>
        {movie?.originalTitle && (
          <p class="text-primary text-[11px] font-semibold mt-0.5 font-outfit line-clamp-1">{movie.originalTitle}</p>
        )}
      </div>

      <!-- Action Buttons Row -->
      <div class="flex items-center gap-2">
        <a href={`/xem/${slug}?ep=tap-1`} class="flex-1 flex items-center justify-center gap-1.5 py-2 px-3 bg-primary hover:bg-primary/90 text-on-primary rounded-xl text-xs font-bold transition-all shadow-[0_4px_12px_rgba(124,58,237,0.2)] cursor-pointer">
          <span class="material-symbols-outlined text-sm font-bold" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
          Xem ngay
        </a>
        <button class="w-8 h-8 rounded-xl border border-glass-stroke flex items-center justify-center text-white hover:bg-white/5 transition-all cursor-pointer" data-txatooltip="Thích">
          <span class="material-symbols-outlined text-sm">favorite</span>
        </button>
        <button class="w-8 h-8 rounded-xl border border-glass-stroke flex items-center justify-center text-white hover:bg-white/5 transition-all cursor-pointer card-playlist-btn relative" data-slug={slug} data-txatooltip="Danh sách phát">
          <span class="card-icon-add flex items-center justify-center">
            <Txaicon name="playlist-add" class="w-4 h-4" />
          </span>
          <span class="card-icon-added flex items-center justify-center hidden text-primary">
            <Txaicon name="playlist-added" class="w-4 h-4" />
          </span>
        </button>
        <a href={`/phim/${slug}`} class="w-8 h-8 rounded-xl border border-glass-stroke flex items-center justify-center text-white hover:bg-white/5 transition-all cursor-pointer" data-txatooltip="Chi tiết">
          <span class="material-symbols-outlined text-sm">info</span>
        </a>
      </div>

      <!-- Tags & Details Row -->
      <div class="flex flex-wrap items-center gap-2 text-[10px] text-zinc-300 font-semibold font-outfit pt-1">
        {movie?.imdbScore && (
          <span class="border border-primary text-primary px-1.5 py-0.5 rounded text-[9px] font-bold">IMDb {movie.imdbScore.toFixed(1)}</span>
        )}
        {movie?.ageRating && (
          <span class="border border-zinc-500 text-zinc-300 px-1.5 py-0.5 rounded text-[9px] font-bold">{movie.ageRating}</span>
        )}
        {year && <span>{year}</span>}
        {movie?.seasons && <span>{movie.seasons}</span>}
        {status && <span class="text-secondary">{status}</span>}
      </div>

      <!-- Genres Row -->
      {(() => {
        const genres = movie?.genres;
        if (!genres || genres.length === 0) return null;
        return (
          <div class="text-[10px] text-zinc-400 font-medium border-t border-glass-stroke pt-2 flex flex-wrap gap-x-1.5 gap-y-0.5">
            {genres.map((genre: string, idx: number) => (
              <>
                <span>{genre}</span>
                {idx < genres.length - 1 && <span class="text-zinc-600">•</span>}
              </>
            ))}
          </div>
        );
      })()}
    </div>
  </div>
</div>
