---
import '../styles/index.css';
import { SettingService } from '../services/SettingService';
import { MovieService } from '../services/MovieService';
import { ClientRouter } from 'astro:transitions';
import Txatooltip from '../components/ui/txatooltip.astro';
import Txaicon from '../components/ui/txaicon.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHome?: boolean;
  useTransition?: boolean;
}

const settings = await SettingService.getSettings();
const popularMovies = await MovieService.getMovies({ limit: 12 });

const { 
  title, 
  description = settings.general.site_description, 
  image = "/favicon.png",
  isHome = false,
  useTransition = true
} = Astro.props;

const defaultTitle = `${settings.general.site_name} - Trải nghiệm điện ảnh đỉnh cao`;
const pageTitle = isHome 
  ? defaultTitle 
  : (title ? `${title} | ${settings.general.site_name}` : defaultTitle);

const socialLinks = [];
if (settings.social?.social_fb_enable && settings.social?.social_fb_url) {
  socialLinks.push({ platform: "Facebook", url: settings.social.social_fb_url, icon: "facebook" });
}
if (settings.social?.social_fb_group_enable && settings.social?.social_fb_group_url) {
  socialLinks.push({ platform: "Facebook Group", url: settings.social.social_fb_group_url, icon: "facebook-group" });
}
if (settings.social?.social_telegram_enable && settings.social?.social_telegram_url) {
  socialLinks.push({ platform: "Telegram", url: settings.social.social_telegram_url, icon: "telegram" });
}
if (settings.social?.social_tiktok_enable && settings.social?.social_tiktok_url) {
  socialLinks.push({ platform: "TikTok", url: settings.social.social_tiktok_url, icon: "tiktok" });
}
if (settings.social?.social_zalo_group_enable && settings.social?.social_zalo_group_url) {
  socialLinks.push({ platform: "Zalo Group", url: settings.social.social_zalo_group_url, icon: "zalo" });
}

const allMoviesForNav = await MovieService.getMovies();
const uniqueCountries = [...new Set(allMoviesForNav.map(m => m.category).filter(Boolean))] as string[];
const uniqueGenres = [...new Set(allMoviesForNav.flatMap(m => m.genres || []).filter(Boolean))] as string[];

const slugify = (text: string) => {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[đĐ]/g, 'd')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
};

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/tphim') {
    return currentPath === '/tphim';
  }
  return currentPath.startsWith(path);
};
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    {useTransition && <ClientRouter />}
    <script is:inline>
      function applyTheme() {
        document.documentElement.classList.add('dark');
        window.localStorage.setItem('theme', 'dark');
      }
      function hydrateSettings() {
        if (typeof localStorage === 'undefined') return;
        const stored = localStorage.getItem('txa_site_settings');
        if (!stored) return;
        try {
          const settings = JSON.parse(stored);
          if (!settings || !settings.general) return;

          // 1. Maintenance redirect
          const path = window.location.pathname;
          if (settings.general.maintenance_enable && !path.startsWith('/admin') && path !== '/bao-tri') {
            window.location.href = '/bao-tri';
            return;
          }

          // 2. Override title
          const titleEl = document.querySelector('title');
          if (titleEl) {
            const isHome = path === '/' || path === '/tphim';
            if (isHome) {
              titleEl.textContent = settings.general.site_name + " - Trải nghiệm điện ảnh đỉnh cao";
            } else {
              const currentTitle = titleEl.textContent;
              const parts = currentTitle.split(' | ');
              if (parts.length > 0) {
                titleEl.textContent = parts[0] + " | " + settings.general.site_name;
              }
            }
          }

          // 3. SEO Meta Tags
          const descMeta = document.querySelector('meta[name="description"]');
          if (descMeta && settings.general.site_description) {
            descMeta.setAttribute('content', settings.general.site_description);
          }
          const keyMeta = document.querySelector('meta[name="keywords"]');
          if (keyMeta && settings.general.site_keywords) {
            keyMeta.setAttribute('content', settings.general.site_keywords);
          }

          // 4. Logo alt text
          const logoImgs = document.querySelectorAll('.dyn-logo-img');
          logoImgs.forEach(img => {
            img.setAttribute('alt', settings.general.site_name + ' Logo');
          });

          // 5. Site Name text
          const siteNames = document.querySelectorAll('.dyn-site-name');
          siteNames.forEach(el => {
            el.textContent = settings.general.site_name;
          });

          // 6. Copyright text
          const copyrights = document.querySelectorAll('.dyn-copyright');
          copyrights.forEach(el => {
            el.textContent = '© ' + new Date().getFullYear() + ' ' + settings.general.site_name + '. Trải nghiệm điện ảnh đỉnh cao. Bản quyền thuộc về ' + settings.general.site_name + ' Group.';
          });

          // 7. Hydrate Social Links
          const socialData = settings.social || {};
          
          const fbLink = document.getElementById('social-link-facebook');
          if (fbLink) {
            if (socialData.social_fb_enable && socialData.social_fb_url) {
              fbLink.setAttribute('href', socialData.social_fb_url);
              fbLink.classList.remove('hidden');
            } else {
              fbLink.classList.add('hidden');
            }
          }
          
          const fbGroupLink = document.getElementById('social-link-facebook-group');
          if (fbGroupLink) {
            if (socialData.social_fb_group_enable && socialData.social_fb_group_url) {
              fbGroupLink.setAttribute('href', socialData.social_fb_group_url);
              fbGroupLink.classList.remove('hidden');
            } else {
              fbGroupLink.classList.add('hidden');
            }
          }
          
          const teleLink = document.getElementById('social-link-telegram');
          if (teleLink) {
            if (socialData.social_telegram_enable && socialData.social_telegram_url) {
              teleLink.setAttribute('href', socialData.social_telegram_url);
              teleLink.classList.remove('hidden');
            } else {
              teleLink.classList.add('hidden');
            }
          }
          
          const tiktokLink = document.getElementById('social-link-tiktok');
          if (tiktokLink) {
            if (socialData.social_tiktok_enable && socialData.social_tiktok_url) {
              tiktokLink.setAttribute('href', socialData.social_tiktok_url);
              tiktokLink.classList.remove('hidden');
            } else {
              tiktokLink.classList.add('hidden');
            }
          }
          
          const zaloLink = document.getElementById('social-link-zalo');
          if (zaloLink) {
            if (socialData.social_zalo_group_enable && socialData.social_zalo_group_url) {
              zaloLink.setAttribute('href', socialData.social_zalo_group_url);
              zaloLink.classList.remove('hidden');
            } else {
              zaloLink.classList.add('hidden');
            }
          }
        } catch (e) {
          console.error('Error hydrating settings:', e);
        }
      }
      applyTheme();
      hydrateSettings();
      document.addEventListener('astro:after-swap', () => {
        applyTheme();
        hydrateSettings();
      });
      document.addEventListener('astro:page-load', () => {
        applyTheme();
        hydrateSettings();
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="keywords" content={settings.general.site_keywords} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  </head>
  <body class="font-body-main text-on-surface bg-surface-deep overflow-x-hidden transition-colors duration-300">
    {isHome && (
      <div id="splash-screen" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-[#0A0A0B] transition-all duration-500 ease-out">
        <div class="flex flex-col items-center gap-6">
          <img src="/logo-icon.gif" alt="Logo" class="h-20 w-auto animate-pulse" />
          <div class="w-48 h-1 bg-white/5 rounded-full overflow-hidden relative">
            <div class="absolute inset-y-0 left-0 w-1/3 bg-gradient-to-r from-primary to-secondary rounded-full animate-[shimmer_1.5s_infinite_linear]"></div>
          </div>
        </div>
      </div>
      <style>
        @keyframes shimmer {
          0% { transform: translateX(-100%); }
          100% { transform: translateX(300%); }
        }
      </style>
      <script is:inline>
        (function() {
          const splash = document.getElementById('splash-screen');
          if (splash) {
            if (sessionStorage.getItem('dongphim_splash_shown')) {
              splash.style.display = 'none';
              splash.remove();
            } else {
              sessionStorage.setItem('dongphim_splash_shown', 'true');
              setTimeout(() => {
                splash.style.opacity = '0';
                splash.style.pointerEvents = 'none';
                setTimeout(() => {
                  splash.remove();
                }, 500);
              }, 1500);
            }
          }
        })();
      </script>
    )}

    <!-- TopNavBar (Mobile Header like Image 1) -->
    <nav class="fixed top-0 w-full z-50 backdrop-blur-[20px] bg-surface/60 border-b border-glass-stroke shadow-2xl transition-all duration-300 md:hidden" id="mobile-top-nav">
        <div class="flex justify-between items-center px-6 py-3">
            <a class="flex items-center gap-2" href="/tphim">
                <img src="/logo-icon.gif" alt={`${settings.general.site_name} Logo`} class="h-8 w-auto dyn-logo-img" />
            </a>
            <div class="flex items-center gap-3">
                <button onclick="window.showToast ? window.showToast('Chưa có thông báo mới', 'info') : console.log('No notifications')" class="p-2 rounded-xl bg-white/5 border border-white/10 text-on-surface flex items-center justify-center hover:bg-white/10 active:scale-95 transition-all w-9 h-9 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">notifications</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- TopNavBar (Desktop) -->
    <nav class="fixed top-0 w-full z-50 backdrop-blur-[20px] bg-surface/60 border-b border-glass-stroke shadow-2xl transition-all duration-300 hidden md:block" id="main-nav">
        <div class="flex justify-between items-center px-gutter py-4 max-w-container-max mx-auto transition-all duration-300" id="nav-container">
            <div class="flex items-center gap-8">
                <a class="flex items-center gap-2" href="/tphim">
                    <img src="/logo-icon.gif" alt={`${settings.general.site_name} Logo`} class="h-10 w-auto dyn-logo-img" />
                </a>
                <div class="hidden lg:flex gap-6 items-center">
                    <a class={`font-label-caps text-label-caps pb-1 ${isActive('/tphim') ? 'text-primary border-b-2 border-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`} href="/tphim">Trang Chủ</a>
                    <a class={`font-label-caps text-label-caps pb-1 ${isActive('/phim-bo') ? 'text-primary border-b-2 border-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`} href="/phim-bo">Phim Bộ</a>
                    <a class={`font-label-caps text-label-caps pb-1 ${isActive('/phim-le') ? 'text-primary border-b-2 border-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`} href="/phim-le">Phim Lẻ</a>
                    
                    <!-- Thể loại Dropdown -->
                    <div class="relative group">
                        <a href="/the-loai" class="font-label-caps text-label-caps pb-1 text-on-surface-variant hover:text-on-surface transition-colors flex items-center gap-1 cursor-pointer">
                            Thể Loại <span class="material-symbols-outlined text-[16px] group-hover:rotate-180 transition-transform duration-300">keyboard_arrow_down</span>
                        </a>
                        <div class="absolute left-1/2 -translate-x-1/2 top-full mt-2 w-96 bg-zinc-950/95 border border-glass-stroke rounded-2xl shadow-2xl p-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 grid grid-cols-3 gap-2 backdrop-blur-xl z-50">
                            {uniqueGenres.map(genre => (
                                <a href={`/the-loai/${slugify(genre)}`} class="px-3 py-2 text-xs font-semibold rounded-lg text-on-surface-variant hover:text-primary hover:bg-white/5 transition-colors">{genre}</a>
                            ))}
                        </div>
                    </div>

                    <!-- Quốc gia Dropdown -->
                    <div class="relative group">
                        <a href="/quoc-gia" class="font-label-caps text-label-caps pb-1 text-on-surface-variant hover:text-on-surface transition-colors flex items-center gap-1 cursor-pointer">
                            Quốc Gia <span class="material-symbols-outlined text-[16px] group-hover:rotate-180 transition-transform duration-300">keyboard_arrow_down</span>
                        </a>
                        <div class="absolute left-1/2 -translate-x-1/2 top-full mt-2 w-80 bg-zinc-950/95 border border-glass-stroke rounded-2xl shadow-2xl p-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 grid grid-cols-2 gap-2 backdrop-blur-xl z-50">
                            {uniqueCountries.map(country => (
                                <a href={`/quoc-gia/${slugify(country)}`} class="px-3 py-2 text-xs font-semibold rounded-lg text-on-surface-variant hover:text-primary hover:bg-white/5 transition-colors">{country}</a>
                            ))}
                        </div>
                    </div>

                    <a class={`font-label-caps text-label-caps pb-1 ${isActive('/moi-cap-nhat') ? 'text-primary border-b-2 border-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`} href="/moi-cap-nhat">Mới Cập Nhật</a>

                    <!-- Thêm Dropdown -->
                    <div class="relative group">
                        <button class="font-label-caps text-label-caps pb-1 text-on-surface-variant hover:text-on-surface transition-colors flex items-center gap-1 cursor-pointer">
                            Thêm <span class="material-symbols-outlined text-[16px] group-hover:rotate-180 transition-transform duration-300">keyboard_arrow_down</span>
                        </button>
                        <div class="absolute left-1/2 -translate-x-1/2 top-full mt-2 w-48 bg-zinc-950/95 border border-glass-stroke rounded-2xl shadow-2xl p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 flex flex-col gap-1 backdrop-blur-xl z-50">
                            <a href="/lich-chieu" class="px-4 py-2.5 text-xs font-bold text-on-surface-variant hover:text-primary hover:bg-white/5 transition-colors flex items-center gap-2 rounded-xl"><span class="material-symbols-outlined text-[16px]">calendar_month</span> Lịch chiếu</a>
                            <a href="/admin/dien-vien" class="px-4 py-2.5 text-xs font-bold text-on-surface-variant hover:text-primary hover:bg-white/5 transition-colors flex items-center gap-2 rounded-xl"><span class="material-symbols-outlined text-[16px]">group</span> Diễn viên</a>
                            <a href="/chu-de" class="px-4 py-2.5 text-xs font-bold text-on-surface-variant hover:text-primary hover:bg-white/5 transition-colors flex items-center gap-2 rounded-xl"><span class="material-symbols-outlined text-[16px]">grid_view</span> Chủ đề</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="relative hidden md:block" id="search-container">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant z-10">search</span>
                    <input id="nav-search-input" class="bg-white/5 border border-glass-stroke rounded-full py-2 pl-10 pr-4 w-64 focus:w-80 focus:ring-2 focus:ring-primary/50 transition-all outline-none text-sm text-on-surface" placeholder="Tìm phim, diễn viên..." type="text" autocomplete="off">
                    
                    <!-- Real-time Search Popup -->
                    <div id="search-popup" class="absolute top-full right-0 mt-3 w-96 bg-[#0f111a]/95 border border-glass-stroke rounded-2xl shadow-2xl p-4 opacity-0 invisible scale-95 origin-top-right transition-all duration-300 backdrop-blur-xl z-50 flex flex-col gap-3">
                        <div class="flex justify-between items-center text-xs border-b border-glass-stroke pb-2 text-on-surface-variant font-bold">
                            <span>KẾT QUẢ TÌM KIẾM</span>
                            <span id="search-loader" class="material-symbols-outlined text-sm animate-spin hidden">progress_activity</span>
                        </div>
                        <div id="search-results-list" class="flex flex-col gap-2.5 max-h-[350px] overflow-y-auto pr-1">
                            <div class="text-xs text-on-surface-variant/60 py-4 text-center italic">Nhập từ khóa để tìm kiếm...</div>
                        </div>
                    </div>
                </div>
                <div class="flex gap-2 items-center">

                    
                    <!-- Guest View -->
                    <div class="auth-guest flex gap-2 items-center">
                      <button onclick="window.dispatchEvent(new Event('open-login-modal'))" class="font-label-caps text-label-caps px-4 py-2 text-on-surface-variant hover:text-on-surface transition-all active:scale-95">Đăng nhập</button>
                      <button onclick="window.dispatchEvent(new Event('open-register-modal'))" class="font-label-caps text-label-caps px-6 py-2 bg-gradient-to-br from-primary-container to-secondary-container text-white rounded-lg shadow-lg hover:brightness-110 transition-all active:scale-95 flex items-center">Đăng ký</button>
                    </div>

                    <!-- Logged In View -->
                    <div class="auth-user hidden flex gap-4 items-center pl-2">
                      <a href="/danh-sach-cua-toi" class="text-on-surface-variant hover:text-primary transition-colors flex items-center">
                        <span class="material-symbols-outlined">bookmark</span>
                      </a>
                      <div class="relative group cursor-pointer">
                        <div class="w-9 h-9 rounded-full bg-surface border-2 border-primary overflow-hidden flex items-center justify-center">
                          <span class="material-symbols-outlined text-primary text-xl">person</span>
                        </div>
                        <div class="absolute right-0 top-full mt-2 w-48 bg-surface border border-glass-stroke rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all flex flex-col overflow-hidden">
                          <a href="/thong-tin" class="px-4 py-3 text-sm text-on-surface hover:bg-white/5 transition-colors border-b border-glass-stroke flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">account_circle</span> Tài khoản</a>
                          <a href="/lich-su-xem" class="px-4 py-3 text-sm text-on-surface hover:bg-white/5 transition-colors border-b border-glass-stroke flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">history</span> Lịch sử xem</a>
                          <a href="/admin" class="px-4 py-3 text-sm text-on-surface hover:bg-white/5 transition-colors border-b border-glass-stroke flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">admin_panel_settings</span> Quản trị</a>
                          <button onclick="logout()" class="px-4 py-3 text-sm text-red-400 hover:bg-red-500/10 transition-colors flex items-center gap-2 text-left"><span class="material-symbols-outlined text-[18px]">logout</span> Đăng xuất</button>
                        </div>
                      </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- BottomNavBar (Mobile Pill) -->
    <nav class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 md:hidden w-[94%] max-w-md rounded-full backdrop-blur-[25px] bg-surface/80 border border-white/20 shadow-2xl overflow-hidden" style="box-shadow: 0 8px 32px rgba(0,0,0,0.3); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);">
      <div class="flex justify-between items-center px-4 py-3">
        <a href="/tphim" class={`flex flex-col items-center gap-1 ${isActive('/tphim') ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`}>
          <span class="material-symbols-outlined text-xl">home</span>
          <span class="text-[10px] font-medium">Trang chủ</span>
        </a>
        <a href="/tim-kiem" class={`flex flex-col items-center gap-1 ${isActive('/tim-kiem') ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`}>
          <span class="material-symbols-outlined text-xl">search</span>
          <span class="text-[10px] font-medium">Tìm kiếm</span>
        </a>

        <!-- Guest View Links -->
        <a href="/danh-sach-cua-toi" class={`auth-guest flex flex-col items-center gap-1 ${isActive('/danh-sach-cua-toi') ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`}>
          <span class="material-symbols-outlined text-xl">bookmark</span>
          <span class="text-[10px] font-medium">Lưu</span>
        </a>
        <a href="/lich-chieu" class={`auth-guest flex flex-col items-center gap-1 ${isActive('/lich-chieu') ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`}>
          <span class="material-symbols-outlined text-xl">calendar_month</span>
          <span class="text-[10px] font-medium">Lịch chiếu</span>
        </a>
        <button onclick="window.dispatchEvent(new Event('open-login-modal'))" class={`auth-guest flex flex-col items-center gap-1 text-on-surface-variant hover:text-on-surface transition-colors`}>
          <span class="material-symbols-outlined text-xl">person</span>
          <span class="text-[10px] font-medium">Đăng nhập</span>
        </button>

        <!-- User View Links -->
        <a href="/lich-su-xem" class={`auth-user hidden flex flex-col items-center gap-1 ${isActive('/lich-su-xem') ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`}>
          <span class="material-symbols-outlined text-xl">history</span>
          <span class="text-[10px] font-medium">Lịch sử</span>
        </a>
        <a href="/admin" class={`auth-user hidden flex flex-col items-center gap-1 ${isActive('/admin') ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`}>
          <span class="material-symbols-outlined text-xl">admin_panel_settings</span>
          <span class="text-[10px] font-medium">Quản trị</span>
        </a>
        <a href="/thong-tin" class={`auth-user hidden flex flex-col items-center gap-1 ${isActive('/thong-tin') ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors'}`}>
          <span class="material-symbols-outlined text-xl">account_circle</span>
          <span class="text-[10px] font-medium">Tài khoản</span>
        </a>
      </div>
    </nav>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- PREMIUM UNIFIED AUTH MODAL (Redesigned Split Layout)            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div id="login-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/85 backdrop-blur-md transition-all duration-300" style="display:none;">
      <div class="relative w-full max-w-[850px] mx-4 overflow-hidden rounded-[28px] border border-glass-stroke shadow-[0_0_80px_rgba(0,0,0,0.8)] backdrop-blur-2xl bg-[#0f172a]/95 animate-[modalZoomIn_0.3s_cubic-bezier(0.34,1.56,0.64,1)] grid grid-cols-1 md:grid-cols-12 min-h-[500px]">
        
        <!-- Left Panel: Movie Collage (Hidden on Mobile) -->
        <div class="col-span-5 hidden md:block relative overflow-hidden bg-[#090d16] border-r border-glass-stroke select-none pointer-events-none">
          <!-- Poster Grid -->
