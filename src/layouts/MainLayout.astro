    <script is:inline>

      // ══════════════════════════════════════════════════════════════
      // Auth State Manager
      // ══════════════════════════════════════════════════════════════
      function updateAuthState() {
        const isLoggedIn = document.cookie.includes('txa_gate_passed');
        const guestViews = document.querySelectorAll('.auth-guest');
        const userViews = document.querySelectorAll('.auth-user');
        
        if (isLoggedIn) {
          guestViews.forEach(el => el.classList.add('hidden'));
          userViews.forEach(el => el.classList.remove('hidden'));
        } else {
          guestViews.forEach(el => el.classList.remove('hidden'));
          userViews.forEach(el => el.classList.add('hidden'));
        }
      }

      updateAuthState();
      window.addEventListener('auth-changed', updateAuthState);

      window.logout = function() {
        document.cookie = "txa_gate_passed=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
        if (typeof localStorage !== 'undefined') {
          localStorage.removeItem('tlogged_in_as');
          localStorage.removeItem('thistory');
        }
        window.dispatchEvent(new Event('auth-changed'));
        if (window.showGlobalToast) {
          window.showGlobalToast('Đã đăng xuất', 'success');
        }
        
        setTimeout(() => {
          window.location.href = '/tphim';
        }, 800);
      };

      // ══════════════════════════════════════════════════════════════
      // Global Toast Manager (Stackable, supports calling via Console/JS)
      // ══════════════════════════════════════════════════════════════
      (function() {
        window.showGlobalToast = function(message, type = 'success', duration = 3000) {
          let container = document.getElementById('txa-toast-container');
          if (!container) {
            container = document.createElement('div');
            container.id = 'txa-toast-container';
            container.className = 'fixed bottom-6 right-6 z-[200] flex flex-col gap-2 pointer-events-none';
            document.body.appendChild(container);
          }
          
          const toast = document.createElement('div');
          toast.className = 'pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl shadow-xl border border-white/10 backdrop-blur-md bg-[#12141d]/90 text-white transition-all duration-300 transform translate-y-2 opacity-0';
          
          const icons = { success: 'check_circle', error: 'error', info: 'info' };
          const colors = { success: 'text-emerald-400', error: 'text-red-400', info: 'text-blue-400' };
          
          toast.innerHTML = `
            <span class="material-symbols-outlined ${colors[type] || colors.info}">${icons[type] || 'info'}</span>
            <span class="text-sm font-medium">${message}</span>
          `;
          
          container.appendChild(toast);
          
          // Trigger entry transition
          requestAnimationFrame(() => {
            toast.classList.remove('translate-y-2', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
          });
          
          // Remove timer
          setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-2', 'opacity-0');
            setTimeout(() => {
              toast.remove();
            }, 300);
          }, duration);
        };
        
        window.showToast = window.showGlobalToast;
      })();

      (function() {
        window.showGlobalModal = function(options) {
          const { title = '', content = '', onClose } = options;
          
          // Remove any existing active dynamic modals
          const existing = document.getElementById('txa-global-modal');
          if (existing) existing.remove();

          const modal = document.createElement('div');
          modal.id = 'txa-global-modal';
          modal.className = 'fixed inset-0 z-[110] flex items-center justify-center bg-black/70 backdrop-blur-sm transition-all duration-300';
          modal.style.opacity = '0';

          modal.innerHTML = `
            <div class="relative w-full max-w-[500px] mx-4 rounded-[24px] p-6 sm:p-8 bg-[#12141d]/95 border border-white/10 shadow-[0_0_50px_rgba(0,0,0,0.5)] ring-1 ring-white/10 backdrop-blur-2xl transition-all duration-300 transform scale-90 opacity-0">
              <button class="absolute right-4 top-4 text-zinc-400 hover:text-white transition-colors p-2 cursor-pointer modal-close-btn">
                <span class="material-symbols-outlined">close</span>
              </button>
              ${title ? `<h3 class="text-xl font-bold text-white mb-4 pr-10 font-outfit">${title}</h3>` : ''}
              <div class="text-zinc-300 text-sm leading-relaxed max-h-[70vh] overflow-y-auto pr-2 txaformat">
                ${content}
              </div>
            </div>
          `;

          document.body.appendChild(modal);
          document.body.style.overflow = 'hidden';

          // Animate in
          requestAnimationFrame(() => {
            modal.style.opacity = '1';
            const body = modal.querySelector('div');
            if (body) {
              body.classList.remove('scale-90', 'opacity-0');
              body.classList.add('scale-100', 'opacity-100');
            }
          });

          function closeModal() {
            modal.style.opacity = '0';
            const body = modal.querySelector('div');
            if (body) {
              body.classList.remove('scale-100', 'opacity-100');
              body.classList.add('scale-90', 'opacity-0');
            }
            setTimeout(() => {
              modal.remove();
              document.body.style.overflow = '';
              if (onClose) onClose();
            }, 300);
          }

          // Close event handlers
          modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal();
          });
          
          const closeBtn = modal.querySelector('.modal-close-btn');
          if (closeBtn) closeBtn.addEventListener('click', closeModal);

          // Esc key handler
          const escHandler = function(e) {
            if (e.key === 'Escape') {
              closeModal();
              document.removeEventListener('keydown', escHandler);
            }
          };
          document.addEventListener('keydown', escHandler);
        };
      })();

      // ══════════════════════════════════════════════════════════════
      // Ultimate mouse-following Glassmorphism Tooltip System (TXA Tooltip)
      // ══════════════════════════════════════════════════════════════
      (function () {
        'use strict';

        if (window.isTxaTooltipInit) return;
        window.isTxaTooltipInit = true;

        const tooltip = document.getElementById('txa-tooltip') || document.createElement('div');
        if (!tooltip.id) {
          tooltip.id = 'txa-tooltip';
          tooltip.style.cssText = `
            position: fixed;
            pointer-events: none;
            z-index: 2147483647;
            padding: 10px 16px;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            color: #fff;
            font-size: 12px;
            font-weight: 500;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5), 0 0 15px rgba(109, 40, 217, 0.15);
            opacity: 0;
            transform: scale(0.95) translateY(6px);
            transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            white-space: normal;
            max-width: 300px;
            line-height: 1.5;
            text-align: center;
            word-break: break-word;
            font-family: 'Inter', sans-serif;
          `;
        }

        function initTooltip() {
          if (!document.body) {
            window.addEventListener('DOMContentLoaded', initTooltip);
            return;
          }
          if (!document.getElementById('txa-tooltip')) {
            document.body.appendChild(tooltip);
          }
        }

        window.initTxaTooltips = initTooltip;
        initTooltip();
        document.addEventListener('astro:page-load', initTooltip);

        let currentTarget = null;
        let hideTimeout = null;

        function showTooltip(text, target, e = null) {
          if (!text) return;
          clearTimeout(hideTimeout);
          
          tooltip.innerHTML = `<div class="txa-tooltip-content">${text}</div>`;
          
          tooltip.style.opacity = '1';
          tooltip.style.transform = 'scale(1) translateY(0)';
          currentTarget = target;

          if (e) {
            updatePosition(e);
          }
        }

        function hideTooltip() {
          hideTimeout = setTimeout(() => {
            tooltip.style.opacity = '0';
            tooltip.style.transform = 'scale(0.95) translateY(6px)';
            currentTarget = null;
          }, 80);
        }

        function updatePosition(e) {
          if (tooltip.style.opacity === '0') return;

          const offset = 18;
          const rect = tooltip.getBoundingClientRect();

          let x = e.clientX - (rect.width / 2);
          let y = e.clientY - rect.height - offset;

          const padding = 12;

          if (x < padding) x = padding;
          if (x + rect.width + padding > window.innerWidth) {
            x = window.innerWidth - rect.width - padding;
          }

          if (y < padding) {
            y = e.clientY + offset;
          }

          tooltip.style.left = x + 'px';
          tooltip.style.top = y + 'px';
        }

        // Global capture of hover states, supporting: data-txatooltip, data-txa-tooltip, .txatooltip, and title attributes
        document.addEventListener('mouseover', (e) => {
          const target = e.target.closest('[data-txatooltip], [data-txa-tooltip], .txatooltip, [title]');
          if (target) {
            const tooltipText = target.getAttribute('data-txatooltip') || target.getAttribute('data-txa-tooltip') || target.title;
            if (tooltipText) {
              if (target.title) {
                target.setAttribute('data-original-title', target.title);
                target.title = '';
              }
              showTooltip(tooltipText, target, e);
            }
          }
        }, true);

        document.addEventListener('mouseout', (e) => {
          const target = e.target.closest('[data-txatooltip], [data-txa-tooltip], .txatooltip, [data-original-title]');
          if (target) {
            const originalTitle = target.getAttribute('data-original-title');
            if (originalTitle) {
              target.title = originalTitle;
              target.removeAttribute('data-original-title');
            }
            hideTooltip();
          }
        }, true);

        document.addEventListener('mousemove', (e) => {
          if (currentTarget) updatePosition(e);
        }, true);

        document.addEventListener('click', () => {
          hideTooltip();
        });

        // Fullscreen support
        function handleFullscreenChange() {
          const fsElem = document.fullscreenElement || document.webkitFullscreenElement;
          if (fsElem) {
            fsElem.appendChild(tooltip);
          } else {
            if (document.body && !document.body.contains(tooltip)) {
              document.body.appendChild(tooltip);
            }
          }
        }

        document.addEventListener('fullscreenchange', handleFullscreenChange);
        document.addEventListener('webkitfullscreenchange', handleFullscreenChange);

        // Expose helper globally to call via Console/JS
        window.showGlobalTooltip = function(targetElementOrSelector, text) {
          const target = typeof targetElementOrSelector === 'string'
            ? document.querySelector(targetElementOrSelector)
            : targetElementOrSelector;
          if (!target) return;
          target.setAttribute('data-txatooltip', text);
          showTooltip(text, target);
          setTimeout(hideTooltip, 2500);
        };
      })();

      // ══════════════════════════════════════════════════════════════
      // Real-time Search Autocomplete Logic
      // ══════════════════════════════════════════════════════════════
      (function() {
        const searchInput = document.getElementById('nav-search-input');
        const searchPopup = document.getElementById('search-popup');
        const searchLoader = document.getElementById('search-loader');
        const resultsList = document.getElementById('search-results-list');
        let debounceTimer;

        if (!searchInput) return;

        function hideSearchPopup() {
          searchPopup?.classList.add('opacity-0', 'invisible', 'scale-95');
        }

        function showSearchPopup() {
          searchPopup?.classList.remove('opacity-0', 'invisible', 'scale-95');
        }

        searchInput.addEventListener('input', function() {
          const val = this.value.trim();
          clearTimeout(debounceTimer);

          if (val.length < 1) {
            resultsList.innerHTML = '<div class="text-xs text-on-surface-variant/60 py-4 text-center italic">Nhập từ khóa để tìm kiếm...</div>';
            hideSearchPopup();
            return;
          }

          showSearchPopup();
          searchLoader?.classList.remove('hidden');

          debounceTimer = setTimeout(async () => {
            try {
              const res = await fetch(`/api/movies/search?q=${encodeURIComponent(val)}`);
              if (!res.ok) throw new Error();
              const payload = await res.json();
              const movies = payload.data || [];

              // Merge crawled movies client-side
              let localCrawled = [];
              try {
                const stored = localStorage.getItem('txa_crawled_movies');
                if (stored) {
                  const list = JSON.parse(stored);
                  if (Array.isArray(list)) {
                    localCrawled = list.map(m => m.movie || m);
                  }
                }
              } catch (e) {}

              // Filter crawled movies matching the query
              const queryLower = val.toLowerCase();
              const matchedCrawled = localCrawled.filter(m => 
                m.title.toLowerCase().includes(queryLower) ||
                (m.originalTitle && m.originalTitle.toLowerCase().includes(queryLower)) ||
                (m.description && m.description.toLowerCase().includes(queryLower))
              );

              // Combine and deduplicate by slug
              let combined = [...matchedCrawled, ...movies];
              const seen = new Set();
              const uniqueMovies = combined.filter(m => {
                if (seen.has(m.slug)) return false;
                seen.add(m.slug);
                return true;
              }).slice(0, 6);

              if (uniqueMovies.length === 0) {
                resultsList.innerHTML = '<div class="text-xs text-on-surface-variant/60 py-4 text-center">Không tìm thấy kết quả phù hợp</div>';
              } else {
                resultsList.innerHTML = uniqueMovies.map(m => `
                  <a href="/phim/${m.slug}" class="flex gap-3 p-2 rounded-xl hover:bg-white/5 border border-transparent hover:border-glass-stroke transition-all duration-300 group/item cursor-pointer">
                    <img src="${m.posterUrl}" class="w-10 h-14 object-cover rounded-lg border border-glass-stroke shrink-0" />
                    <div class="flex-grow flex flex-col justify-center min-w-0">
                      <div class="text-xs font-bold text-white group-hover/item:text-primary transition-colors truncate">${m.title}</div>
                      ${m.originalTitle ? `<div class="text-[10px] text-on-surface-variant/75 truncate mt-0.5">${m.originalTitle}</div>` : ''}
                      <div class="flex items-center gap-2 mt-1.5 text-[9px] text-on-surface-variant/50 font-bold">
                        <span class="px-1.5 py-0.5 bg-white/5 border border-glass-stroke rounded text-primary">${m.quality || 'FHD'}</span>
                        <span>${m.releaseYear || 2024}</span>
                        <span>•</span>
                        <span>${m.episodeCurrent || 'Full'}</span>
                      </div>
                    </div>
                  </a>
                `).join('');
              }
            } catch (err) {
              resultsList.innerHTML = '<div class="text-xs text-red-400 py-4 text-center">Lỗi tải dữ liệu. Vui lòng thử lại.</div>';
            } finally {
              searchLoader?.classList.add('hidden');
            }
          }, 350);
        });

        // Enter key to search
        searchInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            const val = this.value.trim();
            if (val.length >= 1) {
              window.location.href = `/tim-kiem?q=${encodeURIComponent(val)}`;
            }
          }
        });

        // Click outside search
        document.addEventListener('click', function(e) {
          if (!document.getElementById('search-container')?.contains(e.target)) {
            hideSearchPopup();
          }
        });
      })();

      // ══════════════════════════════════════════════════════════════
      // Premium Modal Open/Close & Tab Toggles
      // ══════════════════════════════════════════════════════════════
      function initTurnstileDecoy() {
        const spinner = document.querySelector('.turnstile-spinner');
        const check = document.querySelector('.turnstile-check');
        const text = document.querySelector('.turnstile-text');
        
        if (spinner && check && text) {
          spinner.classList.remove('hidden');
          check.classList.add('hidden');
          text.textContent = 'Đang xác minh...';
          
          setTimeout(() => {
            spinner.classList.add('hidden');
            check.classList.remove('hidden');
            text.textContent = 'Đã xác minh';
          }, 1500);
        }
      }

      function switchAuthTab(tab) {
        const loginTab = document.getElementById('auth-tab-login');
        const registerTab = document.getElementById('auth-tab-register');

        if (tab === 'login') {
          loginTab?.classList.remove('hidden');
          registerTab?.classList.add('hidden');
        } else {
          loginTab?.classList.add('hidden');
          registerTab?.classList.remove('hidden');
        }
        
        // Restart simulated Cloudflare Turnstile decoy verification
        initTurnstileDecoy();
      }

      function openLoginModal() {
        const m = document.getElementById('login-modal');
        if (m) {
          m.style.display = 'flex';
          m.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          switchAuthTab('login');
        }
      }

      function openRegisterModal() {
        const m = document.getElementById('login-modal');
        if (m) {
          m.style.display = 'flex';
          m.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          switchAuthTab('register');
        }
      }

      function closeLoginModal() {
        const m = document.getElementById('login-modal');
        if (m) {
          m.style.display = 'none';
          m.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      // Expose globally
      window.openLoginModal = openLoginModal;
      window.closeLoginModal = closeLoginModal;
      window.openRegisterModal = openRegisterModal;
      window.closeRegisterModal = closeLoginModal;
      window.switchAuthTab = switchAuthTab;

      window.addEventListener('open-login-modal', openLoginModal);
      window.addEventListener('open-register-modal', openRegisterModal);

      // Close on backdrop click or Escape
      document.getElementById('login-modal')?.addEventListener('click', function(e) {
        if (e.target === this) closeLoginModal();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLoginModal();
      });

      // ══════════════════════════════════════════════════════════════
      // Form Submission Actions
      // ══════════════════════════════════════════════════════════════
      (function() {
        const loginForm = document.getElementById('login-form');
        const regForm = document.getElementById('register-form');

        // Validation states
        const idInput = document.getElementById('login-identity');
        const passInput = document.getElementById('login-password');
        const togglePass = document.getElementById('login-toggle-pass');
        let showPass = false;

        if (togglePass && passInput) {
          togglePass.addEventListener('click', function() {
            showPass = !showPass;
            passInput.type = showPass ? 'text' : 'password';
            this.querySelector('.material-symbols-outlined').textContent = showPass ? 'visibility' : 'visibility_off';
          });
        }

        // Real-time login validation
        if (idInput) {
          idInput.addEventListener('input', function() {
            const msgEl = this.closest('.auth-field').querySelector('.login-id-error');
            if (this.value.trim().length >= 3) {
              this.style.borderColor = 'rgba(16, 185, 129, 0.4)';
              if (msgEl) msgEl.style.opacity = '0';
            } else {
              this.style.borderColor = 'rgba(239, 68, 68, 0.4)';
              if (msgEl) { msgEl.textContent = 'Tối thiểu 3 ký tự'; msgEl.style.opacity = '1'; }
            }
          });
        }

        if (passInput) {
          passInput.addEventListener('input', function() {
            const msgEl = this.closest('.auth-field').querySelector('.login-pass-msg');
            if (this.value.length >= 6) {
              this.style.borderColor = 'rgba(16, 185, 129, 0.4)';
              if (msgEl) msgEl.style.opacity = '0';
            } else {
              this.style.borderColor = 'rgba(239, 68, 68, 0.4)';
              if (msgEl) { msgEl.textContent = 'Tối thiểu 6 ký tự'; msgEl.style.opacity = '1'; }
            }
          });
        }

        if (loginForm) {
          loginForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const identity = idInput?.value.trim() || '';
            const password = passInput?.value || '';

            if (identity.length < 3 || password.length < 6) {
              showGlobalToast('Kiểm tra lại thông tin đăng nhập!', 'error');
              return;
            }

            const submitBtn = document.getElementById('login-submit');
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">progress_activity</span><span>Đang xác thực...</span>';
            }

            try {
              const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ identity, password })
              });
              const data = await res.json();
              if (res.ok) {
                showGlobalToast('Đăng nhập thành công!', 'success');
                document.cookie = "txa_gate_passed=true; path=/; max-age=604800";
                if (typeof localStorage !== 'undefined') {
                  localStorage.setItem('tlogged_in_as', identity);
                  localStorage.removeItem('thistory');
                  fetch('/api/user/history')
                    .then(hRes => hRes.ok ? hRes.json() : [])
                    .then(historyData => {
                      if (Array.isArray(historyData)) {
                        localStorage.setItem('thistory', JSON.stringify(historyData));
                      }
                    })
                    .finally(() => {
                      window.dispatchEvent(new Event('auth-changed'));
                      closeLoginModal();
                      window.location.reload();
                    });
                } else {
                  window.dispatchEvent(new Event('auth-changed'));
                  closeLoginModal();
                  window.location.reload();
                }
              } else {
                showGlobalToast(data.message || data.error || 'Sai thông tin tài khoản!', 'error');
              }
            } catch (err) {
              showGlobalToast('Lỗi kết nối!', 'error');
            } finally {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>Đăng nhập</span>';
              }
            }
          });
        }

        // Register Validation & Submit
        const fields = ['reg-username', 'reg-email', 'reg-password', 'reg-confirm'];
        const validation = { username: false, email: false, password: false, confirmPassword: false };

        function validateRegisterField(id, val) {
          const input = document.getElementById(id);
          const parent = input?.closest('.auth-field');
          const errP = parent?.querySelector('.reg-error');
          let isValid = false, msg = '';

          if (id === 'reg-username') {
            if (val.length < 4) msg = 'Tối thiểu 4 ký tự';
            else if (!/^[a-zA-Z0-9_]+$/.test(val)) msg = 'Chỉ dùng chữ cái, số, gạch dưới';
            else isValid = true;
            validation.username = isValid;
          } else if (id === 'reg-email') {
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) msg = 'Định dạng email không hợp lệ';
            else isValid = true;
            validation.email = isValid;
          } else if (id === 'reg-password') {
            if (val.length < 6) msg = 'Tối thiểu 6 ký tự';
            else isValid = true;
            validation.password = isValid;
          } else if (id === 'reg-confirm') {
            const pw = document.getElementById('reg-password')?.value || '';
            if (val !== pw) msg = 'Mật khẩu xác nhận không khớp';
            else if (val.length >= 6) isValid = true;
            validation.confirmPassword = isValid;
          }

          if (input) input.style.borderColor = isValid ? 'rgba(16, 185, 129, 0.4)' : (val.length > 0 ? 'rgba(239, 68, 68, 0.4)' : '');
          if (errP) { errP.textContent = msg; errP.style.opacity = msg ? '1' : '0'; }
        }

        fields.forEach(id => {
          const input = document.getElementById(id);
          input?.addEventListener('input', function() {
            validateRegisterField(id, this.value);
          });
        });

        if (regForm) {
          regForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const allValid = Object.values(validation).every(v => v === true);
            const terms = document.getElementById('reg-terms')?.checked;

            if (!allValid) {
              showGlobalToast('Vui lòng kiểm tra lại thông tin đăng ký!', 'error');
              return;
            }
            if (!terms) {
              showGlobalToast('Bạn cần đồng ý với điều khoản dịch vụ!', 'error');
              return;
            }

            const submitBtn = document.getElementById('reg-submit');
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">progress_activity</span><span>Đang khởi tạo...</span>';
            }

            try {
              const body = {
                username: document.getElementById('reg-username')?.value.trim(),
                email: document.getElementById('reg-email')?.value.trim(),
                password: document.getElementById('reg-password')?.value,
                confirmPassword: document.getElementById('reg-confirm')?.value
              };
              const res = await fetch('/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
              });
              const data = await res.json();
              if (res.ok) {
                showGlobalToast(data.message || 'Đăng ký thành công! Vui lòng đăng nhập.', 'success');
                try {
                  const regUsers = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
                  if (!regUsers.some(u => u.username === body.username)) {
                    regUsers.push({
                      username: body.username,
                      email: body.email,
                      createdAt: new Date().toISOString()
                    });
                    localStorage.setItem('tregistered_users', JSON.stringify(regUsers));
                  }
                } catch (e) {
                  console.error('Error saving user registration locally:', e);
                }
                switchAuthTab('login');
              } else {
                showGlobalToast(data.message || data.error || 'Đăng ký thất bại!', 'error');
              }
            } catch (err) {
              showGlobalToast('Lỗi hệ thống!', 'error');
            } finally {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>Đăng ký tài khoản</span><span class="material-symbols-outlined text-[14px]">rocket_launch</span>';
              }
            }
          });
        }
      })();
    </script>
    <script is:inline>
      // Scroll effect - using is:inline + astro:page-load for reliability
      (function() {
        var _scrollHandler;
        function initScrollEffect() {
          if (_scrollHandler) window.removeEventListener('scroll', _scrollHandler);
          _scrollHandler = function() {
            var nav = document.getElementById('main-nav');
            var container = document.getElementById('nav-container');
            if (window.scrollY > 50) {
              container && container.classList.add('py-2');
              container && container.classList.remove('py-4');
              nav && nav.classList.add('bg-surface/95');
              nav && nav.classList.remove('bg-surface/60');
            } else {
              container && container.classList.add('py-4');
              container && container.classList.remove('py-2');
              nav && nav.classList.add('bg-surface/60');
              nav && nav.classList.remove('bg-surface/95');
            }
          };
          window.addEventListener('scroll', _scrollHandler);
          _scrollHandler();
        }

        // Run on initial load
        initScrollEffect();

        // Re-run on SPA navigation (Astro view transitions)
        document.addEventListener('astro:page-load', function() {
          initScrollEffect();
        });
      })();
    </script>
  </body>
</html>
