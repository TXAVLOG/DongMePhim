          const splash = document.getElementById('splash-screen');
          if (splash) {
            if (sessionStorage.getItem('dongphim_splash_shown')) {
              splash.style.display = 'none';
              splash.remove();
            } else {
              sessionStorage.setItem('dongphim_splash_shown', 'true');
              setTimeout(() => {
                splash.style.opacity = '0';
                splash.style.pointerEvents = 'none';
                setTimeout(() => {
