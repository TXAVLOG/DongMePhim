    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- PREMIUM UNIFIED AUTH MODAL (Redesigned Split Layout)            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div id="login-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/85 backdrop-blur-md transition-all duration-300 p-4" style="display:none;">
      <div class="relative w-[92%] sm:w-full max-w-[460px] overflow-hidden rounded-[28px] border border-glass-stroke shadow-[0_0_80px_rgba(0,0,0,0.8)] backdrop-blur-2xl bg-[#0f172a]/95 animate-[modalZoomIn_0.3s_cubic-bezier(0.34,1.56,0.64,1)] p-8 sm:p-10 flex flex-col justify-center">
        <!-- Close button -->
        <button onclick="closeLoginModal()" class="absolute right-5 top-5 text-on-surface-variant hover:text-white hover:rotate-90 transition-all duration-300 z-50 p-2 cursor-pointer bg-transparent border-none">
          <span class="material-symbols-outlined text-xl">close</span>
        </button>

        <!-- LOGIN TAB CONTENT -->
        <div id="auth-tab-login" class="space-y-6">
          <div>
            <h2 class="text-2xl font-black text-white tracking-tight font-display-hero">Đăng nhập</h2>
            <p class="text-xs text-on-surface-variant mt-2 font-semibold">
              Nếu bạn chưa có tài khoản, <span onclick="switchAuthTab('register')" class="text-primary hover:underline cursor-pointer font-bold">đăng ký ngay</span>
            </p>
          </div>
          
          <form id="login-form" class="space-y-4" novalidate>
            <div class="space-y-1.5 auth-field">
              <input type="text" id="login-identity" placeholder="Email hoặc tên đăng nhập..." class="w-full bg-white/5 border border-glass-stroke rounded-xl py-3 px-4 text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" required />
              <p class="login-id-error text-[10px] text-red-400 font-medium ml-1 h-3 opacity-0 transition-opacity"></p>
            </div>

            <div class="space-y-1.5 auth-field">
              <div class="relative">
                <input type="password" id="login-password" placeholder="Mật khẩu..." class="w-full bg-white/5 border border-glass-stroke rounded-xl py-3 pl-4 pr-12 text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" required />
                <button type="button" id="login-toggle-pass" class="absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-white transition-colors cursor-pointer bg-transparent border-none">
                  <span class="material-symbols-outlined text-lg">visibility_off</span>
                </button>
              </div>
              <p class="login-pass-msg text-[10px] text-red-400 font-medium ml-1 h-3 opacity-0 transition-opacity"></p>
            </div>

            <!-- Cloudflare Turnstile Captcha -->
            {settings.login?.turnstile_enable && (
              <div id="cf-turnstile-login" class="my-2 flex justify-center" data-sitekey={settings.login.turnstile_site_key}></div>
            )}

            <button type="submit" id="login-submit" class="w-full bg-gradient-to-r from-amber-400 to-amber-500 hover:brightness-110 text-slate-950 font-bold uppercase tracking-wider py-3.5 rounded-xl shadow-lg shadow-amber-400/10 transition-all flex items-center justify-center gap-2 mt-4 active:scale-95 cursor-pointer text-xs border-none">
              <span>Đăng nhập</span>
            </button>

            <div id="forgot-password-link-container" class="text-center pt-2 hidden">
              <span onclick="switchAuthTab('forgot-password')" class="text-xs font-semibold text-primary hover:underline cursor-pointer">Quên mật khẩu?</span>
            </div>

            {settings.login?.login_google_enable && settings.login?.login_google_client_id && settings.login?.login_google_client_id !== 'mock_google_id' && (
              <>
                <div class="relative flex py-2 items-center">
                  <div class="flex-grow border-t border-white/5"></div>
                  <span class="flex-shrink mx-4 text-[10px] text-zinc-600 font-bold uppercase tracking-widest">hoặc</span>
                  <div class="flex-grow border-t border-white/5"></div>
                </div>

                <!-- Google Login Button -->
                <button type="button" id="google-client-login-btn" data-clientid={settings.login.login_google_client_id} data-onetap={settings.login.login_google_onetap_enable ? "true" : "false"} class="w-full bg-white hover:bg-zinc-100 text-zinc-800 font-bold py-3 px-4 rounded-xl transition-all flex items-center justify-center gap-3 active:scale-95 cursor-pointer border-none shadow-md">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                  </svg>
                  <span class="text-xs">Đăng nhập bằng Google</span>
                </button>
              </>
            )}
          </form>
        </div>

        <!-- REGISTER TAB CONTENT -->
        <div id="auth-tab-register" class="space-y-5 hidden">
          <div>
            <h2 class="text-2xl font-black text-white tracking-tight font-display-hero">Đăng ký tài khoản</h2>
            <p class="text-xs text-on-surface-variant mt-1 font-semibold">
              Nếu bạn đã có tài khoản, <span onclick="switchAuthTab('login')" class="text-primary hover:underline cursor-pointer font-bold">đăng nhập ngay</span>
            </p>
          </div>
          
          <form id="register-form" class="space-y-3.5" novalidate>
            <!-- Username Field -->
            <div class="space-y-1 auth-field relative">
              <input type="text" id="reg-username" name="username" placeholder="Tên tài khoản..." class="w-full bg-white/5 border border-glass-stroke rounded-xl py-3 pl-4 pr-10 text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" required />
              <span class="validation-icon material-symbols-outlined absolute right-3.5 top-[13px] text-[18px] hidden select-none"></span>
              <p class="reg-error text-[9px] text-rose-400 font-medium ml-1 mt-0.5 opacity-0 transition-opacity" data-field="username"></p>
            </div>

            <!-- Email Field -->
            <div class="space-y-1 auth-field relative">
              <input type="email" id="reg-email" name="email" placeholder="Địa chỉ Email (Gmail, Outlook, iCloud)..." class="w-full bg-white/5 border border-glass-stroke rounded-xl py-3 pl-4 pr-10 text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" required />
              <span class="validation-icon material-symbols-outlined absolute right-3.5 top-[13px] text-[18px] hidden select-none"></span>
              <p class="reg-error text-[9px] text-rose-400 font-medium ml-1 mt-0.5 opacity-0 transition-opacity" data-field="email"></p>
            </div>

            <!-- Passwords Fields -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="space-y-1 auth-field relative">
                <input type="password" id="reg-password" name="password" placeholder="Mật khẩu..." class="w-full bg-white/5 border border-glass-stroke rounded-xl py-3 pl-4 pr-10 text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" required />
                <span class="validation-icon material-symbols-outlined absolute right-3.5 top-[13px] text-[18px] hidden select-none"></span>
                <p class="reg-error text-[9px] text-rose-400 font-medium ml-1 mt-0.5 opacity-0 transition-opacity" data-field="password"></p>
              </div>
              <div class="space-y-1 auth-field relative">
                <input type="password" id="reg-confirm" name="confirmPassword" placeholder="Xác nhận mật khẩu..." class="w-full bg-white/5 border border-glass-stroke rounded-xl py-3 pl-4 pr-10 text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" required />
                <span class="validation-icon material-symbols-outlined absolute right-3.5 top-[13px] text-[18px] hidden select-none"></span>
                <p class="reg-error text-[9px] text-rose-400 font-medium ml-1 mt-0.5 opacity-0 transition-opacity" data-field="confirmPassword"></p>
              </div>
            </div>

            <!-- Password Strength Bar & Conditions Indicator -->
            <div id="password-strength-container" class="glass-panel p-3.5 rounded-2xl border border-glass-stroke space-y-2.5 hidden">
              <div class="flex items-center justify-between">
                <span class="text-[9px] text-zinc-400 font-bold uppercase tracking-wider">Độ mạnh mật khẩu</span>
                <span id="strength-text" class="text-[9px] font-black text-zinc-500 uppercase tracking-widest">Trống</span>
              </div>
              <div class="flex gap-1.5 h-1.5 w-full rounded-full overflow-hidden bg-zinc-800/80">
                <div id="strength-bar-1" class="h-full w-1/4 rounded-full transition-all duration-300"></div>
                <div id="strength-bar-2" class="h-full w-1/4 rounded-full transition-all duration-300"></div>
                <div id="strength-bar-3" class="h-full w-1/4 rounded-full transition-all duration-300"></div>
                <div id="strength-bar-4" class="h-full w-1/4 rounded-full transition-all duration-300"></div>
              </div>
              <div id="password-conditions" class="grid grid-cols-2 gap-x-2 gap-y-1.5 pt-1.5 border-t border-white/5 text-[9px] text-zinc-500 font-semibold">
                <div class="flex items-center gap-1.5 condition-item" data-cond="length">
                  <span class="material-symbols-outlined text-[12px]">radio_button_unchecked</span>
                  <span>Tối thiểu 8 ký tự</span>
                </div>
                <div class="flex items-center gap-1.5 condition-item" data-cond="uppercase">
                  <span class="material-symbols-outlined text-[12px]">radio_button_unchecked</span>
                  <span>1 chữ viết hoa</span>
                </div>
                <div class="flex items-center gap-1.5 condition-item" data-cond="lowercase">
                  <span class="material-symbols-outlined text-[12px]">radio_button_unchecked</span>
                  <span>1 chữ viết thường</span>
                </div>
                <div class="flex items-center gap-1.5 condition-item" data-cond="number">
                  <span class="material-symbols-outlined text-[12px]">radio_button_unchecked</span>
                  <span>1 chữ số</span>
                </div>
                <div class="flex items-center gap-1.5 condition-item col-span-2" data-cond="special">
                  <span class="material-symbols-outlined text-[12px]">radio_button_unchecked</span>
                  <span>1 ký tự đặc biệt</span>
                </div>
              </div>
            </div>

            <!-- Cloudflare Turnstile Captcha -->
            {settings.login?.turnstile_enable && (
              <div id="cf-turnstile-register" class="my-2 flex justify-center" data-sitekey={settings.login.turnstile_site_key}></div>
            )}

            <label class="flex items-start gap-2.5 cursor-pointer group pt-1">
              <div class="relative flex items-center justify-center shrink-0 mt-0.5">
                <input type="checkbox" id="reg-terms" class="peer sr-only" required />
                <div class="h-4 w-4 rounded-md border border-glass-stroke bg-white/5 transition-all peer-checked:bg-primary peer-checked:border-primary font-bold"></div>
                <span class="material-symbols-outlined absolute text-[12px] text-white opacity-0 peer-checked:opacity-100 transition-opacity">check</span>
              </div>
              <span class="text-[10px] leading-snug font-semibold text-on-surface-variant group-hover:text-white select-none transition-colors">
                Tôi đồng ý với <a href="/terms" target="_blank" class="text-primary hover:underline font-bold">Điều khoản</a> và <a href="/privacy" target="_blank" class="text-primary hover:underline font-bold">Chính sách bảo mật</a>.
              </span>
            </label>

            <button type="submit" id="reg-submit" class="w-full bg-gradient-to-r from-amber-400 to-amber-500 hover:brightness-110 text-slate-950 font-bold uppercase tracking-wider py-3.5 rounded-xl shadow-lg shadow-amber-400/10 transition-all flex items-center justify-center gap-2 mt-4 active:scale-95 cursor-pointer text-xs border-none" disabled>
              <span>Đăng ký tài khoản</span>
            </button>
          </form>
        </div>

        <!-- FORGOT PASSWORD TAB CONTENT -->
        {isSmtpConfigured && (
          <div id="auth-tab-forgot-password" class="space-y-6 hidden">
            <div>
              <h2 class="text-2xl font-black text-white tracking-tight font-display-hero">Khôi phục mật khẩu</h2>
              <p class="text-xs text-on-surface-variant mt-2 font-semibold">
                Nhập email để nhận liên kết khôi phục, hoặc <span onclick="switchAuthTab('login')" class="text-primary hover:underline cursor-pointer font-bold">quay lại đăng nhập</span>
              </p>
            </div>

            <form id="forgot-password-form" class="space-y-4" novalidate>
              <div class="space-y-1.5 auth-field">
                <input type="email" id="forgot-email" name="email" placeholder="Nhập địa chỉ Email..." class="w-full bg-white/5 border border-glass-stroke rounded-xl py-3 px-4 text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" required />
                <p class="forgot-email-error text-[10px] text-red-400 font-medium ml-1 h-3 opacity-0 transition-opacity"></p>
              </div>

              <!-- Cloudflare Turnstile Captcha -->
              {settings.login?.turnstile_enable && (
                <div id="cf-turnstile-forgot" class="my-2 flex justify-center" data-sitekey={settings.login.turnstile_site_key}></div>
              )}

              <button type="submit" id="forgot-submit" class="w-full bg-gradient-to-r from-amber-400 to-amber-500 hover:brightness-110 text-slate-950 font-bold uppercase tracking-wider py-3.5 rounded-xl shadow-lg shadow-amber-400/10 transition-all flex items-center justify-center gap-2 mt-4 active:scale-95 cursor-pointer text-xs border-none">
                <span>Gửi yêu cầu phục hồi</span>
              </button>
            </form>
          </div>
        )}

      </div>
    </div>

    <!-- Global Modal Container -->
    <div id="txa-global-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4 transition-all duration-300 opacity-0">
      <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-6 shadow-2xl max-w-md w-full transform scale-95 transition-all duration-300 flex flex-col gap-4">
        <div class="flex items-center justify-between pb-2 border-b border-white/5">
          <h3 id="txa-modal-title" class="text-lg font-semibold text-white">Xác nhận</h3>
          <button id="txa-modal-close" class="text-zinc-400 hover:text-white transition-colors bg-transparent border-none cursor-pointer">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div id="txa-modal-body" class="text-sm text-zinc-300 font-body-main py-2">
        </div>
        <div class="flex justify-end gap-3 pt-2">
          <button id="txa-modal-cancel" class="px-4 py-2 rounded-xl text-xs font-semibold bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-zinc-300 transition-all hidden">Hủy</button>
          <button id="txa-modal-confirm" class="px-4 py-2 rounded-xl text-xs font-semibold bg-primary hover:bg-primary/90 text-white transition-all border-none cursor-pointer">Xác nhận</button>
        </div>
      </div>
    </div>

    <!-- Toast Container (global) -->
    <div id="txa-toast-container" class="fixed bottom-6 right-6 z-[100000] flex flex-col gap-2"></div>

    <div class="min-h-screen">
      <slot />
    </div>

    <!-- Footer -->
    <footer class="bg-surface-container-lowest py-section-gap border-t border-glass-stroke mt-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter px-gutter max-w-container-max mx-auto">
            <div class="space-y-4">
                <div class="flex items-center gap-2">
                    <img src="/logo-icon.gif" alt={`${settings.general.site_name} Logo`} class="h-8 w-auto dyn-logo-img grayscale opacity-80" />
                    <div class="font-display-hero text-title-md font-bold text-primary dyn-site-name">{settings.general.site_name}</div>
