          if (code === decoyPasscode) {
            closeBypassModal();
            localStorage.setItem('txa_referred_token', 'true');
            if (window.showToast) {
              window.showToast("Mật mã chính xác! Chào mừng bạn.", "success");
            }
            
            // Cập nhật class hiển thị giao diện qua checkTxaGate
            if (typeof window.checkTxaGate === 'function') {
              window.checkTxaGate();
            } else if (typeof checkTxaGate === 'function') {
              checkTxaGate();
            } else {
              document.documentElement.classList.remove('gate-decoy');
              if (zaloLockEnable === false) {
                document.documentElement.classList.add('gate-passed');
              } else {
                document.documentElement.classList.add('gate-zalo');
              }
            }

            // Kiểm tra Zalo Lock
            if (zaloLockEnable === false) {
              setTimeout(() => window.location.reload(), 1000);
            } else {
              // Check status Zalo
              checkZaloStatusOnLoad();
            }
          } else {
            if (window.showToast) {
              window.showToast("Mật mã không chính xác!", "error");
            }
          }
        };

        // 2. Điểu khiển Modal Zalo
        window.openZaloModal = function() {
          const status = localStorage.getItem('zalo_access_status') || (document.cookie.includes('txa_gate_passed=true') ? 'approved' : '');
          if (status === 'approved') {
            document.cookie = "txa_gate_passed=true; path=/; max-age=604800";
            if (window.showToast) window.showToast('Truy cập đã được phê duyệt!', 'success');
            document.documentElement.classList.remove('gate-zalo');
            document.documentElement.classList.add('gate-passed');
            if (window.location.pathname !== '/tphim') {
              setTimeout(() => {
                window.location.href = '/tphim';
              }, 1000);
            }
            return;
          }
          if (status === 'pending') {
            if (window.showToast) window.showToast('Yêu cầu đang chờ duyệt. Hệ thống kiểm tra tự động...', 'info');
            return;
          }
          
          const modal = document.getElementById('zalo-auth-modal');
          if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            renderZaloQR();
          }
        };

        window.closeZaloModal = function() {
          const modal = document.getElementById('zalo-auth-modal');
          if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          }
        };

        // Vẽ QR Code
        let qrRendered = false;
        function renderZaloQR() {
          if (qrRendered) return;
          
          const canvasEl = document.getElementById('zalo-qr-canvas');
          if (!canvasEl) return;

          function drawQR() {
            if (!window.QRCodeStyling) return;
            canvasEl.innerHTML = '';
            const qrCode = new window.QRCodeStyling({
              width: 156,
              height: 156,
              type: "svg",
              data: zaloGroupUrl,
              image: "/favicon.png",
              dotsOptions: {
                color: "#a78bfa",
                type: "rounded"
              },
              backgroundOptions: {
                color: "transparent",
              },
              imageOptions: {
                crossOrigin: "anonymous",
                margin: 4
              },
              cornersSquareOptions: {
                color: "#60a5fa",
                type: "extra-rounded"
              },
              cornersDotOptions: {
                color: "#a78bfa",
                type: "dot"
              }
            });
            qrCode.append(canvasEl);
            qrRendered = true;
          }

          if (window.QRCodeStyling) {
            drawQR();
          } else {
            const script = document.createElement('script');
            script.src = 'https://unpkg.com/qr-code-styling@1.5.0/lib/qr-code-styling.js';
            script.async = true;
            script.onload = drawQR;
            document.body.appendChild(script);
          }
        }

        // Đăng ký Zalo
        window.handleZaloRegister = async function(e) {
          e.preventDefault();
          const nickname = document.getElementById('zalo-nickname-input').value.trim();
          if (!nickname) return;

          const submitBtn = document.getElementById('zalo-submit-btn');
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<i class="fas fa-spinner animate-spin"></i> <span>Đang đăng ký...</span>';

          try {
            const userEmail = localStorage.getItem('tlogged_in_as') || null;
            const res = await fetch('/api/auth/zalo-request', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                token: browserToken,
                nickname: nickname,
                email: userEmail
              })
            });
            const data = await res.json();
            if (res.ok) {
              if (window.showToast) window.showToast('Gửi yêu cầu thành công! Vui lòng chờ phê duyệt.', 'success');
              localStorage.setItem('zalo_access_status', 'pending');
              closeZaloModal();
              updateZaloUI('pending');
              startZaloPolling();
            } else {
              if (window.showToast) window.showToast(data.message || 'Đăng ký thất bại', 'error');
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> <span>Gửi yêu cầu duyệt</span>';
            }
          } catch (err) {
            if (window.showToast) window.showToast('Lỗi kết nối mạng!', 'error');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> <span>Gửi yêu cầu duyệt</span>';
          }
        };

        // Polling duyệt Zalo
        let pollingInterval = null;
        function startZaloPolling() {
          if (pollingInterval) clearInterval(pollingInterval);
          pollingInterval = setInterval(async () => {
            try {
              const res = await fetch('/api/auth/zalo-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token: browserToken })
              });
              const data = await res.json();
              if (res.ok) {
                const status = data.data ? data.data.status : data.status;
                if (status === 'approved') {
                  clearInterval(pollingInterval);
                  localStorage.setItem('zalo_access_status', 'approved');
                  document.cookie = "txa_gate_passed=true; path=/; max-age=604800";
                  updateZaloUI('approved');
                  if (window.showToast) {
                    window.showToast('Yêu cầu truy cập Zalo của bạn đã được phê duyệt thành công!', 'success');
                  }
                  
                  setTimeout(() => {
                    document.documentElement.classList.remove('gate-zalo');
                    document.documentElement.classList.add('gate-passed');
                    if (window.location.pathname !== '/tphim') {
                      window.location.href = '/tphim';
                    }
                  }, 1500);
                } else if (status === 'rejected') {
                  clearInterval(pollingInterval);
                  localStorage.removeItem('zalo_access_status');
                  // Tạo token mới để họ có thể gửi yêu cầu khác
                  localStorage.removeItem('zalo_browser_token');
                  if (window.showToast) window.showToast('Yêu cầu duyệt của bạn bị Admin từ chối!', 'error');
                  updateZaloUI('none');
                }
              }
            } catch (e) {}
          }, 4000);
        }

        // Cập nhật UI nút bấm
        function updateZaloUI(status) {
          const navBtn = document.getElementById('zalo-status-btn-nav');
          const mainBtn = document.getElementById('zalo-status-btn-main');
          
          if (status === 'pending') {
            if (navBtn) {
              navBtn.textContent = 'Chờ duyệt';
              navBtn.className = 'px-5 py-2.5 bg-amber-500/20 border border-amber-500/30 rounded-full text-[10px] font-black uppercase text-amber-400 tracking-widest cursor-not-allowed';
              navBtn.disabled = true;
            }
            if (mainBtn) {
              mainBtn.innerHTML = '<i class="fas fa-spinner animate-spin"></i> <span>Chờ duyệt... (Tự động cập nhật)</span>';
              mainBtn.className = 'w-full sm:w-auto px-8 py-4.5 bg-amber-500/10 border border-amber-500/30 text-amber-400 rounded-2xl text-xs font-black uppercase tracking-wider flex items-center justify-center gap-3 cursor-not-allowed';
              mainBtn.disabled = true;
            }
          } else if (status === 'approved') {
            if (navBtn) {
              navBtn.textContent = 'Đã duyệt';
              navBtn.className = 'px-5 py-2.5 bg-rose-600 text-white rounded-full text-[10px] font-black uppercase tracking-widest hover:shadow-[0_0_20px_rgba(244,63,94,0.4)] transition-all cursor-pointer border-none';
              navBtn.disabled = false;
            }
            if (mainBtn) {
              mainBtn.innerHTML = '<i class="fas fa-check-circle text-lg animate-pulse"></i> <span>Đã duyệt! Vào xem ngay</span>';
              mainBtn.className = 'w-full sm:w-auto px-8 py-4.5 bg-rose-600 hover:bg-rose-700 text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-[0_0_30px_rgba(244,63,94,0.35)] hover:shadow-[0_0_40px_rgba(244,63,94,0.55)] hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer border-none';
              mainBtn.disabled = false;
            }
          } else {
            if (navBtn) {
              navBtn.textContent = 'Xác thực';
              navBtn.className = 'px-5 py-2.5 bg-gradient-to-r from-purple-600 to-pink-600 rounded-full text-[10px] font-black uppercase tracking-widest hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all cursor-pointer border-none';
              navBtn.disabled = false;
            }
            if (mainBtn) {
              mainBtn.innerHTML = '<i class="fas fa-shield-halved text-lg"></i> <span>Khám phá ngay</span>';
              mainBtn.className = 'w-full sm:w-auto px-8 py-4.5 bg-gradient-to-r from-purple-600 via-purple-600 to-indigo-600 text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-[0_0_30px_rgba(124,58,237,0.25)] hover:shadow-[0_0_40px_rgba(124,58,237,0.45)] hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer border-none';
              mainBtn.disabled = false;
            }
          }
        }

        // Kiểm tra trạng thái khi tải trang
        async function checkZaloStatusOnLoad() {
          if (zaloLockEnable === false) return;
          const status = localStorage.getItem('zalo_access_status');
          
          if (status === 'approved') {
            document.documentElement.classList.add('gate-passed');
            return;
          }

          updateZaloUI(status);

          if (status === 'pending') {
            startZaloPolling();
          }

          // Gọi API đồng bộ trạng thái thực tế từ server
          try {
            const userEmail = localStorage.getItem('tlogged_in_as') || null;
            const res = await fetch('/api/auth/zalo-status', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                token: browserToken,
                email: userEmail
              })
            });
            const data = await res.json();
            if (res.ok) {
              const currentStatus = data.data ? data.data.status : data.status;
              if (currentStatus) {
                localStorage.setItem('zalo_access_status', currentStatus);
                updateZaloUI(currentStatus);

                if (currentStatus === 'approved') {
                  if (pollingInterval) clearInterval(pollingInterval);
                  document.cookie = "txa_gate_passed=true; path=/; max-age=604800";
                  if (window.showToast) {
                    window.showToast('Yêu cầu truy cập Zalo của bạn đã được phê duyệt thành công!', 'success');
                  }
                  setTimeout(() => {
                    document.documentElement.classList.remove('gate-zalo');
                    document.documentElement.classList.add('gate-passed');
                    if (window.location.pathname !== '/tphim') {
                      window.location.href = '/tphim';
                    }
                  }, 1500);
                } else if (currentStatus === 'pending') {
                  startZaloPolling();
                } else {
                  if (pollingInterval) clearInterval(pollingInterval);
                }
              }
            }
          } catch(e) {}
        }

        // Lắng nghe sự kiện để check status khi load
        initBrowserToken();

        // Logo click bypass ở cổng Zalo
        window.handleZaloLogoClick = function() {
          handleDecoyLogoClick();
        };

      })();
    </script>
  </body>
</html>
