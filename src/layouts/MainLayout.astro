    <script is:inline>
      // ══════════════════════════════════════════════════════════════
      // Auth State Manager
      // ══════════════════════════════════════════════════════════════
      function updateAuthState() {
        const isLoggedIn = document.cookie.includes('txa_gate_passed');
        const guestViews = document.querySelectorAll('.auth-guest');
        const userViews = document.querySelectorAll('.auth-user');
        
        if (isLoggedIn) {
          guestViews.forEach(el => el.classList.add('hidden'));
          userViews.forEach(el => el.classList.remove('hidden'));

          // Check VIP expiry
          if (typeof localStorage !== 'undefined') {
            const username = localStorage.getItem('tlogged_in_as');
            if (username) {
              let isVIP = false;
              let userInDb = null;
              
              // 1. Look up user in tregistered_users
              const usersStr = localStorage.getItem('tregistered_users');
              if (usersStr) {
                try {
                  const users = JSON.parse(usersStr);
                  userInDb = users.find(u => u.username === username || u.email === username);
                } catch(e) {}
              }

              // 2. Check VIP package in registered database
              if (userInDb && userInDb.package && userInDb.package.includes('VIP')) {
                const expiryStr = userInDb.expiryDate;
                if (expiryStr) {
                  const expiry = new Date(expiryStr);
                  const now = new Date();
                  if (now > expiry) {
                    // Expired in database
                    userInDb.package = 'Free';
                    userInDb.status = 'standard';
                    localStorage.setItem('tregistered_users', JSON.stringify(JSON.parse(usersStr).map(u => (u.username === username || u.email === username) ? userInDb : u)));
                    localStorage.removeItem('txa_user_subscription');
                    if (window.showGlobalToast) {
                      window.showGlobalToast('Gói đăng ký VIP của bạn đã hết hạn. Tài khoản được chuyển về gói Miễn phí.', 'info', 5000);
                    }
                  } else {
                    isVIP = true;
                    // Sync with txa_user_subscription
                    localStorage.setItem('txa_user_subscription', JSON.stringify({
                      username: username,
                      tier: userInDb.package,
                      status: 'active',
                      expiry: expiry.toISOString()
                    }));
                  }
                } else {
                  isVIP = true; // No expiry means lifetime VIP
                }
              } else {
                // 3. Fallback check txa_user_subscription key directly
                const subStr = localStorage.getItem('txa_user_subscription');
                if (subStr) {
                  try {
                    const sub = JSON.parse(subStr);
                    const expiryStr = sub.expiresAt || sub.expiry;
                    if (expiryStr) {
                      const expiry = new Date(expiryStr);
                      const now = new Date();
                      if (now > expiry) {
                        localStorage.removeItem('txa_user_subscription');
                        if (window.showGlobalToast) {
                          window.showGlobalToast('Gói đăng ký VIP của bạn đã hết hạn. Tài khoản được chuyển về gói Miễn phí.', 'info', 5000);
                        }
                      } else {
                        isVIP = true;
                      }
                    } else if (sub.status === 'active' || (sub.tier && sub.tier.includes('VIP'))) {
                      isVIP = true;
                    }
                  } catch (e) {
                    console.error('Error parsing user sub:', e);
                  }
                }
              }

              // Update profile dropdown values
              const userEl = document.getElementById('dropdown-username');
              const badgeEl = document.getElementById('dropdown-badge');
              if (userEl) userEl.textContent = username;
              if (badgeEl) {
                if (isVIP) {
                  badgeEl.textContent = 'VIP MEMBER';
                  badgeEl.className = 'text-[9px] font-black px-1.5 py-0.5 rounded w-max select-none bg-gradient-to-r from-violet-600 to-cyan-500 text-white uppercase font-label-caps';
                } else {
                  badgeEl.textContent = 'Cơ Bản';
                  badgeEl.className = 'text-[9px] font-bold px-1.5 py-0.5 rounded w-max select-none bg-zinc-800 text-zinc-400 uppercase font-label-caps';
                }
              }
            }
          }
        } else {
          guestViews.forEach(el => el.classList.remove('hidden'));
          userViews.forEach(el => el.classList.add('hidden'));
        }
      }

      // Global Modal Controller
      window.txamodal = {
        show: (options) => {
          const modal = document.getElementById('txa-global-modal');
          if (!modal) return;
          const modalBox = modal.querySelector('div');
          const titleEl = document.getElementById('txa-modal-title');
          const bodyEl = document.getElementById('txa-modal-body');
          const confirmBtn = document.getElementById('txa-modal-confirm');
          const cancelBtn = document.getElementById('txa-modal-cancel');
          const closeBtn = document.getElementById('txa-modal-close');

          titleEl.innerHTML = options.title || 'Thông báo';
          
          if (options.content instanceof HTMLElement) {
            bodyEl.innerHTML = '';
            bodyEl.appendChild(options.content);
          } else {
            bodyEl.innerHTML = options.message || options.content || '';
          }
          
          confirmBtn.textContent = options.confirmText || 'Xác nhận';
          if (options.cancelText) {
            cancelBtn.textContent = options.cancelText;
            cancelBtn.classList.remove('hidden');
          } else {
            cancelBtn.classList.add('hidden');
          }

          if (options.type === 'danger' || options.type === 'error') {
            confirmBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-500 text-white transition-all border-none cursor-pointer';
          } else {
            confirmBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold bg-violet-600 hover:bg-violet-500 text-white transition-all border-none cursor-pointer';
          }

          const closeModal = () => {
            modal.classList.add('opacity-0');
            modalBox.classList.add('scale-95');
            setTimeout(() => {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
              bodyEl.innerHTML = '';
            }, 200);
            document.body.style.overflow = '';
          };

          confirmBtn.onclick = () => {
            closeModal();
            if (typeof options.onConfirm === 'function') options.onConfirm();
          };

          cancelBtn.onclick = () => {
            closeModal();
            if (typeof options.onCancel === 'function') options.onCancel();
          };

          closeBtn.onclick = closeModal;
          modal.onclick = (e) => {
            if (e.target === modal) closeModal();
          };

          document.body.style.overflow = 'hidden';
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalBox.classList.remove('scale-95');
          }, 10);
        }
      };

      // ─── CLOUDFLARE TURNSTILE INTEGRATION ───
      let turnstileScriptLoaded = false;
      let turnstileLoginWidgetId = null;
      let turnstileRegisterWidgetId = null;
      let turnstileForgotWidgetId = null;

      function initTurnstile() {
        const loginEl = document.getElementById('cf-turnstile-login');
        const registerEl = document.getElementById('cf-turnstile-register');
        const forgotEl = document.getElementById('cf-turnstile-forgot');
        if (!loginEl && !registerEl && !forgotEl) return;

        if (turnstileScriptLoaded) {
          renderTurnstileWidgets();
          return;
        }

        window.onloadTurnstileCallback = function() {
          turnstileScriptLoaded = true;
          renderTurnstileWidgets();
        };

        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback&render=explicit';
        script.async = true;
        script.defer = true;
        document.head.appendChild(script);
      }

      function renderTurnstileWidgets() {
        if (typeof turnstile === 'undefined') return;
        
        const loginEl = document.getElementById('cf-turnstile-login');
        if (loginEl && loginEl.innerHTML === '') {
          const sitekey = loginEl.dataset.sitekey;
          if (sitekey) {
            turnstileLoginWidgetId = turnstile.render('#cf-turnstile-login', {
              sitekey: sitekey,
              theme: 'dark',
              callback: function(token) {
                window.txaTurnstileTokenLogin = token;
                if (window.checkLoginFormValidity) window.checkLoginFormValidity();
              }
            });
          }
        }

        const registerEl = document.getElementById('cf-turnstile-register');
        if (registerEl && registerEl.innerHTML === '') {
          const sitekey = registerEl.dataset.sitekey;
          if (sitekey) {
            turnstileRegisterWidgetId = turnstile.render('#cf-turnstile-register', {
              sitekey: sitekey,
              theme: 'dark',
              callback: function(token) {
                window.txaTurnstileTokenRegister = token;
                if (window.checkFormValidity) window.checkFormValidity();
              }
            });
          }
        }

        const forgotEl = document.getElementById('cf-turnstile-forgot');
        if (forgotEl && forgotEl.innerHTML === '') {
          const sitekey = forgotEl.dataset.sitekey;
          if (sitekey) {
            turnstileForgotWidgetId = turnstile.render('#cf-turnstile-forgot', {
              sitekey: sitekey,
              theme: 'dark',
              callback: function(token) {
                window.txaTurnstileTokenForgot = token;
              }
            });
          }
        }
      }

      function resetTurnstileWidgets() {
        if (typeof turnstile === 'undefined') return;
        window.txaTurnstileTokenLogin = null;
        window.txaTurnstileTokenRegister = null;
        window.txaTurnstileTokenForgot = null;
        if (turnstileLoginWidgetId !== null) {
          try { turnstile.reset(turnstileLoginWidgetId); } catch(e) {}
        }
        if (turnstileRegisterWidgetId !== null) {
          try { turnstile.reset(turnstileRegisterWidgetId); } catch(e) {}
        }
        if (turnstileForgotWidgetId !== null) {
          try { turnstile.reset(turnstileForgotWidgetId); } catch(e) {}
        }
      }

      // ─── GOOGLE CLIENT LOGIN (TOKEN CLIENT) ───
      let googleGsiLoaded = false;
      let tokenClient = null;

      function initGoogleClientLogin() {
        const btn = document.getElementById('google-client-login-btn');
        if (!btn) return;
        const clientId = btn.dataset.clientid;
        if (!clientId) return;

        if (googleGsiLoaded) return;

        const script = document.createElement('script');
        script.src = 'https://accounts.google.com/gsi/client';
        script.async = true;
        script.defer = true;
        script.onload = () => {
          googleGsiLoaded = true;
          tokenClient = google.accounts.oauth2.initTokenClient({
            client_id: clientId,
            scope: 'https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/userinfo.email',
            callback: (tokenResponse) => {
              if (tokenResponse && tokenResponse.access_token) {
                fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
                  headers: { Authorization: `Bearer ${tokenResponse.access_token}` }
                })
                .then(res => res.json())
                .then(profile => {
                  handleOAuthSuccess({
                    id: profile.sub,
                    name: profile.name,
                    email: profile.email,
                    avatar: profile.picture,
                    provider: 'Google'
                  });
                })
                .catch(err => {
                  console.error(err);
                  if (window.showGlobalToast) window.showGlobalToast('Không thể lấy thông tin profile Google', 'error');
                });
              }
            }
          });
        };
        document.head.appendChild(script);
      }

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('#google-client-login-btn');
        if (btn) {
          if (tokenClient) {
            tokenClient.requestAccessToken();
          } else {
            initGoogleClientLogin();
            let checks = 0;
            const interval = setInterval(() => {
              checks++;
              if (tokenClient) {
                clearInterval(interval);
                tokenClient.requestAccessToken();
              } else if (checks > 20) {
                clearInterval(interval);
              }
            }, 100);
          }
        }
      });

      // ─── GOOGLE ONE-TAP FOR CLIENT ───
      function initGoogleOneTap() {
        const isLoggedIn = document.cookie.includes('txa_gate_passed');
        if (isLoggedIn) return;

        const btn = document.getElementById('google-client-login-btn');
        if (!btn) return;
        const clientId = btn.dataset.clientid;
        const isOneTapEnabled = btn.dataset.onetap === 'true';
        if (!clientId || clientId === 'mock_google_id' || !isOneTapEnabled) return;

        const loadOneTap = () => {
          if (typeof google === 'undefined') return;
          google.accounts.id.initialize({
            client_id: clientId,
            callback: (response) => {
              fetch('/api/auth/google-login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ credential: response.credential })
              })
              .then(res => res.json())
              .then(data => {
                if (data.success && data.user) {
                  handleOAuthSuccess({
                    id: data.user.sub,
                    name: data.user.name,
                    email: data.user.email,
                    avatar: data.user.picture,
                    provider: 'Google'
                  });
                }
              });
            }
          });
          google.accounts.id.prompt();
        };

        if (typeof google !== 'undefined') {
          loadOneTap();
        } else {
          const script = document.createElement('script');
          script.src = 'https://accounts.google.com/gsi/client';
          script.async = true;
          script.defer = true;
          script.onload = loadOneTap;
          document.head.appendChild(script);
        }
      }

      // ─── OAUTH CALLBACK RESPONSE LISTENER ───
      window.addEventListener('message', (event) => {
        if (event.data && event.data.type === 'txa-oauth-callback-response') {
          const { success, error, profile } = event.data;
          if (success && profile) {
            handleOAuthSuccess(profile);
          } else {
            if (window.showGlobalToast) window.showGlobalToast(error || 'Đăng nhập OAuth thất bại!', 'error');
          }
        }
      });

      // ─── OAUTH SUCCESS & NEW USER ADDR PICKER ───
      function handleOAuthSuccess(profile) {
        const username = profile.email || profile.id;
        const usersStr = localStorage.getItem('tregistered_users') || '[]';
        let users = [];
        try { users = JSON.parse(usersStr); } catch (e) {}

        const userExists = users.some(u => u.username === username || u.email === username);
        
        const performLogin = (addressInfo = null) => {
          if (!userExists) {
            users.push({
              username: username,
              email: profile.email || '',
              createdAt: new Date().toISOString(),
              avatar: profile.avatar || '',
              provider: profile.provider,
              address: addressInfo,
              package: 'Free',
              status: 'active',
              roles: 'users',
              emailVerified: true
            });
            localStorage.setItem('tregistered_users', JSON.stringify(users));
          }

          document.cookie = "txa_gate_passed=true; path=/; max-age=604800";
          localStorage.setItem('tlogged_in_as', username);

          // Auto pass decoy if admin
          try {
            const usersList = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
            const user = usersList.find(u => u.username.toLowerCase() === username.toLowerCase() || u.email.toLowerCase() === username.toLowerCase());
            if (user && (user.role === 'admin' || user.is_admin === true || user.is_admin === 'true')) {
              localStorage.setItem('txa_referred_token', 'true');
            }
          } catch(e) {}

          localStorage.removeItem('thistory');
          
          window.dispatchEvent(new Event('auth-changed'));
          if (typeof window.checkTxaGate === 'function') {
            window.checkTxaGate();
          }

          if (window.showGlobalToast) window.showGlobalToast(`Chào mừng ${profile.name}! Đăng nhập thành công.`, 'success');
          
          setTimeout(() => {
            window.location.reload();
          }, 1000);
        };

        if (!userExists) {
          const container = document.createElement('div');
          container.className = 'space-y-4';
          container.innerHTML = `
            <p class="text-xs text-zinc-400">Chào mừng thành viên mới! Vui lòng bổ sung thông tin địa chỉ để hoàn tất:</p>
            <div class="space-y-3">
              <div class="space-y-1">
                <label class="text-[10px] text-zinc-500 font-bold uppercase">Tỉnh / Thành phố</label>
                <select id="addr-province" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-primary">
                  <option value="">-- Chọn Tỉnh / Thành phố --</option>
                  <option value="Hà Nội">Hà Nội</option>
                  <option value="Hồ Chí Minh">TP. Hồ Chí Minh</option>
                  <option value="Đà Nẵng">Đà Nẵng</option>
                  <option value="Hải Phòng">Hải Phòng</option>
                  <option value="Cần Thơ">Cần Thơ</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class="text-[10px] text-zinc-500 font-bold uppercase">Quận / Huyện</label>
                <select id="addr-district" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-primary" disabled>
                  <option value="">-- Chọn Quận / Huyện --</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class="text-[10px] text-zinc-500 font-bold uppercase">Xã / Phường / Thị trấn</label>
                <select id="addr-ward" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-primary" disabled>
                  <option value="">-- Chọn Xã / Phường --</option>
                </select>
              </div>
            </div>
          `;

          const districts = {
            'Hà Nội': ['Ba Đình', 'Hoàn Kiếm', 'Đống Đa', 'Cầu Giấy', 'Hai Bà Trưng'],
            'Hồ Chí Minh': ['Quận 1', 'Quận 3', 'Quận 7', 'Bình Thạnh', 'Thủ Đức'],
            'Đà Nẵng': ['Hải Châu', 'Thanh Khê', 'Sơn Trà', 'Ngũ Hành Sơn'],
            'Hải Phòng': ['Hồng Bàng', 'Lê Chân', 'Ngô Quyền', 'Hải An'],
            'Cần Thơ': ['Ninh Kiều', 'Bình Thủy', 'Cái Răng', 'Ô Môn']
          };

          const wards = {
            'Ba Đình': ['Trúc Bạch', 'Vĩnh Phúc', 'Cống Vị', 'Liễu Giai'],
            'Hoàn Kiếm': ['Hàng Bạc', 'Hàng Đào', 'Tràng Tiền', 'Lý Thái Tổ'],
            'Quận 1': ['Bến Nghé', 'Bến Thành', 'Đa Kao', 'Tân Định'],
            'Quận 3': ['Phường 1', 'Phường 2', 'Phường 3', 'Phường 4'],
            'Hải Châu': ['Hải Châu I', 'Hải Châu II', 'Thạch Thang', 'Thuận Phước']
          };

          setTimeout(() => {
            const provSel = document.getElementById('addr-province');
            const distSel = document.getElementById('addr-district');
            const wardSel = document.getElementById('addr-ward');

            if (provSel && distSel && wardSel) {
              provSel.addEventListener('change', () => {
                const prov = provSel.value;
                distSel.innerHTML = '<option value="">-- Chọn Quận / Huyện --</option>';
                wardSel.innerHTML = '<option value="">-- Chọn Xã / Phường --</option>';
                wardSel.disabled = true;
                
                if (prov && districts[prov]) {
                  districts[prov].forEach(d => {
                    distSel.innerHTML += `<option value="${d}">${d}</option>`;
                  });
                  distSel.disabled = false;
                } else {
                  distSel.disabled = true;
                }
              });

              distSel.addEventListener('change', () => {
                const dist = distSel.value;
                wardSel.innerHTML = '<option value="">-- Chọn Xã / Phường --</option>';
                
                if (dist && wards[dist]) {
                  wards[dist].forEach(w => {
                    wardSel.innerHTML += `<option value="${w}">${w}</option>`;
                  });
                  wardSel.disabled = false;
                } else if (dist) {
                  ['Phường A', 'Phường B', 'Xã C', 'Xã D'].forEach(w => {
                    wardSel.innerHTML += `<option value="${w}">${w}</option>`;
                  });
                  wardSel.disabled = false;
                } else {
                  wardSel.disabled = true;
                }
              });
            }
          }, 50);

          if (window.txamodal) {
            window.txamodal.show({
              title: 'Bổ sung địa chỉ đăng ký',
              content: container,
              confirmText: 'Hoàn tất',
              cancelText: 'Bỏ qua',
              onConfirm: () => {
                const prov = document.getElementById('addr-province')?.value;
                const dist = document.getElementById('addr-district')?.value;
                const ward = document.getElementById('addr-ward')?.value;
                
                const addressInfo = (prov && dist && ward) ? { province: prov, district: dist, ward: ward } : null;
                performLogin(addressInfo);
              },
              onCancel: () => {
                performLogin(null);
              }
            });
          } else {
            performLogin(null);
          }
        } else {
          performLogin(null);
        }
      }

      updateAuthState();
      window.addEventListener('auth-changed', updateAuthState);
      document.addEventListener('astro:after-swap', () => {
        updateAuthState();
        initGoogleOneTap();
      });
      document.addEventListener('astro:page-load', () => {
        updateAuthState();
        initGoogleOneTap();
      });

      window.logout = function() {
        document.cookie = "txa_gate_passed=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
        if (typeof localStorage !== 'undefined') {
          localStorage.removeItem('tlogged_in_as');
          localStorage.removeItem('thistory');
        }
        window.dispatchEvent(new Event('auth-changed'));
        if (window.showGlobalToast) {
          window.showGlobalToast('Đã đăng xuất', 'success');
        }
        
        setTimeout(() => {
          window.location.href = '/tphim';
        }, 800);
      };

      // ══════════════════════════════════════════════════════════════
      // Global Toast Manager (Stackable, supports calling via Console/JS)
      // ══════════════════════════════════════════════════════════════
      (function() {
        window.showGlobalToast = function(message, type = 'success', duration = 3000) {
          let container = document.getElementById('txa-toast-container');
          if (!container) {
            container = document.createElement('div');
            container.id = 'txa-toast-container';
            container.className = 'fixed bottom-6 right-6 z-[100000] flex flex-col gap-2 pointer-events-none';
            document.body.appendChild(container);
          }
          
          const toast = document.createElement('div');
          toast.className = 'pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl shadow-xl border border-white/10 backdrop-blur-md bg-[#12141d]/90 text-white transition-all duration-300 transform translate-y-2 opacity-0';
          
          const icons = { success: 'check_circle', error: 'error', info: 'info' };
          const colors = { success: 'text-emerald-400', error: 'text-red-400', info: 'text-blue-400' };
          
          toast.innerHTML = `
            <span class="material-symbols-outlined ${colors[type] || colors.info}">${icons[type] || 'info'}</span>
            <span class="text-sm font-medium">${message}</span>
          `;
          
          container.appendChild(toast);
          
          // Trigger entry transition
          requestAnimationFrame(() => {
            toast.classList.remove('translate-y-2', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
          });
          
          // Remove timer
          setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-2', 'opacity-0');
            setTimeout(() => {
              toast.remove();
            }, 300);
          }, duration);
        };
        
        window.showToast = window.showGlobalToast;
      })();

      (function() {
        window.showGlobalModal = function(options) {
          const { title = '', content = '', onClose } = options;
          
          // Remove any existing active dynamic modals
          const existing = document.getElementById('txa-global-modal');
          if (existing) existing.remove();

          const modal = document.createElement('div');
          modal.id = 'txa-global-modal';
          modal.className = 'fixed inset-0 z-[110] flex items-center justify-center bg-black/70 backdrop-blur-sm transition-all duration-300';
          modal.style.opacity = '0';

          modal.innerHTML = `
            <div class="relative w-full max-w-[500px] mx-4 rounded-[24px] p-6 sm:p-8 bg-[#12141d]/95 border border-white/10 shadow-[0_0_50px_rgba(0,0,0,0.5)] ring-1 ring-white/10 backdrop-blur-2xl transition-all duration-300 transform scale-90 opacity-0">
              <button class="absolute right-4 top-4 text-zinc-400 hover:text-white transition-colors p-2 cursor-pointer modal-close-btn">
                <span class="material-symbols-outlined">close</span>
              </button>
              ${title ? `<h3 class="text-xl font-bold text-white mb-4 pr-10 font-outfit">${title}</h3>` : ''}
              <div class="text-zinc-300 text-sm leading-relaxed max-h-[70vh] overflow-y-auto pr-2 txaformat">
                ${content}
              </div>
            </div>
          `;

          document.body.appendChild(modal);
          document.body.style.overflow = 'hidden';

          // Animate in
          requestAnimationFrame(() => {
            modal.style.opacity = '1';
            const body = modal.querySelector('div');
            if (body) {
              body.classList.remove('scale-90', 'opacity-0');
              body.classList.add('scale-100', 'opacity-100');
            }
          });

          function closeModal() {
            modal.style.opacity = '0';
            const body = modal.querySelector('div');
            if (body) {
              body.classList.remove('scale-100', 'opacity-100');
              body.classList.add('scale-90', 'opacity-0');
            }
            setTimeout(() => {
              modal.remove();
              document.body.style.overflow = '';
              if (onClose) onClose();
            }, 300);
          }

          // Close event handlers
          modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal();
          });
          
          const closeBtn = modal.querySelector('.modal-close-btn');
          if (closeBtn) closeBtn.addEventListener('click', closeModal);

          // Esc key handler
          const escHandler = function(e) {
            if (e.key === 'Escape') {
              closeModal();
              document.removeEventListener('keydown', escHandler);
            }
          };
          document.addEventListener('keydown', escHandler);
        };
      })();

      // ══════════════════════════════════════════════════════════════
      // Ultimate mouse-following Glassmorphism Tooltip System (TXA Tooltip)
      // ══════════════════════════════════════════════════════════════
      (function () {
        'use strict';

        if (window.isTxaTooltipInit) return;
        window.isTxaTooltipInit = true;

        const tooltip = document.getElementById('txa-tooltip') || document.createElement('div');
        if (!tooltip.id) {
          tooltip.id = 'txa-tooltip';
          tooltip.style.cssText = `
            position: fixed;
            pointer-events: none;
            z-index: 2147483647;
            padding: 10px 16px;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            color: #fff;
            font-size: 12px;
            font-weight: 500;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5), 0 0 15px rgba(109, 40, 217, 0.15);
            opacity: 0;
            transform: scale(0.95) translateY(6px);
            transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            white-space: normal;
            max-width: 300px;
            line-height: 1.5;
            text-align: center;
            word-break: break-word;
            font-family: 'Inter', sans-serif;
          `;
        }

        function initTooltip() {
          if (!document.body) {
            window.addEventListener('DOMContentLoaded', initTooltip);
            return;
          }
          if (!document.getElementById('txa-tooltip')) {
            document.body.appendChild(tooltip);
          }
        }

        window.initTxaTooltips = initTooltip;
        initTooltip();
        document.addEventListener('astro:page-load', initTooltip);

        let currentTarget = null;
        let hideTimeout = null;

        function showTooltip(text, target, e = null) {
          if (!text) return;
          clearTimeout(hideTimeout);
          
          tooltip.innerHTML = `<div class="txa-tooltip-content">${text}</div>`;
          
          tooltip.style.opacity = '1';
          tooltip.style.transform = 'scale(1) translateY(0)';
          currentTarget = target;

          if (e) {
            updatePosition(e);
          }
        }

        function hideTooltip() {
          hideTimeout = setTimeout(() => {
            tooltip.style.opacity = '0';
            tooltip.style.transform = 'scale(0.95) translateY(6px)';
            currentTarget = null;
          }, 80);
        }

        function updatePosition(e) {
          if (tooltip.style.opacity === '0') return;

          const offset = 18;
          const rect = tooltip.getBoundingClientRect();

          let x = e.clientX - (rect.width / 2);
          let y = e.clientY - rect.height - offset;

          const padding = 12;

          if (x < padding) x = padding;
          if (x + rect.width + padding > window.innerWidth) {
            x = window.innerWidth - rect.width - padding;
          }

          if (y < padding) {
            y = e.clientY + offset;
          }

          tooltip.style.left = x + 'px';
          tooltip.style.top = y + 'px';
        }

        // Global capture of hover states, supporting: data-txatooltip, data-txa-tooltip, .txatooltip, and title attributes
        document.addEventListener('mouseover', (e) => {
          const target = e.target.closest('[data-txatooltip], [data-txa-tooltip], .txatooltip, [title]');
          if (target) {
            const tooltipText = target.getAttribute('data-txatooltip') || target.getAttribute('data-txa-tooltip') || target.title;
            if (tooltipText) {
              if (target.title) {
                target.setAttribute('data-original-title', target.title);
                target.title = '';
              }
              showTooltip(tooltipText, target, e);
            }
          }
        }, true);

        document.addEventListener('mouseout', (e) => {
          const target = e.target.closest('[data-txatooltip], [data-txa-tooltip], .txatooltip, [data-original-title]');
          if (target) {
            const originalTitle = target.getAttribute('data-original-title');
            if (originalTitle) {
              target.title = originalTitle;
              target.removeAttribute('data-original-title');
            }
            hideTooltip();
          }
        }, true);

        document.addEventListener('mousemove', (e) => {
          if (currentTarget) updatePosition(e);
        }, true);

        document.addEventListener('click', () => {
          hideTooltip();
        });

        // Fullscreen support
        function handleFullscreenChange() {
          const fsElem = document.fullscreenElement || document.webkitFullscreenElement;
          if (fsElem) {
            fsElem.appendChild(tooltip);
          } else {
            if (document.body && !document.body.contains(tooltip)) {
              document.body.appendChild(tooltip);
            }
          }
        }

        document.addEventListener('fullscreenchange', handleFullscreenChange);
        document.addEventListener('webkitfullscreenchange', handleFullscreenChange);

        // Expose helper globally to call via Console/JS
        window.showGlobalTooltip = function(targetElementOrSelector, text) {
          const target = typeof targetElementOrSelector === 'string'
            ? document.querySelector(targetElementOrSelector)
            : targetElementOrSelector;
          if (!target) return;
          target.setAttribute('data-txatooltip', text);
          showTooltip(text, target);
          setTimeout(hideTooltip, 2500);
        };
      })();

      // ══════════════════════════════════════════════════════════════
      // Card Playlist Button Interaction System
      // ══════════════════════════════════════════════════════════════
      (function() {
        'use strict';

        const initCardPlaylistBtns = () => {
          const playlistBtns = document.querySelectorAll('.card-playlist-btn');
          const playList = JSON.parse(localStorage.getItem('tplaylist') || '[]');

          playlistBtns.forEach(btn => {
            const slug = btn.getAttribute('data-slug');
            if (!slug) return;

            const iconAdd = btn.querySelector('.card-icon-add');
            const iconAdded = btn.querySelector('.card-icon-added');
            if (!iconAdd || !iconAdded) return;

            // Update initial state
            const isInPlaylist = playList.includes(slug);
            if (isInPlaylist) {
              iconAdd.classList.add('hidden');
              iconAdded.classList.remove('hidden');
              btn.setAttribute('title', 'Xóa khỏi DS phát');
            } else {
              iconAdd.classList.remove('hidden');
              iconAdded.classList.add('hidden');
              btn.setAttribute('title', 'Thêm vào DS phát');
            }

            // Remove existing listener to avoid duplicates
            const newBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(newBtn, btn);

            // Add click listener
            newBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();

              const isLoggedIn = document.cookie.includes('txa_gate_passed');
              if (!isLoggedIn) {
                if (window.showGlobalToast) window.showGlobalToast('Vui lòng đăng nhập để thực hiện chức năng này!', 'error');
                setTimeout(() => {
                  if (window.openLoginModal) window.openLoginModal();
                }, 800);
                return;
              }

              const currentPlayList = JSON.parse(localStorage.getItem('tplaylist') || '[]');
              const idx = currentPlayList.indexOf(slug);
              let msg = '';
              if (idx === -1) {
                currentPlayList.push(slug);
                msg = 'Đã lưu phim vào Danh sách phát!';
              } else {
                currentPlayList.splice(idx, 1);
                msg = 'Đã gỡ phim khỏi Danh sách phát!';
              }
              localStorage.setItem('tplaylist', JSON.stringify(currentPlayList));

              if (window.showGlobalToast) window.showGlobalToast(msg, 'success');

              // Sync all buttons on the page with the same slug
              const allMatchingBtns = document.querySelectorAll(`.card-playlist-btn[data-slug="${slug}"]`);
              allMatchingBtns.forEach(b => {
                const bAdd = b.querySelector('.card-icon-add');
                const bAdded = b.querySelector('.card-icon-added');
                if (bAdd && bAdded) {
                  if (idx === -1) {
                    bAdd.classList.add('hidden');
                    bAdded.classList.remove('hidden');
                    b.setAttribute('title', 'Xóa khỏi DS phát');
                  } else {
                    bAdd.classList.remove('hidden');
                    bAdded.classList.add('hidden');
                    b.setAttribute('title', 'Thêm vào DS phát');
                  }
                }
              });

              // Also sync homepage hero playlist button if active
              const heroBtn = document.getElementById('hero-playlist-btn');
              if (heroBtn && window.updateHeroPlaylistBtn) {
                window.updateHeroPlaylistBtn();
              }
            });
          });
        };

        // Run on DOMContentLoaded and astro:page-load
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initCardPlaylistBtns);
        } else {
          initCardPlaylistBtns();
        }
        document.addEventListener('astro:page-load', initCardPlaylistBtns);
        
        // Also run when popovers are shown or dynamically added
        document.addEventListener('mouseover', (e) => {
          const popover = e.target.closest('.group');
          if (popover) {
            setTimeout(initCardPlaylistBtns, 100);
          }
        }, true);

        // Expose init function globally
        window.initCardPlaylistBtns = initCardPlaylistBtns;
      })();

      // ══════════════════════════════════════════════════════════════
      // Real-time Search Autocomplete Logic
      // ══════════════════════════════════════════════════════════════
      (function() {
        function initSearchAutocomplete() {
          const searchInput = document.getElementById('nav-search-input');
          const searchPopup = document.getElementById('search-popup');
          const searchLoader = document.getElementById('search-loader');
          const resultsList = document.getElementById('search-results-list');
          let debounceTimer;

          if (!searchInput) return;

          function hideSearchPopup() {
            searchPopup?.classList.add('opacity-0', 'invisible', 'scale-95');
          }

          function showSearchPopup() {
            searchPopup?.classList.remove('opacity-0', 'invisible', 'scale-95');
          }

          searchInput.addEventListener('input', function() {
            const val = this.value.trim();
            clearTimeout(debounceTimer);

            if (val.length < 1) {
              resultsList.innerHTML = '<div class="text-xs text-on-surface-variant/60 py-4 text-center italic">Nhập từ khóa để tìm kiếm...</div>';
              hideSearchPopup();
              return;
            }

            showSearchPopup();
            searchLoader?.classList.remove('hidden');

            debounceTimer = setTimeout(async () => {
              try {
                const res = await fetch(`/api/movies/search?q=${encodeURIComponent(val)}`);
                if (!res.ok) throw new Error();
                const payload = await res.json();
                const movies = payload.data || [];

                const seen = new Set();
                const uniqueMovies = movies.filter((m) => {
                  if (!m.slug || m.slug === 'undefined' || m.slug === 'null' || seen.has(m.slug)) return false;
                  seen.add(m.slug);
                  return true;
                }).slice(0, 6);

                if (uniqueMovies.length === 0) {
                  resultsList.innerHTML = '<div class="text-xs text-on-surface-variant/60 py-4 text-center">Không tìm thấy kết quả phù hợp</div>';
                } else {
                  resultsList.innerHTML = uniqueMovies.map(m => `
                    <a href="/phim/${m.slug}" class="flex gap-3 p-2 rounded-xl hover:bg-white/5 border border-transparent hover:border-glass-stroke transition-all duration-300 group/item cursor-pointer">
                      <img src="${m.posterUrl}" class="w-10 h-14 object-cover rounded-lg border border-glass-stroke shrink-0" />
                      <div class="flex-grow flex flex-col justify-center min-w-0">
                        <div class="text-xs font-bold text-white group-hover/item:text-primary transition-colors truncate">${m.title}</div>
                        ${m.originalTitle ? `<div class="text-[10px] text-on-surface-variant/75 truncate mt-0.5">${m.originalTitle}</div>` : ''}
                        <div class="flex items-center gap-2 mt-1.5 text-[9px] text-on-surface-variant/50 font-bold">
                          <span class="px-1.5 py-0.5 bg-white/5 border border-glass-stroke rounded text-primary">${m.quality || 'FHD'}</span>
                          <span>${m.releaseYear || 2024}</span>
                          <span>•</span>
                          <span>${m.episodeCurrent || 'Full'}</span>
                        </div>
                      </div>
                    </a>
                  `).join('');
                }
              } catch (err) {
                resultsList.innerHTML = '<div class="text-xs text-red-400 py-4 text-center">Lỗi tải dữ liệu. Vui lòng thử lại.</div>';
              } finally {
                searchLoader?.classList.add('hidden');
              }
            }, 200);
          });

          // Enter key to search
          searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
              const val = this.value.trim();
              if (val.length >= 1) {
                window.location.href = `/tim-kiem?q=${encodeURIComponent(val)}`;
              }
            }
          });

          // Click outside search
          const clickOutsideHandler = function(e) {
            if (!document.getElementById('search-container')?.contains(e.target)) {
              hideSearchPopup();
            }
          };
          document.addEventListener('click', clickOutsideHandler);
        }

        // Run on DOMContentLoaded and astro:page-load
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initSearchAutocomplete);
        } else {
          initSearchAutocomplete();
        }
        document.addEventListener('astro:page-load', initSearchAutocomplete);
      })();

      // ══════════════════════════════════════════════════════════════
      // Premium Modal Open/Close & Tab Toggles
      // ══════════════════════════════════════════════════════════════
      function initTurnstileDecoy() {
        const spinner = document.querySelector('.turnstile-spinner');
        const check = document.querySelector('.turnstile-check');
        const text = document.querySelector('.turnstile-text');
        
        if (spinner && check && text) {
          spinner.classList.remove('hidden');
          check.classList.add('hidden');
          text.textContent = 'Đang xác minh...';
          
          setTimeout(() => {
            spinner.classList.add('hidden');
            check.classList.remove('hidden');
            text.textContent = 'Đã xác minh';
          }, 1500);
        }
      }

      function switchAuthTab(tab) {
        const loginTab = document.getElementById('auth-tab-login');
        const registerTab = document.getElementById('auth-tab-register');
        const forgotTab = document.getElementById('auth-tab-forgot-password');

        loginTab?.classList.add('hidden');
        registerTab?.classList.add('hidden');
        forgotTab?.classList.add('hidden');

        if (tab === 'login') {
          loginTab?.classList.remove('hidden');
        } else if (tab === 'register') {
          registerTab?.classList.remove('hidden');
        } else if (tab === 'forgot-password') {
          forgotTab?.classList.remove('hidden');
        }
        
        // Restart simulated Cloudflare Turnstile decoy verification
        initTurnstileDecoy();
      }

      function openLoginModal() {
        const m = document.getElementById('login-modal');
        if (m) {
          m.style.display = 'flex';
          m.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          switchAuthTab('login');
          initTurnstile();
          resetTurnstileWidgets();
        }
      }

      function openRegisterModal() {
        const m = document.getElementById('login-modal');
        if (m) {
          m.style.display = 'flex';
          m.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          switchAuthTab('register');
          initTurnstile();
          resetTurnstileWidgets();
        }
      }

      function closeLoginModal() {
        const m = document.getElementById('login-modal');
        if (m) {
          m.style.display = 'none';
          m.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      // Expose globally
      window.openLoginModal = openLoginModal;
      window.closeLoginModal = closeLoginModal;
      window.openRegisterModal = openRegisterModal;
      window.closeRegisterModal = closeLoginModal;
      window.switchAuthTab = switchAuthTab;

      window.addEventListener('open-login-modal', openLoginModal);
      window.addEventListener('open-register-modal', openRegisterModal);

      // Close on backdrop click or Escape
      document.getElementById('login-modal')?.addEventListener('click', function(e) {
        if (e.target === this) closeLoginModal();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLoginModal();
      });

      // ══════════════════════════════════════════════════════════════
      // Form Submission Actions
      // ══════════════════════════════════════════════════════════════
      (function() {
        const loginForm = document.getElementById('login-form');
        const regForm = document.getElementById('register-form');

        // Login inputs
        const idInput = document.getElementById('login-identity');
        const passInput = document.getElementById('login-password');
        const togglePass = document.getElementById('login-toggle-pass');
        let showPass = false;

        if (togglePass && passInput) {
          togglePass.addEventListener('click', function() {
            showPass = !showPass;
            passInput.type = showPass ? 'text' : 'password';
            this.querySelector('.material-symbols-outlined').textContent = showPass ? 'visibility' : 'visibility_off';
          });
        }

        // Login Form Validation Check
        function checkLoginFormValidity() {
          const identity = idInput?.value.trim() || '';
          const password = passInput?.value || '';
          const submitBtn = document.getElementById('login-submit');

          let isCaptchaValid = true;
          const isTurnstileEnabled = !!document.getElementById('cf-turnstile-login');
          if (isTurnstileEnabled) {
            isCaptchaValid = !!window.txaTurnstileTokenLogin;
          }

          if (submitBtn) {
            const canSubmit = identity.length >= 3 && password.length >= 6 && isCaptchaValid;
            submitBtn.disabled = !canSubmit;
            if (canSubmit) {
              submitBtn.classList.remove('opacity-55', 'cursor-not-allowed');
              submitBtn.classList.add('hover:brightness-110', 'active:scale-95');
            } else {
              submitBtn.classList.add('opacity-55', 'cursor-not-allowed');
              submitBtn.classList.remove('hover:brightness-110', 'active:scale-95');
            }
          }
        }
        window.checkLoginFormValidity = checkLoginFormValidity;

        if (idInput) {
          idInput.addEventListener('input', function() {
            const msgEl = this.closest('.auth-field').querySelector('.login-id-error');
            if (this.value.trim().length >= 3) {
              this.style.borderColor = 'rgba(16, 185, 129, 0.4)';
              if (msgEl) msgEl.style.opacity = '0';
            } else {
              this.style.borderColor = 'rgba(239, 68, 68, 0.4)';
              if (msgEl) { msgEl.textContent = 'Tối thiểu 3 ký tự'; msgEl.style.opacity = '1'; }
            }
            checkLoginFormValidity();
          });
        }

        if (passInput) {
          passInput.addEventListener('input', function() {
            const msgEl = this.closest('.auth-field').querySelector('.login-pass-msg');
            if (this.value.length >= 6) {
              this.style.borderColor = 'rgba(16, 185, 129, 0.4)';
              if (msgEl) msgEl.style.opacity = '0';
            } else {
              this.style.borderColor = 'rgba(239, 68, 68, 0.4)';
              if (msgEl) { msgEl.textContent = 'Tối thiểu 6 ký tự'; msgEl.style.opacity = '1'; }
            }
            checkLoginFormValidity();
          });
        }

        if (loginForm) {
          loginForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const identity = idInput?.value.trim() || '';
            const password = passInput?.value || '';

            if (identity.length < 3 || password.length < 6) {
              showGlobalToast('Kiểm tra lại thông tin đăng nhập!', 'error');
              return;
            }

            const submitBtn = document.getElementById('login-submit');
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">progress_activity</span><span>Đang xác thực...</span>';
            }

            const turnstileToken = window.txaTurnstileTokenLogin || '';
            
            fetch('/api/auth/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ identity, password, turnstileToken })
            })
            .then(res => res.json())
            .then(data => {
              if (data.status === 'success' && data.data && data.data.user) {
                const user = data.data.user;

                // Clear any error styles
                if (idInput) {
                  idInput.style.borderColor = 'rgba(16, 185, 129, 0.4)';
                  const idMsgEl = idInput.closest('.auth-field').querySelector('.login-id-error');
                  if (idMsgEl) idMsgEl.style.opacity = '0';
                }
                if (passInput) {
                  passInput.style.borderColor = 'rgba(16, 185, 129, 0.4)';
                  const passMsgEl = passInput.closest('.auth-field').querySelector('.login-pass-msg');
                  if (passMsgEl) passMsgEl.style.opacity = '0';
                }

                document.cookie = "txa_gate_passed=true; path=/; max-age=604800";
                localStorage.setItem('tlogged_in_as', user.username);
                
                // Keep local tregistered_users synced
                try {
                  let registered = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
                  const idx = registered.findIndex(u => u.username.toLowerCase() === user.username.toLowerCase());
                  const syncUser = {
                    username: user.username,
                    email: user.email,
                    name: user.name,
                    role: user.role,
                    roles: user.role,
                    avatar: user.avatar_url,
                    gender: user.gender,
                    province: user.province,
                    ward: user.ward,
                    package: user.role === 'admin' ? 'VIP' : 'Free',
                    status: 'active',
                    emailVerified: true
                  };
                  if (idx === -1) {
                    registered.push(syncUser);
                  } else {
                    registered[idx] = { ...registered[idx], ...syncUser };
                  }
                  localStorage.setItem('tregistered_users', JSON.stringify(registered));
                } catch(e) {}

                if (user.role === 'admin') {
                  localStorage.setItem('txa_referred_token', 'true');
                }
                localStorage.removeItem('thistory');
                
                resetTurnstileWidgets();
                window.dispatchEvent(new Event('auth-changed'));
                
                if (typeof window.checkTxaGate === 'function') {
                  window.checkTxaGate();
                }

                showGlobalToast('Đăng nhập thành công!', 'success');
                closeLoginModal();
                setTimeout(() => { window.location.reload(); }, 800);
              } else {
                resetTurnstileWidgets();
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = '<span>Đăng nhập</span>';
                }

                const errorType = data.data?.errorType;
                const errorMsg = data.message || 'Đăng nhập thất bại!';

                if (errorType === 'identity') {
                  if (idInput) {
                    idInput.style.borderColor = 'rgba(239, 68, 68, 0.8)';
                    const idMsgEl = idInput.closest('.auth-field').querySelector('.login-id-error');
                    if (idMsgEl) {
                      idMsgEl.textContent = errorMsg;
                      idMsgEl.style.opacity = '1';
                    }
                  }
                  showGlobalToast(errorMsg, 'error');
                } else if (errorType === 'password') {
                  if (passInput) {
                    passInput.style.borderColor = 'rgba(239, 68, 68, 0.8)';
                    const passMsgEl = passInput.closest('.auth-field').querySelector('.login-pass-msg');
                    if (passMsgEl) {
                      passMsgEl.textContent = errorMsg;
                      passMsgEl.style.opacity = '1';
                    }
                  }
                  showGlobalToast(errorMsg, 'error');
                } else {
                  showGlobalToast(errorMsg, 'error');
                }
                checkLoginFormValidity();
              }
            })
            .catch(err => {
              showGlobalToast('Lỗi hệ thống xác thực!', 'error');
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>Đăng nhập</span>';
              }
            });
          });
        }

        // ══════════════════════════════════════════════════════════════
        // Register Validation & Submit (Real-time & Premium UI)
        // ══════════════════════════════════════════════════════════════
        const validation = { username: false, email: false, password: false, confirmPassword: false };

        function updateFieldUI(inputEl, isValid, errorMsg) {
          if (!inputEl) return;
          const parent = inputEl.closest('.auth-field');
          if (!parent) return;
          const iconEl = parent.querySelector('.validation-icon');
          const errorEl = parent.querySelector('.reg-error');

          if (inputEl.value.trim() === '') {
            inputEl.style.borderColor = '';
            if (iconEl) iconEl.classList.add('hidden');
            if (errorEl) { errorEl.style.opacity = '0'; errorEl.textContent = ''; }
            return;
          }

          if (isValid) {
            inputEl.style.borderColor = 'rgba(16, 185, 129, 0.6)';
            if (iconEl) {
              iconEl.textContent = 'check_circle';
              iconEl.className = 'validation-icon material-symbols-outlined absolute right-3.5 top-[13px] text-[18px] text-emerald-400 select-none';
              iconEl.classList.remove('hidden');
            }
            if (errorEl) { errorEl.style.opacity = '0'; errorEl.textContent = ''; }
          } else {
            inputEl.style.borderColor = 'rgba(244, 63, 94, 0.6)';
            if (iconEl) {
              iconEl.textContent = 'cancel';
              iconEl.className = 'validation-icon material-symbols-outlined absolute right-3.5 top-[13px] text-[18px] text-rose-400 select-none';
              iconEl.classList.remove('hidden');
            }
            if (errorEl) {
              errorEl.textContent = errorMsg;
              errorEl.style.opacity = '1';
            }
          }
        }

        function validateUsername(val) {
          const input = document.getElementById('reg-username');
          if (!input) return false;
          let isValid = false;
          let msg = '';

          if (val.length === 0) {
            updateFieldUI(input, false, '');
            validation.username = false;
            return false;
          }

          if (val.length < 4) {
            msg = 'Tên tài khoản phải tối thiểu 4 ký tự';
          } else if (!/^[a-zA-Z0-9_]+$/.test(val)) {
            msg = 'Chỉ dùng chữ cái, số và dấu gạch dưới (_)';
          } else {
            try {
              const users = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
              const isTaken = users.some(u => u.username.toLowerCase() === val.toLowerCase());
              if (isTaken) {
                msg = 'Tên tài khoản đã được sử dụng';
              } else {
                isValid = true;
              }
            } catch(e) { isValid = true; }
          }

          updateFieldUI(input, isValid, msg);
          validation.username = isValid;
          checkFormValidity();
          return isValid;
        }

        function validateEmail(val) {
          const input = document.getElementById('reg-email');
          if (!input) return false;
          let isValid = false;
          let msg = '';

          if (val.length === 0) {
            updateFieldUI(input, false, '');
            validation.email = false;
            return false;
          }

          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(val)) {
            msg = 'Địa chỉ email không hợp lệ';
          } else {
            const domain = val.split('@')[1]?.toLowerCase() || '';
            const allowedDomains = ['gmail.com', 'outlook.com', 'icloud.com'];
            const isHotmail = domain.startsWith('hotmail.');
            const isAllowed = allowedDomains.includes(domain) || isHotmail;

            if (!isAllowed) {
              msg = 'Chỉ hỗ trợ Gmail, Outlook, Hotmail, iCloud';
            } else {
              try {
                const users = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
                const isTaken = users.some(u => u.email.toLowerCase() === val.toLowerCase());
                if (isTaken) {
                  msg = 'Địa chỉ email đã được đăng ký';
                } else {
                  isValid = true;
                }
              } catch(e) { isValid = true; }
            }
          }

          updateFieldUI(input, isValid, msg);
          validation.email = isValid;
          checkFormValidity();
          return isValid;
        }

        function validatePassword(val) {
          const input = document.getElementById('reg-password');
          const strengthContainer = document.getElementById('password-strength-container');
          if (!input) return false;

          if (strengthContainer) strengthContainer.classList.remove('hidden');

          const conds = {
            length: val.length >= 8,
            uppercase: /[A-Z]/.test(val),
            lowercase: /[a-z]/.test(val),
            number: /[0-9]/.test(val),
            special: /[^A-Za-z0-9]/.test(val)
          };

          let passedCount = 0;
          Object.entries(conds).forEach(([key, passed]) => {
            const item = document.querySelector(`.condition-item[data-cond="${key}"]`);
            if (item) {
              const icon = item.querySelector('.material-symbols-outlined');
              if (val.length === 0) {
                item.className = 'flex items-center gap-1.5 condition-item text-zinc-500';
                if (icon) icon.textContent = 'radio_button_unchecked';
              } else if (passed) {
                passedCount++;
                item.className = 'flex items-center gap-1.5 condition-item text-emerald-400';
                if (icon) icon.textContent = 'check_circle';
              } else {
                item.className = 'flex items-center gap-1.5 condition-item text-rose-500';
                if (icon) icon.textContent = 'cancel';
              }
            }
          });

          const strengthTextEl = document.getElementById('strength-text');
          const bars = [
            document.getElementById('strength-bar-1'),
            document.getElementById('strength-bar-2'),
            document.getElementById('strength-bar-3'),
            document.getElementById('strength-bar-4')
          ];

          bars.forEach(b => { if (b) b.className = 'h-full w-1/4 rounded-full bg-zinc-800/80 transition-all duration-300'; });

          if (val.length === 0) {
            if (strengthTextEl) {
              strengthTextEl.textContent = 'Trống';
              strengthTextEl.className = 'text-[9px] font-black uppercase tracking-widest text-zinc-500';
            }
            updateFieldUI(input, false, '');
            validation.password = false;
            return false;
          }

          let strengthLabel = 'Rất yếu';
          let strengthColor = 'bg-rose-500';
          let activeBars = 1;

          if (passedCount <= 2) {
            strengthLabel = 'Yếu';
            strengthColor = 'bg-rose-500';
            activeBars = 1;
          } else if (passedCount === 3) {
            strengthLabel = 'Trung bình';
            strengthColor = 'bg-amber-500';
            activeBars = 2;
          } else if (passedCount === 4) {
            strengthLabel = 'Mạnh';
            strengthColor = 'bg-yellow-400';
            activeBars = 3;
          } else if (passedCount === 5) {
            strengthLabel = 'Cực kỳ bảo mật';
            strengthColor = 'bg-emerald-400';
            activeBars = 4;
          }

          if (strengthTextEl) {
            strengthTextEl.textContent = strengthLabel;
            strengthTextEl.className = `text-[9px] font-black uppercase tracking-widest transition-colors ${passedCount <= 2 ? 'text-rose-400' : passedCount === 3 ? 'text-amber-400' : passedCount === 4 ? 'text-yellow-400' : 'text-emerald-400'}`;
          }

          for (let i = 0; i < activeBars; i++) {
            if (bars[i]) bars[i].className = `h-full w-1/4 rounded-full transition-all duration-300 ${strengthColor}`;
          }

          const isValid = passedCount === 5;
          const errorMsg = isValid ? '' : 'Mật khẩu chưa đủ mạnh';
          updateFieldUI(input, isValid, errorMsg);
          validation.password = isValid;

          const confirmInput = document.getElementById('reg-confirm');
          if (confirmInput && confirmInput.value !== '') {
            validateConfirmPassword(confirmInput.value);
          }

          checkFormValidity();
          return isValid;
        }

        function validateConfirmPassword(val) {
          const input = document.getElementById('reg-confirm');
          if (!input) return false;
          let isValid = false;
          let msg = '';

          if (val.length === 0) {
            updateFieldUI(input, false, '');
            validation.confirmPassword = false;
            return false;
          }

          const pwdVal = document.getElementById('reg-password')?.value || '';
          if (val !== pwdVal) {
            msg = 'Xác nhận mật khẩu không khớp';
          } else if (val.length < 8) {
            msg = 'Mật khẩu phải tối thiểu 8 ký tự';
          } else {
            isValid = true;
          }

          updateFieldUI(input, isValid, msg);
          validation.confirmPassword = isValid;
          checkFormValidity();
          return isValid;
        }

        function checkFormValidity() {
          const allValid = Object.values(validation).every(v => v === true);
          const terms = document.getElementById('reg-terms')?.checked;
          const submitBtn = document.getElementById('reg-submit');
          
          let isCaptchaValid = true;
          const isTurnstileEnabled = !!document.getElementById('cf-turnstile-register');
          if (isTurnstileEnabled) {
            isCaptchaValid = !!window.txaTurnstileTokenRegister;
          }

          if (submitBtn) {
            const canSubmit = allValid && terms && isCaptchaValid;
            submitBtn.disabled = !canSubmit;
            if (canSubmit) {
              submitBtn.classList.remove('opacity-55', 'cursor-not-allowed');
              submitBtn.classList.add('hover:brightness-110', 'active:scale-95');
            } else {
              submitBtn.classList.add('opacity-55', 'cursor-not-allowed');
              submitBtn.classList.remove('hover:brightness-110', 'active:scale-95');
            }
          }
        }
        window.checkFormValidity = checkFormValidity;

        // Register event listeners
        document.getElementById('reg-username')?.addEventListener('input', function() { validateUsername(this.value); });
        document.getElementById('reg-email')?.addEventListener('input', function() { validateEmail(this.value); });
        document.getElementById('reg-password')?.addEventListener('input', function() { validatePassword(this.value); });
        document.getElementById('reg-confirm')?.addEventListener('input', function() { validateConfirmPassword(this.value); });
        document.getElementById('reg-terms')?.addEventListener('change', checkFormValidity);

