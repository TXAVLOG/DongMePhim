---
import '../styles/index.css';
import { SettingService } from '../services/SettingService';
import { MovieService } from '../services/MovieService';
import { ClientRouter } from 'astro:transitions';
import Txatooltip from '../components/ui/txatooltip.astro';
import Txaicon from '../components/ui/txaicon.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHome?: boolean;
  useTransition?: boolean;
}

const settings = await SettingService.getSettings();
const isSmtpConfigured = !!(settings.smtp?.smtp_host && settings.smtp?.smtp_user && settings.smtp?.smtp_pass);
const popularMovies = await MovieService.getMovies({ limit: 12 });

const decoyEnable = settings.general?.decoy_enable ?? true;
const zaloLockEnable = settings.general?.zalo_lock_enable ?? true;
const decoyPasscode = settings.general?.decoy_passcode || 'phimtxadinhvai';
const zaloGroupUrl = settings.social?.social_zalo_group_url || 'https://zalo.me/g/nc4aaozaxnr5fszvnxdb';

const { 
  title, 
  description = settings.general.site_description, 
  image = "/favicon.png",
  isHome = false,
  useTransition = true
} = Astro.props;

const defaultTitle = `${settings.general.site_name} - Trải nghiệm điện ảnh đỉnh cao`;
const pageTitle = isHome 
  ? defaultTitle 
  : (title ? `${title} | ${settings.general.site_name}` : defaultTitle);

const socialLinks = [];
if (settings.social?.social_fb_enable && settings.social?.social_fb_url) {
  socialLinks.push({ platform: "Facebook", url: settings.social.social_fb_url, icon: "facebook" });
}
if (settings.social?.social_fb_group_enable && settings.social?.social_fb_group_url) {
  socialLinks.push({ platform: "Facebook Group", url: settings.social.social_fb_group_url, icon: "facebook-group" });
}
if (settings.social?.social_telegram_enable && settings.social?.social_telegram_url) {
  socialLinks.push({ platform: "Telegram", url: settings.social.social_telegram_url, icon: "telegram" });
}
if (settings.social?.social_tiktok_enable && settings.social?.social_tiktok_url) {
  socialLinks.push({ platform: "TikTok", url: settings.social.social_tiktok_url, icon: "tiktok" });
}
if (settings.social?.social_zalo_group_enable && settings.social?.social_zalo_group_url) {
  socialLinks.push({ platform: "Zalo Group", url: settings.social.social_zalo_group_url, icon: "zalo" });
}

const { countries: uniqueCountries, genres: uniqueGenres } = await MovieService.getGenresAndCountries();

const slugify = (text: string) => {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[đĐ]/g, 'd')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
};

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/tphim') {
    return currentPath === '/tphim';
  }
  return currentPath.startsWith(path);
};
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    {useTransition && <ClientRouter />}
    <script define:vars={{ 
      apiEncryptEnable: settings.general?.api_encrypt_enable ?? false, 
      apiEncryptPass: settings.general?.api_encrypt_pass || 'tphimx'
    }}>
      window.TXA_API_CONFIG = {
        encryptEnable: apiEncryptEnable,
        encryptPass: apiEncryptPass
      };
    </script>
    <script is:inline>
      // Helper function to decrypt AES-256-GCM client-side
      async function clientTxaDecrypt(encoded, passphrase) {
        try {
          const base64 = encoded.replace(/-/g, '+').replace(/_/g, '/');
          const binaryStr = atob(base64);
          const raw = new Uint8Array(binaryStr.length);
          for (let i = 0; i < binaryStr.length; i++) {
            raw[i] = binaryStr.charCodeAt(i);
          }

          const SALT_LEN = 16;
          const IV_LEN = 12;

          const salt = raw.slice(0, SALT_LEN);
          const iv = raw.slice(SALT_LEN, SALT_LEN + IV_LEN);
          const cipherData = raw.slice(SALT_LEN + IV_LEN);

          const encoder = new TextEncoder();
          const baseKey = await window.crypto.subtle.importKey(
            'raw',
            encoder.encode(passphrase),
            'PBKDF2',
            false,
            ['deriveKey']
          );

          const key = await window.crypto.subtle.deriveKey(
            {
              name: 'PBKDF2',
              salt: salt,
              iterations: 100000,
              hash: 'SHA-256'
            },
            baseKey,
            { name: 'AES-GCM', length: 256 },
            false,
            ['decrypt']
          );

          const decryptedBuffer = await window.crypto.subtle.decrypt(
            { name: 'AES-GCM', iv: iv },
            key,
            cipherData
          );

          const decoder = new TextDecoder();
          return decoder.decode(decryptedBuffer);
        } catch (e) {
          console.error("Client-side decryption error:", e);
          throw e;
        }
      }

      // Read configuration from server-injected config
      function getTxaApiConfig() {
        if (window.TXA_API_CONFIG) {
          return window.TXA_API_CONFIG;
        }
        return { encryptEnable: false, encryptPass: 'tphimx' };
      }

      // Monkey patch fetch
      (function() {
        const originalFetch = window.fetch;
        window.fetch = async function(...args) {
          const res = await originalFetch(...args);
          const isEncrypted = res.headers.get('X-TXA-Encrypted') === '1';
          if (isEncrypted) {
            try {
              const clone = res.clone();
              const json = await clone.json();
              const config = getTxaApiConfig();
              if (json && json.d && json.v === 1 && config.encryptEnable && config.encryptPass) {
                const decryptedText = await clientTxaDecrypt(json.d, config.encryptPass);
                const decryptedJson = JSON.parse(decryptedText);
                return new Response(JSON.stringify(decryptedJson), {
                  status: res.status,
                  statusText: res.statusText,
                  headers: new Headers({
                    ...Object.fromEntries(res.headers.entries()),
                    'Content-Type': 'application/json',
                    'X-TXA-Encrypted': '0'
                  })
                });
              }
            } catch (e) {
              console.error("Client-side fetch automatic decryption failed:", e);
            }
          }
          return res;
        };
      })();

      function applyTheme() {
        document.documentElement.classList.add('dark');
        window.localStorage.setItem('theme', 'dark');
      }
      function hydrateSettings() {
        // All settings are now rendered server-side using Supabase. No client-side hydration from localStorage is needed.
      }
      applyTheme();
      hydrateSettings();
      document.addEventListener('astro:after-swap', () => {
        applyTheme();
        hydrateSettings();
        if (typeof updateAuthState === 'function') updateAuthState();
      });
      document.addEventListener('astro:page-load', () => {
        applyTheme();
        hydrateSettings();
        if (typeof updateAuthState === 'function') updateAuthState();
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="keywords" content={settings.general.site_keywords} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- DNS Prefetch & Preconnect for Fast Asset Loading -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
    <link rel="preconnect" href="https://player.phimapi.com" crossorigin />
    <link rel="dns-prefetch" href="https://player.phimapi.com" />
    <link rel="preconnect" href="https://phimimg.com" crossorigin />
    <link rel="dns-prefetch" href="https://phimimg.com" />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link rel="dns-prefetch" href="https://unpkg.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Cấu hình bảo mật cổng ngụy trang & Zalo (Fast Bypass) -->
    <style is:inline>
      #main-app-container, #decoy-container, #zalo-container {
        display: none !important;
      }
      html.gate-passed #main-app-container {
        display: block !important;
      }
      html.gate-decoy #decoy-container {
        display: flex !important;
      }
      html.gate-zalo #zalo-container {
        display: flex !important;
      }
    </style>
    <script is:inline id="txa-gate-config" type="application/json" set:html={JSON.stringify({
      decoyEnable,
      zaloLockEnable,
      decoyPasscode,
      zaloGroupUrl
    })} />
    <script is:inline>
      function checkTxaGate() {
        const configEl = document.getElementById('txa-gate-config');
        if (!configEl) return;
        const config = JSON.parse(configEl.textContent);
        const decoyEnable = config.decoyEnable;
        const zaloLockEnable = config.zaloLockEnable;
        
        // Clear old classes before applying new one to avoid conflicts
        document.documentElement.classList.remove('gate-passed', 'gate-decoy', 'gate-zalo');

        // Check if logged in as Admin first (always bypass decoy and zalo)
        const username = localStorage.getItem('tlogged_in_as');
        let isAdmin = false;
        if (username) {
          try {
            const users = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
            const user = users.find(u => u.username.toLowerCase() === username.toLowerCase() || u.email.toLowerCase() === username.toLowerCase());
            if (user && (user.role === 'admin' || user.is_admin === true || user.is_admin === 'true')) {
              isAdmin = true;
            }
          } catch(e) {}
        }

        if (isAdmin) {
          document.documentElement.classList.add('gate-passed');
          localStorage.setItem('txa_referred_token', 'true'); // Automatically pass decoy for admin
          return;
        }

        if (decoyEnable === false) {
          document.documentElement.classList.add('gate-passed');
          return;
        }
        
        let isDecoyPassed = localStorage.getItem('txa_referred_token') === 'true';
        if (!isDecoyPassed) {
          const urlParams = new URLSearchParams(window.location.search);
          if (urlParams.get('t_time') && urlParams.get('t_token')) {
            localStorage.setItem('txa_referred_token', 'true');
            isDecoyPassed = true;
          }
        }
        
        if (!isDecoyPassed) {
          document.documentElement.classList.add('gate-decoy');
          return;
        }
        
        if (zaloLockEnable === false) {
          document.documentElement.classList.add('gate-passed');
          return;
        }
        
        const isZaloApproved = localStorage.getItem('zalo_access_status') === 'approved' || document.cookie.includes('txa_gate_passed=true');
        if (isZaloApproved) {
          document.documentElement.classList.add('gate-passed');
        } else {
          document.documentElement.classList.add('gate-zalo');
        }
      }

      window.checkTxaGate = checkTxaGate;
      checkTxaGate();
      document.addEventListener('astro:after-swap', checkTxaGate);
      document.addEventListener('astro:page-load', checkTxaGate);
    </script>

    <!-- Google Fonts -->
