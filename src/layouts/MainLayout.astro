              try {
                const username = document.getElementById('reg-username').value.trim();
                const email = document.getElementById('reg-email').value.trim();
                const password = document.getElementById('reg-password').value;

                const users = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
                
                if (users.some(u => u.username.toLowerCase() === username.toLowerCase())) {
                  showGlobalToast('Tên tài khoản đã tồn tại!', 'error');
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = '<span>Đăng ký tài khoản</span>';
                  return;
                }
                if (users.some(u => u.email.toLowerCase() === email.toLowerCase())) {
                  showGlobalToast('Địa chỉ email đã được đăng ký!', 'error');
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = '<span>Đăng ký tài khoản</span>';
                  return;
                }

                // Helper to compute MD5 hash client-side for Gravatar
