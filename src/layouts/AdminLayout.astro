<!DOCTYPE html>
<html lang="vi" class="dark admin-root">
<head>
  <meta charset="utf-8" />
  <meta name="referrer" content="no-referrer" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | {settings.general.site_name} Admin</title>
  <ClientRouter />
  <script is:inline define:vars={{ 
    apiEncryptEnable: settings.general?.api_encrypt_enable ?? false, 
    apiEncryptPass: settings.general?.api_encrypt_pass || 'tphimx',
    settings 
  }}>
    // Helper function to decrypt AES-256-GCM client-side
    async function clientTxaDecrypt(encoded, passphrase) {
      try {
        const base64 = encoded.replace(/-/g, '+').replace(/_/g, '/');
        const binaryStr = atob(base64);
        const raw = new Uint8Array(binaryStr.length);
        for (let i = 0; i < binaryStr.length; i++) {
          raw[i] = binaryStr.charCodeAt(i);
        }

        const SALT_LEN = 16;
        const IV_LEN = 12;

        const salt = raw.slice(0, SALT_LEN);
        const iv = raw.slice(SALT_LEN, SALT_LEN + IV_LEN);
        const cipherData = raw.slice(SALT_LEN + IV_LEN);

        const encoder = new TextEncoder();
        const baseKey = await window.crypto.subtle.importKey(
          'raw',
          encoder.encode(passphrase),
          'PBKDF2',
          false,
          ['deriveKey']
        );

        const key = await window.crypto.subtle.deriveKey(
          {
            name: 'PBKDF2',
            salt: salt,
            iterations: 100000,
            hash: 'SHA-256'
          },
          baseKey,
          { name: 'AES-GCM', length: 256 },
          false,
          ['decrypt']
        );

        const decryptedBuffer = await window.crypto.subtle.decrypt(
          { name: 'AES-GCM', iv: iv },
          key,
          cipherData
        );

        const decoder = new TextDecoder();
        return decoder.decode(decryptedBuffer);
      } catch (e) {
        console.error("Client-side decryption error:", e);
        throw e;
      }
    }

    // Initialize API config on window
    window.TXA_API_CONFIG = {
      encryptEnable: apiEncryptEnable,
      encryptPass: apiEncryptPass
    };
    window.TXA_SITE_SETTINGS = settings;

    // Monkey patch fetch for automatic API decryption in admin panel
    (function() {
      if (window.__txa_fetch_patched) return;
      window.__txa_fetch_patched = true;
      const originalFetch = window.fetch;
      window.fetch = async function(...args) {
        const res = await originalFetch(...args);
        const isEncrypted = res.headers.get('X-TXA-Encrypted') === '1';
        if (isEncrypted) {
          try {
            const clone = res.clone();
            const json = await clone.json();
            const config = window.TXA_API_CONFIG || { encryptEnable: false, encryptPass: 'tphimx' };
            if (json && json.d && json.v === 1 && config.encryptEnable && config.encryptPass) {
              const decryptedText = await clientTxaDecrypt(json.d, config.encryptPass);
              const decryptedJson = JSON.parse(decryptedText);
              return new Response(JSON.stringify(decryptedJson), {
                status: res.status,
                statusText: res.statusText,
                headers: new Headers({
                  ...Object.fromEntries(res.headers.entries()),
                  'Content-Type': 'application/json',
                  'X-TXA-Encrypted': '0'
                })
              });
            }
          } catch (e) {
            console.error("Client-side fetch automatic decryption failed:", e);
          }
        }
        return res;
      };
    })();

    (function() {
      if (typeof localStorage !== 'undefined') {
        const loggedInUser = localStorage.getItem('tlogged_in_as');
        if (!loggedInUser) {
          window.location.href = '/tphim';
          return;
        }

        // Tương thích ngược: nếu chuỗi identity là 'admin'
        let hasAdminRole = loggedInUser === 'admin';

        if (!hasAdminRole) {
          try {
            const users = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
            const user = users.find(u => u.username === loggedInUser || u.email === loggedInUser);
            if (user && (user.roles === 'admin' || user.role === 'admin')) {
              hasAdminRole = true;
            }
          } catch (e) {}
        }

        if (!hasAdminRole) {
          window.location.href = '/tphim';
          return;
        }

        // Synchronize database settings to localStorage on page load
        localStorage.setItem('txa_site_settings', JSON.stringify(settings));

        // Intercept setItem to sync client-side updates back to Supabase
        const originalSetItem = localStorage.setItem;
        localStorage.setItem = function(key, value) {
          originalSetItem.apply(this, arguments);
          if (key === 'txa_site_settings') {
            fetch('/api/admin/settings', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: value,
              keepalive: true
            }).catch(err => console.error('Lỗi khi lưu cấu hình lên database:', err));
          }
        };
      }
    })();
  </script>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
