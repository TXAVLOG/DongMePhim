  <script is:inline define:vars={{ providerType }}>
    // Highlight active sidebar item based on current URL path
    function initAdminLayout() {
      // Toggle Email logs link based on SMTP configuration in localStorage
      const emailLink = document.getElementById('nav-email');
      if (emailLink) {
        let isConfigured = false;
        try {
          const stored = localStorage.getItem('txa_site_settings');
          if (stored) {
            const parsed = JSON.parse(stored);
            isConfigured = !!(parsed.smtp?.smtp_host && parsed.smtp?.smtp_user && parsed.smtp?.smtp_pass);
          } else {
            isConfigured = true; // Default fallback to server seeds
          }
        } catch (e) {}
        if (isConfigured) {
          emailLink.classList.remove('hidden');
        } else {
          emailLink.classList.add('hidden');
        }
      }

      const currentPath = window.location.pathname;
      const navLinks = document.querySelectorAll('aside nav a');
      
      let matchedLink = null;
      let longestMatch = 0;

      navLinks.forEach(link => {
          link.classList.remove('sidebar-active');
          link.classList.add('text-on-surface-variant');
          const icon = link.querySelector('.material-symbols-outlined');
          if (icon instanceof HTMLElement) {
              icon.style.fontVariationSettings = "'FILL' 0";
          }
          const href = link.getAttribute('href');
          if (href && currentPath.startsWith(href) && href.length > longestMatch) {
              longestMatch = href.length;
              matchedLink = link;
          }
      });

      // Special case for root `/admin` so it doesn't match everything
      if(currentPath === '/admin' || currentPath === '/admin/') {
          matchedLink = document.getElementById('nav-dashboard');
      }

      if (matchedLink) {
          matchedLink.classList.remove('text-on-surface-variant');
          matchedLink.classList.add('sidebar-active');
          const icon = matchedLink.querySelector('.material-symbols-outlined');
          if (icon instanceof HTMLElement) {
              icon.style.fontVariationSettings = "'FILL' 1";
          }
      }

      // Initialize global tooltip logic
      let tooltipEl = document.getElementById('global-tooltip');
      if (!tooltipEl) {
        tooltipEl = document.createElement('div');
        tooltipEl.id = 'global-tooltip';
        tooltipEl.className = 'fixed pointer-events-none z-[9999] opacity-0 scale-95 transition-all duration-150 ease-out text-[11px] font-medium px-3 py-1.5 rounded-lg border border-white/10 bg-black/85 backdrop-blur-md text-white shadow-2xl';
        document.body.appendChild(tooltipEl);
      }

      // Listen on document to handle client routing updates dynamically
      const handleMouseOver = (e) => {
        const target = e.target.closest('[data-tooltip], [data-txatooltip]');
        if (target) {
          const text = target.getAttribute('data-tooltip') || target.getAttribute('data-txatooltip');
          tooltipEl.textContent = text;
          tooltipEl.classList.remove('opacity-0', 'scale-95');
          tooltipEl.classList.add('opacity-100', 'scale-100');
        }
      };

      const handleMouseMove = (e) => {
        const target = e.target.closest('[data-tooltip], [data-txatooltip]');
        if (target && tooltipEl) {
          const x = e.clientX + 10;
          const y = e.clientY + 15;
          tooltipEl.style.left = `${x}px`;
          tooltipEl.style.top = `${y}px`;
        }
      };

      const handleMouseOut = (e) => {
        const target = e.target.closest('[data-tooltip], [data-txatooltip]');
        if (target) {
          tooltipEl.classList.add('opacity-0', 'scale-95');
          tooltipEl.classList.remove('opacity-100', 'scale-100');
        }
      };

      document.removeEventListener('mouseover', handleMouseOver);
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('mouseout', handleMouseOut);

      document.addEventListener('mouseover', handleMouseOver);
      document.addEventListener('mousemove', handleMouseMove);
      document.addEventListener('mouseout', handleMouseOut);
      
      // Global Modal Controller
      window.txamodal = {
        show: (options) => {
          const modal = document.getElementById('txa-global-modal');
          if (!modal) return;
          const modalBox = modal.querySelector('div');
          
          // Dynamic sizing
          modalBox.classList.remove('max-w-md', 'max-w-2xl');
          if (options.size === 'lg') {
            modalBox.classList.add('max-w-2xl');
          } else {
            modalBox.classList.add('max-w-md');
          }

          const titleEl = document.getElementById('txa-modal-title');
          const bodyEl = document.getElementById('txa-modal-body');
          const confirmBtn = document.getElementById('txa-modal-confirm');
          const cancelBtn = document.getElementById('txa-modal-cancel');
          const closeBtn = document.getElementById('txa-modal-close');

          titleEl.innerHTML = options.title || 'Thông báo';
          bodyEl.innerHTML = options.message || options.content || '';
          
          if (options.cancelText) {
            cancelBtn.textContent = options.cancelText;
            cancelBtn.classList.remove('hidden');
          } else {
            cancelBtn.classList.add('hidden');
          }

          if (options.confirmText === '') {
            confirmBtn.classList.add('hidden');
          } else {
            confirmBtn.classList.remove('hidden');
            confirmBtn.textContent = options.confirmText || 'Xác nhận';
            if (options.type === 'danger' || options.type === 'error') {
              confirmBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-500 text-white transition-all';
            } else {
              confirmBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold bg-violet-600 hover:bg-violet-500 text-white transition-all';
            }
          }

          const closeModal = () => {
            modal.classList.add('opacity-0');
            modalBox.classList.add('scale-95');
            setTimeout(() => {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
              bodyEl.innerHTML = '';
            }, 200);
            document.body.style.overflow = '';
          };

          confirmBtn.onclick = () => {
            closeModal();
            if (typeof options.onConfirm === 'function') options.onConfirm();
          };

          cancelBtn.onclick = () => {
            closeModal();
            if (typeof options.onCancel === 'function') options.onCancel();
          };

          closeBtn.onclick = closeModal;
          modal.onclick = (e) => {
            if (e.target === modal) closeModal();
          };

          document.body.style.overflow = 'hidden';
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalBox.classList.remove('scale-95');
          }, 10);
        }
      };

      // Global Toast Notification Helper
      window.txatoast = {
        show: (message, type = 'success', duration = 3000) => {
          let container = document.getElementById('txa-toast-container');
          if (!container) {
            container = document.createElement('div');
            container.id = 'txa-toast-container';
            container.className = 'fixed top-6 right-6 z-[100000] flex flex-col gap-3 pointer-events-none';
            document.body.appendChild(container);
          }

          const toast = document.createElement('div');
          toast.className = 'txatoast flex items-center gap-3 px-4 py-3 rounded-xl shadow-2xl border border-white/10 backdrop-blur-md bg-zinc-900/95 text-white pointer-events-auto transform translate-x-4 opacity-0 transition-all duration-300';
          
          const icons = { success: 'check_circle', error: 'cancel', info: 'info' };
          const colors = { success: 'text-emerald-400', error: 'text-rose-500', info: 'text-cyan-400' };
          
          toast.innerHTML = `
            <span class="material-symbols-outlined ${colors[type] || 'text-emerald-400'}">${icons[type] || 'check_circle'}</span>
            <span class="text-xs font-medium font-body-main">${message}</span>
          `;

          container.appendChild(toast);
          
          setTimeout(() => {
            toast.classList.remove('translate-x-4', 'opacity-0');
          }, 10);

          setTimeout(() => {
            toast.classList.add('translate-x-4', 'opacity-0');
            setTimeout(() => {
              toast.remove();
            }, 300);
          }, duration);
        }
      };
      window.showGlobalToast = window.txatoast.show;
      // Dynamic Profile updates
      const loggedIn = localStorage.getItem('tlogged_in_as');
      if (loggedIn) {
        let avatar = '/logo-decoy.png';
        let nameDisplay = loggedIn;
        let roleDisplay = 'Quản trị viên';
        
        try {
          const users = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
          const user = users.find(u => u.username === loggedIn || u.email === loggedIn);
          if (user) {
            avatar = user.avatar || avatar;
            nameDisplay = user.username || loggedIn;
            roleDisplay = (user.roles === 'admin' || user.role === 'admin') ? 'Super Admin' : 'Quản trị viên';
          } else if (loggedIn === 'admin') {
            nameDisplay = 'admin';
            roleDisplay = 'Super Admin';
          }
        } catch(e) {}

        const avatarEl = document.getElementById('sidebar-avatar');
        const usernameEl = document.getElementById('sidebar-username');
        const roleEl = document.getElementById('sidebar-role');

        if (avatarEl) avatarEl.src = avatar;
        if (usernameEl) usernameEl.textContent = nameDisplay;
        if (roleEl) roleEl.textContent = roleDisplay;
      }

      // Zalo pending badge updater
      async function updateZaloPendingBadge() {
        const badge = document.getElementById('zalo-pending-badge');
        if (!badge) {
          if (window.zaloBadgeInterval) {
            clearInterval(window.zaloBadgeInterval);
            window.zaloBadgeInterval = null;
          }
          return;
        }

        let count = 0;
        if (providerType === 'supabase') {
          try {
            const res = await fetch('/api/admin/zalo-action');
            if (res.ok) {
              const resData = await res.json();
              if (resData && typeof resData.count === 'number') {
                count = resData.count;
              } else if (resData && resData.data && typeof resData.data.count === 'number') {
                count = resData.data.count;
              }
            }
          } catch (e) {
            console.error('Lỗi khi lấy số lượng yêu cầu Zalo:', e);
          }
        } else {
          // Local mode
          try {
            const list = JSON.parse(localStorage.getItem('txa_zalo_access') || '[]');
            count = list.filter(x => x.status === 'pending').length;
          } catch (e) {}
        }

        if (count > 0) {
          badge.textContent = `+${count}`;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }

      updateZaloPendingBadge();

      if (window.zaloBadgeInterval) clearInterval(window.zaloBadgeInterval);
      window.zaloBadgeInterval = setInterval(updateZaloPendingBadge, 5000);
    }

    initAdminLayout();
    document.addEventListener('astro:page-load', initAdminLayout);
  </script>
</body>
</html>
