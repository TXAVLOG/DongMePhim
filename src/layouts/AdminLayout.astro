    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #37333e; border-radius: 10px; }

    @keyframes rainbow-text-animation {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    @keyframes rainbow-glow-animation {
      0% { box-shadow: 0 0 25px rgba(255, 0, 0, 0.25), 0 0 45px rgba(0, 0, 255, 0.15); }
      50% { box-shadow: 0 0 25px rgba(0, 255, 0, 0.25), 0 0 45px rgba(255, 255, 0, 0.15); }
      100% { box-shadow: 0 0 25px rgba(255, 0, 0, 0.25), 0 0 45px rgba(0, 0, 255, 0.15); }
    }

    /* Tự động giãn đều kích thước, khoảng cách và font chữ cho Desktop */
    @media (min-width: 1280px) { /* xl */
      html.admin-root { font-size: 17px; }
    }
    @media (min-width: 1536px) { /* 2xl */
      html.admin-root { font-size: 19px; }
    }
    @media (min-width: 1920px) { /* 3xl+ */
      html.admin-root { font-size: 21px; }
    }
  </style>
</head>
