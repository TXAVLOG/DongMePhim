---
import '../styles/index.css';
import { SettingService } from '../services/SettingService';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
}

const { title } = Astro.props;
const settings = await SettingService.getSettings();
const isSmtpConfigured = !!(settings.smtp?.smtp_host && settings.smtp?.smtp_user && settings.smtp?.smtp_pass);
const providerType = import.meta.env.PUBLIC_DATA_PROVIDER || 'local';

const packages = settings.packages || [];
let packageStyles = '';
packages.forEach((pkg: any) => {
  if (pkg.style_type === 'rainbow_effect') {
    packageStyles += `
      .package-style-${pkg.id} {
        background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8f00ff);
        background-size: 400% 400%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbow-text-animation 6s ease infinite;
        font-weight: bold;
      }
      .package-border-${pkg.id} {
        position: relative;
        border-color: transparent !important;
      }
      .package-border-${pkg.id}::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 2px;
        background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8f00ff);
        background-size: 400% 400%;
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
        animation: rainbow-text-animation 6s ease infinite;
      }
      .package-glow-${pkg.id} {
        animation: rainbow-glow-animation 6s ease infinite;
      }
      .package-btn-${pkg.id} {
        background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8f00ff) !important;
        background-size: 400% 400%;
        color: #000 !important;
        font-weight: 900 !important;
        animation: rainbow-text-animation 6s ease infinite;
        box-shadow: 0 0 20px rgba(139, 92, 246, 0.4) !important;
      }
    `;
  } else if (pkg.style_type === 'custom_color' && pkg.custom_color) {
    packageStyles += `
      .package-style-${pkg.id} {
        color: ${pkg.custom_color} !important;
        font-weight: bold;
      }
      .package-border-${pkg.id} {
        border-color: ${pkg.custom_color} !important;
      }
      .package-glow-${pkg.id} {
        box-shadow: 0 0 25px ${pkg.custom_color}4d !important;
      }
      .package-btn-${pkg.id} {
        background-color: ${pkg.custom_color} !important;
        color: #000 !important;
        box-shadow: 0 4px 14px ${pkg.custom_color}4d !important;
      }
    `;
  }
});
