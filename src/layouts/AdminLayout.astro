---
import '../styles/index.css';
import { SettingService } from '../services/SettingService';

interface Props {
  title: string;
}

const { title } = Astro.props;
const settings = await SettingService.getSettings();
---

<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="referrer" content="no-referrer" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | {settings.general.site_name} Admin</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  
<style is:global>
    .glass-panel {
        background: rgba(18, 18, 20, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .sidebar-active {
        background: rgba(210, 187, 255, 0.15);
        border-left: 3px solid #d2bbff;
        color: #d2bbff;
    }
    .neon-gradient-text {
        background: linear-gradient(to right, #d2bbff, #00daf3);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px -15px rgba(210, 187, 255, 0.2);
        border-color: rgba(210, 187, 255, 0.4);
    }
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #37333e; border-radius: 10px; }
  </style>
</head>
<body class="bg-surface-deep text-on-surface font-body-main selection:bg-primary/30">
  <div class="flex min-h-screen">
    <!-- SideNavBar -->
    <aside class="fixed left-0 top-0 h-full w-64 bg-surface-container-lowest/80 backdrop-blur-2xl border-r border-glass-stroke hidden lg:flex flex-col py-8 z-50">
      <div class="px-6 mb-8 flex items-center gap-3">
        <a href="/tphim" class="flex items-center gap-3" title="Về trang chủ">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-primary to-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-on-primary-fixed">movie_filter</span>
          </div>
          <div>
            <h1 class="font-display-hero text-title-md text-primary leading-none">{settings.general.site_name}</h1>
            <p class="text-[10px] text-text-dim font-label-caps tracking-widest mt-1">PREMIUM ADMIN</p>
          </div>
        </a>
      </div>
      
      <!-- Profile Info -->
      <div class="px-4 mb-6">
        <div class="glass-panel rounded-2xl p-4 flex items-center gap-3">
          <div class="relative">
            <img alt="Admin Avatar" class="w-10 h-10 rounded-full object-cover border-2 border-primary/20" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCqp33LfcA-w_kjd-HzFU-K80l1qq2M_ZRyzgUG8pz6_he7pyx9UttAoNBl1iaJ9bAke_TMHTnvEVB9wE2CFymqNH818Lk9YQmBAtdvSiL-nlwI5EkXkJEj0YG6HTfwQaq-n0BQZmItZsYAx_VK2MPXRuNa93P8ypKP6VwLTyIwfKIIAeZU7Ok55bckAjP3URJ0gBcisLPKJjdMnApqOgebWSoS-RXy5I_7BnTMYLtOfFE3OTpUANQKOWEWXZtDMY2S8tq_U8tleB9V"/>
            <div class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 border-2 border-surface-deep rounded-full"></div>
          </div>
          <div class="overflow-hidden">
            <p class="font-title-md text-sm truncate">Admin_{settings.general.site_name}</p>
            <p class="text-xs text-text-dim font-label-caps">Super Admin</p>
          </div>
        </div>
      </div>
      
      <!-- Navigation -->
      <nav class="flex-1 px-2 space-y-1 overflow-y-auto custom-scrollbar pb-20">
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-dashboard" href="/admin">
          <span class="material-symbols-outlined text-xl">dashboard</span>
          <span class="font-label-caps text-xs">Tổng quan</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-movie" href="/admin/phim">
          <span class="material-symbols-outlined text-xl">movie</span>
          <span class="font-label-caps text-xs">Quản lý Phim</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-manual-movie" href="/admin/phim/tao-thu-cong">
          <span class="material-symbols-outlined text-xl">edit_square</span>
          <span class="font-label-caps text-xs">Tạo phim thủ công</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-crawler" href="/admin/phim/crawler">
          <span class="material-symbols-outlined text-xl">cloud_download</span>
          <span class="font-label-caps text-xs">Thu thập phim</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-server" href="/admin/he-thong/server">
          <span class="material-symbols-outlined text-xl">dns</span>
          <span class="font-label-caps text-xs">Quản lý Server</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-actor" href="/admin/dien-vien">
          <span class="material-symbols-outlined text-xl">theater_comedy</span>
          <span class="font-label-caps text-xs">Diễn viên</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-category" href="/admin/phim/the-loai">
          <span class="material-symbols-outlined text-xl">category</span>
          <span class="font-label-caps text-xs">Thể loại</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-ios" href="/admin/he-thong/ios-management">
          <span class="material-symbols-outlined text-xl">phonelink_setup</span>
          <span class="font-label-caps text-xs">Thiết bị & Chứng chỉ iOS</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-error" href="/admin/he-thong/bao-cao-loi">
          <span class="material-symbols-outlined text-xl">report</span>
          <span class="font-label-caps text-xs">Báo cáo lỗi</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-comment" href="/admin/thanh-vien/binh-luan">
          <span class="material-symbols-outlined text-xl">forum</span>
          <span class="font-label-caps text-xs">Quản lý bình luận</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-sub" href="/admin/thanh-vien/goi-dang-ky">
          <span class="material-symbols-outlined text-xl">card_membership</span>
          <span class="font-label-caps text-xs">Gói đăng ký</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-email" href="/admin/he-thong/email-logs">
          <span class="material-symbols-outlined text-xl">mail_lock</span>
          <span class="font-label-caps text-xs">Lịch sử mail gửi đi</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-variant/30 rounded-lg transition-all duration-200" id="nav-user" href="/admin/thanh-vien">
          <span class="material-symbols-outlined text-xl">group</span>
          <span class="font-label-caps text-xs">Thành viên</span>
        </a>
      </nav>
      
      <div class="px-4 mt-auto py-4 bg-surface-container-lowest/80 backdrop-blur-md">
        <button class="w-full py-2 bg-gradient-to-r from-primary/20 to-secondary/20 border border-primary/30 rounded-xl text-primary font-label-caps text-[10px] hover:from-primary/30 hover:to-secondary/30 transition-all flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-sm">auto_awesome</span>
          Upgrade Pro
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 lg:ml-64 p-6 md:p-10 w-full overflow-x-hidden min-h-screen flex flex-col">
      <slot />

      <!-- Footer -->
      <footer class="mt-auto pt-12 border-t border-glass-stroke w-full pb-6">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <div>
            <h4 class="font-display-hero text-title-md text-primary mb-1">{settings.general.site_name} Admin</h4>
            <p class="font-body-main text-[10px] font-label-caps text-text-dim">© {new Date().getFullYear()} {settings.general.site_name}. Tất cả các quyền được bảo lưu.</p>
          </div>
          <div class="flex gap-4">
             <a class="text-xs text-text-dim hover:text-primary transition-colors" href={settings.social?.social_telegram_url || "/lien-he"} target="_blank" rel="noopener noreferrer">Trợ giúp</a>
             <a class="text-xs text-text-dim hover:text-primary transition-colors" href="/bao-mat">Quyền riêng tư</a>
          </div>
        </div>
      </footer>
    </main>

    <!-- Mobile Navigation -->
    <nav class="fixed bottom-0 left-0 w-full lg:hidden bg-surface-container-lowest/90 backdrop-blur-xl border-t border-glass-stroke py-3 px-6 flex justify-between items-center z-50">
      <a class="flex flex-col items-center gap-1 text-primary" href="/admin">
        <span class="material-symbols-outlined">dashboard</span>
        <span class="text-[10px] font-label-caps">Home</span>
      </a>
      <a class="flex flex-col items-center gap-1 text-on-surface-variant" href="/admin/phim">
        <span class="material-symbols-outlined">movie</span>
        <span class="text-[10px] font-label-caps">Movies</span>
      </a>
      <a class="flex flex-col items-center gap-1 text-on-surface-variant" href="/admin/thanh-vien">
        <span class="material-symbols-outlined">group</span>
        <span class="text-[10px] font-label-caps">Users</span>
      </a>
      <a class="flex flex-col items-center gap-1 text-on-surface-variant" href="/admin/he-thong">
        <span class="material-symbols-outlined">settings</span>
        <span class="text-[10px] font-label-caps">Config</span>
      </a>
    </nav>
  </div>

  <script>
    // Highlight active sidebar item based on current URL path
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('aside nav a');
    
    let matchedLink = null;
    let longestMatch = 0;

    navLinks.forEach(link => {
        const href = link.getAttribute('href');
        if (href && currentPath.startsWith(href) && href.length > longestMatch) {
            longestMatch = href.length;
            matchedLink = link;
        }
    });

    // Special case for root `/admin` so it doesn't match everything
    if(currentPath === '/admin' || currentPath === '/admin/') {
        matchedLink = document.getElementById('nav-dashboard');
    }

    if (matchedLink) {
        matchedLink.classList.remove('text-on-surface-variant');
        matchedLink.classList.add('sidebar-active');
        const icon = matchedLink.querySelector('.material-symbols-outlined');
        if (icon instanceof HTMLElement) {
            icon.style.fontVariationSettings = "'FILL' 1";
        }
    }
  </script>
</body>
</html>
