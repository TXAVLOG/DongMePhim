---
import MainLayout from '@layouts/MainLayout.astro';
import { MovieService } from '@services/MovieService';
import { Button } from '@components/ui/Button';

// Mock Auth check (in real app this uses cookies or session)
const isLoggedIn = Astro.cookies.has('txa_gate_passed');

if (!isLoggedIn) {
  // If we want to strictly protect this page, redirect:
  // return Astro.redirect('/login');
}

// Dummy list of user's saved movies
const savedMovies = await MovieService.getMovies({ type: 'series', limit: 5 });
---

<MainLayout title="Danh sách của tôi">
  <main class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 space-y-8 min-h-[70vh]">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-glass-stroke pb-6">
      <div>
        <h1 class="font-display-hero text-4xl text-white font-bold tracking-tight">Danh sách của tôi</h1>
        <p class="text-on-surface-variant mt-2 font-body-main">Kho lưu trữ các bộ phim yêu thích của bạn.</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="bg-surface border border-glass-stroke rounded-xl px-4 py-2 text-sm text-white flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary text-sm">movie</span>
          {savedMovies.length} phim đã lưu
        </div>
      </div>
    </div>

    <div class="auth-guest flex flex-col items-center justify-center text-center shadow-2xl glass-card bg-surface-card border border-glass-stroke rounded-3xl p-12">
        <div class="w-20 h-20 rounded-full bg-primary/10 flex items-center justify-center mb-6 border border-primary/20">
          <span class="material-symbols-outlined text-primary text-4xl">lock</span>
        </div>
        <h2 class="text-2xl text-white font-title-md mb-2">Yêu cầu đăng nhập</h2>
        <p class="text-on-surface-variant max-w-md mx-auto mb-8 font-body-main">Bạn cần đăng nhập vào tài khoản để lưu danh sách phim yêu thích trên nhiều thiết bị.</p>
        <button onclick="window.dispatchEvent(new Event('open-login-modal'))" class="px-8 py-3 rounded-full text-white font-bold bg-gradient-to-br from-primary-container to-secondary-container shadow-lg hover:brightness-110 transition-all">
          Đăng nhập ngay
        </button>
    </div>
    
    <div class="auth-user hidden">
      {savedMovies.length === 0 ? (
        <div class="text-center py-20 text-on-surface-variant">Bạn chưa lưu bộ phim nào.</div>
      ) : (
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4 lg:gap-6">
          {savedMovies.map((movie: any) => (
            <div class="group relative flex flex-col gap-2 card-hover">
              <a href={`/phim/${movie.slug}`} class="block w-full aspect-[2/3] relative rounded-lg overflow-hidden glass-card border border-glass-stroke transition-all duration-300">
                <img src={movie.posterUrl} alt={movie.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-deep via-surface-deep/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity"></div>
                
                <div class="absolute bottom-0 left-0 w-full p-3 flex flex-col justify-end gap-1">
                  <h3 class="text-white font-title-md text-sm line-clamp-2 leading-tight">{movie.title}</h3>
                  <div class="flex items-center gap-2">
                    <span class="bg-secondary/20 text-secondary px-1.5 py-0.5 rounded text-[10px] font-label-caps font-bold">{movie.releaseYear}</span>
                    {movie.lang && <span class="text-text-dim text-[10px] font-label-caps">{movie.lang}</span>}
                  </div>
                </div>
              </a>
              <!-- Actions -->
              <button class="w-full bg-surface border border-red-500/30 rounded-lg py-2 text-xs font-bold text-red-400 hover:text-white hover:bg-red-500/80 hover:border-red-500 transition-all flex items-center justify-center gap-1 group/btn relative" onclick="showToast('Đã gỡ khỏi Playlist', 'success')">
                <span class="material-symbols-outlined text-[16px]">bookmark_remove</span>
                Bỏ lưu
                <div class="txatooltip absolute -top-8 left-1/2 -translate-x-1/2 pointer-events-none">Xóa khỏi Playlist</div>
              </button>
            </div>
          ))}
        </div>
      )}
    </div>

  </main>
  
  <div id="txa-toast-container"></div>
</MainLayout>

<script>
  declare global {
    interface Window {
      showToast: (message: string, type?: string) => void;
    }
  }

  // 1. Toggle visibility based on cookie client-side
  (function() {
    const isLoggedIn = document.cookie.includes('txa_gate_passed');
    const guest = document.querySelector('.auth-guest');
    const user = document.querySelector('.auth-user');
    if (isLoggedIn) {
      guest?.classList.add('hidden');
      guest?.classList.remove('flex');
      user?.classList.remove('hidden');
    } else {
      guest?.classList.remove('hidden');
      guest?.classList.add('flex');
      user?.classList.add('hidden');
    }
  })();

  window.showToast = function(message: string, type = 'success') {
    const toastContainer = document.getElementById('txa-toast-container');
    if (!toastContainer) return;
    
    const toast = document.createElement('div');
    toast.className = 'txatoast';
    
    const icon = type === 'success' ? 'check_circle' : 'error';
    const colorClass = type === 'success' ? 'text-green-400' : 'text-red-400';
    
    toast.innerHTML = `
      <span class="material-symbols-outlined ${colorClass}">${icon}</span>
      <span>${message}</span>
    `;
    
    toastContainer.appendChild(toast);
    
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(100%)';
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }
</script>
