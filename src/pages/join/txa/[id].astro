---
import MainLayout from '@layouts/MainLayout.astro';
import { SettingService } from '@services/SettingService';

const { id } = Astro.params;
const settings = await SettingService.getSettings();
const events = (settings as any).lucky_draw_events || [];
const event = events.find((e: any) => e.id === id);
---

<MainLayout title={event ? event.title : "Sự kiện Vòng Quay May Mắn"}>
  <main class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 min-h-[85vh] flex flex-col items-center justify-center">
    {!event ? (
      <div class="glass-panel border border-rose-500/30 bg-rose-500/5 rounded-3xl p-12 text-center max-w-lg space-y-4 shadow-2xl">
        <div class="w-20 h-20 rounded-full bg-rose-500/10 border border-rose-500/20 flex items-center justify-center mx-auto">
          <span class="material-symbols-outlined text-rose-500 text-4xl">error</span>
        </div>
        <h1 class="text-2xl font-black text-white">Liên kết không hợp lệ!</h1>
        <p class="text-xs text-zinc-400 font-body-main leading-relaxed">Sự kiện bạn đang tìm kiếm không tồn tại hoặc đã bị xóa khỏi hệ thống. Vui lòng kiểm tra lại đường dẫn.</p>
        <a href="/tphim" class="inline-block px-8 py-3 bg-white/10 hover:bg-white/20 text-white font-bold rounded-full text-xs transition-all no-underline mt-4">Về Trang Chủ</a>
      </div>
    ) : (
      <div class="w-full max-w-4xl space-y-8 text-center" id="lucky-draw-app-root" data-event={JSON.stringify(event)}>
        
        <!-- Header & Countdown -->
        <div class="space-y-3">
          <span class="px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded-full text-[10px] font-black uppercase tracking-widest">MINIGAME ĐẶC BIỆT</span>
          <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight">{event.title}</h1>
          <p class="text-xs md:text-sm text-zinc-400 max-w-xl mx-auto font-body-main">{event.description || 'Đăng ký tham gia minigame để có cơ hội nhận ngay nhiều phần quà hấp dẫn từ Ban Quản Trị!'}</p>
        </div>

        <!-- Participant & Timer Bar -->
        <div class="flex flex-wrap items-center justify-center gap-4 text-xs">
          <div class="glass-panel border border-glass-stroke rounded-2xl px-5 py-3 flex items-center gap-2.5">
            <span class="material-symbols-outlined text-emerald-400 text-lg">group</span>
            <span class="text-zinc-400">TV đã tham gia: <strong class="text-white font-bold" id="participants-cnt">{(event.participants || []).length || event.participantsCount || 0} người</strong></span>
          </div>

          <div class="glass-panel border border-glass-stroke rounded-2xl px-5 py-3 flex items-center gap-2.5">
            <span class="material-symbols-outlined text-amber-400 text-lg">timer</span>
            <span class="text-zinc-400">Kết thúc sau: <strong class="text-amber-400 font-mono font-bold" id="countdown-timer">--:--:--</strong></span>
          </div>
        </div>

        <!-- Claim Phone Box (Phone cards / Physical gifts only) -->
        <div id="user-win-phone-claim-box" class="hidden glass-panel border-2 border-emerald-500/50 bg-emerald-500/10 rounded-3xl p-6 text-left max-w-xl mx-auto space-y-3 shadow-[0_0_40px_rgba(16,185,129,0.2)]">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-emerald-400 text-3xl">emoji_events</span>
            <div>
              <h3 class="text-base font-bold text-white">🎉 Chúc Mừng Bạn Đã Trúng Giải THẺ CÀO / QUÀ TẶNG!</h3>
              <p class="text-xs text-emerald-300 font-bold" id="user-prize-phone-name">Phần quà: ...</p>
            </div>
          </div>
          <p class="text-xs text-zinc-300">Vui lòng nhập Số Điện Thoại để Admin liên hệ trao quà / nạp thẻ cào:</p>
          <div class="flex gap-2">
            <input type="tel" id="user-phone-input" placeholder="Nhập SĐT của bạn (10 số)..." class="flex-1 bg-zinc-900 border border-zinc-700 rounded-xl px-4 py-2.5 text-white font-mono font-bold text-xs focus:outline-none focus:border-emerald-500" />
            <button onclick="submitUserPhoneClaim('${event.id}')" class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl text-xs transition-all cursor-pointer border-none shadow-md">
              Gửi SĐT
            </button>
          </div>
        </div>

        <!-- VIP Package Auto-Awarded Notice Box -->
        <div id="user-win-vip-notice-box" class="hidden glass-panel border-2 border-purple-500/50 bg-purple-500/10 rounded-3xl p-6 text-left max-w-xl mx-auto space-y-2 shadow-[0_0_40px_rgba(168,85,247,0.2)]">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-purple-400 text-3xl">workspace_premium</span>
            <div>
              <h3 class="text-base font-bold text-white">🎉 CHÚC MỪNG BẠN ĐÃ TRÚNG GÓI VIP!</h3>
              <p class="text-xs text-purple-300 font-bold" id="user-prize-vip-name">Phần quà: ...</p>
            </div>
          </div>
          <p class="text-xs text-zinc-300 leading-relaxed">Gói cước VIP đã được hệ thống tự động cộng 30 ngày hoặc tự động nâng cấp vào tài khoản của bạn. Chúc bạn xem phim vui vẻ!</p>
        </div>

        <!-- Join Event Action Box -->
        <div class="glass-panel border border-glass-stroke rounded-3xl p-8 max-w-xl mx-auto space-y-4 shadow-2xl">
          <div class="w-16 h-16 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mx-auto">
            <span class="material-symbols-outlined text-amber-400 text-3xl">how_to_reg</span>
          </div>
          <h3 class="text-xl font-bold text-white">Đăng Ký Tham Gia Minigame</h3>
          <p class="text-xs text-zinc-400 font-body-main leading-relaxed">Nhấp vào nút bên dưới để ghi tên vào danh sách quay thưởng. Ban Quản Trị sẽ tiến hành quay vòng quay trực tiếp!</p>
          
          <button id="btn-join-event" onclick="joinMinigameEvent('${event.id}')" class="w-full py-4 bg-gradient-to-r from-amber-500 via-amber-400 to-amber-600 hover:scale-[1.02] active:scale-[0.98] text-slate-950 font-black text-sm uppercase tracking-wider rounded-2xl transition-all cursor-pointer border-none shadow-xl shadow-amber-500/25 flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-xl">check_circle</span>
            <span id="btn-join-text">XÁC NHẬN THAM GIA</span>
          </button>
        </div>

        <!-- Prize List Grid -->
        <div class="space-y-4 pt-4">
          <h3 class="text-base font-bold text-white uppercase tracking-wider flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-amber-400">card_giftcard</span> Danh Sách Giải Thưởng Minigame
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
            {(event.prizes || []).map((p: any) => (
              <div class="glass-panel border border-glass-stroke/60 rounded-2xl p-4 space-y-2 flex flex-col justify-between" style={`border-left: 4px solid ${p.color || '#f59e0b'}`}>
                <div>
                  <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-wider">Giải Thưởng</span>
                  <h4 class="text-sm font-bold text-white mt-0.5">{p.name}</h4>
                </div>
                <div class="flex justify-between items-center text-xs pt-2 border-t border-glass-stroke/30">
                  <span class="text-zinc-400">Số lượng:</span>
                  <span class="font-bold text-amber-400">{p.maxQuantity || p.count || 1} phần</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Winners Leaderboard -->
        <div class="glass-panel border border-glass-stroke rounded-3xl p-6 text-left space-y-4 shadow-xl">
          <div class="flex justify-between items-center border-b border-glass-stroke/40 pb-3">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-amber-400">emoji_events</span> Bảng Vàng Người Trúng Giải
            </h3>
            <span class="text-xs text-zinc-400 font-mono" id="winners-cnt-badge">{(event.winners || []).length} người đã trúng</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="text-[10px] text-zinc-500 uppercase font-bold border-b border-glass-stroke/30">
                  <th class="p-3">Thời gian quay</th>
                  <th class="p-3">Thành viên</th>
                  <th class="p-3">Giải thưởng đã trúng</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-glass-stroke/20" id="winners-table-body">
                {(event.winners || []).length === 0 ? (
                  <tr><td colspan="3" class="p-6 text-center text-zinc-500">Chưa có kết quả quay thưởng nào. Ban quản trị sẽ tiến hành quay sớm!</td></tr>
                ) : (event.winners || []).map((w: any) => (
                  <tr class="hover:bg-white/5 transition-all">
                    <td class="p-3 font-mono text-zinc-400">{new Date(w.wonAt || w.drawnAt || Date.now()).toLocaleString('vi-VN')}</td>
                    <td class="p-3 font-bold text-white flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
                      {w.username || 'Thành viên'}
                    </td>
                    <td class="p-3 font-bold text-amber-400">{w.prizeName || 'Phần quà'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    )}
  </main>
</MainLayout>

<script is:inline>
  (function() {
    const root = document.getElementById('lucky-draw-app-root');
    if (!root) return;

    const event = JSON.parse(root.dataset.event || '{}');

    // Countdown Timer
    function updateTimer() {
      const timerEl = document.getElementById('countdown-timer');
      if (!timerEl || !event.endTime) return;

      const diff = new Date(event.endTime) - new Date();
      if (diff <= 0) {
        timerEl.textContent = 'Đã kết thúc!';
        return;
      }

      const hours = Math.floor(diff / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);
      timerEl.textContent = `${hours.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }
    setInterval(updateTimer, 1000);
    updateTimer();

    // Check user registration and winning status
    function checkUserStatus() {
      if (!window.APP_USER) return;
      const uName = window.APP_USER.username;
      const participants = event.participants || [];
      const isJoined = participants.some(p => (typeof p === 'string' ? p === uName : p.username === uName));

      const btnText = document.getElementById('btn-join-text');
      const btn = document.getElementById('btn-join-event');
      if (isJoined && btnText && btn) {
        btnText.textContent = 'BẠN ĐÃ THAM GIA THÀNH CÔNG';
        btn.classList.remove('from-amber-500', 'via-amber-400', 'to-amber-600');
        btn.classList.add('bg-emerald-600', 'text-white', 'cursor-default');
        btn.disabled = true;
      }

      // Check if user won
      const winners = event.winners || [];
      const winEntry = winners.find(w => w.username === uName);
      if (winEntry) {
        if (winEntry.prizeType === 'phone') {
          const phoneClaimBox = document.getElementById('user-win-phone-claim-box');
          const prizeNameEl = document.getElementById('user-prize-phone-name');
          if (phoneClaimBox && prizeNameEl) {
            prizeNameEl.textContent = `Phần quà: ${winEntry.prizeName}`;
            phoneClaimBox.classList.remove('hidden');
          }
        } else if (winEntry.prizeType === 'vip') {
          const vipNoticeBox = document.getElementById('user-win-vip-notice-box');
          const prizeVipNameEl = document.getElementById('user-prize-vip-name');
          if (vipNoticeBox && prizeVipNameEl) {
            prizeVipNameEl.textContent = `Gói cước: ${winEntry.prizeName}`;
            vipNoticeBox.classList.remove('hidden');
          }
        }
      }
    }

    setTimeout(checkUserStatus, 300);

    window.joinMinigameEvent = async function(eventId) {
      if (!window.APP_USER) {
        if (window.showGlobalToast) window.showGlobalToast('Vui lòng đăng nhập để tham gia minigame!', 'error');
        window.dispatchEvent(new Event('open-login-modal'));
        return;
      }

      try {
        const res = await fetch('/api/admin/lucky-draw', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'join_event', eventId, username: window.APP_USER.username })
        });
        if (res.ok) {
          if (window.showGlobalToast) window.showGlobalToast('Đã đăng ký tham gia thành công!', 'success');
          setTimeout(() => window.location.reload(), 1000);
        }
      } catch (e) {}
    };

    window.submitUserPhoneClaim = async function(eventId) {
      const phone = (document.getElementById('user-phone-input')?.value || '').trim();
      const vnPnRegex = /(84|0[3|5|7|8|9])+([0-9]{8})\b/;
      if (!vnPnRegex.test(phone)) {
        if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập đúng số điện thoại Việt Nam hợp lệ!', 'error');
        return;
      }

      const winners = event.winners || [];
      const winEntry = winners.find(w => w.username === (window.APP_USER ? window.APP_USER.username : ''));

      try {
        const res = await fetch('/api/admin/lucky-draw', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'claim_phone_prize',
            eventId,
            phone,
            winnerName: window.APP_USER ? window.APP_USER.username : 'Khách',
            prizeName: winEntry ? winEntry.prizeName : 'Phần quà'
          })
        });
        if (res.ok) {
          if (window.showGlobalToast) window.showGlobalToast('Đã gửi thông tin SĐT nhận giải thành công!', 'success');
          document.getElementById('user-win-phone-claim-box')?.classList.add('hidden');
        }
      } catch (e) {}
    };
  })();
</script>
