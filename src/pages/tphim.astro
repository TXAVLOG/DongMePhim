        'cau-truyen-hinh': { title: 'Cầu Truyền Hình', posterUrl: 'https://lh3.googleusercontent.com/aida/AP1WRLskEpjrTbHRx6Jj3TAoagePHNQcXAyfE57exarNW0uRrctCdcc2Ns3Gccg-Q-sHR-iGafdXbWGBY3VqNGMMuNWRowyO8JZHlFLslh1G5WNrcjJ3y-OsTKgIzQGIYkOO5N88CKrVCPSenE4g8yUwk_MMtWZukOp8Pey1U0z24BjmBKodM448SynZ3QPSKC1mnooHd98SJMI_XxGvi66yl7YdJWaJyz_WDpl2GVANjq5HCB5SoVUfM8sY3Auj' },
        'one-piece': { title: 'ONE PIECE', posterUrl: 'https://lh3.googleusercontent.com/aida/AP1WRLskEpjrTbHRx6Jj3TAoagePHNQcXAyfE57exarNW0uRrctCdcc2Ns3Gccg-Q-sHR-iGafdXbWGBY3VqNGMMuNWRowyO8JZHlFLslh1G5WNrcjJ3y-OsTKgIzQGIYkOO5N88CKrVCPSenE4g8yUwk_MMtWZukOp8Pey1U0z24BjmBKodM448SynZ3QPSKC1mnooHd98SJMI_XxGvi66yl7YdJWaJyz_WDpl2GVANjq5HCB5SoVUfM8sY3Auj' }
      };

      // 4. Fetch comments from Supabase API
      let allComments = [];
      try {
        const res = await fetch('/api/comments');
        if (res.ok) {
          const result = await res.json();
          if (result && result.status === 'success' && Array.isArray(result.data)) {
                allComments = result.data.map(c => {
                  const slug = c.movieSlug || '';
                  const movieObj = moviesMap[slug] || seedMoviesLookup[slug] || { title: slug.replace(/-/g, ' '), posterUrl: '/favicon.png' };
                  return {
                    id: c.id,
                    author: c.author,
                    content: c.content,
                    likes: c.likes || 0,
                    replies: c.replies || [],
                    gender: c.gender || 'other',
                    package: c.package || 'Free',
                    movieSlug: slug,
                    movieTitle: movieObj.title,
                    moviePoster: movieObj.posterUrl || movieObj.bannerUrl
                  };
                });
          }
        }
      } catch(e) {
        console.error('Error fetching comments from API:', e);
      }

      // 5. Render Carousel Top Bình Luận
      const carouselContainer = document.getElementById('comments-carousel');
      if (carouselContainer) {
        if (allComments.length > 0) {
          let carouselHtml = '';
          const top10Comments = allComments.slice(0, 10);
          top10Comments.forEach(c => {
            carouselHtml += createCarouselCommentCardHTML(c);
          });
          carouselContainer.innerHTML = carouselHtml;
        } else {
          carouselContainer.innerHTML = '<p class="text-xs text-zinc-500 py-8 text-center w-full font-outfit">Chưa có bình luận nào.</p>';
        }
      }

      // 6. Render Bình Luận Mới sidebar
      const newCommentsContainer = document.getElementById('binh-luan-moi-list');
      if (newCommentsContainer) {
        if (allComments.length > 0) {
          let sidebarHtml = '';
          const top5Comments = allComments.slice(0, 5);
          top5Comments.forEach(c => {
            sidebarHtml += createSidebarCommentRowHTML(c);
          });
          newCommentsContainer.innerHTML = sidebarHtml;
        } else {
          newCommentsContainer.innerHTML = '<p class="text-xs text-zinc-500 py-4 text-center font-outfit">Chưa có bình luận nào.</p>';
        }
      }

      // 7. Hero Banner Slide Cycle Animation
      const heroBanner = document.getElementById('hero-banner');
      const heroContent = document.getElementById('hero-content');
      const heroImdb = document.getElementById('hero-imdb');
      const heroYear = document.getElementById('hero-year');
      const heroType = document.getElementById('hero-type');
      const heroTitle = document.getElementById('hero-title');
      const heroDesc = document.getElementById('hero-desc');
      const heroPlayLink = document.getElementById('hero-play-link');
      const heroPlaylistBtn = document.getElementById('hero-playlist-btn');
      const bg1 = document.getElementById('hero-bg-1');
      const bg2 = document.getElementById('hero-bg-2');

      let currentHeroSlug = (typeof heroMoviesForClient !== 'undefined' && heroMoviesForClient.length > 0) ? heroMoviesForClient[0].slug : 'bai-hoc-dang-doi';

      let userPlaylist = [];
      const username = (window.APP_USER ? window.APP_USER.username : null) || '';

      async function loadWatchlist() {
        if (username) {
          try {
            const res = await fetch(`/api/user/watchlist?username=${encodeURIComponent(username)}`);
            if (res.ok) {
              const result = await res.json();
              userPlaylist = result.data?.playlist || [];
            }
          } catch(e) {
            console.error('Error loading watchlist:', e);
          }
        } else {
          userPlaylist = JSON.parse(localStorage.getItem('tplaylist') || '[]');
        }
        updateHeroPlaylistBtn();
      }

      let dbHistory = [];
      async function loadDbHistory() {
        if (username) {
          try {
            const res = await fetch(`/api/user/history?username=${encodeURIComponent(username)}`);
            if (res.ok) {
              dbHistory = await res.json() || [];
            }
          } catch(e) {
            console.error('Error loading DB history:', e);
          }
        }
      }

      const updateHeroPlaylistBtn = () => {
        const playlistBtn = document.getElementById('hero-playlist-btn');
        const iconAdd = document.getElementById('hero-playlist-icon-add');
        const iconAdded = document.getElementById('hero-playlist-icon-added');
        if (!playlistBtn || !iconAdd || !iconAdded) return;

        const isInPlaylist = userPlaylist.includes(currentHeroSlug);

        if (isInPlaylist) {
          iconAdd.classList.add('hidden');
          iconAdded.classList.remove('hidden');
          playlistBtn.classList.add('bg-primary/20', 'border-primary');
          playlistBtn.setAttribute('data-txatooltip', 'Xóa khỏi DS phát');
        } else {
          iconAdd.classList.remove('hidden');
          iconAdded.classList.add('hidden');
          playlistBtn.classList.remove('bg-primary/20', 'border-primary');
          playlistBtn.setAttribute('data-txatooltip', 'Thêm vào DS phát');
        }
      };
      window.updateHeroPlaylistBtn = updateHeroPlaylistBtn;

      const playlistBtn = document.getElementById('hero-playlist-btn');
      if (playlistBtn) {
        playlistBtn.addEventListener('click', async () => {
          const isLoggedIn = document.cookie.includes('txa_gate_passed');
          if (!isLoggedIn) {
            if (window.showGlobalToast) window.showGlobalToast('Vui lòng đăng nhập để thực hiện chức năng này!', 'error');
            setTimeout(() => {
              if (window.openLoginModal) window.openLoginModal();
            }, 800);
            return;
          }

          const isInPlaylist = userPlaylist.includes(currentHeroSlug);
          if (username) {
            try {
              if (isInPlaylist) {
                const res = await fetch(`/api/user/watchlist?username=${encodeURIComponent(username)}&slug=${encodeURIComponent(currentHeroSlug)}&type=playlist`, {
                  method: 'DELETE'
                });
                if (res.ok) {
                  userPlaylist = userPlaylist.filter(slug => slug !== currentHeroSlug);
                  if (window.showGlobalToast) window.showGlobalToast('Đã gỡ phim khỏi Danh sách phát!', 'success');
                }
              } else {
                const res = await fetch('/api/user/watchlist', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    username: username,
                    slug: currentHeroSlug,
                    type: 'playlist'
                  })
                });
                if (res.ok) {
                  userPlaylist.push(currentHeroSlug);
                  if (window.showGlobalToast) window.showGlobalToast('Đã lưu phim vào Danh sách phát!', 'success');
                }
              }
            } catch(e) {
              console.error('Error updating watchlist:', e);
            }
          } else {
            if (isInPlaylist) {
              userPlaylist = userPlaylist.filter(slug => slug !== currentHeroSlug);
              if (window.showGlobalToast) window.showGlobalToast('Đã gỡ phim khỏi Danh sách phát!', 'success');
            } else {
              userPlaylist.push(currentHeroSlug);
              if (window.showGlobalToast) window.showGlobalToast('Đã lưu phim vào Danh sách phát!', 'success');
            }
            localStorage.setItem('tplaylist', JSON.stringify(userPlaylist));
          }
          updateHeroPlaylistBtn();
        });
      }

      // Initial load
      loadWatchlist();
      loadDbHistory();

      if (combinedMovies.length > 0 && heroBanner && heroContent && heroTitle && heroDesc && heroPlayLink && bg1 && bg2) {
        let apiRegistry = {};
        try {
          const registryStr = localStorage.getItem('txa_episodes_config');
          if (registryStr) apiRegistry = JSON.parse(registryStr);
        } catch(e) {}

        const pinnedList = combinedMovies.filter(m => {
          const isPinnedInLocal = m.pinned === true || m.pinned === 'true';
          const isPinnedInApi = apiRegistry[m.slug] && (apiRegistry[m.slug].pinned === true || apiRegistry[m.slug].pinned === 'true');
          return isPinnedInLocal || isPinnedInApi;
        });

        const heroMovies = pinnedList.length > 0 
          ? pinnedList
          : combinedMovies.slice(0, 5);

        let currentHeroIndex = 0;
        let activeBg = 1;
        let heroIntervalId = null;

        const heroSlideLeft = document.getElementById('hero-slide-left');
        const heroSlideRight = document.getElementById('hero-slide-right');
        const heroIndicators = document.getElementById('hero-indicators');

        const updateHero = (index) => {
          const movie = heroMovies[index];
          currentHeroSlug = movie.slug || 'bai-hoc-dang-doi';
          const imgUrl = movie.bannerUrl || movie.posterUrl || '';
          
          if (activeBg === 1) {
            bg2.style.backgroundImage = `url('${imgUrl}')`;
            bg2.style.opacity = '1';
            bg1.style.opacity = '0';
            activeBg = 2;
          } else {
            bg1.style.backgroundImage = `url('${imgUrl}')`;
            bg1.style.opacity = '1';
            bg2.style.opacity = '0';
            activeBg = 1;
          }

          heroContent.style.opacity = '0';
          heroContent.style.transform = 'translateY(10px)';

          if (heroSlideLeft) {
            if (index === 0) {
              heroSlideLeft.classList.add('opacity-0', 'pointer-events-none');
              heroSlideLeft.classList.remove('opacity-100');
            } else {
              heroSlideLeft.classList.remove('opacity-0', 'pointer-events-none');
              heroSlideLeft.classList.add('opacity-100');
            }
          }

          if (heroSlideRight) {
            if (index === heroMovies.length - 1) {
              heroSlideRight.classList.add('opacity-0', 'pointer-events-none');
              heroSlideRight.classList.remove('opacity-100');
            } else {
              heroSlideRight.classList.remove('opacity-0', 'pointer-events-none');
              heroSlideRight.classList.add('opacity-100');
            }
          }

          const buttons = heroIndicators?.querySelectorAll('.hero-indicator-btn');
          if (buttons) {
            buttons.forEach((btn, idx) => {
              if (idx === index) {
                btn.classList.add('border-primary', 'shadow-[0_0_15px_rgba(124,58,237,0.6)]', 'scale-105', 'brightness-110', 'opacity-100');
                btn.classList.remove('border-white/10', 'opacity-60');
                const overlay = btn.querySelector('.btn-overlay');
                if (overlay) overlay.classList.add('bg-black/0');
                if (overlay) overlay.classList.remove('bg-black/40');
              } else {
                btn.classList.remove('border-primary', 'shadow-[0_0_15px_rgba(124,58,237,0.6)]', 'scale-105', 'brightness-110', 'opacity-100');
                btn.classList.add('border-white/10', 'opacity-60');
                const overlay = btn.querySelector('.btn-overlay');
                if (overlay) overlay.classList.remove('bg-black/0');
                if (overlay) overlay.classList.add('bg-black/40');
              }
            });
          }

          setTimeout(() => {
            if (heroImdb) {
              const score = movie.imdbScore ? movie.imdbScore.toFixed(1) : '8.0';
              heroImdb.textContent = `${score} IMDb`;
            }
            if (heroYear) heroYear.textContent = movie.releaseYear || '2024';
            if (heroType) {
              const typeText = movie.type === 'movie' ? 'Phim Lẻ' : movie.type === 'hoathinh' ? 'Hoạt Hình' : 'Phim Bộ';
              heroType.textContent = typeText;
            }

            heroTitle.textContent = movie.title;
            heroDesc.textContent = movie.description || 'Không có mô tả cho phim này.';
            
            let watchUrl = `/xem/${movie.slug}`;
            const dbItem = dbHistory.find(h => h.slug === movie.slug);
            if (dbItem) {
              watchUrl = `/xem/${movie.slug}?ep=${dbItem.episodeSlug}&sv=${dbItem.serverIndex || 0}`;
            } else {
              try {
                const thistory = JSON.parse(localStorage.getItem('thistory') || '[]');
                const historyItem = thistory.find(h => h.slug === movie.slug);
                if (historyItem) {
                  watchUrl = `/xem/${movie.slug}?ep=${historyItem.episodeSlug}&sv=${historyItem.serverIndex || 0}`;
                }
              } catch(e) {}
            }
            heroPlayLink.href = watchUrl;

            const heroInfoLink = document.getElementById('hero-info-link');
            if (heroInfoLink) {
              heroInfoLink.href = `/phim/${movie.slug}`;
            }

            heroContent.style.opacity = '1';
            heroContent.style.transform = 'translateY(0)';

            updateHeroPlaylistBtn();
          }, 400);
        };

        const renderIndicators = () => {
          if (!heroIndicators) return;
          if (heroMovies.length <= 1) {
            heroIndicators.classList.add('hidden');
            return;
          }
          heroIndicators.innerHTML = heroMovies.map((movie, index) => {
            const imgUrl = movie.bannerUrl || movie.posterUrl || '';
            return `
              <button data-index="${index}" class="hero-indicator-btn relative w-24 h-14 rounded-xl overflow-hidden border-2 border-white/10 hover:border-white/40 transition-all duration-300 shadow-md hover:shadow-lg shrink-0 cursor-pointer transform hover:-translate-y-0.5" data-txatooltip="${movie.title}">
                <img src="${imgUrl}" class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
                <div class="btn-overlay absolute inset-0 bg-black/40 hover:bg-black/10 transition-colors duration-300"></div>
              </button>
            `;
          }).join('');

          const buttons = heroIndicators.querySelectorAll('.hero-indicator-btn');
          buttons.forEach(btn => {
            btn.addEventListener('click', () => {
              const targetIndex = parseInt(btn.getAttribute('data-index'));
              if (!isNaN(targetIndex)) {
                currentHeroIndex = targetIndex;
                updateHero(currentHeroIndex);
                resetHeroInterval();
              }
            });
          });
        };

        if (heroSlideLeft) {
          heroSlideLeft.addEventListener('click', () => {
            if (currentHeroIndex > 0) {
              currentHeroIndex--;
              updateHero(currentHeroIndex);
              resetHeroInterval();
            }
          });
        }

        if (heroSlideRight) {
          heroSlideRight.addEventListener('click', () => {
            if (currentHeroIndex < heroMovies.length - 1) {
              currentHeroIndex++;
              updateHero(currentHeroIndex);
              resetHeroInterval();
            }
          });
        }

        const startHeroInterval = () => {
          if (heroMovies.length > 1) {
            heroIntervalId = setInterval(() => {
              currentHeroIndex = (currentHeroIndex + 1) % heroMovies.length;
              updateHero(currentHeroIndex);
            }, 7000);
          }
        };

        const resetHeroInterval = () => {
          if (heroIntervalId) {
            clearInterval(heroIntervalId);
          }
          startHeroInterval();
        };

        renderIndicators();
        updateHero(currentHeroIndex);
        startHeroInterval();
      } else if (combinedMovies.length === 0 && heroTitle && heroDesc && heroPlayLink) {
        heroTitle.textContent = 'Chào Mừng Đến Với DongMePhim';
        heroDesc.textContent = 'Trải nghiệm điện ảnh đỉnh cao. Hãy tìm kiếm phim hoặc cào dữ liệu phim từ kho lưu trữ để bắt đầu thưởng thức phim ngay bây giờ!';
        heroPlayLink.style.display = 'none';
        if (heroPlaylistBtn) heroPlaylistBtn.style.display = 'none';
        if (heroImdb) heroImdb.style.display = 'none';
        if (heroYear) heroYear.style.display = 'none';
        if (heroType) heroType.style.display = 'none';
        if (bg1) {
          bg1.style.backgroundImage = "url('/logo-icon.gif')";
          bg1.style.backgroundSize = "contain";
          bg1.style.backgroundRepeat = "no-repeat";
          bg1.style.backgroundPosition = "center";
          bg1.style.opacity = '0.15';
        }
      }

    } catch (e) {
      console.error('Error during client-side hydration:', e);
    }
  });
</script>

