---
import MainLayout from '@layouts/MainLayout.astro';
import { Button } from '@components/ui/Button';
import Card from '@components/ui/Card.astro';
import TopicCard from '@components/ui/TopicCard.astro';
import { topics } from '@data/topics';
import { MovieService } from '@services/MovieService';
import Txaicon from '@components/ui/txaicon.astro';
import { getHomepageCategories } from '@data/categories';

const homepageMappings = await getHomepageCategories();

// Lấy tất cả các slugs được gán thủ công trên trang chủ
const animeSlugs = homepageMappings['top-anime-he'] || [];
const top10Slugs = homepageMappings['top-10-phim-le'] || [];
const top10PhimBoSlugs = homepageMappings['top-10-phim-bo'] || [];

const assignedSlugs = [
  ...animeSlugs,
  ...top10Slugs,
  ...top10PhimBoSlugs
];

// Lấy phim theo các slugs được gán và 300 phim mới nhất để làm fallback/sidebar
const [assignedMovies, latestMovies] = await Promise.all([
  assignedSlugs.length > 0 ? MovieService.getMovies({ slugs: assignedSlugs }) : Promise.resolve([]),
  MovieService.getMovies({ limit: 300, sortBy: 'updatedAt' })
]);

// Gộp và loại bỏ trùng lặp
const movieMap = new Map();
latestMovies.forEach((m: any) => movieMap.set(m.slug, m));
assignedMovies.forEach((m: any) => movieMap.set(m.slug, m));
const allMoviesForServer = Array.from(movieMap.values());

// Top Anime
const animeMovies = allMoviesForServer.filter((m: any) => animeSlugs.includes(m.slug));
const fallbackAnime = allMoviesForServer.filter((m: any) => m.type === 'hoathinh' || (m.genres && m.genres.some((g: string) => g.toLowerCase().includes('hoạt hình')))).slice(0, 6);
const animeMoviesSorted = [...animeMovies].sort((a, b) => animeSlugs.indexOf(a.slug) - animeSlugs.indexOf(b.slug));
const topAnimeList = animeMovies.length > 0 ? animeMoviesSorted : fallbackAnime;

// Top 10 Phim Lẻ
const top10MoviesManual = allMoviesForServer.filter((m: any) => top10Slugs.includes(m.slug));
const fallbackTop10Le = [...allMoviesForServer]
  .filter((m: any) => m.type === 'movie')
  .sort((a: any, b: any) => {
    const scoreA = (a.views || 0) + (a.imdbScore || 0) * 10;
    const scoreB = (b.views || 0) + (b.imdbScore || 0) * 10;
    return scoreB - scoreA;
  })
  .slice(0, 10);
const top10MoviesManualSorted = [...top10MoviesManual].sort((a, b) => top10Slugs.indexOf(a.slug) - top10Slugs.indexOf(b.slug));
const top10PhimLeList = top10MoviesManual.length > 0 ? top10MoviesManualSorted : fallbackTop10Le;

// Filter Top Series for Rank slider (server-side)
const topSeries = allMoviesForServer
  .filter((m: any) => m.type === 'series')
  .sort((a: any, b: any) => ((b.views || 0) + (b.commentCount || 0)) - ((a.views || 0) + (a.commentCount || 0)))
  .slice(0, 10);

// Top 10 Phim Bộ
const topBoMoviesManual = allMoviesForServer.filter((m: any) => top10PhimBoSlugs.includes(m.slug));
const fallbackTop10Bo = [...allMoviesForServer]
  .filter((m: any) => m.type === 'series')
  .sort((a: any, b: any) => {
    const scoreA = (a.views || 0) + (a.imdbScore || 0) * 10;
    const scoreB = (b.views || 0) + (b.imdbScore || 0) * 10;
    return scoreB - scoreA;
  })
  .slice(0, 10);
const topBoMoviesManualSorted = [...topBoMoviesManual].sort((a, b) => top10PhimBoSlugs.indexOf(a.slug) - top10PhimBoSlugs.indexOf(b.slug));
const top10PhimBoList = topBoMoviesManual.length > 0 ? topBoMoviesManualSorted : fallbackTop10Bo;

// Phim điện ảnh mới coóng - Tự động phân loại (Lọc phim lẻ, ưu tiên chiếu rạp, sắp xếp mới nhất)
const phimDienAnhList = [...allMoviesForServer]
  .filter((m: any) => m.type === 'movie')
  .sort((a: any, b: any) => {
    const aIsChieuRap = a.genres && a.genres.some((g: string) => g.toLowerCase().includes('chiếu rạp'));
    const bIsChieuRap = b.genres && b.genres.some((g: string) => g.toLowerCase().includes('chiếu rạp'));
    if (aIsChieuRap && !bIsChieuRap) return -1;
    if (!aIsChieuRap && bIsChieuRap) return 1;
    
    const yearDiff = (b.releaseYear || 0) - (a.releaseYear || 0);
    if (yearDiff !== 0) return yearDiff;
    
    return new Date(b.updatedAt || 0).getTime() - new Date(a.updatedAt || 0).getTime();
  })
  .slice(0, 18);

// Filter lists for Sidebar ranking (server-side)
const soiNoiMovies = [...allMoviesForServer]
  .sort((a: any, b: any) => (b.views || 0) - (a.views || 0))
  .slice(0, 5);

const yeuThichMovies = [...allMoviesForServer]
  .sort((a: any, b: any) => (b.imdbScore || 0) - (a.imdbScore || 0))
  .slice(0, 5);

// Get pinned or fallback latest movies for hero banner
const pinnedMovies = allMoviesForServer.filter((m: any) => m.pinned === true || m.pinned === 'true');
const heroMovies = pinnedMovies.length > 0 ? pinnedMovies : allMoviesForServer.slice(0, 5);
const firstHero = heroMovies[0] || null;

const getMovieProgressBadgesSSR = (movie: any) => {
  if (!movie) return '';

  const isSeries = movie.type === 'series' || movie.type === 'hoathinh' || movie.type === 'tvshows';
  if (isSeries && movie.status === 'completed') {
    return `
      <span class="bg-emerald-950/90 text-emerald-400 border border-emerald-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase tracking-wide">
        Hoàn tất
      </span>
    `;
  }

  const episodes = movie.episodes || [];

  if (isSeries) {
    let pdEpisodes = 0;
    let tmEpisodes = 0;

    episodes.forEach((server: any) => {
      const name = (server.serverName || '').toLowerCase();
      const epCount = Array.isArray(server.serverData) ? server.serverData.length : 0;
      const isTm = name.includes('thuyết minh') || name.includes('thuyetminh') || name.includes('t.minh') || name.includes('tm') || name.includes('lồng tiếng') || name.includes('longtieng') || name.includes('l.tiếng') || name.includes('lt');
      if (isTm) {
        tmEpisodes = Math.max(tmEpisodes, epCount);
      } else {
        pdEpisodes = Math.max(pdEpisodes, epCount);
      }
    });

    if (pdEpisodes === 0 && tmEpisodes === 0) {
      const cur = (movie.episodeCurrent || '').trim().replace(/^[tT]ập\s+/, '');
      const curNum = parseInt(cur);
      if (!isNaN(curNum)) {
        const langLower = (movie.lang || '').toLowerCase();
        if (langLower.includes('thuyết minh') || langLower.includes('lồng tiếng')) {
          tmEpisodes = curNum;
        } else {
          pdEpisodes = curNum;
        }
      }
    }

    let html = '';
    if (pdEpisodes > 0) {
      html += `
        <span class="bg-sky-950/90 text-sky-400 border border-sky-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          PĐ ${pdEpisodes}
        </span>
      `;
    }
    if (tmEpisodes > 0) {
      html += `
        <span class="bg-purple-950/90 text-purple-400 border border-purple-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          TM ${tmEpisodes}
        </span>
      `;
    }
    if (pdEpisodes === 0 && tmEpisodes === 0) {
      html += `
        <span class="bg-zinc-950/90 text-zinc-400 border border-zinc-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          Đang chiếu
        </span>
      `;
    }
    return html;
  } else {
    let hasPd = false;
    let hasTm = false;

    episodes.forEach((server: any) => {
      const name = (server.serverName || '').toLowerCase();
      const isTm = name.includes('thuyết minh') || name.includes('thuyetminh') || name.includes('t.minh') || name.includes('tm') || name.includes('lồng tiếng') || name.includes('longtieng') || name.includes('l.tiếng') || name.includes('lt');
      if (isTm) {
        hasTm = true;
      } else {
        hasPd = true;
      }
    });

    if (!hasPd && !hasTm) {
      const langLower = (movie.lang || '').toLowerCase();
      if (langLower.includes('thuyết minh') && (langLower.includes('vietsub') || langLower.includes('phụ đề'))) {
        hasPd = true;
        hasTm = true;
      } else if (langLower.includes('thuyết minh') || langLower.includes('lồng tiếng')) {
        hasTm = true;
      } else {
        hasPd = true;
      }
    }

    let html = '';
    if (hasPd) {
      html += `
        <span class="bg-sky-950/90 text-sky-400 border border-sky-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          Vietsub
        </span>
      `;
    }
    if (hasTm) {
      html += `
        <span class="bg-purple-950/90 text-purple-400 border border-purple-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          TM
        </span>
      `;
    }
    return html;
  }
};
---

<MainLayout isHome={true}>
  <!-- Hero Banner -->
  <section id="hero-banner" class="relative h-[55vh] md:h-[85vh] w-full overflow-hidden">
    <!-- Image layers for cross-fade transition -->
    <div id="hero-bg-1" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-100" style={`background-image: url('${firstHero ? (firstHero.bannerUrl || firstHero.posterUrl) : "/logo-icon.gif"}')`}></div>
    <div id="hero-bg-2" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0B] via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0B] via-[#0A0A0B]/50 to-transparent hidden md:block"></div>
    
    <!-- Left & Right Arrow controls (Desktop only) -->
    <button id="hero-slide-left" class="absolute left-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full border border-white/10 bg-black/40 backdrop-blur-md text-white flex items-center justify-center hover:bg-primary/20 hover:border-primary transition-all duration-300 opacity-0 pointer-events-none hidden md:flex cursor-pointer shadow-lg" data-txatooltip="Phim trước">
      <span class="material-symbols-outlined text-2xl font-bold">chevron_left</span>
    </button>
    <button id="hero-slide-right" class="absolute right-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full border border-white/10 bg-black/40 backdrop-blur-md text-white flex items-center justify-center hover:bg-primary/20 hover:border-primary transition-all duration-300 opacity-0 pointer-events-none hidden md:flex cursor-pointer shadow-lg" data-txatooltip="Phim tiếp theo">
      <span class="material-symbols-outlined text-2xl font-bold">chevron_right</span>
    </button>

    <div class="relative h-full flex items-center max-w-container-max mx-auto px-gutter pt-20">
      <div id="hero-content" class="max-w-2xl space-y-6 transition-all duration-500 transform translate-y-0 opacity-100">
        <div class="flex items-center gap-3">
          <span id="hero-imdb" class="bg-primary/20 text-primary font-label-caps text-label-caps px-2 py-1 rounded shadow-sm backdrop-blur-md">{firstHero?.imdbScore ? `${firstHero.imdbScore.toFixed(1)} IMDb` : '8.0 IMDb'}</span>
          <span id="hero-year" class="bg-white/10 text-white font-label-caps text-label-caps px-2 py-1 rounded shadow-sm backdrop-blur-md">{firstHero?.releaseYear || '2024'}</span>
          <span id="hero-type" class="bg-white/10 text-white font-label-caps text-label-caps px-2 py-1 rounded shadow-sm backdrop-blur-md">{firstHero?.type === 'movie' ? 'Phim Lẻ' : firstHero?.type === 'hoathinh' ? 'Hoạt Hình' : 'Phim Bộ'}</span>
        </div>
        <h1 id="hero-title" class="font-display-hero text-display-hero md:text-[64px] font-extrabold leading-tight text-white drop-shadow-lg line-clamp-2">
            {firstHero?.title || 'Chào Mừng Đến Với DongMePhim'}
        </h1>
        <p id="hero-desc" class="text-on-surface-variant text-lg md:text-xl line-clamp-3 leading-relaxed">
            {firstHero?.description || 'Trải nghiệm điện ảnh đỉnh cao tại DongMePhim.'}
        </p>
        <div class="flex items-center gap-4 pt-4">
          <!-- Play Button (Circle) -->
          <a id="hero-play-link" href={firstHero ? `/xem/${firstHero.slug}` : "#"} class="w-14 h-14 rounded-full bg-primary hover:bg-primary/95 text-slate-950 flex items-center justify-center shadow-lg transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer shrink-0" style={firstHero ? "" : "display: none;"} data-txatooltip="Xem Phim">
            <span class="material-symbols-outlined text-3xl ml-0.5" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
          </a>

          <!-- Capsule container for Playlist and Info buttons -->
          <div class="flex items-center rounded-full bg-[#141416]/60 border border-glass-stroke backdrop-blur-md overflow-hidden h-12 shadow-lg" style={firstHero ? "" : "display: none;"}>
            <!-- Playlist Button -->
            <button id="hero-playlist-btn" class="relative w-12 h-full flex items-center justify-center text-zinc-400 hover:text-white hover:bg-white/5 transition-colors cursor-pointer border-r border-glass-stroke/50" data-txatooltip="Thêm vào DS phát">
              <span id="hero-playlist-icon-add" class="flex items-center justify-center">
                <Txaicon name="playlist-add" class="w-5 h-5" />
              </span>
              <span id="hero-playlist-icon-added" class="flex items-center justify-center hidden">
                <Txaicon name="playlist-added" class="w-5 h-5" />
              </span>
            </button>
            
            <!-- Info/Details Button -->
            <a id="hero-info-link" href={firstHero ? `/phim/${firstHero.slug}` : "#"} class="relative w-12 h-full flex items-center justify-center text-zinc-400 hover:text-white hover:bg-white/5 transition-colors cursor-pointer" data-txatooltip="Chi tiết phim">
              <span class="material-symbols-outlined text-xl">info</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Carousel Indicators (Desktop Only) -->
    <div id="hero-indicators" class="absolute bottom-8 right-8 z-30 flex items-center gap-3 hidden md:flex"></div>
  </section>

  <!-- Content Categories -> Topics Grid -->
  <section class="px-gutter -mt-16 relative z-10 max-w-container-max mx-auto space-y-4">
    <h3 class="font-headline-lg text-lg text-white font-bold tracking-tight px-1 drop-shadow-md">Bạn đang quan tâm gì?</h3>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {topics.slice(0, 5).map((topic) => (
        <TopicCard
          name={topic.name}
          slug={topic.slug}
          gradient={topic.gradient}
          icon={topic.icon}
          labelText="Khám phá ngay"
          description={topic.description}
        />
      ))}
      <TopicCard
        name={`+${topics.length - 5} chủ đề`}
        slug="/chu-de"
        gradient="from-zinc-800 via-zinc-900 to-zinc-950"
        icon="apps"
        labelText="Xem tất cả"
        description="Khám phá tất cả danh mục phim thú vị khác."
      />
    </div>
  </section>

  <main class="max-w-container-max mx-auto px-gutter py-section-gap space-y-section-gap">
    <!-- Swiper CDN assets -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- Top Anime đáng xem mùa hè này (Image 1 Style) -->
    {topAnimeList.length > 0 && (
      <section class="space-y-6">
        <div class="flex items-center justify-between mb-2">
          <div>
            <h2 class="font-display-hero text-2xl md:text-3xl font-extrabold text-white tracking-tight flex items-center gap-2 font-outfit">
              Top Anime Đáng Xem Mùa Hè Này
              <span class="material-symbols-outlined text-transparent bg-clip-text bg-gradient-to-tr from-primary to-secondary" style="font-variation-settings: 'FILL' 1;">star</span>
            </h2>
            <p class="text-on-surface-variant font-body-main mt-1 text-sm">Những tác phẩm anime siêu đỉnh không thể bỏ qua</p>
          </div>
          <a class="group/more inline-flex items-center justify-center w-6 h-6 rounded-full bg-zinc-950/40 border border-zinc-800 hover:border-amber-500/50 hover:w-auto hover:px-3.5 hover:py-1 hover:gap-1.5 text-amber-400 hover:text-amber-300 hover:bg-amber-500/10 transition-all duration-300 shadow-md hover:shadow-[0_0_12px_rgba(245,158,11,0.35)] font-outfit" href="/c/top-anime-he">
            <span class="max-w-0 overflow-hidden group-hover/more:max-w-[120px] transition-all duration-300 ease-out whitespace-nowrap">Xem tất cả</span>
            <span class="material-symbols-outlined text-[12px] font-bold">chevron_right</span>
          </a>
        </div>

        <!-- Synced Swiper Container -->
        <div class="relative group/anime-nav">
          <!-- Navigation Buttons -->
          <button id="anime-prev-btn" class="absolute left-4 top-[40%] -translate-y-1/2 z-30 w-10 h-10 rounded-full border border-white/10 bg-black/60 backdrop-blur-md text-white flex items-center justify-center hover:bg-amber-500/20 hover:border-amber-500 transition-all duration-300 cursor-pointer shadow-lg opacity-0 group-hover/anime-nav:opacity-100">
            <span class="material-symbols-outlined text-xl font-bold">chevron_left</span>
          </button>
          <button id="anime-next-btn" class="absolute right-4 top-[40%] -translate-y-1/2 z-30 w-10 h-10 rounded-full border border-white/10 bg-black/60 backdrop-blur-md text-white flex items-center justify-center hover:bg-amber-500/20 hover:border-amber-500 transition-all duration-300 cursor-pointer shadow-lg opacity-0 group-hover/anime-nav:opacity-100">
            <span class="material-symbols-outlined text-xl font-bold">chevron_right</span>
          </button>

          <!-- Main Swiper -->
          <div class="swiper anime-main-swiper">
            <div class="swiper-wrapper">
              {topAnimeList.map((movie: any) => (
                <div class="swiper-slide relative bg-[#0a0b10]">
                  <img src={movie.bannerUrl || movie.posterUrl} alt={movie.title} class="anime-slide-img" onerror="this.src='/favicon.png'" />
                  <div class="absolute inset-0 bg-gradient-to-r from-[#0a0b10] via-[#0a0b10]/60 to-transparent"></div>
                  <div class="anime-slide-content">
                    <div class="max-w-md md:max-w-lg space-y-4 text-left">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="bg-primary/20 text-primary font-bold text-[10px] px-2 py-0.5 rounded border border-primary/20">{movie.quality}</span>
                        <span class="bg-white/10 text-white text-[10px] px-2 py-0.5 rounded border border-white/10">{movie.releaseYear}</span>
                        <span class="bg-secondary/15 text-secondary text-[10px] font-bold px-2 py-0.5 rounded border border-secondary/20">{movie.lang}</span>
                      </div>
                      <h3 class="text-2xl md:text-4xl font-extrabold text-white leading-tight font-outfit line-clamp-2">{movie.title}</h3>
                      <p class="text-xs md:text-sm text-zinc-400 font-sans leading-relaxed line-clamp-3 md:line-clamp-4">{movie.description?.replace(/<[^>]*>/g, '')}</p>
                      <div class="pt-2 flex gap-3">
                        <a href={`/phim/${movie.slug}`} class="px-6 py-2.5 bg-gradient-to-br from-primary-container to-secondary-container hover:brightness-110 text-white rounded-xl text-xs font-bold transition-all shadow-[0_4px_15px_rgba(124,58,237,0.3)] inline-flex items-center gap-1.5 active:scale-95 no-underline">
                          <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                          Xem ngay
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Thumbnails Swiper (Desktop) / Pagination dots (Mobile) -->
          <div class="swiper anime-thumbs-swiper">
            <div class="swiper-wrapper">
              {topAnimeList.map((movie: any) => (
                <div class="swiper-slide w-[150px]">
                  <div class="v-thumbnail aspect-video overflow-hidden">
                    <img src={movie.bannerUrl || movie.posterUrl} alt={movie.title} class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
                  </div>
                  <p class="thumb-title text-[10px] text-zinc-400 font-bold truncate mt-1 text-center font-outfit">{movie.title}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Top 10 Phim Lẻ Hay Nhức Nách (Image 2 style with skewed cards) -->
    <section class="space-y-6 fade-in-section opacity-0 invisible transition-all duration-700 min-h-[150px]">
      <div class="flex items-center justify-between mb-2">
        <div>
          <h2 class="font-display-hero text-2xl md:text-3xl font-extrabold text-white tracking-tight flex items-center gap-2 font-outfit">
            Top 10 Phim Lẻ Hay Nhức Nách
            <span class="material-symbols-outlined text-amber-400" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
          </h2>
          <p class="text-on-surface-variant font-body-main mt-1 text-sm">Bảng xếp hạng phim lẻ ăn khách nhất hệ thống</p>
        </div>
        <a class="group/more inline-flex items-center justify-center w-6 h-6 rounded-full bg-zinc-950/40 border border-zinc-800 hover:border-amber-500/50 hover:w-auto hover:px-3.5 hover:py-1 hover:gap-1.5 text-amber-400 hover:text-amber-300 hover:bg-amber-500/10 transition-all duration-300 shadow-md hover:shadow-[0_0_12px_rgba(245,158,11,0.35)] font-outfit" href="/c/top-10-phim-le">
          <span class="max-w-0 overflow-hidden group-hover/more:max-w-[120px] transition-all duration-300 ease-out whitespace-nowrap">Xem thêm</span>
          <span class="material-symbols-outlined text-[12px] font-bold">chevron_right</span>
        </a>
      </div>

      <!-- Swiper Slider for Skewed Cards -->
      <div class="swiper top10-swiper">
        <div class="swiper-wrapper">
          {top10PhimLeList.map((movie: any, index: number) => (
            <div class="swiper-slide">
              <div class="top10-item group">
                <a class="top10-thumbnail block" href={`/phim/${movie.slug}`}>
                  <div class="absolute inset-0 bg-black/10 group-hover:bg-primary/10 transition-colors z-10 rounded-2xl"></div>
