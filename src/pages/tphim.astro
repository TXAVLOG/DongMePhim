<script define:vars={{ heroMoviesForClient: heroMovies }}>
  window.heroMoviesForClient = heroMoviesForClient;

  // Helper function to create movie list items with Netflix-style popover cards
  function createMovieListItemHTML(movieData, index, type) {
    const trendColor = index < 3 ? 'emerald' : 'zinc';
    const trendIcon = index === 0 ? 'trending_up' : index === 2 ? 'trending_up' : index === 3 ? 'trending_down' : 'remove';
    
    const originalTitle = movieData.originalTitle || '';
    const imdbScore = movieData.imdbScore ? Number(movieData.imdbScore).toFixed(1) : '8.0';
    const ageRating = movieData.ageRating || 'T13';
    const releaseYear = movieData.releaseYear || 2024;
    const seasons = movieData.seasons || 'Phần 1';
    const quality = movieData.quality || 'FHD';
    const lang = movieData.lang || 'Vietsub';
    const genres = movieData.genres || [];
    
    const genresHTML = genres.map(g => `<span>${g}</span>`).join('<span class="text-zinc-600">•</span>');
    
    return `
      <a href="/phim/${movieData.slug}" class="relative group flex items-center gap-3.5 p-2 rounded-xl hover:bg-white/5 transition-all cursor-pointer w-full">
        <span class="text-sm font-black text-zinc-600 group-hover:text-primary transition-colors w-4 font-outfit">${index + 1}.</span>
        <span class="material-symbols-outlined text-${trendColor}-400 text-sm font-bold w-4">${trendIcon}</span>
        <div class="w-8 h-10 rounded overflow-hidden border border-glass-stroke bg-zinc-900 shrink-0 shadow-md">
          <img src="${movieData.posterUrl || '/favicon.png'}" class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
        </div>
        <span class="text-xs font-bold text-zinc-300 group-hover:text-white transition-colors line-clamp-1 flex-1 font-outfit">${movieData.title}</span>
        
        <!-- Netflix-style Popover Card (visible on hover) -->
        <div class="pointer-events-none absolute left-1/2 top-1/2 z-50 w-[300px] -translate-x-1/2 -translate-y-1/2 scale-75 rounded-2xl border border-glass-stroke bg-[#141416]/95 backdrop-blur-md opacity-0 shadow-[0_0_40px_rgba(109,40,217,0.3),_0_20px_50px_rgba(0,0,0,0.85)] transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:pointer-events-auto group-hover:scale-100 group-hover:opacity-100 group-hover:visible group-hover:delay-[600ms] hidden lg:block overflow-hidden">
          <div class="relative w-full aspect-video bg-black/40">
            <img src="${movieData.bannerUrl || movieData.posterUrl || '/favicon.png'}" alt="${movieData.title}" class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#141416] via-[#141416]/20 to-transparent"></div>
            <div class="absolute top-3 left-3 flex gap-1">
              <span class="bg-primary text-on-primary text-[9px] px-1.5 py-0.5 rounded font-bold shadow-sm">${quality}</span>
              <span class="bg-white/10 text-white text-[9px] px-1.5 py-0.5 rounded shadow-sm backdrop-blur-md">${lang}</span>
            </div>
          </div>
          <div class="p-4 space-y-3.5 text-left whitespace-normal">
            <div>
              <h4 class="font-bold text-white text-base leading-tight font-outfit line-clamp-1">${movieData.title}</h4>
              ${originalTitle ? `<p class="text-primary text-[11px] font-semibold mt-0.5 font-outfit line-clamp-1">${originalTitle}</p>` : ''}
            </div>
            <div class="flex items-center gap-2">
              <span class="flex-1 flex items-center justify-center gap-1.5 py-2 px-3 bg-primary hover:bg-primary/90 text-on-primary rounded-xl text-xs font-bold transition-all shadow-[0_4px_12px_rgba(124,58,237,0.25)] cursor-pointer">
                <span class="material-symbols-outlined text-sm font-bold" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
