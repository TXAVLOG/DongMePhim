                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/95 text-on-primary backdrop-blur-md transform scale-50 transition-transform duration-300 group-hover:scale-100 shadow-xl shadow-primary/20">
                  <span class="material-symbols-outlined ml-0.5 text-xl" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                </div>
              </div>
              
              <div class="absolute bottom-2 left-1/2 -translate-x-1/2 z-20">
                <span class="bg-[#141416]/80 text-zinc-300 text-[8px] font-bold px-2.5 py-0.5 rounded border border-white/10 shadow-sm backdrop-blur-sm whitespace-nowrap">
                  ${getLangBadge(lang)}
                </span>
              </div>
            </a>

            <div class="mt-2.5 px-1 space-y-0.5 text-center">
              <h3 class="font-bold text-xs text-white line-clamp-1 group-hover:text-primary transition-colors font-outfit" title="${title}">
                ${title}
              </h3>
              <p class="text-[9px] text-zinc-500 truncate font-medium font-outfit" title="${originalTitle}">
                ${originalTitle || title}
              </p>
            </div>

            <!-- Hover Popover details card (Netflix style, desktop only) -->
            <div class="pointer-events-none absolute left-1/2 top-1/2 z-50 w-[300px] -translate-x-1/2 -translate-y-1/2 scale-75 rounded-2xl border border-glass-stroke bg-[#141416]/95 backdrop-blur-md opacity-0 shadow-[0_0_40px_rgba(109,40,217,0.3),_0_20px_50px_rgba(0,0,0,0.85)] transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:pointer-events-auto group-hover:scale-100 group-hover:opacity-100 group-hover:visible group-hover:delay-[600ms] hidden lg:block overflow-hidden">
              <div class="relative w-full aspect-video bg-black/40">
                <img src="${movie.bannerUrl || poster}" alt="${title}" class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#141416] via-[#141416]/20 to-transparent"></div>
                <div class="absolute top-3 left-3 flex gap-1">
                  <span class="bg-primary text-on-primary text-[9px] px-1.5 py-0.5 rounded font-bold shadow-sm">${quality}</span>
                  <span class="bg-white/10 text-white text-[9px] px-1.5 py-0.5 rounded shadow-sm backdrop-blur-md">${lang}</span>
                </div>
              </div>
              <div class="p-4 space-y-3.5 text-left whitespace-normal">
                <div>
                  <h4 class="font-bold text-white text-base leading-tight font-outfit line-clamp-1">${title}</h4>
                  ${originalTitle ? `<p class="text-primary text-[11px] font-semibold mt-0.5 font-outfit line-clamp-1">${originalTitle}</p>` : ''}
                </div>
                <div class="flex items-center gap-2">
                  <a href="/xem/${slug}?ep=tap-1" class="flex-1 flex items-center justify-center gap-1.5 py-2 px-3 bg-primary hover:bg-primary/90 text-on-primary rounded-xl text-xs font-bold transition-all shadow-[0_4px_12px_rgba(124,58,237,0.2)] cursor-pointer">
                    <span class="material-symbols-outlined text-sm font-bold" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                    Xem ngay
                  </a>
                  <button class="w-8 h-8 rounded-xl border border-glass-stroke flex items-center justify-center text-white hover:bg-white/5 transition-all cursor-pointer" title="Thích">
                    <span class="material-symbols-outlined text-sm">favorite</span>
                  </button>
                  <a href="/phim/${slug}" class="w-8 h-8 rounded-xl border border-glass-stroke flex items-center justify-center text-white hover:bg-white/5 transition-all cursor-pointer" title="Chi tiết">
                    <span class="material-symbols-outlined text-sm">info</span>
                  </a>
                </div>
                <div class="flex flex-wrap items-center gap-2 text-[10px] text-zinc-300 font-semibold font-outfit pt-1">
                  <span class="border border-primary text-primary px-1.5 py-0.5 rounded text-[9px] font-bold">IMDb ${(movie.imdbScore || 8.0).toFixed(1)}</span>
                  <span>${year || 2024}</span>
                  <span>${status}</span>
                </div>
                ${genresHTML ? `<div class="text-[10px] text-zinc-400 font-medium border-t border-glass-stroke pt-2 flex flex-wrap gap-x-1.5 gap-y-0.5">${genresHTML}</div>` : ''}
              </div>
            </div>
          </div>
        `;
      }

      // Bind all initialization to 'astro:page-load' for view transition compatibility
      document.addEventListener('astro:page-load', async () => {
        // Comments carousel sliding
        const carousel = document.getElementById('comments-carousel');
        const slideLeft = document.getElementById('slide-left');
        const slideRight = document.getElementById('slide-right');
        
        slideLeft?.addEventListener('click', () => {
          carousel?.scrollBy({ left: -296, behavior: 'smooth' });
        });
        
        slideRight?.addEventListener('click', () => {
          carousel?.scrollBy({ left: 296, behavior: 'smooth' });
        });

        // Hydration logic
        try {
          const combinedMovies = (allMoviesForClient || []).filter(m => m.slug && m.slug !== 'undefined' && m.slug !== 'null');
          const hasMovies = combinedMovies.length > 0;

          // 1. Update existing card images/banners (fallback sync)
          if (hasMovies) {
            combinedMovies.forEach(movieData => {
              const slug = movieData.slug;
              if (!slug) return;

              const links = document.querySelectorAll(`a[href*="/phim/${slug}"], a[href*="/xem/${slug}"]`);
              links.forEach(link => {
                const img = link.querySelector('img');
                if (img) img.src = movieData.posterUrl;
                
                const parentCard = link.closest('.group.relative.w-full') || link.closest('a');
                if (parentCard) {
                  const cardImg = parentCard.querySelector('img');
                  if (cardImg && cardImg !== img) cardImg.src = movieData.posterUrl;
                  const popoverBanner = parentCard.querySelector('.pointer-events-none img');
                  if (popoverBanner) popoverBanner.src = movieData.bannerUrl || movieData.posterUrl;
                  const popoverTitle = parentCard.querySelector('.pointer-events-none h4');
                  if (popoverTitle) popoverTitle.textContent = movieData.title;
                }
              });
            });
          }

          // 2. Render Sôi nổi nhất list
          const soiNoiContainer = document.getElementById('soi-noi-list');
          if (soiNoiContainer) {
            const sortedByViews = [...combinedMovies].sort((a, b) => (b.views || 0) - (a.views || 0));
            const top5Views = sortedByViews.slice(0, 5);
            let html = '';
            top5Views.forEach((movieData, index) => {
              html += createMovieListItemHTML(movieData, index, 'soi-noi');
            });
            soiNoiContainer.innerHTML = html;
          }

          // 3. Render Yêu thích nhất list
          const yeuThichContainer = document.getElementById('yeu-thich-list');
          if (yeuThichContainer) {
            const sortedByImdb = [...combinedMovies].sort((a, b) => (b.imdbScore || 0) - (a.imdbScore || 0));
            const top5Imdb = sortedByImdb.slice(0, 5);
            let html = '';
            top5Imdb.forEach((movieData, index) => {
              html += createMovieListItemHTML(movieData, index, 'yeu-thich');
            });
            yeuThichContainer.innerHTML = html;
          }

          // 4. Render Phim Hàn Quốc Mới
          const koreanGrid = document.getElementById('korean-grid');
          if (koreanGrid) {
            const koreanList = combinedMovies.filter(m => m.category === 'Hàn Quốc' || (Array.isArray(m.genres) && m.genres.includes('Hàn Quốc')));
            if (koreanList.length > 0) {
              let html = '';
              koreanList.slice(0, 4).forEach(m => {
                html += createMovieCardHTML(m, "aspect-[2/3]");
              });
              koreanGrid.innerHTML = html;
            }
          }

          // 5. Render Phim Trung Quốc Mới
          const chineseGrid = document.getElementById('chinese-grid');
          if (chineseGrid) {
            const chineseList = combinedMovies.filter(m => m.category === 'Trung Quốc' || (Array.isArray(m.genres) && m.genres.includes('Trung Quốc')));
            if (chineseList.length > 0) {
