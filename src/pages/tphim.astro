                <div class="w-9 h-9 rounded-full bg-${badgeColor} flex items-center justify-center text-white font-bold text-xs">
                  ${initial}
                </div>
                <div>
                  <div class="flex items-center gap-1">
                    ${adminTag}
                    <span class="text-xs font-bold text-white">${comment.author}</span>
                  </div>
                  <span class="text-[9px] text-zinc-500">${roleBadge}</span>
                </div>
              </div>
              <a href="/phim/${comment.movieSlug}" class="w-10 h-14 rounded-lg overflow-hidden border border-glass-stroke shrink-0 block hover:scale-105 transition-transform bg-zinc-900">
                <img src="${comment.moviePoster || '/favicon.png'}" class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
              </a>
            </div>
            <p class="text-xs text-zinc-300 italic line-clamp-3 mt-3 font-body-main">"${comment.content}"</p>
            <div class="flex items-center gap-3 mt-4 pt-3 border-t border-glass-stroke/30 text-[10px] text-zinc-500">
              <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[12px]">visibility</span> ${views}</span>
              <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[12px]">thumb_up</span> ${comment.likes || 0}</span>
              <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[12px]">forum</span> ${comment.replies ? comment.replies.length : 0}</span>
            </div>
          </div>
        `;
      }

      // Helper function to create sidebar comment rows
      function createSidebarCommentRowHTML(comment) {
        const initial = (comment.author || 'T').substring(0, 1).toUpperCase();
        
        let roleBadge = '';
        let badgeColor = 'zinc-700';
        
        const lowerAuthor = (comment.author || '').toLowerCase();
        if (lowerAuthor.includes('cô 3 rổ') || lowerAuthor.includes('admin') || lowerAuthor.includes('hoài lê') || lowerAuthor.includes('mod') || lowerAuthor.includes('ad')) {
          roleBadge = `<span class="text-[10px] text-primary" title="ADMIN">👑</span>`;
          badgeColor = 'pink-500';
        } else if (lowerAuthor.includes('nam') || lowerAuthor.includes('thư') || lowerAuthor.includes('linh') || lowerAuthor.includes('tiểu')) {
          badgeColor = 'amber-500';
        } else if (lowerAuthor.charCodeAt(0) % 2 === 0) {
          badgeColor = 'indigo-500';
        } else {
          badgeColor = 'teal-500';
        }

        return `
          <div class="p-3 bg-zinc-950/30 border border-glass-stroke/40 rounded-xl space-y-1 hover:border-primary/20 hover:bg-zinc-950/60 transition-all duration-300">
            <div class="flex items-center gap-2">
              <div class="w-5 h-5 rounded-full bg-${badgeColor} text-white font-bold text-[9px] flex items-center justify-center font-outfit">${initial}</div>
              <span class="text-xs font-bold text-zinc-300">${comment.author}</span>
              ${roleBadge}
            </div>
            <p class="text-xs text-zinc-400 italic line-clamp-1 font-body-main">"${comment.content}"</p>
            <a href="/phim/${comment.movieSlug}" class="text-[9px] text-primary hover:underline flex items-center gap-1 pt-0.5 font-outfit">
              <span class="material-symbols-outlined text-[10px]">play_circle</span> ${comment.movieTitle}
            </a>
          </div>
        `;
