---
import MainLayout from '../layouts/MainLayout.astro';
import { Button } from '../components/ui/Button';
import Card from '../components/ui/Card.astro';
import TopicCard from '../components/ui/TopicCard.astro';
import { topics } from '../data/topics';
import { MovieService } from '../services/MovieService';
import Txaicon from '../components/ui/txaicon.astro';

// Single database query for optimal SSR performance
const allMoviesForServer = await MovieService.getMovies();

// Get pinned or fallback latest movies for hero banner
const pinnedMovies = allMoviesForServer.filter((m: any) => m.pinned === true || m.pinned === 'true');
const heroMovies = pinnedMovies.length > 0 ? pinnedMovies : allMoviesForServer.slice(0, 5);
const firstHero = heroMovies[0] || null;

// Filter Top Series for Rank slider (server-side)
const topSeries = allMoviesForServer
  .filter((m: any) => m.type === 'series')
  .sort((a: any, b: any) => ((b.views || 0) + (b.commentCount || 0)) - ((a.views || 0) + (a.commentCount || 0)))
  .slice(0, 10);

// Filter lists for Sidebar ranking (server-side)
const soiNoiMovies = [...allMoviesForServer]
  .sort((a: any, b: any) => (b.views || 0) - (a.views || 0))
  .slice(0, 5);

const yeuThichMovies = [...allMoviesForServer]
  .sort((a: any, b: any) => (b.imdbScore || 0) - (a.imdbScore || 0))
  .slice(0, 5);
---

<MainLayout isHome={true}>
  <!-- Hero Banner -->
  <section id="hero-banner" class="relative h-[85vh] w-full overflow-hidden">
    <!-- Image layers for cross-fade transition -->
    <div id="hero-bg-1" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-100" style={`background-image: url('${firstHero ? (firstHero.bannerUrl || firstHero.posterUrl) : "/logo-icon.gif"}')`}></div>
    <div id="hero-bg-2" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0B] via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0B] via-[#0A0A0B]/50 to-transparent hidden md:block"></div>
    
    <!-- Left & Right Arrow controls (Desktop only) -->
    <button id="hero-slide-left" class="absolute left-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full border border-white/10 bg-black/40 backdrop-blur-md text-white flex items-center justify-center hover:bg-primary/20 hover:border-primary transition-all duration-300 opacity-0 pointer-events-none hidden md:flex cursor-pointer shadow-lg" data-txatooltip="Phim trước">
      <span class="material-symbols-outlined text-2xl font-bold">chevron_left</span>
    </button>
    <button id="hero-slide-right" class="absolute right-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full border border-white/10 bg-black/40 backdrop-blur-md text-white flex items-center justify-center hover:bg-primary/20 hover:border-primary transition-all duration-300 opacity-0 pointer-events-none hidden md:flex cursor-pointer shadow-lg" data-txatooltip="Phim tiếp theo">
      <span class="material-symbols-outlined text-2xl font-bold">chevron_right</span>
    </button>

    <div class="relative h-full flex items-center max-w-container-max mx-auto px-gutter pt-20">
      <div id="hero-content" class="max-w-2xl space-y-6 transition-all duration-500 transform translate-y-0 opacity-100">
        <div class="flex items-center gap-3">
          <span id="hero-imdb" class="bg-primary/20 text-primary font-label-caps text-label-caps px-2 py-1 rounded shadow-sm backdrop-blur-md">{firstHero?.imdbScore ? `${firstHero.imdbScore.toFixed(1)} IMDb` : '8.0 IMDb'}</span>
          <span id="hero-year" class="bg-white/10 text-white font-label-caps text-label-caps px-2 py-1 rounded shadow-sm backdrop-blur-md">{firstHero?.releaseYear || '2024'}</span>
          <span id="hero-type" class="bg-white/10 text-white font-label-caps text-label-caps px-2 py-1 rounded shadow-sm backdrop-blur-md">{firstHero?.type === 'movie' ? 'Phim Lẻ' : firstHero?.type === 'hoathinh' ? 'Hoạt Hình' : 'Phim Bộ'}</span>
        </div>
        <h1 id="hero-title" class="font-display-hero text-display-hero md:text-[64px] font-extrabold leading-tight text-white drop-shadow-lg line-clamp-2">
            {firstHero?.title || 'Chào Mừng Đến Với DongMePhim'}
        </h1>
        <p id="hero-desc" class="text-on-surface-variant text-lg md:text-xl line-clamp-3 leading-relaxed">
            {firstHero?.description || 'Trải nghiệm điện ảnh đỉnh cao tại DongMePhim.'}
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a id="hero-play-link" href={firstHero ? `/phim/${firstHero.slug}` : "#"} class="cursor-pointer" style={firstHero ? "" : "display: none;"}>
            <Button variant="premium" size="lg" className="rounded-xl px-8 py-4 gap-2 text-white font-title-md">
              <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
              Xem Phim
            </Button>
          </a>
          <Button id="hero-playlist-btn" variant="secondary" size="lg" className="rounded-xl px-8 py-4 gap-2 font-title-md cursor-pointer relative group" style={firstHero ? {} : { display: 'none' }}>
            <span id="hero-playlist-icon-add" class="flex items-center justify-center">
              <Txaicon name="playlist-add" class="w-5 h-5" />
            </span>
            <span id="hero-playlist-icon-added" class="flex items-center justify-center hidden">
              <Txaicon name="playlist-added" class="w-5 h-5" />
            </span>
            <span id="hero-playlist-text">Danh sách</span>
            <div class="txatooltip absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap pointer-events-none text-[10px]">Thêm vào DS phát</div>
          </Button>
        </div>
      </div>
    </div>

    <!-- Carousel Indicators (Desktop Only) -->
    <div id="hero-indicators" class="absolute bottom-8 right-8 z-30 flex items-center gap-3 hidden md:flex"></div>
  </section>

  <!-- Content Categories -> Topics Grid -->
  <section class="px-gutter -mt-16 relative z-10 max-w-container-max mx-auto space-y-4">
    <h3 class="font-headline-lg text-lg text-white font-bold tracking-tight px-1 drop-shadow-md">Bạn đang quan tâm gì?</h3>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {topics.slice(0, 5).map((topic) => (
        <TopicCard
          name={topic.name}
          slug={topic.slug}
          gradient={topic.gradient}
          icon={topic.icon}
          labelText="Khám phá ngay"
          description={topic.description}
        />
      ))}
      <TopicCard
        name={`+${topics.length - 5} chủ đề`}
        slug="/chu-de"
        gradient="from-zinc-800 via-zinc-900 to-zinc-950"
        icon="apps"
        labelText="Xem tất cả"
        description="Khám phá tất cả danh mục phim thú vị khác."
      />
    </div>
  </section>

  <main class="max-w-container-max mx-auto px-gutter py-section-gap space-y-section-gap">
    <!-- Phim Lẻ Mới -->
    <section class="lazy-section" data-endpoint="/api/movies?type=movie&limit=4" data-grid-id="movies-grid" data-aspect="aspect-[2/3]">
      <div class="flex items-center gap-3 mb-6">
        <h2 class="font-display-hero text-2xl md:text-3xl font-extrabold text-white tracking-tight flex items-center gap-2 font-outfit">
          Phim Lẻ Mới
        </h2>
        <a class="group/more inline-flex items-center justify-center w-6 h-6 rounded-full bg-zinc-950/40 border border-zinc-800 hover:border-amber-500/50 hover:w-auto hover:px-3 hover:py-1 text-amber-400 hover:text-amber-300 hover:bg-amber-500/10 transition-all duration-300 shadow-md hover:shadow-[0_0_12px_rgba(245,158,11,0.35)] font-outfit" href="/phim-le">
          <span class="max-w-0 overflow-hidden group-hover/more:max-w-[70px] group-hover/more:mr-1 transition-all duration-300 ease-out whitespace-nowrap">Xem thêm</span>
          <span class="material-symbols-outlined text-[12px] font-bold">chevron_right</span>
        </a>
      </div>
      <div id="movies-grid" class="grid grid-cols-2 md:grid-cols-4 gap-gutter min-h-[280px]">
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
      </div>
    </section>

    <!-- Phim Hàn Quốc Mới -->
    <section class="lazy-section" data-endpoint="/api/movies?category=Hàn Quốc&limit=10" data-grid-id="korean-grid" data-layout="slider" data-more-url="/quoc-gia/han-quoc">
      <div class="flex flex-col md:flex-row gap-6 items-stretch">
        <!-- Mobile Section Header (visible on mobile only) -->
        <div class="flex md:hidden justify-between items-center w-full mb-1">
          <h2 class="text-lg font-bold text-white font-outfit flex items-center gap-1.5">
            Phim <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">Hàn Quốc</span> mới
          </h2>
          <a class="text-zinc-400 hover:text-white flex items-center" href="/quoc-gia/han-quoc">
            <span class="material-symbols-outlined text-lg">chevron_right</span>
          </a>
        </div>
        
        <!-- Desktop Left Header Column (hidden on mobile) -->
        <div class="hidden md:flex flex-col justify-center w-48 shrink-0 pr-4 space-y-3.5 select-none">
          <h2 class="font-display-hero text-2xl lg:text-3xl font-extrabold text-white tracking-tight font-outfit leading-tight">
            Phim <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary font-black">Hàn Quốc</span> <br/>
            mới
          </h2>
          <a class="group inline-flex items-center gap-1.5 text-xs font-bold text-amber-400 hover:text-amber-300 transition-all hover:shadow-[0_0_8px_rgba(245,158,11,0.2)] font-outfit" href="/quoc-gia/han-quoc">
            <span>Xem toàn bộ</span>
            <span class="material-symbols-outlined text-[10px] transform group-hover:translate-x-1 transition-transform">arrow_forward_ios</span>
          </a>
        </div>

        <!-- Right Slider Content -->
        <div class="relative flex-1 min-w-0">
          <div id="korean-grid" class="flex gap-4 overflow-x-auto pb-4 scrollbar-thin scrollbar-thumb-white/10 scrollbar-track-transparent snap-x">
            <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-2xl aspect-[16/9] w-[240px] md:w-[280px] shrink-0"></div>
            <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-2xl aspect-[16/9] w-[240px] md:w-[280px] shrink-0"></div>
            <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-2xl aspect-[16/9] w-[240px] md:w-[280px] shrink-0"></div>
            <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-2xl aspect-[16/9] w-[240px] md:w-[280px] shrink-0"></div>
          </div>
          <!-- Arrow Control -->
          <button class="absolute -right-4 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-black/60 border border-white/10 text-white flex items-center justify-center hover:bg-primary/20 hover:border-primary transition-all shadow-md hidden md:flex cursor-pointer slider-next-btn" data-txatooltip="Xem thêm">
            <span class="material-symbols-outlined text-sm font-bold">chevron_right</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Top 10 phim bộ hôm nay -->
    <section>
      <div class="flex justify-between items-end mb-6">
        <div>
          <h2 class="font-display-hero text-2xl md:text-3xl font-extrabold text-white tracking-tight flex items-center gap-2 font-outfit">
            Top 10 Phim Bộ Hôm Nay
            <span class="material-symbols-outlined text-transparent bg-clip-text bg-gradient-to-tr from-primary to-secondary" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
          </h2>
          <p class="text-on-surface-variant font-body-main mt-1 text-sm">Các bộ phim bộ đang được thảo luận và xem nhiều nhất</p>
        </div>
      </div>
      
      <!-- Horizontal Scroll Container with clipping protection -->
      <div id="top-series-scroll" class="flex gap-6 overflow-x-auto pb-20 pt-20 -my-16 scrollbar-thin scrollbar-thumb-white/10 scrollbar-track-transparent snap-x">
        {topSeries.map((movie: any, index: number) => (
          <div class="flex-shrink-0 w-44 md:w-52 relative pl-10 snap-center group">
            <!-- Large Rank Number -->
            <div class="absolute bottom-0 left-0 text-[120px] md:text-[140px] font-black leading-none select-none pointer-events-none text-transparent bg-clip-text bg-gradient-to-tr from-primary/80 via-primary/20 to-transparent z-0 font-display-hero transform translate-y-6">
              {index + 1}
            </div>
            
            <Card 
              title={movie.title}
              slug={movie.slug}
              poster={movie.posterUrl}
              year={movie.releaseYear}
              quality={movie.quality}
              status={movie.status === 'completed' ? 'Hoàn thành' : 'Đang chiếu'}
              aspect="aspect-[3/4]"
              class="z-10 relative"
              movie={movie}
            />
          </div>
        ))}
      </div>
    </section>

    <!-- Phim Bộ Mới -->
    <section class="lazy-section" data-endpoint="/api/movies?type=series&limit=4" data-grid-id="series-grid" data-aspect="aspect-[2/3]">
      <div class="flex items-center gap-3 mb-6">
        <h2 class="font-display-hero text-2xl md:text-3xl font-extrabold text-white tracking-tight flex items-center gap-2 font-outfit">
          Phim Bộ Mới
        </h2>
        <a class="group/more inline-flex items-center justify-center w-6 h-6 rounded-full bg-zinc-950/40 border border-zinc-800 hover:border-amber-500/50 hover:w-auto hover:px-3 hover:py-1 text-amber-400 hover:text-amber-300 hover:bg-amber-500/10 transition-all duration-300 shadow-md hover:shadow-[0_0_12px_rgba(245,158,11,0.35)] font-outfit" href="/phim-bo">
          <span class="max-w-0 overflow-hidden group-hover/more:max-w-[70px] group-hover/more:mr-1 transition-all duration-300 ease-out whitespace-nowrap">Xem thêm</span>
          <span class="material-symbols-outlined text-[12px] font-bold">chevron_right</span>
        </a>
      </div>
      <div id="series-grid" class="grid grid-cols-2 md:grid-cols-4 gap-gutter min-h-[280px]">
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
      </div>
    </section>

    <!-- Phim Trung Quốc Mới -->
    <section class="lazy-section" data-endpoint="/api/movies?category=Trung Quốc&limit=10" data-grid-id="chinese-grid" data-layout="slider" data-more-url="/quoc-gia/trung-quoc">
      <div class="flex flex-col md:flex-row gap-6 items-stretch">
        <!-- Mobile Section Header (visible on mobile only) -->
        <div class="flex md:hidden justify-between items-center w-full mb-1">
          <h2 class="text-lg font-bold text-white font-outfit flex items-center gap-1.5">
            Phim <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">Trung Quốc</span> mới
          </h2>
          <a class="text-zinc-400 hover:text-white flex items-center" href="/quoc-gia/trung-quoc">
            <span class="material-symbols-outlined text-lg">chevron_right</span>
          </a>
        </div>
        
        <!-- Desktop Left Header Column (hidden on mobile) -->
        <div class="hidden md:flex flex-col justify-center w-48 shrink-0 pr-4 space-y-3.5 select-none">
          <h2 class="font-display-hero text-2xl lg:text-3xl font-extrabold text-white tracking-tight font-outfit leading-tight">
            Phim <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary font-black">Trung Quốc</span> <br/>
            mới
          </h2>
          <a class="group inline-flex items-center gap-1.5 text-xs font-bold text-amber-400 hover:text-amber-300 transition-all hover:shadow-[0_0_8px_rgba(245,158,11,0.2)] font-outfit" href="/quoc-gia/trung-quoc">
            <span>Xem toàn bộ</span>
            <span class="material-symbols-outlined text-[10px] transform group-hover:translate-x-1 transition-transform">arrow_forward_ios</span>
          </a>
        </div>

        <!-- Right Slider Content -->
        <div class="relative flex-1 min-w-0">
          <div id="chinese-grid" class="flex gap-4 overflow-x-auto pb-4 scrollbar-thin scrollbar-thumb-white/10 scrollbar-track-transparent snap-x">
            <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-2xl aspect-[16/9] w-[240px] md:w-[280px] shrink-0"></div>
            <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-2xl aspect-[16/9] w-[240px] md:w-[280px] shrink-0"></div>
            <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-2xl aspect-[16/9] w-[240px] md:w-[280px] shrink-0"></div>
            <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-2xl aspect-[16/9] w-[240px] md:w-[280px] shrink-0"></div>
          </div>
          <!-- Arrow Control -->
          <button class="absolute -right-4 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-black/60 border border-white/10 text-white flex items-center justify-center hover:bg-primary/20 hover:border-primary transition-all shadow-md hidden md:flex cursor-pointer slider-next-btn" data-txatooltip="Xem thêm">
            <span class="material-symbols-outlined text-sm font-bold">chevron_right</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Phim Hoạt Hình Mới -->
    <section class="lazy-section" data-endpoint="/api/movies?type=hoathinh&limit=4" data-grid-id="anime-grid" data-aspect="aspect-[2/3]">
      <div class="flex items-center gap-3 mb-6">
        <h2 class="font-display-hero text-2xl md:text-3xl font-extrabold text-white tracking-tight flex items-center gap-2 font-outfit">
          Phim Hoạt Hình Mới
        </h2>
        <a class="group/more inline-flex items-center justify-center w-6 h-6 rounded-full bg-zinc-950/40 border border-zinc-800 hover:border-amber-500/50 hover:w-auto hover:px-3 hover:py-1 text-amber-400 hover:text-amber-300 hover:bg-amber-500/10 transition-all duration-300 shadow-md hover:shadow-[0_0_12px_rgba(245,158,11,0.35)] font-outfit" href="/the-loai/hoat-hinh">
          <span class="max-w-0 overflow-hidden group-hover/more:max-w-[70px] group-hover/more:mr-1 transition-all duration-300 ease-out whitespace-nowrap">Xem thêm</span>
          <span class="material-symbols-outlined text-[12px] font-bold">chevron_right</span>
        </a>
      </div>
      <div id="anime-grid" class="grid grid-cols-2 md:grid-cols-4 gap-gutter min-h-[280px]">
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
        <div class="skeleton-card animate-pulse bg-zinc-900/60 border border-glass-stroke/40 rounded-xl aspect-[2/3]"></div>
      </div>
    </section>

    <!-- Upgraded Bento Section: Top Comments Carousel & Three-Column Grid -->
    <section class="glass-card bg-[#141416]/50 border border-glass-stroke rounded-3xl p-6 md:p-8 space-y-8 shadow-2xl relative overflow-hidden">
      <!-- Glow backgrounds -->
      <div class="absolute -left-20 -top-20 w-80 h-80 bg-primary/5 blur-[120px] rounded-full"></div>
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-secondary/5 blur-[120px] rounded-full"></div>

      <!-- TOP BÌNH LUẬN Header -->
      <div class="flex items-center justify-between relative z-10 border-b border-glass-stroke pb-4">
        <h3 class="font-headline-lg text-lg text-primary flex items-center gap-2 font-outfit">
          <span class="material-symbols-outlined text-amber-400">forum</span>
          <span class="uppercase tracking-wider">Top Bình Luận</span>
        </h3>
        <!-- Carousel navigation arrows -->
        <div class="flex items-center gap-2">
          <button id="slide-left" class="w-8 h-8 rounded-full border border-glass-stroke flex items-center justify-center text-zinc-400 hover:text-white hover:border-zinc-500 transition-colors cursor-pointer bg-black/20" data-txatooltip="Slide Trái">
            <span class="material-symbols-outlined text-sm font-bold">chevron_left</span>
          </button>
          <button id="slide-right" class="w-8 h-8 rounded-full border border-glass-stroke flex items-center justify-center text-zinc-400 hover:text-white hover:border-zinc-500 transition-colors cursor-pointer bg-black/20" data-txatooltip="Slide Phải">
            <span class="material-symbols-outlined text-sm font-bold">chevron_right</span>
          </button>
        </div>
      </div>

      <!-- TOP BÌNH LUẬN Horizontal Carousel -->
      <div id="comments-carousel" class="flex gap-4 overflow-x-auto pb-4 scroll-smooth scrollbar-none snap-x relative z-10">
         <p class="text-xs text-zinc-500 py-8 text-center w-full font-outfit">Đang tải bình luận...</p>
      </div>

      <!-- Bottom Grid: SÔI NỔI NHẤT, YÊU THÍCH NHẤT, THỂ LOẠI HOT, BÌNH LUẬN MỚI -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 pt-6 border-t border-glass-stroke relative z-10">
        <!-- SÔI NỔI NHẤT -->
        <div class="space-y-4">
          <h4 class="font-bold text-sm text-amber-400 uppercase tracking-wider flex items-center gap-2 border-b border-glass-stroke/40 pb-2 font-outfit">
            <span class="material-symbols-outlined text-amber-400 text-sm">analytics</span> Sôi nổi nhất
          </h4>
          <div id="soi-noi-list" class="space-y-3">
            {soiNoiMovies.map((movie, index) => {
              const trendColor = index < 3 ? 'emerald' : 'zinc';
              const trendIcon = index === 0 ? 'trending_up' : index === 2 ? 'trending_up' : index === 3 ? 'trending_down' : 'remove';
              return (
                <a href={`/phim/${movie.slug}`} class="flex items-center gap-3.5 p-2 rounded-xl hover:bg-white/5 transition-all group/item cursor-pointer w-full">
