  // Helper function to create movie slider cards with 16:9 aspect ratio and bottom-left badges
  function createMovieSliderCardHTML(movie) {
    const title = movie.title || '';
    const slug = movie.slug || '';
    const poster = movie.posterUrl || movie.poster || '';
    const quality = movie.quality || 'FHD';
    const lang = movie.lang || 'Vietsub';
    const originalTitle = movie.originalTitle || movie.origin_name || '';
    
    // Format label badges
    let badgesHTML = '';
    const cleanLang = lang.toLowerCase();
    let label = 'PĐ';
    let labelClass = 'bg-zinc-800/80 border border-white/10';
    if (cleanLang.includes('thuyết minh') || cleanLang.includes('tm')) {
      label = 'TM';
      labelClass = 'bg-blue-600/80 border border-blue-500/20';
    } else if (cleanLang.includes('lồng tiếng') || cleanLang.includes('lt')) {
      label = 'LT';
      labelClass = 'bg-pink-600/80 border border-pink-500/20';
    }
    
    let epLabel = '';
    if (movie.episodeCurrent) {
      let cur = (movie.episodeCurrent || '1').trim().replace(/^[tT]ập\s+/, '');
      if (cur.toLowerCase() === 'full' || cur.toLowerCase() === 'hoàn thành') {
        epLabel = 'Full';
      } else {
        epLabel = `Tập ${cur}`;
      }
    }
    
    badgesHTML = `
      <div class="absolute bottom-2 left-2 z-20 flex gap-1 font-outfit select-none pointer-events-none">
        <span class="${labelClass} text-white text-[8px] font-black px-1.5 py-0.5 rounded shadow-sm">${label}</span>
        ${epLabel ? `<span class="bg-black/60 text-white text-[8px] font-semibold px-1.5 py-0.5 rounded border border-white/5 backdrop-blur-sm shadow-sm">${epLabel}</span>` : ''}
      </div>
    `;

    return `
      <div class="flex-shrink-0 w-[240px] md:w-[280px] snap-center group">
        <a href="/phim/${slug}" class="relative block w-full aspect-[16/9] rounded-2xl overflow-hidden glass-card border border-glass-stroke movie-card-hover transition-all duration-300 cursor-pointer">
          <img src="${poster}" alt="${title}" class="w-full h-full object-cover" loading="lazy" onerror="this.src='/favicon.png'" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-100 transition-opacity"></div>
          
          ${badgesHTML}
          
          <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-all duration-300 group-hover:opacity-100 bg-black/20">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/95 text-on-primary backdrop-blur-md transform scale-50 transition-transform duration-300 group-hover:scale-100 shadow-xl shadow-primary/20">
              <span class="material-symbols-outlined ml-0.5 text-xl" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
            </div>
          </div>
        </a>

        <div class="mt-2.5 px-1 space-y-0.5">
          <h3 class="font-bold text-xs text-white line-clamp-1 group-hover:text-primary transition-colors font-outfit" data-txatooltip="${title}">
            ${title}
          </h3>
          <p class="text-[9px] text-zinc-500 truncate font-medium font-outfit" data-txatooltip="${originalTitle}">
            ${originalTitle || title}
          </p>
        </div>
      </div>
    `;
  }

  // Bind all initialization to 'astro:page-load'
  document.addEventListener('astro:page-load', async () => {
    // Initialize Swipers
    function initSwipers() {
      if (typeof Swiper === 'undefined') {
        setTimeout(initSwipers, 100);
        return;
      }
      
      const animeThumbs = new Swiper('.anime-thumbs-swiper', {
        spaceBetween: 10,
        slidesPerView: 4,
        freeMode: true,
        watchSlidesProgress: true,
      });

      new Swiper('.anime-main-swiper', {
        spaceBetween: 10,
        effect: 'fade',
        fadeEffect: {
          crossFade: true
        },
        thumbs: {
          swiper: animeThumbs,
        },
        autoplay: {
          delay: 5000,
          disableOnInteraction: false,
        },
      });

      document.querySelectorAll('.top10-swiper').forEach(el => {
        new Swiper(el, {
          slidesPerView: 2,
          spaceBetween: 16,
          breakpoints: {
            640: {
              slidesPerView: 3,
              spaceBetween: 20,
            },
            768: {
              slidesPerView: 4,
              spaceBetween: 20,
            },
            1024: {
              slidesPerView: 5,
              spaceBetween: 24,
            },
          },
        });
      });
    }
    initSwipers();

    // 1. IntersectionObserver for Scroll-based Lazy Rendering
    const lazySections = document.querySelectorAll('.lazy-section');
    
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const section = entry.target;
            const endpoint = section.getAttribute('data-endpoint');
            const gridId = section.getAttribute('data-grid-id');
            const aspect = section.getAttribute('data-aspect') || 'aspect-[2/3]';
            const layout = section.getAttribute('data-layout');
            const grid = document.getElementById(gridId);
            
            if (endpoint && grid) {
              fetch(endpoint)
                .then(res => res.json())
                .then(result => {
                  const moviesList = result.data || [];
                  if (moviesList.length > 0) {
                    let html = '';
                    moviesList.forEach((m) => {
                      if (layout === 'slider') {
                        html += createMovieSliderCardHTML(m);
                      } else {
                        html += createMovieCardHTML(m, aspect);
                      }
                    });
                    grid.innerHTML = html;
                  } else {
                    grid.innerHTML = '<p class="text-xs text-zinc-500 py-8 text-center col-span-full font-outfit">Chưa có phim nào trong mục này.</p>';
                  }
                })
                .catch(err => {
                  console.error('Error fetching lazy section:', err);
                  grid.innerHTML = '<p class="text-xs text-red-400 py-8 text-center col-span-full font-outfit">Lỗi tải dữ liệu.</p>';
                });
            }
            observer.unobserve(section);
          }
        });
      }, { rootMargin: '100px 0px 400px 0px' });
      
      lazySections.forEach(section => observer.observe(section));
    } else {
      // Fallback if IntersectionObserver not supported
      lazySections.forEach(section => {
        const endpoint = section.getAttribute('data-endpoint');
        const gridId = section.getAttribute('data-grid-id');
        const aspect = section.getAttribute('data-aspect') || 'aspect-[2/3]';
        const layout = section.getAttribute('data-layout');
        const grid = document.getElementById(gridId);
        if (endpoint && grid) {
          fetch(endpoint)
            .then(res => res.json())
            .then(result => {
              const moviesList = result.data || [];
              let html = '';
              moviesList.forEach(m => {
                if (layout === 'slider') {
                  html += createMovieSliderCardHTML(m);
                } else {
                  html += createMovieCardHTML(m, aspect);
                }
              });
              grid.innerHTML = html;
            });
        }
      });
    }

    // Scroll-to-load Groups controller
    if ('IntersectionObserver' in window) {
      const showGroup = (groupId) => {
        const group = document.getElementById(groupId);
        if (group) {
          group.classList.remove('hidden');
          // Trigger reflow
          group.offsetHeight;
          group.classList.remove('opacity-0');
          group.classList.add('opacity-100');
        }
      };

      const obsOptions = { rootMargin: '100px 0px 400px 0px' };

      const obs1 = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          showGroup('scroll-group-1');
          obs1.disconnect();
        }
      }, obsOptions);
      const s1 = document.getElementById('sentinel-1');
      if (s1) obs1.observe(s1);

      const obs2 = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          showGroup('scroll-group-2');
          obs2.disconnect();
        }
      }, obsOptions);
      const s2 = document.getElementById('sentinel-2');
      if (s2) obs2.observe(s2);

      const obs3 = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          showGroup('scroll-group-3');
          obs3.disconnect();
        }
      }, obsOptions);
      const s3 = document.getElementById('sentinel-3');
      if (s3) obs3.observe(s3);
    } else {
      // Fallback
      ['scroll-group-1', 'scroll-group-2', 'scroll-group-3'].forEach(id => {
        const group = document.getElementById(id);
        if (group) group.classList.remove('hidden', 'opacity-0');
      });
    }

    // Scroll controls for slider layout sections
    document.querySelectorAll('.lazy-section[data-layout="slider"]').forEach(section => {
      const gridId = section.getAttribute('data-grid-id');
      const grid = document.getElementById(gridId);
      const nextBtn = section.querySelector('.slider-next-btn');
      if (grid && nextBtn) {
        nextBtn.addEventListener('click', () => {
          grid.scrollBy({ left: grid.clientWidth * 0.85, behavior: 'smooth' });
        });
      }
    });

    // 2. Comments carousel sliding
    const carousel = document.getElementById('comments-carousel');
    const slideLeft = document.getElementById('slide-left');
    const slideRight = document.getElementById('slide-right');
    
    slideLeft?.addEventListener('click', () => {
      carousel?.scrollBy({ left: -296, behavior: 'smooth' });
    });
    
    slideRight?.addEventListener('click', () => {
      carousel?.scrollBy({ left: 296, behavior: 'smooth' });
    });

    // 3. Hydration logic
    let combinedMovies = [];
    try {
      combinedMovies = heroMoviesForClient || [];
      const hasMovies = combinedMovies.length > 0;

      // Helper to map movie slug to details
