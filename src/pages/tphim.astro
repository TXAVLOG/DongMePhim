  // Helper function to create movie slider cards with 16:9 aspect ratio and bottom-left badges
  function createMovieSliderCardHTML(movie) {
    const title = movie.title || '';
    const slug = movie.slug || '';
    const poster = movie.posterUrl || movie.poster || '';
    const quality = movie.quality || 'FHD';
    const lang = movie.lang || 'Vietsub';
    const originalTitle = movie.originalTitle || movie.origin_name || '';
    
    // Format label badges
    let badgesHTML = '';
    const cleanLang = lang.toLowerCase();
    let label = 'PĐ';
    let labelClass = 'bg-zinc-800/80 border border-white/10';
    if (cleanLang.includes('thuyết minh') || cleanLang.includes('tm')) {
      label = 'TM';
      labelClass = 'bg-blue-600/80 border border-blue-500/20';
    } else if (cleanLang.includes('lồng tiếng') || cleanLang.includes('lt')) {
      label = 'LT';
      labelClass = 'bg-pink-600/80 border border-pink-500/20';
    }
    
    let epLabel = '';
    if (movie.episodeCurrent) {
      let cur = (movie.episodeCurrent || '1').trim().replace(/^[tT]ập\s+/, '');
      if (cur.toLowerCase() === 'full' || cur.toLowerCase() === 'hoàn thành') {
        epLabel = 'Full';
      } else {
        epLabel = `Tập ${cur}`;
      }
    }
    
    badgesHTML = `
      <div class="absolute bottom-2 left-2 z-20 flex gap-1 font-outfit select-none pointer-events-none">
        <span class="${labelClass} text-white text-[8px] font-black px-1.5 py-0.5 rounded shadow-sm">${label}</span>
        ${epLabel ? `<span class="bg-black/60 text-white text-[8px] font-semibold px-1.5 py-0.5 rounded border border-white/5 backdrop-blur-sm shadow-sm">${epLabel}</span>` : ''}
      </div>
    `;

    return `
