---
import MainLayout from '@layouts/MainLayout.astro';
import { Button } from '@components/ui/Button';
import Card from '@components/ui/Card.astro';
import TopicCard from '@components/ui/TopicCard.astro';
import { topics } from '@data/topics';
import { MovieService } from '@services/MovieService';
import Txaicon from '@components/ui/txaicon.astro';
import { getHomepageCategories } from '@data/categories';
import { TxaMovieRanker } from '../backend/utils/txaMovieRanker';
import { TxaTrendingService } from '../backend/services/txaTrendingService';
import { supabase } from '@lib/supabase';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
const siteName = settings?.general?.site_name || 'Động Mê Phim';

const homepageMappings = await getHomepageCategories();

// Lấy tất cả các slugs được gán thủ công trên trang chủ
const animeSlugs: string[] = homepageMappings['top-anime-he'] || [];
const top10Slugs: string[] = homepageMappings['top-10-phim-le'] || [];
const top10PhimBoSlugs: string[] = homepageMappings['top-10-phim-bo'] || [];
const vietNamSlugs: string[] = homepageMappings['viet-nam'] || [];

const assignedSlugs: string[] = [...new Set([...animeSlugs, ...top10Slugs, ...top10PhimBoSlugs, ...vietNamSlugs])];

// Lấy phim theo các slugs được gán, 300 phim mới nhất và toàn bộ phim Việt Nam để làm fallback/sidebar
const [assignedMovies, latestMovies, allVietNamMovies] = await Promise.all([
  assignedSlugs.length > 0 ? MovieService.getMovies({ slugs: assignedSlugs }) : Promise.resolve([]),
  MovieService.getMovies({ limit: 300, sortBy: 'updatedAt' }),
  MovieService.getMovies({ category: 'Việt Nam' })
]);

// Gộp và loại bỏ trùng lặp
const movieMap = new Map();
latestMovies.forEach((m: any) => movieMap.set(m.slug, m));
assignedMovies.forEach((m: any) => movieMap.set(m.slug, m));
const allMoviesForServer = Array.from(movieMap.values());

// Top Anime: Đọc từ cấu hình admin + lọc bù cho đủ 15 bộ bằng Anime chuẩn (loại bỏ hoạt hình như Gấu Boonie)
const isAnimeMovie = (m: any) => {
  if (!m) return false;
  const title = (m.title || '').toLowerCase();
  const desc = (m.description || '').toLowerCase();
  const country = (m.country || '').toLowerCase();
  const genres = Array.isArray(m.genres) ? m.genres.map((g: any) => g.toLowerCase()) : [];
  
  const isAnimation = m.type === 'hoathinh' || genres.includes('hoạt hình') || genres.includes('anime');
  if (!isAnimation) return false;
  
  // Lọc chuẩn Anime: Phải có chữ 'anime', hoặc xuất xứ từ Nhật Bản, hoặc từ khóa trong tiêu đề/mô tả
  const hasAnimeKeywords = genres.includes('anime') || 
                           country.includes('nhật bản') || 
                           country.includes('japan') || 
                           title.includes('anime') || 
                           desc.includes('anime');
                           
  return hasAnimeKeywords;
};

const configuredAnime = animeSlugs
  .map(slug => allMoviesForServer.find((m: any) => m.slug === slug))
  .filter(Boolean);
const otherAnime = allMoviesForServer.filter((m: any) => isAnimeMovie(m) && !animeSlugs.includes(m.slug));
const sortedOtherAnime = TxaMovieRanker.sortMovies(otherAnime);
const topAnimeList = [...configuredAnime, ...sortedOtherAnime].slice(0, 15);

// Phim xu hướng và gợi ý động từ TxaTrendingService
const [top10PhimLeList, top10PhimBoList, pRecommendations] = await Promise.all([
  TxaTrendingService.getTopTrending('movie', 10),
  TxaTrendingService.getTopTrending('series', 10),
  TxaTrendingService.getPersonalizedRecommendations(null, 10)
]);

// Điện Ảnh Việt: Xem Là Cuốn!: Đọc từ cấu hình admin + bù cho đủ 20 phim Việt Nam chuẩn sắp xếp theo txaranking
const configuredVietNam = vietNamSlugs
  .map(slug => allMoviesForServer.find((m: any) => m.slug === slug) || allVietNamMovies.find((m: any) => m.slug === slug))
  .filter(Boolean);
const otherVietNam = allVietNamMovies.filter((m: any) => !vietNamSlugs.includes(m.slug));
const sortedOtherVietNam = TxaMovieRanker.sortMovies(otherVietNam);
const vietNamMoviesList = [...configuredVietNam, ...sortedOtherVietNam].slice(0, 20);

// Filter Top Series for Rank slider (server-side)
const topSeries = allMoviesForServer
  .filter((m: any) => m.type === 'series')
  .sort((a: any, b: any) => ((b.views || 0) + (b.commentCount || 0)) - ((a.views || 0) + (a.commentCount || 0)))
  .slice(0, 10);

// Phim điện ảnh mới coóng - Tự động phân loại (Lọc phim lẻ, ưu tiên chiếu rạp, sắp xếp mới nhất)
const phimDienAnhList = [...allMoviesForServer]
  .filter((m: any) => m.type === 'movie')
  .sort((a: any, b: any) => {
    const aIsChieuRap = a.genres && a.genres.some((g: string) => g.toLowerCase().includes('chiếu rạp'));
    const bIsChieuRap = b.genres && b.genres.some((g: string) => g.toLowerCase().includes('chiếu rạp'));
    if (aIsChieuRap && !bIsChieuRap) return -1;
    if (!aIsChieuRap && bIsChieuRap) return 1;
    
    const yearDiff = (b.releaseYear || 0) - (a.releaseYear || 0);
    if (yearDiff !== 0) return yearDiff;
    
    return new Date(b.updatedAt || 0).getTime() - new Date(a.updatedAt || 0).getTime();
  })
  .slice(0, 18);

// Filter lists for Sidebar ranking (server-side)
// Sôi nổi nhất: Sắp xếp theo công thức ranking TXA
const soiNoiMovies = TxaMovieRanker.sortMovies(allMoviesForServer).slice(0, 5);

// Yêu thích nhất: Lấy số lượt yêu thích từ database favorites (nếu có), fallback về ngẫu nhiên
const movieIds = allMoviesForServer.map((m: any) => m.id).filter(Boolean);
const favoriteCounts: Record<string, number> = {};

if (movieIds.length > 0) {
  const { data: favoriteData } = await supabase
    .from('favorites')
    .select('movie_id')
    .in('movie_id', movieIds);

  if (favoriteData) {
    for (const fav of favoriteData) {
      if (fav.movie_id) {
        favoriteCounts[fav.movie_id] = (favoriteCounts[fav.movie_id] || 0) + 1;
      }
    }
  }
}

// Phân loại phim có lượt yêu thích và không có lượt yêu thích
const moviesWithFavs = allMoviesForServer.filter((m: any) => (favoriteCounts[m.id] || 0) > 0);
const moviesWithoutFavs = allMoviesForServer.filter((m: any) => !(favoriteCounts[m.id] || 0));

// Sắp xếp phim có lượt yêu thích theo số lượng giảm dần
moviesWithFavs.sort((a: any, b: any) => (favoriteCounts[b.id] || 0) - (favoriteCounts[a.id] || 0));

// Xáo trộn ngẫu nhiên các phim không có lượt yêu thích
const shuffledWithoutFavs = [...moviesWithoutFavs].sort(() => Math.random() - 0.5);

// Gộp chung: Ưu tiên phim có lượt yêu thích, sau đó bổ sung phim ngẫu nhiên cho đủ 5
const yeuThichMovies = [...moviesWithFavs, ...shuffledWithoutFavs].slice(0, 5);

// Get pinned or fallback latest movies for hero banner
const pinnedMovies = allMoviesForServer.filter((m: any) => m.pinned === true || m.pinned === 'true');
const heroMovies = pinnedMovies.length > 0 ? pinnedMovies : allMoviesForServer.slice(0, 5);
const firstHero = heroMovies[0] || null;

const getMovieProgressBadgesSSR = (movie: any) => {
  if (!movie) return '';

  const isSeries = movie.type === 'series' || movie.type === 'hoathinh' || movie.type === 'tvshows';
  if (isSeries && movie.status === 'completed') {
    return `
      <span class="bg-emerald-950/90 text-emerald-400 border border-emerald-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase tracking-wide">
        Hoàn tất
      </span>
    `;
  }

  const episodes = movie.episodes || [];

  if (isSeries) {
    let pdEpisodes = 0;
    let tmEpisodes = 0;

    episodes.forEach((server: any) => {
      const name = (server.serverName || '').toLowerCase();
      const epCount = Array.isArray(server.serverData) ? server.serverData.length : 0;
      const isTm = name.includes('thuyết minh') || name.includes('thuyetminh') || name.includes('t.minh') || name.includes('tm') || name.includes('lồng tiếng') || name.includes('longtieng') || name.includes('l.tiếng') || name.includes('lt');
      if (isTm) {
        tmEpisodes = Math.max(tmEpisodes, epCount);
      } else {
        pdEpisodes = Math.max(pdEpisodes, epCount);
      }
    });

    if (pdEpisodes === 0 && tmEpisodes === 0) {
      const cur = (movie.episodeCurrent || '').trim().replace(/^[tT]ập\s+/, '');
      const curNum = parseInt(cur);
      if (!isNaN(curNum)) {
        const langLower = (movie.lang || '').toLowerCase();
        if (langLower.includes('thuyết minh') || langLower.includes('lồng tiếng')) {
          tmEpisodes = curNum;
        } else {
          pdEpisodes = curNum;
        }
      }
    }

    let html = '';
    if (pdEpisodes > 0) {
      html += `
        <span class="bg-sky-950/90 text-sky-400 border border-sky-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          PĐ ${pdEpisodes}
        </span>
      `;
    }
    if (tmEpisodes > 0) {
      html += `
        <span class="bg-purple-950/90 text-purple-400 border border-purple-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          TM ${tmEpisodes}
        </span>
      `;
    }
    if (pdEpisodes === 0 && tmEpisodes === 0) {
      html += `
        <span class="bg-zinc-950/90 text-zinc-400 border border-zinc-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          Đang chiếu
        </span>
      `;
    }
    return html;
  } else {
    let hasPd = false;
    let hasTm = false;

    episodes.forEach((server: any) => {
      const name = (server.serverName || '').toLowerCase();
      const isTm = name.includes('thuyết minh') || name.includes('thuyetminh') || name.includes('t.minh') || name.includes('tm') || name.includes('lồng tiếng') || name.includes('longtieng') || name.includes('l.tiếng') || name.includes('lt');
      if (isTm) {
        hasTm = true;
      } else {
        hasPd = true;
      }
    });

    if (!hasPd && !hasTm) {
      const langLower = (movie.lang || '').toLowerCase();
      if (langLower.includes('thuyết minh') && (langLower.includes('vietsub') || langLower.includes('phụ đề'))) {
        hasPd = true;
        hasTm = true;
      } else if (langLower.includes('thuyết minh') || langLower.includes('lồng tiếng')) {
        hasTm = true;
      } else {
        hasPd = true;
      }
    }

    let html = '';
    if (hasPd) {
      html += `
        <span class="bg-sky-950/90 text-sky-400 border border-sky-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          Vietsub
        </span>
      `;
    }
    if (hasTm) {
      html += `
        <span class="bg-purple-950/90 text-purple-400 border border-purple-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
          TM
        </span>
      `;
    }
    return html;
  }
};
---

<MainLayout isHome={true}>
  <!-- Hero Banner -->
  <section id="hero-banner" class="relative h-[55vh] md:h-[85vh] w-full overflow-hidden">
    <!-- Image layers for cross-fade transition -->
    <div id="hero-bg-1" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-100 will-change-transform" style={`background-image: url('${firstHero ? (firstHero.bannerUrl || firstHero.posterUrl) : "/logo-icon.gif"}')`}></div>
    <div id="hero-bg-2" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 will-change-transform"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0B] via-[#0A0A0B]/40 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0B] via-[#0A0A0B]/60 to-transparent hidden md:block"></div>
    
    <!-- Left & Right Arrow controls (Desktop only) -->
    <button id="hero-slide-left" class="absolute left-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full border border-white/15 bg-black/50 backdrop-blur-xl text-white flex items-center justify-center hover:bg-primary hover:border-primary hover:scale-110 active:scale-95 transition-all duration-300 opacity-0 pointer-events-none hidden md:flex cursor-pointer shadow-2xl" data-txatooltip="Phim trước">
      <span class="material-symbols-outlined text-2xl font-bold">chevron_left</span>
    </button>
    <button id="hero-slide-right" class="absolute right-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full border border-white/15 bg-black/50 backdrop-blur-xl text-white flex items-center justify-center hover:bg-primary hover:border-primary hover:scale-110 active:scale-95 transition-all duration-300 opacity-0 pointer-events-none hidden md:flex cursor-pointer shadow-2xl" data-txatooltip="Phim tiếp theo">
      <span class="material-symbols-outlined text-2xl font-bold">chevron_right</span>
    </button>

    <div class="relative h-full flex items-center max-w-container-max mx-auto px-gutter pt-20">
      <div id="hero-content" class="max-w-2xl space-y-6 transition-all duration-500 transform translate-y-0 opacity-100">
        <div class="flex items-center gap-3">
          <span id="hero-imdb" class="bg-primary/25 text-primary font-label-caps text-label-caps px-2.5 py-1 rounded-lg border border-primary/30 shadow-md backdrop-blur-md font-extrabold">{firstHero?.imdbScore ? `${firstHero.imdbScore.toFixed(1)} IMDb` : '8.0 IMDb'}</span>
          <span id="hero-year" class="bg-white/10 text-white font-label-caps text-label-caps px-2.5 py-1 rounded-lg border border-white/10 shadow-md backdrop-blur-md font-bold">{firstHero?.releaseYear || '2024'}</span>
          <span id="hero-type" class="bg-white/10 text-white font-label-caps text-label-caps px-2.5 py-1 rounded-lg border border-white/10 shadow-md backdrop-blur-md font-bold">{firstHero?.type === 'movie' ? 'Phim Lẻ' : firstHero?.type === 'hoathinh' ? 'Hoạt Hình' : 'Phim Bộ'}</span>
        </div>
        <h1 id="hero-title" class="font-display-hero text-display-hero md:text-[64px] font-extrabold leading-tight text-white drop-shadow-xl line-clamp-2">
            {firstHero?.title || 'Chào Mừng Đến Với DongMePhim'}
        </h1>
        <p id="hero-desc" class="text-on-surface-variant text-lg md:text-xl line-clamp-3 leading-relaxed font-sans opacity-90">
            {firstHero?.description || 'Trải nghiệm điện ảnh đỉnh cao tại DongMePhim.'}
        </p>
        <div class="flex items-center gap-4 pt-4">
          <!-- Play Button (Circle, vibrant amber/gold with silky glow) -->
          <a id="hero-play-link" href={firstHero ? `/xem/${firstHero.slug}` : "#"} class="w-14 h-14 rounded-full btn-gold-glow flex items-center justify-center cursor-pointer shrink-0 transition-all duration-300" style={firstHero ? "" : "display: none;"} data-txatooltip="Xem Phim">
            <span class="material-symbols-outlined text-3xl ml-0.5 font-bold" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
          </a>

          <!-- Capsule container for Playlist and Info buttons -->
          <div class="flex items-center rounded-full bg-[#141416]/80 border border-white/15 backdrop-blur-xl overflow-hidden h-12 shadow-2xl transition-all" style={firstHero ? "" : "display: none;"}>
            <!-- Playlist Button -->
            <button id="hero-playlist-btn" class="relative w-12 h-full flex items-center justify-center text-zinc-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer border-r border-white/10" data-txatooltip="Thêm vào DS phát">
              <span id="hero-playlist-icon-add" class="flex items-center justify-center">
                <Txaicon name="playlist-add" class="w-5 h-5" />
              </span>
              <span id="hero-playlist-icon-added" class="flex items-center justify-center hidden">
                <Txaicon name="playlist-added" class="w-5 h-5 text-amber-400" />
              </span>
            </button>
            
            <!-- Info/Details Button -->
            <a id="hero-info-link" href={firstHero ? `/phim/${firstHero.slug}` : "#"} class="relative w-12 h-full flex items-center justify-center text-zinc-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" data-txatooltip="Chi tiết phim">
              <span class="material-symbols-outlined text-xl">info</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Carousel Indicators (Desktop Only) -->
    <div id="hero-indicators" class="absolute bottom-8 right-8 z-30 flex items-center gap-3 hidden md:flex"></div>
  </section>

  <!-- Content Categories -> Topics Grid -->
  <section class="px-gutter -mt-10 sm:-mt-14 md:-mt-16 relative z-10 max-w-container-max mx-auto space-y-4">
    <h3 class="font-headline-lg text-lg text-white font-bold tracking-tight px-1 drop-shadow-md font-outfit">Bạn đang quan tâm gì?</h3>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      {topics.slice(0, 5).map((topic) => (
        <TopicCard
          name={topic.name}
          slug={topic.slug}
          gradient={topic.gradient}
          icon={topic.icon}
          labelText="Khám phá ngay"
          description={topic.description}
        />
      ))}
      <TopicCard
        name={`+${topics.length - 5} chủ đề`}
        slug="/chu-de"
        gradient="from-zinc-800 via-zinc-900 to-zinc-950"
        icon="apps"
        labelText="Xem tất cả"
        description="Khám phá tất cả danh mục phim thú vị khác."
      />
    </div>
  </section>

  <!-- Member Callout Banner: "Đăng nhập để lưu phim xem tiếp" (Như Ảnh 2) -->
  <section class="auth-guest px-gutter max-w-container-max mx-auto mt-6 mb-2">
    <div class="glass-card-premium rounded-2xl sm:rounded-3xl border border-amber-500/25 p-5 sm:p-6 md:p-8 relative overflow-hidden shadow-[0_16px_40px_rgba(0,0,0,0.6)]">
      <!-- Ambient Glow Elements -->
      <div class="absolute -right-16 -top-16 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-72 h-72 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <!-- Left: Text & Action Button -->
        <div class="space-y-3 max-w-xl">
          <div class="space-y-1">
            <h4 class="font-title-md text-base sm:text-xl font-extrabold text-white tracking-tight flex items-center gap-2 font-outfit">
              <span class="material-symbols-outlined text-amber-400 text-2xl">account_circle</span>
              Đăng nhập để lưu phim xem tiếp
            </h4>
            <p class="text-xs sm:text-sm text-zinc-300/90 font-sans leading-relaxed">
              Lưu phim đang xem, đồng bộ trên nhiều thiết bị, tạo danh sách riêng — hoàn toàn miễn phí.
            </p>
          </div>
          <button onclick="window.dispatchEvent(new Event('open-login-modal'))" class="btn-gold-glow px-5 py-2.5 rounded-xl font-bold text-xs inline-flex items-center gap-2 cursor-pointer uppercase tracking-wider font-outfit">
            <span class="material-symbols-outlined text-base">login</span>
            <span>Đăng nhập ngay</span>
          </button>
        </div>

        <!-- Right: 4 Features in 2x2 Grid -->
        <div class="grid grid-cols-2 gap-2.5 sm:gap-3.5 shrink-0 lg:max-w-md w-full lg:w-auto">
          <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white/5 border border-white/5 backdrop-blur-sm">
            <span class="material-symbols-outlined text-amber-400 text-lg sm:text-xl shrink-0">history</span>
            <span class="text-xs font-semibold text-zinc-200">Lưu tiến trình xem</span>
          </div>
          <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white/5 border border-white/5 backdrop-blur-sm">
            <span class="material-symbols-outlined text-rose-400 text-lg sm:text-xl shrink-0">favorite</span>
            <span class="text-xs font-semibold text-zinc-200">Thêm phim yêu thích</span>
          </div>
          <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white/5 border border-white/5 backdrop-blur-sm">
            <span class="material-symbols-outlined text-sky-400 text-lg sm:text-xl shrink-0">devices</span>
            <span class="text-xs font-semibold text-zinc-200">Đồng bộ đa thiết bị</span>
          </div>
          <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white/5 border border-white/5 backdrop-blur-sm">
            <span class="material-symbols-outlined text-emerald-400 text-lg sm:text-xl shrink-0">playlist_add_check</span>
            <span class="text-xs font-semibold text-zinc-200">Tạo danh sách riêng</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="max-w-container-max mx-auto px-gutter py-section-gap space-y-section-gap">
    <!-- Swiper CDN assets -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.css" />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js"></script>

    <!-- Gợi Ý Cho Bạn (Personalized Recommendations) -->
    {pRecommendations.length > 0 && (
      <section class="space-y-6 relative py-4">
        <!-- Ambient Glow -->
        <div class="absolute -top-10 left-10 w-96 h-96 bg-purple-600/5 rounded-full blur-[120px] pointer-events-none"></div>
        
        <div class="flex items-center justify-between relative z-10">
          <div>
            <h2 class="font-display-hero text-2xl md:text-3xl font-extrabold text-white tracking-tight flex items-center gap-2 font-outfit">
              Gợi Ý Cho Bạn
