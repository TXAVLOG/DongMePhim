          badgeColor = 'amber-500';
        } else if (lowerAuthor.charCodeAt(0) % 2 === 0) {
          badgeColor = 'indigo-500';
        } else {
          badgeColor = 'teal-500';
        }

        const views = comment.views !== undefined ? comment.views : Math.floor(Math.random() * 150) + 10;

        return `
          <div class="flex-shrink-0 w-[280px] bg-zinc-950/40 border border-glass-stroke/60 rounded-2xl p-4 flex flex-col justify-between hover:border-primary/30 hover:bg-zinc-950/60 transition-all duration-300 snap-center">
