              chineseList.slice(0, 3).forEach(m => {
                html += createMovieCardHTML(m, "aspect-video");
              });
              chineseGrid.innerHTML = html;
            }
          }

          // 6. Render Top 10 Phim Bộ Hôm Nay
          const topSeriesScroll = document.getElementById('top-series-scroll');
          if (topSeriesScroll) {
            const seriesList = combinedMovies.filter(m => m.type === 'series');
            if (seriesList.length > 0) {
              const sortedSeries = [...seriesList].sort((a, b) => {
                const scoreA = (a.views || 0) + (a.commentCount || 0);
                const scoreB = (b.views || 0) + (b.commentCount || 0);
                return scoreB - scoreA;
              });
              let html = '';
              sortedSeries.slice(0, 10).forEach((movie, index) => {
                html += `
                  <div class="flex-shrink-0 w-44 md:w-52 relative pl-10 snap-center group">
