<script define:vars={{ heroMoviesForClient: heroMovies }}>
  window.heroMoviesForClient = heroMoviesForClient;

  // Helper function to create movie list items with Netflix-style popover cards
  function createMovieListItemHTML(movieData, index, type) {
    const trendColor = index < 3 ? 'emerald' : 'zinc';
    const trendIcon = index === 0 ? 'trending_up' : index === 2 ? 'trending_up' : index === 3 ? 'trending_down' : 'remove';
    
