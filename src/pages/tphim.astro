---
import MainLayout from '../layouts/MainLayout.astro';
import { Button } from '../components/ui/Button';
import Card from '../components/ui/Card.astro';
import TopicCard from '../components/ui/TopicCard.astro';
import { topics } from '../data/topics';
import { MovieService } from '../services/MovieService';
import Txaicon from '../components/ui/txaicon.astro';

const topSeries = await MovieService.getMovies({ type: 'series', sortBy: 'views_comments', limit: 10 });

// Fetch dynamic categories from Local database
const allKorean = await MovieService.getMovies({ category: 'Hàn Quốc' });
const koreanMovies = allKorean.slice(0, 4).map((m: any) => ({
  title: m.title,
  slug: m.slug,
  poster: m.posterUrl,
  quality: m.quality,
  aspect: "aspect-video"
}));

const allChinese = await MovieService.getMovies({ category: 'Trung Quốc' });
const chineseMovies = allChinese.slice(0, 3).map((m: any) => ({
  title: m.title,
  slug: m.slug,
  poster: m.posterUrl,
  aspect: "aspect-video"
}));

const allWestern = await MovieService.getMovies({ category: 'Âu Mỹ' });
const westernMovies = allWestern.slice(0, 3).map((m: any, idx: number) => ({
  title: m.title,
  slug: m.slug,
  poster: m.posterUrl,
  quality: m.quality,
  duration: m.durationMinutes,
  isPremium: (m.imdbScore || 0) >= 9.0,
  description: m.description,
  rating: m.imdbScore ? String(m.imdbScore) : undefined,
  season: m.seasons,
  isHiddenLg: idx === 2
}));

const allRanking = await MovieService.getMovies({ sortBy: 'views_comments', limit: 4 });
const rankingMovies = allRanking.map((m: any, idx: number) => ({
  title: m.title,
  description: m.type === 'movie' ? 'Phim Lẻ Cực HOT' : `Cập nhật tập ${m.episodeCurrent}`,
  trend: idx === 0 ? "up" : idx === 2 ? "flat" : "up",
  slug: m.slug
}));

const comments = [
  { name: "Hoàng Nam", initial: "H", time: "2 phút trước", color: "primary", content: "Tập mới của Bài Học Đáng Đời đỉnh thực sự, twist không ngờ tới luôn. Phim đáng xem nhất năm nay!" },
  { name: "Anh Thư", initial: "A", time: "15 phút trước", color: "secondary", content: "Vừa cày xong Hyeri Yêu Dấu, phim nhẹ nhàng nhưng sâu sắc. Chất lượng 4K trên DongMePhim quá mượt." },
  { name: "Khánh Linh", initial: "K", time: "40 phút trước", color: "primary", content: "Cho mình hỏi lịch chiếu One Piece tiếp theo là bao giờ vậy ạ? Đang hóng quá trời hóng luôn." },
  { name: "Tuấn Trần", initial: "T", time: "1 giờ trước", color: "secondary", content: "Mấy bộ phim lẻ Trung Quốc gần đây toàn hàng cực phẩm, kỹ xảo điện ảnh đỉnh cao, xem mà sướng mắt." }
];
const allMoviesForClient = await MovieService.getMovies();
---

<MainLayout isHome={true}>
  <!-- Hero Banner -->
  <section id="hero-banner" class="relative h-[85vh] w-full overflow-hidden">
    <!-- Image layers for cross-fade transition -->
    <div id="hero-bg-1" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-100" style="background-image: url('https://lh3.googleusercontent.com/aida/AP1WRLs0cwmsQtUMxz8S1kYIBe2vdzk9wlKrAYAA0SaImKjlJwYFoNlbX5Ezes6Vk4D5W-ucCQ2T9RmBKbr_ZMBabRA9Ttc6dmERubqhLsdx1wunz3brbgXi5rroXOR2ruzik_0pwCF5YxH6Uvl1XXNB5hThMgn1BnmAaijvACGEDvmqkuTyiOamRT4EaIM9cR5bB6VIsLFANxSFbHoSZwiBE2ropgLTIEGcBH_t4b9HchPMwtxA3L-vMixjNaq2')"></div>
    <div id="hero-bg-2" class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0B] via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0B] via-[#0A0A0B]/50 to-transparent hidden md:block"></div>
    
    <!-- Left & Right Arrow controls (Desktop only, hidden md:flex) -->
    <button id="hero-slide-left" class="absolute left-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full border border-white/10 bg-black/40 backdrop-blur-md text-white flex items-center justify-center hover:bg-primary/20 hover:border-primary transition-all duration-300 opacity-0 pointer-events-none hidden md:flex cursor-pointer shadow-lg" title="Phim trước">
      <span class="material-symbols-outlined text-2xl font-bold">chevron_left</span>
    </button>
    <button id="hero-slide-right" class="absolute right-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full border border-white/10 bg-black/40 backdrop-blur-md text-white flex items-center justify-center hover:bg-primary/20 hover:border-primary transition-all duration-300 opacity-0 pointer-events-none hidden md:flex cursor-pointer shadow-lg" title="Phim tiếp theo">
      <span class="material-symbols-outlined text-2xl font-bold">chevron_right</span>
    </button>

    <div class="relative h-full flex items-center max-w-container-max mx-auto px-gutter pt-20">
      <div id="hero-content" class="max-w-2xl space-y-6 transition-all duration-500 transform translate-y-0 opacity-100">
        <div class="flex items-center gap-3">
          <span id="hero-imdb" class="bg-primary/20 text-primary font-label-caps text-label-caps px-2 py-1 rounded shadow-sm backdrop-blur-md">10.0 IMDB</span>
          <span id="hero-year" class="bg-white/10 text-white font-label-caps text-label-caps px-2 py-1 rounded shadow-sm backdrop-blur-md">2024</span>
          <span id="hero-type" class="bg-white/10 text-white font-label-caps text-label-caps px-2 py-1 rounded shadow-sm backdrop-blur-md">Phim Bộ</span>
        </div>
        <h1 id="hero-title" class="font-display-hero text-display-hero md:text-[64px] font-extrabold leading-tight text-white drop-shadow-lg line-clamp-2">
            Bài Học Đáng Đời
        </h1>
        <p id="hero-desc" class="text-on-surface-variant text-lg md:text-xl line-clamp-3 leading-relaxed">
            Khi kỷ cương trong trường học sụp đổ, những thành trì đạo moral cuối cùng dần mất đi sự tôn nghiêm. Một câu chuyện gai góc về giáo dục, sự trừng phạt và những giá trị nhân bản bị lãng quên.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a id="hero-play-link" href="/phim/bai-hoc-dang-doi" class="cursor-pointer">
            <Button variant="premium" size="lg" className="rounded-xl px-8 py-4 gap-2 text-white font-title-md">
              <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
              Xem Phim
            </Button>
          </a>
          <Button id="hero-playlist-btn" variant="secondary" size="lg" className="rounded-xl px-8 py-4 gap-2 font-title-md cursor-pointer relative group">
            <span id="hero-playlist-icon-add" class="flex items-center justify-center">
              <Txaicon name="playlist-add" class="w-5 h-5" />
            </span>
            <span id="hero-playlist-icon-added" class="flex items-center justify-center hidden">
              <Txaicon name="playlist-added" class="w-5 h-5" />
            </span>
            <span id="hero-playlist-text">Danh sách</span>
            <div class="txatooltip absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap pointer-events-none text-[10px]">Thêm vào DS phát</div>
          </Button>
        </div>
      </div>
    </div>

    <!-- Carousel Indicators (Desktop Only) -->
    <div id="hero-indicators" class="absolute bottom-8 right-8 z-30 flex items-center gap-3 hidden md:flex"></div>
  </section>

  <!-- Content Categories (Mini Bento) -> Upgraded to Topics Grid -->
  <section class="px-gutter -mt-16 relative z-10 max-w-container-max mx-auto space-y-4">
    <h3 class="font-headline-lg text-lg text-white font-bold tracking-tight px-1 drop-shadow-md">Bạn đang quan tâm gì?</h3>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {topics.slice(0, 5).map((topic) => (
        <TopicCard
          name={topic.name}
          slug={topic.slug}
          gradient={topic.gradient}
          icon={topic.icon}
          labelText="Khám phá ngay"
          description={topic.description}
        />
      ))}
      <TopicCard
        name={`+${topics.length - 5} chủ đề`}
        slug="/chu-de"
        gradient="from-zinc-800 via-zinc-900 to-zinc-950"
        icon="apps"
        labelText="Xem tất cả"
        description="Khám phá tất cả danh mục phim thú vị khác."
      />
    </div>
  </section>

  <main class="max-w-container-max mx-auto px-gutter py-section-gap space-y-section-gap">
    <!-- Phim Hàn Quốc Mới -->
    <section>
      <div class="flex justify-between items-end mb-6">
        <div>
          <h2 class="font-headline-lg text-headline-lg text-primary flex items-center gap-2">
            Phim Hàn Quốc Mới
            <span class="material-symbols-outlined">trending_up</span>
          </h2>
          <p class="text-on-surface-variant font-body-main mt-1">Cập nhật xu hướng điện ảnh xứ kim chi</p>
        </div>
        <a class="text-primary font-label-caps tracking-wider hover:underline hover:text-white transition-colors" href="#">Xem tất cả</a>
      </div>
      <div id="korean-grid" class="grid grid-cols-2 md:grid-cols-4 gap-gutter">
        {koreanMovies.map((movie: any) => (
          <Card 
            title={movie.title}
            slug={movie.slug}
            poster={movie.poster}
            quality={movie.quality}
            aspect={movie.aspect}
          />
        ))}
      </div>
    </section>

    <!-- Top 10 phim bộ hôm nay -->
    <section>
      <div class="flex justify-between items-end mb-6">
        <div>
          <h2 class="font-headline-lg text-headline-lg text-primary flex items-center gap-2">
            Top 10 Phim Bộ Hôm Nay
            <span class="material-symbols-outlined text-transparent bg-clip-text bg-gradient-to-tr from-primary to-secondary" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
          </h2>
          <p class="text-on-surface-variant font-body-main mt-1 text-sm">Các bộ phim bộ đang được thảo luận và xem nhiều nhất</p>
        </div>
      </div>
      
      <!-- Horizontal Scroll Container with clipping protection -->
      <div id="top-series-scroll" class="flex gap-6 overflow-x-auto pb-20 pt-20 -my-16 scrollbar-thin scrollbar-thumb-white/10 scrollbar-track-transparent snap-x">
        {topSeries.map((movie: any, index: number) => (
          <div class="flex-shrink-0 w-44 md:w-52 relative pl-10 snap-center group">
            <!-- Large Rank Number -->
            <div class="absolute bottom-0 left-0 text-[120px] md:text-[140px] font-black leading-none select-none pointer-events-none text-transparent bg-clip-text bg-gradient-to-tr from-primary/80 via-primary/20 to-transparent z-0 font-display-hero transform translate-y-6">
              {index + 1}
            </div>
            
            <Card 
              title={movie.title}
              slug={movie.slug}
              poster={movie.posterUrl}
              year={movie.releaseYear}
              quality={movie.quality}
              status={movie.status === 'completed' ? 'Hoàn thành' : 'Đang chiếu'}
              aspect="aspect-[3/4]"
              class="z-10 relative"
            />
          </div>
        ))}
      </div>
    </section>

    <!-- Phim Trung Quốc Mới -->
    <section>
      <div class="flex justify-between items-end mb-6">
        <div>
          <h2 class="font-headline-lg text-headline-lg text-secondary flex items-center gap-2">
            Phim Trung Quốc Mới
            <span class="material-symbols-outlined">stars</span>
          </h2>
          <p class="text-on-surface-variant font-body-main mt-1">Những tuyệt phẩm cổ trang và hiện đại</p>
        </div>
        <a class="text-secondary font-label-caps tracking-wider hover:underline hover:text-white transition-colors" href="#">Xem tất cả</a>
      </div>
      <div id="chinese-grid" class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        {chineseMovies.map((movie: any) => (
          <Card 
            title={movie.title}
            slug={movie.slug}
            poster={movie.poster}
            aspect={movie.aspect}
          />
        ))}
      </div>
    </section>


    <!-- Upgraded Bento Section: Top Comments Carousel & Three-Column Grid (Image 2 style) -->
    <section class="glass-card bg-[#141416]/50 border border-glass-stroke rounded-3xl p-6 md:p-8 space-y-8 shadow-2xl relative overflow-hidden">
      <!-- Glow backgrounds -->
      <div class="absolute -left-20 -top-20 w-80 h-80 bg-primary/5 blur-[120px] rounded-full"></div>
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-secondary/5 blur-[120px] rounded-full"></div>

      <!-- TOP BÌNH LUẬN Header -->
      <div class="flex items-center justify-between relative z-10 border-b border-glass-stroke pb-4">
        <h3 class="font-headline-lg text-lg text-primary flex items-center gap-2">
          <span class="material-symbols-outlined text-amber-400">forum</span>
          <span class="uppercase tracking-wider">Top Bình Luận</span>
        </h3>
        <!-- Carousel navigation arrows -->
        <div class="flex items-center gap-2">
          <button id="slide-left" class="w-8 h-8 rounded-full border border-glass-stroke flex items-center justify-center text-zinc-400 hover:text-white hover:border-zinc-500 transition-colors cursor-pointer bg-black/20" title="Slide Trái">
            <span class="material-symbols-outlined text-sm font-bold">chevron_left</span>
