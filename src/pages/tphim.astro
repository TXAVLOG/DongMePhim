      // Helper function to create movie cards dynamically
      function createMovieCardHTML(movie, aspect = "aspect-[2/3]") {
        const title = movie.title || '';
        const slug = movie.slug || '';
        const poster = movie.posterUrl || movie.poster || '';
        const quality = movie.quality || 'FHD';
        const lang = movie.lang || 'Vietsub';
        const originalTitle = movie.originalTitle || movie.origin_name || '';
        const year = movie.releaseYear || '';
        const status = movie.status === 'completed' ? 'Hoàn thành' : 'Đang chiếu';
        
        let typeBadgeHTML = '';
        if (movie.type === 'series' && movie.episodeCurrent) {
          let cur = (movie.episodeCurrent || '1').trim().replace(/^[tT]ập\s+/, '');
          if (cur.toLowerCase() === 'full' || cur.toLowerCase() === 'hoàn thành') {
            cur = 'Full';
          } else if (movie.episodeTotal) {
            let tot = movie.episodeTotal.trim().replace(/^[tT]ập\s+/, '');
            cur = `Tập ${cur}/${tot}`;
          } else {
            cur = `Tập ${cur}`;
          }
          typeBadgeHTML = `
            <div class="absolute top-2 left-2 z-20">
              <span class="bg-black/60 text-white text-[9px] px-1.5 py-0.5 rounded backdrop-blur-sm border border-white/10 font-semibold shadow-sm">
                ${cur}
              </span>
            </div>
          `;
        }

        const getLangBadge = (lang) => {
          if (!lang) return 'P.Đề';
          const lower = lang.toLowerCase();
          if (lower.includes('thuyết minh') && (lower.includes('vietsub') || lower.includes('phụ đề'))) return 'P.Đề + T.Minh';
          if (lower.includes('thuyết minh') || lower.includes('t.minh') || lower.includes('tm')) return 'T.Minh';
          if (lower.includes('lồng tiếng') || lower.includes('lt')) return 'L.Tiếng';
          return 'P.Đề';
        };

        const genresHTML = Array.isArray(movie.genres) ? movie.genres.map(g => `<span>${g}</span>`).join('<span class="text-zinc-600">•</span>') : '';

        return `
          <div class="relative group w-full">
            <a href="/phim/${slug}" class="relative block w-full ${aspect} rounded-xl overflow-hidden glass-card border border-glass-stroke movie-card-hover transition-all duration-300 cursor-pointer">
              <img src="${poster}" alt="${title}" class="w-full h-full object-cover" loading="lazy" onerror="this.src='/favicon.png'" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-100 transition-opacity"></div>
              
              ${quality === '4K' ? `
                <div class="absolute top-2 right-2 z-20">
                  <span class="bg-amber-500 text-slate-950 text-[9px] px-1.5 py-0.5 rounded font-black shadow-sm tracking-wider">4K</span>
                </div>
              ` : ''}

