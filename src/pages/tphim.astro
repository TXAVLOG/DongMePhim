                      ${m.description ? `<p class="text-sm text-on-surface-variant line-clamp-1">${m.description}</p>` : `
                        <div class="flex gap-4 text-sm text-on-surface-variant">
                          <span class="flex items-center gap-1 font-label-caps"><span class="material-symbols-outlined text-sm">schedule</span> ${m.durationMinutes || '120 phút'}</span>
                          <span class="flex items-center gap-1 font-label-caps"><span class="material-symbols-outlined text-sm">star</span> ${(m.imdbScore || 8.0).toFixed(1)}</span>
                          <span class="flex items-center gap-1 font-label-caps"><span class="material-symbols-outlined text-sm">hd</span> ${m.quality || 'FHD'}</span>
                        </div>
