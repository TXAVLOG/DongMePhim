  // Helper to get progress badges for movies/series client-side
  function getProgressBadgesHTML(movie) {
    const isSeries = movie.type === 'series' || movie.type === 'hoathinh' || movie.type === 'tvshows';
    if (isSeries && movie.status === 'completed') {
      return `
        <span class="bg-emerald-950/90 text-emerald-400 border border-emerald-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase tracking-wide">
          Hoàn tất
        </span>
      `;
    }

    const episodes = movie.episodes || [];

    if (isSeries) {
      let pdEpisodes = 0;
      let tmEpisodes = 0;

      episodes.forEach((server) => {
        const name = (server.serverName || '').toLowerCase();
        const epCount = Array.isArray(server.serverData) ? server.serverData.length : 0;
        const isTm = name.includes('thuyết minh') || name.includes('thuyetminh') || name.includes('t.minh') || name.includes('tm') || name.includes('lồng tiếng') || name.includes('longtieng') || name.includes('l.tiếng') || name.includes('lt');
        if (isTm) {
          tmEpisodes = Math.max(tmEpisodes, epCount);
        } else {
          pdEpisodes = Math.max(pdEpisodes, epCount);
        }
      });

      if (pdEpisodes === 0 && tmEpisodes === 0) {
        const cur = (movie.episodeCurrent || '').trim().replace(/^[tT]ập\s+/, '');
        const curNum = parseInt(cur);
        if (!isNaN(curNum)) {
          const langLower = (movie.lang || '').toLowerCase();
          if (langLower.includes('thuyết minh') || langLower.includes('lồng tiếng')) {
            tmEpisodes = curNum;
          } else {
            pdEpisodes = curNum;
          }
        }
      }

      let html = '';
      if (pdEpisodes > 0) {
        html += `
          <span class="bg-sky-950/90 text-sky-400 border border-sky-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
            PĐ ${pdEpisodes}
          </span>
        `;
      }
      if (tmEpisodes > 0) {
        html += `
          <span class="bg-purple-950/90 text-purple-400 border border-purple-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
            TM ${tmEpisodes}
          </span>
        `;
      }
      if (pdEpisodes === 0 && tmEpisodes === 0) {
        html += `
          <span class="bg-zinc-950/90 text-zinc-400 border border-zinc-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
            Đang chiếu
          </span>
        `;
      }
      return html;
    } else {
      let hasPd = false;
      let hasTm = false;

      episodes.forEach((server) => {
        const name = (server.serverName || '').toLowerCase();
        const isTm = name.includes('thuyết minh') || name.includes('thuyetminh') || name.includes('t.minh') || name.includes('tm') || name.includes('lồng tiếng') || name.includes('longtieng') || name.includes('l.tiếng') || name.includes('lt');
        if (isTm) {
          hasTm = true;
        } else {
          hasPd = true;
        }
      });

      if (!hasPd && !hasTm) {
        const langLower = (movie.lang || '').toLowerCase();
        if (langLower.includes('thuyết minh') && (langLower.includes('vietsub') || langLower.includes('phụ đề'))) {
          hasPd = true;
          hasTm = true;
        } else if (langLower.includes('thuyết minh') || langLower.includes('lồng tiếng')) {
          hasTm = true;
        } else {
          hasPd = true;
        }
      }

      let html = '';
      if (hasPd) {
        html += `
          <span class="bg-sky-950/90 text-sky-400 border border-sky-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
            Vietsub
          </span>
        `;
      }
      if (hasTm) {
        html += `
          <span class="bg-purple-950/90 text-purple-400 border border-purple-500/30 text-[10px] font-black px-2.5 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
            TM
          </span>
        `;
      }
      return html;
    }
  }

