<!-- Script blocks -->
<script define:vars={{ heroMoviesForClient: heroMovies }}>
  // Helper function to create movie list items with Netflix-style popover cards
  function createMovieListItemHTML(movieData, index, type) {
    const trendColor = index < 3 ? 'emerald' : 'zinc';
    const trendIcon = index === 0 ? 'trending_up' : index === 2 ? 'trending_up' : index === 3 ? 'trending_down' : 'remove';
    
    const originalTitle = movieData.originalTitle || '';
    const imdbScore = movieData.imdbScore ? movieData.imdbScore.toFixed(1) : '8.0';
    const ageRating = movieData.ageRating || 'T13';
    const releaseYear = movieData.releaseYear || 2024;
    const seasons = movieData.seasons || 'Phần 1';
    const quality = movieData.quality || 'FHD';
    const lang = movieData.lang || 'Vietsub';
    const genres = movieData.genres || [];
    
    const genresHTML = genres.map(g => `<span>${g}</span>`).join('<span class="text-zinc-600">•</span>');
    
    return `
      <a href="/phim/${movieData.slug}" class="relative group flex items-center gap-3.5 p-2 rounded-xl hover:bg-white/5 transition-all cursor-pointer w-full">
        <span class="text-sm font-black text-zinc-600 group-hover:text-primary transition-colors w-4 font-outfit">${index + 1}.</span>
        <span class="material-symbols-outlined text-${trendColor}-400 text-sm font-bold w-4">${trendIcon}</span>
        <div class="w-8 h-10 rounded overflow-hidden border border-glass-stroke bg-zinc-900 shrink-0 shadow-md">
          <img src="${movieData.posterUrl || '/favicon.png'}" class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
        </div>
        <span class="text-xs font-bold text-zinc-300 group-hover:text-white transition-colors line-clamp-1 flex-1 font-outfit">${movieData.title}</span>
        
        <!-- Netflix-style Popover Card (visible on hover) -->
        <div class="pointer-events-none absolute left-1/2 top-1/2 z-50 w-[300px] -translate-x-1/2 -translate-y-1/2 scale-75 rounded-2xl border border-glass-stroke bg-[#141416]/95 backdrop-blur-md opacity-0 shadow-[0_0_40px_rgba(109,40,217,0.3),_0_20px_50px_rgba(0,0,0,0.85)] transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:pointer-events-auto group-hover:scale-100 group-hover:opacity-100 group-hover:visible group-hover:delay-[600ms] hidden lg:block overflow-hidden">
          <div class="relative w-full aspect-video bg-black/40">
            <img src="${movieData.bannerUrl || movieData.posterUrl || '/favicon.png'}" alt="${movieData.title}" class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#141416] via-[#141416]/20 to-transparent"></div>
            <div class="absolute top-3 left-3 flex gap-1">
              <span class="bg-primary text-on-primary text-[9px] px-1.5 py-0.5 rounded font-bold shadow-sm">${quality}</span>
              <span class="bg-white/10 text-white text-[9px] px-1.5 py-0.5 rounded shadow-sm backdrop-blur-md">${lang}</span>
            </div>
          </div>
          <div class="p-4 space-y-3.5 text-left whitespace-normal">
            <div>
              <h4 class="font-bold text-white text-base leading-tight font-outfit line-clamp-1">${movieData.title}</h4>
              ${originalTitle ? `<p class="text-primary text-[11px] font-semibold mt-0.5 font-outfit line-clamp-1">${originalTitle}</p>` : ''}
            </div>
            <div class="flex items-center gap-2">
              <span class="flex-1 flex items-center justify-center gap-1.5 py-2 px-3 bg-primary hover:bg-primary/90 text-on-primary rounded-xl text-xs font-bold transition-all shadow-[0_4px_12px_rgba(124,58,237,0.25)] cursor-pointer">
                <span class="material-symbols-outlined text-sm font-bold" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                Xem ngay
              </span>
              <span class="w-8 h-8 rounded-xl border border-glass-stroke flex items-center justify-center text-white hover:bg-white/5 transition-all cursor-pointer" data-txatooltip="Chi tiết">
                <span class="material-symbols-outlined text-sm">info</span>
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-[10px] text-zinc-300 font-semibold font-outfit pt-1">
              <span class="border border-primary text-primary px-1.5 py-0.5 rounded text-[9px] font-bold">IMDb ${imdbScore}</span>
              <span class="border border-zinc-500 text-zinc-300 px-1.5 py-0.5 rounded text-[9px] font-bold">${ageRating}</span>
              <span>${releaseYear}</span>
              <span>${seasons}</span>
            </div>
            ${genresHTML ? `<div class="text-[10px] text-zinc-400 font-medium border-t border-glass-stroke pt-2 flex flex-wrap gap-x-1.5 gap-y-0.5">${genresHTML}</div>` : ''}
          </div>
        </div>
      </a>
    `;
  }

  const getPlanByPackageNameOrId = (pkgNameOrId) => {
    const settings = window.TXA_SITE_SETTINGS || {};
    const packages = settings.packages || [];
    const normalized = (pkgNameOrId || 'free').toLowerCase().trim();
    let plan = packages.find(p => p.id.toLowerCase() === normalized);
    if (plan) return plan;
    plan = packages.find(p => p.title.toLowerCase() === normalized);
    if (plan) return plan;
    if (normalized === 'free' || normalized === 'gói free') {
      return { id: 'free', title: 'Gói Free' };
    }
    return { id: 'free', title: pkgNameOrId || 'Gói Free' };
  };

  // Helper function to create carousel comment cards
  function createCarouselCommentCardHTML(comment) {
    const initial = (comment.author || 'T').substring(0, 2).toUpperCase();
    let roleBadge = 'Thành viên';
    let badgeColor = 'emerald-500';
    let adminTag = '';
    
    const lowerAuthor = (comment.author || '').toLowerCase();
    const isMod = lowerAuthor.includes('cô 3 rổ') || lowerAuthor.includes('admin') || lowerAuthor.includes('hoài lê') || lowerAuthor.includes('mod') || lowerAuthor.includes('ad');
    if (isMod) {
      roleBadge = 'Người kiểm duyệt';
      badgeColor = 'pink-500';
      adminTag = `<span class="bg-pink-500/20 text-pink-400 border border-pink-500/30 rounded px-1 py-0.2 text-[8px] font-bold tracking-widest uppercase mr-1">Admin</span>`;
    } else if (lowerAuthor.includes('nam') || lowerAuthor.includes('thư') || lowerAuthor.includes('linh') || lowerAuthor.includes('tiểu')) {
      badgeColor = 'amber-500';
    } else if (lowerAuthor.charCodeAt(0) % 2 === 0) {
      badgeColor = 'indigo-500';
    } else {
      badgeColor = 'teal-500';
    }

    const plan = getPlanByPackageNameOrId(comment.package);
    const pkgId = plan.id;
    const pkgTitle = plan.title;

    const views = comment.views !== undefined ? comment.views : Math.floor(Math.random() * 150) + 10;

    let authorTag = '';
    const userGender = comment.gender || 'other';
    if (userGender === 'male') {
      authorTag = `<span class="text-blue-400 font-bold ml-1 text-[10px]" title="Nam">♂</span>`;
    } else if (userGender === 'female') {
      authorTag = `<span class="text-rose-400 font-bold ml-1 text-[10px]" title="Nữ">♀</span>`;
    } else {
      authorTag = `<span class="text-primary font-bold ml-1 text-xs" title="Khác">∞</span>`;
    }

    return `
      <div class="flex-shrink-0 w-[280px] bg-zinc-950/40 border border-glass-stroke/60 rounded-2xl p-4 flex flex-col justify-between hover:border-primary/30 hover:bg-zinc-950/60 transition-all duration-300 snap-center">
        <div class="flex justify-between items-start gap-3">
          <div class="flex items-center gap-2">
            <div class="w-9 h-9 rounded-full bg-${badgeColor} flex items-center justify-center text-white font-bold text-xs">
              ${initial}
            </div>
            <div>
              <div class="flex items-center gap-1.5 flex-wrap">
                ${adminTag}
                <span class="text-xs font-bold ${isMod ? 'text-white' : `package-style-${pkgId}`}">${comment.author}</span>
                ${!isMod ? `<span class="text-[8px] font-bold px-1.5 py-0.2 rounded bg-white/5 border border-glass-stroke/50 package-style-${pkgId}">${pkgTitle}</span>` : ''}
                ${authorTag}
              </div>
              <span class="text-[9px] text-zinc-500">${roleBadge}</span>
            </div>
          </div>
          <a href="/phim/${comment.movieSlug}" class="w-10 h-14 rounded-lg overflow-hidden border border-glass-stroke shrink-0 block hover:scale-105 transition-transform bg-zinc-900 shadow-md">
            <img src="${comment.moviePoster || '/favicon.png'}" class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
          </a>
        </div>
        <p class="text-xs text-zinc-300 italic line-clamp-3 mt-3 font-body-main">"${comment.content}"</p>
        <div class="flex items-center gap-4 mt-4 pt-3 border-t border-glass-stroke/30 text-[10px] text-zinc-500 font-outfit">
          <span class="flex items-center gap-1 cursor-pointer hover:text-white transition-colors"><span class="material-symbols-outlined text-[14px]">thumb_up</span> ${comment.likes || 0}</span>
          <span class="flex items-center gap-1 cursor-pointer hover:text-white transition-colors"><span class="material-symbols-outlined text-[14px]">thumb_down</span> 0</span>
          <span class="flex items-center gap-1 cursor-pointer hover:text-white transition-colors"><span class="material-symbols-outlined text-[14px]">chat_bubble</span> ${comment.replies ? comment.replies.length : 0}</span>
        </div>
      </div>
    `;
  }

  // Helper function to create sidebar comment rows
  function createSidebarCommentRowHTML(comment) {
    const initial = (comment.author || 'T').substring(0, 1).toUpperCase();
    let roleBadge = '';
    let badgeColor = 'zinc-700';
    
    const lowerAuthor = (comment.author || '').toLowerCase();
    const isMod = lowerAuthor.includes('cô 3 rổ') || lowerAuthor.includes('admin') || lowerAuthor.includes('hoài lê') || lowerAuthor.includes('mod') || lowerAuthor.includes('ad');
    if (isMod) {
      roleBadge = `<span class="text-[10px] text-primary" data-txatooltip="ADMIN">👑</span>`;
      badgeColor = 'pink-500';
    } else if (lowerAuthor.includes('nam') || lowerAuthor.includes('thư') || lowerAuthor.includes('linh') || lowerAuthor.includes('tiểu')) {
      badgeColor = 'amber-500';
    } else if (lowerAuthor.charCodeAt(0) % 2 === 0) {
      badgeColor = 'indigo-500';
    } else {
      badgeColor = 'teal-500';
    }

    const plan = getPlanByPackageNameOrId(comment.package);
    const pkgId = plan.id;
    const pkgTitle = plan.title;

    return `
      <div class="p-3 bg-zinc-950/30 border border-glass-stroke/40 rounded-xl space-y-1 hover:border-primary/20 hover:bg-zinc-950/60 transition-all duration-300">
        <div class="flex items-center gap-2 flex-wrap">
          <div class="w-5 h-5 rounded-full bg-${badgeColor} text-white font-bold text-[9px] flex items-center justify-center font-outfit">${initial}</div>
          <span class="text-xs font-bold ${isMod ? 'text-zinc-300' : `package-style-${pkgId}`}">${comment.author}</span>
          ${!isMod ? `<span class="text-[7px] font-bold px-1.2 py-0.2 rounded bg-white/5 border border-glass-stroke/50 package-style-${pkgId}">${pkgTitle}</span>` : ''}
          ${roleBadge}
        </div>
        <p class="text-xs text-zinc-400 italic line-clamp-1 font-body-main">"${comment.content}"</p>
        <a href="/phim/${comment.movieSlug}" class="text-[9px] text-primary hover:underline flex items-center gap-1 pt-0.5 font-outfit">
          <span class="material-symbols-outlined text-[10px]">play_circle</span> ${comment.movieTitle}
        </a>
      </div>
    `;
  }

  // Helper function to create movie cards dynamically
  function createMovieCardHTML(movie, aspect = "aspect-[2/3]") {
    const title = movie.title || '';
    const slug = movie.slug || '';
    const poster = movie.posterUrl || movie.poster || '';
    const quality = movie.quality || 'FHD';
    const lang = movie.lang || 'Vietsub';
    const originalTitle = movie.originalTitle || movie.origin_name || '';
    const year = movie.releaseYear || '';
    const status = movie.status === 'completed' ? 'Hoàn thành' : 'Đang chiếu';
    
    const getProgressBadgesHTML = () => {
      const isSeries = movie.type === 'series' || movie.type === 'hoathinh' || movie.type === 'tvshows';
      if (isSeries && movie.status === 'completed') {
        return `
          <span class="bg-emerald-950/90 text-emerald-400 border border-emerald-500/30 text-[8px] font-black px-2 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase tracking-wide">
            Hoàn tất
          </span>
        `;
      }

      const episodes = movie.episodes || [];

      if (isSeries) {
        let pdEpisodes = 0;
        let tmEpisodes = 0;

        episodes.forEach((server) => {
          const name = (server.serverName || '').toLowerCase();
          const epCount = Array.isArray(server.serverData) ? server.serverData.length : 0;
          const isTm = name.includes('thuyết minh') || name.includes('thuyetminh') || name.includes('t.minh') || name.includes('tm') || name.includes('lồng tiếng') || name.includes('longtieng') || name.includes('l.tiếng') || name.includes('lt');
          if (isTm) {
            tmEpisodes = Math.max(tmEpisodes, epCount);
          } else {
            pdEpisodes = Math.max(pdEpisodes, epCount);
          }
        });

        if (pdEpisodes === 0 && tmEpisodes === 0) {
          const cur = (movie.episodeCurrent || '').trim().replace(/^[tT]ập\s+/, '');
          const curNum = parseInt(cur);
          if (!isNaN(curNum)) {
            const langLower = (movie.lang || '').toLowerCase();
            if (langLower.includes('thuyết minh') || langLower.includes('lồng tiếng')) {
              tmEpisodes = curNum;
            } else {
              pdEpisodes = curNum;
            }
          }
        }

        let html = '';
        if (pdEpisodes > 0) {
          html += `
            <span class="bg-sky-950/90 text-sky-400 border border-sky-500/30 text-[8px] font-black px-2 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
              PĐ ${pdEpisodes}
            </span>
          `;
        }
        if (tmEpisodes > 0) {
          html += `
            <span class="bg-purple-950/90 text-purple-400 border border-purple-500/30 text-[8px] font-black px-2 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
              TM ${tmEpisodes}
            </span>
          `;
        }
        if (pdEpisodes === 0 && tmEpisodes === 0) {
          html += `
            <span class="bg-zinc-950/90 text-zinc-400 border border-zinc-500/30 text-[8px] font-black px-2 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
              Đang chiếu
            </span>
          `;
        }
        return html;
      } else {
        let hasPd = false;
        let hasTm = false;

        episodes.forEach((server) => {
          const name = (server.serverName || '').toLowerCase();
          const isTm = name.includes('thuyết minh') || name.includes('thuyetminh') || name.includes('t.minh') || name.includes('tm') || name.includes('lồng tiếng') || name.includes('longtieng') || name.includes('l.tiếng') || name.includes('lt');
          if (isTm) {
            hasTm = true;
          } else {
            hasPd = true;
          }
        });

        if (!hasPd && !hasTm) {
          const langLower = (movie.lang || '').toLowerCase();
          if (langLower.includes('thuyết minh') && (langLower.includes('vietsub') || langLower.includes('phụ đề'))) {
            hasPd = true;
            hasTm = true;
          } else if (langLower.includes('thuyết minh') || langLower.includes('lồng tiếng')) {
            hasTm = true;
          } else {
            hasPd = true;
          }
        }

        let html = '';
        if (hasPd) {
          html += `
            <span class="bg-sky-950/90 text-sky-400 border border-sky-500/30 text-[8px] font-black px-2 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
              Vietsub
            </span>
          `;
        }
        if (hasTm) {
          html += `
            <span class="bg-purple-950/90 text-purple-400 border border-purple-500/30 text-[8px] font-black px-2 py-0.5 rounded shadow-sm backdrop-blur-sm whitespace-nowrap font-outfit uppercase">
              TM
            </span>
          `;
        }
        return html;
      }
    };

    const genresHTML = Array.isArray(movie.genres) ? movie.genres.map(g => `<span>${g}</span>`).join('<span class="text-zinc-600">•</span>') : '';

    return `
      <div class="relative group w-full">
        <a href="/phim/${slug}" class="relative block w-full ${aspect} rounded-xl overflow-hidden glass-card border border-glass-stroke movie-card-hover transition-all duration-300 cursor-pointer">
          <img src="${poster}" alt="${title}" class="w-full h-full object-cover" loading="lazy" onerror="this.src='/favicon.png'" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-100 transition-opacity"></div>
          
          ${quality === '4K' ? `
            <div class="absolute top-2 right-2 z-20">
              <span class="bg-amber-500 text-slate-950 text-[9px] px-1.5 py-0.5 rounded font-black shadow-sm tracking-wider font-outfit">4K</span>
            </div>
          ` : ''}
          
          <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-all duration-300 group-hover:opacity-100 bg-black/20">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/95 text-on-primary backdrop-blur-md transform scale-50 transition-transform duration-300 group-hover:scale-100 shadow-xl shadow-primary/20">
              <span class="material-symbols-outlined ml-0.5 text-xl" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
            </div>
          </div>
          
          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 z-20 flex gap-1 items-center justify-center">
            ${getProgressBadgesHTML()}
          </div>
        </a>

        <div class="mt-2.5 px-1 space-y-0.5 text-center">
          <h3 class="font-bold text-xs text-white line-clamp-1 group-hover:text-primary transition-colors font-outfit" data-txatooltip="${title}">
            ${title}
          </h3>
          <p class="text-[9px] text-zinc-500 truncate font-medium font-outfit" data-txatooltip="${originalTitle}">
            ${originalTitle || title}
          </p>
        </div>

        <!-- Hover Popover details card (Netflix style, desktop only) -->
        <div class="pointer-events-none absolute left-1/2 top-1/2 z-50 w-[300px] -translate-x-1/2 -translate-y-1/2 scale-75 rounded-2xl border border-glass-stroke bg-[#141416]/95 backdrop-blur-md opacity-0 shadow-[0_0_40px_rgba(109,40,217,0.3),_0_20px_50px_rgba(0,0,0,0.85)] transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:pointer-events-auto group-hover:scale-100 group-hover:opacity-100 group-hover:visible group-hover:delay-[600ms] hidden lg:block overflow-hidden">
          <div class="relative w-full aspect-video bg-black/40">
            <img src="${movie.bannerUrl || poster}" alt="${title}" class="w-full h-full object-cover" onerror="this.src='/favicon.png'" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#141416] via-[#141416]/20 to-transparent"></div>
            <div class="absolute top-3 left-3 flex gap-1">
              <span class="bg-primary text-on-primary text-[9px] px-1.5 py-0.5 rounded font-bold shadow-sm">${quality}</span>
              <span class="bg-white/10 text-white text-[9px] px-1.5 py-0.5 rounded shadow-sm backdrop-blur-md">${getLangBadge(lang)}</span>
            </div>
          </div>
          <div class="p-4 space-y-3.5 text-left whitespace-normal">
            <div>
              <h4 class="font-bold text-white text-base leading-tight font-outfit line-clamp-1">${title}</h4>
              ${originalTitle ? `<p class="text-primary text-[11px] font-semibold mt-0.5 font-outfit line-clamp-1">${originalTitle}</p>` : ''}
            </div>
            <div class="flex items-center gap-2">
