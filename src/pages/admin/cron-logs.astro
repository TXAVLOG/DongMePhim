---
import AdminLayout from '@layouts/AdminLayout.astro';
import { supabase } from '@lib/supabase';

// Fetch latest 100 logs from public.txa_cron_logs
const { data: logs, error } = await supabase
  .from('txa_cron_logs')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(100);

const initialLogs = logs || [];

// Calculate simple stats
const totalRuns = initialLogs.length;
const successRuns = initialLogs.filter(l => l.status === 'success').length;
const errorRuns = totalRuns - successRuns;
const successRate = totalRuns > 0 ? Math.round((successRuns / totalRuns) * 100) : 100;
const avgDurationMs = totalRuns > 0 ? Math.round(initialLogs.reduce((acc, curr) => acc + (curr.duration_ms || 0), 0) / totalRuns) : 0;

function formatDuration(ms: number) {
  if (ms >= 1000) {
    return `${(ms / 1000).toFixed(1)} s`;
  }
  return `${ms} ms`;
}
---

<AdminLayout title="Nhật ký Cron tự động">
  <div class="space-y-6">
    
    <!-- Header Block -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 glass-panel p-6 rounded-2xl">
      <div>
        <h1 class="text-2xl font-black text-white flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-400 text-3xl">history_toggle_off</span>
          Nhật Ký Cron Tự Động (Cron Logs)
        </h1>
        <p class="text-xs text-zinc-400 mt-1">Theo dõi tiến trình đồng bộ phim và quét hạn tài khoản chạy ngầm trên Cloudflare Workers</p>
      </div>
      <button 
        type="button" 
        onclick="window.location.reload()"
        class="px-5 py-2.5 bg-white/5 border border-glass-stroke/40 hover:bg-white/10 text-white rounded-xl font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span class="material-symbols-outlined text-base">refresh</span>
        <span>Làm mới</span>
      </button>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">
      <div class="glass-panel p-5 rounded-2xl flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
          <span class="material-symbols-outlined text-2xl">sync_alt</span>
        </div>
        <div>
          <span class="text-[10px] text-zinc-400 font-bold uppercase tracking-wider block">Tổng số lần chạy</span>
          <span class="text-xl font-black text-white">{totalRuns} <span class="text-[10px] text-zinc-500 font-normal">lượt gần nhất</span></span>
        </div>
      </div>

      <div class="glass-panel p-5 rounded-2xl flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
          <span class="material-symbols-outlined text-2xl">check_circle</span>
        </div>
        <div>
          <span class="text-[10px] text-zinc-400 font-bold uppercase tracking-wider block">Tỷ lệ thành công</span>
          <span class="text-xl font-black text-emerald-400">{successRate}% <span class="text-[10px] text-zinc-500 font-normal">({successRuns}/{totalRuns})</span></span>
        </div>
      </div>

      <div class="glass-panel p-5 rounded-2xl flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400">
          <span class="material-symbols-outlined text-2xl">error</span>
        </div>
        <div>
          <span class="text-[10px] text-zinc-400 font-bold uppercase tracking-wider block">Số lượt lỗi</span>
          <span class="text-xl font-black text-red-400">{errorRuns} <span class="text-[10px] text-zinc-500 font-normal">lượt thất bại</span></span>
        </div>
      </div>

      <div class="glass-panel p-5 rounded-2xl flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
          <span class="material-symbols-outlined text-2xl">schedule</span>
        </div>
        <div>
          <span class="text-[10px] text-zinc-400 font-bold uppercase tracking-wider block">Thời gian chạy trung bình</span>
          <span class="text-xl font-black text-white">{formatDuration(avgDurationMs)}</span>
        </div>
      </div>
    </div>

    <!-- Manual Trigger Section -->
    <div class="glass-panel p-6 rounded-2xl space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-glass-stroke/40 pb-4">
        <div>
          <h2 class="text-base font-black text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-purple-400">play_circle</span>
            Kích Hoạt Tác Vụ Thủ Công (Manual Triggers)
          </h2>
          <p class="text-[10px] text-zinc-400 mt-0.5">Chủ động chạy ngay tiến trình đồng bộ hoặc quét hạn dùng không cần đợi theo lịch tự động.</p>
        </div>
        <button 
          type="button" 
          onclick="triggerCronJob('all')"
          id="btn-trigger-all"
          class="px-4 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 hover:brightness-110 active:scale-95 text-white rounded-xl font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer border-none shadow-[0_4px_12px_rgba(139,92,246,0.3)]"
        >
          <span class="material-symbols-outlined text-sm">run_circle</span>
          <span>Chạy tất cả tác vụ</span>
        </button>
      </div>

      <!-- Global Progress Container (initially hidden) -->
      <div id="global-progress-container" class="hidden glass-panel p-4 rounded-xl border border-purple-500/20 bg-purple-500/5 mb-4 space-y-2">
        <div class="flex items-center justify-between text-xs font-bold text-white">
          <span id="global-progress-status" class="flex items-center gap-1.5">
            <span class="animate-spin inline-block w-3.5 h-3.5 border-2 border-purple-400 border-t-transparent rounded-full"></span>
            <span>Đang chạy tuần tự tất cả tác vụ...</span>
          </span>
          <span id="global-progress-eta" class="text-purple-400">Tổng ETA: --s</span>
        </div>
        <div class="w-full h-2 bg-zinc-950 border border-zinc-800 rounded-full overflow-hidden">
          <div id="global-progress-bar" class="h-full bg-gradient-to-r from-purple-500 via-indigo-500 to-emerald-500 w-0 transition-all duration-300"></div>
        </div>
        <div class="flex justify-between text-[9px] text-zinc-500 font-bold font-mono">
          <span>Khởi đầu</span>
          <span id="global-progress-percentage">0%</span>
          <span>Hoàn tất</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1: Sync KKPhim -->
        <div class="glass-panel p-5 rounded-2xl flex flex-col justify-between border border-glass-stroke/30 hover:border-purple-500/30 transition-all bg-white/[0.01] hover:bg-white/[0.03]">
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
                <span class="material-symbols-outlined text-xl">sync</span>
              </div>
              <div>
                <span class="text-xs font-bold text-white block">Đồng bộ phim (sync-kkphim)</span>
                <span class="text-[9px] text-zinc-500 font-bold font-mono">Trực tiếp: 15-phút / lần + Hàng ngày 1:30 AM</span>
              </div>
            </div>
            <p class="text-[11px] text-zinc-400 leading-relaxed">
              Cập nhật tập phim mới và tiến độ phát sóng cho các phim đang cập nhật (`ongoing`) từ các API của đối tác.
            </p>
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 mt-2 pt-1">
              <div class="flex items-center gap-2">
                <span class="text-[10px] text-zinc-400 font-bold shrink-0">Giới hạn:</span>
                <select id="sync-limit-select" class="bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-1 text-[10px] text-white focus:outline-none font-bold">
                  <option value="20">20 phim (Mặc định)</option>
                  <option value="10">10 phim</option>
                  <option value="50">50 phim</option>
                  <option value="100">100 phim</option>
                  <option value="200">200 phim</option>
                  <option value="500">500 phim</option>
                </select>
              </div>
              <div class="flex items-center gap-1.5">
                <input type="checkbox" id="sync-resume-checkbox" checked class="w-3.5 h-3.5 accent-purple-500 rounded bg-zinc-950 border border-zinc-800 cursor-pointer" />
                <label for="sync-resume-checkbox" class="text-[10px] text-zinc-300 font-bold cursor-pointer select-none" data-txatooltip="Quét tiếp tục từ phim cuối cùng của lần chạy trước. Nếu tắt, sẽ quét lại từ đầu.">Quét tiếp tục</label>
              </div>
            </div>
          </div>
          <div class="pt-4 flex justify-between items-center gap-4">
            <div id="progress-container-sync-kkphim" class="hidden flex-1 flex items-center gap-3">
              <div class="flex-1 h-1.5 bg-zinc-950 border border-zinc-800 rounded-full overflow-hidden">
                <div id="progress-bar-sync-kkphim" class="h-full bg-gradient-to-r from-purple-500 to-indigo-500 w-0 transition-all duration-200"></div>
              </div>
              <span id="progress-text-sync-kkphim" class="text-[10px] text-zinc-300 font-bold shrink-0">0%</span>
              <span id="progress-eta-sync-kkphim" class="text-[10px] text-purple-400 font-bold shrink-0">ETA: --s</span>
            </div>
            <button 
              type="button" 
              onclick="triggerCronJob('sync-kkphim')"
              id="btn-trigger-sync-kkphim"
              class="px-3 py-1.5 bg-white/5 border border-glass-stroke/40 hover:bg-white/10 text-white rounded-xl font-bold text-[10px] transition-all flex items-center gap-1.5 cursor-pointer shrink-0"
            >
              <span class="material-symbols-outlined text-sm">play_arrow</span>
              <span>Chạy ngay</span>
            </button>
          </div>
        </div>

        <!-- Card 2: Crawl New Movies -->
        <div class="glass-panel p-5 rounded-2xl flex flex-col justify-between border border-glass-stroke/30 hover:border-emerald-500/30 transition-all bg-white/[0.01] hover:bg-white/[0.03]">
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                <span class="material-symbols-outlined text-xl">movie_filter</span>
              </div>
              <div>
                <span class="text-xs font-bold text-white block">Cào phim tự động (crawl-new-movies)</span>
                <span class="text-[9px] text-zinc-500 font-bold font-mono">Trực tiếp: Hằng ngày 7:00 AM + 1:30 AM</span>
              </div>
            </div>
            <p class="text-[11px] text-zinc-400 leading-relaxed">
              Quét danh sách mới cập nhật và cào tự động 10 phim mới nhất từ nguồn phim đối tác KKPhim & VSMOV vào hệ thống.
            </p>
          </div>
          <div class="pt-4 flex justify-between items-center gap-4">
            <div id="progress-container-crawl-new-movies" class="hidden flex-1 flex items-center gap-3">
              <div class="flex-1 h-1.5 bg-zinc-950 border border-zinc-800 rounded-full overflow-hidden">
                <div id="progress-bar-crawl-new-movies" class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 w-0 transition-all duration-200"></div>
              </div>
              <span id="progress-text-crawl-new-movies" class="text-[10px] text-zinc-300 font-bold shrink-0">0%</span>
              <span id="progress-eta-crawl-new-movies" class="text-[10px] text-emerald-400 font-bold shrink-0">ETA: --s</span>
            </div>
            <button 
              type="button" 
              onclick="triggerCronJob('crawl-new-movies')"
              id="btn-trigger-crawl-new-movies"
              class="px-3 py-1.5 bg-white/5 border border-glass-stroke/40 hover:bg-white/10 text-white rounded-xl font-bold text-[10px] transition-all flex items-center gap-1.5 cursor-pointer shrink-0"
            >
              <span class="material-symbols-outlined text-sm">play_arrow</span>
              <span>Chạy ngay</span>
            </button>
          </div>
        </div>

        <!-- Card 3: Membership Check -->
        <div class="glass-panel p-5 rounded-2xl flex flex-col justify-between border border-glass-stroke/30 hover:border-sky-500/30 transition-all bg-white/[0.01] hover:bg-white/[0.03]">
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400">
                <span class="material-symbols-outlined text-xl">badge</span>
              </div>
              <div>
                <span class="text-xs font-bold text-white block">Quét hạn tài khoản (membership-check)</span>
                <span class="text-[9px] text-zinc-500 font-bold font-mono">Trực tiếp: 15-phút / lần + Hàng ngày 1:30 AM</span>
              </div>
            </div>
            <p class="text-[11px] text-zinc-400 leading-relaxed">
              Kiểm tra thời hạn gói cước, hạ cấp tài khoản hết hạn về gói Free và gửi email cảnh báo/thông báo hết hạn tự động.
            </p>
          </div>
          <div class="pt-4 flex justify-between items-center gap-4">
            <div id="progress-container-membership-check" class="hidden flex-1 flex items-center gap-3">
              <div class="flex-1 h-1.5 bg-zinc-950 border border-zinc-800 rounded-full overflow-hidden">
                <div id="progress-bar-membership-check" class="h-full bg-gradient-to-r from-sky-500 to-blue-500 w-0 transition-all duration-200"></div>
              </div>
              <span id="progress-text-membership-check" class="text-[10px] text-zinc-300 font-bold shrink-0">0%</span>
              <span id="progress-eta-membership-check" class="text-[10px] text-sky-400 font-bold shrink-0">ETA: --s</span>
            </div>
            <button 
              type="button" 
              onclick="triggerCronJob('membership-check')"
              id="btn-trigger-membership-check"
              class="px-3 py-1.5 bg-white/5 border border-glass-stroke/40 hover:bg-white/10 text-white rounded-xl font-bold text-[10px] transition-all flex items-center gap-1.5 cursor-pointer shrink-0"
            >
              <span class="material-symbols-outlined text-sm">play_arrow</span>
              <span>Chạy ngay</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Control Bar -->
    <div class="glass-panel p-4 rounded-2xl flex flex-col sm:flex-row gap-4 items-center justify-between">
      <div class="flex items-center gap-2 w-full sm:w-auto">
        <span class="text-xs text-zinc-400 font-bold shrink-0">Lọc theo Tác vụ:</span>
        <select id="filter-job" onchange="filterLogsTable()" class="bg-zinc-900 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs text-white focus:outline-none font-bold w-full sm:w-auto">
          <option value="all">🔍 Tất cả các tác vụ</option>
          <option value="sync-kkphim">🔄 Đồng bộ phim (sync-kkphim)</option>
          <option value="membership-check">👤 Quét hạn tài khoản (membership-check)</option>
          <option value="crawl-new-movies">🎬 Cào phim tự động (crawl-new-movies)</option>
        </select>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <span class="text-xs text-zinc-400 font-bold shrink-0">Trạng thái:</span>
        <select id="filter-status" onchange="filterLogsTable()" class="bg-zinc-900 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs text-white focus:outline-none font-bold w-full sm:w-auto">
          <option value="all">🔍 Tất cả trạng thái</option>
          <option value="success">🟢 Thành công</option>
          <option value="error">🔴 Lỗi / Thất bại</option>
        </select>
      </div>
    </div>

    <!-- Logs Table Container -->
    <div class="glass-panel rounded-2xl overflow-hidden p-6">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-glass-stroke/40 text-[11px] text-zinc-400 uppercase tracking-wider font-bold">
              <th class="py-3.5 px-4 w-48">Thời Gian Chạy</th>
              <th class="py-3.5 px-4 w-52">Tên Tác Vụ</th>
              <th class="py-3.5 px-4 w-32">Trạng Thái</th>
              <th class="py-3.5 px-4 w-32">Thời Gian Xử Lý</th>
              <th class="py-3.5 px-4">Thông Điệp Chi Tiết</th>
              <th class="py-3.5 px-4 text-right w-24">Chi Tiết</th>
            </tr>
          </thead>
          <tbody id="logs-tbody" class="divide-y divide-glass-stroke/30 text-xs font-body-main">
            {initialLogs.length === 0 ? (
              <tr>
                <td colspan="6" class="py-12 text-center text-zinc-500 font-bold">
                  Hệ thống chưa ghi nhận log nào. Vui lòng đợi Cloudflare triggers hoạt động!
                </td>
              </tr>
            ) : (
              initialLogs.map((item) => {
                const dateStr = new Date(item.created_at).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });
                return (
                  <tr class="hover:bg-white/5 transition-all log-row" data-job={item.job_name} data-status={item.status}>
                    <td class="py-4 px-4 font-mono text-zinc-300 font-bold">
                      {dateStr}
                    </td>
                    <td class="py-4 px-4 font-bold text-zinc-100">
                      {item.job_name === 'sync-kkphim' ? (
                        <span class="flex items-center gap-1 text-purple-400">
                          <span class="material-symbols-outlined text-sm">sync</span>
                          <span>sync-kkphim</span>
                        </span>
                      ) : item.job_name === 'crawl-new-movies' ? (
                        <span class="flex items-center gap-1 text-emerald-400">
                          <span class="material-symbols-outlined text-sm">movie_filter</span>
                          <span>crawl-new-movies</span>
                        </span>
                      ) : (
                        <span class="flex items-center gap-1 text-sky-400">
                          <span class="material-symbols-outlined text-sm">badge</span>
                          <span>membership-check</span>
                        </span>
                      )}
                    </td>
                    <td class="py-4 px-4">
                      {item.status === 'success' ? (
                        <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold uppercase tracking-wider">Thành công</span>
                      ) : item.status === 'running' ? (
                        <span class="px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] font-bold uppercase tracking-wider animate-pulse">Đang chạy</span>
                      ) : item.status === 'partial' ? (
                        <span class="px-2.5 py-1 rounded-full bg-orange-500/10 text-orange-400 border border-orange-500/20 text-[10px] font-bold uppercase tracking-wider">Gián đoạn</span>
                      ) : (
                        <span class="px-2.5 py-1 rounded-full bg-red-500/10 text-red-400 border border-red-500/20 text-[10px] font-bold uppercase tracking-wider">Lỗi</span>
                      )}
                    </td>
                    <td class="py-4 px-4 font-mono font-bold text-zinc-300">
                      {formatDuration(item.duration_ms || 0)}
                    </td>
                    <td class="py-4 px-4 text-zinc-400 truncate max-w-md" title={item.message}>
                      {item.message || 'Không có thông điệp'}
                    </td>
                    <td class="py-4 px-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        {item.status === 'partial' && item.job_name === 'sync-kkphim' && (
                          <button 
                            type="button" 
                            onclick={`resumeSyncJob(this, ${item.details?.limit || 20})`}
                            class="px-2.5 py-1.5 bg-orange-500/15 hover:bg-orange-500/25 border border-orange-500/30 text-orange-400 rounded-lg font-bold text-[10px] transition-all cursor-pointer inline-flex items-center gap-1"
                            data-txatooltip="Tiếp tục quét các phim còn lại"
                          >
                            <span class="material-symbols-outlined text-[12px] font-bold">play_arrow</span>
                            <span>Tiếp tục</span>
                          </button>
                        )}
                        <button 
                          type="button" 
                          onclick={`viewLogDetails('${item.id}', ${JSON.stringify(item.details).replace(/'/g, "\\'")})`}
                          class="p-2 bg-purple-500/10 hover:bg-purple-500/20 rounded-lg text-purple-400 transition-all cursor-pointer inline-flex items-center justify-center border-none"
                          data-txatooltip="Xem chi tiết dữ liệu JSON"
                        >
                          <span class="material-symbols-outlined text-base">visibility</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<script is:inline>
  (function() {
    window.viewLogDetails = function(id, details) {
      if (!details) {
        if (window.showGlobalToast) window.showGlobalToast('Không có dữ liệu chi tiết!', 'info');
        return;
      }
      
      const formattedJson = JSON.stringify(details, null, 2);
      const content = `
        <div class="pt-2 text-xs space-y-3">
          <p class="text-zinc-400">Metadata JSON của lần chạy:</p>
          <div class="border border-zinc-800 rounded-xl bg-zinc-950 p-4 font-mono overflow-auto max-h-80 text-[11px] text-emerald-400 select-text leading-relaxed whitespace-pre">
${formattedJson}
          </div>
        </div>
      `;

      if (window.txamodal) {
        window.txamodal.show({
          title: '📊 Chi Tiết Log Metadata',
          content: content,
          confirmText: 'Đóng',
          cancelText: '',
          onConfirm: () => {}
        });
      }
    };

    window.filterLogsTable = function() {
      const jobFilter = document.getElementById('filter-job').value;
      const statusFilter = document.getElementById('filter-status').value;
      const rows = document.querySelectorAll('.log-row');

      rows.forEach(row => {
        const job = row.getAttribute('data-job');
        const status = row.getAttribute('data-status');

        const matchJob = jobFilter === 'all' || job === jobFilter;
        let matchStatus = false;
        if (statusFilter === 'all') {
          matchStatus = true;
        } else if (statusFilter === 'success') {
          matchStatus = status === 'success';
        } else if (statusFilter === 'error') {
          matchStatus = status === 'error' || status === 'partial' || status === 'running';
        }

        if (matchJob && matchStatus) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    };

    async function runSingleJobWithProgress(jobName, isPartOfSequential = false) {
      const btn = document.getElementById(`btn-trigger-${jobName}`);
      const progContainer = document.getElementById(`progress-container-${jobName}`);
      const progBar = document.getElementById(`progress-bar-${jobName}`);
      const progText = document.getElementById(`progress-text-${jobName}`);
      const progEta = document.getElementById(`progress-eta-${jobName}`);

      let limitVal = 20;
      const limitSelect = document.getElementById('sync-limit-select');
      if (limitSelect && jobName === 'sync-kkphim') {
        limitVal = parseInt(limitSelect.value, 10) || 20;
      }

      if (btn && progContainer) {
        btn.classList.add('hidden');
        progContainer.classList.remove('hidden');
      }

      let estDurationMs = 1500; // default for membership-check
      if (jobName === 'sync-kkphim') {
        estDurationMs = limitVal * 350; // 350ms per movie
      } else if (jobName === 'crawl-new-movies') {
        estDurationMs = 8000; // 8 seconds
      }

      let elapsedMs = 0;
      let progress = 0;

      const updateProgressUI = () => {
        if (progBar) progBar.style.width = `${progress}%`;
        if (progText) progText.textContent = `${Math.round(progress)}%`;
        const remainingSec = Math.max(0, Math.ceil((estDurationMs - elapsedMs) / 1000));
        if (progEta) {
          progEta.textContent = remainingSec > 0 ? `ETA: ${remainingSec}s` : `Xử lý...`;
          progEta.className = 'text-[10px] text-purple-400 font-bold shrink-0';
        }
      };

      updateProgressUI();

      const timer = setInterval(() => {
        elapsedMs += 100;
        if (progress < 95) {
          const ratio = elapsedMs / estDurationMs;
          progress = Math.min(95, ratio * 95);
        }
        updateProgressUI();
      }, 100);

      try {
        const payload = { job: jobName };
        if (jobName === 'sync-kkphim') {
          payload.limit = limitVal;
          const resumeCheckbox = document.getElementById('sync-resume-checkbox');
          payload.resume = resumeCheckbox ? resumeCheckbox.checked : true;
        }

        const res = await fetch('/api/admin/cron-trigger', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'Lỗi không xác định');

        clearInterval(timer);
        progress = 100;
        if (progBar) progBar.style.width = '100%';
        if (progText) progText.textContent = '100%';
        if (progEta) {
          progEta.textContent = 'Xong!';
          progEta.className = 'text-[10px] text-emerald-400 font-bold shrink-0';
        }
        
        if (window.showGlobalToast && !isPartOfSequential) {
          window.showGlobalToast(data.message || `Đã chạy tác vụ ${jobName} thành công!`, 'success');
        }

        if (!isPartOfSequential) {
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        }
        return true;
      } catch (err) {
        clearInterval(timer);
        progress = 0;
        if (progBar) progBar.style.width = '0%';
        if (progText) progText.textContent = 'Lỗi';
        if (progEta) {
          progEta.textContent = 'Thất bại';
          progEta.className = 'text-[10px] text-red-500 font-bold shrink-0';
        }
        if (window.showGlobalToast && !isPartOfSequential) {
          window.showGlobalToast(`Lỗi: ${err.message}`, 'error');
        }
        
        if (!isPartOfSequential) {
          setTimeout(() => {
            if (btn && progContainer) {
              btn.classList.remove('hidden');
              progContainer.classList.add('hidden');
            }
          }, 4000);
        }
        throw err;
      }
    }

    async function runAllJobsSequentially() {
      const btnAll = document.getElementById('btn-trigger-all');
      const globalContainer = document.getElementById('global-progress-container');
      const globalBar = document.getElementById('global-progress-bar');
      const globalStatus = document.getElementById('global-progress-status');
      const globalEta = document.getElementById('global-progress-eta');
      const globalPercentage = document.getElementById('global-progress-percentage');

      if (btnAll) btnAll.disabled = true;
      if (globalContainer) {
        globalContainer.classList.remove('hidden');
        // Scroll to container smoothly
        globalContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      const jobs = [
        { name: 'sync-kkphim', label: 'Đồng bộ phim (sync-kkphim)' },
        { name: 'membership-check', label: 'Quét hạn dùng (membership-check)' },
        { name: 'crawl-new-movies', label: 'Cào phim tự động (crawl-new-movies)' }
      ];

      let limitVal = 20;
      const limitSelect = document.getElementById('sync-limit-select');
      if (limitSelect) {
        limitVal = parseInt(limitSelect.value, 10) || 20;
      }

      const estDurations = {
        'sync-kkphim': limitVal * 350,
        'membership-check': 1500,
        'crawl-new-movies': 8000
      };

      const totalEstDurationMs = estDurations['sync-kkphim'] + estDurations['membership-check'] + estDurations['crawl-new-movies'];
      let elapsedTotalMs = 0;
      let overallProgress = 0;

      const updateGlobalUI = (currentLabel) => {
        if (globalBar) globalBar.style.width = `${overallProgress}%`;
        if (globalPercentage) globalPercentage.textContent = `${Math.round(overallProgress)}%`;
        const remainingSec = Math.max(0, Math.ceil((totalEstDurationMs - elapsedTotalMs) / 1000));
        if (globalEta) globalEta.textContent = remainingSec > 0 ? `Tổng ETA: còn ${remainingSec}s` : 'Hoàn tất...';
        if (globalStatus && currentLabel) {
          globalStatus.innerHTML = `
            <span class="animate-spin inline-block w-3.5 h-3.5 border-2 border-purple-400 border-t-transparent rounded-full mr-1"></span>
            <span>Đang chạy: ${currentLabel}</span>
          `;
        }
      };

      const globalTimer = setInterval(() => {
        elapsedTotalMs += 100;
        if (overallProgress < 95) {
          const ratio = elapsedTotalMs / totalEstDurationMs;
          overallProgress = Math.min(95, ratio * 95);
        }
        updateGlobalUI();
      }, 100);

      try {
        for (let i = 0; i < jobs.length; i++) {
          const job = jobs[i];
          updateGlobalUI(job.label);
          await runSingleJobWithProgress(job.name, true);
        }

        clearInterval(globalTimer);
        overallProgress = 100;
        if (globalBar) globalBar.style.width = '100%';
        if (globalPercentage) globalPercentage.textContent = '100%';
        if (globalEta) globalEta.textContent = 'Hoàn tất!';
        if (globalStatus) {
          globalStatus.innerHTML = `
            <span class="material-symbols-outlined text-emerald-400 text-sm align-middle mr-1">check_circle</span>
            <span class="text-emerald-400 font-bold">Đã hoàn thành tất cả các tác vụ!</span>
          `;
        }

        if (window.showGlobalToast) {
          window.showGlobalToast('Đã kích hoạt và hoàn tất tất cả tác vụ thành công!', 'success');
        }

        setTimeout(() => {
          window.location.reload();
        }, 1500);

      } catch (err) {
        clearInterval(globalTimer);
        if (globalStatus) {
          globalStatus.innerHTML = `
            <span class="material-symbols-outlined text-red-500 text-sm align-middle mr-1">error</span>
            <span class="text-red-500 font-bold">Gặp lỗi trong quá trình chạy tuần tự!</span>
          `;
        }
        if (window.showGlobalToast) {
          window.showGlobalToast(`Chạy tuần tự thất bại: ${err.message}`, 'error');
        }
        setTimeout(() => {
          if (globalContainer) globalContainer.classList.add('hidden');
          if (btnAll) btnAll.disabled = false;
          
          // Restore all card buttons
          jobs.forEach(j => {
            const btn = document.getElementById(`btn-trigger-${j.name}`);
            const progContainer = document.getElementById(`progress-container-${j.name}`);
            if (btn && progContainer) {
              btn.classList.remove('hidden');
              progContainer.classList.add('hidden');
            }
          });
        }, 5000);
      }
    }

    window.triggerCronJob = async function(jobName) {
      if (jobName === 'all') {
        await runAllJobsSequentially();
      } else {
        await runSingleJobWithProgress(jobName);
      }
    };

    window.resumeSyncJob = async function(btnElement, limit) {
      let oldHtml = btnElement.innerHTML;
      btnElement.disabled = true;
      btnElement.innerHTML = '<span class="material-symbols-outlined animate-spin text-[12px]">autorenew</span> Đang chạy...';
      
      if (window.showGlobalToast) window.showGlobalToast('Đang tiếp tục đồng bộ phim...', 'info');
      
      try {
        const res = await fetch('/api/admin/cron-trigger', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ job: 'sync-kkphim', limit: limit || 20, resume: true })
        });
        
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'Lỗi không xác định');
        
        if (window.showGlobalToast) window.showGlobalToast(data.message || 'Đồng bộ tiếp tục thành công!', 'success');
        setTimeout(() => window.location.reload(), 1500);
      } catch (err) {
        if (window.showGlobalToast) window.showGlobalToast(`Lỗi: ${err.message}`, 'error');
        btnElement.disabled = false;
        btnElement.innerHTML = oldHtml;
      }
    };

    // Auto highlight active nav item
    const navItem = document.getElementById('nav-cron-logs');
    if (navItem) navItem.classList.add('sidebar-active');
  })();
</script>
