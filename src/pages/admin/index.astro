---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { MovieService } from '../../services/MovieService';
import { supabase } from '../../lib/supabase';

const staticMovies = await MovieService.getMovies();

// 1. Movies Stats
const totalMovies = staticMovies.length;

const now = new Date();
const oneWeekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
const twoWeeksAgo = new Date(now.getTime() - 14 * 24 * 60 * 60 * 1000);

const moviesThisWeek = staticMovies.filter((m: any) => {
  const d = m.updatedAt ? new Date(m.updatedAt) : new Date('2024-01-01');
  return d >= oneWeekAgo;
}).length;

const moviesLastWeek = staticMovies.filter((m: any) => {
  const d = m.updatedAt ? new Date(m.updatedAt) : new Date('2024-01-01');
  return d >= twoWeeksAgo && d < oneWeekAgo;
}).length;

const moviesGrowthPct = moviesLastWeek > 0 
  ? ((moviesThisWeek - moviesLastWeek) / moviesLastWeek) * 100 
  : (moviesThisWeek > 0 ? 100 : 0);

// 2. Views Stats
const totalViews = staticMovies.reduce((acc: number, m: any) => acc + (m.views || 0), 0);
const formattedViews = totalViews >= 1000000 
  ? (totalViews / 1000000).toFixed(1) + 'M' 
  : totalViews >= 1000 
    ? (totalViews / 1000).toFixed(1) + 'K' 
    : totalViews;

// Query views growth from watch_history table in Supabase
let viewsThisWeek = 0;
let viewsLastWeek = 0;
try {
  const { data: whThisWeek } = await supabase
    .from('watch_history')
    .select('id')
    .gte('updated_at', oneWeekAgo.toISOString());
  
  const { data: whLastWeek } = await supabase
    .from('watch_history')
    .select('id')
    .gte('updated_at', twoWeeksAgo.toISOString())
    .lt('updated_at', oneWeekAgo.toISOString());

  viewsThisWeek = whThisWeek?.length || 0;
  viewsLastWeek = whLastWeek?.length || 0;
} catch (e) {
  console.warn("Không thể query watch_history cho views growth:", e);
}

const viewsGrowthPct = viewsLastWeek > 0 
  ? ((viewsThisWeek - viewsLastWeek) / viewsLastWeek) * 100 
  : (viewsThisWeek > 0 ? 100 : 0);

// 3. Members Stats
let totalMembers = 0;
let membersThisWeek = 0;
let membersLastWeek = 0;

try {
  const { count } = await supabase
    .from('users')
    .select('*', { count: 'exact', head: true });
  totalMembers = count || 0;

  const { data: mThisWeek } = await supabase
    .from('users')
    .select('id')
    .gte('created_at', oneWeekAgo.toISOString());

  const { data: mLastWeek } = await supabase
    .from('users')
    .select('id')
    .gte('created_at', twoWeeksAgo.toISOString())
    .lt('created_at', oneWeekAgo.toISOString());

  membersThisWeek = mThisWeek?.length || 0;
  membersLastWeek = mLastWeek?.length || 0;
} catch (e) {
  console.warn("Không thể query users cho stats:", e);
}

// Fallback to local users list if database is empty
if (totalMembers === 0) {
  totalMembers = 6; 
  membersThisWeek = 1;
  membersLastWeek = 1;
}

const membersGrowthPct = membersLastWeek > 0 
  ? ((membersThisWeek - membersLastWeek) / membersLastWeek) * 100 
  : (membersThisWeek > 0 ? 100 : 0);

// 4. Broken Movies Stats
let brokenMoviesCount = 0;
staticMovies.forEach((m: any) => {
  if (!m.posterUrl || m.posterUrl.trim() === '' || m.posterUrl.includes('error')) {
    brokenMoviesCount++;
  }
});
const brokenGrowthPct = 0;
