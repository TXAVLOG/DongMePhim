---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { MovieService } from '../../services/MovieService';

const staticMovies = await MovieService.getMovies();
---

<AdminLayout title="Bảng điều khiển">
  <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 mt-4 gap-4">
    <div>
      <h2 class="font-headline-lg text-on-surface text-3xl">Bảng điều khiển</h2>
      <p class="text-text-dim text-body-main mt-1">Chào mừng trở lại, hôm nay hệ thống đang hoạt động ổn định.</p>
    </div>
    <div class="flex items-center gap-4">
      <div class="relative group">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-text-dim group-focus-within:text-primary transition-colors">search</span>
        <input class="bg-surface-container border border-glass-stroke rounded-full pl-10 pr-4 py-2 text-sm focus:ring-1 focus:ring-primary focus:border-primary w-full md:w-64 transition-all focus:outline-none" placeholder="Tìm kiếm phim, thành viên..." type="text"/>
      </div>
      <button class="w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-full glass-panel hover:bg-surface-variant transition-all cursor-pointer">
        <span class="material-symbols-outlined text-on-surface">notifications</span>
      </button>
    </div>
  </header>

  <!-- Stats Cards Grid -->
  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    <div class="glass-panel p-6 rounded-3xl card-hover transition-all duration-300 relative overflow-hidden group">
      <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
        <span class="material-symbols-outlined text-6xl">trending_up</span>
      </div>
      <div class="flex items-center gap-4 mb-4">
        <div class="w-12 h-12 rounded-2xl bg-secondary/10 flex items-center justify-center text-secondary">
          <span class="material-symbols-outlined">visibility</span>
        </div>
        <p class="font-label-caps text-xs text-text-dim uppercase tracking-wider">Lượt truy cập</p>
      </div>
      <div class="flex items-end justify-between">
        <h3 id="stat-views" class="text-3xl font-display-hero">1.2M</h3>
        <span id="stat-views-growth" class="text-emerald-400 text-xs font-bold bg-emerald-400/10 px-2 py-1 rounded-full">+12%</span>
      </div>
    </div>

    <a href="/admin/phim" class="glass-panel p-6 rounded-3xl card-hover transition-all duration-300 relative overflow-hidden group block border border-glass-stroke text-current hover:no-underline">
      <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
        <span class="material-symbols-outlined text-6xl">movie</span>
      </div>
      <div class="flex items-center gap-4 mb-4">
        <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined">inventory_2</span>
        </div>
        <p class="font-label-caps text-xs text-text-dim uppercase tracking-wider">Tổng số phim</p>
      </div>
      <div class="flex items-end justify-between">
        <h3 id="stat-movies" class="text-3xl font-display-hero">42,850</h3>
        <span id="stat-movies-growth" class="text-emerald-400 text-xs font-bold bg-emerald-400/10 px-2 py-1 rounded-full">+450</span>
      </div>
    </a>

    <a href="/admin/thanh-vien" class="glass-panel p-6 rounded-3xl card-hover transition-all duration-300 relative overflow-hidden group block border border-glass-stroke text-current hover:no-underline">
      <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
        <span class="material-symbols-outlined text-6xl">person_add</span>
      </div>
      <div class="flex items-center gap-4 mb-4">
        <div class="w-12 h-12 rounded-2xl bg-tertiary/10 flex items-center justify-center text-tertiary">
          <span class="material-symbols-outlined">group_add</span>
        </div>
        <p class="font-label-caps text-xs text-text-dim uppercase tracking-wider">Thành viên mới</p>
      </div>
      <div class="flex items-end justify-between">
        <h3 id="stat-members" class="text-3xl font-display-hero">1,244</h3>
        <span id="stat-members-growth" class="text-emerald-400 text-xs font-bold bg-emerald-400/10 px-2 py-1 rounded-full">+5.2%</span>
      </div>
    </a>

    <a href="/admin/cai-dat/bao-cao-loi" class="glass-panel p-6 rounded-3xl card-hover transition-all duration-300 relative overflow-hidden group block border border-glass-stroke text-current hover:no-underline">
      <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
        <span class="material-symbols-outlined text-6xl">report_problem</span>
      </div>
      <div class="flex items-center gap-4 mb-4">
        <div class="w-12 h-12 rounded-2xl bg-error/10 flex items-center justify-center text-error">
          <span class="material-symbols-outlined">bug_report</span>
        </div>
        <p class="font-label-caps text-xs text-text-dim uppercase tracking-wider">Phim đang lỗi</p>
      </div>
      <div class="flex items-end justify-between">
        <h3 id="stat-broken" class="text-3xl font-display-hero">12</h3>
        <span id="stat-broken-growth" class="text-error text-xs font-bold bg-error/10 px-2 py-1 rounded-full">-3%</span>
      </div>
    </a>
  </section>

  <!-- Chart Section -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
    <div class="lg:col-span-2 glass-panel p-8 rounded-3xl">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h3 class="text-title-md font-headline-lg text-xl text-on-surface">Lưu lượng truy cập</h3>
          <p class="text-text-dim text-sm mt-1">Thống kê 7 ngày gần nhất</p>
        </div>
        <div class="flex gap-2">
          <button class="px-3 py-1 text-xs font-label-caps bg-primary text-on-primary-fixed rounded-full cursor-pointer hover:opacity-90">Tuần</button>
          <button class="px-3 py-1 text-xs font-label-caps glass-panel rounded-full hover:bg-surface-variant transition-all cursor-pointer border border-glass-stroke">Tháng</button>
        </div>
      </div>
      <div id="traffic-chart" class="h-64 w-full relative flex items-end gap-2 px-2">
        <div class="absolute inset-0 flex flex-col justify-between opacity-10">
          <div class="border-t border-on-surface w-full"></div>
          <div class="border-t border-on-surface w-full"></div>
          <div class="border-t border-on-surface w-full"></div>
          <div class="border-t border-on-surface w-full"></div>
        </div>
        <div class="flex-1 bg-gradient-to-t from-primary/20 to-primary/60 rounded-t-lg h-[40%] transition-all hover:brightness-125 hover:scale-x-105 duration-300" style="height: 40%"></div>
        <div class="flex-1 bg-gradient-to-t from-primary/20 to-primary/60 rounded-t-lg h-[65%] transition-all hover:brightness-125 hover:scale-x-105 duration-300" style="height: 65%"></div>
        <div class="flex-1 bg-gradient-to-t from-primary/20 to-primary/60 rounded-t-lg h-[55%] transition-all hover:brightness-125 hover:scale-x-105 duration-300" style="height: 55%"></div>
        <div class="flex-1 bg-gradient-to-t from-primary/20 to-primary/60 rounded-t-lg h-[85%] transition-all hover:brightness-125 hover:scale-x-105 duration-300" style="height: 85%"></div>
        <div class="flex-1 bg-gradient-to-t from-primary/20 to-primary/60 rounded-t-lg h-[75%] transition-all hover:brightness-125 hover:scale-x-105 duration-300" style="height: 75%"></div>
        <div class="flex-1 bg-gradient-to-t from-primary/20 to-primary/60 rounded-t-lg h-[95%] transition-all hover:brightness-125 hover:scale-x-105 duration-300" style="height: 95%"></div>
        <div class="flex-1 bg-gradient-to-t from-secondary/20 to-secondary/60 rounded-t-lg h-[80%] transition-all hover:brightness-125 hover:scale-x-105 duration-300 border-x-2 border-secondary/30" style="height: 80%"></div>
      </div>
      <div id="chart-labels" class="flex justify-between mt-4 text-[10px] text-text-dim font-label-caps px-2">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span class="text-secondary">Today</span>
      </div>
    </div>
    
    <div class="glass-panel p-8 rounded-3xl flex flex-col justify-center relative overflow-hidden">
      <div class="relative z-10 text-center">
        <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-gradient-to-tr from-primary to-secondary flex items-center justify-center shadow-lg shadow-primary/20">
          <span class="material-symbols-outlined text-4xl text-on-primary-fixed">rocket_launch</span>
        </div>
        <h4 class="text-title-md mb-2 text-on-surface text-lg">Tối ưu hóa dữ liệu</h4>
        <p class="text-sm text-text-dim mb-6 leading-relaxed">Hệ thống gợi ý đã sẵn sàng cập nhật thuật toán mới cho 42k phim hiện có.</p>
        <button class="w-full py-3 bg-on-surface text-surface-deep font-bold rounded-xl hover:scale-[1.02] transition-transform active:scale-95 cursor-pointer">
          Bắt đầu ngay
        </button>
      </div>
    </div>
  </section>

  <!-- Recent Movies Table -->
  <section class="glass-panel rounded-3xl overflow-hidden mb-gutter">
    <div class="px-8 py-6 flex justify-between items-center border-b border-glass-stroke">
      <h3 class="text-title-md text-on-surface">Phim vừa cập nhật (Crawled)</h3>
      <a href="/admin/phim/crawler" class="text-primary text-sm font-label-caps hover:underline cursor-pointer">Xem tất cả</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-surface-container/50">
          <tr>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">PHIM</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">CHẤT LƯỢNG</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">NGUỒN</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">TRẠNG THÁI</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim text-right">HÀNH ĐỘNG</th>
          </tr>
        </thead>
        <tbody id="recent-movies-tbody" class="divide-y divide-glass-stroke">
          <!-- Populated dynamically via JS client side -->
        </tbody>
      </table>
    </div>
    <div class="p-4 bg-surface-container/30 text-center border-t border-glass-stroke">
      <p id="show-count-text" class="text-xs text-text-dim font-label-caps font-bold">HIỂN THỊ 0 TRÊN TỔNG SỐ 0 PHIM MỚI CRAWL</p>
    </div>
  </section>

  <script define:vars={{ staticMovies }}>
    (function() {
      function initDashboard() {
        const tbody = document.getElementById('recent-movies-tbody');
        if (!tbody) return; // Exit if not on this page

        function loadDashboardStats() {
          const crawledListRaw = JSON.parse(localStorage.getItem('txa_crawled_movies') || '[]');
          const crawledList = crawledListRaw.map(item => {
            const m = item.movie || item;
            let type = 'series';
            if (m.type === 'single' || m.type === 'movie') {
              type = 'movie';
            } else if (m.type === 'hoathinh') {
              type = 'hoathinh';
            } else if (m.type === 'tvshows') {
              type = 'tvshows';
            }
            return {
              id: m.id || `local-${m.slug}`,
              title: m.title || m.name,
              originalTitle: m.originalTitle || m.origin_name || '',
              slug: m.slug,
              description: m.description || m.content || '',
              posterUrl: m.posterUrl || m.poster_url || m.poster || '',
              bannerUrl: m.bannerUrl || m.thumb_url || m.posterUrl || m.poster_url || m.poster || '',
              releaseYear: m.releaseYear || parseInt(m.year) || 2024,
              durationMinutes: m.durationMinutes || m.time || '120 phút',
              type: type,
              status: m.status === 'completed' ? 'completed' : 'ongoing',
              episodeCurrent: m.episodeCurrent || m.episode_current || 'Full',
              episodeTotal: m.episodeTotal || m.episode_total || '1',
              quality: m.quality || 'FHD',
              lang: m.lang || 'Vietsub',
              imdbScore: m.imdbScore || 8.0,
              views: m.views || 0,
              commentCount: m.commentCount || 0,
              category: m.category || 'Khác',
              genres: m.genres || [],
              updatedAt: m.updatedAt || new Date().toISOString(),
              source: 'crawled'
            };
          }).filter(m => m.slug && m.slug !== 'undefined' && m.slug !== 'null');
          const regUsers = JSON.parse(localStorage.getItem('tregistered_users') || '[]');
          
          const totalMovies = staticMovies.length + crawledList.length;
          
          const staticViewsSum = staticMovies.reduce((acc, m) => acc + (m.views || 0), 0);
          const crawledViewsSum = crawledList.reduce((acc, m) => acc + (m.views || 2500), 0);
          const totalViews = (staticViewsSum + crawledViewsSum) * 12;
          
          let formattedViews = totalViews >= 1000000 
            ? (totalViews / 1000000).toFixed(1) + 'M' 
            : totalViews >= 1000 
              ? (totalViews / 1000).toFixed(1) + 'K' 
              : totalViews;

          const membersCount = 1240 + regUsers.length;
          
          let brokenMoviesCount = 0;
          crawledList.forEach(m => {
            if (!m.posterUrl || m.posterUrl.trim() === '' || m.posterUrl.includes('error')) {
              brokenMoviesCount++;
            } else if (!m.episodeTotal || parseInt(m.episodeTotal) === 0) {
              brokenMoviesCount++;
            }
          });
          staticMovies.forEach(m => {
            if (!m.posterUrl || m.posterUrl.trim() === '' || m.posterUrl.includes('error')) {
              brokenMoviesCount++;
            }
          });
          if (brokenMoviesCount === 0) brokenMoviesCount = 2; // base static broken items

          // Update DOM values
          const viewsH3 = document.getElementById('stat-views');
          if (viewsH3) viewsH3.textContent = formattedViews;
          
          const moviesH3 = document.getElementById('stat-movies');
          if (moviesH3) moviesH3.textContent = totalMovies.toLocaleString('vi-VN');
          
          const membersH3 = document.getElementById('stat-members');
          if (membersH3) membersH3.textContent = membersCount.toLocaleString('vi-VN');
          
          const brokenH3 = document.getElementById('stat-broken');
          if (brokenH3) brokenH3.textContent = brokenMoviesCount;

          const moviesGrowth = document.getElementById('stat-movies-growth');
          if (moviesGrowth) {
            moviesGrowth.textContent = `+${crawledList.length} Crawled`;
          }
          const membersGrowth = document.getElementById('stat-members-growth');
          if (membersGrowth) {
            membersGrowth.textContent = `+${regUsers.length} Mới`;
          }

          // Populate Recent Movies Table
          const displayList = crawledList.length > 0 ? crawledList : staticMovies.slice(0, 5);
          const recent5 = [...displayList].reverse().slice(0, 5);
          
          tbody.innerHTML = recent5.map(m => {
            const genresStr = Array.isArray(m.genres) ? m.genres.join(', ') : (m.genres || 'KỊCH TÍNH');
            const quality = m.quality || 'FHD';
            const lang = m.lang || 'Vietsub';
            
            let source = 'Hệ thống (Static)';
            if (m.id && m.id.startsWith('kk-')) {
              source = 'KKPhim API';
            } else if (m.id && m.id.startsWith('local-')) {
              source = 'OPhim Crawler';
            } else if (crawledList.some(c => c.id === m.id)) {
              source = 'Manual Upload';
            }
            
            let statusText = '';
            let statusBg = '';
            if (m.type === 'movie') {
              statusText = 'Film Full';
              statusBg = 'bg-emerald-500';
            } else {
              let epNum = m.episodeCurrent || '1';
              epNum = String(epNum).trim().replace(/^[tT]ập\s+/, '');
              statusText = m.status === 'completed' ? 'Completed' : `Ongoing (Tập ${epNum})`;
              statusBg = m.status === 'completed' ? 'bg-emerald-500' : 'bg-amber-500';
            }

            const isStatic = !crawledList.some(c => c.id === m.id);

            return `
              <tr class="hover:bg-white/5 transition-colors group">
                <td class="px-8 py-4">
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke">
                      <img alt="${m.title} Poster" class="w-full h-full object-cover" src="${m.posterUrl}" onerror="this.src='/logo-icon.png'" />
                    </div>
                    <div>
                      <p class="text-sm font-semibold group-hover:text-primary transition-colors">${m.title}</p>
                      <p class="text-[9px] text-text-dim uppercase tracking-tighter mt-1">${genresStr}</p>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-4">
                  <span class="px-2 py-1 rounded bg-secondary/10 text-secondary text-[10px] font-bold border border-secondary/20 whitespace-nowrap">${quality} ${lang.toUpperCase()}</span>
                </td>
                <td class="px-8 py-4 text-xs text-text-dim">${source}</td>
                <td class="px-8 py-4">
                  <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full ${statusBg}"></div>
                    <span class="text-xs font-medium text-on-surface">${statusText}</span>
                  </div>
                </td>
                <td class="px-8 py-4 text-right">
                  <div class="flex gap-2 justify-end">
                    <a href="/phim/${m.slug}" target="_blank" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-primary transition-colors cursor-pointer" title="Xem trên web">
                      <span class="material-symbols-outlined text-sm">visibility</span>
                    </a>
                    ${isStatic ? `
                      <button class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center text-zinc-600 cursor-not-allowed" title="Không thể xóa phim hệ thống" disabled>
                        <span class="material-symbols-outlined text-sm">delete</span>
                      </button>
                    ` : `
                      <button onclick="deleteCrawledMovie('${m.id}')" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-error transition-colors cursor-pointer" title="Xóa phim crawled">
                        <span class="material-symbols-outlined text-sm">delete</span>
                      </button>
                    `}
                  </div>
                </td>
              </tr>
            `;
          }).join('');

          const showCountText = document.getElementById('show-count-text');
          if (showCountText) {
            showCountText.textContent = crawledList.length > 0 
              ? `HIỂN THỊ ${recent5.length} TRÊN TỔNG SỐ ${crawledList.length} PHIM MỚI CRAWL`
              : `HIỂN THỊ 5 PHIM HỆ THỐNG MỚI NHẤT (CHƯA CÓ PHIM CRAWL)`;
          }
        }

        window.deleteCrawledMovie = function(movieId) {
          const performDelete = () => {
            let list = JSON.parse(localStorage.getItem('txa_crawled_movies') || '[]');
            list = list.filter(m => m.id !== movieId);
            localStorage.setItem('txa_crawled_movies', JSON.stringify(list));
            if (window.showGlobalToast) {
              window.showGlobalToast('Đã xóa phim thành công!', 'success');
            }
            loadDashboardStats();
          };

          if (window.txamodal) {
            window.txamodal.show({
              title: 'Xóa phim khỏi danh sách',
              message: 'Bạn có chắc chắn muốn xóa phim này khỏi danh sách đã thu thập không?',
              type: 'danger',
              confirmText: 'Xóa phim',
              cancelText: 'Hủy bỏ',
              onConfirm: performDelete
            });
          } else if (confirm('Bạn có chắc chắn muốn xóa phim này khỏi danh sách đã thu thập không?')) {
            performDelete();
          }
        };

        loadDashboardStats();

        // 3. Dynamic heights for traffic chart based on watch history
        const baseTraffic = [40, 65, 55, 85, 75, 95, 80];
        const historyList = JSON.parse(localStorage.getItem('thistory') || '[]');
        const dayCounts = [0, 0, 0, 0, 0, 0, 0];
        const now = new Date();
        historyList.forEach(h => {
          try {
            const itemDate = new Date(h.updatedAt);
            const diffDays = Math.floor((now.getTime() - itemDate.getTime()) / (1000 * 60 * 60 * 24));
            if (diffDays >= 0 && diffDays < 7) {
              dayCounts[6 - diffDays]++;
            }
          } catch (e) {}
        });

        const chartContainer = document.getElementById('traffic-chart');
        if (chartContainer) {
          const bars = Array.from(chartContainer.children).filter(el => !el.classList.contains('absolute'));
          bars.forEach((bar, idx) => {
            const count = dayCounts[idx] || 0;
            const percentage = Math.min(100, baseTraffic[idx] + (count * 15));
            bar.style.height = percentage + '%';
            bar.title = `Lưu lượng: ${percentage}% (+${count} lượt xem từ bạn)`;
          });
        }

        // Render week labels dynamically in Vietnamese
        const dayShortNames = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
        const chartLabels = document.getElementById('chart-labels');
        if (chartLabels) {
          let labelHtml = '';
          for (let i = 6; i >= 0; i--) {
            const d = new Date();
            d.setDate(d.getDate() - i);
            const name = i === 0 ? 'Hôm nay' : dayShortNames[d.getDay()];
            const isTodayClass = i === 0 ? 'text-secondary font-bold text-[11px]' : '';
            labelHtml += `<span class="${isTodayClass}">${name}</span>`;
          }
          chartLabels.innerHTML = labelHtml;
        }
      }

      initDashboard();
      document.addEventListener('astro:page-load', initDashboard);
    })();
  </script>
</AdminLayout>
