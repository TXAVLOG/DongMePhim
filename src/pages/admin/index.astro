      function initDashboard() {
        const tbody = document.getElementById('recent-movies-tbody');
        if (!tbody) return; // Exit if not on this page

        // Ensure users are initialized in localStorage
        if (!localStorage.getItem('tregistered_users')) {
          localStorage.setItem('tregistered_users', JSON.stringify(getInitialUsers()));
        }

        const now = new Date();
        const historyList = JSON.parse(localStorage.getItem('thistory') || '[]');

        function loadDashboardStats() {
          const crawledList = staticMovies.filter((m) => !m.isStatic);

          // Populate Recent Movies Table
          const displayList = crawledList.length > 0 ? crawledList : staticMovies.slice(0, 5);
          const recent5 = [...displayList].reverse().slice(0, 5);
          
          tbody.innerHTML = recent5.map(m => {
            const genresStr = Array.isArray(m.genres) ? m.genres.join(', ') : (m.genres || 'KỊCH TÍNH');
            const quality = m.quality || 'FHD';
            const lang = m.lang || 'Vietsub';
            
