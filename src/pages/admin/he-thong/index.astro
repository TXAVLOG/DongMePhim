                  ${canApprove ? `
                    <button onclick="approveSandboxTx('${item.txid}')" class="px-2 py-1 rounded bg-emerald-500 text-slate-950 font-bold hover:brightness-110 active:scale-95 transition-all cursor-pointer">Duyệt</button>
                    <button onclick="declineSandboxTx('${item.txid}')" class="px-2 py-1 rounded bg-red-500/10 border border-red-500/20 text-red-400 font-bold hover:bg-red-500/20 active:scale-95 transition-all cursor-pointer">Từ chối</button>
                  ` : '<span class="text-zinc-600 italic">Đã đối soát</span>'}
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      window.viewReceiptImage = function(txid) {
        const logsStr = localStorage.getItem('txa_payment_logs') || '[]';
        let logs = [];
        try { logs = JSON.parse(logsStr); } catch (e) {}
        const tx = logs.find(item => item.txid === txid);
        if (!tx || !tx.receiptImg) return;
        if (window.txamodal) {
          window.txamodal.show({
            title: 'Xem hóa đơn chuyển khoản thực tế',
            message: `<div class="flex flex-col items-center gap-4"><p class="text-xs text-zinc-400 font-body-main">User: <strong class="text-white">${tx.username}</strong> | Mã GD: <strong class="text-white">${tx.txid}</strong></p><div class="max-w-xs border border-glass-stroke rounded-xl overflow-hidden bg-black flex items-center justify-center"><img src="${tx.receiptImg}" class="w-full h-auto object-contain max-h-[350px]" alt="Receipt" /></div></div>`,
            type: 'info', confirmText: 'Đóng', cancelText: '', onConfirm: () => {}
          });
        }
      };

      window.approveSandboxTx = function(txid) {
        const logsStr = localStorage.getItem('txa_payment_logs') || '[]';
        let logs = [];
        try { logs = JSON.parse(logsStr); } catch (e) {}
        const idx = logs.findIndex(item => item.txid === txid);
        if (idx === -1) return;
        const tx = logs[idx];
        const performApprove = () => {
          tx.status = 'approved';
          localStorage.setItem('txa_payment_logs', JSON.stringify(logs));
          const cycleDays = tx.cycle === 'annual' ? 365 : 30;
          const expiryDate = new Date(Date.now() + 3600 * 1000 * 24 * cycleDays).toISOString();
          localStorage.setItem('txa_user_subscription', JSON.stringify({
            username: tx.username, tier: tx.packageTitle, status: 'active',
            price: tx.price, cycle: tx.cycle, expiry: expiryDate, updatedAt: new Date().toISOString()
          }));
          if (window.showGlobalToast) window.showGlobalToast('Đã duyệt giao dịch và kích hoạt gói VIP!', 'success');
          renderSandboxLogs();
        };
        if (window.txamodal) {
          window.txamodal.show({
            title: 'Phê duyệt giao dịch thủ công',
            message: `Bạn có chắc chắn muốn phê duyệt giao dịch số tiền ${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(tx.price)} của user "${tx.username}"? Quyền lợi VIP sẽ được kích hoạt ngay lập tức.`,
            type: 'info', confirmText: 'Duyệt ngay', cancelText: 'Hủy bỏ', onConfirm: performApprove
          });
        } else if (confirm('Duyệt giao dịch này?')) performApprove();
      };

      window.declineSandboxTx = function(txid) {
        const logsStr = localStorage.getItem('txa_payment_logs') || '[]';
        let logs = [];
        try { logs = JSON.parse(logsStr); } catch (e) {}
        const idx = logs.findIndex(item => item.txid === txid);
        if (idx === -1) return;
        const tx = logs[idx];
        const performDecline = () => {
          tx.status = 'declined';
          localStorage.setItem('txa_payment_logs', JSON.stringify(logs));
          if (window.showGlobalToast) window.showGlobalToast('Đã từ chối giao dịch chuyển khoản.', 'info');
          renderSandboxLogs();
        };
        if (window.txamodal) {
          window.txamodal.show({
            title: 'Từ chối giao dịch thủ công',
            message: `Bạn chắc chắn từ chối giao dịch chuyển khoản này của user "${tx.username}"?`,
            type: 'danger', confirmText: 'Từ chối', cancelText: 'Hủy bỏ', onConfirm: performDecline
          });
        } else if (confirm('Từ chối giao dịch này?')) performDecline();
      };

      // ─── INIT ───
      hydrateFromLocalStorage();
      initChangelogsFromSeed();
      renderChangelogs();
      renderSandboxLogs();
      document.addEventListener('astro:page-load', () => {
        hydrateFromLocalStorage();
        initChangelogsFromSeed();
        renderChangelogs();
        renderSandboxLogs();
      });
    })();
  </script>
</AdminLayout>
