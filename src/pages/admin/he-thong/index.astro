          if (input && input.classList.contains('callback-uri-input')) {
            navigator.clipboard.writeText(input.value)
              .then(() => {
                if (window.showGlobalToast) window.showGlobalToast('Sao chép Redirect URI thành công!', 'success');
              })
              .catch(() => {
                if (window.showGlobalToast) window.showGlobalToast('Không thể sao chép!', 'error');
              });
          }
        }
      });

      // ─── GOOGLE GSI LOAD & BUTTON ───
      let gsiLoaded = false;
      function initGoogleGSIAndButton() {
        const clientId = document.getElementById('login-google-client-id')?.value.trim();
        if (!clientId) {
          const container = document.getElementById('google-test-btn-container');
          if (container) container.innerHTML = `<span class="text-xs text-zinc-500 italic">Vui lòng điền Client ID để hiện nút Google One-Tap Test</span>`;
          return;
        }

        if (gsiLoaded) {
          renderGoogleAdminButton(clientId);
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://accounts.google.com/gsi/client';
        script.async = true;
        script.defer = true;
        script.onload = () => {
          gsiLoaded = true;
          renderGoogleAdminButton(clientId);
        };
        document.head.appendChild(script);
      }

      function renderGoogleAdminButton(clientId) {
        if (typeof google === 'undefined') return;
        
        google.accounts.id.initialize({
          client_id: clientId,
          callback: handleGoogleAdminTestResponse
        });

        const container = document.getElementById('google-test-btn-container');
        if (container) {
          container.innerHTML = '';
          google.accounts.id.renderButton(
            container,
            { theme: 'outline', size: 'large', text: 'signin_with' }
          );
        }

        // Trigger One-Tap prompt in admin for testing if enabled
        const oneTapEnabled = document.getElementById('login-google-onetap')?.checked;
        if (oneTapEnabled) {
          google.accounts.id.prompt();
        }
