  <!-- Toggle Switch CSS -->
  <style>
    .txa-switch { position: relative; display: inline-block; width: 44px; height: 24px; flex-shrink: 0; }
    .txa-switch input { opacity: 0; width: 0; height: 0; }
    .txa-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.08); transition: 0.3s; border-radius: 24px; }
    .txa-slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 2px; bottom: 2px; background: #64748b; transition: 0.3s; border-radius: 50%; }
    .txa-switch input:checked + .txa-slider { background: rgba(167,139,250,0.25); border-color: rgba(167,139,250,0.4); }
    .txa-switch input:checked + .txa-slider:before { transform: translateX(20px); background: #a78bfa; box-shadow: 0 0 8px rgba(167,139,250,0.5); }
  </style>

  <script is:inline define:vars={{ serverSettings: settings }}>
    // ═══════════════════════════════════════════════════════════════════
    //  ADMIN SETTINGS - Phase 3: Client-side Hydration + Full Features
    // ═══════════════════════════════════════════════════════════════════
    (function() {
      // ─── In-memory changelogs state ───
      let changelogsState = [];

      // ─── HYDRATE FROM LOCALSTORAGE (FIX: persistence bug) ───
      function hydrateFromLocalStorage() {
        let stored = null;
        try {
          const raw = localStorage.getItem('txa_site_settings');
          if (raw) stored = JSON.parse(raw);
        } catch (e) {}
        if (!stored) return; // Use server-rendered defaults if no localStorage

        const s = stored;
        // General
        setVal('general-site-name', s.general?.site_name);
        setVal('general-site-url', s.general?.site_url);
        setTextarea('general-site-desc', s.general?.site_description);
        setVal('general-site-keywords', s.general?.site_keywords);
        setVal('general-maintenance-msg', s.general?.maintenance_message);
        setChecked('general-maintenance-enable', s.general?.maintenance_enable);
        // Security
        setChecked('security-encrypt-enable', s.general?.api_encrypt_enable);
        setVal('security-encrypt-pass', s.general?.api_encrypt_pass);
        // App
        setVal('app-version', s.app?.app_version);
        setTextarea('app-release-notes', s.app?.app_release_notes);
        setVal('app-android-url', s.app?.app_android_download_url);
        setVal('app-apk-size', s.app?.app_apk_size);
        setVal('app-apk-sha', s.app?.app_apk_sha256);
        setChecked('app-android-enable', s.app?.app_android_download_enable);
        setChecked('app-ios-ota-enable', s.app?.app_ios_direct_install_enable);
        setVal('app-ios-download-url', s.app?.app_ios_download_url);
        setChecked('app-ios-ipa-enable', s.app?.app_ios_ipa_download_enable);
        setVal('app-ios-ipa-url', s.app?.app_ios_ipa_url);
        setChecked('app-gplay-enable', s.app?.app_google_play_enable);
        setVal('app-gplay-url', s.app?.app_google_play_url);
        setChecked('app-appstore-enable', s.app?.app_app_store_enable);
        setVal('app-appstore-url', s.app?.app_app_store_url);
        if (Array.isArray(s.app?.app_changelogs)) changelogsState = [...s.app.app_changelogs];
        // SMTP
        setVal('smtp-host', s.smtp?.smtp_host);
        setVal('smtp-port', s.smtp?.smtp_port);
        setSelect('smtp-secure', s.smtp?.smtp_secure);
        setVal('smtp-user', s.smtp?.smtp_user);
        setVal('smtp-pass', s.smtp?.smtp_pass);
        setVal('smtp-from-email', s.smtp?.smtp_from_email);
        setVal('smtp-from-name', s.smtp?.smtp_from_name);
        // Telegram
        setVal('telegram-bot-token', s.telegram?.telegram_bot_token);
        setVal('telegram-chat-id', s.telegram?.telegram_chat_id);
        setVal('telegram-channel-id', s.telegram?.telegram_channel_id);
        setChecked('telegram-notify-report', s.telegram?.telegram_notify_report);
        setChecked('telegram-notify-zalo', s.telegram?.telegram_notify_zalo);
        setChecked('telegram-notify-user', s.telegram?.telegram_notify_user);
        setChecked('telegram-notify-luckydraw', s.telegram?.telegram_notify_luckydraw);
        // Login
        setChecked('login-standard-enable', s.login?.login_standard_enable);
        setChecked('login-google-enable', s.login?.login_google_enable);
        setVal('login-google-client-id', s.login?.login_google_client_id);
        setVal('login-google-client-secret', s.login?.login_google_client_secret);
        setChecked('login-google-onetap', s.login?.login_google_onetap_enable);
        setChecked('login-fb-enable', s.login?.login_fb_enable);
        setVal('login-fb-app-id', s.login?.login_fb_app_id);
