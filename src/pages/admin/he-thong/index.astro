      function updateCallbackURIs() {
        const siteUrlInput = document.getElementById('general-site-url');
        const siteUrl = siteUrlInput?.value.trim() || window.location.origin;
        const callbackUri = siteUrl.replace(/\/$/, '') + '/api/auth/txa-callback';
        document.querySelectorAll('.callback-uri-input').forEach(input => {
          input.value = callbackUri;
        });
      }

      document.getElementById('general-site-url')?.addEventListener('input', updateCallbackURIs);

      document.addEventListener('click', (e) => {
