---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { SettingService } from '../../../services/SettingService';

const settings = await SettingService.getSettings();
---

<AdminLayout title="Cấu hình hệ thống">
  <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 mt-4 gap-4">
    <div>
      <h2 class="font-headline-lg text-on-surface text-3xl">Cấu hình hệ thống</h2>
      <p class="text-text-dim text-body-main mt-1">Quản lý toàn bộ tham số cấu hình của ứng dụng.</p>
    </div>
    <div class="flex items-center gap-4">
      <button id="save-settings-btn" class="px-6 py-2 bg-primary text-slate-950 rounded-full font-label-caps font-bold hover:brightness-110 transition-all cursor-pointer flex items-center gap-2 border-none">
        <span class="material-symbols-outlined text-sm">save</span>
        Lưu thay đổi
      </button>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Tabs Sidebar -->
    <div class="lg:col-span-1 flex flex-col gap-2">
      <button id="btn-tab-general" class="w-full text-left px-4 py-3 rounded-xl sidebar-active font-label-caps flex items-center gap-3 cursor-pointer">
        <span class="material-symbols-outlined">settings</span> Chung
      </button>
      <button id="btn-tab-security" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 font-label-caps text-text-dim flex items-center gap-3 transition-colors cursor-pointer">
        <span class="material-symbols-outlined">security</span> API Security
      </button>
      <button id="btn-tab-app" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 font-label-caps text-text-dim flex items-center gap-3 transition-colors cursor-pointer">
        <span class="material-symbols-outlined">smartphone</span> App Mobile
      </button>
      <button id="btn-tab-smtp" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 font-label-caps text-text-dim flex items-center gap-3 transition-colors cursor-pointer">
        <span class="material-symbols-outlined">mail</span> SMTP Mail
      </button>
      <button id="btn-tab-telegram" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 font-label-caps text-text-dim flex items-center gap-3 transition-colors cursor-pointer">
        <span class="material-symbols-outlined">send</span> Telegram
      </button>
      <button id="btn-tab-login" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 font-label-caps text-text-dim flex items-center gap-3 transition-colors cursor-pointer">
        <span class="material-symbols-outlined">login</span> Đăng nhập
      </button>
      <button id="btn-tab-social" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 font-label-caps text-text-dim flex items-center gap-3 transition-colors cursor-pointer">
        <span class="material-symbols-outlined">share</span> Mạng xã hội
      </button>
      <button id="btn-tab-payment" class="w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 font-label-caps text-text-dim flex items-center gap-3 transition-colors cursor-pointer">
        <span class="material-symbols-outlined">payments</span> Cấu hình Thanh toán
      </button>
    </div>

    <!-- Tab Content -->
    <div class="lg:col-span-3 glass-panel rounded-3xl p-8">
      
      <!-- ═══════════════════════════════════════ TAB: CHUNG ═══════════════════════════════════════ -->
      <div id="tab-general" class="space-y-6">
        <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-6">Cài đặt chung</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">Tên Website</label>
            <input type="text" id="general-site-name" value={settings.general.site_name} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">URL Website</label>
            <input type="text" id="general-site-url" value={settings.general.site_url} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-label-caps text-text-dim">Mô tả SEO</label>
            <textarea id="general-site-desc" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none min-h-[100px] text-white">{settings.general.site_description}</textarea>
          </div>
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-label-caps text-text-dim">Từ khóa SEO (ngăn cách bằng dấu phẩy)</label>
            <input type="text" id="general-site-keywords" value={settings.general.site_keywords} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-label-caps text-text-dim">Thông điệp bảo trì</label>
            <input type="text" id="general-maintenance-msg" value={settings.general.maintenance_message} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-label-caps text-text-dim">Chế độ bảo trì</label>
            <div class="flex items-center gap-3">
              <input type="checkbox" id="general-maintenance-enable" checked={settings.general.maintenance_enable} class="w-5 h-5 accent-primary bg-surface-container border-glass-stroke" />
              <span class="text-sm">Bật chế độ bảo trì hệ thống</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══════════════════════════════════════ TAB: API SECURITY ═══════════════════════════════════════ -->
      <div id="tab-security" class="space-y-6 hidden">
        <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-6">API Security (AES-256-GCM)</h3>
        <div class="bg-primary/10 border border-primary/20 rounded-xl p-4 mb-6">
          <p class="text-xs text-primary font-body-main">Lưu ý: Bật tính năng này sẽ mã hóa toàn bộ dữ liệu trả về của API thành định dạng <code>&#123;"d": "...", "v": 1&#125;</code>. App Flutter phải được trang bị khóa giải mã tương ứng.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-label-caps text-text-dim">Mã hóa TXA Payload</label>
            <div class="flex items-center gap-3">
              <input type="checkbox" id="security-encrypt-enable" checked={settings.general.api_encrypt_enable} class="w-5 h-5 accent-primary bg-surface-container border-glass-stroke" />
              <span class="text-sm">Bật mã hóa (api_encrypt_enable)</span>
            </div>
          </div>
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-label-caps text-text-dim">Passphrase (Khóa mã hóa)</label>
            <input type="password" id="security-encrypt-pass" value={settings.general.api_encrypt_pass || ''} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" placeholder="Nhập khóa mã hóa AES-256-GCM..." />
          </div>
        </div>
      </div>

      <!-- ═══════════════════════════════════════ TAB: APP MOBILE ═══════════════════════════════════════ -->
      <div id="tab-app" class="space-y-6 hidden">
        <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-6">Cấu hình Cổng tải & Phiên bản App di động</h3>
        
        <!-- App Version -->
        <div class="space-y-3">
          <label class="text-xs font-label-caps text-text-dim">Phiên bản app hiện tại (app_version)</label>
          <input type="text" id="app-version" value={settings.app.app_version} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          <div class="bg-primary/10 border border-primary/20 rounded-xl p-3 flex items-center gap-2">
            <span class="text-xs text-primary font-bold">ℹ️ Tự động đồng bộ từ changelog mới nhất khi nhấn Lưu cấu hình (nếu có).</span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Android Section -->
          <div class="glass-panel p-5 rounded-2xl border border-glass-stroke space-y-4 hover:border-primary/20 transition-colors">
            <div class="flex items-center justify-between">
              <div class="flex flex-col gap-1">
                <span class="text-sm font-bold text-white flex items-center gap-2">
                  <span class="material-symbols-outlined text-[#3DDC84]" style="font-size:18px">android</span> Tải App cho Android
                </span>
                <span class="text-[10px] text-zinc-500">Cho phép tải tệp tin cài đặt APK trực tiếp.</span>
              </div>
              <label class="txa-switch">
                <input type="checkbox" id="app-android-enable" checked={settings.app.app_android_download_enable} />
                <span class="txa-slider"></span>
              </label>
            </div>
            <div id="android-fields" class="space-y-3 pl-2 border-l-2 border-primary/20 ml-2" style={settings.app.app_android_download_enable ? '' : 'display:none'}>
              <div class="space-y-1">
                <label class="text-[10px] text-zinc-500 font-bold uppercase">Link tải file APK</label>
                <input type="url" id="app-android-url" value={settings.app.app_android_download_url} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 text-xs focus:ring-1 focus:ring-primary focus:outline-none text-white" />
              </div>
              <div class="space-y-1">
                <label class="text-[10px] text-zinc-500 font-bold uppercase">Kích thước tệp tin (Bytes)</label>
                <input type="text" id="app-apk-size" value={settings.app.app_apk_size} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 text-xs focus:ring-1 focus:ring-primary focus:outline-none text-white" />
              </div>
              <div class="space-y-1">
                <label class="text-[10px] text-zinc-500 font-bold uppercase">SHA256 File APK</label>
                <input type="text" id="app-apk-sha" value={settings.app.app_apk_sha256} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 text-xs focus:ring-1 focus:ring-primary focus:outline-none text-white" />
              </div>
            </div>
          </div>

          <!-- iOS Section -->
          <div class="glass-panel p-5 rounded-2xl border border-glass-stroke space-y-4 hover:border-primary/20 transition-colors">
            <span class="text-sm font-bold text-white flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined" style="font-size:18px">phone_iphone</span> Tải & Cài đặt cho iOS (Apple)
            </span>
            <!-- OTA -->
            <div class="border-t border-glass-stroke/50 pt-3">
              <div class="flex items-center justify-between">
                <div class="flex flex-col gap-0.5">
                  <span class="text-xs font-bold text-white">1. Cài đặt trực tiếp (OTA / UDID)</span>
                  <span class="text-[10px] text-zinc-500">Kích hoạt profile, yêu cầu chứng chỉ đăng ký OTA.</span>
                </div>
                <label class="txa-switch">
                  <input type="checkbox" id="app-ios-ota-enable" checked={settings.app.app_ios_direct_install_enable} />
                  <span class="txa-slider"></span>
                </label>
              </div>
              <div id="ios-ota-fields" class="mt-3 pl-2 border-l-2 border-primary/20 ml-2" style={settings.app.app_ios_direct_install_enable ? '' : 'display:none'}>
                <label class="text-[10px] text-zinc-500 font-bold uppercase">Link cài đặt trực tiếp / UDID</label>
                <input type="url" id="app-ios-download-url" value={settings.app.app_ios_download_url} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 text-xs focus:ring-1 focus:ring-primary focus:outline-none text-white mt-1" />
              </div>
            </div>
            <!-- IPA -->
            <div class="border-t border-glass-stroke/50 pt-3">
              <div class="flex items-center justify-between">
                <div class="flex flex-col gap-0.5">
                  <span class="text-xs font-bold text-white">2. Tải tệp tin IPA (Sideload)</span>
                  <span class="text-[10px] text-zinc-500">Tải tệp tin .ipa về máy để tự cài đặt ngoài luồng.</span>
                </div>
                <label class="txa-switch">
                  <input type="checkbox" id="app-ios-ipa-enable" checked={settings.app.app_ios_ipa_download_enable} />
                  <span class="txa-slider"></span>
                </label>
              </div>
              <div id="ios-ipa-fields" class="mt-3 pl-2 border-l-2 border-primary/20 ml-2" style={settings.app.app_ios_ipa_download_enable ? '' : 'display:none'}>
                <label class="text-[10px] text-zinc-500 font-bold uppercase">Link tải tệp IPA (.ipa)</label>
                <input type="url" id="app-ios-ipa-url" value={settings.app.app_ios_ipa_url} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 text-xs focus:ring-1 focus:ring-primary focus:outline-none text-white mt-1" />
              </div>
            </div>
          </div>
        </div>

        <!-- Google Play & App Store -->
        <div class="glass-panel p-5 rounded-2xl border border-glass-stroke space-y-4 hover:border-primary/20 transition-colors">
          <span class="text-sm font-bold text-white flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-primary" style="font-size:18px">store</span> Liên kết Cửa hàng Ứng dụng chính thức
          </span>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Google Play -->
            <div class="border-t border-glass-stroke/50 pt-3 space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex flex-col gap-0.5">
                  <span class="text-xs font-bold text-white flex items-center gap-1"><span class="material-symbols-outlined text-[#3DDC84]" style="font-size:14px">shop</span> Google Play</span>
                  <span class="text-[10px] text-zinc-500">Hiển thị huy hiệu chính thức.</span>
                </div>
                <label class="txa-switch">
                  <input type="checkbox" id="app-gplay-enable" checked={settings.app.app_google_play_enable} />
                  <span class="txa-slider"></span>
                </label>
              </div>
              <div id="gplay-fields" style={settings.app.app_google_play_enable ? '' : 'display:none'}>
                <input type="url" id="app-gplay-url" value={settings.app.app_google_play_url} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 text-xs focus:ring-1 focus:ring-primary focus:outline-none text-white" placeholder="https://play.google.com/store/apps/details?id=..." />
              </div>
            </div>
            <!-- App Store -->
            <div class="border-t border-glass-stroke/50 pt-3 space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex flex-col gap-0.5">
                  <span class="text-xs font-bold text-white flex items-center gap-1"><span class="material-symbols-outlined text-primary" style="font-size:14px">phone_iphone</span> App Store</span>
                  <span class="text-[10px] text-zinc-500">Hiển thị huy hiệu chính thức.</span>
                </div>
                <label class="txa-switch">
                  <input type="checkbox" id="app-appstore-enable" checked={settings.app.app_app_store_enable} />
                  <span class="txa-slider"></span>
                </label>
              </div>
              <div id="appstore-fields" style={settings.app.app_app_store_enable ? '' : 'display:none'}>
                <input type="url" id="app-appstore-url" value={settings.app.app_app_store_url} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 text-xs focus:ring-1 focus:ring-primary focus:outline-none text-white" placeholder="https://apps.apple.com/app/..." />
              </div>
            </div>
          </div>
        </div>

        <!-- Changelogs CRUD -->
        <div class="glass-panel p-5 rounded-2xl border border-glass-stroke space-y-4 hover:border-primary/20 transition-colors mt-4">
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div class="flex flex-col gap-1">
              <span class="text-sm font-bold text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-primary" style="font-size:18px">update</span> Lịch sử Cập nhật & Changelog Chi tiết
              </span>
              <span class="text-[10px] text-zinc-500">Quản lý danh sách nhật ký thay đổi cho từng phiên bản của ứng dụng.</span>
            </div>
            <button id="btn-add-changelog" class="px-4 py-2 bg-primary/15 text-primary border border-primary/25 rounded-xl font-bold text-[11px] uppercase tracking-wider hover:bg-primary/25 hover:text-white transition-all cursor-pointer flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm">add</span> Thêm bản ghi mới
            </button>
          </div>
          <div class="overflow-x-auto border border-glass-stroke rounded-2xl max-h-[400px] overflow-y-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-zinc-950/40 sticky top-0">
                <tr>
                  <th class="px-4 py-3 text-zinc-500 font-bold" style="width:12%">PHIÊN BẢN</th>
                  <th class="px-4 py-3 text-zinc-500 font-bold" style="width:15%">NGÀY RA MẮT</th>
                  <th class="px-4 py-3 text-zinc-500 font-bold" style="width:28%">TIÊU ĐỀ</th>
                  <th class="px-4 py-3 text-zinc-500 font-bold hidden md:table-cell">NỘI DUNG</th>
                  <th class="px-4 py-3 text-zinc-500 font-bold text-right" style="width:130px">THAO TÁC</th>
                </tr>
              </thead>
              <tbody id="changelogTableBody" class="divide-y divide-glass-stroke/40">
                <!-- Populated dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ═══════════════════════════════════════ TAB: SMTP ═══════════════════════════════════════ -->
      <div id="tab-smtp" class="space-y-6 hidden">
        <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-6">Cấu hình SMTP Mail</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">SMTP Host</label>
            <input type="text" id="smtp-host" value={settings.smtp.smtp_host} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">SMTP Port</label>
            <input type="number" id="smtp-port" value={settings.smtp.smtp_port} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">SMTP Secure</label>
            <select id="smtp-secure" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-zinc-300">
              <option value="SSL" selected={settings.smtp.smtp_secure === "SSL"}>SSL (Port 465)</option>
              <option value="TLS" selected={settings.smtp.smtp_secure === "TLS"}>TLS (Port 587)</option>
              <option value="NONE" selected={settings.smtp.smtp_secure === "NONE"}>Không (No security)</option>
            </select>
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">SMTP User</label>
            <input type="text" id="smtp-user" value={settings.smtp.smtp_user} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">SMTP Password</label>
            <input type="password" id="smtp-pass" value={settings.smtp.smtp_pass} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">SMTP From Email</label>
            <input type="email" id="smtp-from-email" value={settings.smtp.smtp_from_email} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">SMTP From Name</label>
            <input type="text" id="smtp-from-name" value={settings.smtp.smtp_from_name} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" />
          </div>
        </div>
        <!-- SMTP Test Button -->
        <div class="flex items-center gap-4 flex-wrap mt-4">
          <button id="btn-smtp-test" class="px-5 py-2.5 bg-primary text-slate-950 rounded-xl font-bold text-[11px] uppercase tracking-wider hover:brightness-110 transition-all cursor-pointer flex items-center gap-2 border-none">
            <span class="material-symbols-outlined text-sm">mail</span> Gửi email test
          </button>
          <div id="smtp-status" class="hidden px-4 py-2 rounded-xl bg-amber-500/10 border border-amber-500/20">
            <span class="text-xs text-amber-400 font-bold uppercase">Cấu hình chưa đầy đủ</span>
          </div>
        </div>
      </div>

      <!-- ═══════════════════════════════════════ TAB: TELEGRAM ═══════════════════════════════════════ -->
      <div id="tab-telegram" class="space-y-6 hidden">
        <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-6">Kết nối & Xác thực Telegram Bot</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-label-caps text-text-dim">Bot Token</label>
            <input type="password" id="telegram-bot-token" value={settings.telegram.telegram_bot_token} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white" placeholder="Bot Token lấy từ @BotFather" />
          </div>
          <div class="space-y-2">
