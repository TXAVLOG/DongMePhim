---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="iOS Management">
  <div class="p-gutter space-y-section-gap max-w-container-max mx-auto pb-10">
    <!-- Header -->
    <header class="flex items-center justify-between mb-8 z-40 relative">
      <div>
        <h2 class="font-headline-lg text-on-surface text-2xl">Quản lý Thiết bị &amp; iOS Certificate</h2>
        <p class="text-body-main text-on-surface-variant text-sm mt-1">Quản lý hạ tầng ký app và phân phối iOS</p>
      </div>
      <div class="flex items-center gap-4">
        <button class="w-10 h-10 flex items-center justify-center rounded-full glass-panel hover:bg-surface-variant transition-colors cursor-pointer text-on-surface-variant">
          <span class="material-symbols-outlined">notifications</span>
        </button>
        <button class="bg-primary hover:bg-primary/90 px-6 py-2.5 rounded-full flex items-center gap-2 text-on-primary-fixed font-bold shadow-lg shadow-primary/20 transition-all cursor-pointer">
          <span class="material-symbols-outlined">upload_file</span>
          Upload chứng chỉ mới
        </button>
      </div>
    </header>

    <!-- Statistics Overview -->
    <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
      <div class="glass-panel p-6 rounded-xl">
        <p class="text-label-caps text-on-surface-variant uppercase text-xs">Tổng số Certificate</p>
        <div class="flex items-end justify-between mt-2">
          <span class="text-headline-lg font-display-hero text-3xl text-on-surface">12</span>
          <span class="text-primary flex items-center text-sm font-bold"><span class="material-symbols-outlined text-sm">trending_up</span> +2</span>
        </div>
      </div>
      <div class="glass-panel p-6 rounded-xl">
        <p class="text-label-caps text-on-surface-variant uppercase text-xs">Chứng chỉ hợp lệ</p>
        <div class="flex items-end justify-between mt-2">
          <span class="text-headline-lg font-display-hero text-secondary-fixed text-3xl">08</span>
          <span class="bg-secondary/10 text-secondary px-2 py-0.5 rounded text-[10px] font-bold border border-secondary/20">STABLE</span>
        </div>
      </div>
      <div class="glass-panel p-6 rounded-xl border border-error/30">
        <p class="text-label-caps text-on-surface-variant uppercase text-xs">Sắp hết hạn</p>
        <div class="flex items-end justify-between mt-2">
          <span class="text-headline-lg font-display-hero text-error text-3xl">03</span>
          <span class="text-error text-xs animate-pulse font-bold uppercase">Cần gia hạn</span>
        </div>
      </div>
      <div class="glass-panel p-6 rounded-xl">
        <p class="text-label-caps text-on-surface-variant uppercase text-xs">Thiết bị Active</p>
        <div class="flex items-end justify-between mt-2">
          <span class="text-headline-lg font-display-hero text-3xl text-on-surface">1,240</span>
          <span class="text-on-surface-variant text-sm">Max 5,000</span>
        </div>
      </div>
    </section>

    <!-- Certificate List -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-6">
        <h3 class="font-headline-lg-mobile md:text-headline-lg flex items-center gap-3 text-on-surface text-xl">
          <span class="material-symbols-outlined text-primary">security</span>
          Danh sách Certificate (.p12)
        </h3>
        <div class="flex gap-2">
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
            <input class="bg-surface-container border border-glass-stroke rounded-lg pl-10 pr-4 py-2 text-sm focus:ring-1 focus:ring-primary focus:border-primary text-on-surface outline-none transition-all" placeholder="Tìm tên chứng chỉ..." type="text"/>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Certificate Card 1 -->
        <div class="glass-panel p-6 rounded-xl transition-all duration-300 relative overflow-hidden group hover:border-primary hover:shadow-[0_0_15px_rgba(210,187,255,0.15)]">
          <div class="absolute top-0 right-0 p-4">
            <span class="px-3 py-1 rounded-full bg-secondary-fixed/20 text-secondary-fixed text-[10px] font-bold uppercase tracking-wider">Hợp lệ</span>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-lg bg-primary-container/20 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-3xl">badge</span>
            </div>
            <div>
              <h4 class="font-title-md text-on-surface mb-1 font-bold">Apple Distribution: DongPhim Ltd.</h4>
              <p class="text-sm text-on-surface-variant font-mono">ID: W87A...92KL</p>
            </div>
          </div>
          <div class="mt-8 space-y-3">
            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant">Ngày hết hạn:</span>
              <span class="font-medium text-on-surface">12 Th04, 2025</span>
            </div>
            <div class="w-full bg-surface-container-highest rounded-full h-1.5 overflow-hidden">
              <div class="bg-secondary-fixed h-full w-3/4 rounded-full"></div>
            </div>
            <div class="flex justify-between items-center pt-2">
              <button class="text-sm text-primary hover:underline font-bold flex items-center gap-1 cursor-pointer">
                <span class="material-symbols-outlined text-sm">download</span> Tải về .p12
              </button>
              <button class="text-on-surface-variant hover:text-error transition-colors cursor-pointer">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Certificate Card 2 (Expiring) -->
        <div class="glass-panel p-6 rounded-xl border border-error/20 transition-all duration-300 relative overflow-hidden bg-error-container/5 hover:border-error/50">
          <div class="absolute top-0 right-0 p-4">
            <span class="px-3 py-1 rounded-full bg-error/20 text-error text-[10px] font-bold uppercase tracking-wider animate-pulse border border-error/20">Sắp hết hạn</span>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-lg bg-error-container/20 flex items-center justify-center text-error">
              <span class="material-symbols-outlined text-3xl">warning</span>
            </div>
            <div>
              <h4 class="font-title-md text-on-surface mb-1 font-bold">Developer ID: Tran Van A</h4>
              <p class="text-sm text-on-surface-variant font-mono">ID: BX12...L33P</p>
            </div>
          </div>
          <div class="mt-8 space-y-3">
            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant">Ngày hết hạn:</span>
              <span class="font-bold text-error">15 Th12, 2024</span>
            </div>
            <div class="w-full bg-surface-container-highest rounded-full h-1.5 overflow-hidden">
              <div class="bg-error h-full w-[92%] rounded-full"></div>
            </div>
            <div class="flex justify-between items-center pt-2">
              <button class="text-sm text-primary hover:underline font-bold cursor-pointer">Gia hạn ngay</button>
              <button class="text-on-surface-variant hover:text-error transition-colors cursor-pointer">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Add New Card Skeleton -->
        <div class="glass-panel border-dashed border-2 border-glass-stroke p-6 rounded-xl flex flex-col items-center justify-center gap-4 hover:border-primary group cursor-pointer transition-all">
          <div class="w-14 h-14 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant group-hover:text-primary group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-4xl">add</span>
          </div>
          <p class="font-title-md text-on-surface-variant group-hover:text-primary transition-colors">Thêm Certificate mới</p>
        </div>
      </div>
    </section>

    <!-- Device Management Section -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h3 class="font-headline-lg-mobile md:text-headline-lg flex items-center gap-3 text-on-surface text-xl">
          <span class="material-symbols-outlined text-secondary-fixed">devices</span>
          Quản lý Thiết bị Phân phối
        </h3>
      </div>
      <div class="glass-panel rounded-xl overflow-hidden">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-surface-container-low border-b border-glass-stroke">
              <th class="px-6 py-4 font-label-caps text-on-surface-variant uppercase tracking-widest text-[10px]">Tên thiết bị</th>
              <th class="px-6 py-4 font-label-caps text-on-surface-variant uppercase tracking-widest text-[10px]">UDID</th>
              <th class="px-6 py-4 font-label-caps text-on-surface-variant uppercase tracking-widest text-[10px]">Loại</th>
              <th class="px-6 py-4 font-label-caps text-on-surface-variant uppercase tracking-widest text-[10px]">Ngày Active</th>
              <th class="px-6 py-4 font-label-caps text-on-surface-variant uppercase tracking-widest text-[10px]">Trạng thái</th>
              <th class="px-6 py-4 font-label-caps text-on-surface-variant uppercase tracking-widest text-[10px]">Thao tác</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-glass-stroke">
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-on-surface-variant">smartphone</span>
                  <span class="font-medium text-on-surface">iPhone 15 Pro Max</span>
                </div>
              </td>
              <td class="px-6 py-4 font-mono text-xs text-on-surface-variant">00008120-001A25E81A...</td>
              <td class="px-6 py-4 text-sm text-on-surface">Personal</td>
              <td class="px-6 py-4 text-sm text-on-surface">20/11/2024</td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 rounded bg-secondary-fixed/10 text-secondary-fixed text-[10px] font-bold border border-secondary-fixed/20">ACTIVE</span>
              </td>
              <td class="px-6 py-4">
                <button class="text-on-surface-variant hover:text-error transition-colors cursor-pointer"><span class="material-symbols-outlined text-sm">block</span></button>
              </td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-on-surface-variant">tablet_mac</span>
                  <span class="font-medium text-on-surface">iPad Pro M2</span>
                </div>
              </td>
              <td class="px-6 py-4 font-mono text-xs text-on-surface-variant">00008103-000E089C0C...</td>
              <td class="px-6 py-4 text-sm text-on-surface">Development</td>
              <td class="px-6 py-4 text-sm text-on-surface">18/11/2024</td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 rounded bg-secondary-fixed/10 text-secondary-fixed text-[10px] font-bold border border-secondary-fixed/20">ACTIVE</span>
              </td>
              <td class="px-6 py-4">
                <button class="text-on-surface-variant hover:text-error transition-colors cursor-pointer"><span class="material-symbols-outlined text-sm">block</span></button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>
