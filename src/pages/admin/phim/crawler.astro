    // URL slug parser helper
    function extractSlug(input) {
      const trimmed = input.trim();
      if (!trimmed) return null;
      
      if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) {
        try {
          const url = new URL(trimmed);
          const pathname = url.pathname;
          const parts = pathname.split('/').filter(Boolean);
          if (parts.length > 0) {
            return parts[parts.length - 1];
          }
        } catch (e) {
          const match = trimmed.match(/(?:phim|detail|chitet|info)\/([a-zA-Z0-9\-]+)/);
          if (match) return match[1];
        }
      }
      
      const cleanSlug = trimmed.split('/').filter(Boolean).pop();
      if (cleanSlug && /^[a-zA-Z0-9\-]+$/.test(cleanSlug)) {
        return cleanSlug;
      }
      return trimmed;
    }

    // Dynamic count input slugs
    const crawlUrlsInput = document.getElementById('crawlUrlsInput');
    const detectCountText = document.getElementById('detectCountText');

    function updateDetectCount() {
      const lines = crawlUrlsInput.value.split('\n').map(l => l.trim()).filter(Boolean);
      let valid = 0;
      lines.forEach(line => {
        const slug = extractSlug(line);
        if (slug) valid++;
      });
      detectCountText.innerHTML = `<span class="material-symbols-outlined text-sm text-emerald-400">check_circle</span> Phát hiện ${valid} phim hợp lệ từ dòng nhập.`;
    }
    crawlUrlsInput.addEventListener('input', updateDetectCount);

    // File upload handler for TXT files
    const crawlTxtUpload = document.getElementById('crawlTxtUpload');
    const uploadText = document.getElementById('uploadText');
    const uploadIcon = document.getElementById('uploadIcon');

    crawlTxtUpload.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      uploadText.textContent = `Đang đọc file: ${file.name}...`;
      uploadIcon.className = 'material-symbols-outlined text-2xl text-primary animate-spin';
      uploadIcon.textContent = 'sync';

      const reader = new FileReader();
      reader.onload = (event) => {
        const text = event.target.result;
        const lines = text.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
        
        const validLines = [];
        let invalidCount = 0;
        
        lines.forEach(line => {
          const slug = extractSlug(line);
          if (slug) {
            validLines.push(line);
          } else {
            invalidCount++;
          }
        });

        // Populate textarea and update count
        crawlUrlsInput.value = validLines.join('\n');
        updateDetectCount();

        uploadText.textContent = `Đã tải: ${file.name} (${validLines.length} dòng)`;
        uploadIcon.className = 'material-symbols-outlined text-2xl text-emerald-400';
        uploadIcon.textContent = 'check_circle';

        if (invalidCount > 0) {
          if (window.showGlobalToast) {
            window.showGlobalToast(`Đã bỏ qua ${invalidCount} dòng không hợp lệ!`, 'warning');
          }
          addLog(`⚠️ Đã tải file .txt nhưng phát hiện ${invalidCount} dòng không hợp lệ và bị bỏ qua.`, 'warning');
        } else {
          if (window.showGlobalToast) {
            window.showGlobalToast(`Đã tải thành công ${validLines.length} dòng!`, 'success');
          }
          addLog(`✓ Đã tải thành công ${validLines.length} phim từ file .txt.`, 'success');
        }
      };

      reader.onerror = () => {
        uploadText.textContent = 'Lỗi khi đọc file!';
        uploadIcon.className = 'material-symbols-outlined text-2xl text-red-400';
        uploadIcon.textContent = 'error';
        if (window.showGlobalToast) window.showGlobalToast('Lỗi khi đọc file TXT!', 'error');
      };

      reader.readAsText(file);
    });

    // Logs helper
    const logTerminalBody = document.getElementById('logTerminalBody');
    const clearLogsBtn = document.getElementById('clearLogsBtn');

    function addLog(text, type = 'info') {
      const timeStr = new Date().toLocaleTimeString('vi-VN');
      let colorClass = 'text-zinc-400';
      if (type === 'success') colorClass = 'text-emerald-400 font-bold';
      else if (type === 'error') colorClass = 'text-red-400 font-bold';
      else if (type === 'warning') colorClass = 'text-yellow-400';
      else if (type === 'system') colorClass = 'text-primary';

      const line = document.createElement('div');
      line.className = `flex gap-2 py-0.5 border-b border-glass-stroke/10 ${colorClass}`;
      line.innerHTML = `<span class="text-zinc-600 shrink-0 select-none">[${timeStr}]</span> <span>${text}</span>`;
      logTerminalBody.appendChild(line);
      logTerminalBody.scrollTop = logTerminalBody.scrollHeight;
    }

    clearLogsBtn.addEventListener('click', () => {
      logTerminalBody.innerHTML = '<div class="text-zinc-600">Console cleared. Ready.</div>';
    });

    // Load list local crawled movies & dictionaries
    let crawledListCache = [];

    // Load list local crawled movies & dictionaries from database
    async function loadExistingMoviesDict() {
      try {
        const res = await fetch('/api/admin/movie-action?action=list');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (data.status !== 'success' || !data.data) {
          throw new Error(data.message || 'Lỗi API');
        }
        
        const list = data.data;
        crawledListCache = list;

        existingMoviesMap = {};
        list.forEach(m => {
          let count = 0;
          const eps = m.episodes || [];
          eps.forEach(srv => {
            const serverData = srv.serverData || srv.server_data || [];
            count = Math.max(count, serverData.length || 0);
          });
          existingMoviesMap[m.slug] = count;
        });
      } catch (e) {
        console.error('Error fetching dynamic movies:', e);
      }
    }

    function renderCrawledList() {
      const list = crawledListCache;

      document.getElementById('crawledCount').textContent = list.length;
      const crawledMoviesBody = document.getElementById('crawledMoviesBody');
      const emptyCrawled = document.getElementById('emptyCrawled');
      const crawledPagination = document.getElementById('crawledPagination');

      if (list.length === 0) {
        crawledMoviesBody.innerHTML = '';
        emptyCrawled.classList.remove('hidden');
        if (crawledPagination) crawledPagination.classList.add('hidden');
        return;
      }
      emptyCrawled.classList.add('hidden');
      if (crawledPagination) crawledPagination.classList.remove('hidden');

      // Pagination math
      const totalItems = list.length;
      const totalPages = Math.ceil(totalItems / crawledLimit) || 1;
      if (crawledCurrentPage > totalPages) crawledCurrentPage = totalPages;
      if (crawledCurrentPage < 1) crawledCurrentPage = 1;

      const startIndex = (crawledCurrentPage - 1) * crawledLimit;
      const endIndex = startIndex + crawledLimit;
      const paginatedList = list.slice(startIndex, endIndex);

      // Trigger animation
      crawledMoviesBody.classList.remove('animate-fade-in');
      void crawledMoviesBody.offsetWidth;
      crawledMoviesBody.classList.add('animate-fade-in');

      crawledMoviesBody.innerHTML = paginatedList.map((m) => {
        // Count subtitles and skip timings configured directly in the movie episodes
        let subCount = 0;
        let skipConfigured = false;
        
        const eps = m.episodes || [];
        eps.forEach(srv => {
          const data = srv.serverData || srv.server_data || [];
          data.forEach(ep => {
            if (ep.subtitles && ep.subtitles.length > 0) subCount += ep.subtitles.length;
            if (ep.timeIntroStart > 0 || ep.timeOutroStart > 0 || ep.time_intro_start > 0 || ep.time_outro_start > 0) skipConfigured = true;
          });
        });

        let configBadge = '';
        if (subCount > 0 || skipConfigured) {
          configBadge = `
            <div class="flex items-center gap-1 mt-1">
              ${subCount > 0 ? `<span class="bg-primary/20 text-primary border border-primary/30 rounded px-1 text-[9px] font-bold">CC (${subCount})</span>` : ''}
              ${skipConfigured ? '<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded px-1 text-[9px] font-bold">SKIP TIMINGS</span>' : ''}
            </div>
          `;
        } else {
          configBadge = '<span class="text-[10px] text-zinc-600">Trống (Mặc định)</span>';
        }

        return `
          <tr class="border-b border-glass-stroke/50 hover:bg-white/5 transition-colors">
            <td class="px-6 py-4">
              <div class="w-12 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke">
                <img src="${m.posterUrl || '/logo.png'}" class="w-full h-full object-cover" onerror="this.src='/logo.png'" alt="Poster" />
              </div>
            </td>
            <td class="px-6 py-4 font-semibold text-white">
              <a href="/phim/${m.slug}" target="_blank" class="hover:text-primary transition-colors">${m.title || m.name}</a>
              <div class="text-[10px] text-zinc-500 font-mono mt-0.5">${m.originalTitle || m.origin_name || ''}</div>
            </td>
            <td class="px-6 py-4 text-zinc-400">${(m.genres || []).join(', ') || m.category || 'N/A'}</td>
            <td class="px-6 py-4 text-zinc-400 font-medium">${m.category || 'Khác'} / ${m.releaseYear || m.year || 'N/A'}</td>
            <td class="px-6 py-4">
              <span class="px-2 py-0.5 rounded bg-zinc-950 border border-glass-stroke text-[11px] font-semibold">${m.episodeCurrent || 'Full'}</span>
            </td>
            <td class="px-6 py-4">
              ${configBadge}
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex gap-2 justify-end">
                <a href="/admin/phim/edit?th=${m.slug}" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center hover:text-primary hover:border-primary/50 transition-colors cursor-pointer" data-txatooltip="Cấu hình / Sửa">
                  <span class="material-symbols-outlined text-sm">settings</span>
