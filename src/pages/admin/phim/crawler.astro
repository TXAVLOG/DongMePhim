      async function fetchFilterMetadata() {
        addLog('⏳ Đang đồng bộ danh sách Quốc gia và Thể loại...');
        
        try {
          // 1. Fetch KKPhim metadata
          const [kkGenresRes, kkCountriesRes] = await Promise.all([
            fetch('https://phimapi.com/the-loai').then(r => r.json().catch(() => [])),
            fetch('https://phimapi.com/quoc-gia').then(r => r.json().catch(() => []))
          ]);

          kkphimGenres = Array.isArray(kkGenresRes) ? kkGenresRes : [];
          kkphimCountries = Array.isArray(kkCountriesRes) ? kkCountriesRes : [];

          // 2. Fetch TMDB metadata
          const [tmdbMovieGenresRes, tmdbTvGenresRes, tmdbCountriesRes] = await Promise.all([
            fetch('/api/tmdb-proxy?path=/3/genre/movie/list&language=vi-VN').then(r => r.json().catch(() => ({ genres: [] }))),
            fetch('/api/tmdb-proxy?path=/3/genre/tv/list&language=vi-VN').then(r => r.json().catch(() => ({ genres: [] }))),
            fetch('/api/tmdb-proxy?path=/3/configuration/countries&language=vi-VN').then(r => r.json().catch(() => []))
          ]);

          // Combine TMDB movie & tv genres, avoid duplicates
          const genreMap = new Map();
          if (tmdbMovieGenresRes && Array.isArray(tmdbMovieGenresRes.genres)) {
            tmdbMovieGenresRes.genres.forEach(g => genreMap.set(g.id, g.name));
          }
          if (tmdbTvGenresRes && Array.isArray(tmdbTvGenresRes.genres)) {
            tmdbTvGenresRes.genres.forEach(g => {
              if (!genreMap.has(g.id)) {
                genreMap.set(g.id, g.name);
              } else {
                const existing = genreMap.get(g.id);
                if (existing !== g.name && !existing.includes(g.name)) {
                  genreMap.set(g.id, `${existing} / ${g.name}`);
                }
              }
            });
          }
          tmdbGenres = Array.from(genreMap.entries()).map(([id, name]) => ({ id, name }));

          // Format TMDB countries: use native_name or english_name
          tmdbCountries = Array.isArray(tmdbCountriesRes) 
            ? tmdbCountriesRes.map(c => ({
                code: c.iso_3166_1,
                name: c.native_name || c.english_name
              })).sort((a, b) => a.name.localeCompare(b.name, 'vi'))
            : [];

          addLog(`✓ Đồng bộ thành công: KKPhim (${kkphimCountries.length} quốc gia, ${kkphimGenres.length} thể loại), TMDB (${tmdbCountries.length} quốc gia, ${tmdbGenres.length} thể loại).`, 'success');
          
          populateFilterDropdowns();
        } catch (e) {
          console.error(e);
          addLog(`⚠️ Không thể tự động đồng bộ danh sách đầy đủ: ${e.message}. Sử dụng danh sách dự phòng.`, 'warning');
          useFallbackFilters();
        }
      }

