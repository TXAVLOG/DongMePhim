---
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Thu thập phim (Crawler) - Nâng cao">
  <header class="mb-8 mt-4">
    <a href="/admin" class="text-zinc-400 hover:text-primary text-xs font-bold flex items-center gap-1 mb-2 transition-colors">
      <span class="material-symbols-outlined text-sm">arrow_back</span> QUAY LẠI TỔNG QUAN
    </a>
    <h1 class="font-display-hero text-3xl font-extrabold text-white tracking-tight">Thu thập phim (Crawler) Nâng cao</h1>
    <p class="text-zinc-400 text-sm mt-1">Cào phim nhanh từ nguồn API bằng URL, tìm kiếm trực tuyến để thêm vào giỏ hàng cào hàng loạt, hoặc cào theo thể loại, quốc gia.</p>
  </header>

  <!-- Main Crawler Tabs -->
  <div class="flex flex-wrap border-b border-glass-stroke gap-4 mb-6">
    <button id="tabKkphimBtn" class="pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer flex items-center gap-1.5">
      <span class="material-symbols-outlined text-sm">movie</span> KKPhim API Pro
    </button>
    <button id="tabVsmovBtn" class="pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer flex items-center gap-1.5">
      <span class="material-symbols-outlined text-sm">link</span> VSMOV API Pro
    </button>
    <button id="tabTmdbBtn" class="pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer flex items-center gap-1.5">
      <span class="material-symbols-outlined text-sm">globe</span> TMDB API
    </button>
    <button id="tabAdvancedBtn" class="pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer flex items-center gap-1.5">
      <span class="material-symbols-outlined text-sm">shopping_cart</span> Tìm kiếm &amp; Giỏ hàng
    </button>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 mb-10">
    
    <!-- Left panel: Settings & Controls -->
    <div class="xl:col-span-4 space-y-6">
      <!-- Hidden controls for backward compatibility -->
      <input type="hidden" id="crawlSource" value="kkphim" />

      <!-- General Configuration (Overwrite checkbox) -->
      <div class="glass-panel rounded-2xl p-6 border border-glass-stroke shadow-2xl">
        <div class="flex items-center gap-2 mb-2">
          <span class="material-symbols-outlined text-primary text-xl">tune</span>
          <h2 class="font-bold text-sm text-white uppercase tracking-wider">Cấu hình chung</h2>
        </div>
        <div class="flex items-center gap-3 py-1">
          <input class="rounded border-glass-stroke bg-zinc-950 text-primary focus:ring-primary w-4 h-4 cursor-pointer" id="overwrite" type="checkbox" checked />
          <label class="text-xs text-zinc-400 cursor-pointer select-none" for="overwrite">Ghi đè phim đã cào (Cập nhật tập mới)</label>
        </div>
      </div>

      <!-- PANEL KKPHIM PRO -->
      <div id="panelKkphim" class="glass-panel rounded-2xl p-6 border border-glass-stroke space-y-4">
        <div class="flex items-center gap-2 mb-2">
          <span class="material-symbols-outlined text-primary text-xl font-bold">movie</span>
          <h2 class="font-bold text-sm text-white uppercase tracking-wider font-display-hero">Cấu hình KKPhim API Pro</h2>
        </div>
        
        <div>
          <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Phương thức thu thập</label>
          <select id="kkphimMode" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary font-bold">
            <option value="new_updated">🆕 Mới cập nhật (Mặc định)</option>
            <option value="by_type">🗂️ Danh sách theo loại phim</option>
            <option value="by_genre">🏷️ Lọc theo thể loại</option>
            <option value="by_country">🌍 Lọc theo quốc gia</option>
            <option value="by_year">📅 Lọc theo năm phát hành</option>
            <option value="by_search">🔍 Tìm kiếm &amp; cào từ khóa</option>
            <option value="direct_slug">📝 Nhập URL / Slugs thủ công</option>
          </select>
        </div>

        <!-- KKPhim blocks -->
        <!-- 1. Mới cập nhật -->
        <div id="kkphimBlockNewUpdated" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="kkphimNewPageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none focus:ring-1 focus:ring-primary" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="kkphimNewPageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none focus:ring-1 focus:ring-primary" type="number" min="1" value="1"/>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Phiên bản API</label>
            <select id="kkphimApiVersion" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary font-bold">
              <option value="v3" selected>Version 3 (Khuyên dùng)</option>
              <option value="v2">Version 2</option>
              <option value="v1">Version 1 (Bản cũ)</option>
            </select>
          </div>
        </div>

        <!-- 2. Theo loại phim -->
        <div id="kkphimBlockType" class="space-y-4 hidden">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Loại phim</label>
              <select id="kkphimType" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 focus:outline-none text-xs focus:ring-1 focus:ring-primary">
                <option value="phim-le">Phim Lẻ</option>
                <option value="phim-bo">Phim Bộ</option>
                <option value="hoat-hinh">Hoạt Hình</option>
                <option value="tv-shows">TV Shows</option>
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Định dạng API</label>
              <select id="kkphimTypeFormat" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 focus:outline-none text-xs focus:ring-1 focus:ring-primary font-bold">
                <option value="format2" selected>Format 2 (/v1/api/...)</option>
                <option value="format1">Format 1 (Classic)</option>
              </select>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="kkphimTypePageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="kkphimTypePageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Số lượng phim / trang</label>
            <input id="kkphimTypeLimit" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" max="100" value="20"/>
          </div>
        </div>

        <!-- 3. Theo thể loại -->
        <div id="kkphimBlockGenre" class="space-y-4 hidden">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Chọn Thể loại</label>
            <select id="kkphimSelectedGenre" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary">
              <!-- Populated dynamically -->
            </select>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="kkphimGenrePageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="kkphimGenrePageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Số lượng phim / trang</label>
            <input id="kkphimGenreLimit" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" max="100" value="20"/>
          </div>
        </div>

        <!-- 4. Theo quốc gia -->
        <div id="kkphimBlockCountry" class="space-y-4 hidden">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Chọn Quốc gia</label>
            <select id="kkphimSelectedCountry" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary">
              <!-- Populated dynamically -->
            </select>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="kkphimCountryPageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="kkphimCountryPageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Số lượng phim / trang</label>
            <input id="kkphimCountryLimit" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" max="100" value="20"/>
          </div>
        </div>

        <!-- 5. Theo năm -->
        <div id="kkphimBlockYear" class="space-y-4 hidden">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Chọn Năm phát hành</label>
            <select id="kkphimSelectedYear" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary">
              <!-- Populated dynamically -->
            </select>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="kkphimYearPageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="kkphimYearPageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Số lượng phim / trang</label>
            <input id="kkphimYearLimit" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" max="100" value="20"/>
          </div>
        </div>

        <!-- 6. Theo từ khóa -->
        <div id="kkphimBlockSearch" class="space-y-4 hidden">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Từ khóa tìm kiếm</label>
            <input id="kkphimSearchKeyword" type="text" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary" placeholder="Nhập từ khóa... (VD: avengers)"/>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="kkphimSearchPageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="kkphimSearchPageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Số lượng phim / trang</label>
            <input id="kkphimSearchLimit" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" max="100" value="20"/>
          </div>
        </div>

        <!-- 7. Nhập URL / Slugs thủ công -->
        <div id="kkphimBlockDirect" class="space-y-4 hidden">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Nhập URL phim hoặc Slugs (Mỗi dòng 1 phim)</label>
            <textarea id="kkphimUrlsInput" rows="4" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-xs font-mono placeholder:text-zinc-700" placeholder="https://kkphim1.com/phim/digimon-beatbreak&#10;tro-choi-con-muc"></textarea>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Hoặc Tải lên file TXT</label>
            <div class="relative flex items-center justify-center border-2 border-dashed border-glass-stroke rounded-xl p-4 hover:border-primary/50 transition-all bg-zinc-950/40">
              <input type="file" id="kkphimTxtUpload" accept=".txt" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
              <div class="text-center space-y-1">
                <span class="material-symbols-outlined text-xl text-zinc-500" id="kkphimUploadIcon">upload_file</span>
                <p class="text-[11px] text-zinc-400 font-bold" id="kkphimUploadText">Nhập hoặc kéo thả file .txt</p>
              </div>
            </div>
          </div>
          <div class="text-[10px] text-zinc-500 italic flex items-center gap-1" id="kkphimDetectCountText">
            <span class="material-symbols-outlined text-xs">check_circle</span> Phát hiện 0 phim hợp lệ.
          </div>
        </div>

        <!-- Action Button standard cào -->
        <div class="flex gap-2 pt-2">
          <button id="startKkphimBtn" class="flex-1 bg-gradient-to-r from-primary to-secondary hover:brightness-110 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer text-xs">
            <span class="material-symbols-outlined text-lg">play_arrow</span> Bắt đầu cào KKPhim
          </button>
        </div>
      </div>

      <!-- PANEL VSMOV PRO -->
      <div id="panelVsmov" class="glass-panel rounded-2xl p-6 border border-glass-stroke space-y-4 hidden">
        <div class="flex items-center gap-2 mb-2">
          <span class="material-symbols-outlined text-secondary text-xl font-bold">link</span>
          <h2 class="font-bold text-sm text-white uppercase tracking-wider font-display-hero">Cấu hình VSMOV API Pro</h2>
        </div>
        
        <div>
          <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Phương thức thu thập</label>
          <select id="vsmovMode" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary font-bold">
            <option value="new_updated">🆕 Mới cập nhật (Mặc định)</option>
            <option value="by_type">🗂️ Danh sách theo loại phim</option>
            <option value="by_genre">🏷️ Lọc theo thể loại</option>
            <option value="by_country">🌍 Lọc theo quốc gia</option>
            <option value="by_year">📅 Lọc theo năm phát hành</option>
            <option value="by_code">🎟️ Lọc theo mã Code (Showtimes)</option>
            <option value="by_search">🔍 Tìm kiếm &amp; cào từ khóa</option>
            <option value="direct_slug">📝 Nhập URL / Slugs thủ công</option>
          </select>
        </div>

        <!-- VSMOV blocks -->
        <!-- 1. Mới cập nhật -->
        <div id="vsmovBlockNewUpdated" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="vsmovNewPageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none focus:ring-1 focus:ring-primary" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="vsmovNewPageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none focus:ring-1 focus:ring-primary" type="number" min="1" value="1"/>
            </div>
          </div>
        </div>

        <!-- 2. Theo loại phim -->
        <div id="vsmovBlockType" class="space-y-4 hidden">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Loại phim</label>
            <select id="vsmovType" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 focus:outline-none text-xs focus:ring-1 focus:ring-primary">
              <option value="single">Phim Lẻ (single)</option>
              <option value="series">Phim Bộ (series)</option>
              <option value="hoathinh">Hoạt Hình (hoathinh)</option>
              <option value="tvshows">TV Shows (tvshows)</option>
            </select>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="vsmovTypePageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="vsmovTypePageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Số lượng phim / trang</label>
            <input id="vsmovTypeLimit" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" max="100" value="20"/>
          </div>
        </div>

        <!-- 3. Theo thể loại -->
        <div id="vsmovBlockGenre" class="space-y-4 hidden">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Chọn Thể loại</label>
            <select id="vsmovSelectedGenre" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary">
              <!-- Populated dynamically -->
            </select>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="vsmovGenrePageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="vsmovGenrePageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Số lượng phim / trang</label>
            <input id="vsmovGenreLimit" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" max="100" value="20"/>
          </div>
        </div>

        <!-- 4. Theo quốc gia -->
        <div id="vsmovBlockCountry" class="space-y-4 hidden">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Chọn Quốc gia</label>
            <select id="vsmovSelectedCountry" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary">
              <!-- Populated dynamically -->
            </select>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
