    searchOnlineBtn.addEventListener('click', async () => {
      const keyword = searchKeywordInput.value.trim();
      if (!keyword) {
        if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập từ khóa tìm kiếm!', 'error');
