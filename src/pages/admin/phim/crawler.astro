          }
          runCrawlProcess(slugs);
        }
        else if (mode === 'by_year') {
          const year = document.getElementById('vsmovSelectedYear').value;
          const startPage = parseInt(document.getElementById('vsmovYearPageStart').value) || 1;
          const endPage = parseInt(document.getElementById('vsmovYearPageEnd').value) || 1;
