            return;
          }
          runCrawlProcess(slugs);
        }
      });
    }

    // TMDB Start Click Listener
    if (startTmdbBtn) {
      startTmdbBtn.addEventListener('click', async () => {
        if (isRunning) return;
        const mode = document.getElementById('tmdbMode').value;
        document.getElementById('crawlSource').value = 'tmdb';

        if (mode === 'direct_slug') {
          const lines = document.getElementById('tmdbIdsInput').value.split('\n').map(l => l.trim()).filter(Boolean);
          const slugs = [];
          lines.forEach(line => {
            if (/^\d+$/.test(line)) {
              const dummySlug = `tmdb-${line}`;
              slugs.push(dummySlug);
              cartSlugs.set(dummySlug, {
                name: `TMDB Movie (ID: ${line})`,
                type: 'single',
                episodeCurrent: 'Full',
                tmdbId: line,
                tmdbType: 'movie',
                source: 'tmdb'
              });
            }
          });

          if (slugs.length === 0) {
            if (window.showGlobalToast) window.showGlobalToast('Không tìm thấy ID TMDB nào hợp lệ (chỉ nhập số)!', 'error');
            return;
          }
          runCrawlProcess(slugs);
        }
        else if (mode === 'by_discover') {
          const startPage = parseInt(document.getElementById('tmdbDiscoverPageStart').value) || 1;
          const endPage = parseInt(document.getElementById('tmdbDiscoverPageEnd').value) || 1;

          if (startPage < 1 || endPage < startPage) {
            if (window.showGlobalToast) window.showGlobalToast('Phạm vi số trang không hợp lệ!', 'error');
            return;
          }

          const slugs = [];
          const country = document.getElementById('tmdbSelectedCountry').value;
          const genre = document.getElementById('tmdbSelectedGenre').value;
          
          addLog(`⏳ Đang tải phim từ TMDB Discover: ${filterType === 'country' ? 'Quốc gia ' + country : 'Thể loại ' + genre} (Trang ${startPage}-${endPage})...`);
          
          for (let p = startPage; p <= endPage; p++) {
            try {
              let discoverUrl = `/api/admin/tmdb-discover?page=${p}`;
              if (filterType === 'country') {
                discoverUrl += `&country=${country}`;
              } else {
                discoverUrl += `&genre=${genre}`;
              }

              const res = await fetch(discoverUrl);
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              const data = await res.json();
              if (data.status === 'success' && data.data && Array.isArray(data.data.items)) {
                data.data.items.forEach((item) => {
                  if (item.slug) {
                    slugs.push(item.slug);
                    if (item.tmdb) {
                      cartSlugs.set(item.slug, {
                        name: item.name,
                        type: item.type,
                        episodeCurrent: item.episode_current,
                        tmdbId: item.tmdb.id,
                        tmdbType: item.tmdb.type,
                        source: 'tmdb'
                      });
                    }
                  }
                });
                addLog(`✓ Quét xong TMDB trang ${p}: Thêm ${data.data.items.length} phim.`);
              }
            } catch (e) {
              addLog(`✗ Lỗi tải TMDB Discover trang ${p}: ${e.message}`, 'error');
            }
            await new Promise(r => setTimeout(r, 200));
          }

          if (slugs.length === 0) {
            if (window.showGlobalToast) window.showGlobalToast('Không cào được phim nào từ TMDB Discover!', 'error');
            return;
          }
          runCrawlProcess(slugs);
        }
      });
    }

    // Dummy crawlAllBtn trigger to prevent console errors if elements missing
    const dummyCrawlAllBtn = { addEventListener: () => {} };
    (document.getElementById('crawlAllBtn') || dummyCrawlAllBtn).addEventListener('click', async () => {
      if (isRunning) return;

      const performCrawlAll = async () => {
        addLog('⏳ Đang lấy dữ liệu trang 1 để ước tính toàn bộ kho phim...');
        try {
          const crawlSource = document.getElementById('crawlSource')?.value || 'kkphim';
          const batchUrl1 = crawlSource === 'vsmov'
            ? 'https://vsmov.com/api/danh-sach/phim-moi-cap-nhat?page=1'
            : 'https://phimapi.com/danh-sach/phim-moi-cap-nhat?page=1&limit=40';
          const res = await fetch('/api/admin/proxy-crawler?url=' + encodeURIComponent(batchUrl1));
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const resJson = await res.json();
          const data = resJson.data;
          
          const totalPages = data.pagination?.totalPages || data.data?.params?.pagination?.totalPages || 500;
          addLog(`✓ Tổng số trang phim cần quét: ${totalPages} trang. Bắt đầu thu thập slugs...`, 'system');

          const slugs = [];
          for (let p = 1; p <= totalPages; p++) {
            if (shouldStop) break;
            try {
              const batchUrl = crawlSource === 'vsmov'
                ? `https://vsmov.com/api/danh-sach/phim-moi-cap-nhat?page=${p}`
                : `https://phimapi.com/danh-sach/phim-moi-cap-nhat?page=${p}&limit=40`;
               const pageRes = await fetch('/api/admin/proxy-crawler?url=' + encodeURIComponent(batchUrl));
               const pageJson = await pageRes.json();
               const pageData = pageJson.data;
              const items = pageData.data?.items || pageData.items;
              if (items && Array.isArray(items)) {
                items.forEach(item => {
                  if (item.slug) slugs.push(item.slug);
                });
                addLog(`Quét danh sách trang ${p}/${totalPages}: Thêm ${items.length} slugs.`);
              }
            } catch (e) {
              addLog(`✗ Lỗi quét trang ${p}: ${e.message}`, 'error');
            }
            await new Promise(r => setTimeout(r, 100));
          }

          if (slugs.length > 0) {
            runCrawlProcess(slugs);
          }
        } catch (e) {
          addLog(`✗ Lỗi ước tính toàn bộ kho phim: ${e.message}`, 'error');
        }
      };

      if (window.txamodal) {
        window.txamodal.show({
          title: 'Bắt đầu cào toàn bộ kho phim',
          message: '<strong class="text-rose-500">CẢNH BÁO:</strong> Cào toàn bộ sẽ tải tất cả các trang phim trên API (20000+ phim). Tiến trình có thể kéo dài rất lâu và tiêu tốn tài nguyên. Bạn chắc chắn muốn chạy?',
          type: 'danger',
          confirmText: 'Chạy cào toàn bộ',
          cancelText: 'Hủy bỏ',
          onConfirm: performCrawlAll
        });
      } else if (confirm('CẢNH BÁO: Cào toàn bộ sẽ tải tất cả các trang phim trên API (20000+ phim). Tiến trình có thể kéo dài rất lâu. Bạn chắc chắn muốn chạy?')) {
        performCrawlAll();
      }
    });

    stopStandardBtn.addEventListener('click', () => {
      shouldStop = true;
      stopStandardBtn.classList.add('opacity-40', 'pointer-events-none');
      addLog('Đang chờ tiến trình dừng lại...', 'warning');
    });

    // Start crawl single direct from search result
    window.crawlSingleDirect = function(slug) {
      if (isRunning) {
        if (window.showGlobalToast) window.showGlobalToast('Đang có tiến trình cào phim đang hoạt động!', 'error');
        return;
      }
      runCrawlProcess([slug]);
    };

    // Start cart crawl
    document.getElementById('startCartCrawlBtn').addEventListener('click', () => {
      if (isRunning) return;
      if (cartSlugs.size === 0) {
        if (window.showGlobalToast) window.showGlobalToast('Vui lòng chọn ít nhất 1 phim vào giỏ hàng!', 'error');
        return;
      }

      const slugs = Array.from(cartSlugs.keys());
      runCrawlProcess(slugs);
      
      // Reset cart
      cartSlugs.clear();
      updateCartUI();
      const checkboxes = document.querySelectorAll('.item-checkbox');
      checkboxes.forEach(cb => cb.checked = false);
      selectAllSearch.checked = false;
    });

    document.getElementById('crawledPrevBtn').addEventListener('click', () => {
      if (crawledCurrentPage > 1) {
        crawledCurrentPage--;
        renderCrawledList();
      }
    });

    document.getElementById('crawledNextBtn').addEventListener('click', () => {
      const totalPages = Math.ceil(crawledListCache.length / crawledLimit) || 1;
      if (crawledCurrentPage < totalPages) {
        crawledCurrentPage++;
        renderCrawledList();
      }
    });

      document.addEventListener('astro:before-swap', () => {
        stopCountdownTimer();
      }, { once: true });

      // Initial runs
      (async () => {
        await loadExistingMoviesDict();
        renderCrawledList();
        checkAndRestoreCrawlSession();
        populateYearsDropdowns();
        await fetchFilterMetadata();
      })();
    })();
  </script>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #37333e; border-radius: 10px; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
  </style>
