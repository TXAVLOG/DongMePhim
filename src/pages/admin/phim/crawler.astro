---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Thu thập phim (Crawler) - Nâng cao">
  <header class="mb-8 mt-4">
    <a href="/admin" class="text-zinc-400 hover:text-primary text-xs font-bold flex items-center gap-1 mb-2 transition-colors">
      <span class="material-symbols-outlined text-sm">arrow_back</span> QUAY LẠI TỔNG QUAN
    </a>
    <h1 class="font-display-hero text-3xl font-extrabold text-white tracking-tight">Thu thập phim (Crawler) Nâng cao</h1>
    <p class="text-zinc-400 text-sm mt-1">Cào phim nhanh từ nguồn API bằng URL, tìm kiếm trực tuyến để thêm vào giỏ hàng cào hàng loạt, hoặc cào theo thể loại, quốc gia.</p>
  </header>

  <!-- Main Crawler Tabs -->
  <div class="flex border-b border-glass-stroke gap-4 mb-6">
    <button id="tabStandardBtn" class="pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer">
      Cào phim tiêu chuẩn
    </button>
    <button id="tabAdvancedBtn" class="pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer">
      Tìm kiếm trực tuyến & Giỏ hàng
    </button>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 mb-10">
    
    <!-- Left panel: Settings & Controls -->
    <div class="xl:col-span-4 space-y-6">
      
      <!-- Source Configuration -->
      <div class="glass-panel rounded-2xl p-6 border border-glass-stroke shadow-2xl">
        <div class="flex items-center gap-2 mb-4">
          <span class="material-symbols-outlined text-primary text-xl">tune</span>
          <h2 class="font-bold text-sm text-white uppercase tracking-wider">Cấu hình chung</h2>
        </div>
        <div class="space-y-4">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Nguồn dữ liệu</label>
            <select id="crawlSource" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary">
              <option value="kkphim">KKPhim API (phimapi.com)</option>
            </select>
          </div>
          <div class="flex items-center gap-3 py-1">
            <input class="rounded border-glass-stroke bg-zinc-950 text-primary focus:ring-primary w-4 h-4 cursor-pointer" id="overwrite" type="checkbox" checked />
            <label class="text-xs text-zinc-400 cursor-pointer select-none" for="overwrite">Ghi đè phim đã cào (Cập nhật tập mới)</label>
          </div>
        </div>
      </div>

      <!-- STANDARD CRAWLERS PANEL -->
      <div id="panelStandard" class="glass-panel rounded-2xl p-6 border border-glass-stroke space-y-5">
        <div class="flex items-center gap-2 mb-2">
          <span class="material-symbols-outlined text-secondary text-xl">layers</span>
          <h2 class="font-bold text-sm text-white uppercase tracking-wider font-display-hero">Chế độ cào chuẩn</h2>
        </div>

        <!-- Mode sub-tabs -->
        <div class="grid grid-cols-3 gap-1 p-1 bg-zinc-950/80 rounded-xl border border-glass-stroke">
          <button id="subTabUrlBtn" class="py-2 text-[10px] font-bold text-center rounded-lg bg-primary/20 text-primary cursor-pointer transition-all">URL/Slugs</button>
          <button id="subTabBatchBtn" class="py-2 text-[10px] font-bold text-center rounded-lg text-zinc-400 hover:text-white cursor-pointer transition-all">Số trang</button>
          <button id="subTabFilterBtn" class="py-2 text-[10px] font-bold text-center rounded-lg text-zinc-400 hover:text-white cursor-pointer transition-all">Lọc/Bộ lọc</button>
        </div>

        <!-- Sub-Tab: URL / Slug input -->
        <div id="subTabUrl" class="space-y-4">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Nhập URL phim hoặc Slugs (Mỗi dòng 1 phim)</label>
            <textarea id="crawlUrlsInput" rows="5" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-xs font-mono placeholder:text-zinc-700" placeholder="https://kkphim1.com/phim/digimon-beatbreak&#10;tro-choi-con-muc"></textarea>
          </div>
          <div class="text-[11px] text-zinc-500 italic flex items-center gap-1" id="detectCountText">
            <span class="material-symbols-outlined text-sm">check_circle</span> Phát hiện 0 phim hợp lệ.
          </div>
        </div>

        <!-- Sub-Tab: Batch range -->
        <div id="subTabBatch" class="space-y-4 hidden">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang bắt đầu</label>
              <input id="pageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none focus:ring-1 focus:ring-primary" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang kết thúc</label>
              <input id="pageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none focus:ring-1 focus:ring-primary" type="number" min="1" value="1"/>
            </div>
          </div>
          <p class="text-[10px] text-zinc-500 italic">Mỗi trang chứa 20 bộ phim mới cập nhật.</p>
          <div class="border-t border-glass-stroke/50 pt-3">
            <button id="crawlAllBtn" class="w-full py-2 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg text-xs font-bold hover:bg-red-500/20 active:scale-95 transition-all cursor-pointer">
              ⚠️ Cào toàn bộ API (All)
            </button>
          </div>
        </div>

        <!-- Sub-Tab: Country / Genre filters -->
        <div id="subTabFilter" class="space-y-4 hidden">
          <div>
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-1.5">Bộ lọc cào</label>
            <div class="grid grid-cols-2 gap-2 mb-3">
              <button id="filterCountryBtn" class="py-2 rounded-lg text-[10px] font-bold border border-primary bg-primary/20 text-primary cursor-pointer transition-all">Quốc gia</button>
              <button id="filterGenreBtn" class="py-2 rounded-lg text-[10px] font-bold border border-glass-stroke text-zinc-400 hover:text-white cursor-pointer transition-all">Thể loại</button>
            </div>
          </div>

          <!-- Select lists -->
          <div id="filterCountryPanel">
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Chọn Quốc gia</label>
            <select id="selectedCountry" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary mb-3">
              <option value="trung-quoc">Trung Quốc</option>
              <option value="han-quoc">Hàn Quốc</option>
              <option value="nhat-ban">Nhật Bản</option>
              <option value="au-my">Âu Mỹ</option>
              <option value="thai-lan">Thái Lan</option>
              <option value="viet-nam">Việt Nam</option>
            </select>
          </div>

          <div id="filterGenrePanel" class="hidden">
            <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Chọn Thể loại</label>
            <select id="selectedGenre" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none text-xs focus:ring-1 focus:ring-primary mb-3">
              <option value="hanh-dong">Hành Động</option>
              <option value="phieu-luu">Phiêu Lưu</option>
              <option value="tinh-cam">Tình Cảm</option>
              <option value="hoat-hinh">Hoạt Hình</option>
              <option value="khoa-hoc">Khoa Học</option>
              <option value="kinh-di">Kinh Dị</option>
              <option value="hai-huoc">Hài Hước</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang đầu</label>
              <input id="filterPageStart" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-zinc-500 uppercase mb-2">Trang cuối</label>
              <input id="filterPageEnd" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none" type="number" min="1" value="1"/>
            </div>
          </div>
        </div>

        <!-- Start/Stop buttons -->
        <div class="flex gap-2 pt-2">
          <button id="startStandardBtn" class="flex-1 bg-gradient-to-r from-primary to-secondary hover:brightness-110 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer text-xs">
            <span class="material-symbols-outlined text-lg">play_arrow</span> Bắt đầu cào
          </button>
          <button id="stopStandardBtn" class="bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/30 hover:scale-[1.02] active:scale-95 transition-all py-3 px-4 rounded-xl cursor-pointer flex items-center justify-center hidden">
            <span class="material-symbols-outlined">stop</span>
          </button>
        </div>
      </div>

      <!-- ADVANCED CRAWLERS PANEL (Cart & Search trigger) -->
      <div id="panelAdvanced" class="glass-panel rounded-2xl p-6 border border-glass-stroke space-y-4 hidden">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-xl">shopping_cart</span>
          <h2 class="font-bold text-sm text-white uppercase tracking-wider font-display-hero">Giỏ hàng cào phim</h2>
        </div>
        <p class="text-xs text-zinc-400">Chọn các phim từ kết quả tìm kiếm trực tuyến ở bên phải để đưa vào giỏ hàng cào hàng loạt.</p>
        
        <div class="p-4 rounded-xl bg-zinc-950 border border-glass-stroke text-center">
          <p class="text-[10px] text-zinc-500 font-bold uppercase mb-1">ĐÃ CHỌN TRONG GIỎ</p>
          <p class="text-3xl font-black text-primary" id="cartCount">0 phim</p>
        </div>

        <div class="flex gap-2">
          <button id="startCartCrawlBtn" class="flex-1 bg-gradient-to-r from-primary to-secondary text-white font-bold py-3.5 rounded-xl text-xs flex items-center justify-center gap-2 cursor-pointer active:scale-95 transition-all">
            <span class="material-symbols-outlined text-lg">cloud_download</span> Cào các phim đã chọn
          </button>
          <button id="clearCartBtn" class="p-3 border border-glass-stroke hover:bg-white/5 text-zinc-400 rounded-xl cursor-pointer" title="Làm trống giỏ">
            <span class="material-symbols-outlined text-lg">delete_sweep</span>
          </button>
        </div>
      </div>

      <!-- Stats Summary Box -->
      <div class="glass-panel rounded-2xl p-6 border border-glass-stroke">
        <h3 class="font-bold text-xs text-zinc-400 uppercase tracking-widest mb-4 flex items-center gap-1.5">
          <span class="material-symbols-outlined text-primary text-lg">analytics</span> Thống kê cào phim
        </h3>
        <div class="grid grid-cols-3 gap-2">
          <div class="p-3 rounded-xl bg-zinc-950 border border-glass-stroke text-center">
            <p class="text-[9px] text-zinc-500 font-bold mb-1">THÀNH CÔNG</p>
            <p class="text-xl font-bold text-emerald-400" id="statSuccess">0</p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-950 border border-glass-stroke text-center">
            <p class="text-[9px] text-zinc-500 font-bold mb-1">BỎ QUA</p>
            <p class="text-xl font-bold text-yellow-400" id="statSkipped">0</p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-950 border border-glass-stroke text-center">
            <p class="text-[9px] text-zinc-500 font-bold mb-1">THẤT BẠI</p>
            <p class="text-xl font-bold text-red-400" id="statFailed">0</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right panel: Interactive Search Results / Logs -->
    <div class="xl:col-span-8 flex flex-col gap-6">
      
      <!-- Progress Bar (Visible during crawl) -->
      <div class="glass-panel rounded-2xl p-6 border border-glass-stroke hidden" id="progressSection">
        <div class="flex justify-between items-center mb-3">
          <div>
            <h3 class="font-bold text-sm text-white" id="currentMovieName">Đang khởi động...</h3>
            <p class="text-xs text-zinc-400 mt-0.5" id="moviesCountProgress">Tiến trình: 0/0 phim</p>
          </div>
          <span class="text-2xl font-black text-primary" id="progressPercent">0%</span>
        </div>
        <div class="w-full bg-zinc-950 h-3 rounded-full overflow-hidden border border-glass-stroke/50">
          <div class="bg-gradient-to-r from-primary to-secondary h-full rounded-full transition-all duration-300 shadow-[0_0_15px_rgba(210,187,255,0.4)]" id="mainProgressBar" style="width: 0%;"></div>
        </div>
        <div class="flex justify-between mt-2 text-[10px] text-zinc-500 font-bold">
          <span id="progressTimeEstimate">Ước tính: Đang tính...</span>
          <span class="animate-pulse flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-primary"></span> ĐANG CÀO PHIM</span>
        </div>
      </div>

      <!-- Advanced Direct Search Container (Tab content) -->
      <div id="containerSearchTab" class="glass-panel rounded-2xl border border-glass-stroke flex flex-col min-h-[450px] hidden">
        <div class="p-5 border-b border-glass-stroke flex flex-col sm:flex-row items-stretch sm:items-center gap-4 bg-zinc-900/30">
          <h3 class="font-bold text-white text-base shrink-0 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">search</span> Tìm kiếm phim trực tuyến
          </h3>
          <div class="flex-1 flex gap-2">
            <input type="text" id="searchKeyword" class="flex-1 bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2 px-3 text-xs focus:outline-none focus:ring-1 focus:ring-primary" placeholder="Nhập tên phim cần tìm (ví dụ: Batman)..."/>
            <button id="searchOnlineBtn" class="bg-primary text-on-primary font-bold px-4 rounded-xl text-xs hover:brightness-110 active:scale-95 transition-all cursor-pointer">
              Tìm phim
            </button>
          </div>
        </div>
        
        <div class="overflow-x-auto flex-1 max-h-[350px] custom-scrollbar">
          <table class="w-full text-left" id="searchResultTable">
            <thead class="bg-zinc-950/70 text-[10px] font-bold text-zinc-500 uppercase tracking-wider sticky top-0 backdrop-blur-md">
              <tr>
                <th class="px-5 py-3 text-center w-12">
                  <input type="checkbox" id="selectAllSearch" class="rounded border-zinc-700 bg-zinc-950 text-primary w-3.5 h-3.5 cursor-pointer"/>
                </th>
                <th class="px-5 py-3">Ảnh</th>
                <th class="px-5 py-3">Phim</th>
                <th class="px-5 py-3">Chất lượng / Loại</th>
                <th class="px-5 py-3">Trạng thái Cục bộ</th>
                <th class="px-5 py-3 text-right">Thao tác</th>
              </tr>
            </thead>
            <tbody class="text-xs divide-y divide-glass-stroke/50" id="searchResultBody">
              <!-- Dynamic search list -->
            </tbody>
          </table>
        </div>
        
        <div id="emptySearchResult" class="flex-1 flex flex-col items-center justify-center p-12 text-center">
          <span class="material-symbols-outlined text-5xl opacity-20 mb-3">search_off</span>
          <p class="text-zinc-400 text-sm">Chưa có kết quả tìm kiếm nào.</p>
          <p class="text-[10px] text-zinc-500 mt-1">Nhập từ khóa ở trên và nhấn Tìm phim để tra cứu trực tiếp từ API.</p>
        </div>
      </div>

      <!-- Logs Terminal (Always visible or toggle) -->
      <div class="glass-panel rounded-2xl border border-glass-stroke flex flex-col flex-1 min-h-[400px]" id="logsTerminal">
        <div class="p-5 border-b border-glass-stroke flex justify-between items-center bg-zinc-900/30">
          <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 rounded-full bg-zinc-500" id="statusIndicator"></div>
            <h3 class="font-bold text-white text-sm">Nhật ký tiến trình thu thập</h3>
          </div>
          <button id="clearLogsBtn" class="p-2 hover:bg-zinc-800 text-zinc-500 hover:text-white rounded-lg transition-colors cursor-pointer" title="Xóa logs">
            <span class="material-symbols-outlined text-base">delete</span>
          </button>
        </div>
        
        <div class="overflow-y-auto flex-1 p-5 font-mono text-[11px] space-y-1.5 bg-black/60 custom-scrollbar max-h-[350px]" id="logTerminalBody">
          <div class="text-zinc-600">Console initialized. Ready for crawl tasks...</div>
        </div>
      </div>

    </div>
  </div>

  <!-- Local Crawled Inventory List -->
  <div class="glass-panel rounded-3xl border border-glass-stroke p-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
      <h3 class="font-bold text-lg text-white flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">video_library</span>
        Kho phim đã cào cục bộ (<span id="crawledCount" class="text-primary font-black">0</span> phim)
      </h3>
      <button id="clearAllCrawledBtn" class="bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-400 px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer">
        Xóa tất cả phim cào
      </button>
    </div>
    
    <div class="overflow-x-auto max-h-[400px] custom-scrollbar">
      <table class="w-full text-left">
        <thead class="bg-zinc-950/70 text-[10px] font-bold text-zinc-500 uppercase tracking-wider sticky top-0 backdrop-blur-md">
          <tr>
            <th class="px-6 py-3">Ảnh</th>
            <th class="px-6 py-3">Tên Phim</th>
            <th class="px-6 py-3">Thể Loại</th>
            <th class="px-6 py-3">Quốc Gia / Năm</th>
            <th class="px-6 py-3">Tập hiện tại</th>
            <th class="px-6 py-3">Phụ đề & Timings</th>
            <th class="px-6 py-3 text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody class="text-xs divide-y divide-glass-stroke/50" id="crawledMoviesBody">
          <!-- Rendered dynamically -->
        </tbody>
      </table>
    </div>
    <!-- Local Crawled Pagination -->
    <div id="crawledPagination" class="flex justify-between items-center mt-4 pt-4 border-t border-glass-stroke/50">
      <span id="crawledPaginationInfo" class="text-xs text-zinc-500 font-bold uppercase">Trang 1 / 1</span>
      <div class="flex gap-2">
        <button id="crawledPrevBtn" class="px-3 py-1.5 bg-zinc-950 border border-glass-stroke text-zinc-400 hover:text-white rounded-lg text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Trước</button>
        <button id="crawledNextBtn" class="px-3 py-1.5 bg-zinc-950 border border-glass-stroke text-zinc-400 hover:text-white rounded-lg text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Sau</button>
      </div>
    </div>
    <div id="emptyCrawled" class="hidden flex flex-col items-center justify-center p-12 text-center text-zinc-500">
      <span class="material-symbols-outlined text-5xl opacity-20 mb-2">movie_filter</span>
      <p>Kho phim cào cục bộ trống. Phim sau khi cào sẽ xuất hiện ở đây.</p>
    </div>
  </div>

  <script is:inline>
    // State
    let activeTab = 'standard'; // 'standard' | 'advanced'
    let standardSubTab = 'url'; // 'url' | 'batch' | 'filter'
    let filterType = 'country'; // 'country' | 'genre'
    let isRunning = false;
    let shouldStop = false;
    let cartSlugs = new Map(); // slug -> name
    let existingMoviesMap = {};
    let crawledCurrentPage = 1;
    const crawledLimit = 10;

    // Elements
    const tabStandardBtn = document.getElementById('tabStandardBtn');
    const tabAdvancedBtn = document.getElementById('tabAdvancedBtn');
    const panelStandard = document.getElementById('panelStandard');
    const panelAdvanced = document.getElementById('panelAdvanced');
    const containerSearchTab = document.getElementById('containerSearchTab');
    const logsTerminal = document.getElementById('logsTerminal');
    const statusIndicator = document.getElementById('statusIndicator');

    const subTabUrlBtn = document.getElementById('subTabUrlBtn');
    const subTabBatchBtn = document.getElementById('subTabBatchBtn');
    const subTabFilterBtn = document.getElementById('subTabFilterBtn');
    const subTabUrl = document.getElementById('subTabUrl');
    const subTabBatch = document.getElementById('subTabBatch');
    const subTabFilter = document.getElementById('subTabFilter');

    const filterCountryBtn = document.getElementById('filterCountryBtn');
    const filterGenreBtn = document.getElementById('filterGenreBtn');
    const filterCountryPanel = document.getElementById('filterCountryPanel');
    const filterGenrePanel = document.getElementById('filterGenrePanel');

    // Tab Switches
    tabStandardBtn.addEventListener('click', () => {
      if (isRunning) return;
      activeTab = 'standard';
      tabStandardBtn.className = "pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer";
      tabAdvancedBtn.className = "pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer";
      panelStandard.classList.remove('hidden');
      panelAdvanced.classList.add('hidden');
      containerSearchTab.classList.add('hidden');
    });

    tabAdvancedBtn.addEventListener('click', () => {
      if (isRunning) return;
      activeTab = 'advanced';
      tabAdvancedBtn.className = "pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer";
      tabStandardBtn.className = "pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer";
      panelAdvanced.classList.remove('hidden');
      panelStandard.classList.add('hidden');
      containerSearchTab.classList.remove('hidden');
    });

    // Sub-tab Switches
    subTabUrlBtn.addEventListener('click', () => {
      if (isRunning) return;
      standardSubTab = 'url';
      subTabUrlBtn.className = "py-2 text-[10px] font-bold text-center rounded-lg bg-primary/20 text-primary cursor-pointer transition-all";
      subTabBatchBtn.className = "py-2 text-[10px] font-bold text-center rounded-lg text-zinc-400 hover:text-white cursor-pointer transition-all";
      subTabFilterBtn.className = "py-2 text-[10px] font-bold text-center rounded-lg text-zinc-400 hover:text-white cursor-pointer transition-all";
      subTabUrl.classList.remove('hidden');
      subTabBatch.classList.add('hidden');
      subTabFilter.classList.add('hidden');
    });

    subTabBatchBtn.addEventListener('click', () => {
      if (isRunning) return;
      standardSubTab = 'batch';
