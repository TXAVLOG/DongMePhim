                <button onclick="deleteCrawledMovie('${m.slug}')" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center text-red-400 hover:text-red-500 hover:border-red-500/50 transition-colors cursor-pointer" data-txatooltip="Xóa">
                  <span class="material-symbols-outlined text-sm">delete</span>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      document.getElementById('crawledPaginationInfo').textContent = `Trang ${crawledCurrentPage} / ${totalPages}`;
      document.getElementById('crawledPrevBtn').disabled = (crawledCurrentPage === 1);
      document.getElementById('crawledNextBtn').disabled = (crawledCurrentPage === totalPages);
    }

    window.deleteCrawledMovie = function(slug) {
      const performDelete = async () => {
        try {
          const res = await fetch('/api/admin/movie-action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete', slug: slug, isStatic: false })
          });
          const result = await res.json();
          if (res.ok) {
            if (window.showGlobalToast) window.showGlobalToast('Đã xóa phim khỏi database thành công!', 'success');
            await loadExistingMoviesDict();
            renderCrawledList();
          } else {
            if (window.showGlobalToast) window.showGlobalToast(result.message || 'Lỗi khi xóa phim', 'error');
          }
        } catch (e) {
          if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API', 'error');
        }
      };

      if (window.txamodal) {
        window.txamodal.show({
          title: 'Xóa phim khỏi database',
          message: 'Bạn có chắc chắn muốn xóa phim này khỏi database không?',
          type: 'danger',
          confirmText: 'Xóa phim',
          cancelText: 'Hủy bỏ',
          onConfirm: performDelete
        });
      } else if (confirm('Bạn có chắc chắn muốn xóa phim này khỏi database không?')) {
        performDelete();
      }
    };

