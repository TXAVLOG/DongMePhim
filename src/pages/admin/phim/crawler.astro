          if (startPage < 1 || endPage < startPage) {
            if (window.showGlobalToast) window.showGlobalToast('Phạm vi số trang không hợp lệ!', 'error');
            return;
          }

          addLog(`⏳ Đang tải phim VSMOV theo năm "${year}" (Trang ${startPage}-${endPage}, SL: ${limit})...`);
          const slugs = [];

          for (let p = startPage; p <= endPage; p++) {
