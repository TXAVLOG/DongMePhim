                <button onclick="deleteCrawledMovie('${m.slug}')" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center text-red-400 hover:text-red-500 hover:border-red-500/50 transition-colors cursor-pointer" data-txatooltip="Xóa">
                  <span class="material-symbols-outlined text-sm">delete</span>
                </button>
