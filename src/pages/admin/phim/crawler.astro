          }
          runCrawlProcess(slugs);
        }
        else if (mode === 'by_code') {
          const codeVal = document.getElementById('vsmovSearchCode').value.trim();
          const startPage = parseInt(document.getElementById('vsmovCodePageStart').value) || 1;
          const endPage = parseInt(document.getElementById('vsmovCodePageEnd').value) || 1;
          const limit = parseInt(document.getElementById('vsmovCodeLimit').value) || 20;

          if (!codeVal) {
            if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập mã Code!', 'error');
            return;
          }

          addLog(`⏳ Đang tải phim VSMOV theo mã Code "${codeVal}" (Trang ${startPage}-${endPage}, SL: ${limit})...`);
          const slugs = [];

          for (let p = startPage; p <= endPage; p++) {
            try {
              const codeUrl = `https://vsmov.com/api/code/${codeVal}?page=${p}&limit=${limit}`;
              const res = await fetch('/api/admin/proxy-crawler?url=' + encodeURIComponent(codeUrl));
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              const resJson = await res.json();
              const items = resJson.data?.items || resJson.items || [];
              if (items && Array.isArray(items)) {
                items.forEach(item => {
                  if (item.slug) slugs.push(item.slug);
                });
                addLog(`✓ Quét xong trang ${p}: Thêm ${items.length} phim.`);
              }
            } catch (e) {
              addLog(`✗ Lỗi tải trang ${p}: ${e.message}`, 'error');
            }
            await new Promise(r => setTimeout(r, 200));
          }

          if (slugs.length === 0) {
            if (window.showGlobalToast) window.showGlobalToast('Không quét được phim nào!', 'error');
            return;
          }
          runCrawlProcess(slugs);
        }
        else if (mode === 'by_search') {
          const keyword = document.getElementById('vsmovSearchKeyword').value.trim();
          const startPage = parseInt(document.getElementById('vsmovSearchPageStart').value) || 1;
          const endPage = parseInt(document.getElementById('vsmovSearchPageEnd').value) || 1;
          const limit = parseInt(document.getElementById('vsmovSearchLimit').value) || 20;

          if (!keyword) {
            if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập từ khóa tìm kiếm!', 'error');
            return;
          }

          addLog(`⏳ Đang tìm kiếm và tải phim VSMOV theo từ khóa "${keyword}" (Trang ${startPage}-${endPage}, SL: ${limit})...`);
          const slugs = [];

          for (let p = startPage; p <= endPage; p++) {
            try {
              const searchUrl = `https://vsmov.com/api/tim-kiem?keyword=${encodeURIComponent(keyword)}&page=${p}&limit=${limit}`;
              const res = await fetch('/api/admin/proxy-crawler?url=' + encodeURIComponent(searchUrl));
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              const resJson = await res.json();
              const items = resJson.data?.items || resJson.items || [];
              if (items && Array.isArray(items)) {
                items.forEach(item => {
                  if (item.slug) slugs.push(item.slug);
                });
                addLog(`✓ Quét xong trang ${p}: Thêm ${items.length} phim.`);
              }
            } catch (e) {
