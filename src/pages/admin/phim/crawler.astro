    // Load list local crawled movies & dictionaries
    function loadExistingMoviesDict() {
      const listStr = localStorage.getItem('txa_crawled_movies') || '[]';
      let list = [];
      try { list = JSON.parse(listStr); } catch (e) {}

      existingMoviesMap = {};
      list.forEach(m => {
        const movieData = m.movie || m;
        let count = 0;
        const eps = m.episodes || [];
        eps.forEach(srv => {
          if (srv && (srv.serverData || srv.server_data)) {
            count = Math.max(count, (srv.serverData || srv.server_data).length || 0);
          }
        });
        existingMoviesMap[movieData.slug] = count;
      });
    }

    function renderCrawledList() {
      loadExistingMoviesDict();
      const listStr = localStorage.getItem('txa_crawled_movies') || '[]';
      let list = [];
      try { list = JSON.parse(listStr); } catch (e) {}

      document.getElementById('crawledCount').textContent = list.length;
      const crawledMoviesBody = document.getElementById('crawledMoviesBody');
      const emptyCrawled = document.getElementById('emptyCrawled');
      const crawledPagination = document.getElementById('crawledPagination');

      if (list.length === 0) {
        crawledMoviesBody.innerHTML = '';
        emptyCrawled.classList.remove('hidden');
        if (crawledPagination) crawledPagination.classList.add('hidden');
        return;
      }
      emptyCrawled.classList.add('hidden');
      if (crawledPagination) crawledPagination.classList.remove('hidden');

      // Pagination math
      const totalItems = list.length;
      const totalPages = Math.ceil(totalItems / crawledLimit) || 1;
      if (crawledCurrentPage > totalPages) crawledCurrentPage = totalPages;
      if (crawledCurrentPage < 1) crawledCurrentPage = 1;

      const startIndex = (crawledCurrentPage - 1) * crawledLimit;
      const endIndex = startIndex + crawledLimit;
      const paginatedList = list.slice(startIndex, endIndex);

      // Load config mapping to show if there's custom settings
      const configStr = localStorage.getItem('txa_episodes_config') || '{}';
      let configs = {};
      try { configs = JSON.parse(configStr); } catch(e) {}

      // Trigger animation
      crawledMoviesBody.classList.remove('animate-fade-in');
      void crawledMoviesBody.offsetWidth;
      crawledMoviesBody.classList.add('animate-fade-in');

      crawledMoviesBody.innerHTML = paginatedList.map((item) => {
        const m = item.movie || item;
        const hasConfig = !!configs[m.slug];
        
        // Count subtitles configured
        let subCount = 0;
        let skipConfigured = false;
        
        if (hasConfig) {
          const mConf = configs[m.slug];
          Object.keys(mConf).forEach(epK => {
            const epC = mConf[epK];
            if (epC.subtitles && epC.subtitles.length > 0) subCount += epC.subtitles.length;
            if (epC.timeIntroStart > 0 || epC.timeOutroStart > 0) skipConfigured = true;
          });
        } else {
          // Check if embedded in episodes data directly
          const eps = item.episodes || [];
          eps.forEach(srv => {
            const data = srv.serverData || srv.server_data || [];
            data.forEach(ep => {
              if (ep.subtitles && ep.subtitles.length > 0) subCount += ep.subtitles.length;
              if (ep.timeIntroStart > 0 || ep.timeOutroStart > 0 || ep.time_intro_start > 0 || ep.time_outro_start > 0) skipConfigured = true;
            });
          });
        }

        let configBadge = '';
        if (subCount > 0 || skipConfigured) {
          configBadge = `
            <div class="flex items-center gap-1 mt-1">
              ${subCount > 0 ? `<span class="bg-primary/20 text-primary border border-primary/30 rounded px-1 text-[9px] font-bold">CC (${subCount})</span>` : ''}
              ${skipConfigured ? '<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded px-1 text-[9px] font-bold">SKIP TIMINGS</span>' : ''}
            </div>
          `;
        } else {
          configBadge = '<span class="text-[10px] text-zinc-600">Trống (Mặc định)</span>';
        }

        return `
          <tr class="border-b border-glass-stroke/50 hover:bg-white/5 transition-colors">
            <td class="px-6 py-4">
              <div class="w-12 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke">
                <img src="${m.posterUrl || '/logo-icon.png'}" class="w-full h-full object-cover" onerror="this.src='/logo-icon.png'" alt="Poster" />
              </div>
            </td>
            <td class="px-6 py-4 font-semibold text-white">
              <a href="/phim/${m.slug}" target="_blank" class="hover:text-primary transition-colors">${m.title || m.name}</a>
              <div class="text-[10px] text-zinc-500 font-mono mt-0.5">${m.originalTitle || m.origin_name || ''}</div>
            </td>
            <td class="px-6 py-4 text-zinc-400">${(m.genres || []).join(', ') || m.category || 'N/A'}</td>
            <td class="px-6 py-4 text-zinc-400 font-medium">${m.category || 'Khác'} / ${m.releaseYear || m.year || 'N/A'}</td>
            <td class="px-6 py-4">
              <span class="px-2 py-0.5 rounded bg-zinc-950 border border-glass-stroke text-[11px] font-semibold">${m.episodeCurrent || 'Full'}</span>
            </td>
            <td class="px-6 py-4">
              ${configBadge}
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex gap-2 justify-end">
                <a href="/admin/phim/tao-thu-cong?edit=${m.slug}" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center hover:text-primary hover:border-primary/50 transition-colors cursor-pointer" title="Cấu hình / Sửa">
                  <span class="material-symbols-outlined text-sm">settings</span>
                </a>
                <button onclick="deleteCrawledMovie('${m.slug}')" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center text-red-400 hover:text-red-500 hover:border-red-500/50 transition-colors cursor-pointer" title="Xóa">
                  <span class="material-symbols-outlined text-sm">delete</span>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      document.getElementById('crawledPaginationInfo').textContent = `Trang ${crawledCurrentPage} / ${totalPages}`;
      document.getElementById('crawledPrevBtn').disabled = (crawledCurrentPage === 1);
      document.getElementById('crawledNextBtn').disabled = (crawledCurrentPage === totalPages);
    }

