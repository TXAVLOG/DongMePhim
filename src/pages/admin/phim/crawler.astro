  <script is:inline data-astro-rerun>
    (function() {
      // State
      let activeTab = 'kkphim'; // 'kkphim' | 'vsmov' | 'tmdb' | 'advanced'
      let filterType = 'country'; // 'country' | 'genre'
      let isRunning = false;
      let shouldStop = false;
      let isPaused = false;
      let remainingTimeSeconds = 0;
      let countdownTimerId = null;
      let cartPage = 1;
      let cartPageSize = 10;
      let cartSlugs = new Map(); // slug -> { name, type, episodeCurrent }
      let existingMoviesMap = {};
      let crawledCurrentPage = 1;
      const crawledPageSize = 20;

      // Cache for fetched metadata
      let kkphimGenres = [];
      let kkphimCountries = [];
      let tmdbGenres = [];
      let tmdbCountries = [];

      async function fetchFilterMetadata() {
        addLog('⏳ Đang đồng bộ danh sách Quốc gia và Thể loại...');
        
        try {
          // 1. Fetch KKPhim metadata
          const [kkGenresRes, kkCountriesRes] = await Promise.all([
            fetch('/api/admin/proxy-crawler?url=' + encodeURIComponent('https://phimapi.com/the-loai')).then(r => r.json().then(j => j.data).catch(() => [])),
            fetch('/api/admin/proxy-crawler?url=' + encodeURIComponent('https://phimapi.com/quoc-gia')).then(r => r.json().then(j => j.data).catch(() => []))
          ]);

          kkphimGenres = Array.isArray(kkGenresRes) ? kkGenresRes : [];
          kkphimCountries = Array.isArray(kkCountriesRes) ? kkCountriesRes : [];

          // 2. Fetch TMDB metadata
          const [tmdbMovieGenresRes, tmdbTvGenresRes, tmdbCountriesRes] = await Promise.all([
            fetch('/api/tmdb-proxy?path=/3/genre/movie/list&language=vi-VN').then(r => r.json().catch(() => ({ genres: [] }))),
            fetch('/api/tmdb-proxy?path=/3/genre/tv/list&language=vi-VN').then(r => r.json().catch(() => ({ genres: [] }))),
            fetch('/api/tmdb-proxy?path=/3/configuration/countries&language=vi-VN').then(r => r.json().catch(() => []))
          ]);

          // Combine TMDB movie & tv genres, avoid duplicates
          const genreMap = new Map();
          if (tmdbMovieGenresRes && Array.isArray(tmdbMovieGenresRes.genres)) {
            tmdbMovieGenresRes.genres.forEach(g => genreMap.set(g.id, g.name));
          }
          if (tmdbTvGenresRes && Array.isArray(tmdbTvGenresRes.genres)) {
            tmdbTvGenresRes.genres.forEach(g => {
              if (!genreMap.has(g.id)) {
                genreMap.set(g.id, g.name);
              } else {
                const existing = genreMap.get(g.id);
                if (existing !== g.name && !existing.includes(g.name)) {
                  genreMap.set(g.id, `${existing} / ${g.name}`);
                }
              }
            });
          }
          tmdbGenres = Array.from(genreMap.entries()).map(([id, name]) => ({ id, name }));

          // Format TMDB countries: use native_name or english_name
          tmdbCountries = Array.isArray(tmdbCountriesRes) 
            ? tmdbCountriesRes.map(c => ({
                code: c.iso_3166_1,
                name: c.native_name || c.english_name
              })).sort((a, b) => a.name.localeCompare(b.name, 'vi'))
            : [];

          addLog(`✓ Đồng bộ thành công: KKPhim (${kkphimCountries.length} quốc gia, ${kkphimGenres.length} thể loại), TMDB (${tmdbCountries.length} quốc gia, ${tmdbGenres.length} thể loại).`, 'success');
          
          populateFilterDropdowns();
        } catch (e) {
          console.error(e);
          addLog(`⚠️ Không thể tự động đồng bộ danh sách đầy đủ: ${e.message}. Sử dụng danh sách dự phòng.`, 'warning');
          useFallbackFilters();
        }
      }

      function useFallbackFilters() {
        kkphimCountries = [
          { name: 'Trung Quốc', slug: 'trung-quoc' },
          { name: 'Hàn Quốc', slug: 'han-quoc' },
          { name: 'Nhật Bản', slug: 'nhat-ban' },
          { name: 'Âu Mỹ', slug: 'au-my' },
          { name: 'Thái Lan', slug: 'thai-lan' },
          { name: 'Việt Nam', slug: 'viet-nam' },
          { name: 'Hồng Kông', slug: 'hong-kong' },
          { name: 'Ấn Độ', slug: 'an-do' }
        ];

        kkphimGenres = [
          { name: 'Hành Động', slug: 'hanh-dong' },
          { name: 'Phiêu Lưu', slug: 'phieu-luu' },
          { name: 'Tình Cảm', slug: 'tinh-cam' },
          { name: 'Hoạt Hình', slug: 'hoat-hinh' },
          { name: 'Khoa Học', slug: 'khoa-hoc' },
          { name: 'Kinh Dị', slug: 'kinh-di' },
          { name: 'Hài Hước', slug: 'hai-huoc' },
          { name: 'Hình Sự', slug: 'hinh-su' },
          { name: 'Võ Thuật', slug: 'vo-thuat' },
          { name: 'Chính Kịch', slug: 'chinh-kich' }
        ];

        tmdbCountries = [
          { code: 'US', name: 'Mỹ' },
          { code: 'KR', name: 'Hàn Quốc' },
          { code: 'CN', name: 'Trung Quốc' },
          { code: 'JP', name: 'Nhật Bản' },
          { code: 'HK', name: 'Hồng Kông' },
          { code: 'TW', name: 'Đài Loan' },
          { code: 'TH', name: 'Thái Lan' },
          { code: 'VN', name: 'Việt Nam' },
          { code: 'GB', name: 'Anh' },
          { code: 'FR', name: 'Pháp' },
          { code: 'DE', name: 'Đức' },
          { code: 'IN', name: 'Ấn Độ' }
        ];

        tmdbGenres = [
          { id: 28, name: 'Hành Động (Action)' },
          { id: 12, name: 'Phiêu Lưu (Adventure)' },
          { id: 35, name: 'Hài Hước (Comedy)' },
          { id: 18, name: 'Tình Cảm / Chính Kịch (Drama)' },
          { id: 10749, name: 'Lãng Mạn (Romance)' },
          { id: 27, name: 'Kinh Dị (Horror)' },
          { id: 53, name: 'Giật Gân / Gây Cấn (Thriller)' },
          { id: 16, name: 'Hoạt Hình (Animation)' },
          { id: 878, name: 'Khoa Học Viễn Tưởng (Sci-Fi)' }
        ];

        populateFilterDropdowns();
      }

      function populateFilterDropdowns() {
        // Populating KKPhim selectors
        const kkCountry = document.getElementById('kkphimSelectedCountry');
        const kkGenre = document.getElementById('kkphimSelectedGenre');
        if (kkCountry && kkGenre) {
          kkCountry.innerHTML = '';
          kkGenre.innerHTML = '';
          kkphimCountries.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.slug; opt.textContent = c.name;
            kkCountry.appendChild(opt);
          });
          kkphimGenres.forEach(g => {
            const opt = document.createElement('option');
            opt.value = g.slug; opt.textContent = g.name;
            kkGenre.appendChild(opt);
          });
        }

        // Populating VSMOV selectors
        const vsCountry = document.getElementById('vsmovSelectedCountry');
        const vsGenre = document.getElementById('vsmovSelectedGenre');
        if (vsCountry && vsGenre) {
          vsCountry.innerHTML = '';
          vsGenre.innerHTML = '';
          kkphimCountries.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.slug; opt.textContent = c.name;
            vsCountry.appendChild(opt);
          });
          kkphimGenres.forEach(g => {
            const opt = document.createElement('option');
            opt.value = g.slug; opt.textContent = g.name;
            vsGenre.appendChild(opt);
          });
        }

        // Populating TMDB selectors
        const tmdbCountry = document.getElementById('tmdbSelectedCountry');
        const tmdbGenre = document.getElementById('tmdbSelectedGenre');
        if (tmdbCountry && tmdbGenre) {
          tmdbCountry.innerHTML = '';
          tmdbGenre.innerHTML = '';
          tmdbCountries.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.code; opt.textContent = `${c.name} (${c.code})`;
            tmdbCountry.appendChild(opt);
          });
          tmdbGenres.forEach(g => {
            const opt = document.createElement('option');
            opt.value = g.id.toString(); opt.textContent = g.name;
            tmdbGenre.appendChild(opt);
          });
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('crawlSource')?.addEventListener('change', populateFilterDropdowns);
      });

    // Elements
    const tabKkphimBtn = document.getElementById('tabKkphimBtn');
    const tabVsmovBtn = document.getElementById('tabVsmovBtn');
    const tabTmdbBtn = document.getElementById('tabTmdbBtn');
    const tabAdvancedBtn = document.getElementById('tabAdvancedBtn');

    const panelKkphim = document.getElementById('panelKkphim');
    const panelVsmov = document.getElementById('panelVsmov');
    const panelTmdb = document.getElementById('panelTmdb');
    const panelAdvanced = document.getElementById('panelAdvanced');
    const containerSearchTab = document.getElementById('containerSearchTab');
    const logsTerminal = document.getElementById('logsTerminal');
    const statusIndicator = document.getElementById('statusIndicator');

    // Tab Switches
    function resetTabStyles() {
      [tabKkphimBtn, tabVsmovBtn, tabTmdbBtn, tabAdvancedBtn].forEach(btn => {
        if (btn) btn.className = "pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer flex items-center gap-1.5";
      });
      [panelKkphim, panelVsmov, panelTmdb, panelAdvanced].forEach(panel => {
        if (panel) panel.classList.add('hidden');
      });
      if (containerSearchTab) containerSearchTab.classList.add('hidden');
    }

    if (tabKkphimBtn) {
      tabKkphimBtn.addEventListener('click', () => {
        if (isRunning) return;
        activeTab = 'kkphim';
        document.getElementById('crawlSource').value = 'kkphim';
        resetTabStyles();
        tabKkphimBtn.className = "pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer flex items-center gap-1.5";
        panelKkphim.classList.remove('hidden');
      });
    }

    if (tabVsmovBtn) {
      tabVsmovBtn.addEventListener('click', () => {
        if (isRunning) return;
        activeTab = 'vsmov';
        document.getElementById('crawlSource').value = 'vsmov';
        resetTabStyles();
        tabVsmovBtn.className = "pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer flex items-center gap-1.5";
        panelVsmov.classList.remove('hidden');
      });
    }

    if (tabTmdbBtn) {
      tabTmdbBtn.addEventListener('click', () => {
        if (isRunning) return;
        activeTab = 'tmdb';
        document.getElementById('crawlSource').value = 'tmdb';
        resetTabStyles();
        tabTmdbBtn.className = "pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer flex items-center gap-1.5";
        panelTmdb.classList.remove('hidden');
      });
    }

    if (tabAdvancedBtn) {
      tabAdvancedBtn.addEventListener('click', () => {
        if (isRunning) return;
        activeTab = 'advanced';
        resetTabStyles();
        tabAdvancedBtn.className = "pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer flex items-center gap-1.5";
        panelAdvanced.classList.remove('hidden');
        containerSearchTab.classList.remove('hidden');
      });
    }

    // Dynamic blocks show/hide for KKPhim Mode selector
    const kkphimMode = document.getElementById('kkphimMode');
    if (kkphimMode) {
      kkphimMode.addEventListener('change', (e) => {
        const mode = e.target.value;
        ['kkphimBlockNewUpdated', 'kkphimBlockType', 'kkphimBlockGenre', 'kkphimBlockCountry', 'kkphimBlockYear', 'kkphimBlockSearch', 'kkphimBlockDirect'].forEach(id => {
          document.getElementById(id)?.classList.add('hidden');
        });
        if (mode === 'new_updated') document.getElementById('kkphimBlockNewUpdated').classList.remove('hidden');
        else if (mode === 'by_type') document.getElementById('kkphimBlockType').classList.remove('hidden');
        else if (mode === 'by_genre') document.getElementById('kkphimBlockGenre').classList.remove('hidden');
        else if (mode === 'by_country') document.getElementById('kkphimBlockCountry').classList.remove('hidden');
        else if (mode === 'by_year') document.getElementById('kkphimBlockYear').classList.remove('hidden');
        else if (mode === 'by_search') document.getElementById('kkphimBlockSearch').classList.remove('hidden');
        else if (mode === 'direct_slug') document.getElementById('kkphimBlockDirect').classList.remove('hidden');
      });
    }

    // Dynamic blocks show/hide for VSMOV Mode selector
    const vsmovMode = document.getElementById('vsmovMode');
    if (vsmovMode) {
      vsmovMode.addEventListener('change', (e) => {
        const mode = e.target.value;
        ['vsmovBlockNewUpdated', 'vsmovBlockType', 'vsmovBlockGenre', 'vsmovBlockCountry', 'vsmovBlockYear', 'vsmovBlockCode', 'vsmovBlockSearch', 'vsmovBlockDirect'].forEach(id => {
          document.getElementById(id)?.classList.add('hidden');
        });
        if (mode === 'new_updated') document.getElementById('vsmovBlockNewUpdated').classList.remove('hidden');
        else if (mode === 'by_type') document.getElementById('vsmovBlockType').classList.remove('hidden');
        else if (mode === 'by_genre') document.getElementById('vsmovBlockGenre').classList.remove('hidden');
        else if (mode === 'by_country') document.getElementById('vsmovBlockCountry').classList.remove('hidden');
        else if (mode === 'by_year') document.getElementById('vsmovBlockYear').classList.remove('hidden');
        else if (mode === 'by_code') document.getElementById('vsmovBlockCode').classList.remove('hidden');
        else if (mode === 'by_search') document.getElementById('vsmovBlockSearch').classList.remove('hidden');
        else if (mode === 'direct_slug') document.getElementById('vsmovBlockDirect').classList.remove('hidden');
      });
    }

    // Dynamic blocks show/hide for TMDB Mode selector
    const tmdbMode = document.getElementById('tmdbMode');
    if (tmdbMode) {
      tmdbMode.addEventListener('change', (e) => {
        const mode = e.target.value;
        document.getElementById('tmdbBlockDiscover')?.classList.add('hidden');
        document.getElementById('tmdbBlockDirect')?.classList.add('hidden');
        if (mode === 'by_discover') document.getElementById('tmdbBlockDiscover').classList.remove('hidden');
        else if (mode === 'direct_slug') document.getElementById('tmdbBlockDirect').classList.remove('hidden');
      });
    }

    // TMDB sub filter toggles
    const tmdbFilterCountryBtn = document.getElementById('tmdbFilterCountryBtn');
    const tmdbFilterGenreBtn = document.getElementById('tmdbFilterGenreBtn');
    const tmdbFilterCountryPanel = document.getElementById('tmdbFilterCountryPanel');
    const tmdbFilterGenrePanel = document.getElementById('tmdbFilterGenrePanel');

    if (tmdbFilterCountryBtn) {
      tmdbFilterCountryBtn.addEventListener('click', () => {
        filterType = 'country';
        tmdbFilterCountryBtn.className = "py-2 rounded-lg text-[10px] font-bold border border-primary bg-primary/20 text-primary cursor-pointer transition-all";
        tmdbFilterGenreBtn.className = "py-2 rounded-lg text-[10px] font-bold border border-glass-stroke text-zinc-400 hover:text-white cursor-pointer transition-all";
        tmdbFilterCountryPanel.classList.remove('hidden');
        tmdbFilterGenrePanel.classList.add('hidden');
      });
    }

    if (tmdbFilterGenreBtn) {
      tmdbFilterGenreBtn.addEventListener('click', () => {
        filterType = 'genre';
        tmdbFilterGenreBtn.className = "py-2 rounded-lg text-[10px] font-bold border border-primary bg-primary/20 text-primary cursor-pointer transition-all";
        tmdbFilterCountryBtn.className = "py-2 rounded-lg text-[10px] font-bold border border-glass-stroke text-zinc-400 hover:text-white cursor-pointer transition-all";
        tmdbFilterGenrePanel.classList.remove('hidden');
        tmdbFilterCountryPanel.classList.add('hidden');
      });
    }

    function populateYearsDropdowns() {
      const currentYear = new Date().getFullYear();
      ['kkphimSelectedYear', 'vsmovSelectedYear'].forEach(id => {
        const select = document.getElementById(id);
        if (select) {
          select.innerHTML = '';
          for (let y = currentYear; y >= 2000; y--) {
            const opt = document.createElement('option');
            opt.value = y.toString();
            opt.textContent = y.toString();
            select.appendChild(opt);
          }
        }
      });
    }

    // URL slug parser helper
    function extractSlug(input) {
      const trimmed = input.trim();
      if (!trimmed) return null;
      
      if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) {
        try {
          const url = new URL(trimmed);
          const pathname = url.pathname;
          const parts = pathname.split('/').filter(Boolean);
          if (parts.length > 0) {
            return parts[parts.length - 1];
          }
        } catch (e) {
          const match = trimmed.match(/(?:phim|detail|chitet|info)\/([a-zA-Z0-9\-]+)/);
          if (match) return match[1];
        }
      }
      
      const cleanSlug = trimmed.split('/').filter(Boolean).pop();
      if (cleanSlug && /^[a-zA-Z0-9\-]+$/.test(cleanSlug)) {
        return cleanSlug;
      }
      return trimmed;
    }

    // Dynamic count input slugs
    const crawlUrlsInput = document.getElementById('crawlUrlsInput');
    const detectCountText = document.getElementById('detectCountText');

    function updateDetectCount() {
      if (!crawlUrlsInput || !detectCountText) return;
      const lines = crawlUrlsInput.value.split('\n').map(l => l.trim()).filter(Boolean);
      let valid = 0;
      lines.forEach(line => {
        const slug = extractSlug(line);
        if (slug) valid++;
      });
      detectCountText.innerHTML = `<span class="material-symbols-outlined text-sm text-emerald-400">check_circle</span> Phát hiện ${valid} phim hợp lệ từ dòng nhập.`;
    }
    crawlUrlsInput?.addEventListener('input', updateDetectCount);

    // File upload handler for TXT files
    const crawlTxtUpload = document.getElementById('crawlTxtUpload');
    const uploadText = document.getElementById('uploadText');
    const uploadIcon = document.getElementById('uploadIcon');

    crawlTxtUpload?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      if (uploadText) uploadText.textContent = `Đang đọc file: ${file.name}...`;
      if (uploadIcon) {
        uploadIcon.className = 'material-symbols-outlined text-2xl text-primary animate-spin';
        uploadIcon.textContent = 'sync';
      }

      const reader = new FileReader();
      reader.onload = (event) => {
        const text = event.target.result;
        const lines = text.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
        
        const validLines = [];
        let invalidCount = 0;
        
        lines.forEach(line => {
          const slug = extractSlug(line);
          if (slug) {
            validLines.push(line);
          } else {
            invalidCount++;
          }
        });

        // Populate textarea and update count
        if (crawlUrlsInput) crawlUrlsInput.value = validLines.join('\n');
        updateDetectCount();

        if (uploadText) uploadText.textContent = `Đã tải: ${file.name} (${validLines.length} dòng)`;
        if (uploadIcon) {
          uploadIcon.className = 'material-symbols-outlined text-2xl text-emerald-400';
          uploadIcon.textContent = 'check_circle';
        }

        if (invalidCount > 0) {
          if (window.showGlobalToast) {
            window.showGlobalToast(`Đã bỏ qua ${invalidCount} dòng không hợp lệ!`, 'warning');
          }
          addLog(`⚠️ Đã tải file .txt nhưng phát hiện ${invalidCount} dòng không hợp lệ và bị bỏ qua.`, 'warning');
        } else {
          if (window.showGlobalToast) {
            window.showGlobalToast(`Đã tải thành công ${validLines.length} dòng!`, 'success');
          }
          addLog(`✓ Đã tải thành công ${validLines.length} phim từ file .txt.`, 'success');
        }
      };

      reader.onerror = () => {
        if (uploadText) uploadText.textContent = 'Lỗi khi đọc file!';
        if (uploadIcon) {
          uploadIcon.className = 'material-symbols-outlined text-2xl text-red-400';
          uploadIcon.textContent = 'error';
        }
        if (window.showGlobalToast) window.showGlobalToast('Lỗi khi đọc file TXT!', 'error');
      };

      reader.readAsText(file);
    });

    // Logs helper
    const logTerminalBody = document.getElementById('logTerminalBody');
    const clearLogsBtn = document.getElementById('clearLogsBtn');

    function addLog(text, type = 'info') {
      const timeStr = new Date().toLocaleTimeString('vi-VN');
      let colorClass = 'text-zinc-400';
      if (type === 'success') colorClass = 'text-emerald-400 font-bold';
      else if (type === 'error') colorClass = 'text-red-400 font-bold';
      else if (type === 'warning') colorClass = 'text-yellow-400';
      else if (type === 'system') colorClass = 'text-primary';

      const line = document.createElement('div');
      line.className = `flex gap-2 py-0.5 border-b border-glass-stroke/10 ${colorClass}`;
      line.innerHTML = `<span class="text-zinc-600 shrink-0 select-none">[${timeStr}]</span> <span>${text}</span>`;
      logTerminalBody.appendChild(line);
      logTerminalBody.scrollTop = logTerminalBody.scrollHeight;
    }

    clearLogsBtn.addEventListener('click', () => {
      logTerminalBody.innerHTML = '<div class="text-zinc-600">Console cleared. Ready.</div>';
    });

    // Load list local crawled movies & dictionaries
    let crawledListCache = [];

    // Load list local crawled movies & dictionaries from database
    async function loadExistingMoviesDict() {
      try {
        const res = await fetch('/api/admin/movie-action?action=list&_t=' + Date.now());
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (data.status !== 'success' || !data.data) {
          throw new Error(data.message || 'Lỗi API');
        }
        
        const list = data.data;
        crawledListCache = list;

        existingMoviesMap = {};
        list.forEach(m => {
          let count = 0;
          const eps = m.episodes || [];
          eps.forEach(srv => {
            const serverData = srv.serverData || srv.server_data || [];
            count = Math.max(count, serverData.length || 0);
          });
          if (count === 0) {
            count = (m.type === 'movie' || m.type === 'single') ? 1 : (m.episodeCurrent ? parseInt(m.episodeCurrent) || 1 : 1);
          }
          // Film đã full/hoàn thành thì set count cao để tránh hiện "có tập mới"
          const epCur = String(m.episodeCurrent || '').toLowerCase();
          const epTot = String(m.episodeTotal || '').toLowerCase();
          const isFull = m.status === 'completed' || epCur === 'full' || epTot === 'full' || epCur.includes('hoàn tất');
          existingMoviesMap[m.slug] = isFull ? 99999 : count;
        });
      } catch (e) {
        console.error('Error fetching dynamic movies:', e);
      }
    }

    function renderCrawledList() {
      const list = crawledListCache;

      document.getElementById('crawledCount').textContent = list.length;
      const crawledMoviesBody = document.getElementById('crawledMoviesBody');
      const emptyCrawled = document.getElementById('emptyCrawled');
      const crawledPagination = document.getElementById('crawledPagination');

      if (list.length === 0) {
        crawledMoviesBody.innerHTML = '';
        emptyCrawled.classList.remove('hidden');
        if (crawledPagination) crawledPagination.classList.add('hidden');
        return;
      }
      emptyCrawled.classList.add('hidden');
      if (crawledPagination) crawledPagination.classList.remove('hidden');

      // Pagination math
      const totalItems = list.length;
      const totalPages = Math.ceil(totalItems / crawledPageSize) || 1;
      if (crawledCurrentPage > totalPages) crawledCurrentPage = totalPages;
      if (crawledCurrentPage < 1) crawledCurrentPage = 1;

      const startIndex = (crawledCurrentPage - 1) * crawledPageSize;
      const endIndex = startIndex + crawledPageSize;
      const paginatedList = list.slice(startIndex, endIndex);

      // Trigger animation
      crawledMoviesBody.classList.remove('animate-fade-in');
      void crawledMoviesBody.offsetWidth;
      crawledMoviesBody.classList.add('animate-fade-in');

      crawledMoviesBody.innerHTML = paginatedList.map((m) => {
        let subCount = 0;
        let skipConfigured = false;
        
        const eps = m.episodes || [];
        eps.forEach(srv => {
          const data = srv.serverData || srv.server_data || [];
          data.forEach(ep => {
            if (ep.subtitles && ep.subtitles.length > 0) subCount += ep.subtitles.length;
            if (ep.timeIntroStart > 0 || ep.timeOutroStart > 0 || ep.time_intro_start > 0 || ep.time_outro_start > 0) skipConfigured = true;
          });
        });

        let configBadge = '';
        if (subCount > 0 || skipConfigured) {
          configBadge = `
            <div class="flex items-center gap-1 mt-1">
              ${subCount > 0 ? `<span class="bg-primary/20 text-primary border border-primary/30 rounded px-1 text-[9px] font-bold">CC (${subCount})</span>` : ''}
              ${skipConfigured ? '<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded px-1 text-[9px] font-bold">SKIP TIMINGS</span>' : ''}
            </div>
          `;
        } else {
          configBadge = '<span class="text-[10px] text-zinc-600">Trống (Mặc định)</span>';
        }

        // Status badge
        const _epCur = String(m.episodeCurrent || '').toLowerCase();
        const _epTot = String(m.episodeTotal || '').toLowerCase();
        const _isMovie = m.type === 'movie' || m.type === 'single';
        const _isCompleted = m.status === 'completed' || _epCur === 'full' || _epTot === 'full' || _epCur.includes('hoàn tất');
        let statusBadge;
        if (_isMovie) {
          statusBadge = '<span class="px-1.5 py-0.5 rounded bg-blue-500/15 text-blue-400 border border-blue-500/20 text-[9px] font-bold">PHIM LẺ</span>';
        } else if (_isCompleted) {
          statusBadge = '<span class="px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/20 text-[9px] font-bold">HOÀN THÀNH</span>';
        } else {
          statusBadge = '<span class="px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-400 border border-amber-500/20 text-[9px] font-bold">ĐANG CHIẾU</span>';
        }

        return `
          <tr class="border-b border-glass-stroke/50 hover:bg-white/5 transition-colors">
            <td class="px-6 py-4">
              <div class="w-12 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke">
                <img src="${m.posterUrl || '/logo.png'}" class="w-full h-full object-cover" onerror="this.src='/logo.png'" alt="Poster" />
              </div>
            </td>
            <td class="px-6 py-4 font-semibold text-white">
              <a href="/phim/${m.slug}" target="_blank" class="hover:text-primary transition-colors">${m.title || m.name}</a>
              <div class="text-[10px] text-zinc-500 font-mono mt-0.5">${m.originalTitle || m.origin_name || ''}</div>
              <div class="mt-1">${statusBadge}</div>
            </td>
            <td class="px-6 py-4 text-zinc-400">${(m.genres || []).join(', ') || m.category || 'N/A'}</td>
            <td class="px-6 py-4 text-zinc-400 font-medium">${m.category || 'Khác'} / ${m.releaseYear || m.year || 'N/A'}</td>
            <td class="px-6 py-4">
              <span class="px-2 py-0.5 rounded bg-zinc-950 border border-glass-stroke text-[11px] font-semibold">${m.episodeCurrent || 'Full'}</span>
            </td>
            <td class="px-6 py-4">
              ${configBadge}
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex gap-2 justify-end">
                <a href="/admin/phim/edit?th=${m.slug}" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center hover:text-primary hover:border-primary/50 transition-colors cursor-pointer" data-txatooltip="Cấu hình / Sửa">
                  <span class="material-symbols-outlined text-sm">settings</span>
                </a>
                <button onclick="deleteCrawledMovie('${m.slug}')" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center text-red-400 hover:text-red-500 hover:border-red-500/50 transition-colors cursor-pointer" data-txatooltip="Xóa">
                  <span class="material-symbols-outlined text-sm">delete</span>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      document.getElementById('crawledPaginationInfo').textContent = `Trang ${crawledCurrentPage} / ${totalPages}`;
      document.getElementById('crawledPrevBtn').disabled = (crawledCurrentPage === 1);
      document.getElementById('crawledNextBtn').disabled = (crawledCurrentPage === totalPages);
    }

    window.deleteCrawledMovie = function(slug) {
      const performDelete = async () => {
        try {
          const res = await fetch('/api/admin/movie-action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete', slug: slug, isStatic: false })
          });
          const result = await res.json();
          if (res.ok) {
            if (window.showGlobalToast) window.showGlobalToast('Đã xóa phim khỏi database thành công!', 'success');
            await loadExistingMoviesDict();
            renderCrawledList();
          } else {
            if (window.showGlobalToast) window.showGlobalToast(result.message || 'Lỗi khi xóa phim', 'error');
          }
        } catch (e) {
          if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API', 'error');
        }
      };

      if (window.txamodal) {
        window.txamodal.show({
          title: 'Xóa phim khỏi database',
          message: 'Bạn có chắc chắn muốn xóa phim này khỏi database không?',
          type: 'danger',
          confirmText: 'Xóa phim',
          cancelText: 'Hủy bỏ',
          onConfirm: performDelete
        });
      } else if (confirm('Bạn có chắc chắn muốn xóa phim này khỏi database không?')) {
        performDelete();
      }
    };

    document.getElementById('clearAllCrawledBtn').addEventListener('click', () => {
      if (window.showGlobalToast) window.showGlobalToast('Tính năng xóa hàng loạt đã được vô hiệu hóa để bảo vệ cơ sở dữ liệu!', 'warning');
    });

    // ONLINE SEARCH TRIGGER
    const searchKeywordInput = document.getElementById('searchKeyword');
    const searchOnlineBtn = document.getElementById('searchOnlineBtn');
    const searchResultBody = document.getElementById('searchResultBody');
    const emptySearchResult = document.getElementById('emptySearchResult');
    const searchResultTable = document.getElementById('searchResultTable');
    const selectAllSearch = document.getElementById('selectAllSearch');
    const cartCount = document.getElementById('cartCount');

    searchKeywordInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        searchOnlineBtn.click();
      }
    });

    searchOnlineBtn.addEventListener('click', async () => {
      const keyword = searchKeywordInput.value.trim();
      if (!keyword) {
        if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập từ khóa tìm kiếm!', 'error');
        return;
      }

      searchOnlineBtn.disabled = true;
      searchOnlineBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">autorenew</span>';
      
      try {
        const searchMode = document.getElementById('searchMode')?.value || 'movie';
        const crawlSource = document.getElementById('crawlSource')?.value || 'kkphim';
        let searchUrl = '';
        let responseData;
        
        if (crawlSource === 'tmdb') {
          // Use TMDB API for search
          searchUrl = `/api/admin/tmdb-search?keyword=${encodeURIComponent(keyword)}&limit=40`;
          const res = await fetch(searchUrl);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          responseData = await res.json();
        } else if (crawlSource === 'vsmov') {
          // Use VSMOV API
          searchUrl = `https://vsmov.com/api/tim-kiem?keyword=${encodeURIComponent(keyword)}`;
          const res = await fetch('/api/admin/proxy-crawler?url=' + encodeURIComponent(searchUrl));
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const resJson = await res.json();
          responseData = resJson.data;
        } else {
          // Use KKPhim API
          searchUrl = `https://phimapi.com/v1/api/tim-kiem?keyword=${encodeURIComponent(keyword)}&limit=40`;
          const isActor = searchMode === 'actor';
          if (isActor) {
            searchUrl = `/api/admin/actor-search?keyword=${encodeURIComponent(keyword)}`;
          }
          const finalUrl = isActor ? searchUrl : ('/api/admin/proxy-crawler?url=' + encodeURIComponent(searchUrl));
          const res = await fetch(finalUrl);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const resJson = await res.json();
          responseData = isActor ? resJson : resJson.data;
        }
        
        // Handle standard vs custom endpoint response structures
        let items = [];
        let cdnDomain = 'https://phimimg.com';
        if (crawlSource === 'tmdb') {
          items = responseData.data?.items || [];
          cdnDomain = responseData.data?.pathImage || 'https://image.tmdb.org/t/p/w500';
        } else if (searchMode === 'actor') {
          items = responseData.data?.items || [];
          cdnDomain = responseData.data?.pathImage || 'https://phimimg.com';
        } else if (crawlSource === 'vsmov') {
          items = responseData.items || [];
          cdnDomain = responseData.data?.pathImage || responseData.data?.APP_DOMAIN_CDN_IMAGE || 'https://vsmov.com';
        } else {
          items = responseData.data?.items || [];
          cdnDomain = responseData.data?.pathImage || responseData.data?.APP_DOMAIN_CDN_IMAGE || 'https://phimimg.com';
        }
        
        renderSearchResultsTable(items, cdnDomain, keyword);

      } catch (e) {
        if (window.showGlobalToast) window.showGlobalToast('Không tìm thấy phim trực tuyến: ' + e.message, 'error');
      } finally {
        searchOnlineBtn.disabled = false;
        searchOnlineBtn.innerHTML = 'Tìm kiếm';
      }
    });

    let currentSearchItems = [];
    let currentCdnDomain = 'https://phimimg.com';

    function renderSearchResultsTable(items, cdnDomain = currentCdnDomain, keyword = '') {
      currentSearchItems = items || [];
      if (cdnDomain) currentCdnDomain = cdnDomain;

      const isOverwrite = document.getElementById('overwrite')?.checked ?? true;
      const searchResultBody = document.getElementById('searchResultBody');
      const searchResultTable = document.getElementById('searchResultTable');
      const emptySearchResult = document.getElementById('emptySearchResult');
      const selectAllSearch = document.getElementById('selectAllSearch');

      if (!items || items.length === 0) {
        searchResultTable.classList.add('hidden');
        emptySearchResult.classList.remove('hidden');
        if (keyword) {
          emptySearchResult.innerHTML = `
            <span class="material-symbols-outlined text-5xl opacity-20 mb-3">search_off</span>
            <p class="text-zinc-400 text-sm">Không tìm thấy phim nào cho từ khóa "${keyword}".</p>
          `;
        }
        return;
      }

      emptySearchResult.classList.add('hidden');
      searchResultTable.classList.remove('hidden');
      
      searchResultBody.innerHTML = items.map(item => {
        const localCount = existingMoviesMap[item.slug] || 0;
        const isAlreadyInDb = existingMoviesMap[item.slug] !== undefined;
        const isSelected = cartSlugs.has(item.slug);
        const typeLabel = (item.type === 'single' ? 'Phim Lẻ' : item.type === 'hoathinh' ? 'Hoạt Hình' : item.type === 'tvshows' ? 'TV Show' : 'Phim Bộ') + ` [${item.source.toUpperCase()}]`;

        let posterUrl = item.poster_url || item.thumb_url || '';
        if (posterUrl) {
          if (!posterUrl.startsWith('http')) {
            posterUrl = `${currentCdnDomain}/${posterUrl.replace(/^\//, '')}`;
          }
        } else {
          posterUrl = '/logo.png';
        }

        const safeName = item.name.replace(/'/g, "\\'").replace(/"/g, '&quot;');
        const episodeCurrent = item.episode_current || '';
        const tmdbId = item.tmdb?.id || '';
        const tmdbType = item.tmdb?.type || '';

        // Extract API episode count from text (e.g., "Tập 36", "36/36", "Full")
        const apiEpMatch = episodeCurrent.match(/\d+/);
        const apiEpNum = apiEpMatch ? parseInt(apiEpMatch[0]) : (item.type === 'single' ? 1 : 0);
        
        // Check if API has newer episodes than DB
        const hasNewEpisodes = isAlreadyInDb && (apiEpNum > localCount || (episodeCurrent.toLowerCase().includes('full') && localCount < 1));
        const addedEpsCount = Math.max(1, apiEpNum - localCount);
        const isFullFilm = localCount > 9999;
        const displayCount = isFullFilm ? '∞' : localCount;

        // Show checkbox if overwrite is checked, OR if not in DB, OR if has new episodes
        const showCheckbox = isOverwrite || !isAlreadyInDb || hasNewEpisodes;

        let statusHtml = '';
        if (isAlreadyInDb) {
          if (hasNewEpisodes) {
            statusHtml = `
              <span class="text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 px-1.5 py-0.5 rounded text-[10px] font-bold inline-block">✓ Đã cào (${displayCount} tập)</span>
              <span class="text-amber-400 font-bold text-[10px] block mt-1 animate-pulse">🔥 Có +${addedEpsCount} tập mới! (${episodeCurrent})</span>
            `;
          } else {
            statusHtml = `<span class="text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 px-1.5 py-0.5 rounded text-[10px] font-bold">${isFullFilm ? '✓ Hoàn tất' : `✓ Đã cào (${displayCount} tập)`}</span>`;
          }
        } else {
          statusHtml = '<span class="text-zinc-500 bg-zinc-950 border border-glass-stroke px-1.5 py-0.5 rounded text-[10px]">Chưa cào</span>';
        }

        let actionBtnText = 'Cào ngay';
        if (isAlreadyInDb) {
          actionBtnText = hasNewEpisodes ? `Cào +${addedEpsCount} tập mới` : (isOverwrite ? 'Ghi đè phim' : 'Cào tiếp');
        }

        return `
          <tr class="border-b border-glass-stroke/50 hover:bg-white/5 transition-colors">
            <td class="px-5 py-3 text-center">
              ${showCheckbox 
                ? `<input type="checkbox" onchange="toggleCartItem(this, '${item.slug}', '${safeName}', '${item.type}', '${episodeCurrent}', '${tmdbId}', '${tmdbType}', '${crawlSource}')" 
                         ${isSelected ? 'checked' : ''} data-crawled="${isAlreadyInDb && !hasNewEpisodes ? 'true' : 'false'}" class="rounded border-zinc-700 bg-zinc-950 text-primary w-3.5 h-3.5 cursor-pointer item-checkbox"/>`
                : '<span class="text-zinc-600 text-xs font-bold select-none" data-txatooltip="Phim đã cào đầy đủ">—</span>'
              }
            </td>
            <td class="px-5 py-3">
              <div class="w-12 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke">
                <img src="${posterUrl}" class="w-full h-full object-cover" onerror="this.src='/logo.png'" alt="Poster" />
              </div>
            </td>
            <td class="px-5 py-3 font-semibold text-white">
              <div>${item.name}</div>
              <div class="text-[10px] text-zinc-500 font-mono mt-0.5">${item.origin_name} (${item.year})</div>
            </td>
            <td class="px-5 py-3">
              <span class="bg-zinc-900 border border-glass-stroke rounded px-1.5 py-0.5 text-[10px] font-bold text-zinc-300 mr-1">${item.quality || 'FHD'}</span>
              <span class="text-zinc-500 text-[10px] font-bold">${typeLabel}</span>
            </td>
            <td class="px-5 py-3 font-medium">
              ${statusHtml}
            </td>
            <td class="px-5 py-3 text-right">
              <button type="button" onclick="crawlSingleDirect('${item.slug}')" class="text-primary hover:underline font-bold text-xs cursor-pointer">
                ${actionBtnText}
              </button>
            </td>
          </tr>
        `;
      }).join('');

      if (selectAllSearch) selectAllSearch.checked = false;
    }

    // Re-render search results when overwrite checkbox toggles
    document.getElementById('overwrite')?.addEventListener('change', () => {
      if (currentSearchItems && currentSearchItems.length > 0) {
        renderSearchResultsTable(currentSearchItems);
      }
    });

    // Select all checkboxes search results
    selectAllSearch.addEventListener('change', (e) => {
      const checked = e.target.checked;
      const isOverwrite = document.getElementById('overwrite')?.checked ?? true;
      const checkboxes = document.querySelectorAll('.item-checkbox');
      checkboxes.forEach(cb => {
        if (checked) {
          // Nếu không ghi đè, bỏ qua film đã cào đầy đủ (data-crawled="true")
          // Film có tập mới (data-crawled="false") vẫn được chọn
          if (!isOverwrite && cb.getAttribute('data-crawled') === 'true') {
            cb.checked = false;
            return;
          }
          cb.checked = true;
        } else {
          cb.checked = false;
        }
        cb.dispatchEvent(new Event('change'));
      });
    });

    // Cart management
    window.toggleCartItem = function(checkbox, slug, name, type = 'single', episodeCurrent = '', tmdbId = '', tmdbType = '', source = 'kkphim') {
      if (checkbox.checked) {
        cartSlugs.set(slug, { name, type, episodeCurrent, tmdbId, tmdbType, source });
      } else {
        cartSlugs.delete(slug);
      }
      updateCartUI();
    };

    function updateCartUI() {
      cartCount.textContent = `${cartSlugs.size} phim`;
    }

    document.getElementById('clearCartBtn').addEventListener('click', () => {
      cartSlugs.clear();
      updateCartUI();
      const checkboxes = document.querySelectorAll('.item-checkbox');
      checkboxes.forEach(cb => cb.checked = false);
      selectAllSearch.checked = false;
      if (window.showGlobalToast) window.showGlobalToast('Đã dọn dẹp giỏ hàng!', 'info');
    });

    // Detailed Cart Modal and operations
    const viewCartBtn = document.getElementById('viewCartBtn');
    if (viewCartBtn) {
      viewCartBtn.addEventListener('click', () => {
        renderCartModal();
      });
    }

    function renderCartModal() {
      if (cartSlugs.size === 0) {
        if (window.txamodal) {
          window.txamodal.show({
            title: 'Chi tiết giỏ hàng cào phim',
            message: '<div class="text-center py-8 text-zinc-500 text-xs font-bold uppercase tracking-wider">Giỏ hàng của bạn đang trống.</div>',
            cancelText: 'Đóng'
          });
        } else {
          alert('Giỏ hàng đang trống!');
        }
        return;
      }

      const items = Array.from(cartSlugs.entries()).map(([slug, val]) => ({
        slug,
        name: val.name,
        type: val.type,
        episodeCurrent: val.episodeCurrent,
        tmdbId: val.tmdbId,
        tmdbType: val.tmdbType,
        source: val.source || 'kkphim'
      }));

      const totalPages = Math.ceil(items.length / cartPageSize);
      cartPage = Math.min(cartPage, totalPages);
      if (cartPage < 1) cartPage = 1;
      const startIdx = (cartPage - 1) * cartPageSize;
      const paginatedItems = items.slice(startIdx, startIdx + cartPageSize);

      const tableRows = paginatedItems.map((item, idx) => {
        const globalIdx = startIdx + idx + 1;
        const typeLabel = (item.type === 'single' ? 'Phim Lẻ' : item.type === 'hoathinh' ? 'Hoạt Hình' : item.type === 'tvshows' ? 'TV Show' : 'Phim Bộ') + ` [${item.source.toUpperCase()}]`;
        const crawlType = item.type === 'single' ? 'Cào phim full' : `Cào phim bộ (${item.episodeCurrent || 'Đang cập nhật'})`;

        return `
          <tr class="border-b border-glass-stroke/30 text-xs">
            <td class="px-4 py-2.5 font-mono text-[10px] text-zinc-500">${globalIdx}</td>
            <td class="px-4 py-2.5 font-bold text-white">
              <div>${item.name}</div>
              <div class="text-[9px] text-zinc-500 font-mono">${item.slug}</div>
            </td>
            <td class="px-4 py-2.5 text-zinc-400 font-sans">${typeLabel}</td>
            <td class="px-4 py-2.5 text-zinc-400 font-sans">${crawlType}</td>
            <td class="px-4 py-2.5 text-right">
              <button onclick="removeCartItemAndRefresh('${item.slug}')" class="text-rose-400 hover:text-rose-300 font-bold p-1 bg-transparent border-none cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">delete</span>
              </button>
            </td>
          </tr>
        `;
      }).join('');

      const html = `
        <div class="space-y-4 min-w-[500px]" style="font-family: system-ui, -apple-system, sans-serif;">
          <div class="max-h-[300px] overflow-y-auto border border-glass-stroke rounded-xl bg-black/40 custom-scrollbar">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-zinc-950/80 border-b border-glass-stroke text-[10px] font-bold text-zinc-500 uppercase tracking-wider">
                  <th class="px-4 py-2.5 w-8">#</th>
                  <th class="px-4 py-2.5">Phim</th>
                  <th class="px-4 py-2.5">Loại</th>
                  <th class="px-4 py-2.5">Phân loại cào</th>
                  <th class="px-4 py-2.5 text-right w-12">Hành động</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-glass-stroke/20">
                ${tableRows}
              </tbody>
            </table>
          </div>

          <!-- Pagination Controls -->
          <div class="flex items-center justify-between gap-4 text-xs pt-2">
            <div class="flex items-center gap-2">
              <span class="text-zinc-500 font-bold">Hiển thị:</span>
              <select id="cartPageSizeSelect" onchange="changeCartPageSize(this.value)" class="bg-zinc-900 border border-zinc-800 rounded-lg px-2 py-1 text-white font-bold cursor-pointer focus:outline-none">
                <option value="5" ${cartPageSize === 5 ? 'selected' : ''}>5 phim</option>
                <option value="10" ${cartPageSize === 10 ? 'selected' : ''}>10 phim</option>
                <option value="20" ${cartPageSize === 20 ? 'selected' : ''}>20 phim</option>
                <option value="50" ${cartPageSize === 50 ? 'selected' : ''}>50 phim</option>
              </select>
            </div>
            
            <div class="flex items-center gap-3">
              <button onclick="changeCartPage(-1)" ${cartPage === 1 ? 'disabled class="opacity-30 cursor-not-allowed px-3 py-1 bg-white/5 border border-white/10 text-white rounded-lg font-bold"' : 'class="cursor-pointer px-3 py-1 bg-white/5 border border-white/10 hover:border-primary/50 text-white rounded-lg font-bold"'}>
                Trước
              </button>
              <span class="text-zinc-400 font-mono">Trang ${cartPage} / ${totalPages}</span>
              <button onclick="changeCartPage(1)" ${cartPage === totalPages ? 'disabled class="opacity-30 cursor-not-allowed px-3 py-1 bg-white/5 border border-white/10 text-white rounded-lg font-bold"' : 'class="cursor-pointer px-3 py-1 bg-white/5 border border-white/10 hover:border-primary/50 text-white rounded-lg font-bold"'}>
                Sau
              </button>
            </div>
          </div>
        </div>
      `;

      if (window.txamodal) {
        window.txamodal.show({
          title: `Chi tiết Giỏ hàng (${items.length} phim)`,
          message: html,
          cancelText: 'Đóng'
        });
      }
    }

    window.removeCartItemAndRefresh = function(slug) {
      cartSlugs.delete(slug);
      updateCartUI();
      
      // Uncheck corresponding checkbox in search table if visible
      const checkboxes = document.querySelectorAll('.item-checkbox');
      checkboxes.forEach(cb => {
        const onchangeAttr = cb.getAttribute('onchange') || '';
        if (onchangeAttr.includes(`'${slug}'`) || onchangeAttr.includes(`"${slug}"`)) {
          cb.checked = false;
        }
      });
      
      renderCartModal();
    };

    window.changeCartPage = function(dir) {
      cartPage += dir;
      renderCartModal();
    };

    window.changeCartPageSize = function(size) {
      cartPageSize = parseInt(size) || 10;
      cartPage = 1;
      renderCartModal();
    };

    // MAP KKPHIM DATA HELPER
    function mapKKPhimToMovieDetail(data, source = 'kkphim') {
      const m = data.movie || data.item;
      const defaultCdn = source === 'vsmov' ? 'https://vsmov.com' : 'https://phimimg.com';
      const cdnDomain = data.pathImage || data.APP_DOMAIN_CDN_IMAGE || defaultCdn;
      
      let posterUrl = m.poster_url || '';
      if (posterUrl && !posterUrl.startsWith('http')) {
        posterUrl = `${cdnDomain}/${posterUrl.replace(/^\//, '')}`;
      }
      let bannerUrl = m.thumb_url || m.poster_url || '';
      if (bannerUrl && !bannerUrl.startsWith('http')) {
        bannerUrl = `${cdnDomain}/${bannerUrl.replace(/^\//, '')}`;
      }

      const catList = m.category || m.categories;
      const genres = Array.isArray(catList) ? catList.map(c => c.name) : [];
      
      let category = "Khác";
      if (Array.isArray(catList) && catList.length > 0) {
        category = catList[0].name;
      }

      const countryList = m.country || m.countries;
      let country = "Khác";
      if (Array.isArray(countryList) && countryList.length > 0) {
        country = countryList[0].name;
      }

      let type = 'series';
      if (m.type === 'single') {
        type = 'movie';
      } else if (m.type === 'hoathinh') {
        type = 'hoathinh';
      } else if (m.type === 'tvshows') {
        type = 'tvshows';
      }

      const episodes = Array.isArray(data.episodes) ? data.episodes.map(server => {
        return {
          serverName: server.server_name || "Server VIP",
          serverData: Array.isArray(server.server_data) ? server.server_data.map(ep => {
            let epName = ep.name || '';
            if (epName.trim().match(/^\d+$/)) {
              epName = `Tập ${epName.padStart(2, '0')}`;
            }
            return {
              name: epName,
              slug: ep.slug || `tap-${ep.name}`,
              filename: ep.filename || `${m.name} - Tap ${ep.name}`,
              linkEmbed: ep.link_embed || '',
              linkM3u8: ep.link_m3u8 || '',
              subtitles: ep.subtitles || ep.subtitles_data || [],
              timeIntroStart: ep.timeIntroStart || ep.time_intro_start || 0,
              timeIntroEnd: ep.timeIntroEnd || ep.time_intro_end || 0,
              timeOutroStart: ep.timeOutroStart || ep.time_outro_start || 0,
              timeOutroEnd: ep.timeOutroEnd || ep.time_outro_end || 0
            };
          }) : []
        };
      }) : [];

  // Check if episodes only have empty/placeholder links
  let hasActualStreamingLinks = false;
  for (const srv of episodes) {
    for (const ep of (srv.serverData || [])) {
      if ((ep.linkM3u8 || '').trim() || (ep.linkEmbed || '').trim()) {
        hasActualStreamingLinks = true;
        break;
      }
    }
    if (hasActualStreamingLinks) break;
  }

  let finalEpisodes = episodes;
  let finalEpisodeCurrent = m.episode_current || (type === 'movie' ? 'Full' : '1');

  if (!hasActualStreamingLinks) {
    finalEpisodes = [];
    finalEpisodeCurrent = "Sắp chiếu";
  }

  return {
    id: m._id || m.id || `kk-${m.slug}`,
    title: m.name,
    originalTitle: m.origin_name,
    slug: m.slug,
    description: m.content ? m.content.replace(/<[^>]*>/g, '') : '',
    posterUrl: posterUrl,
    bannerUrl: bannerUrl,
    releaseYear: parseInt(m.year) || 2025,
    durationMinutes: m.time || (type === 'movie' ? '120 phút' : '45 phút/tập'),
    type: type,
    status: m.status === 'completed' ? 'completed' : 'ongoing',
    episodeCurrent: finalEpisodeCurrent,
    episodeTotal: m.episode_total || '1',
    quality: m.quality || 'FHD',
    lang: m.lang || 'Vietsub',
    imdbScore: 8.0,
    category: category,
    country: country,
    ageRating: type === 'movie' ? 'T16' : 'T13',
    genres: genres,
    seasons: type === 'movie' ? 'Bản Điện Ảnh' : 'Phần 1',
    actors: Array.isArray(m.actor || m.actors) ? (m.actor || m.actors).filter(Boolean) : [],
    directors: Array.isArray(m.director || m.directors) ? (m.director || m.directors).filter(Boolean) : [],
    trailerUrl: m.trailer_url || '',
    episodes: finalEpisodes
  };
}

    function saveCrawlSession(slugsList, currentIndex, success, skipped, failed) {
      const session = {
        slugsList,
        currentIndex,
        success,
        skipped,
        failed,
        overwrite: document.getElementById('overwrite')?.checked ?? true,
        logsHTML: document.getElementById('logTerminalBody')?.innerHTML || '',
        activeTab,
        timestamp: Date.now()
      };
      localStorage.setItem('webfilm_crawl_session', JSON.stringify(session));
    }

    function clearCrawlSession() {
      localStorage.removeItem('webfilm_crawl_session');
    }

    function startCountdownTimer() {
      if (countdownTimerId) clearInterval(countdownTimerId);
      countdownTimerId = setInterval(() => {
        if (remainingTimeSeconds > 0) {
          remainingTimeSeconds = Math.max(0, remainingTimeSeconds - 1);
          const progressTimeEstimate = document.getElementById('progressTimeEstimate');
          if (progressTimeEstimate && isRunning && !isPaused) {
            progressTimeEstimate.textContent = `Thời gian còn lại: ~${remainingTimeSeconds} giây`;
          }
        }
      }, 1000);
    }

    function stopCountdownTimer() {
      if (countdownTimerId) {
        clearInterval(countdownTimerId);
        countdownTimerId = null;
      }
    }

    function restoreSession(session) {
      // Restore settings
      const overwriteEl = document.getElementById('overwrite');
      if (overwriteEl) overwriteEl.checked = session.overwrite;

      // Restore logs
      const logBody = document.getElementById('logTerminalBody');
      if (logBody) {
        logBody.innerHTML = session.logsHTML;
        logBody.scrollTop = logBody.scrollHeight;
      }

      // Switch Tab
      if (session.activeTab === 'advanced') {
        tabAdvancedBtn.click();
      } else if (session.activeTab === 'vsmov') {
        tabVsmovBtn.click();
      } else if (session.activeTab === 'tmdb') {
        tabTmdbBtn.click();
      } else {
        tabKkphimBtn.click();
      }

      // Hide search container during crawl if on advanced tab
      if (activeTab === 'advanced') {
        containerSearchTab.classList.add('hidden');
      }

      // Trigger crawl resume
      runCrawlProcess(session.slugsList, session.currentIndex, session.success, session.skipped, session.failed);
    }

    function checkAndRestoreCrawlSession() {
      const saved = localStorage.getItem('webfilm_crawl_session');
      if (saved) {
        try {
          const session = JSON.parse(saved);
          const age = Date.now() - session.timestamp;
          // Valid within 24 hours and not yet finished
          if (age < 24 * 60 * 60 * 1000 && session.slugsList && session.slugsList.length > 0 && session.currentIndex < session.slugsList.length) {
            setTimeout(() => {
              if (window.txamodal) {
                window.txamodal.show({
                  title: 'Khôi phục phiên cào dở dang',
                  message: `Phát hiện phiên cào phim trước đó chưa hoàn thành (${session.currentIndex}/${session.slugsList.length} phim). Bạn có muốn tiếp tục cào tiếp từ phim thứ ${session.currentIndex + 1} không?`,
                  confirmText: 'Khôi phục và Cào tiếp',
                  cancelText: 'Hủy bỏ / Bắt đầu mới',
                  onConfirm: () => {
                    restoreSession(session);
                  },
                  onCancel: () => {
                    clearCrawlSession();
                  }
                });
              }
            }, 1000);
          }
        } catch (e) {
          console.error('Error restoring session:', e);
        }
      }
    }

    document.getElementById('btnPauseCrawl')?.addEventListener('click', () => {
      isPaused = true;
      document.getElementById('btnPauseCrawl')?.classList.add('hidden');
      document.getElementById('btnResumeCrawl')?.classList.remove('hidden');
      addLog(`⏸️ Đã tạm dừng tiến trình cào phim.`, 'warning');
    });

    document.getElementById('btnResumeCrawl')?.addEventListener('click', () => {
      isPaused = false;
      document.getElementById('btnPauseCrawl')?.classList.remove('hidden');
      document.getElementById('btnResumeCrawl')?.classList.add('hidden');
      addLog(`▶️ Tiếp tục tiến trình cào phim...`, 'system');
    });

    document.getElementById('btnCancelCrawl')?.addEventListener('click', () => {
      shouldStop = true;
      isPaused = false;
      isRunning = false;
      document.getElementById('btnPauseCrawl')?.classList.add('hidden');
      document.getElementById('btnResumeCrawl')?.classList.add('hidden');
      document.getElementById('btnCancelCrawl')?.classList.add('hidden');
      clearCrawlSession();
    });

    // CORE SEQUENTIAL CRAWLER PROCESS
    async function runCrawlProcess(slugsList, startIndex = 0, initialSuccess = 0, initialSkipped = 0, initialFailed = 0) {
      if (isRunning) return;
      isRunning = true;
      shouldStop = false;
      isPaused = false;

      // Update control buttons state
      document.getElementById('btnPauseCrawl')?.classList.remove('hidden');
      document.getElementById('btnResumeCrawl')?.classList.add('hidden');
      document.getElementById('btnCancelCrawl')?.classList.remove('hidden');

      // Hide search container during crawl if on advanced tab
      if (activeTab === 'advanced') {
        containerSearchTab.classList.add('hidden');
      }

      // Reset statistics or load initial state if resuming
      let success = initialSuccess;
      let skipped = initialSkipped;
      let failed = initialFailed;
      
      const overwrite = document.getElementById('overwrite').checked;
      
      document.getElementById('statSuccess').textContent = success;
      document.getElementById('statSkipped').textContent = skipped;
      document.getElementById('statFailed').textContent = failed;

      const progressSection = document.getElementById('progressSection');
      const currentMovieName = document.getElementById('currentMovieName');
      const moviesCountProgress = document.getElementById('moviesCountProgress');
      const progressPercent = document.getElementById('progressPercent');
      const mainProgressBar = document.getElementById('mainProgressBar');
      const progressTimeEstimate = document.getElementById('progressTimeEstimate');
      const stopStandardBtn = document.getElementById('stopStandardBtn');

      progressSection.classList.remove('hidden');
      statusIndicator.className = 'w-2.5 h-2.5 rounded-full bg-primary animate-pulse';
      const startButtons = [
        document.getElementById('startKkphimBtn'),
        document.getElementById('startVsmovBtn'),
        document.getElementById('startTmdbBtn'),
        document.getElementById('startCartCrawlBtn')
      ];
      startButtons.forEach(btn => {
        if (btn) btn.classList.add('pointer-events-none', 'opacity-40');
      });
      if (stopStandardBtn) stopStandardBtn.classList.remove('hidden');

      if (startIndex === 0) {
        addLog(`🚀 Khởi động tiến trình cào ${slugsList.length} phim trong hàng đợi...`, 'system');
      } else {
        addLog(`🔄 Khôi phục tiến trình cào, tiếp tục từ phim ${startIndex + 1}/${slugsList.length}...`, 'system');
      }

      // Set initial countdown time estimate and start active countdown
      remainingTimeSeconds = Math.ceil((slugsList.length - startIndex) * 1.2);
      startCountdownTimer();

      for (let i = startIndex; i < slugsList.length; i++) {
        if (shouldStop) {
          addLog(`⚠️ Đã dừng tiến trình thu thập phim do Admin dừng!`, 'warning');
          break;
        }

        while (isPaused) {
          if (shouldStop) break;
          // Save session state to localStorage while paused
          saveCrawlSession(slugsList, i, success, skipped, failed);
          await new Promise(r => setTimeout(r, 500));
        }

        if (shouldStop) {
          addLog(`⚠️ Đã dừng tiến trình thu thập phim do Admin dừng!`, 'warning');
          break;
        }

        // Save session state at start of each item
        saveCrawlSession(slugsList, i, success, skipped, failed);

        const slug = slugsList[i];
        currentMovieName.textContent = `[${i+1}/${slugsList.length}] Đang xử lý: ${slug}`;
        moviesCountProgress.textContent = `Tiến trình: ${i+1}/${slugsList.length} phim`;
        
        const pct = Math.round(((i + 1) / slugsList.length) * 100);
        progressPercent.textContent = `${pct}%`;
        mainProgressBar.style.width = `${pct}%`;

        // Dynamically get crawlSource for this item (mixed source support)
        let itemSource = 'kkphim';
        const cartItem = cartSlugs.get(slug);
        if (cartItem && cartItem.source) {
          itemSource = cartItem.source;
        } else {
          itemSource = document.getElementById('crawlSource')?.value || 'kkphim';
        }
        document.getElementById('crawlSource').value = itemSource;
        const crawlSource = itemSource;

        // Check if exists in database
        const dup = existingMoviesMap[slug] !== undefined;
        let currentEpisodeCount = existingMoviesMap[slug] || 0;
        let apiEpisodeCount = 0;

        let isUpdateMode = false;
        if (crawlSource === 'kkphim') {
          isUpdateMode = (document.getElementById('kkphimMode')?.value === 'new_updated');
        } else if (crawlSource === 'vsmov') {
          isUpdateMode = (document.getElementById('vsmovMode')?.value === 'new_updated');
        }
        
        if (dup && !overwrite && !isUpdateMode) {
          skipped++;
          document.getElementById('statSkipped').textContent = skipped;
          addLog(`→ Bỏ qua (đã cào & không ghi đè): ${slug}`, 'warning');
          continue;
        }
        const sourceLabel = crawlSource.toUpperCase();
        addLog(`⏳ Đang cào dữ liệu chi tiết từ ${sourceLabel} cho slug: ${slug}...`);
        
        try {
          let movieDetailObj;
          
          if (crawlSource === 'tmdb') {
            // Crawl from TMDB API
            // For TMDB, slug format is: title-year, we need to extract tmdb_id from cart or search
            // Check if this slug has TMDB info in cart
            const cartItem = cartSlugs.get(slug);
            if (cartItem && cartItem.tmdbId) {
              const tmdbDetailUrl = `/api/admin/tmdb-detail?tmdb_id=${cartItem.tmdbId}&tmdb_type=${cartItem.tmdbType || 'movie'}`;
              const tmdbRes = await fetch(tmdbDetailUrl);
              if (!tmdbRes.ok) throw new Error(`HTTP ${tmdbRes.status}`);
              
              const tmdbData = await tmdbRes.json();
              if (tmdbData.status !== 'success' || !tmdbData.data) {
                throw new Error('TMDB API trả về dữ liệu không hợp lệ');
              }
              
              movieDetailObj = tmdbData.data;
              movieDetailObj.updatedAt = new Date().toISOString();
              movieDetailObj.source = 'tmdb';
              
              // Note: TMDB doesn't provide streaming links, so episodes will be empty
              // User will need to manually add episodes or use another source
              addLog(`⚠️ TMDB chỉ cung cấp thông tin phim, không có link streaming. Bạn cần thêm tập thủ công sau khi cào.`, 'warning');
            } else {
              throw new Error('Không tìm thấy thông tin TMDB cho phim này. Vui lòng tìm kiếm lại từ TMDB.');
            }
          } else {
            // Crawl from KKPhim API or VSMOV API
            const isVsmov = crawlSource === 'vsmov';
            const detailUrl = isVsmov ? `https://vsmov.com/api/phim/${slug}` : `https://phimapi.com/phim/${slug}`;
            const detailRes = await fetch('/api/admin/proxy-crawler?url=' + encodeURIComponent(detailUrl));
            if (!detailRes.ok) {
              const errJson = await detailRes.json().catch(() => ({}));
              throw new Error(errJson.message || `HTTP ${detailRes.status}`);
            }
            
            const resJson = await detailRes.json();
            if (resJson.status !== 'success') throw new Error(resJson.message || 'Lỗi tải chi tiết phim');
            const detailData = resJson.data;

            const movieObj = detailData?.movie || detailData?.item;
            if (detailData && movieObj && Array.isArray(detailData.episodes)) {
              // Compare episodes count to see if update exists
              apiEpisodeCount = Math.max(...(detailData.episodes || []).map((server) => (server.server_data || server.serverData || []).length), 0);

              if (!overwrite && currentEpisodeCount > 0 && apiEpisodeCount <= currentEpisodeCount) {
                skipped++;
                document.getElementById('statSkipped').textContent = skipped;
                addLog(`→ Bỏ qua vì đã đầy đủ tập phim (${currentEpisodeCount}/${apiEpisodeCount} tập): "${movieObj.name}"`, 'warning');
                continue;
              }

              movieDetailObj = mapKKPhimToMovieDetail(detailData, crawlSource);
              movieDetailObj.updatedAt = new Date().toISOString();
              movieDetailObj.source = isVsmov ? 'vsmov' : 'kkphim';
            
              // Fetch TMDB images and override if available
              if (movieObj.tmdb && movieObj.tmdb.id) {
                const tmdbId = movieObj.tmdb.id;
                const tmdbType = movieObj.tmdb.type === 'tv' ? 'tv' : 'movie';
                try {
                  const tmdbRes = await fetch(`/api/tmdb-proxy?path=/3/${tmdbType}/${tmdbId}&language=vi-VN`);
                  if (tmdbRes.ok) {
                    const tmdbData = await tmdbRes.json();
                    if (tmdbData.poster_path) {
                      movieDetailObj.posterUrl = `https://image.tmdb.org/t/p/original${tmdbData.poster_path}`;
                    }
                    if (tmdbData.backdrop_path) {
                      movieDetailObj.bannerUrl = `https://image.tmdb.org/t/p/original${tmdbData.backdrop_path}`;
                    }
                    if (tmdbData.vote_average) {
                      movieDetailObj.tmdbScore = tmdbData.vote_average;
                    }

                    // If it's a TV Show, fetch season details to get episode thumbnail stills
                    if (tmdbType === 'tv') {
                      let seasonNumber = 1;
                      if (movieObj.tmdb.season !== undefined) {
                        seasonNumber = parseInt(movieObj.tmdb.season) || 1;
                      } else {
                        const seasonsName = movieDetailObj.seasons || '';
                        const matchSeason = seasonsName.match(/\d+/);
                        if (matchSeason) {
                          seasonNumber = parseInt(matchSeason[0]) || 1;
                        }
                      }

                      try {
                        let seasonRes = await fetch(`/api/tmdb-proxy?path=/3/tv/${tmdbId}/season/${seasonNumber}&language=vi-VN`);
                        if (!seasonRes.ok && seasonNumber !== 1) {
                          addLog(`⚠️ Không thể lấy thông tin Season ${seasonNumber} từ TMDB. Thử lại với Season 1...`, 'warning');
                          seasonNumber = 1;
                          seasonRes = await fetch(`/api/tmdb-proxy?path=/3/tv/${tmdbId}/season/1&language=vi-VN`);
                        }
                        
                        if (seasonRes.ok) {
                          const seasonData = await seasonRes.json();
                          if (seasonData && Array.isArray(seasonData.episodes)) {
                            const tmdbEps = seasonData.episodes;
                            if (Array.isArray(movieDetailObj.episodes)) {
                              movieDetailObj.episodes.forEach(server => {
                                const srvData = server.serverData || server.server_data || [];
                                if (Array.isArray(srvData)) {
                                  srvData.forEach((ep, epIdx) => {
                                    const tmdbEp = tmdbEps[epIdx];
                                    if (tmdbEp && tmdbEp.still_path) {
                                      ep.thumbUrl = `https://image.tmdb.org/t/p/original${tmdbEp.still_path}`;
                                    } else {
                                      ep.thumbUrl = movieDetailObj.bannerUrl || movieDetailObj.posterUrl || '';
                                    }
                                  });
                                }
                              });
                              addLog(`✓ Đã cập nhật ảnh thumbnail riêng biệt từ TMDB cho ${seasonData.episodes.length} tập phim.`, 'success');
                            }
                          }
                        }
                      } catch (errSeason) {
                        addLog(`⚠️ Không thể lấy ảnh tập phim từ TMDB Season ${seasonNumber}: ${errSeason.message}. Dùng ảnh banner làm mặc định.`, 'warning');
                        fallbackEpisodeThumbs(movieDetailObj);
                      }
                    } else {
                      // For single movies, use the movie's main banner/poster as the episode's thumbnail
                      fallbackEpisodeThumbs(movieDetailObj);
                    }

                    function fallbackEpisodeThumbs(movieObj) {
                      if (Array.isArray(movieObj.episodes)) {
                        movieObj.episodes.forEach(server => {
                          const srvData = server.serverData || server.server_data || [];
                          if (Array.isArray(srvData)) {
                            srvData.forEach(ep => {
                              ep.thumbUrl = movieObj.bannerUrl || movieObj.posterUrl || '';
                            });
                          }
                        });
                      }
                    }
                  }
                } catch (e) {
                  addLog(`⚠️ Không thể lấy thông tin TMDB: ${e.message}`, 'warning');
                }
              }
            } else {
              throw new Error('Payload API bị lỗi hoặc trống');
            }
          }

          // Save to database Supabase via API (common for both sources)
          if (movieDetailObj) {
            const saveRes = await fetch('/api/admin/movie-action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'save',
                slug: slug,
                movieData: movieDetailObj,
                isStatic: false
              })
            });
            if (!saveRes.ok) {
              let errMsg = 'Lỗi khi lưu phim vào database';
              try {
                const saveText = await saveRes.text();
                if (saveText.trim().startsWith('<')) {
                  const matchTitle = saveText.match(/<title>([^<]*)<\/title>/i);
