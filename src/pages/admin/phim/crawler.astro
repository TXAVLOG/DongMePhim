    window.deleteCrawledMovie = function(slug) {
      const performDelete = async () => {
        try {
          const res = await fetch('/api/admin/movie-action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete', slug: slug, isStatic: false })
          });
          const result = await res.json();
          if (res.ok) {
            if (window.showGlobalToast) window.showGlobalToast('Đã xóa phim khỏi database thành công!', 'success');
            await loadExistingMoviesDict();
            renderCrawledList();
          } else {
            if (window.showGlobalToast) window.showGlobalToast(result.message || 'Lỗi khi xóa phim', 'error');
          }
        } catch (e) {
          if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API', 'error');
        }
      };

      if (window.txamodal) {
        window.txamodal.show({
          title: 'Xóa phim khỏi database',
          message: 'Bạn có chắc chắn muốn xóa phim này khỏi database không?',
          type: 'danger',
          confirmText: 'Xóa phim',
          cancelText: 'Hủy bỏ',
          onConfirm: performDelete
        });
      } else if (confirm('Bạn có chắc chắn muốn xóa phim này khỏi database không?')) {
        performDelete();
      }
    };

    document.getElementById('clearAllCrawledBtn').addEventListener('click', () => {
      if (window.showGlobalToast) window.showGlobalToast('Tính năng xóa hàng loạt đã được vô hiệu hóa để bảo vệ cơ sở dữ liệu!', 'warning');
    });

    // ONLINE SEARCH TRIGGER
    const searchKeywordInput = document.getElementById('searchKeyword');
    const searchOnlineBtn = document.getElementById('searchOnlineBtn');
    const searchResultBody = document.getElementById('searchResultBody');
    const emptySearchResult = document.getElementById('emptySearchResult');
    const searchResultTable = document.getElementById('searchResultTable');
    const selectAllSearch = document.getElementById('selectAllSearch');
    const cartCount = document.getElementById('cartCount');

    searchKeywordInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        searchOnlineBtn.click();
      }
    });

    searchOnlineBtn.addEventListener('click', async () => {
      const keyword = searchKeywordInput.value.trim();
      if (!keyword) {
        if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập từ khóa tìm kiếm!', 'error');
        return;
      }

      searchOnlineBtn.disabled = true;
      searchOnlineBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">autorenew</span>';
      
      try {
        const searchMode = document.getElementById('searchMode')?.value || 'movie';
        const crawlSource = document.getElementById('crawlSource')?.value || 'kkphim';
        let searchUrl = '';
        let responseData;
        
        if (crawlSource === 'tmdb') {
          // Use TMDB API for search
          searchUrl = `/api/admin/tmdb-search?keyword=${encodeURIComponent(keyword)}&limit=40`;
          const res = await fetch(searchUrl);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          responseData = await res.json();
        } else {
          // Use KKPhim API
          searchUrl = `https://phimapi.com/v1/api/tim-kiem?keyword=${encodeURIComponent(keyword)}&limit=40`;
          if (searchMode === 'actor') {
            searchUrl = `/api/admin/actor-search?keyword=${encodeURIComponent(keyword)}`;
          }
          const res = await fetch(searchUrl);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          responseData = await res.json();
        }
        
        // Handle standard vs custom endpoint response structures
        let items = [];
        let cdnDomain = 'https://phimimg.com';
        if (crawlSource === 'tmdb') {
          items = responseData.data?.items || [];
          cdnDomain = responseData.data?.pathImage || 'https://image.tmdb.org/t/p/w500';
        } else if (searchMode === 'actor') {
          items = responseData.data?.items || [];
          cdnDomain = responseData.data?.pathImage || 'https://phimimg.com';
        } else {
          items = responseData.data?.items || [];
          cdnDomain = responseData.data?.pathImage || responseData.data?.APP_DOMAIN_CDN_IMAGE || 'https://phimimg.com';
        }
        
        renderSearchResultsTable(items, cdnDomain, keyword);

      } catch (e) {
        if (window.showGlobalToast) window.showGlobalToast('Không tìm thấy phim trực tuyến: ' + e.message, 'error');
      } finally {
        searchOnlineBtn.disabled = false;
        searchOnlineBtn.innerHTML = 'Tìm kiếm';
      }
    });

    let currentSearchItems = [];
    let currentCdnDomain = 'https://phimimg.com';

    function renderSearchResultsTable(items, cdnDomain = currentCdnDomain, keyword = '') {
      currentSearchItems = items || [];
      if (cdnDomain) currentCdnDomain = cdnDomain;

      const isOverwrite = document.getElementById('overwrite')?.checked ?? true;
      const searchResultBody = document.getElementById('searchResultBody');
      const searchResultTable = document.getElementById('searchResultTable');
      const emptySearchResult = document.getElementById('emptySearchResult');
      const selectAllSearch = document.getElementById('selectAllSearch');

      if (!items || items.length === 0) {
        searchResultTable.classList.add('hidden');
        emptySearchResult.classList.remove('hidden');
        if (keyword) {
          emptySearchResult.innerHTML = `
            <span class="material-symbols-outlined text-5xl opacity-20 mb-3">search_off</span>
            <p class="text-zinc-400 text-sm">Không tìm thấy phim nào cho từ khóa "${keyword}".</p>
          `;
        }
        return;
      }

      emptySearchResult.classList.add('hidden');
      searchResultTable.classList.remove('hidden');
      
      searchResultBody.innerHTML = items.map(item => {
        const localCount = existingMoviesMap[item.slug] || 0;
        const isAlreadyInDb = existingMoviesMap[item.slug] !== undefined;
        const isSelected = cartSlugs.has(item.slug);
        const typeLabel = item.type === 'single' ? 'Phim Lẻ' : item.type === 'hoathinh' ? 'Hoạt Hình' : item.type === 'tvshows' ? 'TV Show' : 'Phim Bộ';

        let posterUrl = item.poster_url || item.thumb_url || '';
        if (posterUrl) {
          if (!posterUrl.startsWith('http')) {
            posterUrl = `${currentCdnDomain}/${posterUrl.replace(/^\//, '')}`;
          }
        } else {
          posterUrl = '/logo.png';
        }

        const safeName = item.name.replace(/'/g, "\\'").replace(/"/g, '&quot;');
        const episodeCurrent = item.episode_current || '';
        const tmdbId = item.tmdb?.id || '';
        const tmdbType = item.tmdb?.type || '';

        // Extract API episode count from text (e.g., "Tập 36", "36/36", "Full")
        const apiEpMatch = episodeCurrent.match(/\d+/);
        const apiEpNum = apiEpMatch ? parseInt(apiEpMatch[0]) : (item.type === 'single' ? 1 : 0);
        
        // Check if API has newer episodes than DB
        const hasNewEpisodes = isAlreadyInDb && (apiEpNum > localCount || (episodeCurrent.toLowerCase().includes('full') && localCount < 1));
        const addedEpsCount = Math.max(1, apiEpNum - localCount);

        // Show checkbox if overwrite is checked, OR if not in DB, OR if has new episodes
        const showCheckbox = isOverwrite || !isAlreadyInDb || hasNewEpisodes;

        let statusHtml = '';
        if (isAlreadyInDb) {
          if (hasNewEpisodes) {
            statusHtml = `
              <span class="text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 px-1.5 py-0.5 rounded text-[10px] font-bold inline-block">✓ Đã cào (${localCount} tập)</span>
              <span class="text-amber-400 font-bold text-[10px] block mt-1 animate-pulse">🔥 Có +${addedEpsCount} tập mới! (${episodeCurrent})</span>
            `;
          } else {
            statusHtml = `<span class="text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 px-1.5 py-0.5 rounded text-[10px] font-bold">✓ Đã cào (${localCount} tập)</span>`;
          }
        } else {
          statusHtml = '<span class="text-zinc-500 bg-zinc-950 border border-glass-stroke px-1.5 py-0.5 rounded text-[10px]">Chưa cào</span>';
        }

        let actionBtnText = 'Cào ngay';
        if (isAlreadyInDb) {
          actionBtnText = hasNewEpisodes ? `Cào +${addedEpsCount} tập mới` : (isOverwrite ? 'Ghi đè phim' : 'Cào tiếp');
        }

        return `
          <tr class="border-b border-glass-stroke/50 hover:bg-white/5 transition-colors">
            <td class="px-5 py-3 text-center">
              ${showCheckbox 
                ? `<input type="checkbox" onchange="toggleCartItem(this, '${item.slug}', '${safeName}', '${item.type}', '${episodeCurrent}', '${tmdbId}', '${tmdbType}')" 
                         ${isSelected ? 'checked' : ''} data-crawled="${isAlreadyInDb && !hasNewEpisodes ? 'true' : 'false'}" class="rounded border-zinc-700 bg-zinc-950 text-primary w-3.5 h-3.5 cursor-pointer item-checkbox"/>`
                : '<span class="text-zinc-600 text-xs font-bold select-none" data-txatooltip="Phim đã cào đầy đủ">—</span>'
              }
            </td>
            <td class="px-5 py-3">
              <div class="w-12 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke">
                <img src="${posterUrl}" class="w-full h-full object-cover" onerror="this.src='/logo.png'" alt="Poster" />
              </div>
            </td>
            <td class="px-5 py-3 font-semibold text-white">
              <div>${item.name}</div>
              <div class="text-[10px] text-zinc-500 font-mono mt-0.5">${item.origin_name} (${item.year})</div>
            </td>
            <td class="px-5 py-3">
              <span class="bg-zinc-900 border border-glass-stroke rounded px-1.5 py-0.5 text-[10px] font-bold text-zinc-300 mr-1">${item.quality || 'FHD'}</span>
              <span class="text-zinc-500 text-[10px] font-bold">${typeLabel}</span>
            </td>
            <td class="px-5 py-3 font-medium">
              ${statusHtml}
            </td>
            <td class="px-5 py-3 text-right">
              <button type="button" onclick="crawlSingleDirect('${item.slug}')" class="text-primary hover:underline font-bold text-xs cursor-pointer">
                ${actionBtnText}
              </button>
            </td>
          </tr>
        `;
      }).join('');

      if (selectAllSearch) selectAllSearch.checked = false;
    }

    // Re-render search results when overwrite checkbox toggles
    document.getElementById('overwrite')?.addEventListener('change', () => {
      if (currentSearchItems && currentSearchItems.length > 0) {
        renderSearchResultsTable(currentSearchItems);
      }
    });

    // Select all checkboxes search results
    selectAllSearch.addEventListener('change', (e) => {
      const checked = e.target.checked;
      const isOverwrite = document.getElementById('overwrite')?.checked ?? true;
      const checkboxes = document.querySelectorAll('.item-checkbox');
      checkboxes.forEach(cb => {
        if (checked) {
          if (!isOverwrite && cb.getAttribute('data-crawled') === 'true') {
            cb.checked = false;
            return;
          }
          cb.checked = true;
        } else {
          cb.checked = false;
        }
        cb.dispatchEvent(new Event('change'));
      });
    });

    // Cart management
    window.toggleCartItem = function(checkbox, slug, name, type = 'single', episodeCurrent = '', tmdbId = '', tmdbType = '') {
      if (checkbox.checked) {
        cartSlugs.set(slug, { name, type, episodeCurrent, tmdbId, tmdbType });
      } else {
        cartSlugs.delete(slug);
      }
      updateCartUI();
    };

    function updateCartUI() {
      cartCount.textContent = `${cartSlugs.size} phim`;
    }

    document.getElementById('clearCartBtn').addEventListener('click', () => {
      cartSlugs.clear();
      updateCartUI();
      const checkboxes = document.querySelectorAll('.item-checkbox');
      checkboxes.forEach(cb => cb.checked = false);
      selectAllSearch.checked = false;
      if (window.showGlobalToast) window.showGlobalToast('Đã dọn dẹp giỏ hàng!', 'info');
    });

    // Detailed Cart Modal and operations
    const viewCartBtn = document.getElementById('viewCartBtn');
    if (viewCartBtn) {
      viewCartBtn.addEventListener('click', () => {
        renderCartModal();
      });
    }

    function renderCartModal() {
      if (cartSlugs.size === 0) {
        if (window.txamodal) {
          window.txamodal.show({
            title: 'Chi tiết giỏ hàng cào phim',
            message: '<div class="text-center py-8 text-zinc-500 text-xs font-bold uppercase tracking-wider">Giỏ hàng của bạn đang trống.</div>',
            cancelText: 'Đóng'
          });
        } else {
          alert('Giỏ hàng đang trống!');
        }
        return;
      }

      const items = Array.from(cartSlugs.entries()).map(([slug, val]) => ({
        slug,
        name: val.name,
        type: val.type,
        episodeCurrent: val.episodeCurrent,
        tmdbId: val.tmdbId,
        tmdbType: val.tmdbType
      }));

      const totalPages = Math.ceil(items.length / cartPageSize);
      cartPage = Math.min(cartPage, totalPages);
      if (cartPage < 1) cartPage = 1;
      const startIdx = (cartPage - 1) * cartPageSize;
      const paginatedItems = items.slice(startIdx, startIdx + cartPageSize);

      const tableRows = paginatedItems.map((item, idx) => {
        const globalIdx = startIdx + idx + 1;
        const typeLabel = item.type === 'single' ? 'Phim Lẻ' : item.type === 'hoathinh' ? 'Hoạt Hình' : item.type === 'tvshows' ? 'TV Show' : 'Phim Bộ';
        const crawlType = item.type === 'single' ? 'Cào phim full' : `Cào phim bộ (${item.episodeCurrent || 'Đang cập nhật'})`;

        return `
          <tr class="border-b border-glass-stroke/30 text-xs">
            <td class="px-4 py-2.5 font-mono text-[10px] text-zinc-500">${globalIdx}</td>
            <td class="px-4 py-2.5 font-bold text-white">
              <div>${item.name}</div>
              <div class="text-[9px] text-zinc-500 font-mono">${item.slug}</div>
            </td>
            <td class="px-4 py-2.5 text-zinc-400 font-sans">${typeLabel}</td>
            <td class="px-4 py-2.5 text-zinc-400 font-sans">${crawlType}</td>
            <td class="px-4 py-2.5 text-right">
              <button onclick="removeCartItemAndRefresh('${item.slug}')" class="text-rose-400 hover:text-rose-300 font-bold p-1 bg-transparent border-none cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">delete</span>
              </button>
            </td>
          </tr>
        `;
      }).join('');

      const html = `
        <div class="space-y-4 min-w-[500px]" style="font-family: system-ui, -apple-system, sans-serif;">
          <div class="max-h-[300px] overflow-y-auto border border-glass-stroke rounded-xl bg-black/40 custom-scrollbar">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-zinc-950/80 border-b border-glass-stroke text-[10px] font-bold text-zinc-500 uppercase tracking-wider">
                  <th class="px-4 py-2.5 w-8">#</th>
                  <th class="px-4 py-2.5">Phim</th>
                  <th class="px-4 py-2.5">Loại</th>
                  <th class="px-4 py-2.5">Phân loại cào</th>
                  <th class="px-4 py-2.5 text-right w-12">Hành động</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-glass-stroke/20">
                ${tableRows}
              </tbody>
            </table>
          </div>

          <!-- Pagination Controls -->
          <div class="flex items-center justify-between gap-4 text-xs pt-2">
            <div class="flex items-center gap-2">
              <span class="text-zinc-500 font-bold">Hiển thị:</span>
              <select id="cartPageSizeSelect" onchange="changeCartPageSize(this.value)" class="bg-zinc-900 border border-zinc-800 rounded-lg px-2 py-1 text-white font-bold cursor-pointer focus:outline-none">
                <option value="5" ${cartPageSize === 5 ? 'selected' : ''}>5 phim</option>
                <option value="10" ${cartPageSize === 10 ? 'selected' : ''}>10 phim</option>
                <option value="20" ${cartPageSize === 20 ? 'selected' : ''}>20 phim</option>
                <option value="50" ${cartPageSize === 50 ? 'selected' : ''}>50 phim</option>
              </select>
            </div>
            
            <div class="flex items-center gap-3">
              <button onclick="changeCartPage(-1)" ${cartPage === 1 ? 'disabled class="opacity-30 cursor-not-allowed px-3 py-1 bg-white/5 border border-white/10 text-white rounded-lg font-bold"' : 'class="cursor-pointer px-3 py-1 bg-white/5 border border-white/10 hover:border-primary/50 text-white rounded-lg font-bold"'}>
                Trước
              </button>
              <span class="text-zinc-400 font-mono">Trang ${cartPage} / ${totalPages}</span>
              <button onclick="changeCartPage(1)" ${cartPage === totalPages ? 'disabled class="opacity-30 cursor-not-allowed px-3 py-1 bg-white/5 border border-white/10 text-white rounded-lg font-bold"' : 'class="cursor-pointer px-3 py-1 bg-white/5 border border-white/10 hover:border-primary/50 text-white rounded-lg font-bold"'}>
                Sau
              </button>
            </div>
          </div>
        </div>
      `;

      if (window.txamodal) {
        window.txamodal.show({
          title: `Chi tiết Giỏ hàng (${items.length} phim)`,
          message: html,
          cancelText: 'Đóng'
        });
      }
    }

    window.removeCartItemAndRefresh = function(slug) {
      cartSlugs.delete(slug);
      updateCartUI();
      
      // Uncheck corresponding checkbox in search table if visible
      const checkboxes = document.querySelectorAll('.item-checkbox');
      checkboxes.forEach(cb => {
        const onchangeAttr = cb.getAttribute('onchange') || '';
        if (onchangeAttr.includes(`'${slug}'`) || onchangeAttr.includes(`"${slug}"`)) {
          cb.checked = false;
        }
      });
      
      renderCartModal();
    };

    window.changeCartPage = function(dir) {
      cartPage += dir;
      renderCartModal();
    };

    window.changeCartPageSize = function(size) {
      cartPageSize = parseInt(size) || 10;
      cartPage = 1;
      renderCartModal();
    };

    // MAP KKPHIM DATA HELPER
    function mapKKPhimToMovieDetail(data) {
      const m = data.movie;
      const cdnDomain = "https://phimimg.com";
      
      let posterUrl = m.poster_url || '';
      if (posterUrl && !posterUrl.startsWith('http')) {
        posterUrl = `${cdnDomain}/${posterUrl.replace(/^\//, '')}`;
      }
      let bannerUrl = m.thumb_url || m.poster_url || '';
      if (bannerUrl && !bannerUrl.startsWith('http')) {
        bannerUrl = `${cdnDomain}/${bannerUrl.replace(/^\//, '')}`;
      }

      const genres = Array.isArray(m.category) ? m.category.map(c => c.name) : [];
      
      let category = "Khác";
      if (Array.isArray(m.category) && m.category.length > 0) {
        category = m.category[0].name;
      }

      let country = "Khác";
      if (Array.isArray(m.country) && m.country.length > 0) {
        country = m.country[0].name;
      }

      let type = 'series';
      if (m.type === 'single') {
        type = 'movie';
      } else if (m.type === 'hoathinh') {
        type = 'hoathinh';
      } else if (m.type === 'tvshows') {
        type = 'tvshows';
      }

      const episodes = Array.isArray(data.episodes) ? data.episodes.map(server => {
        return {
          serverName: server.server_name || "Server VIP",
          serverData: Array.isArray(server.server_data) ? server.server_data.map(ep => {
            let epName = ep.name || '';
            if (epName.trim().match(/^\d+$/)) {
              epName = `Tập ${epName.padStart(2, '0')}`;
            }
            return {
              name: epName,
              slug: ep.slug || `tap-${ep.name}`,
              filename: ep.filename || `${m.name} - Tap ${ep.name}`,
              linkEmbed: ep.link_embed || '',
              linkM3u8: ep.link_m3u8 || '',
              subtitles: ep.subtitles || ep.subtitles_data || [],
              timeIntroStart: ep.timeIntroStart || ep.time_intro_start || 0,
              timeIntroEnd: ep.timeIntroEnd || ep.time_intro_end || 0,
              timeOutroStart: ep.timeOutroStart || ep.time_outro_start || 0,
              timeOutroEnd: ep.timeOutroEnd || ep.time_outro_end || 0
            };
          }) : []
        };
      }) : [];

      return {
        id: m._id || m.id || `kk-${m.slug}`,
        title: m.name,
        originalTitle: m.origin_name,
        slug: m.slug,
        description: m.content ? m.content.replace(/<[^>]*>/g, '') : '',
        posterUrl: posterUrl,
        bannerUrl: bannerUrl,
        releaseYear: parseInt(m.year) || 2025,
        durationMinutes: m.time || (type === 'movie' ? '120 phút' : '45 phút/tập'),
        type: type,
        status: m.status === 'completed' ? 'completed' : 'ongoing',
        episodeCurrent: m.episode_current || (type === 'movie' ? 'Full' : '1'),
        episodeTotal: m.episode_total || '1',
        quality: m.quality || 'FHD',
        lang: m.lang || 'Vietsub',
        imdbScore: 8.0,
        category: category,
        country: country,
        ageRating: type === 'movie' ? 'T16' : 'T13',
        genres: genres,
        seasons: type === 'movie' ? 'Bản Điện Ảnh' : 'Phần 1',
        actors: Array.isArray(m.actor) ? m.actor.filter(Boolean) : [],
        directors: Array.isArray(m.director) ? m.director.filter(Boolean) : [],
        trailerUrl: m.trailer_url || '',
        episodes: episodes
      };
    }

    function saveCrawlSession(slugsList, currentIndex, success, skipped, failed) {
      const session = {
        slugsList,
        currentIndex,
        success,
        skipped,
        failed,
        overwrite: document.getElementById('overwrite')?.checked ?? true,
        logsHTML: document.getElementById('logTerminalBody')?.innerHTML || '',
        activeTab,
        standardSubTab,
        timestamp: Date.now()
      };
      localStorage.setItem('webfilm_crawl_session', JSON.stringify(session));
    }

    function clearCrawlSession() {
      localStorage.removeItem('webfilm_crawl_session');
    }

    function startCountdownTimer() {
      if (countdownTimerId) clearInterval(countdownTimerId);
      countdownTimerId = setInterval(() => {
        if (remainingTimeSeconds > 0) {
          remainingTimeSeconds = Math.max(0, remainingTimeSeconds - 1);
          const progressTimeEstimate = document.getElementById('progressTimeEstimate');
          if (progressTimeEstimate && isRunning && !isPaused) {
            progressTimeEstimate.textContent = `Thời gian còn lại: ~${remainingTimeSeconds} giây`;
          }
        }
      }, 1000);
    }

    function stopCountdownTimer() {
      if (countdownTimerId) {
        clearInterval(countdownTimerId);
        countdownTimerId = null;
      }
    }

    function restoreSession(session) {
      // Restore settings
      const overwriteEl = document.getElementById('overwrite');
      if (overwriteEl) overwriteEl.checked = session.overwrite;

      // Restore logs
      const logBody = document.getElementById('logTerminalBody');
      if (logBody) {
        logBody.innerHTML = session.logsHTML;
        logBody.scrollTop = logBody.scrollHeight;
      }

      // Switch Tab
      if (session.activeTab === 'advanced') {
        tabAdvancedBtn.click();
      } else {
        tabStandardBtn.click();
        if (session.standardSubTab === 'batch') {
          subTabBatchBtn.click();
        } else if (session.standardSubTab === 'filter') {
          subTabFilterBtn.click();
        } else {
          subTabUrlBtn.click();
        }
      }

      // Hide search container during crawl if on advanced tab
      if (activeTab === 'advanced') {
        containerSearchTab.classList.add('hidden');
      }

      // Trigger crawl resume
      runCrawlProcess(session.slugsList, session.currentIndex, session.success, session.skipped, session.failed);
    }

    function checkAndRestoreCrawlSession() {
      const saved = localStorage.getItem('webfilm_crawl_session');
      if (saved) {
        try {
          const session = JSON.parse(saved);
          const age = Date.now() - session.timestamp;
          // Valid within 24 hours and not yet finished
          if (age < 24 * 60 * 60 * 1000 && session.slugsList && session.slugsList.length > 0 && session.currentIndex < session.slugsList.length) {
            setTimeout(() => {
              if (window.txamodal) {
                window.txamodal.show({
                  title: 'Khôi phục phiên cào dở dang',
                  message: `Phát hiện phiên cào phim trước đó chưa hoàn thành (${session.currentIndex}/${session.slugsList.length} phim). Bạn có muốn tiếp tục cào tiếp từ phim thứ ${session.currentIndex + 1} không?`,
                  confirmText: 'Khôi phục và Cào tiếp',
                  cancelText: 'Hủy bỏ / Bắt đầu mới',
                  onConfirm: () => {
                    restoreSession(session);
                  },
                  onCancel: () => {
                    clearCrawlSession();
                  }
                });
              }
            }, 1000);
          }
        } catch (e) {
          console.error('Error restoring session:', e);
        }
      }
    }

    document.getElementById('btnPauseCrawl')?.addEventListener('click', () => {
      isPaused = true;
      document.getElementById('btnPauseCrawl')?.classList.add('hidden');
      document.getElementById('btnResumeCrawl')?.classList.remove('hidden');
      addLog(`⏸️ Đã tạm dừng tiến trình cào phim.`, 'warning');
    });

    document.getElementById('btnResumeCrawl')?.addEventListener('click', () => {
      isPaused = false;
      document.getElementById('btnPauseCrawl')?.classList.remove('hidden');
      document.getElementById('btnResumeCrawl')?.classList.add('hidden');
      addLog(`▶️ Tiếp tục tiến trình cào phim...`, 'system');
    });

    document.getElementById('btnCancelCrawl')?.addEventListener('click', () => {
      shouldStop = true;
      isPaused = false;
      isRunning = false;
      document.getElementById('btnPauseCrawl')?.classList.add('hidden');
      document.getElementById('btnResumeCrawl')?.classList.add('hidden');
      document.getElementById('btnCancelCrawl')?.classList.add('hidden');
      clearCrawlSession();
    });

    // CORE SEQUENTIAL CRAWLER PROCESS
    async function runCrawlProcess(slugsList, startIndex = 0, initialSuccess = 0, initialSkipped = 0, initialFailed = 0) {
      if (isRunning) return;
      isRunning = true;
      shouldStop = false;
      isPaused = false;

      // Update control buttons state
      document.getElementById('btnPauseCrawl')?.classList.remove('hidden');
      document.getElementById('btnResumeCrawl')?.classList.add('hidden');
      document.getElementById('btnCancelCrawl')?.classList.remove('hidden');

      // Hide search container during crawl if on advanced tab
      if (activeTab === 'advanced') {
        containerSearchTab.classList.add('hidden');
      }

      // Reset statistics or load initial state if resuming
      let success = initialSuccess;
      let skipped = initialSkipped;
      let failed = initialFailed;
      
      const overwrite = document.getElementById('overwrite').checked;
      
      document.getElementById('statSuccess').textContent = success;
      document.getElementById('statSkipped').textContent = skipped;
      document.getElementById('statFailed').textContent = failed;

      const progressSection = document.getElementById('progressSection');
      const currentMovieName = document.getElementById('currentMovieName');
      const moviesCountProgress = document.getElementById('moviesCountProgress');
      const progressPercent = document.getElementById('progressPercent');
      const mainProgressBar = document.getElementById('mainProgressBar');
      const progressTimeEstimate = document.getElementById('progressTimeEstimate');
      const startStandardBtn = document.getElementById('startStandardBtn');
      const stopStandardBtn = document.getElementById('stopStandardBtn');

      progressSection.classList.remove('hidden');
      statusIndicator.className = 'w-2.5 h-2.5 rounded-full bg-primary animate-pulse';
      startStandardBtn.classList.add('pointer-events-none', 'opacity-40');
      stopStandardBtn.classList.remove('hidden');

      if (startIndex === 0) {
        addLog(`🚀 Khởi động tiến trình cào ${slugsList.length} phim trong hàng đợi...`, 'system');
      } else {
        addLog(`🔄 Khôi phục tiến trình cào, tiếp tục từ phim ${startIndex + 1}/${slugsList.length}...`, 'system');
      }

      // Set initial countdown time estimate and start active countdown
      remainingTimeSeconds = Math.ceil((slugsList.length - startIndex) * 1.2);
      startCountdownTimer();

      for (let i = startIndex; i < slugsList.length; i++) {
        if (shouldStop) {
          addLog(`⚠️ Đã dừng tiến trình thu thập phim do Admin dừng!`, 'warning');
          break;
        }

        while (isPaused) {
          if (shouldStop) break;
          // Save session state to localStorage while paused
          saveCrawlSession(slugsList, i, success, skipped, failed);
          await new Promise(r => setTimeout(r, 500));
        }

        if (shouldStop) {
          addLog(`⚠️ Đã dừng tiến trình thu thập phim do Admin dừng!`, 'warning');
          break;
        }

        // Save session state at start of each item
        saveCrawlSession(slugsList, i, success, skipped, failed);

        const slug = slugsList[i];
        currentMovieName.textContent = `[${i+1}/${slugsList.length}] Đang xử lý: ${slug}`;
        moviesCountProgress.textContent = `Tiến trình: ${i+1}/${slugsList.length} phim`;
        
        const pct = Math.round(((i + 1) / slugsList.length) * 100);
        progressPercent.textContent = `${pct}%`;
        mainProgressBar.style.width = `${pct}%`;

        // Check if exists in database
        const dup = existingMoviesMap[slug] !== undefined;
        let currentEpisodeCount = existingMoviesMap[slug] || 0;
        let apiEpisodeCount = 0;

        if (dup && !overwrite) {
          skipped++;
          document.getElementById('statSkipped').textContent = skipped;
          addLog(`→ Bỏ qua (đã cào & không ghi đè): ${slug}`, 'warning');
          continue;
        }

        addLog(`⏳ Đang cào dữ liệu chi tiết cho slug: ${slug}...`);
        
        try {
          const crawlSource = document.getElementById('crawlSource')?.value || 'kkphim';
          let movieDetailObj;
          
          if (crawlSource === 'tmdb') {
            // Crawl from TMDB API
            // For TMDB, slug format is: title-year, we need to extract tmdb_id from cart or search
            // Check if this slug has TMDB info in cart
            const cartItem = cartSlugs.get(slug);
            if (cartItem && cartItem.tmdbId) {
              const tmdbDetailUrl = `/api/admin/tmdb-detail?tmdb_id=${cartItem.tmdbId}&tmdb_type=${cartItem.tmdbType || 'movie'}`;
              const tmdbRes = await fetch(tmdbDetailUrl);
              if (!tmdbRes.ok) throw new Error(`HTTP ${tmdbRes.status}`);
              
              const tmdbData = await tmdbRes.json();
              if (tmdbData.status !== 'success' || !tmdbData.data) {
                throw new Error('TMDB API trả về dữ liệu không hợp lệ');
              }
              
              movieDetailObj = tmdbData.data;
              movieDetailObj.updatedAt = new Date().toISOString();
              movieDetailObj.source = 'tmdb';
              
              // Note: TMDB doesn't provide streaming links, so episodes will be empty
              // User will need to manually add episodes or use another source
              addLog(`⚠️ TMDB chỉ cung cấp thông tin phim, không có link streaming. Bạn cần thêm tập thủ công sau khi cào.`, 'warning');
            } else {
              throw new Error('Không tìm thấy thông tin TMDB cho phim này. Vui lòng tìm kiếm lại từ TMDB.');
            }
          } else {
            // Crawl from KKPhim API
            const detailRes = await fetch(`https://phimapi.com/phim/${slug}`);
            if (!detailRes.ok) throw new Error(`HTTP ${detailRes.status}`);
            
            let detailData;
            const detailText = await detailRes.text();
            try {
              detailData = JSON.parse(detailText);
            } catch (jsonErr) {
              if (detailText.trim().startsWith('<')) {
                const matchTitle = detailText.match(/<title>([^<]*)<\/title>/i);
                const htmlTitle = matchTitle ? matchTitle[1].trim() : '';
                if (htmlTitle.includes('Cloudflare') || htmlTitle.includes('Ray ID') || htmlTitle.includes('502') || htmlTitle.includes('503') || htmlTitle.includes('504')) {
                  throw new Error(`Lỗi Cloudflare/Mạng từ API Phim: ${htmlTitle || 'Gateway Error'}`);
                }
                throw new Error(`API Phim trả về trang HTML thay vì JSON: ${htmlTitle || 'Lỗi hệ thống'}`);
              }
              throw new Error(`Không thể phân giải JSON từ API Phim: ${jsonErr.message}`);
            }

            if (detailData && detailData.movie && Array.isArray(detailData.episodes)) {
              // Compare episodes count to see if update exists
              apiEpisodeCount = Math.max(...(detailData.episodes || []).map((server) => (server.server_data || server.serverData || []).length), 0);

              if (!overwrite && currentEpisodeCount > 0 && apiEpisodeCount <= currentEpisodeCount) {
                skipped++;
                document.getElementById('statSkipped').textContent = skipped;
                addLog(`→ Bỏ qua vì đã đầy đủ tập phim (${currentEpisodeCount}/${apiEpisodeCount} tập): "${detailData.movie.name}"`, 'warning');
                continue;
              }

              movieDetailObj = mapKKPhimToMovieDetail(detailData);
              movieDetailObj.updatedAt = new Date().toISOString();
              movieDetailObj.source = 'kkphim';
            
              // Fetch TMDB images and override if available
              if (detailData.movie.tmdb && detailData.movie.tmdb.id) {
                const tmdbId = detailData.movie.tmdb.id;
                const tmdbType = detailData.movie.tmdb.type === 'tv' ? 'tv' : 'movie';
                try {
                  const tmdbRes = await fetch(`/api/tmdb-proxy?path=/3/${tmdbType}/${tmdbId}&language=vi-VN`);
                  if (tmdbRes.ok) {
                    const tmdbData = await tmdbRes.json();
                    if (tmdbData.poster_path) {
                      movieDetailObj.posterUrl = `https://image.tmdb.org/t/p/original${tmdbData.poster_path}`;
                    }
                    if (tmdbData.backdrop_path) {
                      movieDetailObj.bannerUrl = `https://image.tmdb.org/t/p/original${tmdbData.backdrop_path}`;
                    }
                    if (tmdbData.vote_average) {
                      movieDetailObj.tmdbScore = tmdbData.vote_average;
                    }

                    // If it's a TV Show, fetch season details to get episode thumbnail stills
                    if (tmdbType === 'tv') {
                      let seasonNumber = 1;
                      if (detailData.movie.tmdb.season !== undefined) {
                        seasonNumber = parseInt(detailData.movie.tmdb.season) || 1;
                      } else {
                        const seasonsName = movieDetailObj.seasons || '';
                        const matchSeason = seasonsName.match(/\d+/);
                        if (matchSeason) {
                          seasonNumber = parseInt(matchSeason[0]) || 1;
                        }
                      }

                      try {
                        let seasonRes = await fetch(`/api/tmdb-proxy?path=/3/tv/${tmdbId}/season/${seasonNumber}&language=vi-VN`);
                        if (!seasonRes.ok && seasonNumber !== 1) {
                          addLog(`⚠️ Không thể lấy thông tin Season ${seasonNumber} từ TMDB. Thử lại với Season 1...`, 'warning');
                          seasonNumber = 1;
                          seasonRes = await fetch(`/api/tmdb-proxy?path=/3/tv/${tmdbId}/season/1&language=vi-VN`);
                        }
                        
                        if (seasonRes.ok) {
                          const seasonData = await seasonRes.json();
                          if (seasonData && Array.isArray(seasonData.episodes)) {
                            const tmdbEps = seasonData.episodes;
                            if (Array.isArray(movieDetailObj.episodes)) {
                              movieDetailObj.episodes.forEach(server => {
                                const srvData = server.serverData || server.server_data || [];
                                if (Array.isArray(srvData)) {
                                  srvData.forEach((ep, epIdx) => {
                                    const tmdbEp = tmdbEps[epIdx];
                                    if (tmdbEp && tmdbEp.still_path) {
                                      ep.thumbUrl = `https://image.tmdb.org/t/p/original${tmdbEp.still_path}`;
                                    } else {
                                      ep.thumbUrl = movieDetailObj.bannerUrl || movieDetailObj.posterUrl || '';
                                    }
                                  });
                                }
                              });
                              addLog(`✓ Đã cập nhật ảnh thumbnail riêng biệt từ TMDB cho ${seasonData.episodes.length} tập phim.`, 'success');
                            }
                          }
                        }
                      } catch (errSeason) {
                        addLog(`⚠️ Không thể lấy ảnh tập phim từ TMDB Season ${seasonNumber}: ${errSeason.message}. Dùng ảnh banner làm mặc định.`, 'warning');
                        fallbackEpisodeThumbs(movieDetailObj);
                      }
                    } else {
                      // For single movies, use the movie's main banner/poster as the episode's thumbnail
                      fallbackEpisodeThumbs(movieDetailObj);
                    }

                    function fallbackEpisodeThumbs(movieObj) {
                      if (Array.isArray(movieObj.episodes)) {
                        movieObj.episodes.forEach(server => {
                          const srvData = server.serverData || server.server_data || [];
                          if (Array.isArray(srvData)) {
                            srvData.forEach(ep => {
                              ep.thumbUrl = movieObj.bannerUrl || movieObj.posterUrl || '';
                            });
                          }
                        });
                      }
                    }
                  }
                } catch (e) {
                  addLog(`⚠️ Không thể lấy thông tin TMDB: ${e.message}`, 'warning');
                }
              }
            } else {
              throw new Error('Payload API bị lỗi hoặc trống');
            }
          }

          // Save to database Supabase via API (common for both sources)
          if (movieDetailObj) {
            const saveRes = await fetch('/api/admin/movie-action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'save',
                slug: slug,
                movieData: movieDetailObj,
                isStatic: false
              })
            });
            if (!saveRes.ok) {
              let errMsg = 'Lỗi khi lưu phim vào database';
              try {
                const saveText = await saveRes.text();
                if (saveText.trim().startsWith('<')) {
                  const matchTitle = saveText.match(/<title>([^<]*)<\/title>/i);
                  errMsg = matchTitle ? `Lỗi hệ thống lưu DB (HTML): ${matchTitle[1].trim()}` : 'Lỗi hệ thống lưu DB (trả về trang HTML)';
                } else {
                  const errData = JSON.parse(saveText);
                  errMsg = errData.message || errMsg;
                }
              } catch (jsonErr) {}
              throw new Error(errMsg);
            }

            success++;
            document.getElementById('statSuccess').textContent = success;
            
            // Format log message depending on source and whether movie is new or updated
            const crawlSource = document.getElementById('crawlSource')?.value || 'kkphim';
            if (crawlSource === 'tmdb') {
              const episodeText = movieDetailObj.type === 'movie' ? 'Hoàn Tất (Full)' : movieDetailObj.episodeCurrent;
              addLog(`✓ Cào thành công từ TMDB & đã lưu vào DB: "${movieDetailObj.title}" (${episodeText})`, 'success');
            } else {
              if (currentEpisodeCount > 0) {
                const addedCount = apiEpisodeCount - currentEpisodeCount;
                addLog(`✓ Cào thành công & đã lưu vào DB: "${movieDetailObj.title}" (Cập nhật +${addedCount} tập)`, 'success');
              } else {
                const episodeText = movieDetailObj.type === 'movie' ? 'Hoàn Tất (Full)' : movieDetailObj.episodeCurrent;
                addLog(`✓ Cào thành công & đã lưu vào DB: "${movieDetailObj.title}" (${episodeText})`, 'success');
              }
            }
            
            // Live update inventory list
            await loadExistingMoviesDict();
            renderCrawledList();
          } else {
            throw new Error('Payload API bị lỗi hoặc trống');
          }
        } catch (e) {
          failed++;
          document.getElementById('statFailed').textContent = failed;
          addLog(`✗ Lỗi khi cào slug "${slug}": ${e.message}`, 'error');
        }

        // Update countdown time estimate for subsequent items
        remainingTimeSeconds = Math.ceil((slugsList.length - i - 1) * 1.2);

        // Sequential delay (fast 150ms)
        await new Promise(r => setTimeout(r, 150));
      }

      // Finish crawl task
      isRunning = false;
      isPaused = false;
      stopCountdownTimer();
      clearCrawlSession();

      document.getElementById('btnPauseCrawl')?.classList.add('hidden');
      document.getElementById('btnResumeCrawl')?.classList.add('hidden');
      document.getElementById('btnCancelCrawl')?.classList.add('hidden');

      startStandardBtn.classList.remove('pointer-events-none', 'opacity-40');
      stopStandardBtn.classList.add('hidden');
      statusIndicator.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500';
      progressTimeEstimate.textContent = 'Hoàn tất!';
      addLog(`🎉 TIẾN TRÌNH CÀO PHIM KẾT THÚC! Thành công: ${success}, Bỏ qua: ${skipped}, Lỗi: ${failed}`, 'success');
      if (window.showGlobalToast) window.showGlobalToast(`Cào hoàn tất! Thành công: ${success} phim.`, 'success');

      // Restore search container if on advanced tab
      if (activeTab === 'advanced') {
        containerSearchTab.classList.remove('hidden');
      }
    }

    // Trigger crawl standard
    const startStandardBtn = document.getElementById('startStandardBtn');
    const stopStandardBtn = document.getElementById('stopStandardBtn');

    startStandardBtn.addEventListener('click', async () => {
      if (isRunning) return;

      if (standardSubTab === 'url') {
        const lines = crawlUrlsInput.value.split('\n').map(l => l.trim()).filter(Boolean);
        const slugs = [];
        lines.forEach(line => {
          const slug = extractSlug(line);
          if (slug) slugs.push(slug);
        });

        if (slugs.length === 0) {
          if (window.showGlobalToast) window.showGlobalToast('Không tìm thấy đường dẫn hoặc slug phim nào hợp lệ!', 'error');
          return;
        }

        runCrawlProcess(slugs);
      }
      
      else if (standardSubTab === 'batch') {
        const startPage = parseInt(document.getElementById('pageStart').value) || 1;
        const endPage = parseInt(document.getElementById('pageEnd').value) || 1;

        if (startPage < 1 || endPage < startPage) {
          if (window.showGlobalToast) window.showGlobalToast('Phạm vi số trang không hợp lệ!', 'error');
          return;
        }

        addLog(`⏳ Đang tải danh sách phim từ trang ${startPage} đến ${endPage}...`);
        const slugs = [];
        
        for (let p = startPage; p <= endPage; p++) {
          try {
            const res = await fetch(`https://phimapi.com/danh-sach/phim-moi-cap-nhat?page=${p}`);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            
            if (data && Array.isArray(data.items)) {
              data.items.forEach(item => {
                if (item.slug) slugs.push(item.slug);
              });
              addLog(`✓ Quét xong trang danh sách ${p}: Thêm ${data.items.length} phim.`);
            }
          } catch (e) {
            addLog(`✗ Lỗi tải trang danh sách ${p}: ${e.message}`, 'error');
          }
          await new Promise(r => setTimeout(r, 200));
        }

        if (slugs.length === 0) {
          if (window.showGlobalToast) window.showGlobalToast('Không quét được phim nào từ các trang danh sách!', 'error');
          return;
        }
        
        runCrawlProcess(slugs);
      }
      
      else if (standardSubTab === 'filter') {
        const startPage = parseInt(document.getElementById('filterPageStart').value) || 1;
        const endPage = parseInt(document.getElementById('filterPageEnd').value) || 1;

        if (startPage < 1 || endPage < startPage) {
          if (window.showGlobalToast) window.showGlobalToast('Phạm vi số trang lọc không hợp lệ!', 'error');
          return;
        }

        const slugs = [];
        const country = document.getElementById('selectedCountry').value;
        const genre = document.getElementById('selectedGenre').value;
        const crawlSource = document.getElementById('crawlSource')?.value || 'kkphim';

        // Check if using TMDB format (numeric genre or 2-letter country code)
        const isTMDBGenre = /^\d+$/.test(genre);
        const isTMDBCountry = /^[A-Z]{2}$/.test(country);

        if (crawlSource === 'tmdb' || isTMDBGenre || isTMDBCountry) {
          // Use TMDB discover API
          addLog(`⏳ Đang tải phim từ TMDB: ${filterType === 'country' ? 'Quốc gia ' + country : 'Thể loại ' + genre} (Trang ${startPage}-${endPage})...`);
          
          for (let p = startPage; p <= endPage; p++) {
            try {
              let discoverUrl = `/api/admin/tmdb-discover?page=${p}`;
              if (filterType === 'country' && isTMDBCountry) {
                discoverUrl += `&country=${country}`;
              } else if (filterType === 'genre' && isTMDBGenre) {
                discoverUrl += `&genre=${genre}`;
              } else if (filterType === 'country' && !isTMDBCountry) {
                // Try to map country name to code
                const countryMap = {
                  'trung-quoc': 'CN',
                  'han-quoc': 'KR',
                  'nhat-ban': 'JP',
                  'au-my': 'US',
                  'thai-lan': 'TH',
                  'viet-nam': 'VN'
                };
                const countryCode = countryMap[country] || country.toUpperCase();
                discoverUrl += `&country=${countryCode}`;
              } else if (filterType === 'genre' && !isTMDBGenre) {
                // Try to map genre name to ID
                const genreMap = {
                  'hanh-dong': '28',
                  'phieu-luu': '12',
                  'tinh-cam': '18',
                  'hoat-hinh': '16',
                  'khoa-hoc': '878',
                  'kinh-di': '27',
                  'hai-huoc': '35'
                };
                const genreId = genreMap[genre] || genre;
                discoverUrl += `&genre=${genreId}`;
              }

              const res = await fetch(discoverUrl);
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              const data = await res.json();
              if (data.status === 'success' && data.data && Array.isArray(data.data.items)) {
                data.data.items.forEach((item) => {
                  if (item.slug) {
                    slugs.push(item.slug);
                    // Store TMDB info in cart for later crawling
                    if (item.tmdb) {
                      cartSlugs.set(item.slug, {
                        name: item.name,
                        type: item.type,
                        episodeCurrent: item.episode_current,
                        tmdbId: item.tmdb.id,
                        tmdbType: item.tmdb.type
                      });
                    }
                  }
                });
                addLog(`✓ Quét xong TMDB trang ${p}: Thêm ${data.data.items.length} phim.`);
              }
            } catch (e) {
              addLog(`✗ Lỗi tải TMDB trang ${p}: ${e.message}`, 'error');
            }
            await new Promise(r => setTimeout(r, 200));
          }
        } else {
          // Use KKPhim API
          if (filterType === 'country') {
            addLog(`⏳ Đang tải phim Quốc gia "${country}": Từ trang ${startPage} đến ${endPage}...`);
            for (let p = startPage; p <= endPage; p++) {
              try {
                const res = await fetch(`https://phimapi.com/v1/api/quoc-gia/${country}?page=${p}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                if (data && data.data && Array.isArray(data.data.items)) {
                  data.data.items.forEach(item => {
                    if (item.slug) slugs.push(item.slug);
                  });
                  addLog(`✓ Quét xong quốc gia ${country} trang ${p}: Thêm ${data.data.items.length} phim.`);
                }
              } catch (e) {
                addLog(`✗ Lỗi tải trang quốc gia ${country} trang ${p}: ${e.message}`, 'error');
              }
              await new Promise(r => setTimeout(r, 200));
            }
          } else {
            addLog(`⏳ Đang tải phim Thể loại "${genre}": Từ trang ${startPage} đến ${endPage}...`);
            for (let p = startPage; p <= endPage; p++) {
              try {
                const res = await fetch(`https://phimapi.com/v1/api/the-loai/${genre}?page=${p}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                if (data && data.data && Array.isArray(data.data.items)) {
                  data.data.items.forEach(item => {
                    if (item.slug) slugs.push(item.slug);
                  });
                  addLog(`✓ Quét xong thể loại ${genre} trang ${p}: Thêm ${data.data.items.length} phim.`);
                }
              } catch (e) {
                addLog(`✗ Lỗi tải thể loại ${genre} trang ${p}: ${e.message}`, 'error');
              }
              await new Promise(r => setTimeout(r, 200));
            }
          }
        }

        if (slugs.length === 0) {
          if (window.showGlobalToast) window.showGlobalToast('Không lọc được phim nào từ các trang danh sách!', 'error');
          return;
        }

        runCrawlProcess(slugs);
      }
    });

    document.getElementById('crawlAllBtn').addEventListener('click', async () => {
      if (isRunning) return;

      const performCrawlAll = async () => {
        addLog('⏳ Đang lấy dữ liệu trang 1 để ước tính toàn bộ kho phim...');
        try {
          const res = await fetch('https://phimapi.com/danh-sach/phim-moi-cap-nhat?page=1');
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          
          const totalPages = data.pagination?.totalPages || 500;
          addLog(`✓ Tổng số trang phim cần quét: ${totalPages} trang. Bắt đầu thu thập slugs...`, 'system');

          const slugs = [];
          for (let p = 1; p <= totalPages; p++) {
            if (shouldStop) break;
            try {
              const pageRes = await fetch(`https://phimapi.com/danh-sach/phim-moi-cap-nhat?page=${p}`);
              const pageData = await pageRes.json();
              if (pageData && Array.isArray(pageData.items)) {
                pageData.items.forEach(item => {
                  if (item.slug) slugs.push(item.slug);
                });
                addLog(`Quét danh sách trang ${p}/${totalPages}: Thêm ${pageData.items.length} slugs.`);
              }
            } catch (e) {
              addLog(`✗ Lỗi quét trang ${p}: ${e.message}`, 'error');
            }
            await new Promise(r => setTimeout(r, 100));
          }

          if (slugs.length > 0) {
            runCrawlProcess(slugs);
          }
        } catch (e) {
          addLog(`✗ Lỗi ước tính toàn bộ kho phim: ${e.message}`, 'error');
        }
      };

      if (window.txamodal) {
        window.txamodal.show({
          title: 'Bắt đầu cào toàn bộ kho phim',
          message: '<strong class="text-rose-500">CẢNH BÁO:</strong> Cào toàn bộ sẽ tải tất cả các trang phim trên API (20000+ phim). Tiến trình có thể kéo dài rất lâu và tiêu tốn tài nguyên. Bạn chắc chắn muốn chạy?',
          type: 'danger',
          confirmText: 'Chạy cào toàn bộ',
          cancelText: 'Hủy bỏ',
          onConfirm: performCrawlAll
        });
      } else if (confirm('CẢNH BÁO: Cào toàn bộ sẽ tải tất cả các trang phim trên API (20000+ phim). Tiến trình có thể kéo dài rất lâu. Bạn chắc chắn muốn chạy?')) {
        performCrawlAll();
      }
    });

    stopStandardBtn.addEventListener('click', () => {
      shouldStop = true;
      stopStandardBtn.classList.add('opacity-40', 'pointer-events-none');
      addLog('Đang chờ tiến trình dừng lại...', 'warning');
    });

    // Start crawl single direct from search result
    window.crawlSingleDirect = function(slug) {
      if (isRunning) {
        if (window.showGlobalToast) window.showGlobalToast('Đang có tiến trình cào phim đang hoạt động!', 'error');
        return;
      }
      runCrawlProcess([slug]);
    };

    // Start cart crawl
    document.getElementById('startCartCrawlBtn').addEventListener('click', () => {
      if (isRunning) return;
      if (cartSlugs.size === 0) {
        if (window.showGlobalToast) window.showGlobalToast('Vui lòng chọn ít nhất 1 phim vào giỏ hàng!', 'error');
        return;
      }

      const slugs = Array.from(cartSlugs.keys());
      runCrawlProcess(slugs);
      
      // Reset cart
      cartSlugs.clear();
      updateCartUI();
      const checkboxes = document.querySelectorAll('.item-checkbox');
      checkboxes.forEach(cb => cb.checked = false);
      selectAllSearch.checked = false;
    });

    document.getElementById('crawledPrevBtn').addEventListener('click', () => {
      if (crawledCurrentPage > 1) {
        crawledCurrentPage--;
        renderCrawledList();
      }
    });

    document.getElementById('crawledNextBtn').addEventListener('click', () => {
      const totalPages = Math.ceil(crawledListCache.length / crawledLimit) || 1;
      if (crawledCurrentPage < totalPages) {
        crawledCurrentPage++;
        renderCrawledList();
      }
    });

      document.addEventListener('astro:before-swap', () => {
        stopCountdownTimer();
      }, { once: true });

      // Initial runs
      (async () => {
        await loadExistingMoviesDict();
        renderCrawledList();
        checkAndRestoreCrawlSession();
        await fetchFilterMetadata();
      })();
    })();
  </script>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #37333e; border-radius: 10px; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
  </style>
</AdminLayout>
