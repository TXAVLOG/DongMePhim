---
import AdminLayout from '@layouts/AdminLayout.astro';
import { MovieService } from '@services/MovieService';

const staticMovies = await MovieService.getMovies();
---

<AdminLayout title="Quản lý Phim">
  <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 mt-4 gap-4">
    <div>
      <h2 class="font-headline-lg text-on-surface text-3xl">Quản lý Phim</h2>
      <p class="text-text-dim text-body-main mt-1">Quản lý kho phim của bạn bao gồm phim hệ thống và phim đã thu thập (crawled).</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/phim/danh-muc" class="px-4 py-2.5 glass-panel hover:bg-surface-variant text-on-surface rounded-xl text-xs font-bold transition-all active:scale-95 flex items-center gap-2 cursor-pointer border border-glass-stroke">
        <span class="material-symbols-outlined text-sm">view_carousel</span>
        <span>Danh mục trang chủ</span>
      </a>
      <a href="/admin/phim/crawler" class="px-4 py-2.5 glass-panel hover:bg-surface-variant text-on-surface rounded-xl text-xs font-bold transition-all active:scale-95 flex items-center gap-2 cursor-pointer border border-glass-stroke">
        <span class="material-symbols-outlined text-sm">cloud_download</span>
        <span>Thu thập phim</span>
      </a>
      <a href="/admin/phim/tao-thu-cong" class="px-4 py-2.5 bg-primary hover:brightness-110 text-slate-950 font-bold rounded-xl text-xs transition-all active:scale-95 flex items-center gap-2 cursor-pointer border-none shadow-lg shadow-primary/10">
        <span class="material-symbols-outlined text-sm">add</span>
        <span>Thêm phim thủ công</span>
      </a>
    </div>
  </header>

  <!-- Filter & Search Panel -->
  <section class="glass-panel p-6 rounded-3xl mb-8 flex flex-col gap-4">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="relative group w-full md:w-80">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-text-dim group-focus-within:text-primary transition-colors">search</span>
        <input id="movie-search" class="bg-surface-container border border-glass-stroke rounded-full pl-10 pr-4 py-2.5 text-xs focus:ring-1 focus:ring-primary focus:border-primary w-full transition-all focus:outline-none placeholder:text-zinc-500 text-white" placeholder="Tìm kiếm tên phim, thể loại..." type="text"/>
      </div>
      
      <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <!-- Bulk Action Button -->
        <button id="bulk-delete-btn" class="hidden px-4 py-2.5 bg-rose-600/10 border border-rose-500/20 hover:bg-rose-600/20 text-rose-400 rounded-xl text-xs font-bold transition-all active:scale-95 flex items-center gap-2 cursor-pointer">
          <span class="material-symbols-outlined text-sm">delete_sweep</span>
          <span id="bulk-delete-text">Xóa đã chọn (0)</span>
        </button>

        <button id="bulk-scan-btn" class="hidden px-4 py-2.5 bg-emerald-600/10 border border-emerald-500/20 hover:bg-emerald-600/20 text-emerald-400 rounded-xl text-xs font-bold transition-all active:scale-95 flex items-center gap-2 cursor-pointer" data-txatooltip="Quét tập mới dựa theo nguồn API (phimapi.com)">
          <span class="material-symbols-outlined text-sm">sync</span>
          <span id="bulk-scan-text">Quét tập mới (0)</span>
        </button>

        <select id="filter-type" class="bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-primary text-zinc-300 w-full md:w-auto cursor-pointer">
          <option value="all">Tất cả định dạng</option>
          <option value="movie">Phim Lẻ</option>
          <option value="series">Phim Bộ</option>
        </select>
        
        <select id="filter-source" class="bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-primary text-zinc-300 w-full md:w-auto cursor-pointer">
          <option value="all">Tất cả nguồn</option>
          <option value="static">Hệ thống (Static)</option>
          <option value="crawled">Đã Thu thập (Crawled)</option>
        </select>
      </div>
    </div>
    <!-- Status filter + page size row -->
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-1 bg-surface-container border border-glass-stroke rounded-xl p-1">
        <button id="status-filter-all" onclick="setStatusFilter('all')" class="status-filter-btn active-filter px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">Tất cả</button>
        <button id="status-filter-ongoing" onclick="setStatusFilter('ongoing')" class="status-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">Đang chiếu</button>
        <button id="status-filter-completed" onclick="setStatusFilter('completed')" class="status-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">Hoàn thành</button>
        <button id="status-filter-movie" onclick="setStatusFilter('movie')" class="status-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">Phim lẻ / Full</button>
      </div>
      <div class="flex items-center gap-2 ml-auto">
        <span class="text-xs text-text-dim font-bold whitespace-nowrap">Hiển thị:</span>
        <select id="page-size-select" class="bg-surface-container border border-glass-stroke rounded-xl px-3 py-1.5 text-xs focus:outline-none focus:border-primary text-zinc-300 cursor-pointer">
          <option value="10">10 / trang</option>
          <option value="25">25 / trang</option>
          <option value="50">50 / trang</option>
          <option value="100">100 / trang</option>
        </select>
      </div>
    </div>
  </section>

  <style>
    .status-filter-btn { color: #71717a; }
    .status-filter-btn.active-filter { background: rgba(99,102,241,0.15); color: #818cf8; }
  </style>

  <!-- Movies Table -->
  <section class="glass-panel rounded-3xl overflow-hidden mb-8">
    <div class="px-8 py-6 flex justify-between items-center border-b border-glass-stroke bg-white/[0.01]">
      <h3 class="text-title-md text-on-surface font-bold">Danh sách phim</h3>
      <span id="movies-summary" class="text-xs text-text-dim font-bold font-label-caps">ĐANG TẢI...</span>
    </div>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-surface-container/40">
          <tr>
            <th class="pl-8 pr-4 py-4 w-10">
              <label class="relative flex items-center justify-center shrink-0 cursor-pointer">
                <input type="checkbox" id="select-all-checkbox" class="peer sr-only" />
                <div class="h-4 w-4 rounded border border-white/10 bg-white/5 transition-all peer-checked:bg-primary peer-checked:border-primary"></div>
                <span class="material-symbols-outlined absolute text-[12px] text-zinc-950 font-bold opacity-0 peer-checked:opacity-100 transition-opacity">check</span>
              </label>
            </th>
            <th class="pl-4 pr-8 py-4 text-xs font-label-caps text-text-dim">PHIM</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">ĐỊNH DẠNG</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">CHẤT LƯỢNG</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">NGUỒN</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">TRẠNG THÁI</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim text-right">HÀNH ĐỘNG</th>
          </tr>
        </thead>
        <tbody id="movie-table-tbody" class="divide-y divide-glass-stroke">
          <!-- Populated dynamically via JS client side -->
        </tbody>
      </table>
    </div>
    
    <div class="p-4 bg-surface-container/20 flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-glass-stroke">
      <p id="show-count-text" class="text-xs text-text-dim font-label-caps font-bold">HIỂN THỊ 0 TRÊN TỔNG SỐ 0 PHIM</p>
      <div id="movie-pagination" class="flex items-center gap-4">
        <span id="movie-pagination-info" class="text-xs text-zinc-400 font-bold uppercase">Trang 1 / 1</span>
        <div class="flex gap-2">
          <button id="movie-prev-btn" class="px-3 py-1.5 bg-zinc-950 border border-glass-stroke text-zinc-400 hover:text-white rounded-lg text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Trước</button>
          <button id="movie-next-btn" class="px-3 py-1.5 bg-zinc-950 border border-glass-stroke text-zinc-400 hover:text-white rounded-lg text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Sau</button>
        </div>
      </div>
    </div>
  </section>

  <script id="staticMoviesData" type="application/json" set:html={JSON.stringify(staticMovies).replace(/</g, '\\u003c')}></script>
  <script is:inline>
    // We merge static movies from the server and crawled movies from localStorage client-side
    (function() {
      function initMoviesIndex() {
        let staticMovies = [];
        try {
          staticMovies = JSON.parse(document.getElementById('staticMoviesData').textContent);
        } catch(e) {}
        
        const tbody = document.getElementById('movie-table-tbody');
        if (!tbody) return; // Exit if not on this page

        const searchInput = document.getElementById('movie-search');
        const filterType = document.getElementById('filter-type');
        const filterSource = document.getElementById('filter-source');
        const summaryText = document.getElementById('movies-summary');
        const showCountText = document.getElementById('show-count-text');
        const prevBtn = document.getElementById('movie-prev-btn');
        const nextBtn = document.getElementById('movie-next-btn');
        const paginationInfo = document.getElementById('movie-pagination-info');

        let staticList = staticMovies.map(m => ({ ...m, originalSource: m.source, source: m.isStatic ? 'static' : 'crawled' }));
        let allMovies = [];
        let currentFilteredList = [];
        let currentPage = 1;
        let itemsPerPage = 10;
        let statusFilter = 'all'; // 'all' | 'ongoing' | 'completed' | 'movie'

        // Selection State
        let selectedMovies = [];

        window.toggleSelectMovie = function(slug, isStatic, checked) {
          if (checked) {
            if (!selectedMovies.some(m => m.slug === slug)) {
              selectedMovies.push({ slug: slug, isStatic: isStatic });
            }
          } else {
            selectedMovies = selectedMovies.filter(m => m.slug !== slug);
          }
          updateBulkActionButton();
        };

        function updateBulkActionButton() {
          const bulkBtn = document.getElementById('bulk-delete-btn');
          const bulkText = document.getElementById('bulk-delete-text');
          const scanBtn = document.getElementById('bulk-scan-btn');
          const scanText = document.getElementById('bulk-scan-text');
          const count = selectedMovies.length;
          
          if (bulkBtn && bulkText) {
            if (count > 0) {
              bulkText.textContent = `Xóa đã chọn (${count})`;
              bulkBtn.classList.remove('hidden');
            } else {
              bulkBtn.classList.add('hidden');
            }
          }
          if (scanBtn && scanText) {
            if (count > 0) {
              scanText.textContent = `Quét tập mới (${count})`;
              scanBtn.classList.remove('hidden');
            } else {
              scanBtn.classList.add('hidden');
            }
          }
        }

        function resetSelections() {
          selectedMovies = [];
          const selectAll = document.getElementById('select-all-checkbox');
          if (selectAll) selectAll.checked = false;
          updateBulkActionButton();
        }

        function loadMoviesData() {
          allMovies = staticList.filter(m => m.slug && m.slug !== 'undefined' && m.slug !== 'null');
          
          if (summaryText) {
            const sysCount = allMovies.filter(m => m.source === 'static').length;
            const dbCount = allMovies.filter(m => m.source === 'crawled').length;
            summaryText.textContent = `${sysCount} Hệ thống + ${dbCount} Database`;
          }
        }

        window.deleteMovie = function(movieId, slug, isStatic, btnElement) {
          const performDelete = async () => {
            let oldHtml = '';
            if (btnElement) {
              oldHtml = btnElement.innerHTML;
              btnElement.disabled = true;
              btnElement.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">autorenew</span>';
            }
            try {
              const res = await fetch('/api/admin/movie-action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'delete', slug: slug, isStatic: isStatic })
              });
              const result = await res.json();
              if (res.ok) {
                if (window.showGlobalToast) {
                  window.showGlobalToast('Đã xóa phim thành công!', 'success');
                }
                setTimeout(() => window.location.reload(), 800);
              } else {
                if (window.showGlobalToast) window.showGlobalToast(result.message || 'Lỗi khi xóa phim', 'error');
                if (btnElement) {
                  btnElement.disabled = false;
                  btnElement.innerHTML = oldHtml;
                }
              }
            } catch (e) {
              if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API', 'error');
              if (btnElement) {
                btnElement.disabled = false;
                btnElement.innerHTML = oldHtml;
              }
            }
          };

          if (window.txamodal) {
            window.txamodal.show({
              title: 'Xóa phim khỏi hệ thống',
              message: `Bạn có chắc chắn muốn xóa phim "${slug || movieId}" khỏi hệ thống không?`,
              type: 'danger',
              confirmText: 'Xóa phim',
              cancelText: 'Hủy bỏ',
              onConfirm: performDelete
            });
          } else if (confirm(`Bạn có chắc chắn muốn xóa phim "${slug || movieId}" khỏi hệ thống không?`)) {
            performDelete();
          }
        };

        function displayPage(page) {
          if (!tbody) return;
          resetSelections();

          const totalItems = currentFilteredList.length;
          const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

          if (page > totalPages) page = totalPages;
          if (page < 1) page = 1;
          currentPage = page;

          const startIndex = (currentPage - 1) * itemsPerPage;
          const endIndex = startIndex + itemsPerPage;
          const paginatedList = currentFilteredList.slice(startIndex, endIndex);

          if (paginatedList.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="7" class="px-8 py-12 text-center text-xs text-text-dim italic">
                  Không tìm thấy phim nào khớp với bộ lọc của bạn.
                </td>
              </tr>
            `;
            if (showCountText) showCountText.textContent = 'HIỂN THỊ 0 PHIM';
            if (paginationInfo) paginationInfo.textContent = 'Trang 1 / 1';
            if (prevBtn) prevBtn.disabled = true;
            if (nextBtn) nextBtn.disabled = true;
            return;
          }

          // Apply fade-in animation
          tbody.classList.remove('animate-fade-in');
          void tbody.offsetWidth;
          tbody.classList.add('animate-fade-in');

          tbody.innerHTML = paginatedList.map(m => {
            const genresStr = Array.isArray(m.genres) ? m.genres.join(', ') : (m.genres || 'KỊCH TÍNH');
            const quality = m.quality || 'FHD';
            const lang = m.lang || 'Vietsub';
            const format = m.type === 'movie' ? 'Phim Lẻ' : 'Phim Bộ';
            const formatBg = m.type === 'movie' ? 'bg-blue-500/10 text-blue-400 border-blue-500/20' : 'bg-purple-500/10 text-purple-400 border-purple-500/20';
            
            let sourceText = 'Hệ thống';
            let sourceBg = 'bg-zinc-500/10 text-zinc-400 border-zinc-500/20';
            if (m.source === 'crawled') {
              sourceText = 'Crawled';
              sourceBg = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
            }

            // Formatting status logic
            const format2Digits = (val) => {
              if (val === undefined || val === null || val === '') return '??';
              const clean = String(val).replace(/^[tT]ập\s+/, '').trim();
              if (clean.toLowerCase() === 'full') return 'Full';
              const parsed = parseInt(clean, 10);
              return !isNaN(parsed) && String(parsed) === clean ? (parsed < 10 ? `0${parsed}` : `${parsed}`) : clean;
            };

            let statusText = '';
            let statusBg = 'bg-amber-500';
            if (m.type === 'movie') {
              statusText = 'Film Full';
              statusBg = 'bg-emerald-500';
            } else {
              const xx = format2Digits(m.episodeCurrent);
              const yy = format2Digits(m.episodeTotal);
              
              if (m.status === 'completed' || xx.toLowerCase() === 'full' || xx.toLowerCase() === 'hoàn tất' || yy.toLowerCase() === 'full') {
                statusText = 'Hoàn tất';
                statusBg = 'bg-emerald-500';
              } else if (xx.includes('/') || xx.toLowerCase().includes('full')) {
                statusText = xx.startsWith('Tập') || xx.startsWith('tập') ? xx : `Tập ${xx}`;
              } else {
                statusText = `Tập ${xx}/${yy}`;
                if (xx.toLowerCase() === yy.toLowerCase() && yy !== '??') {
                  statusText = 'Hoàn tất';
                  statusBg = 'bg-emerald-500';
                }
              }
            }

            const isStatic = m.source === 'static';

            return `
              <tr class="hover:bg-white/5 transition-colors group">
                <td class="pl-8 pr-4 py-4 w-10">
                  <label class="relative flex items-center justify-center shrink-0 cursor-pointer">
                    <input type="checkbox" class="movie-select-checkbox peer sr-only" data-slug="${m.slug}" data-is-static="${isStatic}" onclick="window.toggleSelectMovie('${m.slug}', ${isStatic}, this.checked)" />
                    <div class="h-4 w-4 rounded border border-white/10 bg-white/5 transition-all peer-checked:bg-primary peer-checked:border-primary"></div>
                    <span class="material-symbols-outlined absolute text-[12px] text-zinc-950 font-bold opacity-0 peer-checked:opacity-100 transition-opacity">check</span>
                  </label>
                </td>
                <td class="pl-4 pr-8 py-4">
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke">
                      <img alt="${m.title} Poster" class="w-full h-full object-cover" src="${m.posterUrl}" onerror="this.src='/logo-icon.png'" />
                    </div>
                    <div>
                      <p class="text-sm font-semibold group-hover:text-primary transition-colors">${m.title}</p>
                      <p class="text-[9px] text-text-dim uppercase tracking-tighter mt-1">${genresStr} • ${m.releaseYear}</p>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-4">
                  <span class="px-2 py-1 rounded text-[10px] font-bold border ${formatBg}">${format}</span>
                </td>
                <td class="px-8 py-4">
                  <span class="px-2 py-1 rounded bg-secondary/10 text-secondary text-[10px] font-bold border border-secondary/20 whitespace-nowrap">${quality} ${lang.toUpperCase()}</span>
                </td>
                <td class="px-8 py-4">
                  <span class="px-2 py-1 rounded text-[10px] font-bold border ${sourceBg}">${sourceText}</span>
                </td>
                <td class="px-8 py-4">
                  <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full ${statusBg}"></div>
                    <span class="text-xs font-medium text-on-surface">${statusText}</span>
                  </div>
                </td>
                <td class="px-8 py-4 text-right">
                  <div class="flex gap-2 justify-end">
                    <a href="/phim/${m.slug}" target="_blank" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-primary transition-colors cursor-pointer" data-txatooltip="Xem trên web">
                      <span class="material-symbols-outlined text-sm">visibility</span>
                    </a>
                    <a href="/admin/phim/edit?th=${m.slug}" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-primary transition-colors cursor-pointer" data-txatooltip="Chỉnh sửa phim / Cấu hình tập">
                      <span class="material-symbols-outlined text-sm">edit</span>
                    </a>
                    <button onclick="scanSingleMovie('${m.slug}', this)" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-emerald-400 transition-colors cursor-pointer" data-txatooltip="Quét tập mới dựa theo sourceUrl">
                      <span class="material-symbols-outlined text-sm">sync</span>
                    </button>
                    <button onclick="deleteMovie('${m.id}', '${m.slug}', ${isStatic}, this)" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-error transition-colors cursor-pointer" data-txatooltip="Xóa phim này">
                      <span class="material-symbols-outlined text-sm">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            `;
          }).join('');

          if (showCountText) {
            showCountText.textContent = `HIỂN THỊ ${startIndex + 1}–${Math.min(endIndex, totalItems)} / ${totalItems} PHIM`;
          }

          if (paginationInfo) {
            paginationInfo.textContent = `Trang ${currentPage} / ${totalPages}`;
          }

          if (prevBtn) prevBtn.disabled = (currentPage === 1);
          if (nextBtn) nextBtn.disabled = (currentPage === totalPages);
        }

        window.setStatusFilter = function(filter) {
          statusFilter = filter;
          currentPage = 1;
          ['all','ongoing','completed','movie'].forEach(f => {
            const btn = document.getElementById('status-filter-' + f);
            if (btn) btn.classList.toggle('active-filter', filter === f);
          });
          filterAndSearch();
        };

        function filterAndSearch() {
          resetSelections();
          const query = searchInput?.value.trim().toLowerCase() || '';
          const type = filterType?.value || 'all';
          const source = filterSource?.value || 'all';

          let filtered = allMovies;

          if (query) {
            filtered = filtered.filter(m => 
              m.title.toLowerCase().includes(query) || 
              (m.originalTitle && m.originalTitle.toLowerCase().includes(query)) ||
              (Array.isArray(m.genres) && m.genres.some(g => g.toLowerCase().includes(query)))
            );
          }

          if (type !== 'all') {
            filtered = filtered.filter(m => m.type === type);
          }

          if (source !== 'all') {
            filtered = filtered.filter(m => m.source === source);
          }

          if (statusFilter !== 'all') {
            filtered = filtered.filter(m => {
              const epCur = String(m.episodeCurrent || '').toLowerCase();
              const epTot = String(m.episodeTotal || '').toLowerCase();
              const isCompleted = m.status === 'completed' || epCur === 'full' || epTot === 'full' || epCur.includes('hoàn tất');
              const isMovie = m.type === 'movie' || m.type === 'single';
              if (statusFilter === 'completed') return isCompleted && !isMovie;
              if (statusFilter === 'movie') return isMovie;
              if (statusFilter === 'ongoing') return !isCompleted && !isMovie;
              return true;
            });
          }

          currentFilteredList = filtered;
          displayPage(1);
        }

        loadMoviesData();
        currentFilteredList = allMovies;
        displayPage(1);

        // Bind event listeners
        if (searchInput) searchInput.oninput = filterAndSearch;
        if (filterType) filterType.onchange = filterAndSearch;
        if (filterSource) filterSource.onchange = filterAndSearch;
        const pageSizeSelect = document.getElementById('page-size-select');
        if (pageSizeSelect) pageSizeSelect.onchange = () => {
          itemsPerPage = Math.min(100, Number(pageSizeSelect.value) || 10);
          displayPage(1);
        };

        // Bind Select All Checkbox
        const selectAllCheckbox = document.getElementById('select-all-checkbox');
        if (selectAllCheckbox) {
          selectAllCheckbox.addEventListener('change', (e) => {
            const checked = e.target.checked;
            const checkboxes = tbody.querySelectorAll('.movie-select-checkbox');
            checkboxes.forEach(cb => {
              cb.checked = checked;
              const slug = cb.getAttribute('data-slug');
              const isStatic = cb.getAttribute('data-is-static') === 'true';
              window.toggleSelectMovie(slug, isStatic, checked);
            });
          });
        }

        function mapKKPhimToMovieDetail(data, source = 'kkphim') {
          const m = data.movie;
          const defaultCdn = source === 'vsmov' ? 'https://vsmov.com' : 'https://phimimg.com';
          const cdnDomain = data.pathImage || data.APP_DOMAIN_CDN_IMAGE || defaultCdn;
          
          let posterUrl = m.poster_url || '';
          if (posterUrl && !posterUrl.startsWith('http')) {
            const cleanPath = posterUrl.replace(/^\/?uploads\/movies\//, '');
            posterUrl = `${cdnDomain}/uploads/movies/${cleanPath}`;
          }
          let bannerUrl = m.thumb_url || m.poster_url || '';
          if (bannerUrl && !bannerUrl.startsWith('http')) {
            const cleanPath = bannerUrl.replace(/^\/?uploads\/movies\//, '');
            bannerUrl = `${cdnDomain}/uploads/movies/${cleanPath}`;
          }

          const genres = Array.isArray(m.category) ? m.category.map(c => c.name) : [];
          
          let category = "Khác";
          if (Array.isArray(m.country) && m.country.length > 0) {
            category = m.country[0].name;
          }

          let type = 'series';
          if (m.type === 'single') {
            type = 'movie';
          } else if (m.type === 'hoathinh') {
            type = 'hoathinh';
          } else if (m.type === 'tvshows') {
            type = 'tvshows';
          }

          const episodes = Array.isArray(data.episodes) ? data.episodes.map(server => {
            return {
              serverName: server.server_name || "Server VIP",
              serverData: Array.isArray(server.server_data) ? server.server_data.map(ep => {
                let epName = ep.name || '';
                if (epName.trim().match(/^\d+$/)) {
                  epName = `Tập ${epName.padStart(2, '0')}`;
                }
                return {
                  name: epName,
                  slug: ep.slug || `tap-${ep.name}`,
                  filename: ep.filename || `${m.name} - Tap ${ep.name}`,
                  linkEmbed: ep.link_embed || '',
                  linkM3u8: ep.link_m3u8 || '',
                  subtitles: ep.subtitles || ep.subtitles_data || [],
                  timeIntroStart: ep.timeIntroStart || ep.time_intro_start || 0,
                  timeIntroEnd: ep.timeIntroEnd || ep.time_intro_end || 0,
                  timeOutroStart: ep.timeOutroStart || ep.time_outro_start || 0,
                  timeOutroEnd: ep.timeOutroEnd || ep.time_outro_end || 0
                };
              }) : []
            };
          }) : [];

          return {
            id: m._id || m.id || `kk-${m.slug}`,
            title: m.name,
            originalTitle: m.origin_name,
            slug: m.slug,
            description: m.content ? m.content.replace(/<[^>]*>/g, '') : '',
            posterUrl: posterUrl,
            bannerUrl: bannerUrl,
            releaseYear: parseInt(m.year) || 2025,
            durationMinutes: m.time || (type === 'movie' ? '120 phút' : '45 phút/tập'),
            type: type,
            status: m.status === 'completed' ? 'completed' : 'ongoing',
            episodeCurrent: m.episode_current || (type === 'movie' ? 'Full' : '1'),
            episodeTotal: m.episode_total || '1',
            quality: m.quality || 'FHD',
            lang: m.lang || 'Vietsub',
            imdbScore: 8.0,
            category: category,
            ageRating: type === 'movie' ? 'T16' : 'T13',
            genres: genres,
            seasons: type === 'movie' ? 'Bản Điện Ảnh' : 'Phần 1',
            actors: Array.isArray(m.actor) ? m.actor.filter(Boolean) : [],
            directors: Array.isArray(m.director) ? m.director.filter(Boolean) : [],
            trailerUrl: m.trailer_url || '',
            episodes: episodes
          };
        }

        // Bind Bulk Scan Button
        const bulkScanBtn = document.getElementById('bulk-scan-btn');
        if (bulkScanBtn) {
          bulkScanBtn.addEventListener('click', async () => {
            if (selectedMovies.length === 0) return;

            let oldHtml = bulkScanBtn.innerHTML;
            bulkScanBtn.disabled = true;
            bulkScanBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">autorenew</span> Đang quét...';
            
            let success = 0;
            let failed = 0;
            let totalAdded = 0;
            
            if (window.showGlobalToast) window.showGlobalToast('Đang quét tập mới cho ' + selectedMovies.length + ' phim...', 'info');

            for (const item of selectedMovies) {
              try {
                // Fetch old episodes count from internal API
                let oldEpCount = 0;
                try {
                  const oldRes = await fetch('/api/app/movie/' + item.slug);
                  if (oldRes.ok) {
                    const oldJson = await oldRes.json();
                    if (oldJson && oldJson.status === 'success' && oldJson.data && Array.isArray(oldJson.data.servers)) {
                      oldEpCount = oldJson.data.servers[0]?.server_data?.length || 0;
                    }
                  }
                } catch (e) {
                  console.warn('Lỗi khi lấy thông tin phim cũ cho ' + item.slug + ':', e);
                }

                // Determine sourceUrl. If it's stored in allMovies, fetch it. Else fallback to phimapi.com / vsmov.com
                const mObj = allMovies.find(x => x.slug === item.slug);
                const isVsmov = mObj && mObj.originalSource === 'vsmov';
                let sourceUrl = isVsmov 
                  ? 'https://vsmov.com/api/phim/' + item.slug
                  : 'https://phimapi.com/phim/' + item.slug;
                if (mObj && mObj.sourceUrl && mObj.sourceUrl.trim() !== '') {
                  sourceUrl = mObj.sourceUrl;
                }

                const res = await fetch(sourceUrl);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const detailData = await res.json();

                if (detailData && detailData.movie && Array.isArray(detailData.episodes)) {
                  const movieDetailObj = mapKKPhimToMovieDetail(detailData, isVsmov ? 'vsmov' : 'kkphim');
                  movieDetailObj.updatedAt = new Date().toISOString();
                  
                  const newEpCount = movieDetailObj.episodes[0]?.serverData?.length || 0;
                  
                  const saveRes = await fetch('/api/admin/movie-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      action: 'save',
                      slug: item.slug,
                      movieData: movieDetailObj,
                      isStatic: false
                    })
                  });

                  if (saveRes.ok) {
                    success++;
                    const addedCount = newEpCount - oldEpCount;
                    if (addedCount > 0) {
                      totalAdded += addedCount;
                    }
                  } else {
                    failed++;
                  }
                } else {
                  failed++;
                }
              } catch (err) {
                console.error('Lỗi khi quét slug ' + item.slug + ':', err);
                failed++;
              }
              // delay to prevent rate limit
              await new Promise(r => setTimeout(r, 600));
            }

            bulkScanBtn.disabled = false;
            bulkScanBtn.innerHTML = oldHtml;
            
            if (window.showGlobalToast) {
               if (totalAdded > 0) {
                 window.showGlobalToast('Quét xong! Đã thêm tổng cộng ' + totalAdded + ' tập mới.', 'success');
               } else {
                 window.showGlobalToast('Không có tập mới nào được cập nhật.', 'success');
               }
            }
            if (success > 0) {
              setTimeout(() => window.location.reload(), 1500);
            }
          });
        }

        window.scanSingleMovie = async function(slug, btnElement) {
          let oldHtml = btnElement.innerHTML;
          btnElement.disabled = true;
          btnElement.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">autorenew</span>';
          
          if (window.showGlobalToast) window.showGlobalToast('Đang quét tập mới cho phim ' + slug + '...', 'info');

          try {
            // Fetch old episodes count from internal API
            let oldEpCount = 0;
            try {
              const oldRes = await fetch('/api/app/movie/' + slug);
              if (oldRes.ok) {
                const oldJson = await oldRes.json();
                if (oldJson && oldJson.status === 'success' && oldJson.data && Array.isArray(oldJson.data.servers)) {
                  oldEpCount = oldJson.data.servers[0]?.server_data?.length || 0;
                }
              }
            } catch (e) {
              console.warn('Lỗi khi lấy thông tin phim cũ:', e);
            }

            const mObj = allMovies.find(x => x.slug === slug);
            const isVsmov = mObj && mObj.originalSource === 'vsmov';
            let sourceUrl = isVsmov 
              ? 'https://vsmov.com/api/phim/' + slug
              : 'https://phimapi.com/phim/' + slug;
            if (mObj && mObj.sourceUrl && mObj.sourceUrl.trim() !== '') {
              sourceUrl = mObj.sourceUrl;
            }

            const res = await fetch(sourceUrl);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const detailData = await res.json();

            if (detailData && detailData.movie && Array.isArray(detailData.episodes)) {
              const movieDetailObj = mapKKPhimToMovieDetail(detailData, isVsmov ? 'vsmov' : 'kkphim');
              movieDetailObj.updatedAt = new Date().toISOString();
              
              const newEpCount = movieDetailObj.episodes[0]?.serverData?.length || 0;
              
              const saveRes = await fetch('/api/admin/movie-action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  action: 'save',
                  slug: slug,
                  movieData: movieDetailObj,
                  isStatic: false
                })
              });

              if (saveRes.ok) {
                const addedCount = newEpCount - oldEpCount;
                if (window.showGlobalToast) {
                  if (addedCount > 0) {
                    window.showGlobalToast('Quét tập mới thành công! Đã thêm ' + addedCount + ' tập mới.', 'success');
                  } else {
                    window.showGlobalToast('Không có tập mới nào được cập nhật.', 'success');
                  }
                }
                setTimeout(() => window.location.reload(), 1500);
              } else {
                if (window.showGlobalToast) window.showGlobalToast('Lỗi khi lưu dữ liệu', 'error');
                btnElement.disabled = false;
                btnElement.innerHTML = oldHtml;
              }
            } else {
              if (window.showGlobalToast) window.showGlobalToast('Dữ liệu API không hợp lệ', 'error');
              btnElement.disabled = false;
              btnElement.innerHTML = oldHtml;
            }
          } catch (err) {
            console.error('Lỗi khi quét slug ' + slug + ':', err);
            if (window.showGlobalToast) window.showGlobalToast('Không thể quét được tập mới', 'error');
            btnElement.disabled = false;
            btnElement.innerHTML = oldHtml;
          }
        };

        // Bind Bulk Delete Button
        const bulkDeleteBtn = document.getElementById('bulk-delete-btn');
        if (bulkDeleteBtn) {
          bulkDeleteBtn.addEventListener('click', () => {
            if (selectedMovies.length === 0) return;

            const performBulkDelete = async () => {
              let oldHtml = bulkDeleteBtn.innerHTML;
              bulkDeleteBtn.disabled = true;
              bulkDeleteBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">autorenew</span> Xóa đã chọn...';
              try {
                const res = await fetch('/api/admin/movie-action', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'delete', items: selectedMovies })
                });
                const result = await res.json();
                if (res.ok) {
                  if (window.showGlobalToast) {
                    window.showGlobalToast('Đã xóa thành công ' + selectedMovies.length + ' phim!', 'success');
                  }
                  setTimeout(() => window.location.reload(), 800);
                } else {
                  if (window.showGlobalToast) window.showGlobalToast(result.message || 'Lỗi khi xóa phim', 'error');
                  bulkDeleteBtn.disabled = false;
                  bulkDeleteBtn.innerHTML = oldHtml;
                }
              } catch (e) {
                if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API', 'error');
                bulkDeleteBtn.disabled = false;
                bulkDeleteBtn.innerHTML = oldHtml;
              }
            };

            if (window.txamodal) {
              window.txamodal.show({
                title: 'Xóa hàng loạt phim',
                message: 'Bạn có chắc chắn muốn xóa ' + selectedMovies.length + ' phim đã chọn khỏi hệ thống không?',
                type: 'danger',
                confirmText: 'Xóa tất cả',
                cancelText: 'Hủy bỏ',
                onConfirm: performBulkDelete
              });
            } else if (confirm('Bạn có chắc chắn muốn xóa ' + selectedMovies.length + ' phim đã chọn khỏi hệ thống không?')) {
              performBulkDelete();
            }
          });
        }

        if (prevBtn) {
          prevBtn.onclick = () => {
            if (currentPage > 1) {
              displayPage(currentPage - 1);
            }
          };
        }

        if (nextBtn) {
          nextBtn.onclick = () => {
            const totalPages = Math.ceil(currentFilteredList.length / itemsPerPage) || 1;
            if (currentPage < totalPages) {
              displayPage(currentPage + 1);
            }
          };
        }
      }

      initMoviesIndex();
      document.addEventListener('astro:page-load', initMoviesIndex);
    })();
  </script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
  </style>
</AdminLayout>
