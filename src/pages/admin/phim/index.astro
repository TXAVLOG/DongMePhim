---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { MovieService } from '../../../services/MovieService';

const staticMovies = await MovieService.getMovies();
---

<AdminLayout title="Quản lý Phim">
  <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 mt-4 gap-4">
    <div>
      <h2 class="font-headline-lg text-on-surface text-3xl">Quản lý Phim</h2>
      <p class="text-text-dim text-body-main mt-1">Quản lý kho phim của bạn bao gồm phim hệ thống và phim đã thu thập (crawled).</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/phim/crawler" class="px-4 py-2.5 glass-panel hover:bg-surface-variant text-on-surface rounded-xl text-xs font-bold transition-all active:scale-95 flex items-center gap-2 cursor-pointer border border-glass-stroke">
        <span class="material-symbols-outlined text-sm">cloud_download</span>
        <span>Thu thập phim</span>
      </a>
      <a href="/admin/phim/tao-thu-cong" class="px-4 py-2.5 bg-primary hover:brightness-110 text-slate-950 font-bold rounded-xl text-xs transition-all active:scale-95 flex items-center gap-2 cursor-pointer border-none shadow-lg shadow-primary/10">
        <span class="material-symbols-outlined text-sm">add</span>
        <span>Thêm phim thủ công</span>
      </a>
    </div>
  </header>

  <!-- Filter & Search Panel -->
  <section class="glass-panel p-6 rounded-3xl mb-8 flex flex-col md:flex-row justify-between items-center gap-4">
    <div class="relative group w-full md:w-80">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-text-dim group-focus-within:text-primary transition-colors">search</span>
      <input id="movie-search" class="bg-surface-container border border-glass-stroke rounded-full pl-10 pr-4 py-2.5 text-xs focus:ring-1 focus:ring-primary focus:border-primary w-full transition-all focus:outline-none placeholder:text-zinc-500 text-white" placeholder="Tìm kiếm tên phim, thể loại..." type="text"/>
    </div>
    
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
      <select id="filter-type" class="bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-primary text-zinc-300 w-full md:w-auto cursor-pointer">
        <option value="all">Tất cả định dạng</option>
        <option value="movie">Phim Lẻ</option>
        <option value="series">Phim Bộ</option>
      </select>
      
      <select id="filter-source" class="bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-primary text-zinc-300 w-full md:w-auto cursor-pointer">
        <option value="all">Tất cả nguồn</option>
        <option value="static">Hệ thống (Static)</option>
        <option value="crawled">Đã Thu thập (Crawled)</option>
      </select>
    </div>
  </section>

  <!-- Movies Table -->
  <section class="glass-panel rounded-3xl overflow-hidden mb-8">
    <div class="px-8 py-6 flex justify-between items-center border-b border-glass-stroke bg-white/[0.01]">
      <h3 class="text-title-md text-on-surface font-bold">Danh sách phim</h3>
      <span id="movies-summary" class="text-xs text-text-dim font-bold font-label-caps">ĐANG TẢI...</span>
    </div>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-surface-container/40">
          <tr>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">PHIM</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">ĐỊNH DẠNG</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">CHẤT LƯỢNG</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">NGUỒN</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">TRẠNG THÁI</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim text-right">HÀNH ĐỘNG</th>
          </tr>
        </thead>
        <tbody id="movie-table-tbody" class="divide-y divide-glass-stroke">
          <!-- Populated dynamically via JS client side -->
        </tbody>
      </table>
    </div>
    
    <div class="p-4 bg-surface-container/20 flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-glass-stroke">
      <p id="show-count-text" class="text-xs text-text-dim font-label-caps font-bold">HIỂN THỊ 0 TRÊN TỔNG SỐ 0 PHIM</p>
      <div id="movie-pagination" class="flex items-center gap-4">
        <span id="movie-pagination-info" class="text-xs text-zinc-400 font-bold uppercase">Trang 1 / 1</span>
        <div class="flex gap-2">
          <button id="movie-prev-btn" class="px-3 py-1.5 bg-zinc-950 border border-glass-stroke text-zinc-400 hover:text-white rounded-lg text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Trước</button>
          <button id="movie-next-btn" class="px-3 py-1.5 bg-zinc-950 border border-glass-stroke text-zinc-400 hover:text-white rounded-lg text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Sau</button>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ staticMovies }}>
    // We merge static movies from the server and crawled movies from localStorage client-side
    (function() {
      function initMoviesIndex() {
        const tbody = document.getElementById('movie-table-tbody');
        if (!tbody) return; // Exit if not on this page

        const searchInput = document.getElementById('movie-search');
        const filterType = document.getElementById('filter-type');
        const filterSource = document.getElementById('filter-source');
        const summaryText = document.getElementById('movies-summary');
        const showCountText = document.getElementById('show-count-text');
        const prevBtn = document.getElementById('movie-prev-btn');
        const nextBtn = document.getElementById('movie-next-btn');
        const paginationInfo = document.getElementById('movie-pagination-info');

        let staticList = staticMovies.map(m => ({ ...m, source: 'static' }));
        let crawledList = [];
        let allMovies = [];
        let currentFilteredList = [];
        let currentPage = 1;
        const itemsPerPage = 10;

        function loadMoviesData() {
          const crawledMovies = JSON.parse(localStorage.getItem('txa_crawled_movies') || '[]');
          crawledList = crawledMovies.map(item => {
            const m = item.movie || item;
            let type = 'series';
            if (m.type === 'single' || m.type === 'movie') {
              type = 'movie';
            } else if (m.type === 'hoathinh') {
              type = 'hoathinh';
            } else if (m.type === 'tvshows') {
              type = 'tvshows';
            }
            return {
              id: m.id || `local-${m.slug}`,
              title: m.title || m.name,
              originalTitle: m.originalTitle || m.origin_name || '',
              slug: m.slug,
              description: m.description || m.content || '',
              posterUrl: m.posterUrl || m.poster_url || m.poster || '',
              bannerUrl: m.bannerUrl || m.thumb_url || m.posterUrl || m.poster_url || m.poster || '',
              releaseYear: m.releaseYear || parseInt(m.year) || 2024,
              durationMinutes: m.durationMinutes || m.time || '120 phút',
              type: type,
              status: m.status === 'completed' ? 'completed' : 'ongoing',
              episodeCurrent: m.episodeCurrent || m.episode_current || 'Full',
              episodeTotal: m.episodeTotal || m.episode_total || '1',
              quality: m.quality || 'FHD',
              lang: m.lang || 'Vietsub',
              imdbScore: m.imdbScore || 8.0,
              views: m.views || 0,
              commentCount: m.commentCount || 0,
              category: m.category || 'Khác',
              genres: m.genres || [],
              updatedAt: m.updatedAt || new Date().toISOString(),
              source: 'crawled'
            };
          });
          allMovies = [...crawledList, ...staticList].filter(m => m.slug && m.slug !== 'undefined' && m.slug !== 'null');
          
          if (summaryText) {
            summaryText.textContent = `${staticList.length} Hệ thống + ${crawledList.length} Crawled`;
          }
        }

        window.deleteMovie = function(movieId) {
          const performDelete = () => {
            let list = JSON.parse(localStorage.getItem('txa_crawled_movies') || '[]');
            list = list.filter(m => m.id !== movieId);
            localStorage.setItem('txa_crawled_movies', JSON.stringify(list));
            if (window.showGlobalToast) {
              window.showGlobalToast('Đã xóa phim thành công!', 'success');
            }
            loadMoviesData();
            filterAndSearch();
          };

          if (window.txamodal) {
            window.txamodal.show({
              title: 'Xóa phim khỏi hệ thống',
              message: 'Bạn có chắc chắn muốn xóa phim này khỏi danh sách đã thu thập không? Thao tác này không thể khôi phục.',
              type: 'danger',
              confirmText: 'Xóa phim',
              cancelText: 'Hủy bỏ',
              onConfirm: performDelete
            });
          } else if (confirm('Bạn có chắc chắn muốn xóa phim này khỏi danh sách đã thu thập không?')) {
            performDelete();
          }
        };

        function displayPage(page) {
          if (!tbody) return;

          const totalItems = currentFilteredList.length;
          const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

          if (page > totalPages) page = totalPages;
          if (page < 1) page = 1;
          currentPage = page;

          const startIndex = (currentPage - 1) * itemsPerPage;
          const endIndex = startIndex + itemsPerPage;
          const paginatedList = currentFilteredList.slice(startIndex, endIndex);

          if (paginatedList.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="6" class="px-8 py-12 text-center text-xs text-text-dim italic">
                  Không tìm thấy phim nào khớp với bộ lọc của bạn.
                </td>
              </tr>
            `;
            if (showCountText) showCountText.textContent = 'HIỂN THỊ 0 PHIM';
            if (paginationInfo) paginationInfo.textContent = 'Trang 1 / 1';
            if (prevBtn) prevBtn.disabled = true;
            if (nextBtn) nextBtn.disabled = true;
            return;
          }

          // Apply fade-in animation
          tbody.classList.remove('animate-fade-in');
          void tbody.offsetWidth;
          tbody.classList.add('animate-fade-in');

          tbody.innerHTML = paginatedList.map(m => {
            const genresStr = Array.isArray(m.genres) ? m.genres.join(', ') : (m.genres || 'KỊCH TÍNH');
            const quality = m.quality || 'FHD';
            const lang = m.lang || 'Vietsub';
            const format = m.type === 'movie' ? 'Phim Lẻ' : 'Phim Bộ';
            const formatBg = m.type === 'movie' ? 'bg-blue-500/10 text-blue-400 border-blue-500/20' : 'bg-purple-500/10 text-purple-400 border-purple-500/20';
            
            let sourceText = 'Hệ thống';
            let sourceBg = 'bg-zinc-500/10 text-zinc-400 border-zinc-500/20';
            if (m.source === 'crawled') {
              sourceText = 'Crawled';
              sourceBg = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
            }

            // Formatting status logic
            const format2Digits = (val) => {
              if (val === undefined || val === null || val === '') return '??';
              const clean = String(val).replace(/^[tT]ập\s+/, '').trim();
              if (clean.toLowerCase() === 'full') return 'Full';
              const parsed = parseInt(clean, 10);
              return !isNaN(parsed) && String(parsed) === clean ? (parsed < 10 ? `0${parsed}` : `${parsed}`) : clean;
            };

            let statusText = '';
            let statusBg = 'bg-amber-500';
            if (m.type === 'movie') {
              statusText = 'Film Full';
              statusBg = 'bg-emerald-500';
            } else {
              const xx = format2Digits(m.episodeCurrent);
              const yy = format2Digits(m.episodeTotal);
              
              if (xx.toLowerCase() === 'full' || xx.toLowerCase() === 'hoàn tất') {
                statusText = 'Hoàn tất';
              } else if (xx.includes('/') || xx.toLowerCase().includes('hoàn tất') || xx.toLowerCase().includes('full')) {
                statusText = xx.startsWith('Tập') || xx.startsWith('tập') ? xx : `Tập ${xx}`;
              } else {
                statusText = `Tập ${xx}/${yy}`;
              }
              
              if (m.status === 'completed' || xx.toLowerCase().includes('hoàn tất') || xx.toLowerCase() === 'full') {
                statusBg = 'bg-emerald-500';
              }
            }

            const isStatic = m.source === 'static';

            return `
              <tr class="hover:bg-white/5 transition-colors group">
                <td class="px-8 py-4">
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke">
                      <img alt="${m.title} Poster" class="w-full h-full object-cover" src="${m.posterUrl}" onerror="this.src='/logo-icon.png'" />
                    </div>
                    <div>
                      <p class="text-sm font-semibold group-hover:text-primary transition-colors">${m.title}</p>
                      <p class="text-[9px] text-text-dim uppercase tracking-tighter mt-1">${genresStr} • ${m.releaseYear}</p>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-4">
                  <span class="px-2 py-1 rounded text-[10px] font-bold border ${formatBg}">${format}</span>
                </td>
                <td class="px-8 py-4">
                  <span class="px-2 py-1 rounded bg-secondary/10 text-secondary text-[10px] font-bold border border-secondary/20 whitespace-nowrap">${quality} ${lang.toUpperCase()}</span>
                </td>
                <td class="px-8 py-4">
                  <span class="px-2 py-1 rounded text-[10px] font-bold border ${sourceBg}">${sourceText}</span>
                </td>
                <td class="px-8 py-4">
                  <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full ${statusBg}"></div>
                    <span class="text-xs font-medium text-on-surface">${statusText}</span>
                  </div>
                </td>
                <td class="px-8 py-4 text-right">
                  <div class="flex gap-2 justify-end">
                    <a href="/phim/${m.slug}" target="_blank" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-primary transition-colors cursor-pointer" title="Xem trên web">
                      <span class="material-symbols-outlined text-sm">visibility</span>
                    </a>
                    <a href="${m.source === 'crawled' ? `/admin/phim/edit?th=${m.slug}` : `/admin/phim/edit?m=${m.slug}`}" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-primary transition-colors cursor-pointer" title="Chỉnh sửa phim / Cấu hình tập">
                      <span class="material-symbols-outlined text-sm">edit</span>
                    </a>
                    ${isStatic ? `
                      <button class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center text-zinc-600 cursor-not-allowed" title="Không thể xóa phim hệ thống" disabled>
                        <span class="material-symbols-outlined text-sm">delete</span>
                      </button>
                    ` : `
                      <button onclick="deleteMovie('${m.id}')" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-error transition-colors cursor-pointer" title="Xóa phim crawled">
                        <span class="material-symbols-outlined text-sm">delete</span>
                      </button>
                    `}
                  </div>
                </td>
              </tr>
            `;
          }).join('');

          if (showCountText) {
            showCountText.textContent = `HIỂN THỊ ${paginatedList.length} TRÊN TỔNG SỐ ${allMovies.length} PHIM`;
          }

          if (paginationInfo) {
            paginationInfo.textContent = `Trang ${currentPage} / ${totalPages}`;
          }

          if (prevBtn) prevBtn.disabled = (currentPage === 1);
          if (nextBtn) nextBtn.disabled = (currentPage === totalPages);
        }

        function filterAndSearch() {
          const query = searchInput?.value.trim().toLowerCase() || '';
          const type = filterType?.value || 'all';
          const source = filterSource?.value || 'all';

          let filtered = allMovies;

          if (query) {
            filtered = filtered.filter(m => 
              m.title.toLowerCase().includes(query) || 
              (m.originalTitle && m.originalTitle.toLowerCase().includes(query)) ||
              (Array.isArray(m.genres) && m.genres.some(g => g.toLowerCase().includes(query)))
            );
          }

          if (type !== 'all') {
            filtered = filtered.filter(m => m.type === type);
          }

          if (source !== 'all') {
            filtered = filtered.filter(m => m.source === source);
          }

          currentFilteredList = filtered;
          displayPage(1);
        }

        loadMoviesData();
        currentFilteredList = allMovies;
        displayPage(1);

        // Bind event listeners
        if (searchInput) searchInput.oninput = filterAndSearch;
        if (filterType) filterType.onchange = filterAndSearch;
        if (filterSource) filterSource.onchange = filterAndSearch;

        if (prevBtn) {
          prevBtn.onclick = () => {
            if (currentPage > 1) {
              displayPage(currentPage - 1);
            }
          };
        }

        if (nextBtn) {
          nextBtn.onclick = () => {
            const totalPages = Math.ceil(currentFilteredList.length / itemsPerPage) || 1;
            if (currentPage < totalPages) {
              displayPage(currentPage + 1);
            }
          };
        }
      }

      initMoviesIndex();
      document.addEventListener('astro:page-load', initMoviesIndex);
    })();
  </script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
  </style>
</AdminLayout>
