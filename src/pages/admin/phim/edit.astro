                  <input type="text" class="bg-zinc-950 border border-glass-stroke rounded-lg px-3 py-1.5 text-sm font-bold text-white w-48 focus:outline-none" value="${server.server_name}" oninput="movieData.episodes[${serverIdx}].server_name = this.value"/>
