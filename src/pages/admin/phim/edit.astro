                  </div>
                  <div>
                    <label class="block text-[9px] text-zinc-500 font-bold uppercase mb-1">Giờ chiếu tập này</label>
                    <input type="time" class="w-full bg-zinc-950 border border-glass-stroke rounded-lg py-1 px-2.5 text-xs text-white" value="${ep.airTime || ep.air_time || ""}" oninput="movieData.episodes[${serverIdx}].server_data[${epIdx}].air_time = this.value; movieData.episodes[${serverIdx}].server_data[${epIdx}].airTime = this.value"/>
