                    <label class="block text-[9px] text-zinc-500 font-bold uppercase mb-1">Bỏ qua Intro (giây)</label>
                    <input type="number" class="w-full bg-zinc-950 border border-glass-stroke rounded-lg py-1.5 px-2.5 text-xs text-center text-white" value="${ep.time_intro_end}" oninput="movieData.episodes[${serverIdx}].server_data[${epIdx}].time_intro_end = parseInt(this.value) || 0"/>
