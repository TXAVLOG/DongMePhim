                    <input type="number" class="w-full bg-zinc-950 border border-glass-stroke rounded-lg py-1.5 px-2.5 text-xs text-center text-white" value="${ep.time_intro_start}" oninput="movieData.episodes[${serverIdx}].server_data[${epIdx}].time_intro_start = parseInt(this.value) || 0"/>
