---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Chỉnh sửa phim & Cấu hình tập">
  <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 mt-4 gap-4">
    <div>
      <a href="/admin/phim" class="text-zinc-400 hover:text-primary text-xs font-bold flex items-center gap-1 mb-2 transition-colors">
        <span class="material-symbols-outlined text-sm">arrow_back</span> QUAY LẠI DANH SÁCH
      </a>
      <h1 class="font-display-hero text-3xl font-extrabold text-white tracking-tight" id="pageTitle">
        Chỉnh sửa phim
      </h1>
      <p class="text-zinc-400 text-sm mt-1" id="pageSubtitle">
        Chỉnh sửa thông tin chi tiết phim hoặc cấu hình mốc thời gian, phụ đề cho phim cào từ API.
      </p>
    </div>

    <div class="flex gap-3">
      <button id="saveMovieBtn" class="bg-gradient-to-r from-primary to-secondary hover:brightness-110 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center gap-2 cursor-pointer border-none">
        <span class="material-symbols-outlined text-lg">save</span>
        Lưu thay đổi
      </button>
    </div>
  </header>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 mb-10">
    <!-- Left: Movie info & Episode config -->
    <div class="xl:col-span-8 space-y-6">
      
      <!-- API Sync Box (Only visible for API Mode ?m=slug) -->
      <div id="apiSyncCard" class="glass-panel rounded-3xl p-6 border border-glass-stroke hidden relative overflow-hidden">
        <div class="absolute inset-0 bg-primary/5 blur-[40px] pointer-events-none"></div>
        <div class="relative z-10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h3 class="font-bold text-lg text-white mb-1 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">sync</span> Cập nhật tập mới từ KKPhim
            </h3>
            <p class="text-xs text-zinc-400 font-body-main">
              Quét và đồng bộ các tập phim mới được cập nhật trên hệ thống KKPhim mà không mất phụ đề hay timings cũ.
            </p>
          </div>
          <button id="btn-api-sync" class="bg-primary/20 hover:bg-primary/30 border border-primary/30 text-primary font-bold px-5 py-2.5 rounded-xl text-xs transition-all cursor-pointer flex items-center gap-1.5 whitespace-nowrap">
            <span class="material-symbols-outlined text-sm">cached</span> Quét tập mới
          </button>
        </div>
      </div>

      <!-- Main Movie Info Form -->
      <div id="movieInfoCard" class="glass-panel rounded-3xl p-6 border border-glass-stroke">
        <h3 class="font-bold text-lg text-white mb-4 pb-2 border-b border-glass-stroke flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">info</span> Thông tin chi tiết phim
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Tên phim</label>
            <input type="text" id="movieTitle" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Ví dụ: Đảo Hải Tặc" required />
          </div>
          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Tên gốc / Tên tiếng Anh</label>
            <input type="text" id="movieOriginalTitle" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Ví dụ: One Piece" />
          </div>
          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Đường dẫn tĩnh (Slug)</label>
            <input type="text" id="movieSlug" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm font-mono text-zinc-300" placeholder="Ví dụ: dao-hai-tac" disabled />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-label-caps text-outline uppercase mb-2">Phân loại</label>
              <select id="movieType" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white">
                <option value="series">Phim Bộ</option>
                <option value="movie">Phim Lẻ</option>
                <option value="hoathinh">Hoạt Hình</option>
                <option value="tvshows">TV Shows</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-label-caps text-outline uppercase mb-2">Trạng thái</label>
              <select id="movieStatus" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white">
                <option value="ongoing">Đang chiếu</option>
                <option value="completed">Hoàn thành</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-2 col-span-1 md:col-span-2">
            <input type="checkbox" id="moviePinned" class="w-4 h-4 rounded border-glass-stroke bg-zinc-950 text-primary focus:ring-0 focus:outline-none cursor-pointer" />
            <label for="moviePinned" class="text-xs font-bold text-zinc-300 select-none cursor-pointer">Ghim phim này lên Banner chính (Hero Banner)</label>
          </div>

          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Ảnh dọc (Poster URL)</label>
            <input type="text" id="moviePosterUrl" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="https://example.com/poster.jpg" />
          </div>
          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Ảnh ngang (Thumb URL)</label>
            <input type="text" id="movieBannerUrl" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="https://example.com/banner.jpg" />
          </div>

          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Đường dẫn Trailer (YouTube URL)</label>
            <input type="text" id="movieTrailerUrl" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="https://www.youtube.com/watch?v=..." />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-label-caps text-outline uppercase mb-2">Quốc gia</label>
              <input type="text" id="movieCountry" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Ví dụ: Nhật Bản" />
            </div>
            <div>
              <label class="block text-xs font-label-caps text-outline uppercase mb-2">Thể loại</label>
              <div id="genresCheckboxList" class="grid grid-cols-2 gap-2 max-h-36 overflow-y-auto bg-zinc-950 border border-glass-stroke rounded-xl p-3 custom-scrollbar">
                <!-- Rendered via JS -->
              </div>
              <input type="hidden" id="movieCategory" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Diễn viên chính (cách nhau bởi phẩy)</label>
            <input type="text" id="movieActors" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Luffy, Zoro, Nami" />
          </div>
          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Đạo diễn</label>
            <input type="text" id="movieDirectors" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Oda Eiichiro" />
          </div>

          <!-- Lịch chiếu phim -->
          <div class="col-span-1 md:col-span-2 border-t border-glass-stroke/50 pt-4 mt-2" id="broadcastScheduleSection">
            <span class="block text-xs font-label-caps text-outline uppercase mb-3 font-bold text-primary flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">calendar_month</span> Lịch phát sóng (Tập tiếp theo)
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label class="block text-[11px] text-zinc-400 mb-1.5">Ngày phát sóng dự kiến</label>
                <input type="date" id="scheduleDate" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" />
              </div>
              <div>
                <label class="block text-[11px] text-zinc-400 mb-1.5">Giờ phát sóng dự kiến</label>
                <input type="time" id="scheduleTime" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" />
              </div>
              <div>
                <label class="block text-[11px] text-zinc-400 mb-1.5">Thông báo lịch chiếu</label>
                <input type="text" id="scheduleNotice" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-2.5 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Ví dụ: Tập 13 chiếu vào 20:00 tối" />
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <label class="block text-xs font-label-caps text-outline uppercase mb-2">Tóm tắt nội dung phim</label>
          <textarea id="movieDescription" rows="4" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Mô tả nội dung tóm tắt..."></textarea>
        </div>
      </div>

      <!-- Episode Management Panel -->
      <div class="glass-panel rounded-3xl p-6 border border-glass-stroke">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-2 border-b border-glass-stroke">
          <h3 class="font-bold text-lg text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary">list</span>
            Hệ thống liên kết phát (Server / Tập)
          </h3>
          <button type="button" id="addServerBtn" class="border border-primary/40 hover:bg-primary/10 text-primary py-2 px-4 rounded-xl text-xs font-bold transition-all cursor-pointer bg-transparent">
            + Thêm Server phát mới
          </button>
        </div>

        <!-- Dynamic Servers List -->
        <div id="serversContainer" class="space-y-6"></div>

        <div id="emptyServers" class="hidden flex flex-col items-center justify-center p-8 text-center bg-zinc-950/40 rounded-2xl border border-dashed border-glass-stroke">
          <span class="material-symbols-outlined text-4xl opacity-20 mb-2">dns</span>
          <p class="text-sm text-zinc-500">Chưa có server phát nào. Hãy thêm server mới để bắt đầu cấu hình.</p>
        </div>
      </div>
    </div>

    <!-- Right Sticky tools -->
    <div class="xl:col-span-4 space-y-6">
      <div id="formatCard" class="glass-panel rounded-3xl p-6 border border-glass-stroke sticky top-6">
        <h3 class="font-bold text-base text-white mb-4 pb-2 border-b border-glass-stroke flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">tune</span> Định dạng & Tập hiển thị
        </h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Chất lượng hiển thị</label>
            <input type="text" id="movieQuality" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="FHD, 2K, 4K..." />
          </div>
          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Ngôn ngữ hiển thị</label>
            <input type="text" id="movieLang" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Vietsub, Thuyết Minh..." />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-label-caps text-outline uppercase mb-2">Tập hiện tại</label>
              <input type="text" id="movieEpCurrent" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Ví dụ: 12 hoặc Full" />
            </div>
            <div>
              <label class="block text-xs font-label-caps text-outline uppercase mb-2">Tổng số tập</label>
              <input type="text" id="movieEpTotal" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="Ví dụ: 12" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Năm phát hành</label>
            <input type="number" id="movieYear" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" value="2026" />
          </div>
          <div>
            <label class="block text-xs font-label-caps text-outline uppercase mb-2">Thời lượng (phút)</label>
            <input type="text" id="movieTime" class="w-full bg-zinc-950 border border-glass-stroke rounded-xl text-on-surface py-3 px-4 focus:outline-none focus:ring-1 focus:ring-primary text-sm text-white" placeholder="90 phút" />
          </div>
        </div>

        <!-- Time Calculator Tool -->
        <div class="border-t border-glass-stroke/50 pt-4 mt-6">
          <span class="block text-xs font-label-caps text-outline uppercase mb-3 font-bold text-secondary flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">schedule</span> Bộ quy đổi sang giây
          </span>
          <div class="grid grid-cols-3 gap-2 mb-3">
            <input type="number" id="calcH" placeholder="Giờ" class="bg-zinc-950 border border-glass-stroke rounded-lg py-2 px-1 text-center text-xs focus:outline-none text-white" />
            <input type="number" id="calcM" placeholder="Phút" class="bg-zinc-950 border border-glass-stroke rounded-lg py-2 px-1 text-center text-xs focus:outline-none text-white" />
            <input type="number" id="calcS" placeholder="Giây" class="bg-zinc-950 border border-glass-stroke rounded-lg py-2 px-1 text-center text-xs focus:outline-none text-white" />
          </div>
          <div class="flex justify-between items-center bg-zinc-950 border border-glass-stroke rounded-xl p-3">
            <span id="calcResult" class="text-xs font-bold text-white font-mono">0 giây</span>
            <button id="copyCalcBtn" class="text-[10px] text-secondary font-bold uppercase hover:underline cursor-pointer bg-transparent border-none">Sao chép</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      let movieData = {
        movie: {
          name: "", origin_name: "", slug: "", type: "series", status: "ongoing",
          poster_url: "", thumb_url: "", trailer_url: "", category: "", country: "",
          year: 2026, time: "", quality: "FHD", lang: "Vietsub", episode_current: "",
          episode_total: "", actor: [], director: [],
        },
        episodes: []
      };

      let activeMode = "local"; // "local" (thủ công) | "api" (phim API)
      let editSlug = "";

      const pageTitle = document.getElementById("pageTitle");
      const pageSubtitle = document.getElementById("pageSubtitle");
      const saveMovieBtn = document.getElementById("saveMovieBtn");
      const movieInfoCard = document.getElementById("movieInfoCard");
      const formatCard = document.getElementById("formatCard");
      const serversContainer = document.getElementById("serversContainer");
      const emptyServers = document.getElementById("emptyServers");
      const addServerBtn = document.getElementById("addServerBtn");
      const apiSyncCard = document.getElementById("apiSyncCard");
      const btnApiSync = document.getElementById("btn-api-sync");

      function renderGenresCheckboxes(selectedGenres = []) {
        const storedGenres = localStorage.getItem('txa_genres');
        let sysGenres = [];
        try {
          sysGenres = storedGenres ? JSON.parse(storedGenres) : [];
        } catch (e) {}
        if (sysGenres.length === 0) {
          sysGenres = [
            { name: "Hành động", slug: "hanh-dong" },
            { name: "Tình cảm", slug: "tinh-cam" },
            { name: "Kinh dị", slug: "kinh-di" },
            { name: "Viễn tưởng", slug: "vien-tuong" },
            { name: "Kịch tính", slug: "kich-tinh" },
            { name: "Tâm lý", slug: "tam-ly" },
            { name: "Hài hước", slug: "hai-huoc" },
            { name: "Hình sự", slug: "hinh-su" },
            { name: "Cổ trang", slug: "co-trang" },
            { name: "Hoạt hình", slug: "hoat-hinh" },
            { name: "Phiêu lưu", slug: "phieu-luu" }
          ];
        }

        const container = document.getElementById("genresCheckboxList");
        if (!container) return;

        const normSelected = selectedGenres.map(g => g.trim().toLowerCase());

        container.innerHTML = sysGenres.map(genre => {
          const checked = normSelected.includes(genre.name.toLowerCase()) ? "checked" : "";
          return `
            <label class="flex items-center gap-2 cursor-pointer text-xs text-zinc-300 hover:text-white">
              <input type="checkbox" name="movie-genres" value="${genre.name}" ${checked} class="accent-primary w-4 h-4 rounded border-glass-stroke bg-zinc-950 focus:ring-0 focus:outline-none" />
              <span>${genre.name}</span>
            </label>
          `;
        }).join("");
      }

      // Check query params and bootstrap edit data
      async function checkURLMode() {
        const params = new URLSearchParams(window.location.search);
        const th = params.get("th"); // edit thủ công
        const m = params.get("m"); // edit API

        if (th) {
          activeMode = "local";
          editSlug = th;
          pageTitle.textContent = `Chỉnh sửa phim: ${th}`;
          pageSubtitle.textContent = "Chỉnh sửa thông tin phim thủ công và danh sách tập phim.";
          apiSyncCard.classList.add("hidden");
          loadLocalMovieForEdit(th);
        } else if (m) {
          activeMode = "api";
          editSlug = m;
          pageTitle.textContent = `Cấu hình tập phim: ${m}`;
          pageSubtitle.textContent = "Chỉ cấu hình phụ đề, intro/outro và ghim hiển thị cho phim cào từ API.";
          apiSyncCard.classList.remove("hidden");
          
          // Dim info card but enable status & quality
          movieInfoCard.classList.add("opacity-40", "pointer-events-none");
          const broadcastSec = document.getElementById("broadcastScheduleSection");
          if (broadcastSec) broadcastSec.style.cssText = "pointer-events: auto !important; opacity: 1 !important;";

          // Load episodes API and mix with config
          const configStr = localStorage.getItem("txa_episodes_config") || "{}";
          const config = JSON.parse(configStr);
          const movieConfig = config[m];
          await loadApiMovieEpisodes(m, movieConfig);
        } else {
          // Fallback redirect
          window.location.href = "/admin/phim";
        }
      }

      function loadLocalMovieForEdit(slug) {
        const listStr = localStorage.getItem("txa_crawled_movies") || "[]";
        let list = [];
        try { list = JSON.parse(listStr); } catch (e) {}

        const found = list.find(item => (item.movie?.slug || item.slug) === slug);
        if (found) {
          const m = found.movie || found;
          movieData.movie = {
            name: m.title || m.name || "",
            origin_name: m.originalTitle || m.origin_name || "",
            slug: m.slug || slug,
            type: m.type || "series",
            status: m.status || "ongoing",
            poster_url: m.posterUrl || m.poster_url || "",
            thumb_url: m.bannerUrl || m.thumb_url || m.posterUrl || "",
            trailer_url: m.trailerUrl || m.trailer_url || "",
            category: m.category || "",
            country: m.country || "",
            year: m.releaseYear || m.year || 2026,
            time: m.durationMinutes || m.time || "",
            quality: m.quality || "FHD",
            lang: m.lang || "Vietsub",
            episode_current: m.episodeCurrent || m.episode_current || "",
            episode_total: m.episodeTotal || m.episode_total || "",
            actor: m.actors || m.actor || [],
            director: m.directors || m.director || [],
            pinned: found.pinned || m.pinned || false,
          };

          const rawEps = found.episodes || [];
          movieData.episodes = rawEps.map(server => {
            const srvData = server.serverData || server.server_data || [];
            return {
              server_name: server.serverName || server.server_name || "Server VIP",
              server_data: srvData.map(ep => ({
                name: ep.name || "",
                slug: ep.slug || `tap-${ep.name}`,
                filename: ep.filename || "",
                link_m3u8: ep.linkM3u8 || ep.link_m3u8 || "",
                link_embed: ep.linkEmbed || ep.link_embed || "",
                time_intro_start: ep.timeIntroStart ?? ep.time_intro_start ?? 0,
                time_intro_end: ep.timeIntroEnd ?? ep.time_intro_end ?? 0,
                time_outro_start: ep.timeOutroStart ?? ep.time_outro_start ?? 0,
                time_outro_end: ep.timeOutroEnd ?? ep.time_outro_end ?? 0,
                subtitles: ep.subtitles || ep.subtitles_data || [],
              }))
            };
          });

          // Fill input fields
          document.getElementById("movieTitle").value = movieData.movie.name;
          document.getElementById("movieOriginalTitle").value = movieData.movie.origin_name;
          document.getElementById("movieSlug").value = movieData.movie.slug;
          document.getElementById("movieType").value = movieData.movie.type;
          document.getElementById("movieStatus").value = movieData.movie.status;
          document.getElementById("moviePosterUrl").value = movieData.movie.poster_url;
          document.getElementById("movieBannerUrl").value = movieData.movie.thumb_url;
          document.getElementById("movieTrailerUrl").value = movieData.movie.trailer_url;
          document.getElementById("movieCategory").value = movieData.movie.category;
          const selectedGenres = m.genres || (m.category ? m.category.split(",").map(s => s.trim()) : []);
          renderGenresCheckboxes(selectedGenres);
          document.getElementById("movieCountry").value = movieData.movie.country;
          document.getElementById("movieActors").value = movieData.movie.actor.join(", ");
          document.getElementById("movieDirectors").value = movieData.movie.director.join(", ");
          document.getElementById("movieDescription").value = m.description || movieData.movie.content || "";
          document.getElementById("movieQuality").value = movieData.movie.quality;
          document.getElementById("movieLang").value = movieData.movie.lang;
          document.getElementById("movieEpCurrent").value = movieData.movie.episode_current;
          document.getElementById("movieEpTotal").value = movieData.movie.episode_total;
          document.getElementById("movieYear").value = movieData.movie.year;
          document.getElementById("movieTime").value = movieData.movie.time;
          document.getElementById("moviePinned").checked = !!movieData.movie.pinned;

          if (found.broadcastSchedule) {
            document.getElementById("scheduleDate").value = found.broadcastSchedule.nextDate || "";
            document.getElementById("scheduleTime").value = found.broadcastSchedule.nextTime || "";
            document.getElementById("scheduleNotice").value = found.broadcastSchedule.notice || "";
          }

          renderServers();
        } else {
          if (window.showGlobalToast) window.showGlobalToast("Không tìm thấy dữ liệu phim thủ công này!", "error");
        }
      }

      async function loadApiMovieEpisodes(slug, existingConfig = null) {
        try {
          const res = await fetch(`https://phimapi.com/phim/${slug}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();

          if (data && data.movie && Array.isArray(data.episodes)) {
            movieData.movie.slug = slug;
            movieData.movie.name = data.movie.name;

            // Prefill some fields even in API mode
            document.getElementById("movieTitle").value = data.movie.name || "";
            document.getElementById("movieOriginalTitle").value = data.movie.origin_name || "";
            document.getElementById("movieSlug").value = slug;
            document.getElementById("movieQuality").value = existingConfig?.quality || data.movie.quality || "FHD";
            document.getElementById("movieLang").value = existingConfig?.lang || data.movie.lang || "Vietsub";
            document.getElementById("movieEpCurrent").value = data.movie.episode_current || "";
            document.getElementById("movieEpTotal").value = data.movie.episode_total || "";
            document.getElementById("movieYear").value = data.movie.year || 2026;
            document.getElementById("movieTime").value = data.movie.time || "";

            const apiGenres = Array.isArray(data.movie.category) ? data.movie.category.map((c) => c.name) : [];
            renderGenresCheckboxes(apiGenres);

            movieData.episodes = data.episodes.map(server => {
              const srvData = server.server_data || [];
              return {
                server_name: server.server_name || "Server VIP",
                server_data: srvData.map(ep => {
                  let epName = ep.name || "";
                  if (epName.trim().match(/^\d+$/)) {
                    epName = `Tập ${epName.padStart(2, "0")}`;
                  }

                  const epSlug = ep.slug || `tap-${ep.name}`;
                  const localEpConfig = existingConfig ? existingConfig[epSlug] : null;

                  return {
                    name: epName,
                    slug: epSlug,
                    filename: ep.filename || "",
                    link_m3u8: localEpConfig?.link_m3u8 || ep.link_m3u8 || "",
                    link_embed: localEpConfig?.link_embed || ep.link_embed || "",
                    time_intro_start: localEpConfig ? localEpConfig.timeIntroStart : 0,
                    time_intro_end: localEpConfig ? localEpConfig.timeIntroEnd : 0,
                    time_outro_start: localEpConfig ? localEpConfig.timeOutroStart : 0,
                    time_outro_end: localEpConfig ? localEpConfig.timeOutroEnd : 0,
                    subtitles: localEpConfig ? localEpConfig.subtitles : [],
                    airDate: localEpConfig ? localEpConfig.airDate : "",
                    airTime: localEpConfig ? localEpConfig.airTime : "",
                  };
                })
              };
            });

            if (existingConfig) {
              if (existingConfig.broadcastSchedule) {
                document.getElementById("scheduleDate").value = existingConfig.broadcastSchedule.nextDate || "";
                document.getElementById("scheduleTime").value = existingConfig.broadcastSchedule.nextTime || "";
                document.getElementById("scheduleNotice").value = existingConfig.broadcastSchedule.notice || "";
              }
              document.getElementById("moviePinned").checked = !!existingConfig.pinned;
            }

            renderServers();
          }
        } catch (e) {
          if (window.showGlobalToast) window.showGlobalToast("Lỗi tải phim từ API: " + e.message, "error");
        }
      }

      // Sync KKPhim new episodes API keeping current edits
      btnApiSync.onclick = async () => {
        btnApiSync.disabled = true;
        btnApiSync.innerHTML = '<span class="animate-spin material-symbols-outlined text-sm">autorenew</span> Đang quét...';
        
        try {
          const res = await fetch(`https://phimapi.com/phim/${editSlug}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();

          if (data && Array.isArray(data.episodes)) {
            let addedCount = 0;
            const updatedEpisodes = data.episodes.map(newServer => {
              const existingServer = movieData.episodes.find(s => s.server_name === newServer.server_name) || movieData.episodes[0];
              const existingData = existingServer ? existingServer.server_data : [];

              return {
                server_name: newServer.server_name || "Server VIP",
                server_data: newServer.server_data.map(newEp => {
                  let epName = newEp.name || "";
                  if (epName.trim().match(/^\d+$/)) {
                    epName = `Tập ${epName.padStart(2, "0")}`;
                  }
                  const epSlug = newEp.slug || `tap-${newEp.name}`;
                  const existingEp = existingData.find(e => e.slug === epSlug || e.name === epName);

                  if (existingEp) {
                    return {
                      ...existingEp,
                      link_m3u8: existingEp.link_m3u8 || newEp.link_m3u8 || "",
                      link_embed: existingEp.link_embed || newEp.link_embed || "",
                    };
                  } else {
                    addedCount++;
                    return {
                      name: epName, slug: epSlug, filename: newEp.filename || "",
                      link_m3u8: newEp.link_m3u8 || "", link_embed: newEp.link_embed || "",
                      time_intro_start: 0, time_intro_end: 0, time_outro_start: 0, time_outro_end: 0,
                      subtitles: [], airDate: "", airTime: ""
                    };
                  }
                })
              };
            });

            movieData.episodes = updatedEpisodes;
            document.getElementById("movieEpCurrent").value = data.movie.episode_current || "";
            document.getElementById("movieEpTotal").value = data.movie.episode_total || "";
            
            renderServers();
            if (window.showGlobalToast) window.showGlobalToast(`Quét hoàn tất! Thêm ${addedCount} tập phim mới.`, "success");
          }
        } catch (e) {
          if (window.showGlobalToast) window.showGlobalToast("Lỗi đồng bộ: " + e.message, "error");
        } finally {
          btnApiSync.disabled = false;
          btnApiSync.innerHTML = '<span class="material-symbols-outlined text-sm">cached</span> Quét tập mới';
        }
      };

