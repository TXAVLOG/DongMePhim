                    <input type="text" class="w-full bg-zinc-950 border border-glass-stroke rounded-lg py-2 px-3 text-xs focus:outline-none text-zinc-200 font-mono" value="${ep.link_m3u8}" oninput="movieData.episodes[${serverIdx}].server_data[${epIdx}].link_m3u8 = this.value"/>
                  </div>
                  <div>
                    <label class="block text-[10px] text-zinc-500 font-bold uppercase mb-1">Đường dẫn Embed phát</label>
                    <input type="text" class="w-full bg-zinc-950 border border-glass-stroke rounded-lg py-2 px-3 text-xs focus:outline-none text-zinc-200 font-mono" value="${ep.link_embed}" oninput="movieData.episodes[${serverIdx}].server_data[${epIdx}].link_embed = this.value"/>
