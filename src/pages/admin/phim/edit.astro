              <button type="button" onclick="addEpisode(${serverIdx})" class="w-full py-2.5 bg-zinc-900 border border-dashed border-glass-stroke hover:bg-white/5 text-xs text-zinc-300 rounded-xl font-bold flex items-center justify-center gap-1 cursor-pointer border-none">+ Thêm tập phim mới</button>
