      addServerBtn.onclick = () => {
        movieData.episodes.push({ server_name: `Server VIP ${movieData.episodes.length + 1}`, server_data: [] });
        renderServers();
      };

      window.deleteServer = (idx) => {
        const doDel = () => { movieData.episodes.splice(idx, 1); renderServers(); };
        if (window.txamodal) {
          window.txamodal.show({ title: "Xóa Server", message: "Xóa Server này sẽ xóa toàn bộ tập của nó. Bạn có chắc không?", type: "danger", confirmText: "Xóa", cancelText: "Hủy", onConfirm: doDel });
        } else if (confirm("Xóa Server này?")) { doDel(); }
      };

      window.addEpisode = (srvIdx) => {
        const server = movieData.episodes[srvIdx];
        const count = server.server_data.length + 1;
        server.server_data.push({
          name: `Tập ${count.toString().padStart(2, "0")}`, slug: `tap-${count}`,
          link_m3u8: "", link_embed: "", filename: "", time_intro_start: 0, time_intro_end: 0,
          time_outro_start: 0, time_outro_end: 0, subtitles: []
        });
        renderServers();
      };

      window.deleteEpisode = (srvIdx, epIdx) => {
        movieData.episodes[srvIdx].server_data.splice(epIdx, 1);
        renderServers();
      };

      window.addSubtitle = (srvIdx, epIdx) => {
        const ep = movieData.episodes[srvIdx].server_data[epIdx];
        if (!ep.subtitles) ep.subtitles = [];
        ep.subtitles.push({ label: ep.subtitles.length === 0 ? "Tiếng Việt" : `Phụ đề ${ep.subtitles.length + 1}`, file: "", default: ep.subtitles.length === 0 });
        renderServers();
      };

      window.deleteSubtitle = (srvIdx, epIdx, subIdx) => {
        movieData.episodes[srvIdx].server_data[epIdx].subtitles.splice(subIdx, 1);
        renderServers();
      };

      window.toggleSubDefault = (srvIdx, epIdx, subIdx) => {
        movieData.episodes[srvIdx].server_data[epIdx].subtitles.forEach((s, idx) => s.default = (idx === subIdx));
        renderServers();
      };

      // Calculator logic
      const calcH = document.getElementById("calcH");
      const calcM = document.getElementById("calcM");
      const calcS = document.getElementById("calcS");
      const calcResult = document.getElementById("calcResult");
      const copyCalcBtn = document.getElementById("copyCalcBtn");

      function updateCalc() {
        calcResult.textContent = `${(parseInt(calcH.value)||0)*3600 + (parseInt(calcM.value)||0)*60 + (parseInt(calcS.value)||0)} giây`;
      }
      [calcH, calcM, calcS].forEach(el => el?.addEventListener("input", updateCalc));
      copyCalcBtn.onclick = () => {
        navigator.clipboard.writeText(calcResult.textContent.split(" ")[0]);
        if (window.showGlobalToast) window.showGlobalToast("Đã sao chép!", "success");
      };

      // Save handlers
      saveMovieBtn.onclick = () => {
        const scheduleDate = document.getElementById("scheduleDate").value;
        const scheduleTime = document.getElementById("scheduleTime").value;
        const scheduleNotice = document.getElementById("scheduleNotice").value.trim();
        const broadcastSchedule = (scheduleDate || scheduleTime || scheduleNotice) ? { nextDate: scheduleDate, nextTime: scheduleTime, notice: scheduleNotice } : undefined;

        if (activeMode === "local") {
          const title = document.getElementById("movieTitle").value.trim();
          if (!title) {
            if (window.showGlobalToast) window.showGlobalToast("Vui lòng điền tên phim!", "error");
            return;
          }

          const slug = document.getElementById("movieSlug").value;
          const listStr = localStorage.getItem("txa_crawled_movies") || "[]";
          let list = [];
          try { list = JSON.parse(listStr); } catch (e) {}

          const qualityVal = document.getElementById("movieQuality").value.trim() || "FHD";
          const langVal = document.getElementById("movieLang").value.trim() || "Vietsub";
          const epCur = document.getElementById("movieEpCurrent").value.trim();
          const epTot = document.getElementById("movieEpTotal").value.trim();
          const yearVal = parseInt(document.getElementById("movieYear").value) || 2026;
          const timeVal = document.getElementById("movieTime").value.trim();
          const actorsStr = document.getElementById("movieActors").value.trim();
          const directorsStr = document.getElementById("movieDirectors").value.trim();

          const checkedCheckboxes = Array.from(document.querySelectorAll('input[name="movie-genres"]:checked'));
          const selectedGenreNames = checkedCheckboxes.map((cb) => cb.value);
          const categoryVal = selectedGenreNames.join(", ") || "Khác";

          const movieDetailObj = {
            id: `local-${slug}`,
            title: title,
            originalTitle: document.getElementById("movieOriginalTitle").value.trim(),
            slug: slug,
            pinned: document.getElementById("moviePinned").checked,
            description: document.getElementById("movieDescription").value.trim(),
            posterUrl: document.getElementById("moviePosterUrl").value.trim() || "https://png.pngtree.com/thumb_back/fh260/background/20250415/pngtree-a-glowing-film-reel-standing-vertically-in-front-image_17193146.jpg",
            bannerUrl: document.getElementById("movieBannerUrl").value.trim() || document.getElementById("moviePosterUrl").value.trim(),
            releaseYear: yearVal,
            durationMinutes: timeVal || "120 phút",
            type: document.getElementById("movieType").value,
            status: document.getElementById("movieStatus").value,
            episodeCurrent: epCur || "Full",
            episodeTotal: epTot || "1",
            quality: qualityVal,
            lang: langVal,
            imdbScore: 8.0,
            category: categoryVal,
            genres: selectedGenreNames.length > 0 ? selectedGenreNames : ["Khác"],
            actors: actorsStr ? actorsStr.split(",").map(s => s.trim()).filter(Boolean) : [],
            directors: directorsStr ? directorsStr.split(",").map(s => s.trim()).filter(Boolean) : [],
            trailerUrl: document.getElementById("movieTrailerUrl").value.trim(),
            seasons: document.getElementById("movieType").value === "movie" ? "Bản Điện Ảnh" : "Phần 1",
            broadcastSchedule,
            updatedAt: new Date().toISOString(),
            episodes: movieData.episodes.map(server => ({
              serverName: server.server_name || "Server VIP",
              serverData: server.server_data.map(ep => ({
                name: ep.name,
                slug: ep.slug || `tap-${ep.name}`,
                filename: ep.filename || `${title} - ${ep.name}`,
                linkEmbed: ep.link_embed || ep.linkEmbed || "",
                linkM3u8: ep.link_m3u8 || ep.linkM3u8 || "",
                timeIntroStart: ep.time_intro_start || 0,
                timeIntroEnd: ep.time_intro_end || 0,
                timeOutroStart: ep.time_outro_start || 0,
                timeOutroEnd: ep.time_outro_end || 0,
                subtitles: ep.subtitles || [],
                airDate: ep.airDate || ep.air_date || "",
                airTime: ep.airTime || ep.air_time || "",
              }))
            }))
          };

          // Filter out existing and prepend updated
          list = list.filter(m => (m.movie?.slug || m.slug) !== editSlug);
          list.unshift(movieDetailObj);
          localStorage.setItem("txa_crawled_movies", JSON.stringify(list));

          if (window.showGlobalToast) window.showGlobalToast("Cập nhật phim thủ công thành công!", "success");
          setTimeout(() => window.location.href = "/admin/phim", 1000);
        } else {
          // API METADATA OVERRIDE MODE
          if (movieData.episodes.length === 0) {
            if (window.showGlobalToast) window.showGlobalToast("Chưa có cấu hình tập phim để lưu!", "error");
            return;
          }

          const epConfigMap = {
            pinned: document.getElementById("moviePinned").checked,
            quality: document.getElementById("movieQuality").value.trim(),
            lang: document.getElementById("movieLang").value.trim()
          };
          if (broadcastSchedule) epConfigMap.broadcastSchedule = broadcastSchedule;

          movieData.episodes.forEach(server => {
            server.server_data.forEach(ep => {
              epConfigMap[ep.slug] = {
                link_m3u8: ep.link_m3u8 || "",
                link_embed: ep.link_embed || "",
                timeIntroStart: ep.time_intro_start || 0,
                timeIntroEnd: ep.time_intro_end || 0,
                timeOutroStart: ep.time_outro_start || 0,
                timeOutroEnd: ep.time_outro_end || 0,
                subtitles: ep.subtitles || [],
                airDate: ep.airDate || ep.air_date || "",
                airTime: ep.airTime || ep.air_time || "",
              };
            });
          });

          const registryStr = localStorage.getItem("txa_episodes_config") || "{}";
          let registry = {};
          try { registry = JSON.parse(registryStr); } catch (e) {}

          registry[editSlug] = epConfigMap;
          localStorage.setItem("txa_episodes_config", JSON.stringify(registry));

          if (window.showGlobalToast) window.showGlobalToast("Cấu hình tập phim API thành công!", "success");
          setTimeout(() => window.location.href = "/admin/phim", 1000);
        }
      };

      checkURLMode();
    })();
  </script>
</AdminLayout>
