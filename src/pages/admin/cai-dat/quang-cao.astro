---
import AdminLayout from "@layouts/AdminLayout.astro";
import { SettingService } from "@services/SettingService";
import SettingsSidebar from "@components/admin/SettingsSidebar.astro";

const settings = await SettingService.getSettings();
let activeTab = "quang-cao";
---

<AdminLayout title="Cài đặt hệ thống - Cấu hình Quảng cáo">
  <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 mt-4 gap-4">
    <div>
      <h2 class="font-headline-lg text-on-surface text-3xl">Cấu hình hệ thống</h2>
      <p class="text-text-dim text-body-main mt-1">Quản lý quảng cáo video pre-roll, click pop-under và các cấu hình quảng cáo khác.</p>
    </div>
    <div class="flex items-center gap-4">
      <button
        id="save-settings-btn"
        class="px-6 py-2 bg-primary text-slate-950 rounded-full font-label-caps font-bold hover:brightness-110 transition-all cursor-pointer flex items-center gap-2 border-none"
      >
        <span class="material-symbols-outlined text-sm">save</span>
        Lưu thay đổi
      </button>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Cài đặt Navigation Sidebar -->
    <SettingsSidebar activeTab="quang-cao" />

    <!-- Cài đặt Panel Content -->
    <div class="lg:col-span-3 glass-panel rounded-3xl p-8">
      <div id="tab-quang-cao" class="space-y-8">
        
        <!-- SECTION 0: Active Ad Provider Selection -->
        <div class="space-y-4 pb-6 border-b border-glass-stroke">
          <h3 class="text-title-md pb-2 mb-2 text-xl font-bold text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">ad_group</span>
            Nhà cung cấp quảng cáo chính
          </h3>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim">Trạng thái Google AdSense</label>
            <select id="ad-provider-select" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-bold">
              <option value="none">❌ Tắt quảng cáo Google AdSense trên Web</option>
              <option value="google_ads">🌐 Bật quảng cáo Google AdSense trên Web</option>
            </select>
          </div>
        </div>

        <!-- SECTION 1: Pre-roll Video Ads -->
        <div class="space-y-6">
          <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-4 text-xl font-bold text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">play_circle</span>
            Quảng cáo Video trước khi chiếu (Pre-roll Ads)
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">Trạng thái Pre-roll</label>
              <select id="pre-roll-enable" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white">
                <option value="false">Tắt quảng cáo</option>
                <option value="true">Bật quảng cáo</option>
              </select>
            </div>

            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">Loại nguồn phát</label>
              <select id="pre-roll-type" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white">
                <option value="video">Link video MP4 trực tiếp</option>
                <option value="embed">Mã nhúng iframe (YouTube/TikTok/FB/IG)</option>
              </select>
            </div>

            <div class="space-y-2 md:col-span-2">
              <label class="text-xs font-label-caps text-text-dim">Đường dẫn nguồn phát (Mỗi URL/Mã nhúng 1 dòng, chọn ngẫu nhiên)</label>
              <textarea id="pre-roll-url" rows="3" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="Nhập link file MP4 hoặc đoạn code mã nhúng iframe... (Mỗi cái 1 dòng)"></textarea>
            </div>

            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">Thời gian hiển thị nút Skip (Giây)</label>
              <input type="number" id="pre-roll-skip-seconds" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white" min="0" placeholder="Ví dụ: 5" />
            </div>
          </div>
        </div>

        <!-- SECTION 2: Pop-under Click Ads -->
        <div class="space-y-6 pt-6 border-t border-glass-stroke">
          <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-4 text-xl font-bold text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">ads_click</span>
            Quảng cáo nhảy trang khi Click (Pop-under Ads)
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">Trạng thái Click Ads</label>
              <select id="click-ad-enable" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white">
                <option value="false">Tắt quảng cáo click</option>
                <option value="true">Bật quảng cáo click</option>
              </select>
            </div>

            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">Số lần click để kích hoạt nhảy tab (Threshold)</label>
              <input type="number" id="click-ad-threshold" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white" min="1" placeholder="Ví dụ: 5" />
            </div>

            <div class="space-y-2 md:col-span-2">
              <label class="text-xs font-label-caps text-text-dim">Đường dẫn đích khi click (Mỗi URL 1 dòng, chọn ngẫu nhiên)</label>
              <textarea id="click-ad-code" rows="4" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="https://shope.ee/...\nhttps://tiki.vn/..."></textarea>
            </div>
          </div>
        </div>

        <!-- SECTION 3: Google Ads (AdSense) -->
        <div id="google-ads-config-section" class="space-y-6 pt-6 border-t border-glass-stroke transition-all duration-300">
          <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-4 text-xl font-bold text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">public</span>
            Cấu hình Google AdSense
          </h3>

          <div class="grid grid-cols-1 gap-6">
            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">Google AdSense Client ID (ca-pub-xxx)</label>
              <input type="text" id="google-ads-client-id" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="ca-pub-123456789" />
            </div>
          </div>
        </div>

        <!-- SECTION 5: Google AdMob Integration for Mobile & Smart TV -->
        <div id="admob-config-section" class="space-y-6 pt-6 border-t border-glass-stroke transition-all duration-300">
          <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-4 text-xl font-bold text-white flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">smartphone</span>
            Cấu hình Google AdMob (Dành cho App Android & Smart TV)
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2 md:col-span-2">
              <label class="text-xs font-label-caps text-text-dim">Trạng thái Google AdMob</label>
              <select id="admob-enable" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-bold">
                <option value="false">❌ Tắt quảng cáo Google AdMob trên App</option>
                <option value="true">⚡ Bật quảng cáo Google AdMob trên App Mobile & TV</option>
              </select>
            </div>

            <div class="space-y-2 md:col-span-2">
              <label class="text-xs font-label-caps text-text-dim">AdMob Application ID (ca-app-pub-xxx~xxx)</label>
              <input type="text" id="admob-app-id" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="ca-app-pub-3940256099942544~3347511713" />
            </div>

            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">🤖 Android - AdMob Unit ID: Quảng cáo Khởi động App</label>
              <input type="text" id="admob-app-start-ad-id-android" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="ca-app-pub-xxx/xxx (Android)" />
            </div>

            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">🍏 iOS - AdMob Unit ID: Quảng cáo Khởi động App</label>
              <input type="text" id="admob-app-start-ad-id-ios" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="ca-app-pub-xxx/xxx (iOS)" />
            </div>

            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">🤖 Android - AdMob Unit ID: Quảng cáo Pre-roll (Trước khi xem Phim)</label>
              <input type="text" id="admob-preroll-ad-id-android" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="ca-app-pub-xxx/xxx (Android)" />
            </div>

            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim">🍏 iOS - AdMob Unit ID: Quảng cáo Pre-roll (Trước khi xem Phim)</label>
              <input type="text" id="admob-preroll-ad-id-ios" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="ca-app-pub-xxx/xxx (iOS)" />
            </div>

            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim flex items-center gap-1">
                <span class="material-symbols-outlined text-amber-400 text-sm">stars</span>
                🤖 Android - AdMob Unit ID: Rewarded (Xem để Mở khóa Icon 3 ngày)
              </label>
              <input type="text" id="admob-rewarded-ad-id-android" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="ca-app-pub-xxx/xxx (Android)" />
            </div>

            <div class="space-y-2">
              <label class="text-xs font-label-caps text-text-dim flex items-center gap-1">
                <span class="material-symbols-outlined text-amber-400 text-sm">stars</span>
                🍏 iOS - AdMob Unit ID: Rewarded (Xem để Mở khóa Icon 3 ngày)
              </label>
              <input type="text" id="admob-rewarded-ad-id-ios" class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono text-xs" placeholder="ca-app-pub-xxx/xxx (iOS)" />
              <p class="text-xs text-text-dim mt-1 md:col-span-2">⚠️ Phải chọn đúng loại <strong class="text-amber-400">Rewarded</strong> khi tạo đơn vị trên AdMob Console. Để trống = dùng Test ID tự động.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script is:inline define:vars={{ serverSettings: settings }}>
    (function () {
      function updateSectionVisibility() {
        const provider = document.getElementById("ad-provider-select")?.value;
        const googleSection = document.getElementById("google-ads-config-section");

        if (googleSection) {
          googleSection.classList.toggle("hidden", provider !== "google_ads");
        }
      }

      function hydrateFromLocalStorage() {
        const stored = serverSettings;
        if (!stored) return;

        const s = stored;
        const ads = s.ads || {};
        
        // Hydrate Ad Provider Selector
        const provider = ads.ad_provider || (
          (ads.google_ads_enable && ads.offerwall_enable) ? "both" :
          ads.google_ads_enable ? "google_ads" :
          ads.offerwall_enable ? "offerwall" : "none"
        );
        setSelect("ad-provider-select", provider);
        
        // Hydrate Ads Settings
        setSelect("pre-roll-enable", ads.pre_roll_enable ? "true" : "false");
        setSelect("pre-roll-type", ads.pre_roll_type || "video");
        setVal("pre-roll-url", ads.pre_roll_url || "");
        setVal("pre-roll-skip-seconds", ads.pre_roll_skip_seconds !== undefined ? ads.pre_roll_skip_seconds : 5);
        
        setSelect("click-ad-enable", ads.click_ad_enable ? "true" : "false");
        setVal("click-ad-threshold", ads.click_ad_threshold !== undefined ? ads.click_ad_threshold : 5);
        setVal("click-ad-code", ads.click_ad_code || "");

        setVal("google-ads-client-id", ads.google_ads_client_id || "");

        // Hydrate AdMob Settings
        setSelect("admob-enable", ads.admob_enable ? "true" : "false");
        setVal("admob-app-id", ads.admob_app_id || "ca-app-pub-3940256099942544~3347511713");
        setVal("admob-app-start-ad-id-android", ads.admob_app_start_ad_id_android || "");
        setVal("admob-app-start-ad-id-ios", ads.admob_app_start_ad_id_ios || "");
        setVal("admob-preroll-ad-id-android", ads.admob_preroll_ad_id_android || "");
        setVal("admob-preroll-ad-id-ios", ads.admob_preroll_ad_id_ios || "");
        setVal("admob-rewarded-ad-id-android", ads.admob_rewarded_ad_id_android || "");
        setVal("admob-rewarded-ad-id-ios", ads.admob_rewarded_ad_id_ios || "");

        updateSectionVisibility();
      }

      function setVal(id, val) {
        const el = document.getElementById(id);
        if (el && val !== undefined && val !== null) el.value = val;
      }
      function setSelect(id, val) {
        const el = document.getElementById(id);
        if (el && val !== undefined && val !== null) el.value = val;
      }

      // Add event listener for ad provider select
      document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("ad-provider-select")?.addEventListener("change", updateSectionVisibility);
      });
      // Fallback event registration
      setTimeout(() => {
        document.getElementById("ad-provider-select")?.addEventListener("change", updateSectionVisibility);
      }, 500);

      // Save handler
      document.getElementById("save-settings-btn")?.addEventListener("click", async () => {
        const btn = document.getElementById("save-settings-btn");
        if (!btn) return;
        const originalText = btn.innerHTML;

        try {
          btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[16px]">progress_activity</span> Đang lưu...';
          btn.disabled = true;

          const current = serverSettings;
          const providerVal = document.getElementById("ad-provider-select")?.value || "none";

          const updatedSettings = {
            ...current,
            ads: {
              pre_roll_enable: document.getElementById("pre-roll-enable")?.value === "true",
              pre_roll_type: document.getElementById("pre-roll-type")?.value || "video",
              pre_roll_url: document.getElementById("pre-roll-url")?.value || "",
              pre_roll_skip_seconds: parseInt(document.getElementById("pre-roll-skip-seconds")?.value) || 0,
              click_ad_enable: document.getElementById("click-ad-enable")?.value === "true",
              click_ad_threshold: parseInt(document.getElementById("click-ad-threshold")?.value) || 5,
              click_ad_code: document.getElementById("click-ad-code")?.value || "",
              google_ads_client_id: document.getElementById("google-ads-client-id")?.value || "",
              offerwall_script: document.getElementById("offerwall-script")?.value || "",
              admob_enable: document.getElementById("admob-enable")?.value === "true",
              admob_app_id: document.getElementById("admob-app-id")?.value || "",
              admob_app_start_ad_id_android: document.getElementById("admob-app-start-ad-id-android")?.value || "",
              admob_app_start_ad_id_ios: document.getElementById("admob-app-start-ad-id-ios")?.value || "",
              admob_preroll_ad_id_android: document.getElementById("admob-preroll-ad-id-android")?.value || "",
              admob_preroll_ad_id_ios: document.getElementById("admob-preroll-ad-id-ios")?.value || "",
              admob_rewarded_ad_id_android: document.getElementById("admob-rewarded-ad-id-android")?.value || "",
              admob_rewarded_ad_id_ios: document.getElementById("admob-rewarded-ad-id-ios")?.value || "",
              ad_provider: providerVal,
              google_ads_enable: providerVal !== "none",
              offerwall_enable: false
            }
          };

          // Lưu trực tiếp vào Database
          await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(updatedSettings)
          });
          
          if (window.showGlobalToast) {
            window.showGlobalToast("Lưu cấu hình quảng cáo vào Database thành công!", "success");
          } else {
            alert("Lưu cấu hình quảng cáo thành công!");
          }
        } catch (error) {
          console.error("Save error:", error);
          if (window.showGlobalToast) window.showGlobalToast("Lỗi khi lưu Database!", "error");
        } finally {
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      });

      // Init
      hydrateFromLocalStorage();
      document.addEventListener("astro:page-load", () => {
        hydrateFromLocalStorage();
        document.getElementById("ad-provider-select")?.addEventListener("change", updateSectionVisibility);
      });
    })();
  </script>
</AdminLayout>
