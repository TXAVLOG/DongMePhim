---
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="iOS Management">
  <div class="w-full pb-10 mt-4">
    <!-- Header -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
      <div>
        <h2 class="font-headline-lg text-on-surface text-3xl">Quản lý Thiết bị & iOS Certificate</h2>
        <p class="text-text-dim text-body-main mt-1">Quản lý hạ tầng ký app và phân phối iOS cho TPhimX Premium</p>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-glass-stroke gap-6 mb-8">
      <button id="tabDevicesBtn" class="pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer flex items-center gap-2">
        <span class="material-symbols-outlined text-sm">smartphone</span> Thiết bị iOS (UDID)
      </button>
      <button id="tabCertsBtn" class="pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer flex items-center gap-2">
        <span class="material-symbols-outlined text-sm">security</span> Chứng chỉ Apple (.p12)
      </button>
    </div>

    <!-- TAB 1: DEVICES MANAGER -->
    <div id="tabDevicesPanel" class="space-y-6">
      <!-- Statistics Grid -->
      <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <div class="glass-panel p-6 rounded-3xl relative overflow-hidden">
          <div class="absolute -top-6 -right-6 w-20 h-20 rounded-full bg-white/5 blur-xl"></div>
          <p class="text-[10px] text-zinc-500 font-bold uppercase tracking-wider">Tổng thiết bị</p>
          <span id="statTotalDevices" class="text-3xl font-black text-white mt-1 block">0</span>
        </div>
        <div class="glass-panel p-6 rounded-3xl relative overflow-hidden">
          <div class="absolute -top-6 -right-6 w-20 h-20 rounded-full bg-emerald-500/5 blur-xl"></div>
          <p class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider">Đã kích hoạt</p>
          <span id="statApprovedDevices" class="text-3xl font-black text-emerald-400 mt-1 block">0</span>
        </div>
        <div class="glass-panel p-6 rounded-3xl relative overflow-hidden">
          <div class="absolute -top-6 -right-6 w-20 h-20 rounded-full bg-yellow-500/5 blur-xl"></div>
          <p class="text-[10px] text-yellow-400 font-bold uppercase tracking-wider">Đang chờ duyệt</p>
          <span id="statPendingDevices" class="text-3xl font-black text-yellow-400 mt-1 block">0</span>
        </div>
        <div class="glass-panel p-6 rounded-3xl relative overflow-hidden">
          <div class="absolute -top-6 -right-6 w-20 h-20 rounded-full bg-red-500/5 blur-xl"></div>
          <p class="text-[10px] text-red-400 font-bold uppercase tracking-wider">Đã bị chặn</p>
          <span id="statBlockedDevices" class="text-3xl font-black text-red-400 mt-1 block">0</span>
        </div>
      </section>

      <!-- Main Controls and Table Panel -->
      <section class="glass-panel rounded-3xl overflow-hidden">
        <div class="p-6 border-b border-glass-stroke flex flex-col md:flex-row justify-between items-stretch md:items-center gap-4 bg-white/[0.01]">
          <h3 class="text-title-md text-on-surface font-bold flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">phone_iphone</span>
            Danh sách thiết bị (<span id="devicesCountText">0</span>)
          </h3>
          
          <div class="flex flex-wrap items-center gap-3">
            <!-- Search input -->
            <div class="relative group w-full md:w-64">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-text-dim group-focus-within:text-primary transition-colors">search</span>
              <input id="deviceSearchInput" class="bg-surface-container border border-glass-stroke rounded-xl pl-10 pr-4 py-2 text-xs focus:ring-1 focus:ring-primary focus:border-primary w-full transition-all focus:outline-none placeholder:text-zinc-500 text-white" placeholder="Tìm kiếm UDID, tên máy..." type="text"/>
            </div>
            <!-- Status dropdown -->
            <select id="deviceStatusFilter" class="bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 text-xs focus:outline-none focus:border-primary text-zinc-300 w-full md:w-auto cursor-pointer">
              <option value="all">Tất cả trạng thái</option>
              <option value="approved">Đã duyệt (Approved)</option>
              <option value="pending">Chờ duyệt (Pending)</option>
              <option value="blocked">Đã chặn (Blocked)</option>
            </select>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="bg-surface-container/40">
              <tr>
                <th class="px-6 py-4 text-xs font-label-caps text-text-dim">THIẾT BỊ</th>
                <th class="px-6 py-4 text-xs font-label-caps text-text-dim">MÃ UDID</th>
                <th class="px-6 py-4 text-xs font-label-caps text-text-dim">CẤU HÌNH & OS</th>
                <th class="px-6 py-4 text-xs font-label-caps text-text-dim">CÀI ĐẶT VÀO LÚC NÀO</th>
                <th class="px-6 py-4 text-xs font-label-caps text-text-dim">TRẠNG THÁI</th>
                <th class="px-6 py-4 text-xs font-label-caps text-text-dim text-right">HÀNH ĐỘNG</th>
              </tr>
            </thead>
            <tbody id="devicesTableBody" class="divide-y divide-glass-stroke text-xs">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>
        
        <div id="emptyDevices" class="hidden flex flex-col items-center justify-center p-12 text-center text-zinc-500">
          <span class="material-symbols-outlined text-5xl opacity-20 mb-2">phone_iphone</span>
          <p class="font-bold">Không tìm thấy thiết bị iOS nào khớp với bộ lọc.</p>
        </div>

        <div class="p-4 bg-surface-container/20 flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-glass-stroke">
          <p id="devicesShowCount" class="text-xs text-text-dim font-label-caps font-bold">HIỂN THỊ 0 TRÊN TỔNG SỐ 0 THIẾT BỊ</p>
          <div id="devicesPagination" class="flex items-center gap-4">
            <span id="devicesPaginationInfo" class="text-xs text-zinc-400 font-bold uppercase">Trang 1 / 1</span>
            <div class="flex gap-2">
              <button id="devicesPrevBtn" class="px-3 py-1.5 bg-zinc-950 border border-glass-stroke text-zinc-400 hover:text-white rounded-lg text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Trước</button>
              <button id="devicesNextBtn" class="px-3 py-1.5 bg-zinc-950 border border-glass-stroke text-zinc-400 hover:text-white rounded-lg text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Sau</button>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- TAB 2: CERTS MANAGER -->
    <div id="tabCertsPanel" class="space-y-6 hidden">
      <!-- Certificate Stats -->
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="glass-panel p-6 rounded-3xl relative overflow-hidden">
          <p class="text-[10px] text-zinc-500 font-bold uppercase tracking-wider">Tổng số Certificate</p>
          <span class="text-3xl font-black text-white mt-1 block">12</span>
        </div>
        <div class="glass-panel p-6 rounded-3xl relative overflow-hidden">
          <p class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider">Chứng chỉ hợp lệ</p>
          <span class="text-3xl font-black text-emerald-400 mt-1 block">08</span>
        </div>
        <div class="glass-panel p-6 rounded-3xl border border-error/30 relative overflow-hidden">
          <p class="text-[10px] text-error font-bold uppercase tracking-wider">Sắp hết hạn</p>
          <span class="text-3xl font-black text-error mt-1 block">03</span>
        </div>
      </section>

      <!-- Cert Cards Grid -->
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Certificate Card 1 -->
        <div class="glass-panel p-6 rounded-2xl relative overflow-hidden border border-glass-stroke hover:border-primary/50 transition-all duration-300">
          <!-- Overlay: Under Development -->
          <div class="absolute inset-0 bg-black/80 z-20 flex flex-col items-center justify-center gap-2 cursor-not-allowed group/dev" data-txatooltip="Chứng chỉ Apple (.p12) đang được phát triển">
            <div class="w-12 h-12 rounded-full bg-red-500/20 border border-red-500/30 flex items-center justify-center text-red-500 transition-all duration-300 group-hover/dev:scale-110">
              <span class="material-symbols-outlined text-2xl font-bold">close</span>
            </div>
            <span class="text-[10px] font-bold text-red-400 font-label-caps tracking-wider">ĐANG PHÁT TRIỂN</span>
          </div>
          <span class="absolute top-4 right-4 px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[9px] font-bold uppercase">HỢP LỆ</span>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-xl">badge</span>
            </div>
            <div>
              <h4 class="font-bold text-white text-sm">Apple Distribution: DongPhim Ltd.</h4>
              <p class="text-[10px] text-zinc-500 font-mono mt-0.5">ID: W87A...92KL</p>
            </div>
          </div>

          <div class="mt-6 space-y-3">
            <div class="flex justify-between text-xs">
              <span class="text-zinc-500">Ngày hết hạn:</span>
              <span class="font-medium text-white">12 Th04, 2025</span>
            </div>
            <div class="w-full bg-zinc-950 border border-glass-stroke/40 rounded-full h-1.5 overflow-hidden">
              <div class="bg-primary h-full w-3/4 rounded-full"></div>
            </div>
            <div class="flex justify-between items-center pt-2 text-xs">
              <button class="text-primary hover:underline font-bold flex items-center gap-1 cursor-pointer">
                <span class="material-symbols-outlined text-sm">download</span> Tải về .p12
              </button>
              <button class="text-zinc-500 hover:text-error transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-sm">delete</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Certificate Card 2 -->
        <div class="glass-panel p-6 rounded-2xl relative overflow-hidden border border-error/20 bg-error/5 hover:border-error/50 transition-all duration-300">
          <!-- Overlay: Under Development -->
          <div class="absolute inset-0 bg-black/80 z-20 flex flex-col items-center justify-center gap-2 cursor-not-allowed group/dev" data-txatooltip="Chứng chỉ Apple (.p12) đang được phát triển">
            <div class="w-12 h-12 rounded-full bg-red-500/20 border border-red-500/30 flex items-center justify-center text-red-500 transition-all duration-300 group-hover/dev:scale-110">
              <span class="material-symbols-outlined text-2xl font-bold">close</span>
            </div>
            <span class="text-[10px] font-bold text-red-400 font-label-caps tracking-wider">ĐANG PHÁT TRIỂN</span>
          </div>
          <span class="absolute top-4 right-4 px-2 py-0.5 rounded bg-error/10 text-error border border-error/20 text-[9px] font-bold uppercase animate-pulse">SẮP HẾT HẠN</span>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-error/10 border border-error/20 flex items-center justify-center text-error">
              <span class="material-symbols-outlined text-xl">warning</span>
            </div>
            <div>
              <h4 class="font-bold text-white text-sm">Developer ID: Tran Van A</h4>
              <p class="text-[10px] text-zinc-500 font-mono mt-0.5">ID: BX12...L33P</p>
            </div>
          </div>
          <div class="mt-6 space-y-3">
            <div class="flex justify-between text-xs">
              <span class="text-zinc-500">Ngày hết hạn:</span>
              <span class="font-bold text-error">15 Th12, 2024</span>
            </div>
            <div class="w-full bg-zinc-950 border border-glass-stroke/40 rounded-full h-1.5 overflow-hidden">
              <div class="bg-error h-full w-[92%] rounded-full"></div>
            </div>
            <div class="flex justify-between items-center pt-2 text-xs">
              <button class="text-primary hover:underline font-bold cursor-pointer">Gia hạn ngay</button>
              <button class="text-zinc-500 hover:text-error transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-sm">delete</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Add Cert Button Skeleton -->
        <div class="glass-panel border-dashed border-2 border-glass-stroke p-6 rounded-2xl flex flex-col items-center justify-center gap-3 hover:border-primary group cursor-pointer transition-all relative overflow-hidden">
          <!-- Overlay: Under Development -->
          <div class="absolute inset-0 bg-black/80 z-20 flex flex-col items-center justify-center gap-2 cursor-not-allowed group/dev" data-txatooltip="Tính năng thêm chứng chỉ mới đang được phát triển">
            <div class="w-12 h-12 rounded-full bg-red-500/20 border border-red-500/30 flex items-center justify-center text-red-500 transition-all duration-300 group-hover/dev:scale-110">
              <span class="material-symbols-outlined text-2xl font-bold">close</span>
            </div>
            <span class="text-[10px] font-bold text-red-400 font-label-caps tracking-wider">ĐANG PHÁT TRIỂN</span>
          </div>
          <div class="w-10 h-10 rounded-full bg-zinc-950 border border-glass-stroke flex items-center justify-center text-zinc-500 group-hover:text-primary group-hover:scale-110 transition-all">
            <span class="material-symbols-outlined">add</span>
          </div>
          <p class="font-bold text-xs text-zinc-500 group-hover:text-primary transition-colors">Thêm Certificate mới</p>
        </div>
      </section>
    </div>
  </div>

  <!-- Device Detail Modal Dialog (Hidden by default) -->
  <div id="deviceDetailModal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <!-- Backdrop overlay -->
    <div id="modalBackdrop" class="absolute inset-0 bg-black/75 backdrop-blur-sm cursor-pointer"></div>
    <!-- Modal container -->
    <div class="glass-panel w-full max-w-2xl rounded-3xl overflow-hidden border border-glass-stroke shadow-2xl relative z-10 mx-4 max-h-[90vh] flex flex-col">
      <div class="px-6 py-4 border-b border-glass-stroke flex justify-between items-center bg-zinc-900/40">
        <div class="flex items-center gap-2 text-primary">
          <span class="material-symbols-outlined">smartphone</span>
          <h3 class="font-bold text-base text-white">Chi tiết thiết bị iOS đăng ký</h3>
        </div>
        <button id="closeModalBtn" class="text-zinc-400 hover:text-white transition-colors cursor-pointer">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      
      <div class="p-6 overflow-y-auto space-y-6 flex-1 text-xs">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Left Column -->
          <div class="space-y-4">
            <div class="p-3.5 bg-zinc-950/60 border border-glass-stroke/40 rounded-xl">
              <span class="text-[10px] text-zinc-500 font-bold block mb-1 uppercase">Tên thiết bị</span>
              <p id="modalDeviceName" class="text-white font-bold text-sm">-</p>
            </div>
            <div class="p-3.5 bg-zinc-950/60 border border-glass-stroke/40 rounded-xl">
              <span class="text-[10px] text-zinc-500 font-bold block mb-1 uppercase">Dòng máy & Model</span>
              <p id="modalDeviceProduct" class="text-white font-bold text-sm">-</p>
            </div>
            <div class="p-3.5 bg-zinc-950/60 border border-glass-stroke/40 rounded-xl">
              <span class="text-[10px] text-zinc-500 font-bold block mb-1 uppercase">Phiên bản iOS</span>
              <p id="modalDeviceVersion" class="text-primary font-bold text-sm">-</p>
            </div>
            <div class="p-3.5 bg-zinc-950/60 border border-glass-stroke/40 rounded-xl">
              <span class="text-[10px] text-zinc-500 font-bold block mb-1 uppercase">Mã UDID Thiết bị</span>
              <div class="flex justify-between items-center">
                <p id="modalDeviceUdid" class="text-white font-mono break-all font-bold pr-2 cursor-pointer hover:text-primary transition-colors"></p>
                <button id="modalCopyUdidBtn" class="text-zinc-500 hover:text-white transition-colors shrink-0">
                  <span class="material-symbols-outlined text-sm">content_copy</span>
                </button>
              </div>
            </div>
          </div>
          <!-- Right Column -->
          <div class="space-y-4">
            <div class="p-3.5 bg-zinc-950/60 border border-glass-stroke/40 rounded-xl">
              <span class="text-[10px] text-zinc-500 font-bold block mb-1 uppercase">Mã IMEI (Nếu trích xuất)</span>
              <p id="modalDeviceImei" class="text-white font-mono font-bold">-</p>
            </div>
            <div class="p-3.5 bg-zinc-950/60 border border-glass-stroke/40 rounded-xl">
              <span class="text-[10px] text-zinc-500 font-bold block mb-1 uppercase">Địa chỉ MAC Wifi (en0)</span>
              <p id="modalDeviceMac" class="text-white font-mono font-bold">-</p>
            </div>
            <div class="p-3.5 bg-zinc-950/60 border border-glass-stroke/40 rounded-xl">
              <span class="text-[10px] text-zinc-500 font-bold block mb-1 uppercase">Thời gian Kích hoạt (Cài đặt)</span>
              <p id="modalDeviceInstalledAt" class="text-emerald-400 font-bold">-</p>
            </div>
            <div class="p-3.5 bg-zinc-950/60 border border-glass-stroke/40 rounded-xl">
              <span class="text-[10px] text-zinc-500 font-bold block mb-1 uppercase">Địa chỉ IP Yêu cầu</span>
              <p id="modalDeviceIp" class="text-pink-400 font-bold">-</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="px-6 py-4 border-t border-glass-stroke flex justify-end gap-3 bg-zinc-900/20">
        <button id="modalCloseBtn" class="px-4 py-2 border border-glass-stroke hover:bg-white/5 text-zinc-300 font-bold rounded-xl transition-all cursor-pointer text-xs">
          Đóng bảng
        </button>
        <button id="modalApproveBtn" class="px-4 py-2 bg-emerald-500 hover:brightness-110 text-slate-950 font-bold rounded-xl transition-all cursor-pointer text-xs flex items-center gap-1.5 shadow-lg shadow-emerald-500/10">
          <span class="material-symbols-outlined text-sm">check_circle</span>
          <span>Phê duyệt ngay</span>
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      // Mappings
      const IOS_DEVICE_MAP = {
        'iPhone10,3': 'iPhone X',
        'iPhone10,6': 'iPhone X',
        'iPhone11,2': 'iPhone XS',
        'iPhone11,4': 'iPhone XS Max',
        'iPhone11,6': 'iPhone XS Max',
        'iPhone11,8': 'iPhone XR',
        'iPhone12,1': 'iPhone 11',
        'iPhone12,3': 'iPhone 11 Pro',
        'iPhone12,5': 'iPhone 11 Pro Max',
        'iPhone12,8': 'iPhone SE (2nd Gen)',
        'iPhone13,1': 'iPhone 12 mini',
        'iPhone13,2': 'iPhone 12',
        'iPhone13,3': 'iPhone 12 Pro',
        'iPhone13,4': 'iPhone 12 Pro Max',
        'iPhone14,4': 'iPhone 13 mini',
        'iPhone14,5': 'iPhone 13',
        'iPhone14,6': 'iPhone 13 Pro',
        'iPhone14,7': 'iPhone 13 Pro Max',
        'iPhone14,8': 'iPhone SE (3rd Gen)',
        'iPhone15,2': 'iPhone 14 Pro',
        'iPhone15,3': 'iPhone 14 Pro Max',
        'iPhone15,4': 'iPhone 13',
        'iPhone15,5': 'iPhone 14 Plus',
        'iPhone16,1': 'iPhone 15',
        'iPhone16,2': 'iPhone 15 Plus',
        'iPhone16,5': 'iPhone 15 Pro',
        'iPhone16,6': 'iPhone 15 Pro Max',
        'iPhone17,1': 'iPhone 16',
        'iPhone17,2': 'iPhone 16 Plus',
        'iPhone17,3': 'iPhone 16 Pro',
        'iPhone17,4': 'iPhone 16 Pro Max',
        'iPad14,3': 'iPad Pro M2',
      };

      const IOS_VERSION_MAP = {
        '20H392': '17.2',
        '21B74': '17.3',
        '21D62': '17.4',
        '21E72': '17.5',
        '22A5282m': '18.0',
        '22A5297f': '18.0.1',
        '22A5307i': '18.1',
        '22B82': '18.2',
        '22C150': '18.3',
      };

      const getDeviceName = (product) => {
        if (!product) return 'Unknown Device';
        return IOS_DEVICE_MAP[product] || product;
      };

      const getIOSVersion = (version) => {
        if (!version) return 'Unknown';
        if (/^\d+\.\d+(\.\d+)?$/.test(version)) {
          return version;
        }
        return IOS_VERSION_MAP[version] || version;
      };

      const showToast = (text, type = 'success') => {
        const t = window.showGlobalToast || window.txatoast || window.txaToast;
        if (t) {
          if (typeof t === 'function') t(text, type);
          else if (typeof t.show === 'function') t.show(text, type);
        } else {
          alert(`${type.toUpperCase()}: ${text}`);
        }
      };

      // Seed data
      const seedIosDevices = [
        {
          udid: '00008130-001A25E81A02801F',
          device_name: "Minh's iPhone 15 Pro Max",
          product: 'iPhone16,6',
          version: '22B82',
          status: 'approved',
          metadata: {
            imei: '359281102938475',
            mac_address: '00:25:96:FF:FE:12:34:56',
            ip: '192.168.1.5',
            installed_at: '2026-06-15T08:30:00.000Z'
          },
          created_at: '2026-06-15T08:30:00.000Z',
          updated_at: '2026-06-15T08:30:00.000Z'
        },
        {
          udid: '00008103-000E089C0C30002F',
          device_name: "Huy's iPad Pro M2",
          product: 'iPad14,3',
          version: '21E72',
          status: 'approved',
          metadata: {
            imei: 'Không trích xuất được do chính sách bảo mật mới',
            mac_address: 'A4:D1:D2:C3:B4:A5',
            ip: '192.168.1.12',
            installed_at: '2026-06-16T14:15:00.000Z'
          },
          created_at: '2026-06-16T14:15:00.000Z',
          updated_at: '2026-06-16T14:15:00.000Z'
        },
        {
          udid: '00008120-000E089C0C30002E',
          device_name: "Linh's iPhone 14 Pro",
          product: 'iPhone15,2',
          version: '21D62',
          status: 'pending',
          metadata: {
            imei: '359281102938471',
            mac_address: 'B1:C2:D3:E4:F5:66',
            ip: '115.79.4.12',
            installed_at: '2026-06-20T01:10:00.000Z'
          },
          created_at: '2026-06-20T01:10:00.000Z',
          updated_at: '2026-06-20T01:10:00.000Z'
        },
        {
          udid: '00008020-001614C90C83002E',
          device_name: 'Unknown iPhone XS',
          product: 'iPhone11,2',
          version: '20H392',
          status: 'blocked',
          metadata: {
            imei: '359281102938479',
            mac_address: 'C1:D2:E3:F4:A5:B6',
            ip: '171.244.12.80',
            installed_at: '2026-06-18T10:05:00.000Z'
          },
          created_at: '2026-06-18T10:05:00.000Z',
          updated_at: '2026-06-18T10:05:00.000Z'
        }
      ];

      function getDevices() {
        const stored = localStorage.getItem('txa_ios_devices');
        if (!stored) {
          localStorage.setItem('txa_ios_devices', JSON.stringify(seedIosDevices));
          return seedIosDevices;
        }
        try {
          return JSON.parse(stored);
        } catch (e) {
          return seedIosDevices;
        }
      }

      function saveDevices(list) {
        localStorage.setItem('txa_ios_devices', JSON.stringify(list));
      }

      function initIosManagement() {
        const tabDevicesBtn = document.getElementById('tabDevicesBtn');
        const tabCertsBtn = document.getElementById('tabCertsBtn');
        const tabDevicesPanel = document.getElementById('tabDevicesPanel');
        const tabCertsPanel = document.getElementById('tabCertsPanel');
        
        if (!tabDevicesBtn) return; // Exit if not on this page

        // Tab logic
        tabDevicesBtn.onclick = () => {
          tabDevicesBtn.className = "pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer flex items-center gap-2";
          tabCertsBtn.className = "pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer flex items-center gap-2";
          tabDevicesPanel.classList.remove('hidden');
          tabCertsPanel.classList.add('hidden');
        };

        tabCertsBtn.onclick = () => {
          tabCertsBtn.className = "pb-3 text-sm font-bold border-b-2 border-primary text-primary transition-all cursor-pointer flex items-center gap-2";
          tabDevicesBtn.className = "pb-3 text-sm font-bold border-b-2 border-transparent text-zinc-400 hover:text-white transition-all cursor-pointer flex items-center gap-2";
          tabCertsPanel.classList.remove('hidden');
          tabDevicesPanel.classList.add('hidden');
        };

        // DOM elements
        const statTotal = document.getElementById('statTotalDevices');
        const statApproved = document.getElementById('statApprovedDevices');
        const statPending = document.getElementById('statPendingDevices');
        const statBlocked = document.getElementById('statBlockedDevices');
        const devicesCountText = document.getElementById('devicesCountText');
        const searchInput = document.getElementById('deviceSearchInput');
        const statusFilter = document.getElementById('deviceStatusFilter');
        const tableBody = document.getElementById('devicesTableBody');
        const emptyDevices = document.getElementById('emptyDevices');
        const showCountText = document.getElementById('devicesShowCount');
        const paginationInfo = document.getElementById('devicesPaginationInfo');
        const prevBtn = document.getElementById('devicesPrevBtn');
        const nextBtn = document.getElementById('devicesNextBtn');

        const detailModal = document.getElementById('deviceDetailModal');
        const modalCloseBtn = document.getElementById('modalCloseBtn');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const modalCloseBackdrop = document.getElementById('modalBackdrop');
        const modalApproveBtn = document.getElementById('modalApproveBtn');
        const modalCopyUdidBtn = document.getElementById('modalCopyUdidBtn');

        const mName = document.getElementById('modalDeviceName');
        const mProduct = document.getElementById('modalDeviceProduct');
        const mVersion = document.getElementById('modalDeviceVersion');
        const mUdid = document.getElementById('modalDeviceUdid');
        const mImei = document.getElementById('modalDeviceImei');
        const mMac = document.getElementById('modalDeviceMac');
        const mInstalledAt = document.getElementById('modalDeviceInstalledAt');
        const mIp = document.getElementById('modalDeviceIp');

        let currentPage = 1;
        const itemsPerPage = 10;
        let filteredList = [];
        let currentSelectedDevice = null;

        window.viewDeviceDetails = function(udid) {
          const list = getDevices();
          const device = list.find(d => d.udid === udid);
          if (!device) return;

          currentSelectedDevice = device;

          mName.textContent = device.device_name || 'N/A';
          mProduct.textContent = getDeviceName(device.product);
          mVersion.textContent = `iOS ${getIOSVersion(device.version)}`;
          mUdid.textContent = device.udid;
          
          mImei.textContent = device.metadata?.imei || 'Không trích xuất được do chính sách bảo mật mới';
          mMac.textContent = device.metadata?.mac_address || 'Trống';
          
          const installDate = device.metadata?.installed_at 
            ? new Date(device.metadata.installed_at).toLocaleString('vi-VN') 
            : device.created_at 
              ? new Date(device.created_at).toLocaleString('vi-VN') 
              : 'Không rõ';
          
          mInstalledAt.textContent = installDate;
          mIp.textContent = device.metadata?.ip || 'Không lưu';

          if (device.status !== 'approved') {
            modalApproveBtn.classList.remove('hidden');
          } else {
            modalApproveBtn.classList.add('hidden');
          }

          detailModal.classList.remove('hidden');
        };

        const closeModal = () => {
          detailModal.classList.add('hidden');
          currentSelectedDevice = null;
        };

        modalCloseBtn.onclick = closeModal;
        closeModalBtn.onclick = closeModal;
        modalCloseBackdrop.onclick = closeModal;

        modalApproveBtn.onclick = () => {
          if (currentSelectedDevice) {
            window.changeDeviceStatus(currentSelectedDevice.udid, 'approved');
            closeModal();
          }
        };

        modalCopyUdidBtn.onclick = () => {
          if (currentSelectedDevice) {
            window.copyDeviceUdid(currentSelectedDevice.udid);
          }
        };

        window.copyDeviceUdid = function(udid) {
          navigator.clipboard.writeText(udid).then(() => {
            showToast('Đã sao chép UDID vào bộ nhớ tạm!', 'success');
          }).catch(err => {
            showToast('Không thể sao chép UDID: ' + err.message, 'error');
          });
        };

        window.changeDeviceStatus = function(udid, status) {
          const list = getDevices();
          const deviceIndex = list.findIndex(d => d.udid === udid);
          if (deviceIndex === -1) return;

          const device = list[deviceIndex];
          device.status = status;
          device.updated_at = new Date().toISOString();
          
          saveDevices(list);
          showToast(`Đã chuyển trạng thái thiết bị sang: ${status === 'approved' ? 'Phê duyệt' : status === 'blocked' ? 'Chặn' : 'Chờ duyệt'}`, 'success');
          
          renderData();
        };

        window.deleteDevice = function(udid) {
          const list = getDevices();
          const device = list.find(d => d.udid === udid);
          const name = device ? (device.device_name || 'thiết bị') : 'thiết bị';

          const performDelete = () => {
            const filtered = list.filter(d => d.udid !== udid);
            saveDevices(filtered);
            showToast('Đã xóa thiết bị thành công!', 'success');
            renderData();
          };

          if (window.txamodal) {
            window.txamodal.show({
              title: 'Xóa thiết bị iOS',
              message: `Bạn có chắc chắn muốn xóa vĩnh viễn thiết bị <strong>${name}</strong> (${udid}) khỏi hệ thống?`,
              type: 'danger',
              confirmText: 'Xóa vĩnh viễn',
              cancelText: 'Hủy bỏ',
              onConfirm: performDelete
            });
          } else if (confirm('Bạn có chắc chắn muốn xóa vĩnh viễn thiết bị này?')) {
            performDelete();
          }
        };

        function displayPage(page) {
          if (!tableBody) return;

          const totalItems = filteredList.length;
          const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

          if (page > totalPages) page = totalPages;
          if (page < 1) page = 1;
          currentPage = page;

          const startIndex = (currentPage - 1) * itemsPerPage;
          const endIndex = startIndex + itemsPerPage;
          const paginatedList = filteredList.slice(startIndex, endIndex);

          if (paginatedList.length === 0) {
            tableBody.innerHTML = '';
            emptyDevices.classList.remove('hidden');
            showCountText.textContent = 'HIỂN THỊ 0 THIẾT BỊ';
            paginationInfo.textContent = 'Trang 1 / 1';
            prevBtn.disabled = true;
            nextBtn.disabled = true;
            return;
          }

          emptyDevices.classList.add('hidden');

          tableBody.classList.remove('animate-fade-in');
          void tableBody.offsetWidth;
          tableBody.classList.add('animate-fade-in');

          tableBody.innerHTML = paginatedList.map(item => {
            const displayUdid = item.udid.length > 20 ? `${item.udid.substring(0, 20)}...` : item.udid;
            const installDate = item.metadata?.installed_at 
              ? new Date(item.metadata.installed_at).toLocaleString('vi-VN') 
              : item.created_at 
                ? new Date(item.created_at).toLocaleString('vi-VN') 
                : 'Không rõ';

            let statusChip = '';
            if (item.status === 'approved') {
              statusChip = `<span class="px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold">ĐÃ DUYỆT</span>`;
            } else if (item.status === 'blocked') {
              statusChip = `<span class="px-2 py-1 rounded bg-red-500/10 text-red-400 border border-red-500/20 text-[10px] font-bold">BỊ CHẶN</span>`;
            } else {
              statusChip = `<span class="px-2 py-1 rounded bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 text-[10px] font-bold">CHỜ DUYỆT</span>`;
            }

            return `
              <tr class="hover:bg-white/5 transition-colors group">
                <td class="px-6 py-4 font-semibold text-white">
                  <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-zinc-400">smartphone</span>
                    <span>${item.device_name || 'Unknown Device'}</span>
                  </div>
                </td>
                <td class="px-6 py-4 font-mono text-zinc-400">
                  <div class="flex items-center gap-1.5">
                    <span class="cursor-pointer hover:text-primary transition-colors" onclick="copyDeviceUdid('${item.udid}')" data-txatooltip="Sao chép UDID">${displayUdid}</span>
                    <button onclick="copyDeviceUdid('${item.udid}')" class="opacity-0 group-hover:opacity-100 transition-opacity text-zinc-500 hover:text-white" data-txatooltip="Sao chép">
                      <span class="material-symbols-outlined text-xs">content_copy</span>
                    </button>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <p class="font-bold text-white">${getDeviceName(item.product)}</p>
                  <p class="text-[10px] text-zinc-500 font-medium">iOS ${getIOSVersion(item.version)}</p>
                </td>
                <td class="px-6 py-4 text-zinc-400 font-medium">
                  <div class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-xs text-primary">calendar_today</span>
                    <span>${installDate}</span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  ${statusChip}
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex gap-2 justify-end">
                    <button onclick="viewDeviceDetails('${item.udid}')" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center hover:text-primary hover:border-primary/50 transition-colors cursor-pointer" data-txatooltip="Xem chi tiết">
                      <span class="material-symbols-outlined text-sm">visibility</span>
                    </button>
                    ${item.status !== 'approved' ? `
                      <button onclick="changeDeviceStatus('${item.udid}', 'approved')" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center text-emerald-400 hover:text-emerald-500 hover:border-emerald-500/50 transition-colors cursor-pointer" data-txatooltip="Phê duyệt">
                        <span class="material-symbols-outlined text-sm">check_circle</span>
                      </button>
                    ` : ''}
                    ${item.status !== 'blocked' ? `
                      <button onclick="changeDeviceStatus('${item.udid}', 'blocked')" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center text-yellow-500 hover:text-yellow-600 hover:border-yellow-500/50 transition-colors cursor-pointer" data-txatooltip="Chặn">
                        <span class="material-symbols-outlined text-sm">block</span>
                      </button>
                    ` : ''}
                    <button onclick="deleteDevice('${item.udid}')" class="w-8 h-8 rounded-lg border border-glass-stroke bg-zinc-950 flex items-center justify-center text-red-400 hover:text-red-500 hover:border-red-500/50 transition-colors cursor-pointer" data-txatooltip="Xóa">
                      <span class="material-symbols-outlined text-sm">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            `;
          }).join('');

          showCountText.textContent = `HIỂN THỊ ${paginatedList.length} TRÊN TỔNG SỐ ${filteredList.length} THIẾT BỊ`;
          paginationInfo.textContent = `Trang ${currentPage} / ${totalPages}`;
          prevBtn.disabled = (currentPage === 1);
          nextBtn.disabled = (currentPage === totalPages);
        }

        function renderData() {
          const list = getDevices();

          const total = list.length;
          const approved = list.filter(d => d.status === 'approved').length;
          const pending = list.filter(d => d.status === 'pending').length;
          const blocked = list.filter(d => d.status === 'blocked').length;

          statTotal.textContent = total;
          statApproved.textContent = approved;
          statPending.textContent = pending;
          statBlocked.textContent = blocked;
          devicesCountText.textContent = total;

          const search = searchInput.value.trim().toLowerCase();
          const status = statusFilter.value;

          filteredList = list.filter(d => {
            const matchSearch = (d.udid || '').toLowerCase().includes(search) ||
                                (d.device_name || '').toLowerCase().includes(search) ||
                                (d.product || '').toLowerCase().includes(search);
            
            const matchStatus = status === 'all' || d.status === status;
            
            return matchSearch && matchStatus;
          });

          displayPage(1);
        }

        searchInput.oninput = renderData;
        statusFilter.onchange = renderData;

        prevBtn.onclick = () => {
          if (currentPage > 1) {
            displayPage(currentPage - 1);
          }
        };

        nextBtn.onclick = () => {
          const totalPages = Math.ceil(filteredList.length / itemsPerPage) || 1;
          if (currentPage < totalPages) {
            displayPage(currentPage + 1);
          }
        };

        renderData();
      }

      // Run on DOM loaded or page-load
      initIosManagement();
      document.addEventListener('astro:page-load', initIosManagement);
    })();
  </script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
  </style>
</AdminLayout>
