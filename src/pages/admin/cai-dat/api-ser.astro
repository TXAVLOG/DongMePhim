---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { SettingService } from '../../../services/SettingService';

const settings = await SettingService.getSettings();
let activeTab = 'api-ser';
import SettingsSidebar from '../../../components/admin/SettingsSidebar.astro';
---

<AdminLayout title="Cài đặt hệ thống - API Security">
  <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 mt-4 gap-4">
    <div>
      <h2 class="font-headline-lg text-on-surface text-3xl">Cấu hình hệ thống</h2>
      <p class="text-text-dim text-body-main mt-1">Quản lý toàn bộ tham số cấu hình của ứng dụng.</p>
    </div>
    <div class="flex items-center gap-4">
      <button id="save-settings-btn" class="px-6 py-2 bg-primary text-slate-950 rounded-full font-label-caps font-bold hover:brightness-110 transition-all cursor-pointer flex items-center gap-2 border-none">
        <span class="material-symbols-outlined text-sm">save</span>
        Lưu thay đổi
      </button>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Cài đặt Navigation Sidebar -->
    <SettingsSidebar activeTab="api-ser" />

    <!-- Cài đặt Panel Content -->
    <div class="lg:col-span-3 glass-panel rounded-3xl p-8">
      <div id="tab-security" class="space-y-6">
        <h3 class="text-title-md border-b border-glass-stroke pb-4 mb-6 text-xl font-bold">API Security (AES-256-GCM)</h3>
        <div class="bg-primary/10 border border-primary/20 rounded-xl p-4 mb-6">
          <p class="text-xs text-primary font-body-main">Lưu ý: Bật tính năng này sẽ mã hóa toàn bộ dữ liệu trả về của API thành định dạng <code>&#123;"d": "...", "v": 1&#125;</code>. App Flutter phải được trang bị khóa giải mã tương ứng.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-label-caps text-text-dim">Mã hóa TXA Payload</label>
            <div class="flex items-center gap-3">
              <input type="checkbox" id="security-encrypt-enable" checked={settings.general.api_encrypt_enable} class="w-5 h-5 accent-primary bg-surface-container border-glass-stroke" />
              <span class="text-sm">Bật mã hóa (api_encrypt_enable)</span>
            </div>
          </div>
          <div class="space-y-2 md:col-span-2">
            <label class="text-xs font-label-caps text-text-dim">Khóa giải mã API (api_encrypt_pass)</label>
            <input type="password" id="security-encrypt-pass" value={settings.general.api_encrypt_pass || ''} class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ serverSettings: settings }}>
    (function() {
      // Hydrate form fields client-side
      function hydrateFromLocalStorage() {
        let stored = null;
        try {
          const raw = localStorage.getItem('txa_site_settings');
          if (raw) stored = JSON.parse(raw);
        } catch (e) {}
        if (!stored) return;

        const s = stored;
        setChecked('security-encrypt-enable', s.general?.api_encrypt_enable);
        setVal('security-encrypt-pass', s.general?.api_encrypt_pass);
      }

      function setVal(id, val) { const el = document.getElementById(id); if (el && val !== undefined && val !== null) el.value = val; }
      function setChecked(id, val) { const el = document.getElementById(id); if (el && val !== undefined) el.checked = !!val; }

      // Save handler
      document.getElementById('save-settings-btn')?.addEventListener('click', () => {
        let current = {};
        try {
          const stored = localStorage.getItem('txa_site_settings');
          current = stored ? JSON.parse(stored) : serverSettings;
        } catch (e) { current = serverSettings; }

        const updatedSettings = {
          ...current,
          general: {
            ...current.general,
            api_encrypt_enable: document.getElementById('security-encrypt-enable')?.checked || false,
            api_encrypt_pass: document.getElementById('security-encrypt-pass')?.value || '',
          }
        };

        localStorage.setItem('txa_site_settings', JSON.stringify(updatedSettings));

        if (window.showGlobalToast) {
          window.showGlobalToast('Lưu cấu hình hệ thống thành công!', 'success');
        } else {
          alert('Lưu cấu hình hệ thống thành công!');
        }

        setTimeout(() => { window.location.reload(); }, 800);
      });

      // Init
      hydrateFromLocalStorage();
      document.addEventListener('astro:page-load', hydrateFromLocalStorage);
    })();
  </script>
</AdminLayout>
