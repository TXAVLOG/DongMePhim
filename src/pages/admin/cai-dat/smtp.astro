---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { SettingService } from "../../../services/SettingService";

const settings = await SettingService.getSettings();
let activeTab = "smtp";
---

<AdminLayout title="Cài đặt hệ thống - SMTP Mail">
  <header
    class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 mt-4 gap-4"
  >
    <div>
      <h2 class="font-headline-lg text-on-surface text-3xl">
        Cấu hình hệ thống
      </h2>
      <p class="text-text-dim text-body-main mt-1">
        Quản lý toàn bộ tham số cấu hình của ứng dụng.
      </p>
    </div>
    <div class="flex items-center gap-4">
      <button
        id="btn-smtp-test"
        class="px-5 py-2 bg-white/5 border border-glass-stroke text-zinc-300 rounded-full font-label-caps font-bold hover:bg-white/10 transition-all cursor-pointer flex items-center gap-1.5 text-xs"
      >
        <span class="material-symbols-outlined text-sm">mail</span>
        Gửi email test
      </button>
      <button
        id="save-settings-btn"
        class="px-6 py-2 bg-primary text-slate-950 rounded-full font-label-caps font-bold hover:brightness-110 transition-all cursor-pointer flex items-center gap-2 border-none"
      >
        <span class="material-symbols-outlined text-sm">save</span>
        Lưu thay đổi
      </button>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Cài đặt Navigation Sidebar -->
    <div class="lg:col-span-1 flex flex-col gap-2">
      <a
        href="/admin/cai-dat"
        class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${activeTab === "general" ? "sidebar-active text-primary" : "hover:bg-white/5 text-text-dim"}`}
      >
        <span class="material-symbols-outlined">settings</span> Chung
      </a>
      <a
        href="/admin/cai-dat/api-ser"
        class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${activeTab === "api-ser" ? "sidebar-active text-primary" : "hover:bg-white/5 text-text-dim"}`}
      >
        <span class="material-symbols-outlined">security</span> API Security
      </a>
      <a
        href="/admin/cai-dat/app-mobile"
        class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${activeTab === "app-mobile" ? "sidebar-active text-primary" : "hover:bg-white/5 text-text-dim"}`}
      >
        <span class="material-symbols-outlined">smartphone</span> App Mobile
      </a>
      <a
        href="/admin/cai-dat/smtp"
        class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${activeTab === "smtp" ? "sidebar-active text-primary" : "hover:bg-white/5 text-text-dim"}`}
      >
        <span class="material-symbols-outlined">mail</span> SMTP Mail
      </a>
      <a
        href="/admin/cai-dat/telegram"
        class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${activeTab === "telegram" ? "sidebar-active text-primary" : "hover:bg-white/5 text-text-dim"}`}
      >
        <span class="material-symbols-outlined">send</span> Telegram
      </a>
      <a
        href="/admin/cai-dat/dang-ky"
        class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${activeTab === "dang-ky" ? "sidebar-active text-primary" : "hover:bg-white/5 text-text-dim"}`}
      >
        <span class="material-symbols-outlined">login</span> Đăng nhập & Đăng ký
      </a>
      <a
        href="/admin/cai-dat/social"
        class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${activeTab === "social" ? "sidebar-active text-primary" : "hover:bg-white/5 text-text-dim"}`}
      >
        <span class="material-symbols-outlined">share</span> Mạng xã hội
      </a>
      <a
        href="/admin/cai-dat/thanh-toan"
        class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${activeTab === "payment" ? "sidebar-active text-primary" : "hover:bg-white/5 text-text-dim"}`}
      >
        <span class="material-symbols-outlined">payments</span> Cấu hình Thanh toán
      </a>
      <a
        href="/admin/cai-dat/turnstile"
        class={`w-full text-left px-4 py-3 rounded-xl font-label-caps flex items-center gap-3 transition-colors cursor-pointer ${activeTab === "turnstile" ? "sidebar-active text-primary" : "hover:bg-white/5 text-text-dim"}`}
      >
        <span class="material-symbols-outlined">verified_user</span> Turnstile Captcha
      </a>
    </div>

    <!-- Cài đặt Panel Content -->
    <div class="lg:col-span-3 glass-panel rounded-3xl p-8">
      <div id="tab-smtp" class="space-y-6">
        <h3
          class="text-title-md border-b border-glass-stroke pb-4 mb-6 text-xl font-bold"
        >
          Cấu hình SMTP Mail (Gửi email hệ thống)
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim"
              >SMTP Host</label
            >
            <input
              type="text"
              id="smtp-host"
              value={settings.smtp?.smtp_host}
              class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white"
              placeholder="Ví dụ: smtp.gmail.com"
            />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim"
              >SMTP Port</label
            >
            <input
              type="number"
              id="smtp-port"
              value={settings.smtp?.smtp_port}
              class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white"
              placeholder="Ví dụ: 465 hoặc 587"
            />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim"
              >Giao thức bảo mật (smtp_secure)</label
            >
            <select
              id="smtp-secure"
              class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white"
            >
              <option
                value="SSL"
                selected={settings.smtp?.smtp_secure === "SSL"}
                >SSL (Khuyên dùng cho Port 465)</option
              >
              <option
                value="TLS"
                selected={settings.smtp?.smtp_secure === "TLS"}
                >TLS (Khuyên dùng cho Port 587)</option
              >
              <option
                value="NONE"
                selected={settings.smtp?.smtp_secure === "NONE"}
                >NONE (Không bảo mật)</option
              >
            </select>
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim"
              >Tài khoản SMTP (Email)</label
            >
            <input
              type="text"
              id="smtp-user"
              value={settings.smtp?.smtp_user}
              class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white"
              placeholder="email@domain.com"
            />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim"
              >Mật khẩu App SMTP (smtp_pass)</label
            >
            <input
              type="password"
              id="smtp-pass"
              value={settings.smtp?.smtp_pass}
              class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white font-mono"
            />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim"
              >Địa chỉ email gửi đi (From Email)</label
            >
            <input
              type="email"
              id="smtp-from-email"
              value={settings.smtp?.smtp_from_email}
              class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white"
              placeholder="noreply@domain.com"
            />
          </div>
          <div class="space-y-2">
            <label class="text-xs font-label-caps text-text-dim"
              >Tên hiển thị người gửi (From Name)</label
            >
            <input
              type="text"
              id="smtp-from-name"
              value={settings.smtp?.smtp_from_name}
              class="w-full bg-surface-container border border-glass-stroke rounded-xl px-4 py-2 focus:ring-1 focus:ring-primary focus:outline-none text-white"
              placeholder="DongMePhim System"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ serverSettings: settings }}>
    (function () {
      function hydrateFromLocalStorage() {
        let stored = null;
        try {
          const raw = localStorage.getItem("txa_site_settings");
          if (raw) stored = JSON.parse(raw);
        } catch (e) {}
        if (!stored) return;

        const s = stored;
        setVal("smtp-host", s.smtp?.smtp_host);
        setVal("smtp-port", s.smtp?.smtp_port);
        setSelect("smtp-secure", s.smtp?.smtp_secure);
        setVal("smtp-user", s.smtp?.smtp_user);
        setVal("smtp-pass", s.smtp?.smtp_pass);
        setVal("smtp-from-email", s.smtp?.smtp_from_email);
        setVal("smtp-from-name", s.smtp?.smtp_from_name);
      }

      function setVal(id, val) {
        const el = document.getElementById(id);
        if (el && val !== undefined && val !== null) el.value = val;
      }
      function setSelect(id, val) {
        const el = document.getElementById(id);
        if (el && val) el.value = val;
      }

      // Save handler
      document
        .getElementById("save-settings-btn")
        ?.addEventListener("click", () => {
          let current = {};
          try {
            const stored = localStorage.getItem("txa_site_settings");
            current = stored ? JSON.parse(stored) : serverSettings;
          } catch (e) {
            current = serverSettings;
          }

          const updatedSettings = {
            ...current,
            smtp: {
              smtp_host: document.getElementById("smtp-host")?.value || "",
              smtp_port:
                parseInt(document.getElementById("smtp-port")?.value) || 465,
              smtp_secure:
                document.getElementById("smtp-secure")?.value || "SSL",
              smtp_user: document.getElementById("smtp-user")?.value || "",
              smtp_pass: document.getElementById("smtp-pass")?.value || "",
              smtp_from_email:
                document.getElementById("smtp-from-email")?.value || "",
              smtp_from_name:
                document.getElementById("smtp-from-name")?.value || "",
            },
          };

          localStorage.setItem(
            "txa_site_settings",
            JSON.stringify(updatedSettings),
          );

          // Sync SMTP configuration status to sidebar nav checks
          if (window.showGlobalToast) {
            window.showGlobalToast(
              "Lưu cấu hình hệ thống thành công!",
              "success",
            );
          } else {
            alert("Lưu cấu hình hệ thống thành công!");
          }

          setTimeout(() => {
            window.location.reload();
          }, 800);
        });

      // SMTP TEST EMAIL
      document
        .getElementById("btn-smtp-test")
        ?.addEventListener("click", () => {
          const host = document.getElementById("smtp-host")?.value;
          const port = document.getElementById("smtp-port")?.value || "465";
          const secure = document.getElementById("smtp-secure")?.value || "SSL";
          const user = document.getElementById("smtp-user")?.value;
          const pass = document.getElementById("smtp-pass")?.value;
          const fromEmail = document.getElementById("smtp-from-email")?.value;
          const fromName =
            document.getElementById("smtp-from-name")?.value ||
            "DongMePhim Admin";
          const siteUrl = window.location.origin;

          if (!host || !user || !pass || !fromEmail) {
            if (window.showGlobalToast)
              window.showGlobalToast(
                "Vui lòng điền đầy đủ thông tin SMTP trước khi test!",
                "error",
              );
            return;
          }
          if (window.txamodal) {
            window.txamodal.show({
              title: "Gửi Email Kiểm Thử SMTP",
              message: `
              <div style="display:flex;flex-direction:column;gap:12px;min-width:300px">
                <p style="font-size:12px;color:#94a3b8">Nhập địa chỉ email nhận thư test:</p>
                <input type="email" id="smtp-test-email" placeholder="test@example.com" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:14px" />
              </div>
            `,
              type: "info",
              confirmText: "Gửi email test",
              cancelText: "Hủy bỏ",
              onConfirm: () => {
                const testTo = document
                  .getElementById("smtp-test-email")
                  ?.value.trim();
                if (!testTo) {
                  if (window.showGlobalToast)
                    window.showGlobalToast("Vui lòng nhập email!", "error");
                  return;
                }

                const year = new Date().getFullYear().toString();
                const sendTime = new Date().toLocaleString("vi-VN");
                const siteName =
                  serverSettings.general?.site_name || "DongMePhim";

                const templateHtml = `<!DOCTYPE html>
<html>
<body style="margin:0;padding:0;background-color:#09090b;color:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#09090b;padding:32px 16px;">
    <tr>
      <td align="center">
        <table width="100%" style="max-width:600px;background-color:#121214;border:1px solid #1f1f23;border-radius:24px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,0.5);" cellpadding="0" cellspacing="0">
          <tr>
            <td style="padding:40px 40px 20px;text-align:center;border-bottom:1px solid rgba(255,255,255,0.03);">
              <img src="${siteUrl}/favicon.png" alt="Logo" style="width:56px;height:56px;margin-bottom:16px;border-radius:12px;box-shadow:0 0 15px rgba(139,92,246,0.2);" />
              <h2 style="margin:0;font-size:24px;font-weight:800;color:#8b5cf6;letter-spacing:-0.5px;text-transform:uppercase;">${siteName} SMTP Test</h2>
            </td>
          </tr>
          <tr>
            <td style="padding:40px 40px 30px;">
              <h3 style="margin:0 0 16px;font-size:18px;font-weight:700;color:#ffffff;">Xin chào Admin,</h3>
              <p style="margin:0 0 20px;font-size:14px;color:#a1a1aa;line-height:1.6;">Đây là email kiểm tra kết nối từ hệ thống cấu hình SMTP của ${siteName}.</p>
              <div style="background-color:#18181b;border:1px solid #27272a;border-radius:16px;padding:20px;margin:24px 0;">
                <p style="margin:0 0 12px;font-size:13px;color:#8b5cf6;font-weight:bold;text-transform:uppercase;">Thông số kiểm thử:</p>
                <table width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;color:#a1a1aa;line-height:1.8;">
                  <tr><td width="35%">SMTP Host:</td><td style="color:#ffffff;">${host}</td></tr>
                  <tr><td>SMTP Port:</td><td style="color:#ffffff;">${port}</td></tr>
                  <tr><td>SMTP Secure:</td><td style="color:#ffffff;">${secure}</td></tr>
                  <tr><td>SMTP User:</td><td style="color:#ffffff;">${user}</td></tr>
                  <tr><td>Thời gian gửi:</td><td style="color:#ffffff;">${sendTime}</td></tr>
                </table>
              </div>
              <p style="margin:0;font-size:13px;color:#71717a;">Nếu email này gửi thành công, các tính năng gửi mã và link xác minh sẽ hoạt động bình thường trên hệ thống ${siteName}.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>`;

                const emailLog = {
                  id: "mail_" + Math.floor(Math.random() * 100000000),
                  time: new Date().toISOString(),
                  recipient: testTo,
                  sender: `${fromName} <${fromEmail}>`,
                  subject: "Kiểm tra cấu hình SMTP Mail thành công",
                  category: "SMTP Test",
                  status: "success",
                  responseCode: "250 2.0.0 OK Handshake Completed",
                  parameters: {
                    smtp_host: host,
                    smtp_port: port,
                    smtp_secure: secure,
                    smtp_user: user,
                  },
                  smtpConfig: {
                    host: host,
                    port: parseInt(port) || 465,
                    secure: secure,
                    user: user,
                  },
                  html: templateHtml,
                };

                try {
                  const logs = JSON.parse(
                    localStorage.getItem("txa_email_logs") || "[]",
                  );
                  logs.unshift(emailLog);
                  localStorage.setItem("txa_email_logs", JSON.stringify(logs));
                } catch (e) {}

                if (window.showGlobalToast)
                  window.showGlobalToast(
                    `Đã gửi email test tới ${testTo} thành công! (Lịch sử đã ghi nhận)`,
                    "success",
                  );
              },
            });
          }
        });

      // Init
      hydrateFromLocalStorage();
      document.addEventListener("astro:page-load", hydrateFromLocalStorage);
    })();
  </script>
</AdminLayout>
