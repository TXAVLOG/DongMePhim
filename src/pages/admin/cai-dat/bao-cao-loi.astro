---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Báo cáo lỗi">
  <!-- Top App Bar Content (Header) -->
  <header class="flex items-center justify-between mb-8 mt-4">
    <div>
      <h2 class="font-title-md text-title-md text-on-surface text-2xl">Quản lý Báo cáo lỗi</h2>
      <p class="text-sm text-on-surface-variant mt-1">Tổng số: 42 báo cáo chưa xử lý</p>
    </div>
    <div class="flex items-center gap-4">
      <div class="relative group hidden md:block">
        <input class="bg-surface-container border-glass-stroke border px-10 py-2 rounded-full w-64 text-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-on-surface" placeholder="Tìm kiếm phim, người dùng..." type="text"/>
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
      </div>
      <button class="p-2 rounded-full hover:bg-surface-container relative cursor-pointer text-on-surface-variant hover:text-primary transition-all">
        <span class="material-symbols-outlined">notifications</span>
        <span class="absolute top-2 right-2 w-2 h-2 bg-primary rounded-full"></span>
      </button>
      <button class="p-2 rounded-full hover:bg-surface-container cursor-pointer text-on-surface-variant hover:text-primary transition-all">
        <span class="material-symbols-outlined">account_circle</span>
      </button>
    </div>
  </header>

  <div class="space-y-8">
    <!-- Quick Filter Tabs -->
    <div class="flex flex-wrap gap-3">
      <button class="px-5 py-2 rounded-full bg-primary text-on-primary-fixed text-sm font-bold shadow-lg shadow-primary/20 cursor-pointer">Tất cả</button>
      <button class="px-5 py-2 rounded-full bg-surface-container border border-glass-stroke text-on-surface-variant text-sm font-medium hover:border-primary transition-all cursor-pointer">Chưa xử lý</button>
      <button class="px-5 py-2 rounded-full bg-surface-container border border-glass-stroke text-on-surface-variant text-sm font-medium hover:border-primary transition-all cursor-pointer">Đang sửa</button>
      <button class="px-5 py-2 rounded-full bg-surface-container border border-glass-stroke text-on-surface-variant text-sm font-medium hover:border-primary transition-all cursor-pointer">Đã xong</button>
    </div>

    <!-- Report List Grid -->
    <div class="grid grid-cols-1 gap-4">
      <!-- Report Item 1: Lỗi phim -->
      <div class="glass-panel rounded-2xl p-5 card-hover transition-all flex flex-col md:flex-row gap-6 items-start">
        <div class="w-full md:w-32 aspect-[2/3] rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke relative">
          <img class="w-full h-full object-cover" alt="Poster" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB4jkmgiwmTzaQRjkqymMh5Rk_Le3-is8clU1fS8AuyHJKmq9tLSiFrsvfEkfa_vih71MgZZJXPAqQ5HRZM30cT6xfjH2dx7weA8C5mzVh6YU-SjJydRyJyjTmL0lGVtYNmk0e8XkpwT5NPgRmcAMLPKQDt4OiNpWBkAOg6qa-UEJYMv9pn3CXzXG3zj5kZj065mV1T4YgX2nG86qAH5tVsIlGagyG2hnuQeWdoEDS87LE3oQ3-PMPHyAr-KuuyYOx8VmAOIMH8oklE"/>
          <div class="absolute inset-0 bg-gradient-to-t from-surface-deep/90 to-transparent flex items-end p-2">
            <span class="text-[10px] font-bold text-on-surface uppercase tracking-wider">Phim bộ</span>
          </div>
        </div>
        <div class="flex-1 space-y-3 w-full">
          <div class="flex flex-wrap justify-between items-start gap-4">
            <div>
              <h3 class="font-title-md text-title-md text-primary text-lg">Neon Horizon: Tập 04</h3>
              <div class="flex items-center gap-2 mt-1">
                <span class="material-symbols-outlined text-sm text-on-surface-variant">person</span>
                <span class="text-xs text-on-surface-variant">Bởi: hoang.nguyen_92</span>
                <span class="text-xs text-on-surface-variant">•</span>
                <span class="text-xs text-on-surface-variant">2 giờ trước</span>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-error-container/20 text-error border border-error/20 whitespace-nowrap">Chưa xử lý</span>
          </div>
          <div class="bg-surface-container-low/50 rounded-xl p-4 border border-glass-stroke">
            <p class="text-sm font-bold text-error mb-1 flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px]">play_circle_spark</span>
              Lỗi phim không xem được
            </p>
            <p class="text-sm text-on-surface-variant italic">"Phim bị đứng hình ở phút thứ 12:45, sau đó báo lỗi 'Source not found'. Đã thử reset nhưng vẫn không xem tiếp được."</p>
          </div>
          <div class="flex gap-2 pt-2">
            <button class="px-4 py-2 bg-primary-container text-on-primary-container rounded-lg text-xs font-bold hover:brightness-110 transition-all flex items-center gap-2 cursor-pointer shadow-lg shadow-primary-container/20">
              <span class="material-symbols-outlined text-sm">construction</span>
              Xử lý ngay
            </button>
            <button class="px-4 py-2 bg-surface-container border border-glass-stroke text-on-surface-variant rounded-lg text-xs font-bold hover:text-on-surface transition-all cursor-pointer">Chi tiết</button>
          </div>
        </div>
      </div>

      <!-- Report Item 2: Lỗi phụ đề -->
      <div class="glass-panel rounded-2xl p-5 card-hover transition-all flex flex-col md:flex-row gap-6 items-start">
        <div class="w-full md:w-32 aspect-[2/3] rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke relative">
          <img class="w-full h-full object-cover" alt="Poster" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB5ekh-B9W31CKpJBg57xPIUCVET-BeoG7FUvd1fMcHg3tBrnDrJ0hE8jWcxGZdIu74fOY7Oj_652UfRmTc0BXDm6nlk2tK7MFhrQgTwPnruk2kvNS5Oj8jtP7cWAvGFHf5mMWmCa17jDEbCg9C1jwMLCZBMVUweflKtoNW3Lb2q-JPsLaboWJNN_qTGoIL3MaENPE1zr8KwHf3vnhx0SHl_vwg_6M5YL8Gx9o27pdwLAtWyv8qQGvYnr3GoEogyBKpKJeKjdEroVsD"/>
        </div>
        <div class="flex-1 space-y-3 w-full">
          <div class="flex flex-wrap justify-between items-start gap-4">
            <div>
              <h3 class="font-title-md text-title-md text-primary text-lg">The Last Dynasty</h3>
              <div class="flex items-center gap-2 mt-1">
                <span class="material-symbols-outlined text-sm text-on-surface-variant">person</span>
                <span class="text-xs text-on-surface-variant">Bởi: linh_beauty_88</span>
                <span class="text-xs text-on-surface-variant">•</span>
                <span class="text-xs text-on-surface-variant">5 giờ trước</span>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-tertiary/10 text-tertiary border border-tertiary/20 whitespace-nowrap">Đang sửa</span>
          </div>
          <div class="bg-surface-container-low/50 rounded-xl p-4 border border-glass-stroke">
            <p class="text-sm font-bold text-tertiary mb-1 flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px]">subtitles</span>
              Lỗi phụ đề
            </p>
            <p class="text-sm text-on-surface-variant italic">"Phụ đề tiếng Việt bị lệch khoảng 3 giây so với hội thoại từ đầu phim đến cuối. Rất khó theo dõi."</p>
          </div>
          <div class="flex gap-2 pt-2">
            <button class="px-4 py-2 bg-surface-container border border-primary/40 text-primary rounded-lg text-xs font-bold hover:bg-primary/10 transition-all flex items-center gap-2 cursor-pointer">
              <span class="material-symbols-outlined text-sm">check_circle</span>
              Hoàn thành
            </button>
            <button class="px-4 py-2 bg-surface-container border border-glass-stroke text-on-surface-variant rounded-lg text-xs font-bold hover:text-on-surface transition-all cursor-pointer">Chi tiết</button>
          </div>
        </div>
      </div>

      <!-- Report Item 3: Lỗi ứng dụng -->
      <div class="glass-panel rounded-2xl p-5 card-hover transition-all flex flex-col md:flex-row gap-6 items-start">
        <div class="w-full md:w-32 aspect-square rounded-lg flex-shrink-0 bg-surface-container border border-glass-stroke flex items-center justify-center">
          <span class="material-symbols-outlined text-4xl text-primary/40">smartphone</span>
        </div>
        <div class="flex-1 space-y-3 w-full">
          <div class="flex flex-wrap justify-between items-start gap-4">
            <div>
              <h3 class="font-title-md text-title-md text-primary text-lg">Lỗi Ứng Dụng (Mobile iOS)</h3>
              <div class="flex items-center gap-2 mt-1">
                <span class="material-symbols-outlined text-sm text-on-surface-variant">person</span>
                <span class="text-xs text-on-surface-variant">Bởi: ducanh_ios_dev</span>
                <span class="text-xs text-on-surface-variant">•</span>
                <span class="text-xs text-on-surface-variant">Hôm qua</span>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 whitespace-nowrap">Đã xong</span>
          </div>
          <div class="bg-surface-container-low/50 rounded-xl p-4 border border-glass-stroke">
            <p class="text-sm font-bold text-on-surface-variant mb-1 flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px]">bug_report</span>
              Lỗi hiển thị UI
            </p>
            <p class="text-sm text-on-surface-variant italic">"Nút 'Tải về' bị mất khi xoay ngang màn hình trên iPhone 15 Pro Max. Hiện tại đã khắc phục bằng cách update layout constraint."</p>
          </div>
          <div class="flex gap-2 pt-2">
            <button class="px-4 py-2 bg-surface-container border border-glass-stroke text-on-surface-variant opacity-50 rounded-lg text-xs font-bold transition-all cursor-not-allowed">Đã đóng</button>
            <button class="px-4 py-2 bg-surface-container border border-glass-stroke text-on-surface-variant rounded-lg text-xs font-bold hover:text-on-surface transition-all cursor-pointer">Xem lịch sử</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between py-6 mb-10">
      <p class="text-sm text-on-surface-variant">Hiển thị 1 - 3 trên tổng số 142 báo cáo</p>
      <div class="flex items-center gap-2">
        <button class="w-10 h-10 flex items-center justify-center rounded-xl border border-glass-stroke text-on-surface-variant hover:bg-surface-container transition-all cursor-pointer">
          <span class="material-symbols-outlined">chevron_left</span>
        </button>
        <button class="w-10 h-10 flex items-center justify-center rounded-xl bg-primary text-on-primary-fixed font-bold cursor-pointer">1</button>
        <button class="w-10 h-10 flex items-center justify-center rounded-xl border border-glass-stroke text-on-surface-variant hover:bg-surface-container transition-all cursor-pointer">2</button>
        <button class="w-10 h-10 flex items-center justify-center rounded-xl border border-glass-stroke text-on-surface-variant hover:bg-surface-container transition-all cursor-pointer">3</button>
        <span class="text-on-surface-variant">...</span>
        <button class="w-10 h-10 flex items-center justify-center rounded-xl border border-glass-stroke text-on-surface-variant hover:bg-surface-container transition-all cursor-pointer">
          <span class="material-symbols-outlined">chevron_right</span>
        </button>
      </div>
    </div>
  </div>
</AdminLayout>
