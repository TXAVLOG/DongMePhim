---
import AdminLayout from '@layouts/AdminLayout.astro';
import { MovieService } from '@services/MovieService';
import { ErrorReportService } from '@services/ErrorReportService';

const staticMovies = await MovieService.getMovies();
const serverReports = await ErrorReportService.getAllReports();
---

<AdminLayout title="Báo cáo lỗi">
  <!-- Top App Bar Content (Header) -->
  <header class="flex items-center justify-between mb-8 mt-4">
    <div>
      <h2 class="font-title-md text-title-md text-on-surface text-2xl">Quản lý Báo cáo lỗi</h2>
      <p id="reports-header-summary" class="text-sm text-on-surface-variant mt-1">Tổng số: 0 báo cáo chưa xử lý</p>
    </div>
  </header>

  <div class="space-y-8">
    <!-- Quick Filter Tabs -->
    <div class="flex flex-wrap gap-3" id="reports-tabs">
      <button data-filter="all" class="reports-tab-btn px-5 py-2 rounded-full bg-primary text-on-primary-fixed text-sm font-bold shadow-lg shadow-primary/20 cursor-pointer">Tất cả</button>
      <button data-filter="pending" class="reports-tab-btn px-5 py-2 rounded-full bg-surface-container border border-glass-stroke text-on-surface-variant text-sm font-medium hover:border-primary transition-all cursor-pointer">Chưa xử lý</button>
      <button data-filter="fixing" class="reports-tab-btn px-5 py-2 rounded-full bg-surface-container border border-glass-stroke text-on-surface-variant text-sm font-medium hover:border-primary transition-all cursor-pointer">Đang sửa</button>
      <button data-filter="resolved" class="reports-tab-btn px-5 py-2 rounded-full bg-surface-container border border-glass-stroke text-on-surface-variant text-sm font-medium hover:border-primary transition-all cursor-pointer">Đã xong</button>
    </div>

    <!-- Report List Grid -->
    <div class="grid grid-cols-1 gap-4" id="reports-list-container">
      <!-- Populated dynamically via JS client side -->
    </div>

    <!-- Summary Count -->
    <div class="py-6 border-t border-glass-stroke mb-10 flex justify-between items-center">
      <p id="reports-footer-summary" class="text-sm text-on-surface-variant">Hiển thị 0 báo cáo</p>
    </div>
  </div>

  <script define:vars={{ staticMovies, serverReports }}>
    (function() {
      function initErrorReportingAdmin() {
        const container = document.getElementById('reports-list-container');
        if (!container) return; // Exit if not on this page

        const headerSummary = document.getElementById('reports-header-summary');
        const footerSummary = document.getElementById('reports-footer-summary');
        const tabContainer = document.getElementById('reports-tabs');

        let reports = serverReports || [];
        let activeFilter = 'all';

        function getMoviePoster(slug) {
          const movie = staticMovies.find(s => s.slug === slug);
          return movie ? movie.posterUrl : '/logo-icon.png';
        }

        window.updateReportStatus = async function(reportId, nextStatus) {
          try {
            const res = await fetch('/api/admin/error-reports-action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: reportId, action: 'update_status', status: nextStatus })
            });
            const result = await res.json();
            if (res.ok) {
              reports = reports.map(r => {
                if (r.id === reportId) {
                  return { ...r, status: nextStatus };
                }
                return r;
              });
              if (window.showGlobalToast) {
                const statusLabels = { fixing: 'Đang sửa', resolved: 'Đã xong' };
                window.showGlobalToast(`Đã chuyển trạng thái báo cáo sang ${statusLabels[nextStatus]}!`, 'success');
              }
              renderReports();
            } else {
              if (window.showGlobalToast) window.showGlobalToast(result.message || 'Lỗi xử lý', 'error');
            }
          } catch (e) {
            if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API', 'error');
          }
        };

        window.deleteReport = function(reportId) {
          const performDelete = async () => {
            try {
              const res = await fetch('/api/admin/error-reports-action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: reportId, action: 'delete' })
              });
              const result = await res.json();
              if (res.ok) {
                reports = reports.filter(r => r.id !== reportId);
                if (window.showGlobalToast) {
                  window.showGlobalToast('Đã xóa báo cáo lỗi thành công!', 'success');
                }
                renderReports();
              } else {
                if (window.showGlobalToast) window.showGlobalToast(result.message || 'Lỗi xử lý', 'error');
              }
            } catch (e) {
              if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API', 'error');
            }
          };

          if (window.txamodal) {
            window.txamodal.show({
              title: 'Xóa báo cáo lỗi',
              message: 'Bạn có chắc chắn muốn xóa vĩnh viễn báo cáo này không?',
              type: 'danger',
              confirmText: 'Xóa ngay',
              cancelText: 'Hủy bỏ',
              onConfirm: performDelete
            });
          } else if (confirm('Bạn có chắc chắn muốn xóa vĩnh viễn báo cáo này không?')) {
            performDelete();
          }
        };

        function renderReports() {
          let filtered = reports;
          if (activeFilter !== 'all') {
            filtered = reports.filter(r => r.status === activeFilter);
          }

          // Update header summaries
          const pendingCount = reports.filter(r => r.status === 'pending').length;
          if (headerSummary) {
            headerSummary.textContent = `Tổng số: ${pendingCount} báo cáo chưa xử lý`;
          }
          if (footerSummary) {
            footerSummary.textContent = `Hiển thị ${filtered.length} trên tổng số ${reports.length} báo cáo`;
          }

          if (filtered.length === 0) {
            container.innerHTML = `
              <div class="glass-panel rounded-2xl p-10 text-center text-sm text-text-dim italic">
                Không tìm thấy báo cáo lỗi nào thuộc mục này.
              </div>
            `;
            return;
          }

          container.innerHTML = filtered.map(r => {
            const poster = getMoviePoster(r.movieSlug);
            const dateText = new Date(r.createdAt).toLocaleString('vi-VN', {
              hour: '2-digit',
              minute: '2-digit',
              day: '2-digit',
              month: '2-digit',
              year: 'numeric'
            });

            let statusBadge = '';
            let actionButtons = '';

            if (r.status === 'pending') {
              statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-error-container/20 text-error border border-error/20 whitespace-nowrap">Chưa xử lý</span>';
              actionButtons = `
                <button onclick="updateReportStatus('${r.id}', 'fixing')" class="px-4 py-2 bg-primary-container text-on-primary-container rounded-lg text-xs font-bold hover:brightness-110 transition-all flex items-center gap-2 cursor-pointer shadow-lg shadow-primary-container/20 border-none">
                  <span class="material-symbols-outlined text-sm">construction</span>
                  Xử lý
                </button>
                <button onclick="updateReportStatus('${r.id}', 'resolved')" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-2 cursor-pointer border-none">
                  <span class="material-symbols-outlined text-sm">check_circle</span>
                  Hoàn thành
                </button>
              `;
            } else if (r.status === 'fixing') {
              statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-tertiary/10 text-tertiary border border-tertiary/20 whitespace-nowrap">Đang sửa</span>';
              actionButtons = `
                <button onclick="updateReportStatus('${r.id}', 'resolved')" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-2 cursor-pointer border-none">
                  <span class="material-symbols-outlined text-sm">check_circle</span>
                  Hoàn thành
                </button>
              `;
            } else {
              statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 whitespace-nowrap">Đã xong</span>';
              actionButtons = `
                <button onclick="deleteReport('${r.id}')" class="px-4 py-2 bg-rose-600/10 hover:bg-rose-600/20 border border-rose-600/30 text-rose-400 rounded-lg text-xs font-bold hover:text-rose-300 transition-all flex items-center gap-2 cursor-pointer">
                  <span class="material-symbols-outlined text-sm">delete</span>
                  Xóa báo cáo
                </button>
              `;
            }

            return `
              <div class="glass-panel rounded-2xl p-5 card-hover transition-all flex flex-col md:flex-row gap-6 items-start">
                <a href="/phim/${r.movieSlug}" target="_blank" class="w-full md:w-24 aspect-[2/3] rounded-lg overflow-hidden flex-shrink-0 bg-surface-container border border-glass-stroke relative block">
                  <img class="w-full h-full object-cover" alt="Poster" src="${poster}" onerror="this.src='/logo-icon.png'" />
                </a>
                <div class="flex-1 space-y-3 w-full">
                  <div class="flex flex-wrap justify-between items-start gap-4">
                    <div>
                      <h3 class="font-title-md text-title-md text-primary text-base font-bold">${r.movieTitle}</h3>
                      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1 text-[11px] text-on-surface-variant font-medium">
                        <span>Bản: <strong class="text-white">${r.serverName}</strong></span>
                        <span>•</span>
                        <span>Tập: <strong class="text-white">${r.episodeName}</strong></span>
                        <span>•</span>
                        <span>Bởi: <strong class="text-white">${r.user}</strong></span>
                        <span>•</span>
                        <span>${dateText}</span>
                      </div>
                    </div>
                    ${statusBadge}
                  </div>
                  <div class="bg-surface-container-low/50 rounded-xl p-4 border border-glass-stroke">
                    <p class="text-xs font-bold text-rose-400 mb-1 flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-sm">error</span>
                      Chi tiết lỗi báo:
                    </p>
                    <p class="text-xs text-on-surface-variant italic leading-relaxed">"${r.reason}"</p>
                  </div>
                  <div class="flex gap-2 pt-1">
                    ${actionButtons}
                    <a href="/xem/${r.movieSlug}?ep=${r.episodeSlug}&sv=0" target="_blank" class="px-4 py-2 bg-surface-container border border-glass-stroke text-on-surface-variant rounded-lg text-xs font-bold hover:text-on-surface transition-all flex items-center gap-1.5 decoration-none no-underline">
                      <span class="material-symbols-outlined text-sm">visibility</span>
                      Kiểm tra tập phim
                    </a>
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }

        // Tab click handlers
        if (tabContainer) {
          const tabButtons = tabContainer.querySelectorAll('.reports-tab-btn');
          tabButtons.forEach(btn => {
            btn.addEventListener('click', () => {
              tabButtons.forEach(b => {
                b.className = 'reports-tab-btn px-5 py-2 rounded-full bg-surface-container border border-glass-stroke text-on-surface-variant text-sm font-medium hover:border-primary transition-all cursor-pointer';
              });
              btn.className = 'reports-tab-btn px-5 py-2 rounded-full bg-primary text-on-primary-fixed text-sm font-bold shadow-lg shadow-primary/20 cursor-pointer';
              activeFilter = btn.getAttribute('data-filter') || 'all';
              renderReports();
            });
          });
        }

        renderReports();
      }

      initErrorReportingAdmin();
      document.addEventListener('astro:page-load', initErrorReportingAdmin);
    })();
  </script>
</AdminLayout>
