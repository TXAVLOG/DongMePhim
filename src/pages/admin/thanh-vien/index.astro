---
import AdminLayout from '@layouts/AdminLayout.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
const packages = settings.packages || [];
---

<AdminLayout title="Quản lý Thành viên">
  <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 mt-4 gap-4">
    <div>
      <h2 class="font-headline-lg text-on-surface text-3xl">Quản lý Thành viên</h2>
      <p class="text-text-dim text-body-main mt-1 font-outfit">Quản lý các tài khoản đã đăng ký thành viên trên hệ thống.</p>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="openGiveawayModal()" class="px-4 py-2.5 bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-xl text-xs transition-all active:scale-95 flex items-center gap-2 cursor-pointer border-none shadow-lg shadow-purple-600/20">
        <span class="material-symbols-outlined text-sm">card_giftcard</span>
        <span>Tặng gói cước (Giveaway)</span>
      </button>
      <button id="add-member-btn" class="px-4 py-2.5 bg-primary hover:brightness-110 text-slate-950 font-bold rounded-xl text-xs transition-all active:scale-95 flex items-center gap-2 cursor-pointer border-none shadow-lg shadow-primary/10">
        <span class="material-symbols-outlined text-sm">person_add</span>
        <span>Thêm thành viên</span>
      </button>
    </div>
  </header>

  <!-- Bulk Action Panel (Slides/Reveals when items are selected) -->
  <div id="bulk-action-panel" class="glass-panel px-6 py-4 rounded-3xl mb-6 flex flex-col sm:flex-row items-center justify-between gap-4 hidden border-primary/20 bg-primary/5 transition-all duration-300">
    <div class="flex items-center gap-3">
      <span class="w-2.5 h-2.5 rounded-full bg-primary animate-ping"></span>
      <span class="text-xs font-semibold text-white font-outfit"><span id="selected-count">0</span> thành viên được chọn</span>
    </div>
    <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto justify-end">
      <select id="bulk-action-select" class="bg-surface-container border border-glass-stroke rounded-xl px-3 py-2 text-xs focus:outline-none text-zinc-300 cursor-pointer w-full sm:w-auto">
        <option value="">-- Chọn hành động hàng loạt --</option>
        <option value="status-active">✓ Hoạt động (Kích hoạt)</option>
        <option value="status-banned">🔒 Khóa tài khoản</option>
        {packages.map((pkg : any) => (
          <option value={`package-${pkg.title}`}>⭐ Gán gói {pkg.title}</option>
        ))}
        <option value="role-admin">👑 Gán vai trò Admin</option>
        <option value="role-users">👤 Gán vai trò Users</option>
        <option value="verified-true">📧 Xác minh Email</option>
        <option value="verified-false">❌ Hủy xác minh Email</option>
        <option value="delete">🗑️ Xóa tài khoản vĩnh viễn</option>
      </select>
      <button id="bulk-action-run-btn" class="px-4 py-2 bg-primary hover:brightness-110 text-slate-950 font-bold rounded-xl text-xs transition-all active:scale-95 cursor-pointer border-none w-full sm:w-auto">
        Áp dụng
      </button>
      <button id="bulk-action-clear-btn" class="px-3 py-2 bg-white/5 border border-glass-stroke hover:bg-white/10 text-zinc-400 font-bold rounded-xl text-xs transition-all active:scale-95 cursor-pointer w-full sm:w-auto">
        Hủy chọn
      </button>
    </div>
  </div>

  <!-- Filter & Search Panel -->
  <section class="glass-panel p-6 rounded-3xl mb-8 flex flex-col md:flex-row justify-between items-center gap-4">
    <div class="relative group w-full md:w-80">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-text-dim group-focus-within:text-primary transition-colors">search</span>
      <input id="member-search" class="bg-surface-container border border-glass-stroke rounded-full pl-10 pr-4 py-2.5 text-xs focus:ring-1 focus:ring-primary focus:border-primary w-full transition-all focus:outline-none placeholder:text-zinc-500 text-white font-outfit" placeholder="Tìm kiếm tên, email thành viên..." type="text"/>
    </div>
    
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
      <select id="filter-package" class="bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-primary text-zinc-300 w-full md:w-auto cursor-pointer font-outfit">
        <option value="all">Tất cả gói</option>
        {packages.map((pkg : any) => (
          <option value={pkg.title}>{pkg.title}</option>
        ))}
      </select>

      <select id="filter-role" class="bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-primary text-zinc-300 w-full md:w-auto cursor-pointer font-outfit">
        <option value="all">Tất cả vai trò</option>
        <option value="admin">Quản trị viên (admin)</option>
        <option value="users">Thành viên (users)</option>
      </select>
      
      <select id="filter-status" class="bg-surface-container border border-glass-stroke rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-primary text-zinc-300 w-full md:w-auto cursor-pointer font-outfit">
        <option value="all">Tất cả trạng thái</option>
        <option value="active">Đang hoạt động</option>
        <option value="banned">Đã khóa</option>
      </select>
    </div>
  </section>

  <div id="members-page-data" data-packages={JSON.stringify(packages)} class="hidden"></div>

  <!-- Members Table -->
  <section class="glass-panel rounded-3xl overflow-hidden mb-8">
    <div class="px-8 py-6 flex justify-between items-center border-b border-glass-stroke bg-white/[0.01]">
      <h3 class="text-title-md text-on-surface font-bold">Danh sách thành viên</h3>
      <span id="members-summary" class="text-xs text-text-dim font-bold font-label-caps">ĐANG TẢI...</span>
    </div>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-surface-container/40">
          <tr>
            <th class="px-4 py-4 w-10 text-center">
              <input type="checkbox" id="select-all-members" class="rounded border-glass-stroke text-primary bg-surface-container w-4 h-4 cursor-pointer focus:ring-primary focus:ring-offset-0" />
            </th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">TÊN TÀI KHOẢN / EMAIL</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">NGÀY ĐĂNG KÝ</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">GÓI DỊCH VỤ</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">XÁC MINH EMAIL</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim">TRẠNG THÁI</th>
            <th class="px-8 py-4 text-xs font-label-caps text-text-dim text-right">HÀNH ĐỘNG</th>
          </tr>
        </thead>
        <tbody id="member-table-tbody" class="divide-y divide-glass-stroke">
          <!-- Populated dynamically via JS client side -->
        </tbody>
      </table>
    </div>
    
    <div class="p-4 bg-surface-container/20 text-center border-t border-glass-stroke">
      <p id="show-count-text" class="text-xs text-text-dim font-label-caps font-bold">HIỂN THỊ 0 TRÊN TỔNG SỐ 0 THÀNH VIÊN</p>
    </div>
  </section>

  <script is:inline>
    (function() {
      function initMembersManagement() {
        const tbody = document.getElementById('member-table-tbody');
        if (!tbody) return; // Exit if not on this page

        const searchInput = document.getElementById('member-search');
        const filterPackage = document.getElementById('filter-package');
        const filterRole = document.getElementById('filter-role');
        const filterStatus = document.getElementById('filter-status');
        const summaryText = document.getElementById('members-summary');
        const showCountText = document.getElementById('show-count-text');
        const addBtn = document.getElementById('add-member-btn');

        const selectAllCheckbox = document.getElementById('select-all-members');
        const bulkPanel = document.getElementById('bulk-action-panel');
        const selectedCountEl = document.getElementById('selected-count');
        const bulkActionSelect = document.getElementById('bulk-action-select');
        const bulkRunBtn = document.getElementById('bulk-action-run-btn');
        const bulkClearBtn = document.getElementById('bulk-action-clear-btn');

        let users = [];
        let selectedUsernames = [];
        const pageDataEl = document.getElementById('members-page-data');
        const packages = pageDataEl ? JSON.parse(pageDataEl.dataset.packages || '[]') : [];

        async function loadUsersFromDb() {
          if (summaryText) summaryText.textContent = 'ĐANG TẢI...';
          try {
            const res = await fetch('/api/admin/members');
            if (res.ok) {
              const data = await res.json();
              users = data.data || [];
              filterAndSearch();
            }
          } catch (e) {
            console.error('Lỗi khi tải danh sách thành viên:', e);
          }
        }

        function updateBulkPanelState() {
          const checkboxes = document.querySelectorAll('.member-checkbox');
          selectedUsernames = [];
          checkboxes.forEach(cb => {
            if (cb.checked) {
              selectedUsernames.push(cb.dataset.username);
            }
          });

          if (selectedUsernames.length > 0) {
            bulkPanel?.classList.remove('hidden');
            bulkPanel?.classList.add('flex');
            if (selectedCountEl) selectedCountEl.textContent = selectedUsernames.length;
            if (selectAllCheckbox) {
              selectAllCheckbox.checked = (selectedUsernames.length === checkboxes.length);
            }
          } else {
            bulkPanel?.classList.add('hidden');
            bulkPanel?.classList.remove('flex');
            if (selectAllCheckbox) selectAllCheckbox.checked = false;
          }
        }

        if (selectAllCheckbox) {
          selectAllCheckbox.addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.member-checkbox');
            checkboxes.forEach(cb => {
              cb.checked = this.checked;
            });
            updateBulkPanelState();
          });
        }

        // Event delegation for checkbox changes
        tbody.addEventListener('change', (e) => {
          if (e.target && e.target.classList.contains('member-checkbox')) {
            updateBulkPanelState();
          }
        });

        if (bulkClearBtn) {
          bulkClearBtn.onclick = () => {
            const checkboxes = document.querySelectorAll('.member-checkbox');
            checkboxes.forEach(cb => {
              cb.checked = false;
            });
            updateBulkPanelState();
          };
        }

        if (bulkRunBtn) {
          bulkRunBtn.onclick = () => {
            const action = bulkActionSelect?.value;
            if (!action) {
              window.showGlobalToast('Vui lòng chọn một hành động để áp dụng!', 'error');
              return;
            }

            if (selectedUsernames.length === 0) {
              window.showGlobalToast('Không có thành viên nào được chọn!', 'error');
              return;
            }

            const executeBulk = async () => {
              try {
                const res = await fetch('/api/admin/members', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    action: 'bulk',
                    usernames: selectedUsernames,
                    bulkAction: action
                  })
                });

                if (res.ok) {
                  window.showGlobalToast(`Đã áp dụng hành động hàng loạt thành công!`, 'success');
                  selectedUsernames = [];
                  if (selectAllCheckbox) selectAllCheckbox.checked = false;
                  if (bulkActionSelect) bulkActionSelect.value = '';
                  await loadUsersFromDb();
                } else {
                  const errorData = await res.json();
                  window.showGlobalToast(errorData.message || 'Lỗi thao tác hàng loạt!', 'error');
                }
              } catch (e) {
                window.showGlobalToast('Lỗi kết nối máy chủ!', 'error');
              }
            };

            if (window.txamodal) {
              let actionLabel = '';
              if (action === 'delete') actionLabel = 'Xóa tài khoản hàng loạt';
              else if (action.startsWith('status-')) actionLabel = `Thay đổi trạng thái thành ${action.substring(7)} hàng loạt`;
              else if (action.startsWith('package-')) actionLabel = `Thay đổi gói cước thành ${action.substring(8)} hàng loạt`;
              else if (action.startsWith('role-')) actionLabel = `Thay đổi vai trò thành ${action.substring(5)} hàng loạt`;
              else if (action.startsWith('verified-')) actionLabel = `Thay đổi xác minh email hàng loạt`;

              window.txamodal.show({
                title: 'Xác nhận hành động hàng loạt',
                message: `Bạn có chắc chắn muốn thực hiện hành động <strong>${actionLabel}</strong> cho <strong>${selectedUsernames.length}</strong> thành viên đã chọn không?`,
                type: action === 'delete' ? 'danger' : 'info',
                confirmText: 'Thực hiện ngay',
                cancelText: 'Hủy bỏ',
                onConfirm: executeBulk
              });
            } else if (confirm(`Bạn có chắc chắn muốn thực hiện hành động hàng loạt này không?`)) {
              executeBulk();
            }
          };
        }

        window.toggleUserStatus = async function(username) {
          const u = users.find(user => user.username === username);
          if (!u) return;

          const nextStatus = u.status === 'active' ? 'banned' : 'active';
          try {
            const res = await fetch('/api/admin/members', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'edit',
                username,
                status: nextStatus
              })
            });

            if (res.ok) {
              window.showGlobalToast(`Đã ${nextStatus === 'active' ? 'mở khóa' : 'khóa'} tài khoản ${username}!`, 'success');
              await loadUsersFromDb();
            } else {
              window.showGlobalToast('Không thể thay đổi trạng thái tài khoản!', 'error');
            }
          } catch (e) {
            window.showGlobalToast('Lỗi mạng!', 'error');
          }
        };

        window.deleteUser = function(username) {
          const performDelete = async () => {
            try {
              const res = await fetch('/api/admin/members', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  action: 'delete',
                  username
                })
              });

              if (res.ok) {
                window.showGlobalToast('Đã xóa thành viên thành công!', 'success');
                await loadUsersFromDb();
              } else {
                window.showGlobalToast('Xóa thành viên thất bại!', 'error');
              }
            } catch (e) {
              window.showGlobalToast('Lỗi kết nối mạng!', 'error');
            }
          };

          if (window.txamodal) {
            window.txamodal.show({
              title: 'Xóa tài khoản thành viên',
              message: `Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản thành viên <strong>${username}</strong> không? Hành động này không thể hoàn tác.`,
              type: 'danger',
              confirmText: 'Xóa ngay',
              cancelText: 'Hủy bỏ',
              onConfirm: performDelete
            });
          } else if (confirm(`Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản thành viên ${username} không?`)) {
            performDelete();
          }
        };

        window.changeUserPackage = async function(username) {
          const u = users.find(user => user.username === username);
          if (!u) return;

          const currentIndex = packages.findIndex(p => p.id === u.package || p.title === u.package);
          const nextIndex = (currentIndex + 1) % packages.length;
          const nextPackage = packages[nextIndex]?.id || 'free';
          try {
            const res = await fetch('/api/admin/members', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'edit',
                username,
                package: nextPackage
              })
            });

            if (res.ok) {
              window.showGlobalToast(`Đã chuyển ${username} sang gói ${nextPackage}!`, 'success');
              await loadUsersFromDb();
            } else {
              window.showGlobalToast('Không thể thay đổi gói cước!', 'error');
            }
          } catch (e) {
            window.showGlobalToast('Lỗi kết nối mạng!', 'error');
          }
        };

        window.showEditMemberModal = (username) => {
          const u = users.find(user => user.username === username);
          if (!u) return;

          window.txamodal.show({
            title: `Chỉnh sửa thành viên: ${username}`,
            content: `
              <div class="space-y-4 pt-2">
                <div class="flex flex-col gap-1 opacity-60">
                  <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Tên tài khoản (Không thể thay đổi)</label>
                  <input type="text" id="modal-username" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none" value="${u.username}" readonly />
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Email</label>
                  <input type="email" id="modal-email" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:ring-1 focus:ring-primary" value="${u.email || ''}" required />
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div class="flex flex-col gap-1">
                    <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Gói dịch vụ</label>
                    <select id="modal-package" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none">
                      ${packages.map(pkg => `<option value="${pkg.title}" ${u.package === pkg.title ? 'selected' : ''}>${pkg.title}</option>`).join('')}
                    </select>
                  </div>
                  <div class="flex flex-col gap-1">
                    <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Vai trò</label>
                    <select id="modal-role" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none">
                      <option value="users" ${u.roles === 'users' ? 'selected' : ''}>Thành viên (users)</option>
                      <option value="admin" ${u.roles === 'admin' ? 'selected' : ''}>Quản trị viên (admin)</option>
                    </select>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div class="flex flex-col gap-1">
                    <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Xác minh Email</label>
                    <select id="modal-verified" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none">
                      <option value="false" ${!u.emailVerified ? 'selected' : ''}>Chưa xác minh</option>
                      <option value="true" ${u.emailVerified ? 'selected' : ''}>Đã xác minh</option>
                    </select>
                  </div>
                  <div class="flex flex-col gap-1">
                    <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Trạng thái</label>
                    <select id="modal-status" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none">
                      <option value="active" ${u.status === 'active' ? 'selected' : ''}>Đang hoạt động</option>
                      <option value="banned" ${u.status === 'banned' ? 'selected' : ''}>Đã khóa</option>
                    </select>
                  </div>
                </div>
              </div>
            `,
            confirmText: 'Cập nhật',
            cancelText: 'Hủy bỏ',
            onConfirm: async () => {
              const email = document.getElementById('modal-email').value.trim();
              const pack = document.getElementById('modal-package').value;
              const role = document.getElementById('modal-role').value;
              const verified = document.getElementById('modal-verified').value === 'true';
              const status = document.getElementById('modal-status').value;

              if (!email) {
                window.showGlobalToast('Vui lòng điền email hợp lệ!', 'error');
                return;
              }

              try {
                const res = await fetch('/api/admin/members', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    action: 'edit',
                    username,
                    email,
                    package: pack,
                    role,
                    emailVerified: verified,
                    status
                  })
                });

                if (res.ok) {
                  window.showGlobalToast(`Đã cập nhật thông tin thành viên ${username}!`, 'success');
                  await loadUsersFromDb();
                } else {
                  const errorData = await res.json();
                  window.showGlobalToast(errorData.message || 'Cập nhật thất bại!', 'error');
                }
              } catch (e) {
                window.showGlobalToast('Lỗi kết nối mạng!', 'error');
              }
            }
          });
        };

        function renderUsers(list) {
          if (!tbody) return;
          
          if (list.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="7" class="px-8 py-12 text-center text-xs text-text-dim italic font-outfit">
                  Không tìm thấy thành viên nào khớp với bộ lọc của bạn.
                </td>
              </tr>
            `;
            if (showCountText) showCountText.textContent = 'HIỂN THỊ 0 THÀNH VIÊN';
            return;
          }

          tbody.innerHTML = list.map(u => {
            const registeredDate = u.createdAt ? new Date(u.createdAt).toLocaleDateString('vi-VN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            }) : '—';
            
            const pkg = packages.find(p => p.id === u.package) || packages.find(p => p.title === u.package);
            let styleClass = '';
            let styleAttr = '';
            if (pkg) {
              if (pkg.style_type === 'rainbow_effect') {
                styleClass = `package-style-${pkg.id} package-border-${pkg.id} package-glow-${pkg.id} border font-bold`;
              } else if (pkg.style_type === 'custom_color' && pkg.custom_color) {
                styleClass = `package-border-${pkg.id} border`;
                styleAttr = `style="color: ${pkg.custom_color}; border-color: ${pkg.custom_color}; font-weight: bold;"`;
              } else {
                styleClass = (u.package === 'free' || u.package === 'Free') ? 'bg-zinc-500/10 text-zinc-400 border border-zinc-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20';
              }
            } else {
              styleClass = (u.package === 'free' || u.package === 'Free') ? 'bg-zinc-500/10 text-zinc-400 border border-zinc-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20';
            }
            const packageText = u.package;

            const isActive = u.status === 'active';
            const statusBg = isActive ? 'bg-emerald-500' : 'bg-rose-500';
            const statusText = isActive ? 'Hoạt động' : 'Đã khóa';

            const isVerified = !!u.emailVerified;
            const verifiedColor = isVerified ? 'text-emerald-400' : 'text-zinc-500';
            const verifiedText = isVerified ? 'Đã xác minh' : 'Chưa xác minh';
            const verifiedIcon = isVerified ? 'verified' : 'mail';

            return `
              <tr class="hover:bg-white/5 transition-colors group">
                <td class="px-4 py-4 text-center">
                  <input type="checkbox" data-username="${u.username}" class="member-checkbox rounded border-glass-stroke text-primary bg-surface-container w-4 h-4 cursor-pointer focus:ring-primary focus:ring-offset-0" />
                </td>
                <td class="px-8 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-surface-container border border-glass-stroke flex items-center justify-center text-text-dim font-bold text-sm uppercase">
                      ${u.username.substring(0, 2)}
                    </div>
                    <div>
                      <div class="flex items-center gap-2">
                        <p class="text-sm font-semibold group-hover:text-primary transition-colors font-outfit">${u.username}</p>
                        ${u.roles === 'admin' ? '<span class="text-[9px] bg-red-500/10 text-red-400 border border-red-500/20 px-1.5 py-0.5 rounded font-black uppercase tracking-wider font-outfit">Admin</span>' : ''}
                      </div>
                      <p class="text-[10px] text-text-dim mt-0.5 font-outfit">${u.email}</p>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-4 text-xs text-text-dim font-outfit">${registeredDate}</td>
                <td class="px-8 py-4">
                  <button onclick="changeUserPackage('${u.username}')" class="px-2 py-1 rounded text-[10px] font-bold ${styleClass} cursor-pointer hover:brightness-110 font-outfit" ${styleAttr} data-txatooltip="Nhấp để đổi nhanh gói">
                    ${packageText}
                  </button>
                </td>
                <td class="px-8 py-4">
                  <div class="flex items-center gap-2 cursor-pointer select-none" data-txatooltip="Trạng thái xác minh email của thành viên">
                    <span class="material-symbols-outlined text-sm ${verifiedColor}">${verifiedIcon}</span>
                    <span class="text-xs text-text-dim font-outfit">${verifiedText}</span>
                  </div>
                </td>
                <td class="px-8 py-4">
                  <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full ${statusBg}"></div>
                    <span class="text-xs font-medium text-on-surface font-outfit">${statusText}</span>
                  </div>
                </td>
                <td class="px-8 py-4 text-right">
                  <div class="flex gap-2 justify-end">
                    <button onclick="showEditMemberModal('${u.username}')" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-primary transition-colors cursor-pointer" data-txatooltip="Chỉnh sửa chi tiết">
                      <span class="material-symbols-outlined text-sm">edit</span>
                    </button>
                    <button onclick="toggleUserStatus('${u.username}')" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-primary transition-colors cursor-pointer" data-txatooltip="${isActive ? 'Khóa tài khoản' : 'Mở khóa tài khoản'}">
                      <span class="material-symbols-outlined text-sm">${isActive ? 'block' : 'lock_open'}</span>
                    </button>
                    <button onclick="deleteUser('${u.username}')" class="w-8 h-8 rounded-lg glass-panel flex items-center justify-center hover:text-error transition-colors cursor-pointer" data-txatooltip="Xóa vĩnh viễn">
                      <span class="material-symbols-outlined text-sm">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            `;
          }).join('');

          if (showCountText) {
            showCountText.textContent = `HIỂN THỊ ${list.length} TRÊN TỔNG SỐ ${users.length} THÀNH VIÊN`;
          }
        }

        function filterAndSearch() {
          const query = searchInput?.value.trim().toLowerCase() || '';
          const pack = filterPackage?.value || 'all';
          const role = filterRole?.value || 'all';
          const stat = filterStatus?.value || 'all';

          let filtered = users;

          if (query) {
            filtered = filtered.filter(u => 
              u.username.toLowerCase().includes(query) || 
              (u.email && u.email.toLowerCase().includes(query))
            );
          }

          if (pack !== 'all') {
            filtered = filtered.filter(u => u.package === pack);
          }

          if (role !== 'all') {
            filtered = filtered.filter(u => u.roles === role);
          }

          if (stat !== 'all') {
            filtered = filtered.filter(u => u.status === stat);
          }

          renderUsers(filtered);
          if (selectAllCheckbox) selectAllCheckbox.checked = false;
          updateBulkPanelState();
          
          if (summaryText) {
            const activeCount = users.filter(u => u.status === 'active').length;
            summaryText.textContent = `${activeCount} Đang hoạt động / ${users.length} Tổng số`;
          }
        }

        window.openGiveawayModal = function() {
          const content = `
            <div class="space-y-4 text-xs text-left pt-2">
              <div>
                <label class="block text-zinc-400 font-bold mb-1">Tên tài khoản người nhận</label>
                <input type="text" id="giveaway-username" placeholder="Nhập username thành viên..." class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-purple-500 font-bold" />
              </div>
              <div>
                <label class="block text-zinc-400 font-bold mb-1">Chọn gói cước trao tặng</label>
                <select id="giveaway-package" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-white focus:outline-none font-bold">
                  ${packages.map(p => `<option value="${p.title}">${p.title}</option>`).join('')}
                  <option value="bypass_zalo">⭐ [Gói riêng] Key Bypass Zalo (15 Thiết bị)</option>
                </select>
              </div>
            </div>
          `;

          if (window.txamodal) {
            window.txamodal.show({
              title: '🎁 Tặng Gói Cước Giveaway Tốc Độ',
              content: content,
              confirmText: 'Xác nhận tặng gói',
              cancelText: 'Hủy bỏ',
              onConfirm: async () => {
                const username = document.getElementById('giveaway-username').value.trim();
                const selectedPkg = document.getElementById('giveaway-package').value;

                if (!username) {
                  window.showGlobalToast('Vui lòng nhập tên tài khoản!', 'error');
                  return;
                }

                if (selectedPkg === 'bypass_zalo') {
                  // Gọi API tạo Key Bypass
                  try {
                    const res = await fetch('/api/admin/zalo-keys', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ action: 'create', packageTitle: 'Gói Key Bypass Giveaway', durationMonths: 1, note: `Giveaway cho ${username}` })
                    });
                    const data = await res.json();
                    if (res.ok) {
                      window.showGlobalToast(`Đã cấp mã Key Bypass thành công: ${data.data.key_code}`, 'success');
                    }
                  } catch (e) {}
                } else {
                  // Gán gói vào tài khoản người dùng
                  try {
                    const res = await fetch('/api/admin/members', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ action: 'edit', username, package: selectedPkg })
                    });
                    if (res.ok) {
                      window.showGlobalToast(`Đã tặng gói ${selectedPkg} cho ${username} thành công!`, 'success');
                      loadUsersFromDb();
                    } else {
                      window.showGlobalToast('Không tìm thấy thành viên hoặc lỗi cập nhật!', 'error');
                    }
                  } catch (e) {}
                }
              }
            });
          }
        };

        // Add Member Modal Form Trigger
        if (addBtn) {
          addBtn.onclick = () => {
            window.txamodal.show({
              title: 'Thêm thành viên mới',
              content: `
                <div class="space-y-4 pt-2">
                  <div class="flex flex-col gap-1">
                    <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Tên tài khoản</label>
                    <input type="text" id="modal-username" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:ring-1 focus:ring-primary" placeholder="Nhập tên tài khoản..." required />
                  </div>
                  <div class="flex flex-col gap-1">
                    <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Email</label>
                    <input type="email" id="modal-email" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:ring-1 focus:ring-primary" placeholder="Nhập email..." required />
                  </div>
                  <div class="grid grid-cols-2 gap-3">
                    <div class="flex flex-col gap-1">
                      <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Gói dịch vụ</label>
                      <select id="modal-package" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none">
                        ${packages.map(pkg => `<option value="${pkg.title}">${pkg.title}</option>`).join('')}
                      </select>
                    </div>
                    <div class="flex flex-col gap-1">
                      <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Vai trò</label>
                      <select id="modal-role" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none">
                        <option value="users">Thành viên (users)</option>
                        <option value="admin">Quản trị viên (admin)</option>
                      </select>
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-3">
                    <div class="flex flex-col gap-1">
                      <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Xác minh Email</label>
                      <select id="modal-verified" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none">
                        <option value="false">Chưa xác minh</option>
                        <option value="true">Đã xác minh</option>
                      </select>
                    </div>
                    <div class="flex flex-col gap-1">
                      <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Trạng thái</label>
                      <select id="modal-status" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none">
                        <option value="active">Đang hoạt động</option>
                        <option value="banned">Đã khóa</option>
                      </select>
                    </div>
                  </div>
                </div>
              `,
              confirmText: 'Lưu lại',
              cancelText: 'Hủy bỏ',
              onConfirm: async () => {
                const username = document.getElementById('modal-username').value.trim();
                const email = document.getElementById('modal-email').value.trim();
                const pack = document.getElementById('modal-package').value;
                const role = document.getElementById('modal-role').value;
                const verified = document.getElementById('modal-verified').value === 'true';
                const status = document.getElementById('modal-status').value;

                if (!username || !email) {
                  window.showGlobalToast('Vui lòng điền đầy đủ thông tin bắt buộc!', 'error');
                  return;
                }

                // Check username duplicates
                if (users.some(u => u.username.toLowerCase() === username.toLowerCase())) {
                  window.showGlobalToast('Tên tài khoản đã tồn tại!', 'error');
                  return;
                }

                try {
                  const res = await fetch('/api/admin/members', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      action: 'add',
                      username,
                      email,
                      package: pack,
                      role,
                      emailVerified: verified,
                      status
                    })
                  });

                  if (res.ok) {
                    window.showGlobalToast(`Đã thêm thành viên ${username} thành công!`, 'success');
                    await loadUsersFromDb();
                  } else {
                    const errorData = await res.json();
                    window.showGlobalToast(errorData.message || 'Thêm thành viên thất bại!', 'error');
                  }
                } catch (e) {
                  window.showGlobalToast('Lỗi mạng!', 'error');
                }
              }
            });
          };
        }

        // Event listeners
        if (searchInput) searchInput.oninput = filterAndSearch;
        if (filterPackage) filterPackage.onchange = filterAndSearch;
        if (filterRole) filterRole.onchange = filterAndSearch;
        if (filterStatus) filterStatus.onchange = filterAndSearch;

        // Run initial load
        loadUsersFromDb();
      }

      initMembersManagement();
      document.addEventListener('astro:page-load', initMembersManagement);
    })();
  </script>
</AdminLayout>
