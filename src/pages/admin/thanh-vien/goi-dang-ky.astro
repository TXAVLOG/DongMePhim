---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { SettingService } from '../../../services/SettingService';

const settings = await SettingService.getSettings();
const packages = settings.packages || [];
---

<AdminLayout title="Quản lý Gói đăng ký">
  <div class="w-full mt-4 pb-10">
    <!-- Header Section -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center py-8 gap-4">
      <div>
        <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Subscription Plans</h1>
        <p class="text-on-surface-variant mt-1">Manage service tiers, pricing, and active memberships.</p>
      </div>
      <button class="bg-primary-container hover:bg-primary-container/80 text-on-primary-container px-6 py-3 rounded-xl font-bold flex items-center gap-2 transition-all active:scale-95 cursor-pointer">
        <span class="material-symbols-outlined">add_circle</span>
        Create New Plan
      </button>
    </header>

    <!-- Payment Gate validation warning -->
    <div id="payment-gate-warning" class="hidden flex flex-col items-center justify-center p-12 text-center glass-panel rounded-3xl border border-glass-stroke max-w-2xl mx-auto my-12">
      <span class="material-symbols-outlined text-yellow-500 text-6xl mb-4 animate-pulse">warning</span>
      <h3 class="text-xl font-bold text-white mb-2">Chưa cấu hình phương thức thanh toán</h3>
      <p class="text-xs text-zinc-400 max-w-md mb-6 leading-relaxed">
        Để quản lý gói đăng ký và bán dịch vụ thành viên, vui lòng cấu hình ít nhất một phương thức thanh toán (chuyển khoản ngân hàng hoặc cổng tự động) trong phần cài đặt hệ thống.
      </p>
      <a href="/admin/cai-dat" class="px-6 py-3 bg-primary text-slate-950 rounded-xl font-bold text-xs hover:brightness-110 active:scale-95 transition-all cursor-pointer">
        Đi đến Cấu hình hệ thống
      </a>
    </div>

    <div id="subscription-plans-content" class="space-y-12">
      <!-- Subscription Tiers (Bento Grid Style) -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {packages.map((pkg) => {
          const isFree = pkg.id === 'free';
          const cardBorderClass = `package-border-${pkg.id}`;
          const cardGlowClass = `package-glow-${pkg.id}`;
          const textClass = `package-style-${pkg.id}`;
          const btnClass = isFree ? 'border border-glass-stroke hover:bg-surface-container-high text-on-surface' : `package-btn-${pkg.id} hover:brightness-110 active:scale-95 shadow-lg`;
          
          return (
            <div class={`glass-card rounded-2xl p-6 flex flex-col relative overflow-hidden border ${cardBorderClass} ${cardGlowClass} transition-all duration-300`}>
              {!isFree && pkg.style_type === 'rainbow_effect' && (
                <div class="absolute top-0 right-0">
                  <div class="bg-gradient-to-r from-red-500 via-green-500 to-blue-500 text-black px-6 py-1 rotate-45 translate-x-6 translate-y-2 text-[9px] font-black uppercase tracking-wider font-label-caps animate-pulse">POPULAR</div>
                </div>
              )}
              <div class="flex justify-between items-start mb-6">
                <div class="p-3 bg-surface-container-high rounded-xl">
                  <span class="material-symbols-outlined text-on-surface-variant">{isFree ? 'person' : 'workspace_premium'}</span>
                </div>
                <span class="px-3 py-1 bg-surface-container-highest rounded-full text-label-caps font-label-caps text-on-surface-variant">{isFree ? 'DEFAULT' : pkg.cycle.toUpperCase()}</span>
              </div>
              <h3 class={`font-title-md text-title-md mb-2 ${textClass}`}>{pkg.title}</h3>
              <div class="flex items-baseline gap-1 mb-6">
                <span class="text-headline-lg font-headline-lg text-3xl">{pkg.price.toLocaleString('vi-VN')}đ</span>
                <span class="text-on-surface-variant text-[14px]">/ {pkg.cycle === 'lifetime' ? 'Lifetime' : pkg.cycle === 'annual' ? 'Annually' : 'Monthly'}</span>
              </div>
              <ul class="space-y-4 mb-8">
                {pkg.features.map(f => (
                  <li class="flex items-center gap-3 text-[14px]">
                    <span class="material-symbols-outlined text-primary text-[20px]">check</span>
                    <span class="text-on-surface">{f}</span>
                  </li>
                ))}
              </ul>
              <button onclick={`openEditPlanModal('${pkg.id}')`} class={`mt-auto w-full py-3 rounded-lg font-semibold cursor-pointer ${btnClass}`}>
                Edit Plan
              </button>
            </div>
          );
        })}
      </section>

      <!-- Duyệt Chuyển Khoản Thủ Công (Manual Approvals) -->
      <section id="manual-approvals-section" class="glass-panel rounded-2xl overflow-hidden mb-12 hidden">
        <div class="px-8 py-6 border-b border-glass-stroke flex justify-between items-center bg-surface-container-low/50">
          <h2 class="font-title-md text-title-md text-on-surface text-xl">Duyệt chuyển khoản thủ công (VietQR)</h2>
          <span class="px-3 py-1 bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 rounded-full text-label-caps font-label-caps text-xs animate-pulse font-bold uppercase">Chờ duyệt</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-surface-container/30">
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Mã GD</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">User</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Gói cước</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Số tiền</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Minh chứng</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-right text-xs font-bold">Thao tác</th>
              </tr>
            </thead>
            <tbody id="manualApprovalsBody" class="divide-y divide-glass-stroke/40">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>
      </section>

      <!-- User Subscription List Section -->
      <section class="glass-panel rounded-2xl overflow-hidden">
        <div class="px-8 py-6 border-b border-glass-stroke flex justify-between items-center bg-surface-container-low/50">
          <h2 class="font-title-md text-title-md text-on-surface text-xl">Active Subscriptions</h2>
          <div class="flex items-center gap-4">
            <div class="relative hidden sm:block">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
              <input id="activeSubsSearch" class="bg-surface-deep border border-glass-stroke rounded-full pl-10 pr-4 py-2 text-[14px] focus:outline-none focus:border-primary w-64 transition-all text-on-surface" placeholder="Search user email..." type="text"/>
            </div>
          </div>
        </div>
        <div class="overflow-x-auto custom-scrollbar">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-container/30">
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">User</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Current Plan</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Join Date</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Expiry Date</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Status</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-right text-xs font-bold">Actions</th>
              </tr>
            </thead>
            <tbody id="activeSubsBody" class="divide-y divide-glass-stroke">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>
          </table>
        </div>
        <!-- Pagination -->
        <div class="px-8 py-4 border-t border-glass-stroke flex justify-between items-center text-[13px] text-on-surface-variant">
          <p>Showing 4 of 1,248 users</p>
          <div class="flex gap-2">
            <button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer"><span class="material-symbols-outlined text-[20px]">chevron_left</span></button>
            <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary text-on-primary-fixed font-bold cursor-pointer">1</button>
            <button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer">2</button>
            <button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer">3</button>
            <button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer"><span class="material-symbols-outlined text-[20px]">chevron_right</span></button>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script is:inline>
    (function() {
      let loadedUsers = [];
      let loadedLogs = [];

      // 1. Check Payment Gateways Enabled
      function checkPaymentGate() {
        fetch('/api/admin/settings')
          .then(res => res.ok ? res.json() : null)
          .then(result => {
            const settings = result?.data || {};
            const payments = settings.payments || {};
            const anyEnabled = payments.manual_enable || payments.payos_enable || payments.paypal_enable || payments.sepay_enable || payments.vnpay_enable || payments.stripe_enable;
            
            const warningGate = document.getElementById('payment-gate-warning');
            const mainContent = document.getElementById('subscription-plans-content');
            
            if (warningGate && mainContent) {
              if (!anyEnabled) {
                warningGate.classList.remove('hidden');
                mainContent.classList.add('hidden');
              } else {
                warningGate.classList.add('hidden');
                mainContent.classList.remove('hidden');
              }
            }
          })
          .catch(err => console.error('Error checking payment gateways:', err));
      }

      // 2. Fetch all data
      async function loadAllData() {
        try {
          const res = await fetch('/api/admin/members');
          if (res.ok) {
            const result = await res.json();
            if (result && result.status === 'success') {
              loadedUsers = result.data || [];
            }
          }
        } catch (e) {
          console.error('Error fetching members:', e);
        }

        try {
          const res = await fetch('/api/user/payments');
          if (res.ok) {
            const result = await res.json();
            if (result && result.status === 'success') {
              loadedLogs = result.data || [];
            }
          }
        } catch (e) {
          console.error('Error fetching payments:', e);
        }

        renderActiveSubscriptions();
        renderManualApprovals();
      }

      // 3. Render Active Subscriptions list
      function renderActiveSubscriptions() {
        const searchVal = document.getElementById('activeSubsSearch')?.value?.toLowerCase() || '';
        const tbody = document.getElementById('activeSubsBody');
        if (!tbody) return;

        // Filter if searched
        const filteredUsers = loadedUsers.filter(u => 
          (u.username || '').toLowerCase().includes(searchVal) || 
          (u.email || '').toLowerCase().includes(searchVal)
        );

        if (filteredUsers.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" class="px-8 py-5 text-center text-zinc-500 italic">Không có người dùng phù hợp.</td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = filteredUsers.map(u => {
          const initials = u.username ? u.username.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'US';
          
          let pkgBadge = '';
          let bgClass = 'bg-surface-container-highest text-on-surface-variant border-glass-stroke';
          if (u.package && u.package.includes('VIP')) {
            if (u.package.includes('Year')) {
              bgClass = 'bg-secondary/10 text-secondary border border-secondary/20';
            } else {
              bgClass = 'bg-primary/10 text-primary border border-primary/20';
            }
          }
          pkgBadge = `<span class="text-[13px] px-2.5 py-0.5 rounded-full font-medium whitespace-nowrap ${bgClass}">${u.package || 'Free'}</span>`;

          const jDate = u.joinDate ? new Date(u.joinDate).toLocaleDateString('vi-VN') : '—';
          const eDate = u.expiryDate ? new Date(u.expiryDate).toLocaleDateString('vi-VN') : '—';

          let statusText = 'Standard';
          let statusDot = 'bg-on-surface-variant/30';
          let statusColor = 'text-on-surface-variant';
          
          if (u.package && u.package.includes('VIP')) {
            const exp = u.expiryDate ? new Date(u.expiryDate) : null;
            if (exp && new Date() > exp) {
              statusText = 'Expired';
              statusDot = 'bg-error';
              statusColor = 'text-error';
            } else {
              statusText = 'Active';
              statusDot = 'bg-emerald-400 animate-pulse';
              statusColor = 'text-emerald-400';
            }
          }

          return `
            <tr class="hover:bg-surface-container-high/30 transition-colors">
              <td class="px-8 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold text-xs">${initials}</div>
                  <div>
                    <p class="font-bold text-[14px] text-white">${u.username || 'Người dùng'}</p>
                    <p class="text-[12px] text-zinc-400">${u.email || ''}</p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-4">${pkgBadge}</td>
              <td class="px-8 py-4 text-[13px] text-zinc-400 whitespace-nowrap">${jDate}</td>
              <td class="px-8 py-4 text-[13px] text-zinc-400 whitespace-nowrap">${eDate}</td>
              <td class="px-8 py-4">
                <div class="flex items-center gap-2 ${statusColor} text-[13px]">
                  <span class="w-2 h-2 rounded-full ${statusDot}"></span>
                  ${statusText}
                </div>
              </td>
              <td class="px-8 py-4 text-right">
                <button onclick="changeUserTier('${u.username}')" class="text-primary hover:text-white transition-colors text-xs font-bold cursor-pointer bg-transparent border-none">Sửa gói</button>
              </td>
            </tr>
          `;
        }).join('');
      }

      // 4. Render Manual Bank Approvals Table
      function renderManualApprovals() {
        const pendingLogs = loadedLogs.filter(item => item.method === 'manual' && item.status === 'pending');
        const section = document.getElementById('manual-approvals-section');
        const tbody = document.getElementById('manualApprovalsBody');

        if (!tbody || !section) return;

        if (pendingLogs.length === 0) {
          section.classList.add('hidden');
          return;
        }

        section.classList.remove('hidden');

        tbody.innerHTML = pendingLogs.map(item => {
          const formattedPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price);
          const imgHtml = `<button onclick="viewReceiptImage('${item.txid}')" class="text-primary hover:underline font-bold text-xs cursor-pointer flex items-center gap-1 bg-transparent border-none"><span class="material-symbols-outlined text-sm">image</span>Xem ảnh</button>`;

          return `
            <tr class="hover:bg-white/5 transition-colors">
              <td class="px-8 py-4 font-mono text-zinc-400">${(item.txid || '').substring(0, 10)}...</td>
              <td class="px-8 py-4 font-semibold text-white">${item.username}</td>
              <td class="px-8 py-4 text-zinc-300">${item.packageTitle} (${item.cycle === 'annual' ? 'Hàng năm' : 'Hàng tháng'})</td>
              <td class="px-8 py-4 text-zinc-300 font-bold">${formattedPrice}</td>
              <td class="px-8 py-4">${imgHtml}</td>
              <td class="px-8 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <button onclick="approveManualTx('${item.txid}')" class="px-3 py-1 rounded bg-emerald-500 text-slate-950 font-bold hover:brightness-110 active:scale-95 transition-all cursor-pointer text-[11px] border-none">Duyệt</button>
                  <button onclick="declineManualTx('${item.txid}')" class="px-3 py-1 rounded bg-red-500/10 border border-red-500/20 text-red-400 font-bold hover:bg-red-500/20 active:scale-95 transition-all cursor-pointer text-[11px]">Từ chối</button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      // 5. Expose Manual Actions Globally
      window.viewReceiptImage = function(txid) {
        const tx = loadedLogs.find(item => item.txid === txid);
        if (!tx || !tx.receiptImg) return;

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Xem hóa đơn chuyển khoản',
            message: `
              <div class="flex flex-col items-center gap-4">
                <p class="text-xs text-zinc-400">User: <strong class="text-white">${tx.username}</strong> | Mã GD: <strong class="text-white">${tx.txid}</strong></p>
                <div class="max-w-xs border border-glass-stroke rounded-xl overflow-hidden bg-black flex items-center justify-center">
                  <img src="${tx.receiptImg}" class="w-full h-auto object-contain max-h-[350px]" alt="Receipt" />
                </div>
              </div>
            `,
            type: 'info',
            confirmText: 'Đóng',
            cancelText: '',
            onConfirm: () => {}
          });
        }
      };

      window.approveManualTx = function(txid) {
        const tx = loadedLogs.find(item => item.txid === txid);
        if (!tx) return;

        const cycleDays = tx.cycle === 'annual' ? 365 : 30;
        const expiryDate = new Date(Date.now() + 3600 * 1000 * 24 * cycleDays).toISOString();

        const performApprove = async () => {
          try {
            // Update transaction status
            const resPayment = await fetch('/api/user/payments', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                txid: tx.txid,
                username: tx.username,
                email: tx.email,
                packageTitle: tx.packageTitle,
                price: tx.price,
                cycle: tx.cycle,
                method: tx.method,
                status: 'approved',
                receiptImg: tx.receiptImg
              })
            });

            if (!resPayment.ok) {
              throw new Error('Không thể duyệt hóa đơn.');
            }

            // Update user package
            const resUser = await fetch('/api/admin/members', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'edit',
                username: tx.username,
                package: tx.packageTitle,
                joinDate: new Date().toISOString(),
                expiryDate: expiryDate,
                status: 'active'
              })
            });

            if (!resUser.ok) {
              throw new Error('Duyệt hóa đơn thành công nhưng không thể cập nhật gói thành viên.');
            }

            // Update localStorage txa_user_subscription if current user
            const currentLoggedIn = localStorage.getItem('tlogged_in_as');
            if (currentLoggedIn === tx.username) {
              localStorage.setItem('txa_user_subscription', JSON.stringify({
                username: tx.username,
                tier: tx.packageTitle,
                status: 'active',
                price: tx.price,
                cycle: tx.cycle,
                expiry: expiryDate,
                updatedAt: new Date().toISOString()
              }));
            }

            if (window.showGlobalToast) {
              window.showGlobalToast('Phê duyệt giao dịch thành công!', 'success');
            }
            
            loadAllData();
          } catch(err) {
            if (window.showGlobalToast) {
              window.showGlobalToast(`Lỗi: ${err.message}`, 'error');
            }
          }
        };

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Phê duyệt giao dịch thủ công',
            message: `Bạn có chắc chắn muốn phê duyệt giao dịch số tiền ${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(tx.price)} của user "${tx.username}"?`,
            type: 'info',
            confirmText: 'Duyệt',
            cancelText: 'Hủy',
            onConfirm: performApprove
          });
        } else if (confirm('Duyệt giao dịch này?')) {
          performApprove();
        }
      };

      window.declineManualTx = function(txid) {
        const tx = loadedLogs.find(item => item.txid === txid);
        if (!tx) return;

        const performDecline = async () => {
          try {
            const resPayment = await fetch('/api/user/payments', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                txid: tx.txid,
                username: tx.username,
                email: tx.email,
                packageTitle: tx.packageTitle,
                price: tx.price,
                cycle: tx.cycle,
                method: tx.method,
                status: 'declined',
                receiptImg: tx.receiptImg
              })
            });

            if (resPayment.ok) {
              if (window.showGlobalToast) {
                window.showGlobalToast('Đã từ chối giao dịch này.', 'info');
              }
              loadAllData();
            } else {
              if (window.showGlobalToast) {
                window.showGlobalToast('Lỗi từ chối giao dịch!', 'error');
              }
            }
          } catch(err) {
            console.error(err);
          }
        };

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Từ chối giao dịch thủ công',
            message: `Bạn có chắc muốn từ chối giao dịch của user "${tx.username}"?`,
            type: 'danger',
            confirmText: 'Từ chối',
            cancelText: 'Hủy',
            onConfirm: performDecline
          });
        } else if (confirm('Từ chối giao dịch này?')) {
          performDecline();
        }
      };

      // 6. Change User Tier Directly
      window.changeUserTier = function(username) {
        const u = loadedUsers.find(user => user.username === username);
        if (!u) return;

        const newTier = u.package && u.package.includes('VIP') ? 'Free' : 'VIP 1 Year';
        const expiryDate = newTier === 'Free' ? '' : new Date(Date.now() + 3600 * 1000 * 24 * 365).toISOString();

        const changeTier = async () => {
          try {
            const res = await fetch('/api/admin/members', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'edit',
                username: username,
                package: newTier,
                expiryDate: expiryDate,
                status: 'active'
              })
            });

            if (res.ok) {
              const currentLoggedIn = localStorage.getItem('tlogged_in_as');
              if (currentLoggedIn === username) {
                if (newTier === 'Free') {
                  localStorage.removeItem('txa_user_subscription');
                } else {
                  localStorage.setItem('txa_user_subscription', JSON.stringify({
                    username: username,
                    tier: newTier,
                    status: 'active',
                    price: 699000,
                    cycle: 'annual',
                    expiry: expiryDate,
                    updatedAt: new Date().toISOString()
                  }));
                }
              }

              if (window.showGlobalToast) {
                window.showGlobalToast(`Đã cập nhật gói thành công cho ${username}!`, 'success');
              }
              loadAllData();
            } else {
              if (window.showGlobalToast) {
                window.showGlobalToast('Cập nhật gói thất bại!', 'error');
              }
            }
          } catch(err) {
            console.error(err);
          }
        };

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Thay đổi gói cước thành viên',
            message: `Bạn có muốn đổi gói của "${username}" từ <strong>${u.package || 'Free'}</strong> sang <strong>${newTier}</strong>?`,
            type: 'info',
            confirmText: 'Thay đổi',
            cancelText: 'Hủy',
            onConfirm: changeTier
          });
        } else if (confirm('Đổi gói của người dùng?')) {
          changeTier();
        }
      };

      let loadedSettings = {};
      async function loadSettings() {
        try {
          const res = await fetch('/api/admin/settings');
          if (res.ok) {
            const result = await res.json();
            loadedSettings = result.data || {};
          }
        } catch (e) {
          console.error(e);
        }
      }

      window.openEditPlanModal = async function(packageId) {
        const pkg = loadedSettings.packages?.find(p => p.id === packageId);
        if (!pkg) return;

        // Get system servers list
        let systemServers = [];
        try {
          const res = await fetch('/api/admin/servers');
          if (res.ok) {
            const data = await res.json();
            if (data && data.status === 'success') {
              systemServers = data.data;
            }
          }
        } catch (e) {
          console.error('Error loading servers from database:', e);
        }

        if (!systemServers || systemServers.length === 0) {
          systemServers = ["DongMePhim VIP", "FPT Fast", "Vietsub", "Thuyết Minh", "Lồng Tiếng"];
        }

        const allowedServers = pkg.permissions?.allowed_servers || [];

        // Build HTML for server checklist
        const serversHtml = systemServers.map(srv => {
          const checked = allowedServers.includes(srv) ? 'checked' : '';
          return `
            <label class="flex items-center gap-2 text-xs text-zinc-300 bg-white/5 border border-glass-stroke/40 rounded-lg p-2.5 hover:bg-white/10 cursor-pointer select-none">
              <input type="checkbox" name="allowed_servers" value="${srv}" ${checked} class="accent-primary" />
              <span>${srv}</span>
            </label>
          `;
        }).join('');

        const styleType = pkg.style_type || 'default';
        const isFree = packageId === 'free';

        const modalContentHtml = `
          <form id="edit-plan-form" class="space-y-4 text-left max-h-[75vh] overflow-y-auto pr-1">
            <input type="hidden" name="id" value="${pkg.id}" />
            
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="text-[10px] text-zinc-400 font-bold uppercase">Tên gói cước</label>
                <input type="text" name="title" value="${pkg.title}" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" required />
              </div>
              <div class="space-y-1 relative group/lock">
                <label class="text-[10px] text-zinc-400 font-bold uppercase">Giá tiền (VND)</label>
                <input type="number" name="price" value="${pkg.price}" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" ${isFree ? 'disabled' : ''} required />
                ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
              </div>
            </div>

            <div class="space-y-1">
              <label class="text-[10px] text-zinc-400 font-bold uppercase">Các đặc quyền (cách nhau bằng dấu phẩy)</label>
              <textarea name="features" class="w-full h-16 bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" placeholder="Quyền 1, Quyền 2, Quyền 3..." required>${pkg.features ? pkg.features.join(', ') : ''}</textarea>
            </div>

            <div class="border-t border-glass-stroke/50 pt-3 space-y-3">
              <h4 class="text-xs font-black text-primary uppercase">Cấu hình giao diện và màu sắc</h4>
              <div class="grid grid-cols-2 gap-4">
                <div class="space-y-1 relative group/lock">
                  <label class="text-[10px] text-zinc-400 font-bold uppercase">Loại giao diện</label>
                  <select name="style_type" id="edit-style-type" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" ${isFree ? 'disabled' : ''} onchange="toggleColorInput(this.value)">
                    <option value="default" ${styleType === 'default' ? 'selected' : ''}>Mặc định (Tím/Xanh)</option>
                    <option value="custom_color" ${styleType === 'custom_color' ? 'selected' : ''}>Màu tùy chỉnh (Hex)</option>
                    <option value="rainbow_effect" ${styleType === 'rainbow_effect' ? 'selected' : ''}>Hiệu ứng Cầu vồng 7 màu</option>
                  </select>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="space-y-1" id="custom-color-wrapper" style="display: ${styleType === 'custom_color' ? 'block' : 'none'}">
                  <label class="text-[10px] text-zinc-400 font-bold uppercase">Mã màu tùy chỉnh</label>
                  <div class="flex gap-2">
                    <input type="color" id="edit-custom-color-picker" value="${pkg.custom_color || '#7c3aed'}" oninput="document.getElementById('edit-custom-color').value = this.value" class="w-9 h-9 bg-transparent border border-glass-stroke rounded-lg p-0 cursor-pointer" />
                    <input type="text" id="edit-custom-color" name="custom_color" value="${pkg.custom_color || '#7c3aed'}" placeholder="#000000" class="flex-1 bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white uppercase font-mono" />
                  </div>
                </div>
              </div>
            </div>

            <div class="border-t border-glass-stroke/50 pt-3 space-y-3">
              <h4 class="text-xs font-black text-primary uppercase">Cấu hình phân quyền chi tiết</h4>
              <div class="grid grid-cols-2 gap-4">
                <div class="space-y-1 relative group/lock">
                  <label class="text-[10px] text-zinc-400 font-bold uppercase">Chất lượng tối đa</label>
                  <select name="max_resolution" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" ${isFree ? 'disabled' : ''}>
                    <option value="SD" ${pkg.permissions?.max_resolution === 'SD' ? 'selected' : ''}>SD (Standard Definition)</option>
                    <option value="HD" ${pkg.permissions?.max_resolution === 'HD' ? 'selected' : ''}>HD (High Definition)</option>
                    <option value="FHD" ${pkg.permissions?.max_resolution === 'FHD' ? 'selected' : ''}>Full HD (1080p)</option>
                    <option value="4K" ${pkg.permissions?.max_resolution === '4K' ? 'selected' : ''}>Ultra HD 4K</option>
                  </select>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="space-y-1 relative group/lock">
                  <label class="text-[10px] text-zinc-400 font-bold uppercase">Giới hạn Playlist phim</label>
                  <input type="number" name="max_playlists" value="${pkg.permissions?.max_playlists || 10}" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" ${isFree ? 'disabled' : ''} required />
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3 pt-2">
                <div class="relative group/lock">
                  <label class="flex items-center gap-2 text-xs text-zinc-300 cursor-pointer select-none">
                    <input type="checkbox" name="watch_together" value="true" ${pkg.permissions?.watch_together ? 'checked' : ''} ${isFree ? 'disabled' : ''} class="accent-primary" />
                    <span>Quyền Xem Chung</span>
                  </label>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="relative group/lock">
                  <label class="flex items-center gap-2 text-xs text-zinc-300 cursor-pointer select-none">
                    <input type="checkbox" name="hide_watermark" value="true" ${pkg.permissions?.hide_watermark ? 'checked' : ''} ${isFree ? 'disabled' : ''} class="accent-primary" />
                    <span>Bỏ Watermark</span>
                  </label>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="relative group/lock">
                  <label class="flex items-center gap-2 text-xs text-zinc-300 cursor-pointer select-none">
                    <input type="checkbox" name="vip_badge" value="true" ${pkg.permissions?.vip_badge ? 'checked' : ''} ${isFree ? 'disabled' : ''} class="accent-primary" />
                    <span>Huy hiệu VIP</span>
                  </label>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="relative group/lock">
                  <label class="flex items-center gap-2 text-xs text-zinc-300 cursor-pointer select-none">
                    <input type="checkbox" name="bypass_ads" value="true" ${pkg.permissions?.bypass_ads ? 'checked' : ''} ${isFree ? 'disabled' : ''} class="accent-primary" />
                    <span>Bỏ qua Quảng cáo</span>
                  </label>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
              </div>
            </div>

            <div class="border-t border-glass-stroke/50 pt-3 space-y-2">
              <label class="text-[10px] text-zinc-400 font-bold uppercase block">Danh sách Server phát được phép truy cập</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                ${serversHtml}
              </div>
            </div>

            <div class="flex gap-2 justify-end pt-4 border-t border-glass-stroke/50">
              <button type="button" onclick="closeEditPlanModal()" class="px-4 py-2 rounded-xl bg-white/5 text-zinc-400 font-bold hover:bg-white/10 active:scale-95 transition-all text-xs cursor-pointer border border-glass-stroke/30">Hủy</button>
              <button type="submit" class="px-5 py-2 bg-primary text-slate-950 font-black rounded-xl hover:brightness-110 active:scale-95 transition-all text-xs cursor-pointer border-none shadow-lg shadow-primary/20">Lưu thay đổi</button>
            </div>
          </form>
        `;

        if (window.txamodal) {
          window.txamodal.show({
            title: `Cập nhật cấu hình: ${pkg.title}`,
            content: modalContentHtml,
            type: 'info',
            confirmText: '', // Hide default confirm
            cancelText: '',
            onConfirm: () => {}
          });

          // Bind form submit
          const form = document.getElementById('edit-plan-form');
          if (form) {
            form.onsubmit = async function(e) {
              e.preventDefault();
              const formData = new FormData(form);
              
              // Map updated values back to loadedSettings
              const targetPkg = loadedSettings.packages.find(p => p.id === packageId);
              if (targetPkg) {
                targetPkg.title = formData.get('title');
                if (!isFree) {
                  targetPkg.price = parseInt(formData.get('price') || '0');
                  targetPkg.style_type = formData.get('style_type');
                  if (targetPkg.style_type === 'custom_color') {
                    targetPkg.custom_color = formData.get('custom_color');
                  } else {
                    delete targetPkg.custom_color;
                  }
                }
                
                targetPkg.features = formData.get('features').split(',').map(s => s.trim()).filter(s => s.length > 0);
                
                // Permissions
                const allowed_servers = [];
                form.querySelectorAll('input[name="allowed_servers"]:checked').forEach(el => {
                  allowed_servers.push(el.value);
                });

                if (isFree) {
                  targetPkg.permissions = {
                    max_resolution: targetPkg.permissions?.max_resolution || 'SD',
                    max_playlists: targetPkg.permissions?.max_playlists || 10,
                    watch_together: targetPkg.permissions?.watch_together || false,
                    hide_watermark: targetPkg.permissions?.hide_watermark || false,
                    vip_badge: targetPkg.permissions?.vip_badge || false,
                    bypass_ads: targetPkg.permissions?.bypass_ads || false,
                    allowed_servers: allowed_servers
                  };
                } else {
                  targetPkg.permissions = {
                    max_resolution: formData.get('max_resolution'),
                    max_playlists: parseInt(formData.get('max_playlists') || '10'),
                    watch_together: form.querySelector('input[name="watch_together"]').checked,
                    hide_watermark: form.querySelector('input[name="hide_watermark"]').checked,
                    vip_badge: form.querySelector('input[name="vip_badge"]').checked,
                    bypass_ads: form.querySelector('input[name="bypass_ads"]').checked,
                    allowed_servers: allowed_servers
                  };
                }

                // Save to API
                try {
                  const saveRes = await fetch('/api/admin/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(loadedSettings)
                  });
                  if (saveRes.ok) {
                    if (window.showGlobalToast) window.showGlobalToast('Cập nhật gói cước thành công!', 'success');
                    closeEditPlanModal();
                    setTimeout(() => window.location.reload(), 1000);
                  } else {
                    if (window.showGlobalToast) window.showGlobalToast('Cập nhật thất bại!', 'error');
                  }
                } catch(err) {
                  if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API!', 'error');
                }
              }
            };
          }
        }
      };

      window.toggleColorInput = function(val) {
        const wrapper = document.getElementById('custom-color-wrapper');
        if (wrapper) {
          wrapper.style.display = val === 'custom_color' ? 'block' : 'none';
        }
      };

      window.closeEditPlanModal = function() {
        const modal = document.getElementById('txa-global-modal');
        if (modal) {
          modal.classList.add('opacity-0');
          setTimeout(() => { modal.classList.add('hidden'); modal.classList.remove('flex'); }, 200);
          document.body.style.overflow = '';
        }
      };

      function initSubscriptionsPage() {
        checkPaymentGate();
        loadAllData();
        loadSettings();

        // Bind Search Input
        const searchInput = document.getElementById('activeSubsSearch');
        searchInput?.addEventListener('input', renderActiveSubscriptions);
      }

      // Initial running
      initSubscriptionsPage();
      document.addEventListener('astro:page-load', initSubscriptionsPage);
    })();
  </script>
</AdminLayout>
