              if (colorWrapper) {
                colorWrapper.style.display = this.value === 'custom_color' ? 'block' : 'none';
              }
            };
          }

          // Update Select All buttons status and bind form submit
          const form = document.getElementById('create-plan-form');
          if (form) {
            const checkboxes = form.querySelectorAll('input[name="allowed_servers"]');
            const toggleBtn = form.querySelector('button[onclick="toggleSelectAllServers(this)"]');
            const updateToggleBtnText = () => {
              if (checkboxes.length > 0 && toggleBtn) {
                const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                toggleBtn.textContent = allChecked ? 'Bỏ chọn tất cả' : 'Chọn tất cả';
              }
            };
            checkboxes.forEach(cb => cb.addEventListener('change', updateToggleBtnText));
            updateToggleBtnText();

            // Bind form price inputs to calculate saving discount dynamically
            const priceInput = document.getElementById('create-plan-price');
            const annualPriceInput = document.getElementById('create-plan-annual-price');
            const savingBadge = document.getElementById('create-saving-badge');

            const updateModalSaving = () => {
              if (!priceInput || !annualPriceInput || !savingBadge) return;
              const monthly = parseFloat(priceInput.value) || 0;
              const annual = parseFloat(annualPriceInput.value) || 0;
              if (monthly > 0 && annual > 0) {
                const originalAnnual = monthly * 12;
                if (annual < originalAnnual) {
                  const percent = Math.round((1 - annual / originalAnnual) * 100);
                  savingBadge.textContent = `Tiết kiệm ${percent}%`;
                  savingBadge.classList.remove('hidden');
                  return;
                }
              }
              savingBadge.classList.add('hidden');
            };

            if (priceInput && annualPriceInput) {
              priceInput.addEventListener('input', updateModalSaving);
              annualPriceInput.addEventListener('input', updateModalSaving);
            }

            form.onsubmit = async function(e) {
              e.preventDefault();
              const formData = new FormData(form);
              
              const title = formData.get('title');
              const newId = 'vip_' + Math.random().toString(36).substring(2, 8); // unique id
              
              const allowed_servers = [];
              form.querySelectorAll('input[name="allowed_servers"]:checked').forEach(el => {
                allowed_servers.push(el.value);
              });

              const newPlan = {
                id: newId,
                title: title,
                price: parseInt(formData.get('price') || '0'),
                annual_price: parseInt(formData.get('annual_price') || '0'),
                style_type: formData.get('style_type'),
                custom_color: formData.get('style_type') === 'custom_color' ? formData.get('custom_color') : undefined,
                features: formData.get('features').split(',').map(s => s.trim()).filter(s => s.length > 0),
                permissions: {
                  max_resolution: formData.get('max_resolution'),
                  max_playlists: parseInt(formData.get('max_playlists') || '100'),
                  watch_together: form.querySelector('input[name="watch_together"]').checked,
                  hide_watermark: form.querySelector('input[name="hide_watermark"]').checked,
                  vip_badge: form.querySelector('input[name="vip_badge"]').checked,
                  bypass_ads: form.querySelector('input[name="bypass_ads"]').checked,
                  allowed_servers: allowed_servers
                }
              };

              if (!loadedSettings.packages) {
                loadedSettings.packages = [];
              }
              loadedSettings.packages.push(newPlan);

              // Save to API
              try {
                const saveRes = await fetch('/api/admin/settings', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(loadedSettings)
                });
                if (saveRes.ok) {
                  if (window.showGlobalToast) window.showGlobalToast('Tạo gói cước mới thành công!', 'success');
                  closeEditPlanModal();
                  setTimeout(() => window.location.reload(), 1000);
                } else {
                  if (window.showGlobalToast) window.showGlobalToast('Tạo gói cước thất bại!', 'error');
                }
              } catch(err) {
                if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API!', 'error');
              }
            };
          }
        }
      };

      window.togglePackageEnable = async function(packageId, newStatus) {
        try {
          if (!loadedSettings.packages) await loadSettings();
          const targetPkg = loadedSettings.packages?.find(p => p.id === packageId);
          if (targetPkg) {
            targetPkg.enabled = newStatus;
            const saveRes = await fetch('/api/admin/settings', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(loadedSettings)
            });
            if (saveRes.ok) {
              if (window.showGlobalToast) window.showGlobalToast(`Đã ${newStatus ? 'BẬT' : 'TẮT'} gói cước thành công!`, 'success');
              setTimeout(() => window.location.reload(), 800);
            } else {
              if (window.showGlobalToast) window.showGlobalToast('Cập nhật thất bại!', 'error');
            }
          }
        } catch (e) {
          console.error(e);
          if (window.showGlobalToast) window.showGlobalToast('Lỗi khi đổi trạng thái gói!', 'error');
        }
      };

