              <div class="space-y-1">
                <label class="text-[10px] text-zinc-400 font-bold uppercase">Tên gói cước</label>
                <input type="text" name="title" value="${pkg.title}" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" required />
              </div>
              <div class="space-y-1">
                <label class="text-[10px] text-zinc-400 font-bold uppercase">Giá hàng tháng (VND)</label>
                <input type="number" id="edit-plan-price" name="price" value="${pkg.price}" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" ${isFree ? 'disabled' : ''} required />
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-1 relative group/lock">
                <label class="text-[10px] text-zinc-400 font-bold uppercase flex justify-between items-center">
                  <span>Giá hàng năm (VND)</span>
                  <span id="modal-saving-badge" class="hidden px-1.5 py-0.2 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded font-black text-[9px] uppercase tracking-wider font-label-caps">Tự tính</span>
                </label>
                <input type="number" id="edit-plan-annual-price" name="annual_price" value="${pkg.annual_price || ''}" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" ${isFree ? 'disabled' : ''} ${!isFree ? 'required' : ''} />
              </div>
            </div>

            <div class="space-y-1">
              <label class="text-[10px] text-zinc-400 font-bold uppercase">Các đặc quyền (cách nhau bằng dấu phẩy)</label>
              <textarea name="features" class="w-full h-16 bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" placeholder="Quyền 1, Quyền 2, Quyền 3..." required>${pkg.features ? pkg.features.join(', ') : ''}</textarea>
            </div>

            <div class="border-t border-glass-stroke/50 pt-3 space-y-3">
              <h4 class="text-xs font-black text-primary uppercase">Cấu hình giao diện và màu sắc</h4>
              <div class="grid grid-cols-2 gap-4">
                <div class="space-y-1 relative group/lock">
                  <label class="text-[10px] text-zinc-400 font-bold uppercase">Loại giao diện</label>
                  <select name="style_type" id="edit-style-type" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" ${isFree ? 'disabled' : ''} onchange="toggleColorInput(this.value)">
                    <option value="default" ${styleType === 'default' ? 'selected' : ''}>Mặc định (Tím/Xanh)</option>
                    <option value="custom_color" ${styleType === 'custom_color' ? 'selected' : ''}>Màu tùy chỉnh (Hex)</option>
                    <option value="rainbow_effect" ${styleType === 'rainbow_effect' ? 'selected' : ''}>Hiệu ứng Cầu vồng 7 màu</option>
                  </select>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="space-y-1" id="custom-color-wrapper" style="display: ${styleType === 'custom_color' ? 'block' : 'none'}">
                  <label class="text-[10px] text-zinc-400 font-bold uppercase">Mã màu tùy chỉnh</label>
                  <div class="flex gap-2">
                    <input type="color" id="edit-custom-color-picker" value="${pkg.custom_color || '#7c3aed'}" oninput="document.getElementById('edit-custom-color').value = this.value" class="w-9 h-9 bg-transparent border border-glass-stroke rounded-lg p-0 cursor-pointer" />
                    <input type="text" id="edit-custom-color" name="custom_color" value="${pkg.custom_color || '#7c3aed'}" placeholder="#000000" class="flex-1 bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white uppercase font-mono" />
                  </div>
                </div>
              </div>
            </div>

            <div class="border-t border-glass-stroke/50 pt-3 space-y-3">
              <h4 class="text-xs font-black text-primary uppercase">Cấu hình phân quyền chi tiết</h4>
              <div class="grid grid-cols-2 gap-4">
                <div class="space-y-1 relative group/lock">
                  <label class="text-[10px] text-zinc-400 font-bold uppercase">Chất lượng tối đa</label>
                  <select name="max_resolution" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" ${isFree ? 'disabled' : ''}>
                    <option value="SD" ${pkg.permissions?.max_resolution === 'SD' ? 'selected' : ''}>SD (Standard Definition)</option>
                    <option value="HD" ${pkg.permissions?.max_resolution === 'HD' ? 'selected' : ''}>HD (High Definition)</option>
                    <option value="FHD" ${pkg.permissions?.max_resolution === 'FHD' ? 'selected' : ''}>Full HD (1080p)</option>
                    <option value="4K" ${pkg.permissions?.max_resolution === '4K' ? 'selected' : ''}>Ultra HD 4K</option>
                  </select>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="space-y-1 relative group/lock">
                  <label class="text-[10px] text-zinc-400 font-bold uppercase">Giới hạn Playlist phim</label>
                  <input type="number" name="max_playlists" value="${pkg.permissions?.max_playlists || 10}" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" ${isFree ? 'disabled' : ''} required />
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3 pt-2">
                <div class="relative group/lock">
                  <label class="flex items-center gap-2 text-xs text-zinc-300 cursor-pointer select-none">
                    <input type="checkbox" name="watch_together" value="true" ${pkg.permissions?.watch_together ? 'checked' : ''} ${isFree ? 'disabled' : ''} class="accent-primary" />
                    <span>Quyền Xem Chung</span>
                  </label>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="relative group/lock">
                  <label class="flex items-center gap-2 text-xs text-zinc-300 cursor-pointer select-none">
                    <input type="checkbox" name="hide_watermark" value="true" ${pkg.permissions?.hide_watermark ? 'checked' : ''} ${isFree ? 'disabled' : ''} class="accent-primary" />
                    <span>Bỏ Watermark</span>
                  </label>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="relative group/lock">
                  <label class="flex items-center gap-2 text-xs text-zinc-300 cursor-pointer select-none">
                    <input type="checkbox" name="vip_badge" value="true" ${pkg.permissions?.vip_badge ? 'checked' : ''} ${isFree ? 'disabled' : ''} class="accent-primary" />
                    <span>Huy hiệu VIP</span>
                  </label>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
                <div class="relative group/lock">
                  <label class="flex items-center gap-2 text-xs text-zinc-300 cursor-pointer select-none">
                    <input type="checkbox" name="bypass_ads" value="true" ${pkg.permissions?.bypass_ads ? 'checked' : ''} ${isFree ? 'disabled' : ''} class="accent-primary" />
                    <span>Bỏ qua Quảng cáo</span>
                  </label>
                  ${isFree ? '<span class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-1.5 w-max text-[9px] p-2 rounded-lg bg-black border border-white/10 opacity-0 group-hover/lock:opacity-100 transition-opacity z-50 whitespace-nowrap shadow-xl">Mặc định khóa đối với gói Free</span>' : ''}
                </div>
              </div>
            </div>

            <div class="border-t border-glass-stroke/50 pt-3 space-y-2">
              <div class="flex justify-between items-center mb-1">
                <label class="text-[10px] text-zinc-400 font-bold uppercase block">Danh sách Server phát được phép truy cập</label>
                <button type="button" onclick="toggleSelectAllServers(this)" class="text-[10px] text-primary hover:underline font-bold bg-transparent border-none cursor-pointer">Chọn tất cả</button>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                ${serversHtml}
              </div>
            </div>

            <div class="flex gap-2 justify-end pt-4 border-t border-glass-stroke/50">
              <button type="button" onclick="closeEditPlanModal()" class="px-4 py-2 rounded-xl bg-white/5 text-zinc-400 font-bold hover:bg-white/10 active:scale-95 transition-all text-xs cursor-pointer border border-glass-stroke/30">Hủy</button>
              <button type="submit" class="px-5 py-2 bg-primary text-slate-950 font-black rounded-xl hover:brightness-110 active:scale-95 transition-all text-xs cursor-pointer border-none shadow-lg shadow-primary/20">Lưu thay đổi</button>
            </div>
          </form>
        `;

        if (window.txamodal) {
          window.txamodal.show({
            title: `Cập nhật cấu hình: ${pkg.title}`,
            content: modalContentHtml,
            type: 'info',
            confirmText: '', // Hide default confirm
            cancelText: '',
            onConfirm: () => {}
          });

          // Bind form price inputs to calculate saving discount dynamically
          const priceInput = document.getElementById('edit-plan-price');
          const annualPriceInput = document.getElementById('edit-plan-annual-price');
          const savingBadge = document.getElementById('modal-saving-badge');

          function updateModalSaving() {
            if (!priceInput || !annualPriceInput || !savingBadge) return;
            const monthly = parseFloat(priceInput.value) || 0;
            const annual = parseFloat(annualPriceInput.value) || 0;
            if (monthly > 0 && annual > 0) {
              const originalAnnual = monthly * 12;
              if (annual < originalAnnual) {
                const percent = Math.round((1 - annual / originalAnnual) * 100);
                savingBadge.textContent = `Tiết kiệm ${percent}%`;
                savingBadge.classList.remove('hidden');
                return;
              }
            }
            savingBadge.classList.add('hidden');
          }

          if (priceInput && annualPriceInput) {
            priceInput.addEventListener('input', updateModalSaving);
            annualPriceInput.addEventListener('input', updateModalSaving);
            updateModalSaving(); // initial run
          }

          // Bind form submit
          const form = document.getElementById('edit-plan-form');
          if (form) {
            const checkboxes = form.querySelectorAll('input[name="allowed_servers"]');
            const toggleBtn = form.querySelector('button[onclick="toggleSelectAllServers(this)"]');
            const updateToggleBtnText = () => {
              if (checkboxes.length > 0 && toggleBtn) {
                const allChecked = Array.from(checkboxes).every(cb => cb.checked);
                toggleBtn.textContent = allChecked ? 'Bỏ chọn tất cả' : 'Chọn tất cả';
              }
            };
            checkboxes.forEach(cb => cb.addEventListener('change', updateToggleBtnText));
            updateToggleBtnText();

            form.onsubmit = async function(e) {
              e.preventDefault();
              const formData = new FormData(form);
              
              // Map updated values back to loadedSettings
              const targetPkg = loadedSettings.packages.find(p => p.id === packageId);
              if (targetPkg) {
                targetPkg.title = formData.get('title');
                if (!isFree) {
                  targetPkg.price = parseInt(formData.get('price') || '0');
                  targetPkg.annual_price = parseInt(formData.get('annual_price') || '0');
                  targetPkg.style_type = formData.get('style_type');
                  if (targetPkg.style_type === 'custom_color') {
                    targetPkg.custom_color = formData.get('custom_color');
                  } else {
                    delete targetPkg.custom_color;
                  }
                }
                
                targetPkg.features = formData.get('features').split(',').map(s => s.trim()).filter(s => s.length > 0);
                
                // Permissions
                const allowed_servers = [];
                form.querySelectorAll('input[name="allowed_servers"]:checked').forEach(el => {
                  allowed_servers.push(el.value);
                });

                if (isFree) {
                  targetPkg.permissions = {
                    max_resolution: targetPkg.permissions?.max_resolution || 'SD',
                    max_playlists: targetPkg.permissions?.max_playlists || 10,
                    watch_together: targetPkg.permissions?.watch_together || false,
                    hide_watermark: targetPkg.permissions?.hide_watermark || false,
                    vip_badge: targetPkg.permissions?.vip_badge || false,
                    bypass_ads: targetPkg.permissions?.bypass_ads || false,
                    allowed_servers: allowed_servers
                  };
                } else {
                  targetPkg.permissions = {
                    max_resolution: formData.get('max_resolution'),
                    max_playlists: parseInt(formData.get('max_playlists') || '10'),
                    watch_together: form.querySelector('input[name="watch_together"]').checked,
                    hide_watermark: form.querySelector('input[name="hide_watermark"]').checked,
                    vip_badge: form.querySelector('input[name="vip_badge"]').checked,
                    bypass_ads: form.querySelector('input[name="bypass_ads"]').checked,
                    allowed_servers: allowed_servers
                  };
                }

                // Save to API
                try {
                  const saveRes = await fetch('/api/admin/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(loadedSettings)
                  });
                  if (saveRes.ok) {
                    if (window.showGlobalToast) window.showGlobalToast('Cập nhật gói cước thành công!', 'success');
                    closeEditPlanModal();
                    setTimeout(() => window.location.reload(), 1000);
                  } else {
                    if (window.showGlobalToast) window.showGlobalToast('Cập nhật thất bại!', 'error');
                  }
                } catch(err) {
                  if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API!', 'error');
                }
              }
            };
          }
        }
      };

      window.toggleColorInput = function(val) {
        const wrapper = document.getElementById('custom-color-wrapper');
        if (wrapper) {
          wrapper.style.display = val === 'custom_color' ? 'block' : 'none';
        }
      };

      window.toggleSelectAllServers = function(btn) {
        const form = btn.closest('form');
        if (!form) return;
        const checkboxes = form.querySelectorAll('input[name="allowed_servers"]');
        const allChecked = Array.from(checkboxes).every(cb => cb.checked);
        checkboxes.forEach(cb => {
          cb.checked = !allChecked;
        });
        btn.textContent = allChecked ? 'Chọn tất cả' : 'Bỏ chọn tất cả';
      };

      window.toggleMemberExpiryWrapper = function(val) {
        const wrapper = document.getElementById('member-expiry-wrapper');
        if (wrapper) {
          wrapper.style.display = (val.toLowerCase() === 'free') ? 'none' : 'block';
        }
      };

      window.closeEditPlanModal = function() {
        const modal = document.getElementById('txa-global-modal');
        if (modal) {
          modal.classList.add('opacity-0');
          setTimeout(() => { modal.classList.add('hidden'); modal.classList.remove('flex'); }, 200);
          document.body.style.overflow = '';
        }
      };

      function initSubscriptionsPage() {
        checkPaymentGate();
        loadAllData();
        loadSettings();

        // Bind Search Input
        const searchInput = document.getElementById('activeSubsSearch');
        searchInput?.addEventListener('input', renderActiveSubscriptions);
      }

      // Initial running
      initSubscriptionsPage();
      document.addEventListener('astro:page-load', initSubscriptionsPage);
    })();
  </script>
</AdminLayout>

