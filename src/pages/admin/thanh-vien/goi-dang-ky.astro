---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Quản lý Gói đăng ký">
  <div class="max-w-container-max mx-auto mt-4 pb-10">
    <!-- Header Section -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center py-8 gap-4">
      <div>
        <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Subscription Plans</h1>
        <p class="text-on-surface-variant mt-1">Manage service tiers, pricing, and active memberships.</p>
      </div>
      <button class="bg-primary-container hover:bg-primary-container/80 text-on-primary-container px-6 py-3 rounded-xl font-bold flex items-center gap-2 transition-all active:scale-95 cursor-pointer">
        <span class="material-symbols-outlined">add_circle</span>
        Create New Plan
      </button>
    </header>

    <!-- Subscription Tiers (Bento Grid Style) -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- Free Tier -->
      <div class="glass-card rounded-2xl p-6 flex flex-col relative overflow-hidden bg-surface-container-low border border-glass-stroke">
        <div class="flex justify-between items-start mb-6">
          <div class="p-3 bg-surface-container-high rounded-xl">
            <span class="material-symbols-outlined text-on-surface-variant">person</span>
          </div>
          <span class="px-3 py-1 bg-surface-container-highest rounded-full text-label-caps font-label-caps text-on-surface-variant">DEFAULT</span>
        </div>
        <h3 class="font-title-md text-title-md text-on-surface mb-2">Free Plan</h3>
        <div class="flex items-baseline gap-1 mb-6">
          <span class="text-headline-lg font-headline-lg text-3xl">0đ</span>
          <span class="text-on-surface-variant text-[14px]">/ Lifetime</span>
        </div>
        <ul class="space-y-4 mb-8">
          <li class="flex items-center gap-3 text-[14px]">
            <span class="material-symbols-outlined text-error text-[20px]">close</span>
            <span class="text-on-surface-variant">Contains Ads</span>
          </li>
          <li class="flex items-center gap-3 text-[14px]">
            <span class="material-symbols-outlined text-primary text-[20px]">check</span>
            <span class="text-on-surface">Standard Definition (SD)</span>
          </li>
          <li class="flex items-center gap-3 text-[14px]">
            <span class="material-symbols-outlined text-primary text-[20px]">check</span>
            <span class="text-on-surface">Limited Library</span>
          </li>
        </ul>
        <button class="mt-auto w-full py-3 rounded-lg border border-glass-stroke hover:bg-surface-container-high transition-colors text-on-surface font-semibold cursor-pointer">
          Edit Plan
        </button>
      </div>

      <!-- VIP 1 Month -->
      <div class="glass-card rounded-2xl p-6 flex flex-col relative overflow-hidden border-primary/40 bg-primary-container/5 shadow-[0_0_20px_rgba(124,58,237,0.1)]">
        <div class="absolute top-0 right-0">
          <div class="bg-primary px-6 py-1 rotate-45 translate-x-6 translate-y-2 text-on-primary-fixed font-bold text-[10px]">POPULAR</div>
        </div>
        <div class="flex justify-between items-start mb-6">
          <div class="p-3 bg-primary-container/20 rounded-xl">
            <span class="material-symbols-outlined text-primary">workspace_premium</span>
          </div>
        </div>
        <h3 class="font-title-md text-title-md text-primary mb-2">VIP 1 Month</h3>
        <div class="flex items-baseline gap-1 mb-6">
          <span class="text-headline-lg font-headline-lg text-3xl text-on-surface">69,000đ</span>
          <span class="text-on-surface-variant text-[14px]">/ Monthly</span>
        </div>
        <ul class="space-y-4 mb-8">
          <li class="flex items-center gap-3 text-[14px]">
            <span class="material-symbols-outlined text-secondary text-[20px]">verified</span>
            <span class="text-on-surface">No Advertisements</span>
          </li>
          <li class="flex items-center gap-3 text-[14px]">
            <span class="material-symbols-outlined text-secondary text-[20px]">verified</span>
            <span class="text-on-surface">4K UHD Streaming</span>
          </li>
          <li class="flex items-center gap-3 text-[14px]">
            <span class="material-symbols-outlined text-secondary text-[20px]">verified</span>
            <span class="text-on-surface">Full Library Access</span>
          </li>
        </ul>
        <button class="mt-auto w-full py-3 rounded-lg bg-primary-container text-on-primary-container font-bold hover:brightness-110 transition-all cursor-pointer shadow-lg shadow-primary-container/20">
          Edit Plan
        </button>
      </div>

      <!-- VIP 1 Year -->
      <div class="glass-card rounded-2xl p-6 flex flex-col relative overflow-hidden bg-surface-container-low border border-glass-stroke">
        <div class="flex justify-between items-start mb-6">
          <div class="p-3 bg-surface-container-high rounded-xl">
            <span class="material-symbols-outlined text-secondary">diamond</span>
          </div>
          <span class="px-3 py-1 bg-secondary/10 text-secondary border border-secondary/20 rounded-full text-label-caps font-label-caps text-xs">BEST VALUE</span>
        </div>
        <h3 class="font-title-md text-title-md text-on-surface mb-2">VIP 1 Year</h3>
        <div class="flex items-baseline gap-1 mb-6">
          <span class="text-headline-lg font-headline-lg text-3xl text-on-surface">699,000đ</span>
          <span class="text-on-surface-variant text-[14px]">/ Annually</span>
        </div>
        <ul class="space-y-4 mb-8">
          <li class="flex items-center gap-3 text-[14px]">
            <span class="material-symbols-outlined text-primary text-[20px]">check_circle</span>
            <span class="text-on-surface">Everything in Monthly VIP</span>
          </li>
          <li class="flex items-center gap-3 text-[14px]">
            <span class="material-symbols-outlined text-primary text-[20px]">check_circle</span>
            <span class="text-on-surface">Offline Downloads</span>
          </li>
          <li class="flex items-center gap-3 text-[14px]">
            <span class="material-symbols-outlined text-primary text-[20px]">check_circle</span>
            <span class="text-on-surface">Early Access Premières</span>
          </li>
        </ul>
        <button class="mt-auto w-full py-3 rounded-lg border border-glass-stroke hover:bg-surface-container-high transition-colors text-on-surface font-semibold cursor-pointer">
          Edit Plan
        </button>
      </div>
    </section>

    <!-- User Subscription List Section -->
    <section class="glass-panel rounded-2xl overflow-hidden">
      <div class="px-8 py-6 border-b border-glass-stroke flex justify-between items-center bg-surface-container-low/50">
        <h2 class="font-title-md text-title-md text-on-surface text-xl">Active Subscriptions</h2>
        <div class="flex items-center gap-4">
          <div class="relative hidden sm:block">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
            <input class="bg-surface-deep border border-glass-stroke rounded-full pl-10 pr-4 py-2 text-[14px] focus:outline-none focus:border-primary w-64 transition-all text-on-surface" placeholder="Search user email..." type="text"/>
          </div>
          <button class="p-2 hover:bg-surface-container-highest rounded-lg text-on-surface-variant transition-colors cursor-pointer">
            <span class="material-symbols-outlined">filter_list</span>
          </button>
        </div>
      </div>
      <div class="overflow-x-auto custom-scrollbar">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-surface-container/30">
              <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs">User</th>
              <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs">Current Plan</th>
              <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs">Join Date</th>
              <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs">Expiry Date</th>
              <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs">Status</th>
              <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-right text-xs">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-glass-stroke">
            <tr class="hover:bg-surface-container-high/30 transition-colors">
              <td class="px-8 py-5">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold">AL</div>
                  <div>
                    <p class="font-bold text-[14px] text-on-surface">Anh Le</p>
                    <p class="text-[12px] text-on-surface-variant">anhle@gmail.com</p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-5">
                <span class="text-[14px] px-3 py-1 bg-primary/10 text-primary rounded-full border border-primary/20 font-medium whitespace-nowrap">VIP 1 Month</span>
              </td>
              <td class="px-8 py-5 text-[14px] text-on-surface-variant whitespace-nowrap">Oct 12, 2023</td>
              <td class="px-8 py-5 text-[14px] text-on-surface-variant whitespace-nowrap">Nov 12, 2024</td>
              <td class="px-8 py-5">
                <div class="flex items-center gap-2 text-emerald-400 text-[14px]">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Active
                </div>
              </td>
              <td class="px-8 py-5 text-right">
                <button class="text-on-surface-variant hover:text-on-surface transition-colors p-1 cursor-pointer"><span class="material-symbols-outlined">more_vert</span></button>
              </td>
            </tr>
            <tr class="hover:bg-surface-container-high/30 transition-colors">
              <td class="px-8 py-5">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-secondary/20 flex items-center justify-center text-secondary font-bold">MH</div>
                  <div>
                    <p class="font-bold text-[14px] text-on-surface">Minh Hoang</p>
                    <p class="text-[12px] text-on-surface-variant">hoangm@hotmail.com</p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-5">
                <span class="text-[14px] px-3 py-1 bg-secondary/10 text-secondary rounded-full border border-secondary/20 font-medium whitespace-nowrap">VIP 1 Year</span>
              </td>
              <td class="px-8 py-5 text-[14px] text-on-surface-variant whitespace-nowrap">Jan 05, 2024</td>
              <td class="px-8 py-5 text-[14px] text-on-surface-variant whitespace-nowrap">Jan 05, 2025</td>
              <td class="px-8 py-5">
                <div class="flex items-center gap-2 text-emerald-400 text-[14px]">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Active
                </div>
              </td>
              <td class="px-8 py-5 text-right">
                <button class="text-on-surface-variant hover:text-on-surface transition-colors p-1 cursor-pointer"><span class="material-symbols-outlined">more_vert</span></button>
              </td>
            </tr>
            <tr class="hover:bg-surface-container-high/30 transition-colors">
              <td class="px-8 py-5">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center text-on-surface-variant font-bold">DT</div>
                  <div>
                    <p class="font-bold text-[14px] text-on-surface">Duy Tung</p>
                    <p class="text-[12px] text-on-surface-variant">tungd@outlook.com</p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-5">
                <span class="text-[14px] px-3 py-1 bg-surface-container-highest text-on-surface-variant rounded-full border border-glass-stroke font-medium whitespace-nowrap">Free</span>
              </td>
              <td class="px-8 py-5 text-[14px] text-on-surface-variant whitespace-nowrap">May 20, 2024</td>
              <td class="px-8 py-5 text-[14px] text-on-surface-variant whitespace-nowrap">—</td>
              <td class="px-8 py-5">
                <div class="flex items-center gap-2 text-on-surface-variant text-[14px]">
                  <span class="w-2 h-2 rounded-full bg-on-surface-variant/30"></span>
                  Standard
                </div>
              </td>
              <td class="px-8 py-5 text-right">
                <button class="text-on-surface-variant hover:text-on-surface transition-colors p-1 cursor-pointer"><span class="material-symbols-outlined">more_vert</span></button>
              </td>
            </tr>
            <tr class="hover:bg-surface-container-high/30 transition-colors">
              <td class="px-8 py-5">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-error/20 flex items-center justify-center text-error font-bold">KP</div>
                  <div>
                    <p class="font-bold text-[14px] text-on-surface">Kim Phượng</p>
                    <p class="text-[12px] text-on-surface-variant">phuongk@gmail.com</p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-5">
                <span class="text-[14px] px-3 py-1 bg-primary/10 text-primary rounded-full border border-primary/20 font-medium whitespace-nowrap">VIP 1 Month</span>
              </td>
              <td class="px-8 py-5 text-[14px] text-on-surface-variant whitespace-nowrap">Sep 10, 2023</td>
              <td class="px-8 py-5 text-[14px] text-on-surface-variant whitespace-nowrap">Oct 10, 2023</td>
              <td class="px-8 py-5">
                <div class="flex items-center gap-2 text-error text-[14px]">
                  <span class="w-2 h-2 rounded-full bg-error"></span>
                  Expired
                </div>
              </td>
              <td class="px-8 py-5 text-right">
                <button class="text-on-surface-variant hover:text-on-surface transition-colors p-1 cursor-pointer"><span class="material-symbols-outlined">more_vert</span></button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <!-- Pagination -->
      <div class="px-8 py-4 border-t border-glass-stroke flex justify-between items-center text-[13px] text-on-surface-variant">
        <p>Showing 4 of 1,248 users</p>
        <div class="flex gap-2">
          <button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer"><span class="material-symbols-outlined text-[20px]">chevron_left</span></button>
          <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary text-on-primary-fixed font-bold cursor-pointer">1</button>
          <button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer">2</button>
          <button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer">3</button>
          <button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer"><span class="material-symbols-outlined text-[20px]">chevron_right</span></button>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>
