---
import AdminLayout from '@layouts/AdminLayout.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
const packages = settings.packages || [];

const groupedPackages = packages.map((pkg: any) => {
  const isFree = pkg.id === 'free';
  return {
    ...pkg,
    monthlyPrice: pkg.price,
    monthlyId: pkg.id,
    annualPrice: pkg.annual_price,
    annualId: pkg.id
  };
});
---

<AdminLayout title="Quản lý Gói đăng ký">
  <div class="w-full mt-4 pb-10">
    <!-- Header Section -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center py-8 gap-4">
      <div>
        <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Subscription Plans</h1>
        <p class="text-on-surface-variant mt-1">Manage service tiers, pricing, and active memberships.</p>
      </div>
      <button onclick="openCreatePlanModal()" class="bg-primary-container hover:bg-primary-container/80 text-on-primary-container px-6 py-3 rounded-xl font-bold flex items-center gap-2 transition-all active:scale-95 cursor-pointer">
        <span class="material-symbols-outlined">add_circle</span>
        Create New Plan
      </button>
    </header>

    <!-- Payment Gate validation warning -->
    <div id="payment-gate-warning" class="hidden flex flex-col items-center justify-center p-12 text-center glass-panel rounded-3xl border border-glass-stroke max-w-2xl mx-auto my-12">
      <span class="material-symbols-outlined text-yellow-500 text-6xl mb-4 animate-pulse">warning</span>
      <h3 class="text-xl font-bold text-white mb-2">Chưa cấu hình phương thức thanh toán</h3>
      <p class="text-xs text-zinc-400 max-w-md mb-6 leading-relaxed">
        Để quản lý gói đăng ký và bán dịch vụ thành viên, vui lòng cấu hình ít nhất một phương thức thanh toán (chuyển khoản ngân hàng hoặc cổng tự động) trong phần cài đặt hệ thống.
      </p>
      <a href="/admin/cai-dat" class="px-6 py-3 bg-primary text-slate-950 rounded-xl font-bold text-xs hover:brightness-110 active:scale-95 transition-all cursor-pointer">
        Đi đến Cấu hình hệ thống
      </a>
    </div>

    <div id="subscription-plans-content" class="space-y-12">
      <!-- Subscription Tiers (Bento Grid Style) -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {groupedPackages.map((pkg) => {
          const isFree = pkg.id === 'free';
          const cardBorderClass = `package-border-${pkg.id}`;
          const cardGlowClass = `package-glow-${pkg.id}`;
          const textClass = `package-style-${pkg.id}`;
          const btnClass = isFree ? 'border border-glass-stroke hover:bg-surface-container-high text-on-surface' : `package-btn-${pkg.id} hover:brightness-110 active:scale-95 shadow-lg`;
          
          const isBypassKeyPkg = pkg.id === 'bypass_zalo' || pkg.id.includes('bypass') || pkg.title.toLowerCase().includes('bypass');
          const isEnabled = pkg.enabled ?? true;
          
          return (
            <div class={`glass-card rounded-2xl p-6 flex flex-col relative overflow-hidden border ${cardBorderClass} ${cardGlowClass} transition-all duration-300`}>
              {isBypassKeyPkg && (
                <div class="absolute inset-0 z-20 bg-black/65 backdrop-blur-[2px] flex flex-col items-center justify-center p-6 text-center gap-3" data-txatooltip="Gói cước hệ thống cố định, không cho phép chỉnh sửa hoặc xóa">
                  <div class="w-12 h-12 rounded-full bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-400">
                    <span class="material-symbols-outlined text-2xl">lock</span>
                  </div>
                  <span class="px-3 py-1 bg-purple-500/20 text-purple-300 border border-purple-500/30 rounded-full text-[10px] font-bold uppercase tracking-wider">Gói Cố Định Hệ Thống</span>
                  <p class="text-[11px] text-zinc-300 font-medium">Gói cước riêng cấp mã Key Bypass 15 thiết bị. Không cho phép chỉnh sửa cấu hình.</p>
                  
                  <div class="pt-2 pointer-events-auto">
                    <button onclick={`togglePackageEnable('${pkg.id}', ${!isEnabled})`} class={`px-5 py-2.5 rounded-xl font-bold text-xs flex items-center gap-2 transition-all cursor-pointer border-none ${isEnabled ? 'bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-lg shadow-emerald-500/20' : 'bg-rose-600 hover:bg-rose-500 text-white shadow-lg shadow-rose-600/20'}`}>
                      <span class="material-symbols-outlined text-base">{isEnabled ? 'power_settings_new' : 'power_off'}</span>
                      <span>Trạng thái: {isEnabled ? 'Đang ĐÃ BẬT (Hiển thị)' : 'Đã ĐÃ TẮT (Ẩn)'}</span>
                    </button>
                  </div>
                </div>
              )}
              {!isFree && pkg.style_type === 'rainbow_effect' && (
                <div class="absolute top-0 right-0">
                  <div class="bg-gradient-to-r from-red-500 via-green-500 to-blue-500 text-black px-6 py-1 rotate-45 translate-x-6 translate-y-2 text-[9px] font-black uppercase tracking-wider font-label-caps animate-pulse">POPULAR</div>
                </div>
              )}
              <div class="flex justify-between items-start mb-6">
                <div class="p-3 bg-surface-container-high rounded-xl">
                  <span class="material-symbols-outlined text-on-surface-variant">{isFree ? 'person' : 'workspace_premium'}</span>
                </div>
              </div>
              <h3 class={`font-title-md text-title-md mb-2 ${textClass}`}>{pkg.title}</h3>
              <div class="flex flex-col mb-6">
                <div class="flex items-baseline gap-1">
                  <span class="text-headline-lg font-headline-lg text-3xl">{pkg.monthlyPrice.toLocaleString('vi-VN')}đ</span>
                  <span class="text-on-surface-variant text-[14px]">/ tháng</span>
                </div>
                {!isFree && pkg.annualPrice && (
                  <span class="text-[12px] text-zinc-400 mt-1">
                    Giá năm: <strong class="text-emerald-400 font-bold">{pkg.annualPrice.toLocaleString('vi-VN')}đ</strong> / năm
                  </span>
                )}
              </div>
              <ul class="space-y-4 mb-8">
                {pkg.features.map((f: any) => (
                  <li class="flex items-center gap-3 text-[14px]">
                    <span class="material-symbols-outlined text-primary text-[20px]">check</span>
                    <span class="text-on-surface">{f}</span>
                  </li>
                ))}
              </ul>
              <button onclick={isBypassKeyPkg ? undefined : `openEditPlanModal('${pkg.monthlyId}')`} class={`mt-auto w-full py-3 rounded-lg font-semibold cursor-pointer ${btnClass}`} disabled={isBypassKeyPkg}>
                {isBypassKeyPkg ? 'Gói Hệ Thống' : 'Edit Plan'}
              </button>
            </div>
          );
        })}
      </section>

      <!-- Duyệt Chuyển Khoản Thủ Công (Manual Approvals) -->
      <section id="manual-approvals-section" class="glass-panel rounded-2xl overflow-hidden mb-12 hidden">
        <div class="px-8 py-6 border-b border-glass-stroke flex justify-between items-center bg-surface-container-low/50">
          <h2 class="font-title-md text-title-md text-on-surface text-xl">Duyệt chuyển khoản thủ công (VietQR)</h2>
          <span class="px-3 py-1 bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 rounded-full text-label-caps font-label-caps text-xs animate-pulse font-bold uppercase">Chờ duyệt</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-surface-container/30">
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Mã GD</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">User</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Gói cước</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Số tiền</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Minh chứng</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-right text-xs font-bold">Thao tác</th>
              </tr>
            </thead>
            <tbody id="manualApprovalsBody" class="divide-y divide-glass-stroke/40">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>
      </section>

      <!-- User Subscription List Section -->
      <section class="glass-panel rounded-2xl overflow-hidden">
        <div class="px-8 py-6 border-b border-glass-stroke flex justify-between items-center bg-surface-container-low/50">
          <h2 class="font-title-md text-title-md text-on-surface text-xl">Active Subscriptions</h2>
          <div class="flex items-center gap-4">
            <div class="relative hidden sm:block">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
              <input id="activeSubsSearch" class="bg-surface-deep border border-glass-stroke rounded-full pl-10 pr-4 py-2 text-[14px] focus:outline-none focus:border-primary w-64 transition-all text-on-surface" placeholder="Search user email..." type="text"/>
            </div>
          </div>
        </div>
        <div class="overflow-x-auto custom-scrollbar">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-container/30">
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">User</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Current Plan</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Join Date</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Expiry Date</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-xs font-bold">Status</th>
                <th class="px-8 py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-right text-xs font-bold">Actions</th>
              </tr>
            </thead>
            <tbody id="activeSubsBody" class="divide-y divide-glass-stroke">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>
          </table>
        </div>
        <!-- Pagination -->
        <div id="activeSubsPagination" class="px-8 py-4 border-t border-glass-stroke flex justify-between items-center text-[13px] text-on-surface-variant">
          <p id="activeSubsPaginationText">Showing 0 of 0 users</p>
          <div id="activeSubsPaginationBtns" class="flex gap-2">
            <!-- Rendered dynamically -->
          </div>
        </div>
      </section>
    </div>
  </div>

  <script is:inline>
    (function() {
      let loadedUsers = [];
      let loadedLogs = [];

      // 1. Check Payment Gateways Enabled
      function checkPaymentGate() {
        fetch('/api/admin/settings')
          .then(res => res.ok ? res.json() : null)
          .then(result => {
            const settings = result?.data || {};
            const payments = settings.payments || {};
            const anyEnabled = payments.manual_enable || payments.payos_enable || payments.paypal_enable || payments.sepay_enable || payments.vnpay_enable || payments.stripe_enable;
            
            const warningGate = document.getElementById('payment-gate-warning');
            const mainContent = document.getElementById('subscription-plans-content');
            
            if (warningGate && mainContent) {
              if (!anyEnabled) {
                warningGate.classList.remove('hidden');
                mainContent.classList.add('hidden');
              } else {
                warningGate.classList.add('hidden');
                mainContent.classList.remove('hidden');
              }
            }
          })
          .catch(err => console.error('Error checking payment gateways:', err));
      }

      // 2. Fetch all data
      async function loadAllData() {
        try {
          const res = await fetch('/api/admin/members');
          if (res.ok) {
            const result = await res.json();
            if (result && result.status === 'success') {
              loadedUsers = result.data || [];
            }
          }
        } catch (e) {
          console.error('Error fetching members:', e);
        }

        try {
          const res = await fetch('/api/user/payments');
          if (res.ok) {
            const result = await res.json();
            if (result && result.status === 'success') {
              loadedLogs = result.data || [];
            }
          }
        } catch (e) {
          console.error('Error fetching payments:', e);
        }

        renderActiveSubscriptions();
        renderManualApprovals();
      }

      // 3. Render Active Subscriptions list with pagination
      let currentPage = 1;
      const itemsPerPage = 5;

      function renderActiveSubscriptions() {
        const searchVal = document.getElementById('activeSubsSearch')?.value?.toLowerCase() || '';
        const tbody = document.getElementById('activeSubsBody');
        if (!tbody) return;

        // Filter if searched
        const filteredUsers = loadedUsers.filter(u => 
          (u.username || '').toLowerCase().includes(searchVal) || 
          (u.email || '').toLowerCase().includes(searchVal)
        );

        const paginationContainer = document.getElementById('activeSubsPagination');
        const paginationText = document.getElementById('activeSubsPaginationText');
        const paginationBtns = document.getElementById('activeSubsPaginationBtns');

        if (filteredUsers.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" class="px-8 py-5 text-center text-zinc-500 italic">Không có người dùng phù hợp.</td>
            </tr>
          `;
          if (paginationContainer) paginationContainer.classList.add('hidden');
          return;
        }

        const totalPages = Math.ceil(filteredUsers.length / itemsPerPage);
        if (currentPage > totalPages) currentPage = totalPages || 1;

        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const paginatedUsers = filteredUsers.slice(startIndex, endIndex);

        tbody.innerHTML = paginatedUsers.map(u => {
          const initials = u.username ? u.username.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'US';
          
          let pkgBadge = '';
          let bgClass = 'bg-surface-container-highest text-on-surface-variant border-glass-stroke';
          const isFree = !u.package || u.package.toLowerCase() === 'free';
          if (!isFree) {
            bgClass = 'bg-primary/10 text-primary border border-primary/20';
          }
          pkgBadge = `<span class="text-[13px] px-2.5 py-0.5 rounded-full font-medium whitespace-nowrap ${bgClass}">${u.package || 'Free'}</span>`;

          const jDate = u.joinDate ? new Date(u.joinDate).toLocaleDateString('vi-VN') : '—';
          const eDate = u.expiryDate ? new Date(u.expiryDate).toLocaleDateString('vi-VN') : '—';

          let statusText = 'Standard';
          let statusDot = 'bg-on-surface-variant/30';
          let statusColor = 'text-on-surface-variant';
          
          if (!isFree) {
            const exp = u.expiryDate ? new Date(u.expiryDate) : null;
            if (exp && new Date() > exp) {
              statusText = 'Expired';
              statusDot = 'bg-error';
              statusColor = 'text-error';
            } else {
              statusText = 'Active';
              statusDot = 'bg-emerald-400 animate-pulse';
              statusColor = 'text-emerald-400';
            }
          }

          return `
            <tr class="hover:bg-surface-container-high/30 transition-colors">
              <td class="px-8 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold text-xs">${initials}</div>
                  <div>
                    <p class="font-bold text-[14px] text-white">${u.username || 'Người dùng'}</p>
                    <p class="text-[12px] text-zinc-400">${u.email || ''}</p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-4">${pkgBadge}</td>
              <td class="px-8 py-4 text-[13px] text-zinc-400 whitespace-nowrap">${jDate}</td>
              <td class="px-8 py-4 text-[13px] text-zinc-400 whitespace-nowrap">${eDate}</td>
              <td class="px-8 py-4">
                <div class="flex items-center gap-2 ${statusColor} text-[13px]">
                  <span class="w-2 h-2 rounded-full ${statusDot}"></span>
                  ${statusText}
                </div>
              </td>
              <td class="px-8 py-4 text-right">
                <button onclick="changeUserTier('${u.username}')" class="text-primary hover:text-white transition-colors text-xs font-bold cursor-pointer bg-transparent border-none">Sửa gói</button>
              </td>
            </tr>
          `;
        }).join('');

        // Render Pagination UI
        if (paginationContainer) {
          if (totalPages <= 1) {
            paginationContainer.classList.add('hidden');
          } else {
            paginationContainer.classList.remove('hidden');
            if (paginationText) {
              paginationText.textContent = `Showing ${startIndex + 1} - ${Math.min(endIndex, filteredUsers.length)} of ${filteredUsers.length} users`;
            }

            if (paginationBtns) {
              let btnsHtml = `
                <button onclick="changeSubsPage(${currentPage - 1})" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer" ${currentPage === 1 ? 'disabled' : ''}>
                  <span class="material-symbols-outlined text-[20px] ${currentPage === 1 ? 'opacity-40' : ''}">chevron_left</span>
                </button>
              `;

              for (let i = 1; i <= totalPages; i++) {
                const activeClass = i === currentPage ? 'bg-primary text-slate-950 font-bold' : 'hover:bg-surface-container-highest text-white';
                btnsHtml += `
                  <button onclick="changeSubsPage(${i})" class="w-8 h-8 flex items-center justify-center rounded-lg transition-colors cursor-pointer ${activeClass}">
                    ${i}
                  </button>
                `;
              }

              btnsHtml += `
                <button onclick="changeSubsPage(${currentPage + 1})" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface-container-highest transition-colors cursor-pointer" ${currentPage === totalPages ? 'disabled' : ''}>
                  <span class="material-symbols-outlined text-[20px] ${currentPage === totalPages ? 'opacity-40' : ''}">chevron_right</span>
                </button>
              `;
              
              paginationBtns.innerHTML = btnsHtml;
            }
          }
        }
      }

      window.changeSubsPage = function(page) {
        if (page < 1) return;
        currentPage = page;
        renderActiveSubscriptions();
      };

      // 4. Render Manual Bank Approvals Table
      function renderManualApprovals() {
        const pendingLogs = loadedLogs.filter(item => item.method === 'manual' && item.status === 'pending');
        const section = document.getElementById('manual-approvals-section');
        const tbody = document.getElementById('manualApprovalsBody');

        if (!tbody || !section) return;

        if (pendingLogs.length === 0) {
          section.classList.add('hidden');
          return;
        }

        section.classList.remove('hidden');

        tbody.innerHTML = pendingLogs.map(item => {
          const formattedPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price);
          const imgHtml = `<button onclick="viewReceiptImage('${item.txid}')" class="text-primary hover:underline font-bold text-xs cursor-pointer flex items-center gap-1 bg-transparent border-none"><span class="material-symbols-outlined text-sm">image</span>Xem ảnh</button>`;

          return `
            <tr class="hover:bg-white/5 transition-colors">
              <td class="px-8 py-4 font-mono text-zinc-400">${(item.txid || '').substring(0, 10)}...</td>
              <td class="px-8 py-4 font-semibold text-white">${item.username}</td>
              <td class="px-8 py-4 text-zinc-300">${item.packageTitle} (${item.cycle === 'annual' ? 'Hàng năm' : 'Hàng tháng'})</td>
              <td class="px-8 py-4 text-zinc-300 font-bold">${formattedPrice}</td>
              <td class="px-8 py-4">${imgHtml}</td>
              <td class="px-8 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <button onclick="approveManualTx('${item.txid}')" class="px-3 py-1 rounded bg-emerald-500 text-slate-950 font-bold hover:brightness-110 active:scale-95 transition-all cursor-pointer text-[11px] border-none">Duyệt</button>
                  <button onclick="declineManualTx('${item.txid}')" class="px-3 py-1 rounded bg-red-500/10 border border-red-500/20 text-red-400 font-bold hover:bg-red-500/20 active:scale-95 transition-all cursor-pointer text-[11px]">Từ chối</button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      // 5. Expose Manual Actions Globally
      window.viewReceiptImage = function(txid) {
        const tx = loadedLogs.find(item => item.txid === txid);
        if (!tx || !tx.receiptImg) return;

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Xem hóa đơn chuyển khoản',
            message: `
              <div class="flex flex-col items-center gap-4">
                <p class="text-xs text-zinc-400">User: <strong class="text-white">${tx.username}</strong> | Mã GD: <strong class="text-white">${tx.txid}</strong></p>
                <div class="max-w-xs border border-glass-stroke rounded-xl overflow-hidden bg-black flex items-center justify-center">
                  <img src="${tx.receiptImg}" class="w-full h-auto object-contain max-h-[350px]" alt="Receipt" />
                </div>
              </div>
            `,
            type: 'info',
            confirmText: 'Đóng',
            cancelText: '',
            onConfirm: () => {}
          });
        }
      };

      window.approveManualTx = function(txid) {
        const tx = loadedLogs.find(item => item.txid === txid);
        if (!tx) return;

        const cycleDays = tx.cycle === 'annual' ? 365 : 30;
        const expiryDate = new Date(Date.now() + 3600 * 1000 * 24 * cycleDays).toISOString();

        const performApprove = async () => {
          try {
            // Update transaction status
            const resPayment = await fetch('/api/user/payments', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                txid: tx.txid,
                username: tx.username,
                email: tx.email,
                packageTitle: tx.packageTitle,
                price: tx.price,
                cycle: tx.cycle,
                method: tx.method,
                status: 'approved',
                receiptImg: tx.receiptImg
              })
            });

            if (!resPayment.ok) {
              throw new Error('Không thể duyệt hóa đơn.');
            }

            // Resolve package id from title
            const allPkgs = loadedSettings.packages || [];
            const matchedPkg = allPkgs.find((p) => p.title === tx.packageTitle) || allPkgs.find((p) => p.id === tx.packageTitle) || allPkgs.find((p) => p.id === 'free');
            const pkgId = matchedPkg?.id || 'free';

            // Update user package
            const resUser = await fetch('/api/admin/members', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'edit',
                username: tx.username,
                package: pkgId,
                joinDate: new Date().toISOString(),
                expiryDate: expiryDate,
                status: 'active'
              })
            });

            if (!resUser.ok) {
              throw new Error('Duyệt hóa đơn thành công nhưng không thể cập nhật gói thành viên.');
            }

            // Update localStorage txa_user_subscription if current user
            const currentLoggedIn = (window.APP_USER ? window.APP_USER.username : null);
            if (currentLoggedIn === tx.username) {
              localStorage.setItem('txa_user_subscription', JSON.stringify({
                username: tx.username,
                tier: matchedPkg?.title || tx.packageTitle,
                status: 'active',
                price: tx.price,
                cycle: tx.cycle,
                expiry: expiryDate,
                updatedAt: new Date().toISOString()
              }));
            }

            if (window.showGlobalToast) {
              window.showGlobalToast('Phê duyệt giao dịch thành công!', 'success');
            }
            
            loadAllData();
          } catch(err) {
            if (window.showGlobalToast) {
              window.showGlobalToast(`Lỗi: ${err.message}`, 'error');
            }
          }
        };

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Phê duyệt giao dịch thủ công',
            message: `Bạn có chắc chắn muốn phê duyệt giao dịch số tiền ${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(tx.price)} của user "${tx.username}"?`,
            type: 'info',
            confirmText: 'Duyệt',
            cancelText: 'Hủy',
            onConfirm: performApprove
          });
        } else if (confirm('Duyệt giao dịch này?')) {
          performApprove();
        }
      };

      window.declineManualTx = function(txid) {
        const tx = loadedLogs.find(item => item.txid === txid);
        if (!tx) return;

        const performDecline = async () => {
          try {
            const resPayment = await fetch('/api/user/payments', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                txid: tx.txid,
                username: tx.username,
                email: tx.email,
                packageTitle: tx.packageTitle,
                price: tx.price,
                cycle: tx.cycle,
                method: tx.method,
                status: 'declined',
                receiptImg: tx.receiptImg
              })
            });

            if (resPayment.ok) {
              if (window.showGlobalToast) {
                window.showGlobalToast('Đã từ chối giao dịch này.', 'info');
              }
              loadAllData();
            } else {
              if (window.showGlobalToast) {
                window.showGlobalToast('Lỗi từ chối giao dịch!', 'error');
              }
            }
          } catch(err) {
            console.error(err);
          }
        };

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Từ chối giao dịch thủ công',
            message: `Bạn có chắc muốn từ chối giao dịch của user "${tx.username}"?`,
            type: 'danger',
            confirmText: 'Từ chối',
            cancelText: 'Hủy',
            onConfirm: performDecline
          });
        } else if (confirm('Từ chối giao dịch này?')) {
          performDecline();
        }
      };

      // 6. Change User Tier Directly
      window.changeUserTier = function(username) {
        const u = loadedUsers.find(user => user.username === username);
        if (!u) return;

        const plans = [];
        const hasFreeInSettings = (loadedSettings.packages || []).some(p => p.id === 'free' || p.title?.toLowerCase() === 'free' || p.title?.toLowerCase() === 'gói free');
        if (!hasFreeInSettings) {
          plans.push({ id: 'free', title: 'Free' });
        }
        plans.push(...(loadedSettings.packages || []));

        let optionsHtml = '';
        plans.forEach(p => {
          const isSelected = (u.package === p.title || u.package === p.id || (p.id === 'free' && (!u.package || u.package.toLowerCase() === 'free'))) ? 'selected' : '';
          optionsHtml += `<option value="${p.title}" ${isSelected}>${p.title}</option>`;
        });

        const localNow = new Date(Date.now() - new Date().getTimezoneOffset() * 60000);
        const minExpiry = localNow.toISOString().slice(0, 16);

        let defaultExpiry = '';
        if (u.expiryDate) {
          const expDate = new Date(u.expiryDate);
          defaultExpiry = new Date(expDate.getTime() - expDate.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        } else {
          const d30 = new Date(Date.now() + 30 * 24 * 3600 * 1000);
          defaultExpiry = new Date(d30.getTime() - d30.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        }

        const modalContent = `
          <div class="space-y-4 text-left">
            <p class="text-xs text-zinc-400">Thay đổi gói thành viên cho tài khoản <strong class="text-white">${u.username}</strong></p>
            <div class="space-y-1">
              <label class="text-[10px] text-zinc-400 font-bold uppercase">Chọn gói cước</label>
              <select id="member-package-select" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" onchange="toggleMemberExpiryWrapper(this.value)">
                ${optionsHtml}
              </select>
            </div>
            <div class="space-y-1" id="member-expiry-wrapper" style="display: ${u.package && u.package.toLowerCase() !== 'free' ? 'block' : 'none'}">
              <label class="text-[10px] text-zinc-400 font-bold uppercase">Hạn dùng (Giờ & Ngày)</label>
              <input type="datetime-local" id="member-expiry-date" value="${defaultExpiry}" min="${minExpiry}" class="w-full bg-zinc-900 border border-glass-stroke rounded-lg px-3 py-2 text-xs text-white" />
              <p class="text-[10px] text-zinc-500 mt-1">Chọn thời gian hết hạn gói dịch vụ (Múi giờ máy sẽ được tự động lưu về GMT/UTC).</p>
            </div>
            <div class="flex gap-2 justify-end pt-4 border-t border-glass-stroke/50">
              <button type="button" onclick="closeEditPlanModal()" class="px-4 py-2 rounded-xl bg-white/5 text-zinc-400 font-bold hover:bg-white/10 active:scale-95 transition-all text-xs cursor-pointer border border-glass-stroke/30">Hủy</button>
              <button id="submit-change-tier-btn" class="px-5 py-2 bg-primary text-slate-950 font-black rounded-xl hover:brightness-110 active:scale-95 transition-all text-xs cursor-pointer border-none shadow-lg shadow-primary/20">Lưu thay đổi</button>
            </div>
          </div>
        `;

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Thay đổi gói cước thành viên',
            content: modalContent,
            type: 'info',
            confirmText: '',
            cancelText: '',
            onConfirm: () => {}
          });

          // Bind submit action
          const submitBtn = document.getElementById('submit-change-tier-btn');
          if (submitBtn) {
            submitBtn.onclick = async function() {
              const selectedPackage = document.getElementById('member-package-select').value;
              const isFree = selectedPackage.toLowerCase() === 'free';
              
              let expiryDate = '';
              if (!isFree) {
                const dateInput = document.getElementById('member-expiry-date');
                if (dateInput && dateInput.value) {
                  expiryDate = new Date(dateInput.value).toISOString();
                }
              }

              try {
                const res = await fetch('/api/admin/members', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    action: 'edit',
                    username: username,
                    package: selectedPackage,
                    expiryDate: expiryDate,
                    status: 'active'
                  })
                });

                if (res.ok) {
                  const currentLoggedIn = (window.APP_USER ? window.APP_USER.username : null);
                  if (currentLoggedIn === username) {
                    if (isFree) {
                      localStorage.removeItem('txa_user_subscription');
                    } else {
                      localStorage.setItem('txa_user_subscription', JSON.stringify({
                        username: username,
                        tier: selectedPackage,
                        status: 'active',
                        price: 0,
                        cycle: 'custom',
                        expiry: expiryDate,
                        updatedAt: new Date().toISOString()
                      }));
                    }
                  }

                  if (window.showGlobalToast) {
                    window.showGlobalToast(`Đã cập nhật gói thành công cho ${username}!`, 'success');
                  }
                  closeEditPlanModal();
                  loadAllData();
                } else {
                  if (window.showGlobalToast) {
                    window.showGlobalToast('Cập nhật gói thất bại!', 'error');
                  }
                }
              } catch(err) {
                console.error(err);
                if (window.showGlobalToast) {
                  window.showGlobalToast('Lỗi kết nối API!', 'error');
                }
              }
            };
          }
        }
      };

      let loadedSettings = {};
      async function loadSettings() {
        try {
          const res = await fetch('/api/admin/settings');
          if (res.ok) {
            const result = await res.json();
            loadedSettings = result.data || {};
          }
        } catch (e) {
          console.error(e);
        }
      }

