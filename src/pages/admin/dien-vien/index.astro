---
import AdminLayout from '@layouts/AdminLayout.astro';
import { MovieService } from '@services/MovieService';
import { SettingService } from '@services/SettingService';

const staticMovies = await MovieService.getMovies();
const settings = await SettingService.getSettings();
const hasTmdbKey = !!(settings.general as any).tmdb_api_key;
---

<AdminLayout title="Quản lý Diễn viên">
  <div class="actors-admin-root font-[var(--font-body)]">

    <!-- Top Toolbar -->
    <header class="h-20 sticky top-0 flex items-center justify-between px-margin-mobile md:px-gutter z-40 rounded-b-2xl mb-8 ac-toolbar">
      <div class="flex items-center gap-4 w-full max-w-xl">
        <div class="relative w-full">
          <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[var(--ac-gold)]/70 text-[20px]">search</span>
          <input id="actor-search" class="ac-search w-full rounded-full py-2.5 pl-12 pr-4 text-[var(--ac-text)] placeholder:text-[var(--ac-text-muted)] transition-all text-sm" placeholder="Tìm kiếm diễn viên theo tên..." type="text"/>
        </div>
      </div>
      <div class="flex items-center gap-3 ml-4">
        {hasTmdbKey && (
          <button id="btn-sync-actors" class="ac-btn-ghost px-5 py-2.5 rounded-full font-semibold text-sm flex items-center gap-2 active:scale-95 transition-all cursor-pointer whitespace-nowrap">
            <span class="material-symbols-outlined text-lg">sync</span>
            Đồng bộ hàng loạt
          </button>
        )}
        <button id="btn-add-actor" class="ac-btn-gold px-6 py-2.5 rounded-full font-bold text-sm flex items-center gap-2 active:scale-95 transition-all cursor-pointer whitespace-nowrap">
          <span class="material-symbols-outlined text-lg">add</span>
          Thêm diễn viên
        </button>
      </div>
    </header>

    <!-- Content Area -->
    <div class="w-full">
      <div class="mb-8 flex items-end justify-between gap-4 flex-wrap">
        <div>
          <span class="ac-eyebrow">Quản trị nội dung</span>
          <h2 class="ac-headline text-3xl md:text-4xl text-[var(--ac-text)]">Diễn viên</h2>
          <p id="actor-summary-text" class="text-[var(--ac-text-muted)] text-sm mt-1.5">Đang tải thông tin diễn viên...</p>
        </div>
      </div>

      <!-- Bento Grid of Actors -->
      <div id="actors-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-5">
        <!-- Dynamic list via JS client-side -->
      </div>

      <!-- Empty State -->
      <div id="actors-empty" class="hidden text-center py-20 ac-panel rounded-2xl">
        <span class="material-symbols-outlined text-5xl text-[var(--ac-gold)]/40 mb-3">theater_comedy</span>
        <p class="text-sm text-[var(--ac-text-muted)]">Chưa có diễn viên nào khớp với tìm kiếm này.</p>
        <p class="text-xs text-[var(--ac-text-muted)]/70 mt-1">Thử một từ khóa khác, hoặc thêm diễn viên mới ở góc trên bên phải.</p>
      </div>

      <!-- Pagination Container -->
      <div id="pagination-container" class="mt-14 flex items-center justify-center gap-2 pb-10">
        <!-- Dynamically generated page buttons -->
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ staticMovies, hasTmdbKey }}>
    (function() {
      let actorsState = [];
      let allMovies = [];
      let currentFiltered = [];
      let currentPage = 1;
      const itemsPerPage = 24;

      function cleanString(str) {
        if (!str) return '';
        return str
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[đĐ]/g, 'd')
          .trim();
      }

      async function loadActors() {
        try {
          const res = await fetch('/api/admin/actors');
          const json = await res.json();
          if (json.status === 'success') {
            actorsState = json.data || [];
          }
        } catch (e) {
          console.error("Error loading actors:", e);
        }
        return actorsState;
      }

      async function initActors() {
        const grid = document.getElementById('actors-grid');
        if (!grid) return; // Exit if not on the page

        // Load all movies to count roles
        allMovies = staticMovies || [];

        // Load actors from database API
        await loadActors();

        currentFiltered = [...actorsState];
        currentPage = 1;
        filterAndRender();

        setupBulkSyncButton();

        // Bind events
        const searchInput = document.getElementById('actor-search');
        if (searchInput) {
          searchInput.oninput = (e) => {
            const query = e.target.value.trim().toLowerCase();
            const cleanedQuery = cleanString(query);
            currentFiltered = actorsState.filter(a => cleanString(a.name).includes(cleanedQuery));
            currentPage = 1;
            filterAndRender();
          };
        }

        const btnAddActor = document.getElementById('btn-add-actor');
        if (btnAddActor) {
          btnAddActor.onclick = () => {
            const html = `
              <div style="display:flex;flex-direction:column;gap:12px;min-width:320px;max-width:500px">
                <div style="display:flex;flex-direction:column;gap:4px">
                  <label style="font-size:10px;color:#9C97A6;font-weight:800;text-transform:uppercase;letter-spacing:0.06em">Tên diễn viên</label>
                  <input type="text" id="actor-modal-name" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid rgba(232,178,62,0.18);background:rgba(255,255,255,0.03);color:#F4F1EA;font-size:13px" placeholder="Ví dụ: Tom Cruise" />
                </div>
                <div style="display:flex;gap:12px;width:100%">
                  <div style="display:flex;flex-direction:column;gap:4px;flex:1">
                    <label style="font-size:10px;color:#9C97A6;font-weight:800;text-transform:uppercase;letter-spacing:0.06em">TMDB ID (Số)</label>
                    <input type="number" id="actor-modal-tmdb-id" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid rgba(232,178,62,0.18);background:rgba(255,255,255,0.03);color:#F4F1EA;font-size:13px" placeholder="Ví dụ: 287" />
                  </div>
                  ${hasTmdbKey ? `
                  <div style="display:flex;align-items:flex-end">
                    <button type="button" id="btn-fetch-tmdb" style="padding:10px 16px;border-radius:10px;border:1px solid #E8B23E;background:rgba(232,178,62,0.1);color:#E8B23E;font-size:13px;font-weight:bold;cursor:pointer;display:flex;align-items:center;gap:4px;height:42px" class="hover:bg-[#E8B23E] hover:text-[#1a1208] transition-all">
                      <span class="material-symbols-outlined text-[16px]">sync</span> Lấy tin TMDB
                    </button>
                  </div>
                  ` : ''}
                </div>
                <div style="display:flex;flex-direction:column;gap:4px">
                  <label style="font-size:10px;color:#9C97A6;font-weight:800;text-transform:uppercase;letter-spacing:0.06em">Link ảnh đại diện (URL)</label>
                  <input type="text" id="actor-modal-image" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid rgba(232,178,62,0.18);background:rgba(255,255,255,0.03);color:#F4F1EA;font-size:13px" placeholder="Dán link ảnh đại diện..." />
                </div>
                <div style="display:flex;flex-direction:column;gap:4px">
                  <label style="font-size:10px;color:#9C97A6;font-weight:800;text-transform:uppercase;letter-spacing:0.06em">Tiểu sử / Bio</label>
                  <textarea id="actor-modal-bio" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid rgba(232,178,62,0.18);background:rgba(255,255,255,0.03);color:#F4F1EA;font-size:13px;min-height:100px" placeholder="Nhập tiểu sử diễn viên..."></textarea>
                </div>
              </div>
            `;

            if (window.txamodal) {
              window.txamodal.show({
                title: 'Thêm Diễn viên mới',
                message: html,
                confirmText: 'Thêm mới',
                cancelText: 'Hủy bỏ',
                onConfirm: async () => {
                  const name = document.getElementById('actor-modal-name')?.value.trim();
                  let image = document.getElementById('actor-modal-image')?.value.trim();
                  const tmdbId = document.getElementById('actor-modal-tmdb-id')?.value.trim();
                  const bio = document.getElementById('actor-modal-bio')?.value.trim();
                  if (!name) {
                    if (window.showGlobalToast) window.showGlobalToast('Tên diễn viên không được để trống!', 'error');
                    return;
                  }
                  if (actorsState.some(a => cleanString(a.name) === cleanString(name))) {
                    if (window.showGlobalToast) window.showGlobalToast('Diễn viên này đã tồn tại!', 'error');
                    return;
                  }
                  if (!image) {
                    image = 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=200&h=200&q=80'; // default avatar
                  }

                  try {
                    const res = await fetch('/api/admin/actors', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                        action: 'create',
                        actor: { name, image, tmdb_id: tmdbId, bio }
                      })
                    });
                    const json = await res.json();
                    if (json.status === 'success') {
                      await loadActors();
                      // Reload search and render
                      const q = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
                      currentFiltered = actorsState.filter(a => cleanString(a.name).includes(cleanString(q)));
                      filterAndRender();
                      if (window.showGlobalToast) window.showGlobalToast(`Đã thêm diễn viên ${name} thành công!`, 'success');
                    } else {
                      throw new Error(json.message);
                    }
                  } catch (err) {
                    if (window.showGlobalToast) window.showGlobalToast('Lỗi khi thêm diễn viên!', 'error');
                  }
                }
              });

              // Bind TMDB fetch event
              setTimeout(() => {
                const btnFetch = document.getElementById('btn-fetch-tmdb');
                if (btnFetch) {
                  btnFetch.onclick = async () => {
                    const name = document.getElementById('actor-modal-name')?.value.trim();
                    const tmdbId = document.getElementById('actor-modal-tmdb-id')?.value.trim();
                    if (!name && !tmdbId) {
                      if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập Tên hoặc TMDB ID để tìm kiếm!', 'error');
                      return;
                    }
                    btnFetch.disabled = true;
                    btnFetch.innerHTML = '<span class="material-symbols-outlined animate-spin text-[16px]">progress_activity</span> Đang lấy...';
                    try {
                      const res = await fetch('/api/admin/actors', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                          action: 'fetch-tmdb-info',
                          actor: { name, tmdb_id: tmdbId }
                        })
                      });
                      const json = await res.json();
                      if (json.status === 'success') {
                        const data = json.data;
                        if (document.getElementById('actor-modal-name')) document.getElementById('actor-modal-name').value = data.name;
                        if (document.getElementById('actor-modal-tmdb-id')) document.getElementById('actor-modal-tmdb-id').value = data.tmdb_id;
                        if (document.getElementById('actor-modal-image')) document.getElementById('actor-modal-image').value = data.avatar_url;
                        if (document.getElementById('actor-modal-bio')) document.getElementById('actor-modal-bio').value = data.bio;
                        if (window.showGlobalToast) window.showGlobalToast('Đã lấy thông tin diễn viên thành công!', 'success');
                      } else {
                        throw new Error(json.message);
                      }
                    } catch (err) {
                      if (window.showGlobalToast) window.showGlobalToast(err.message || 'Không tìm thấy diễn viên trên TMDB!', 'error');
                    } finally {
                      btnFetch.disabled = false;
                      btnFetch.innerHTML = '<span class="material-symbols-outlined text-[16px]">sync</span> Lấy tin TMDB';
                    }
                  };
                }
              }, 50);
            }
          };
        }
      }

      function countActorMovies(actorName) {
        const term = actorName.toLowerCase().trim();
        return allMovies.filter(m => {
          const list = m.actors || m.actor || [];
          return list.some(act => String(act).toLowerCase().trim() === term);
        }).length;
      }

      function renderPagination(totalPages) {
        const container = document.getElementById('pagination-container');
        if (!container) return;

        if (totalPages <= 1) {
          container.innerHTML = '';
          return;
        }

        let html = '';

        // Prev button
        html += `
          <button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} class="ac-ticket px-4 py-2.5 disabled:opacity-30 disabled:pointer-events-none text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
            <span class="material-symbols-outlined text-sm">chevron_left</span> Trước
          </button>
        `;

        // Page numbers
        const maxVisible = 5;
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, startPage + maxVisible - 1);

        if (endPage - startPage < maxVisible - 1) {
          startPage = Math.max(1, endPage - maxVisible + 1);
        }

        if (startPage > 1) {
          html += `<button onclick="changePage(1)" class="ac-ticket w-10 h-10 text-xs font-bold transition-all cursor-pointer">1</button>`;
          if (startPage > 2) {
            html += `<span class="text-[var(--ac-text-muted)]/60 px-1">···</span>`;
          }
        }

        for (let p = startPage; p <= endPage; p++) {
          const isActive = p === currentPage;
          html += `
            <button onclick="changePage(${p})" class="ac-ticket ${isActive ? 'ac-ticket-active' : ''} w-10 h-10 text-xs font-bold transition-all cursor-pointer">
              ${p}
            </button>
          `;
        }

        if (endPage < totalPages) {
          if (endPage < totalPages - 1) {
            html += `<span class="text-[var(--ac-text-muted)]/60 px-1">···</span>`;
          }
          html += `<button onclick="changePage(${totalPages})" class="ac-ticket w-10 h-10 text-xs font-bold transition-all cursor-pointer">${totalPages}</button>`;
        }

        // Next button
        html += `
          <button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''} class="ac-ticket px-4 py-2.5 disabled:opacity-30 disabled:pointer-events-none text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
            Sau <span class="material-symbols-outlined text-sm">chevron_right</span>
          </button>
        `;

        container.innerHTML = html;
      }

      window.changePage = function(page) {
        currentPage = page;
        filterAndRender();
        // Smooth scroll to top of list
        document.getElementById('actors-grid')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      };

      function filterAndRender() {
        const grid = document.getElementById('actors-grid');
        const emptyState = document.getElementById('actors-empty');
        const summaryText = document.getElementById('actor-summary-text');
        if (!grid) return;

        if (summaryText) {
          summaryText.textContent = `Tổng cộng ${actorsState.length} diễn viên trong hệ thống`;
        }

        if (currentFiltered.length === 0) {
          grid.innerHTML = '';
          emptyState?.classList.remove('hidden');
          renderPagination(0);
          return;
        }

        emptyState?.classList.add('hidden');

        const totalPages = Math.ceil(currentFiltered.length / itemsPerPage);
        if (currentPage > totalPages) currentPage = Math.max(1, totalPages);

        const listToDisplay = currentFiltered.slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage);

        grid.innerHTML = listToDisplay.map((actor, index) => {
          const originalIndex = actorsState.findIndex(a => a.name === actor.name);
          const moviesCount = countActorMovies(actor.name);
          return `
            <div class="actor-card group relative overflow-hidden ac-film-card aspect-[3/4] transition-all duration-300 hover:-translate-y-1">
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/35 to-transparent z-10"></div>
              <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('${actor.image}')"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 z-20">
                <h3 class="text-xs md:text-sm font-bold truncate text-[var(--ac-text)] m-0">${actor.name}</h3>
                <p class="text-[var(--ac-gold)] text-[9px] font-[var(--font-mono)] tracking-wider mt-0.5">${moviesCount} phim</p>
                ${actor.tmdb_id ? `<span class="absolute top-3 right-0 px-1.5 py-0.5 text-[8px] bg-[var(--ac-blue)]/15 text-[var(--ac-blue)] border border-[var(--ac-blue)]/30 rounded-l font-[var(--font-mono)] font-bold">TMDB</span>` : ''}
              </div>

              <!-- Action Hover Overlay -->
              <div class="action-overlay absolute inset-0 bg-black/65 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-30 flex items-center justify-center gap-2">
                ${hasTmdbKey ? `
                <button onclick="quickSyncActor(${originalIndex})" class="w-8 h-8 rounded-full bg-[var(--ac-blue)] text-white flex items-center justify-center hover:scale-110 transition-transform cursor-pointer border-none" data-txatooltip="Đồng bộ TMDB">
                  <span class="material-symbols-outlined text-[16px]">sync</span>
                </button>
                ` : ''}
                <button onclick="editActor(${originalIndex})" class="w-8 h-8 rounded-full bg-[var(--ac-gold)] text-[#1a1208] flex items-center justify-center hover:scale-110 transition-transform cursor-pointer border-none" data-txatooltip="Chỉnh sửa">
                  <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">edit</span>
                </button>
                <button onclick="deleteActor(${originalIndex})" class="w-8 h-8 rounded-full bg-[var(--ac-rose)] text-white flex items-center justify-center hover:scale-110 transition-transform cursor-pointer border-none" data-txatooltip="Xóa">
                  <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">delete</span>
                </button>
              </div>
            </div>
          `;
        }).join('');

        renderPagination(totalPages);
      }

      window.editActor = function(index) {
        const actor = actorsState[index];
        if (!actor) return;
        const html = `
          <div style="display:flex;flex-direction:column;gap:12px;min-width:320px;max-width:500px">
            <div style="display:flex;flex-direction:column;gap:4px">
              <label style="font-size:10px;color:#9C97A6;font-weight:800;text-transform:uppercase;letter-spacing:0.06em">Tên diễn viên</label>
              <input type="text" id="actor-modal-name" value="${actor.name.replace(/"/g, '&quot;')}" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid rgba(232,178,62,0.18);background:rgba(255,255,255,0.03);color:#F4F1EA;font-size:13px" />
            </div>
            <div style="display:flex;gap:12px;width:100%">
              <div style="display:flex;flex-direction:column;gap:4px;flex:1">
                <label style="font-size:10px;color:#9C97A6;font-weight:800;text-transform:uppercase;letter-spacing:0.06em">TMDB ID (Số)</label>
                <input type="number" id="actor-modal-tmdb-id" value="${actor.tmdb_id || ''}" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid rgba(232,178,62,0.18);background:rgba(255,255,255,0.03);color:#F4F1EA;font-size:13px" placeholder="Ví dụ: 287" />
              </div>
              ${hasTmdbKey ? `
              <div style="display:flex;align-items:flex-end">
                <button type="button" id="btn-fetch-tmdb" style="padding:10px 16px;border-radius:10px;border:1px solid #E8B23E;background:rgba(232,178,62,0.1);color:#E8B23E;font-size:13px;font-weight:bold;cursor:pointer;display:flex;align-items:center;gap:4px;height:42px" class="hover:bg-[#E8B23E] hover:text-[#1a1208] transition-all">
                  <span class="material-symbols-outlined text-[16px]">sync</span> Lấy tin TMDB
                </button>
              </div>
              ` : ''}
            </div>
            <div style="display:flex;flex-direction:column;gap:4px">
              <label style="font-size:10px;color:#9C97A6;font-weight:800;text-transform:uppercase;letter-spacing:0.06em">Link ảnh đại diện (URL)</label>
              <input type="text" id="actor-modal-image" value="${actor.image.replace(/"/g, '&quot;')}" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid rgba(232,178,62,0.18);background:rgba(255,255,255,0.03);color:#F4F1EA;font-size:13px" />
            </div>
            <div style="display:flex;flex-direction:column;gap:4px">
              <label style="font-size:10px;color:#9C97A6;font-weight:800;text-transform:uppercase;letter-spacing:0.06em">Tiểu sử / Bio</label>
              <textarea id="actor-modal-bio" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid rgba(232,178,62,0.18);background:rgba(255,255,255,0.03);color:#F4F1EA;font-size:13px;min-height:100px" placeholder="Nhập tiểu sử diễn viên...">${(actor.bio || '').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</textarea>
            </div>
          </div>
        `;

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Chỉnh sửa thông tin Diễn viên',
            message: html,
            confirmText: 'Lưu thay đổi',
            cancelText: 'Hủy bỏ',
            onConfirm: async () => {
              const name = document.getElementById('actor-modal-name')?.value.trim();
              const image = document.getElementById('actor-modal-image')?.value.trim();
              const tmdbId = document.getElementById('actor-modal-tmdb-id')?.value.trim();
              const bio = document.getElementById('actor-modal-bio')?.value.trim();
              if (!name) {
                if (window.showGlobalToast) window.showGlobalToast('Tên diễn viên không được để trống!', 'error');
                return;
              }

              try {
                const res = await fetch('/api/admin/actors', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    action: 'update',
                    actor: { id: actor.id, name, image: image || '/favicon.png', tmdb_id: tmdbId, bio }
                  })
                });
                const json = await res.json();
                if (json.status === 'success') {
                  await loadActors();
                  // Reload search and render
                  const q = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
                  currentFiltered = actorsState.filter(a => cleanString(a.name).includes(cleanString(q)));
                  filterAndRender();
                  if (window.showGlobalToast) window.showGlobalToast('Cập nhật thông tin diễn viên thành công!', 'success');
                } else {
                  throw new Error(json.message);
                }
              } catch (err) {
                if (window.showGlobalToast) window.showGlobalToast('Lỗi khi cập nhật diễn viên!', 'error');
              }
            }
          });

          // Bind TMDB fetch event
          setTimeout(() => {
            const btnFetch = document.getElementById('btn-fetch-tmdb');
            if (btnFetch) {
              btnFetch.onclick = async () => {
                const name = document.getElementById('actor-modal-name')?.value.trim();
                const tmdbId = document.getElementById('actor-modal-tmdb-id')?.value.trim();
                if (!name && !tmdbId) {
                  if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập Tên hoặc TMDB ID để tìm kiếm!', 'error');
                  return;
                }
                btnFetch.disabled = true;
                btnFetch.innerHTML = '<span class="material-symbols-outlined animate-spin text-[16px]">progress_activity</span> Đang lấy...';
                try {
                  const res = await fetch('/api/admin/actors', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      action: 'fetch-tmdb-info',
                      actor: { name, tmdb_id: tmdbId }
                    })
                  });
                  const json = await res.json();
                  if (json.status === 'success') {
                    const data = json.data;
                    if (document.getElementById('actor-modal-name')) document.getElementById('actor-modal-name').value = data.name;
                    if (document.getElementById('actor-modal-tmdb-id')) document.getElementById('actor-modal-tmdb-id').value = data.tmdb_id;
                    if (document.getElementById('actor-modal-image')) document.getElementById('actor-modal-image').value = data.avatar_url;
                    if (document.getElementById('actor-modal-bio')) document.getElementById('actor-modal-bio').value = data.bio;
                    if (window.showGlobalToast) window.showGlobalToast('Đã lấy thông tin diễn viên thành công!', 'success');
                  } else {
                    throw new Error(json.message);
                  }
                } catch (err) {
                  if (window.showGlobalToast) window.showGlobalToast(err.message || 'Không tìm thấy diễn viên trên TMDB!', 'error');
                } finally {
                  btnFetch.disabled = false;
                  btnFetch.innerHTML = '<span class="material-symbols-outlined text-[16px]">sync</span> Lấy tin TMDB';
                }
              };
            }
          }, 50);
        }
      };

      window.deleteActor = function(index) {
        const actor = actorsState[index];
        if (!actor) return;
        const doDelete = async () => {
          try {
            const res = await fetch('/api/admin/actors', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'delete',
                actor: { id: actor.id }
              })
            });
            const json = await res.json();
            if (json.status === 'success') {
              await loadActors();
              // Reload search and render
              const q = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
              currentFiltered = actorsState.filter(a => cleanString(a.name).includes(cleanString(q)));
              filterAndRender();
              if (window.showGlobalToast) window.showGlobalToast('Đã xóa diễn viên thành công!', 'success');
            } else {
              throw new Error(json.message);
            }
          } catch (err) {
            if (window.showGlobalToast) window.showGlobalToast('Lỗi khi xóa diễn viên!', 'error');
          }
        };

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Xóa Diễn viên',
            message: `Bạn có chắc chắn muốn xóa diễn viên <span class="text-[#F4F1EA] font-bold">"${actor.name}"</span> khỏi hệ thống? Hành động này không thể hoàn tác.`,
            type: 'danger',
            confirmText: 'Xóa diễn viên',
            cancelText: 'Hủy bỏ',
            onConfirm: doDelete
          });
        } else if (confirm(`Xóa diễn viên ${actor.name}?`)) {
          doDelete();
        }
      };

      window.quickSyncActor = async function(index) {
        const actor = actorsState[index];
        if (!actor) return;
        if (window.showGlobalToast) window.showGlobalToast('Đang đồng bộ thông tin từ TMDB...', 'info');

        try {
          const res = await fetch('/api/admin/actors', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'sync-single',
              actor: { id: actor.id }
            })
          });
          const json = await res.json();
          if (json.status === 'success') {
            const updated = json.data;
            actorsState[index] = updated;
            const currentQ = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
            currentFiltered = actorsState.filter(a => cleanString(a.name).includes(cleanString(currentQ)));
            filterAndRender();
            if (window.showGlobalToast) window.showGlobalToast(`Đã đồng bộ diễn viên ${actor.name} thành công!`, 'success');
          } else {
            throw new Error(json.message);
          }
        } catch (e) {
          if (window.showGlobalToast) window.showGlobalToast(e.message || 'Lỗi khi đồng bộ diễn viên!', 'error');
        }
      };

      let cancelSync = false;
      let pauseSync = false;

      const closeModal = () => {
        const modal = document.getElementById('txa-global-modal');
        if (modal) {
          const modalBox = modal.querySelector('div');
          modal.classList.add('opacity-0');
          if (modalBox) modalBox.classList.add('scale-95');
          setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            const bodyEl = document.getElementById('txa-modal-body');
            if (bodyEl) bodyEl.innerHTML = '';
          }, 200);
          document.body.style.overflow = '';
        }
      };

      async function runBulkSyncLoop() {
        cancelSync = false;
        pauseSync = false;

        const statusEl = document.getElementById('sync-status');
        const progressEl = document.getElementById('sync-progress');
        const logEl = document.getElementById('sync-logs');
        const btnPause = document.getElementById('btn-sync-pause');
        const btnCancel = document.getElementById('btn-sync-cancel');
        const btnComplete = document.getElementById('btn-sync-complete');

        const addLog = (msg) => {
          if (logEl) {
            logEl.innerHTML += `<div style="margin-bottom:2px">> ${msg}</div>`;
            logEl.scrollTop = logEl.scrollHeight;
          }
        };

        // Bind custom buttons
        if (btnPause) {
          btnPause.onclick = () => {
            pauseSync = !pauseSync;
            if (pauseSync) {
              btnPause.textContent = 'Tiếp tục';
              btnPause.style.borderColor = 'rgba(232,178,62,0.3)';
              btnPause.style.background = 'rgba(232,178,62,0.1)';
              btnPause.style.color = '#E8B23E';
              addLog('Tiến trình đã được TẠM DỪNG.');
              if (statusEl) statusEl.textContent = 'Đang tạm dừng...';
            } else {
              btnPause.textContent = 'Tạm dừng';
              btnPause.style.borderColor = 'rgba(255,255,255,0.15)';
              btnPause.style.background = 'rgba(255,255,255,0.05)';
              btnPause.style.color = '#fff';
              addLog('Đang TIẾP TỤC tiến trình...');
              if (statusEl) statusEl.textContent = 'Đang đồng bộ...';
            }
          };
        }

        if (btnCancel) {
          btnCancel.onclick = () => {
            cancelSync = true;
            addLog('Đang yêu cầu hủy...');
          };
        }

        if (btnComplete) {
          btnComplete.onclick = async () => {
            closeModal();
            await loadActors();
            const q = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
            currentFiltered = actorsState.filter(a => cleanString(a.name).includes(cleanString(q)));
            filterAndRender();
          };
        }

        addLog('Đang khởi chạy tiến trình quét...');
        let totalUpdated = 0;
        let isRunning = true;
        let iteration = 0;

        while (isRunning && !cancelSync) {
          if (pauseSync) {
            await new Promise(resolve => setTimeout(resolve, 500));
            continue;
          }

          iteration++;
          addLog(`Đang chạy lô thứ ${iteration}...`);
          try {
            const res = await fetch('/api/admin/actors', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'sync-batch' })
            });
            const json = await res.json();
            if (json.status === 'success') {
              const count = json.data.count;
              const details = json.data.details || [];
              totalUpdated += count;

              // Log details of each actor in the batch
              details.forEach(d => {
                if (d.status === 'success') {
                  addLog(`Thành công: [${d.source}] ${d.name}`);
                } else {
                  addLog(`<span style="color:#F2545B">Thất bại: ${d.name} (${d.reason})</span>`);
                }
              });

              addLog(`Đồng bộ thành công ${count} diễn viên trong lô này.`);

              if (progressEl) {
                progressEl.style.width = '100%';
                setTimeout(() => { if (progressEl) progressEl.style.width = '20%'; }, 500);
              }

              if (count === 0 && details.length === 0) {
                isRunning = false;
                if (statusEl) statusEl.textContent = `Hoàn thành!`;
                addLog(`Đồng bộ kết thúc. Tổng số diễn viên cập nhật thành công: ${totalUpdated}`);

                if (btnCancel) btnCancel.style.display = 'none';
                if (btnPause) btnPause.style.display = 'none';
                if (btnComplete) btnComplete.style.display = 'block';
              } else {
                if (statusEl) statusEl.textContent = `Đang xử lý... (Tổng cộng đã thành công: ${totalUpdated})`;
              }
            } else {
              throw new Error(json.message);
            }
          } catch (e) {
            addLog(`<span style="color:#F2545B">Gặp lỗi: ${e.message}</span>`);
            isRunning = false;
            if (statusEl) statusEl.textContent = 'Bị lỗi!';
            if (btnCancel) btnCancel.style.display = 'none';
            if (btnPause) btnPause.style.display = 'none';
            if (btnComplete) btnComplete.style.display = 'block';
          }
          await new Promise(resolve => setTimeout(resolve, 800));
        }

        if (cancelSync) {
          addLog('Tiến trình đã bị dừng.');
          if (statusEl) statusEl.textContent = 'Đã dừng';
          if (btnCancel) btnCancel.style.display = 'none';
          if (btnPause) btnPause.style.display = 'none';
          if (btnComplete) btnComplete.style.display = 'block';
        }
      }

      function setupBulkSyncButton() {
        const btnSync = document.getElementById('btn-sync-actors');
        if (btnSync) {
          btnSync.onclick = () => {
            if (window.txamodal) {
              window.txamodal.show({
                title: 'Đồng bộ Diễn viên hàng loạt',
                message: 'Hệ thống sẽ quét toàn bộ diễn viên trong cơ sở dữ liệu chưa có TMDB ID hoặc tiểu sử/ảnh đại diện và thực hiện tìm kiếm, đồng bộ thông tin từ TMDB/Wikipedia.<br><br>Quá trình này được chia thành nhiều đợt (30 diễn viên/lần) để đảm bảo không bị quá tải. Bạn có muốn bắt đầu không?',
                confirmText: 'Bắt đầu',
                cancelText: 'Hủy',
                onConfirm: () => {
                  const syncHtml = `
                    <div style="display:flex;flex-direction:column;gap:12px;min-width:320px;max-width:500px">
                      <p style="font-size:13px;color:#cbd5e1;font-weight:600" id="sync-status">Đang quét diễn viên cần đồng bộ...</p>
                      <div style="width:100%;height:6px;background:rgba(255,255,255,0.08);border-radius:3px;overflow:hidden">
                        <div id="sync-progress" style="width:10%;height:100%;background:#E8B23E;transition:width 0.4s"></div>
                      </div>
                      <div id="sync-logs" style="max-height:150px;overflow-y:auto;font-family:'JetBrains Mono',monospace;font-size:11px;color:#9C97A6;background:rgba(0,0,0,0.3);padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.05);min-height:100px;text-align:left"></div>

                      <!-- Custom Action Buttons inside the HTML body -->
                      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:8px">
                        <button type="button" id="btn-sync-pause" style="padding:8px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.05);color:#fff;font-size:12px;font-weight:600;cursor:pointer" class="hover:bg-white/10 transition-all">Tạm dừng</button>
                        <button type="button" id="btn-sync-cancel" style="padding:8px 14px;border-radius:8px;border:1px solid rgba(242,84,91,0.3);background:rgba(242,84,91,0.1);color:#F2545B;font-size:12px;font-weight:600;cursor:pointer" class="hover:bg-red-500/20 transition-all">Hủy</button>
                        <button type="button" id="btn-sync-complete" style="padding:8px 14px;border-radius:8px;border:none;background:#34D399;color:#0E0D12;font-size:12px;font-weight:700;cursor:pointer;display:none" class="hover:brightness-110 transition-all">Hoàn tất</button>
                      </div>
                    </div>
                  `;

                  setTimeout(() => {
                    window.txamodal.show({
                      title: 'Đang đồng bộ diễn viên',
                      message: syncHtml,
                      confirmText: '',
                      cancelText: ''
                    });

                    setTimeout(runBulkSyncLoop, 100);
                  }, 100);
                }
              });
            }
          };
        }
      }

      // Init
      initActors();
      document.addEventListener('astro:page-load', initActors);
    })();
  </script>
</AdminLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');

  .actors-admin-root {
    --ac-bg: #0E0D12;
    --ac-panel: #18161F;
    --ac-panel-soft: #211D29;
    --ac-stroke: rgba(232, 178, 62, 0.18);
    --ac-stroke-soft: rgba(255, 255, 255, 0.06);
    --ac-gold: #E8B23E;
    --ac-gold-dim: rgba(232, 178, 62, 0.14);
    --ac-text: #F4F1EA;
    --ac-text-muted: #9C97A6;
    --ac-blue: #4FA8E0;
    --ac-rose: #F2545B;
    --ac-green: #34D399;
    --font-display: 'Bebas Neue', 'Oswald', sans-serif;
    --font-body: 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }

  /* Eyebrow + headline: marquee identity */
  .ac-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ac-gold);
    opacity: 0.8;
    margin-bottom: 2px;
  }

  .ac-headline {
    font-family: var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1;
    position: relative;
    display: inline-block;
  }

  .ac-headline::after {
    content: "";
    display: block;
    width: 46px;
    height: 3px;
    margin-top: 10px;
    background: linear-gradient(90deg, var(--ac-gold), transparent);
    border-radius: 2px;
  }

  /* Toolbar */
  .ac-toolbar {
    background: linear-gradient(180deg, rgba(24, 22, 31, 0.92), rgba(14, 13, 18, 0.85));
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--ac-stroke-soft);
  }

  .ac-search {
    background: var(--ac-panel);
    border: 1px solid var(--ac-stroke-soft);
    outline: none;
  }
  .ac-search:focus {
    border-color: var(--ac-gold);
    box-shadow: 0 0 0 3px var(--ac-gold-dim);
  }

  .ac-btn-gold {
    background: linear-gradient(180deg, #F0C160, var(--ac-gold));
    color: #1A1208;
    border: none;
    box-shadow: 0 6px 18px rgba(232, 178, 62, 0.25);
  }
  .ac-btn-gold:hover { filter: brightness(1.06); }

  .ac-btn-ghost {
    background: var(--ac-panel);
    color: var(--ac-text);
    border: 1px solid var(--ac-stroke-soft);
  }
  .ac-btn-ghost:hover {
    border-color: var(--ac-stroke);
    background: var(--ac-panel-soft);
  }

  .ac-panel {
    background: var(--ac-panel);
    border: 1px solid var(--ac-stroke-soft);
  }

  /* Film-strip actor card with sprocket-hole top edge */
  .ac-film-card {
    background: linear-gradient(180deg, var(--ac-panel) 0%, var(--ac-panel-soft) 100%);
    border: 1px solid var(--ac-stroke-soft);
    border-radius: 12px;
  }
  .ac-film-card:hover {
    border-color: var(--ac-stroke);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.35);
  }
  .ac-film-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 9px;
    background-color: rgba(0, 0, 0, 0.55);
    background-image: radial-gradient(circle, var(--ac-bg) 2.4px, transparent 2.5px);
    background-size: 13px 9px;
    background-position: 5px center;
    z-index: 25;
  }

  /* Ticket-stub pagination */
  .ac-ticket {
    position: relative;
    background: var(--ac-panel);
    border: 1px dashed var(--ac-stroke-soft);
    border-radius: 8px;
    color: var(--ac-text);
  }
  .ac-ticket:hover:not(:disabled) {
    border-color: var(--ac-stroke);
    background: var(--ac-panel-soft);
  }
  .ac-ticket-active {
    background: var(--ac-gold);
    border-color: var(--ac-gold);
    border-style: solid;
    color: #1A1208;
    box-shadow: 0 0 0 3px var(--ac-gold-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .ac-film-card, .actor-card { transition: none !important; }
  }
</style>