---

<AdminLayout title="Quản lý Diễn viên">
  <!-- Top Toolbar -->
  <header class="h-20 glass-panel sticky top-0 flex items-center justify-between px-margin-mobile md:px-gutter z-40 rounded-b-xl mb-6">
    <div class="flex items-center gap-4 w-full max-w-xl">
      <div class="relative w-full">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
        <input class="w-full bg-surface-container-low border border-glass-stroke rounded-full py-2.5 pl-12 pr-4 text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/50 placeholder:text-on-surface-variant/50 transition-all" placeholder="Tìm kiếm diễn viên..." type="text"/>
      </div>
    </div>
    <div class="flex items-center gap-4 ml-4">
      <button class="bg-primary-container text-on-primary-container px-6 py-2.5 rounded-full font-title-md text-sm font-bold flex items-center gap-2 hover:brightness-110 active:scale-95 transition-all shadow-lg shadow-primary-container/20 cursor-pointer whitespace-nowrap">
        <span class="material-symbols-outlined text-lg">add</span>
        Thêm diễn viên
      </button>
    </div>
  </header>

  <!-- Content Area -->
  <div class="w-full">
    <div class="mb-8">
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Danh sách Diễn viên</h2>
      <p class="text-on-surface-variant font-body-main mt-1">Tổng cộng 248 diễn viên trong hệ thống</p>
    </div>

    <!-- Bento Grid of Actors -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
      {actors.map(actor => (
        <div class="actor-card group relative overflow-hidden rounded-xl bg-surface-container aspect-[3/4] border border-glass-stroke transition-all duration-300 hover:scale-[1.03] hover:border-primary">
          <div class="absolute inset-0 bg-gradient-to-t from-surface-deep via-transparent to-transparent z-10"></div>
          <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${actor.image}')`}></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 z-20">
            <h3 class="font-title-md text-on-surface text-lg truncate">{actor.name}</h3>
            <p class="text-primary text-[10px] font-label-caps tracking-widest uppercase mt-1">{actor.roles} Phim đã tham gia</p>
          </div>
          
          <!-- Action Hover Overlay -->
          <div class="action-overlay absolute inset-0 bg-surface-deep/70 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-30 flex flex-col items-center justify-center gap-4">
            <button class="w-12 h-12 rounded-full bg-primary text-on-primary-fixed flex items-center justify-center hover:scale-110 transition-transform cursor-pointer" title="Chỉnh sửa">
              <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">edit</span>
            </button>
            <button class="w-12 h-12 rounded-full bg-surface-container-highest text-on-surface flex items-center justify-center hover:scale-110 transition-transform cursor-pointer" title="Chi tiết">
              <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">visibility</span>
            </button>
            <button class="w-12 h-12 rounded-full bg-error-container text-on-error-container flex items-center justify-center hover:scale-110 transition-transform cursor-pointer" title="Xóa">
              <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">delete</span>
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Pagination or Load More -->
    <div class="mt-12 flex justify-center pb-10">
      <button class="border border-glass-stroke bg-surface-container hover:bg-surface-container-high px-8 py-3 rounded-full font-body-main text-sm transition-all flex items-center gap-2 cursor-pointer">
        Tải thêm diễn viên
        <span class="material-symbols-outlined">expand_more</span>
      </button>
    </div>
  </div>
</AdminLayout>
