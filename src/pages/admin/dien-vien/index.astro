---
import AdminLayout from '@layouts/AdminLayout.astro';
import { MovieService } from '@services/MovieService';
import { SettingService } from '@services/SettingService';

const staticMovies = await MovieService.getMovies();
const settings = await SettingService.getSettings();
const hasTmdbKey = !!(settings.general as any).tmdb_api_key;
---

<AdminLayout title="Quản lý Diễn viên">
  <!-- Top Toolbar -->
  <header class="h-20 glass-panel sticky top-0 flex items-center justify-between px-margin-mobile md:px-gutter z-40 rounded-b-xl mb-6">
    <div class="flex items-center gap-4 w-full max-w-xl">
      <div class="relative w-full">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
        <input id="actor-search" class="w-full bg-surface-container-low border border-glass-stroke rounded-full py-2.5 pl-12 pr-4 text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/50 placeholder:text-on-surface-variant/50 transition-all text-white" placeholder="Tìm kiếm diễn viên..." type="text"/>
      </div>
    </div>
    <div class="flex items-center gap-4 ml-4">
      {hasTmdbKey && (
        <button id="btn-sync-actors" class="bg-surface-container-high text-white px-6 py-2.5 rounded-full font-title-md text-sm font-bold flex items-center gap-2 hover:bg-surface-container-highest active:scale-95 transition-all border border-glass-stroke cursor-pointer whitespace-nowrap">
          <span class="material-symbols-outlined text-lg">sync</span>
          Đồng bộ hàng loạt
        </button>
      )}
      <button id="btn-add-actor" class="bg-primary-container text-on-primary-container px-6 py-2.5 rounded-full font-title-md text-sm font-bold flex items-center gap-2 hover:brightness-110 active:scale-95 transition-all shadow-lg shadow-primary-container/20 cursor-pointer whitespace-nowrap border-none">
        <span class="material-symbols-outlined text-lg">add</span>
        Thêm diễn viên
      </button>
    </div>
  </header>

  <!-- Content Area -->
  <div class="w-full">
    <div class="mb-8">
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface text-2xl font-bold">Danh sách Diễn viên</h2>
      <p id="actor-summary-text" class="text-on-surface-variant font-body-main mt-1">Đang tải thông tin diễn viên...</p>
    </div>

    <!-- Bento Grid of Actors -->
    <div id="actors-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-4">
      <!-- Dynamic list via JS client-side -->
    </div>

    <!-- Empty State -->
    <div id="actors-empty" class="hidden text-center py-16 glass-panel rounded-2xl border border-glass-stroke">
      <span class="material-symbols-outlined text-5xl text-zinc-600 mb-2">theater_comedy</span>
      <p class="text-sm text-zinc-400 italic">Không tìm thấy diễn viên nào phù hợp.</p>
    </div>

    <!-- Pagination Container -->
    <div id="pagination-container" class="mt-12 flex items-center justify-center gap-2 pb-10">
      <!-- Dynamically generated page buttons -->
    </div>
  </div>

  <script is:inline define:vars={{ staticMovies, hasTmdbKey }}>
    (function() {
      let actorsState = [];
      let allMovies = [];
      let currentFiltered = [];
      let currentPage = 1;
      const itemsPerPage = 24;

      async function loadActors() {
        try {
          const res = await fetch('/api/admin/actors');
          const json = await res.json();
          if (json.status === 'success') {
            actorsState = json.data || [];
          }
        } catch (e) {
          console.error("Error loading actors:", e);
        }
        return actorsState;
      }

      async function initActors() {
        const grid = document.getElementById('actors-grid');
        if (!grid) return; // Exit if not on the page

        // Load all movies to count roles
        allMovies = staticMovies || [];

        // Load actors from database API
        await loadActors();

        currentFiltered = [...actorsState];
        currentPage = 1;
        filterAndRender();

        setupBulkSyncButton();

        // Bind events
        const searchInput = document.getElementById('actor-search');
        if (searchInput) {
          searchInput.oninput = (e) => {
            const query = e.target.value.trim().toLowerCase();
            currentFiltered = actorsState.filter(a => a.name.toLowerCase().includes(query));
            currentPage = 1;
            filterAndRender();
          };
        }

        const btnAddActor = document.getElementById('btn-add-actor');
        if (btnAddActor) {
          btnAddActor.onclick = () => {
            const html = `
              <div style="display:flex;flex-direction:column;gap:12px;min-width:320px;max-width:500px">
                <div style="display:flex;flex-direction:column;gap:4px">
                  <label style="font-size:10px;color:#64748b;font-weight:800;text-transform:uppercase">Tên diễn viên</label>
                  <input type="text" id="actor-modal-name" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:13px" placeholder="Ví dụ: Tom Cruise" />
                </div>
                <div style="display:flex;gap:12px;width:100%">
                  <div style="display:flex;flex-direction:column;gap:4px;flex:1">
                    <label style="font-size:10px;color:#64748b;font-weight:800;text-transform:uppercase">TMDB ID (Số)</label>
                    <input type="number" id="actor-modal-tmdb-id" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:13px" placeholder="Ví dụ: 287" />
                  </div>
                  ${hasTmdbKey ? `
                  <div style="display:flex;align-items:flex-end">
                    <button type="button" id="btn-fetch-tmdb" style="padding:10px 16px;border-radius:12px;border:1px solid #3b82f6;background:rgba(59,130,246,0.1);color:#3b82f6;font-size:13px;font-weight:bold;cursor:pointer;display:flex;align-items:center;gap:4px;height:42px" class="hover:bg-primary hover:text-slate-950 transition-all">
                      <span class="material-symbols-outlined text-[16px]">sync</span> Lấy tin TMDB
                    </button>
                  </div>
                  ` : ''}
                </div>
                <div style="display:flex;flex-direction:column;gap:4px">
                  <label style="font-size:10px;color:#64748b;font-weight:800;text-transform:uppercase">Link ảnh đại diện (URL)</label>
                  <input type="text" id="actor-modal-image" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:13px" placeholder="Dán link ảnh đại diện..." />
                </div>
                <div style="display:flex;flex-direction:column;gap:4px">
                  <label style="font-size:10px;color:#64748b;font-weight:800;text-transform:uppercase">Tiểu sử / Bio</label>
                  <textarea id="actor-modal-bio" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:13px;min-height:100px" placeholder="Nhập tiểu sử diễn viên..."></textarea>
                </div>
              </div>
            `;

            if (window.txamodal) {
              window.txamodal.show({
                title: 'Thêm Diễn viên mới',
                message: html,
                confirmText: 'Thêm mới',
                cancelText: 'Hủy bỏ',
                onConfirm: async () => {
                  const name = document.getElementById('actor-modal-name')?.value.trim();
                  let image = document.getElementById('actor-modal-image')?.value.trim();
                  const tmdbId = document.getElementById('actor-modal-tmdb-id')?.value.trim();
                  const bio = document.getElementById('actor-modal-bio')?.value.trim();
                  if (!name) {
                    if (window.showGlobalToast) window.showGlobalToast('Tên diễn viên không được để trống!', 'error');
                    return;
                  }
                  if (actorsState.some(a => a.name.toLowerCase() === name.toLowerCase())) {
                    if (window.showGlobalToast) window.showGlobalToast('Diễn viên này đã tồn tại!', 'error');
                    return;
                  }
                  if (!image) {
                    image = 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=200&h=200&q=80'; // default avatar
                  }
                  
                  try {
                    const res = await fetch('/api/admin/actors', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                        action: 'create',
                        actor: { name, image, tmdb_id: tmdbId, bio }
                      })
                    });
                    const json = await res.json();
                    if (json.status === 'success') {
                      await loadActors();
                      // Reload search and render
                      const q = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
                      currentFiltered = actorsState.filter(a => a.name.toLowerCase().includes(q));
                      filterAndRender();
                      if (window.showGlobalToast) window.showGlobalToast(`Đã thêm diễn viên ${name} thành công!`, 'success');
                    } else {
                      throw new Error(json.message);
                    }
                  } catch (err) {
                    if (window.showGlobalToast) window.showGlobalToast('Lỗi khi thêm diễn viên!', 'error');
                  }
                }
              });

              // Bind TMDB fetch event
              setTimeout(() => {
                const btnFetch = document.getElementById('btn-fetch-tmdb');
                if (btnFetch) {
                  btnFetch.onclick = async () => {
                    const name = document.getElementById('actor-modal-name')?.value.trim();
                    const tmdbId = document.getElementById('actor-modal-tmdb-id')?.value.trim();
                    if (!name && !tmdbId) {
                      if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập Tên hoặc TMDB ID để tìm kiếm!', 'error');
                      return;
                    }
                    btnFetch.disabled = true;
                    btnFetch.innerHTML = '<span class="material-symbols-outlined animate-spin text-[16px]">progress_activity</span> Đang lấy...';
                    try {
                      const res = await fetch('/api/admin/actors', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                          action: 'fetch-tmdb-info',
                          actor: { name, tmdb_id: tmdbId }
                        })
                      });
                      const json = await res.json();
                      if (json.status === 'success') {
                        const data = json.data;
                        if (document.getElementById('actor-modal-name')) document.getElementById('actor-modal-name').value = data.name;
                        if (document.getElementById('actor-modal-tmdb-id')) document.getElementById('actor-modal-tmdb-id').value = data.tmdb_id;
                        if (document.getElementById('actor-modal-image')) document.getElementById('actor-modal-image').value = data.avatar_url;
                        if (document.getElementById('actor-modal-bio')) document.getElementById('actor-modal-bio').value = data.bio;
                        if (window.showGlobalToast) window.showGlobalToast('Đã lấy thông tin diễn viên thành công!', 'success');
                      } else {
                        throw new Error(json.message);
                      }
                    } catch (err) {
                      if (window.showGlobalToast) window.showGlobalToast(err.message || 'Không tìm thấy diễn viên trên TMDB!', 'error');
                    } finally {
                      btnFetch.disabled = false;
                      btnFetch.innerHTML = '<span class="material-symbols-outlined text-[16px]">sync</span> Lấy tin TMDB';
                    }
                  };
                }
              }, 50);
            }
          };
        }
      }

      function countActorMovies(actorName) {
        const term = actorName.toLowerCase().trim();
        return allMovies.filter(m => {
          const list = m.actors || m.actor || [];
          return list.some(act => String(act).toLowerCase().trim() === term);
        }).length;
      }

      function renderPagination(totalPages) {
        const container = document.getElementById('pagination-container');
        if (!container) return;

        if (totalPages <= 1) {
          container.innerHTML = '';
          return;
        }

        let html = '';
        
        // Prev button
        html += `
          <button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} class="px-4 py-2.5 rounded-xl border border-glass-stroke bg-surface-container hover:bg-surface-container-high disabled:opacity-30 disabled:pointer-events-none text-white text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
            <span class="material-symbols-outlined text-sm">chevron_left</span> Trước
          </button>
        `;

        // Page numbers
        const maxVisible = 5;
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, startPage + maxVisible - 1);
        
        if (endPage - startPage < maxVisible - 1) {
          startPage = Math.max(1, endPage - maxVisible + 1);
        }

        if (startPage > 1) {
          html += `<button onclick="changePage(1)" class="w-10 h-10 rounded-xl border border-glass-stroke bg-surface-container hover:bg-surface-container-high text-white text-xs font-bold transition-all cursor-pointer">1</button>`;
          if (startPage > 2) {
            html += `<span class="text-zinc-600 px-1">...</span>`;
          }
        }

        for (let p = startPage; p <= endPage; p++) {
          const isActive = p === currentPage;
          html += `
            <button onclick="changePage(${p})" class="w-10 h-10 rounded-xl border ${isActive ? 'border-primary bg-primary text-slate-950' : 'border-glass-stroke bg-surface-container hover:bg-surface-container-high text-white'} text-xs font-bold transition-all cursor-pointer">
              ${p}
            </button>
          `;
        }

        if (endPage < totalPages) {
          if (endPage < totalPages - 1) {
            html += `<span class="text-zinc-600 px-1">...</span>`;
          }
          html += `<button onclick="changePage(${totalPages})" class="w-10 h-10 rounded-xl border border-glass-stroke bg-surface-container hover:bg-surface-container-high text-white text-xs font-bold transition-all cursor-pointer">${totalPages}</button>`;
        }

        // Next button
        html += `
          <button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''} class="px-4 py-2.5 rounded-xl border border-glass-stroke bg-surface-container hover:bg-surface-container-high disabled:opacity-30 disabled:pointer-events-none text-white text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
            Sau <span class="material-symbols-outlined text-sm">chevron_right</span>
          </button>
        `;

        container.innerHTML = html;
      }

      window.changePage = function(page) {
        currentPage = page;
        filterAndRender();
        // Smooth scroll to top of list
        document.getElementById('actors-grid')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      };

      function filterAndRender() {
        const grid = document.getElementById('actors-grid');
        const emptyState = document.getElementById('actors-empty');
        const summaryText = document.getElementById('actor-summary-text');
        if (!grid) return;

        if (summaryText) {
          summaryText.textContent = `Tổng cộng ${actorsState.length} diễn viên trong hệ thống`;
        }

        if (currentFiltered.length === 0) {
          grid.innerHTML = '';
          emptyState?.classList.remove('hidden');
          renderPagination(0);
          return;
        }

        emptyState?.classList.add('hidden');
        
        const totalPages = Math.ceil(currentFiltered.length / itemsPerPage);
        if (currentPage > totalPages) currentPage = Math.max(1, totalPages);

        const listToDisplay = currentFiltered.slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage);

        grid.innerHTML = listToDisplay.map((actor, index) => {
          const originalIndex = actorsState.findIndex(a => a.name === actor.name);
          const moviesCount = countActorMovies(actor.name);
          return `
            <div class="actor-card group relative overflow-hidden rounded-xl bg-surface-container aspect-[3/4] border border-glass-stroke transition-all duration-300 hover:scale-[1.03] hover:border-primary">
              <div class="absolute inset-0 bg-gradient-to-t from-surface-deep/90 via-surface-deep/30 to-transparent z-10"></div>
              <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('${actor.image}')"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 z-20">
                <h3 class="text-xs md:text-sm font-bold truncate text-white m-0">${actor.name}</h3>
                <p class="text-primary text-[9px] font-mono tracking-wider mt-0.5">${moviesCount} phim</p>
                ${actor.tmdb_id ? `<span class="absolute top-2 right-2 px-1.5 py-0.5 text-[8px] bg-sky-500/20 text-sky-400 border border-sky-500/30 rounded font-mono font-bold">TMDB</span>` : ''}
              </div>
              
              <!-- Action Hover Overlay -->
              <div class="action-overlay absolute inset-0 bg-surface-deep/70 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-30 flex items-center justify-center gap-2">
                ${hasTmdbKey ? `
                <button onclick="quickSyncActor(${originalIndex})" class="w-8 h-8 rounded-full bg-sky-500 text-white flex items-center justify-center hover:scale-110 transition-transform cursor-pointer border-none" data-txatooltip="Đồng bộ TMDB">
                  <span class="material-symbols-outlined text-[16px]">sync</span>
                </button>
                ` : ''}
                <button onclick="editActor(${originalIndex})" class="w-8 h-8 rounded-full bg-primary text-slate-950 flex items-center justify-center hover:scale-110 transition-transform cursor-pointer border-none" data-txatooltip="Chỉnh sửa">
                  <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">edit</span>
                </button>
                <button onclick="deleteActor(${originalIndex})" class="w-8 h-8 rounded-full bg-rose-600 text-white flex items-center justify-center hover:scale-110 transition-transform cursor-pointer border-none" data-txatooltip="Xóa">
                  <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">delete</span>
                </button>
              </div>
            </div>
          `;
        }).join('');

        renderPagination(totalPages);
      }

      window.editActor = function(index) {
        const actor = actorsState[index];
        if (!actor) return;
        const html = `
          <div style="display:flex;flex-direction:column;gap:12px;min-width:320px;max-width:500px">
            <div style="display:flex;flex-direction:column;gap:4px">
              <label style="font-size:10px;color:#64748b;font-weight:800;text-transform:uppercase">Tên diễn viên</label>
              <input type="text" id="actor-modal-name" value="${actor.name.replace(/"/g, '&quot;')}" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:13px" />
            </div>
            <div style="display:flex;gap:12px;width:100%">
              <div style="display:flex;flex-direction:column;gap:4px;flex:1">
                <label style="font-size:10px;color:#64748b;font-weight:800;text-transform:uppercase">TMDB ID (Số)</label>
                <input type="number" id="actor-modal-tmdb-id" value="${actor.tmdb_id || ''}" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:13px" placeholder="Ví dụ: 287" />
              </div>
              ${hasTmdbKey ? `
              <div style="display:flex;align-items:flex-end">
                <button type="button" id="btn-fetch-tmdb" style="padding:10px 16px;border-radius:12px;border:1px solid #3b82f6;background:rgba(59,130,246,0.1);color:#3b82f6;font-size:13px;font-weight:bold;cursor:pointer;display:flex;align-items:center;gap:4px;height:42px" class="hover:bg-primary hover:text-slate-950 transition-all">
                  <span class="material-symbols-outlined text-[16px]">sync</span> Lấy tin TMDB
                </button>
              </div>
              ` : ''}
            </div>
            <div style="display:flex;flex-direction:column;gap:4px">
              <label style="font-size:10px;color:#64748b;font-weight:800;text-transform:uppercase">Link ảnh đại diện (URL)</label>
              <input type="text" id="actor-modal-image" value="${actor.image.replace(/"/g, '&quot;')}" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:13px" />
            </div>
            <div style="display:flex;flex-direction:column;gap:4px">
              <label style="font-size:10px;color:#64748b;font-weight:800;text-transform:uppercase">Tiểu sử / Bio</label>
              <textarea id="actor-modal-bio" style="width:100%;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff;font-size:13px;min-height:100px" placeholder="Nhập tiểu sử diễn viên...">${(actor.bio || '').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</textarea>
            </div>
          </div>
        `;

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Chỉnh sửa thông tin Diễn viên',
            message: html,
            confirmText: 'Lưu thay đổi',
            cancelText: 'Hủy bỏ',
            onConfirm: async () => {
              const name = document.getElementById('actor-modal-name')?.value.trim();
              const image = document.getElementById('actor-modal-image')?.value.trim();
              const tmdbId = document.getElementById('actor-modal-tmdb-id')?.value.trim();
              const bio = document.getElementById('actor-modal-bio')?.value.trim();
              if (!name) {
                if (window.showGlobalToast) window.showGlobalToast('Tên diễn viên không được để trống!', 'error');
                return;
              }
              
              try {
                const res = await fetch('/api/admin/actors', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    action: 'update',
                    actor: { id: actor.id, name, image: image || '/favicon.png', tmdb_id: tmdbId, bio }
                  })
                });
                const json = await res.json();
                if (json.status === 'success') {
                  await loadActors();
                  // Reload search and render
                  const q = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
                  currentFiltered = actorsState.filter(a => a.name.toLowerCase().includes(q));
                  filterAndRender();
                  if (window.showGlobalToast) window.showGlobalToast('Cập nhật thông tin diễn viên thành công!', 'success');
                } else {
                  throw new Error(json.message);
                }
              } catch (err) {
                if (window.showGlobalToast) window.showGlobalToast('Lỗi khi cập nhật diễn viên!', 'error');
              }
            }
          });

          // Bind TMDB fetch event
          setTimeout(() => {
            const btnFetch = document.getElementById('btn-fetch-tmdb');
            if (btnFetch) {
              btnFetch.onclick = async () => {
                const name = document.getElementById('actor-modal-name')?.value.trim();
                const tmdbId = document.getElementById('actor-modal-tmdb-id')?.value.trim();
                if (!name && !tmdbId) {
                  if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập Tên hoặc TMDB ID để tìm kiếm!', 'error');
                  return;
                }
                btnFetch.disabled = true;
                btnFetch.innerHTML = '<span class="material-symbols-outlined animate-spin text-[16px]">progress_activity</span> Đang lấy...';
                try {
                  const res = await fetch('/api/admin/actors', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      action: 'fetch-tmdb-info',
                      actor: { name, tmdb_id: tmdbId }
                    })
                  });
                  const json = await res.json();
                  if (json.status === 'success') {
                    const data = json.data;
                    if (document.getElementById('actor-modal-name')) document.getElementById('actor-modal-name').value = data.name;
                    if (document.getElementById('actor-modal-tmdb-id')) document.getElementById('actor-modal-tmdb-id').value = data.tmdb_id;
                    if (document.getElementById('actor-modal-image')) document.getElementById('actor-modal-image').value = data.avatar_url;
                    if (document.getElementById('actor-modal-bio')) document.getElementById('actor-modal-bio').value = data.bio;
                    if (window.showGlobalToast) window.showGlobalToast('Đã lấy thông tin diễn viên thành công!', 'success');
                  } else {
                    throw new Error(json.message);
                  }
                } catch (err) {
                  if (window.showGlobalToast) window.showGlobalToast(err.message || 'Không tìm thấy diễn viên trên TMDB!', 'error');
                } finally {
                  btnFetch.disabled = false;
                  btnFetch.innerHTML = '<span class="material-symbols-outlined text-[16px]">sync</span> Lấy tin TMDB';
                }
              };
            }
          }, 50);
        }
      };

      window.deleteActor = function(index) {
        const actor = actorsState[index];
        if (!actor) return;
        const doDelete = async () => {
          try {
            const res = await fetch('/api/admin/actors', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'delete',
                actor: { id: actor.id }
              })
            });
            const json = await res.json();
            if (json.status === 'success') {
              await loadActors();
              // Reload search and render
              const q = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
              currentFiltered = actorsState.filter(a => a.name.toLowerCase().includes(q));
              filterAndRender();
              if (window.showGlobalToast) window.showGlobalToast('Đã xóa diễn viên thành công!', 'success');
            } else {
              throw new Error(json.message);
            }
          } catch (err) {
            if (window.showGlobalToast) window.showGlobalToast('Lỗi khi xóa diễn viên!', 'error');
          }
        };

        if (window.txamodal) {
          window.txamodal.show({
            title: 'Xóa Diễn viên',
            message: `Bạn có chắc chắn muốn xóa diễn viên <span class="text-white font-bold">"${actor.name}"</span> khỏi hệ thống? Hành động này không thể hoàn tác.`,
            type: 'danger',
            confirmText: 'Xóa diễn viên',
            cancelText: 'Hủy bỏ',
            onConfirm: doDelete
          });
        } else if (confirm(`Xóa diễn viên ${actor.name}?`)) {
          doDelete();
        }
      };

      // Helper sync functions
      window.quickSyncActor = async function(index) {
        const actor = actorsState[index];
        if (!actor) return;
        if (window.showGlobalToast) window.showGlobalToast('Đang đồng bộ thông tin từ TMDB...', 'info');
        
        try {
          const res = await fetch('/api/admin/actors', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'sync-single',
              actor: { id: actor.id }
            })
          });
          const json = await res.json();
          if (json.status === 'success') {
            const updated = json.data;
            actorsState[index] = updated;
            const currentQ = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
            currentFiltered = actorsState.filter(a => a.name.toLowerCase().includes(currentQ));
            filterAndRender();
            if (window.showGlobalToast) window.showGlobalToast(`Đã đồng bộ diễn viên ${actor.name} thành công!`, 'success');
          } else {
            throw new Error(json.message);
          }
        } catch (e) {
          if (window.showGlobalToast) window.showGlobalToast(e.message || 'Lỗi khi đồng bộ diễn viên!', 'error');
        }
      };

      let cancelSync = false;
      async function runBulkSyncLoop() {
        cancelSync = false;
        const statusEl = document.getElementById('sync-status');
        const progressEl = document.getElementById('sync-progress');
        const logEl = document.getElementById('sync-logs');
        const modalBoxCancel = document.getElementById('txa-modal-cancel');
        
        const addLog = (msg) => {
          if (logEl) {
            logEl.innerHTML += `<div style="margin-bottom:2px">> ${msg}</div>`;
            logEl.scrollTop = logEl.scrollHeight;
          }
        };

        addLog('Đang khởi chạy tiến trình quét...');
        let totalUpdated = 0;
        let isRunning = true;
        let iteration = 0;

        while (isRunning && !cancelSync) {
          iteration++;
          addLog(`Đang chạy lô thứ ${iteration}...`);
          try {
            const res = await fetch('/api/admin/actors', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'sync-batch' })
            });
            const json = await res.json();
            if (json.status === 'success') {
              const count = json.data.count;
              totalUpdated += count;
              addLog(`Đồng bộ thành công ${count} diễn viên trong lô này.`);
              if (progressEl) {
                progressEl.style.width = '100%';
                setTimeout(() => { if (progressEl) progressEl.style.width = '20%'; }, 500);
              }
              if (count === 0) {
                isRunning = false;
                if (statusEl) statusEl.textContent = `Hoàn thành!`;
                addLog(`Đồng bộ kết thúc. Tổng số diễn viên cập nhật: ${totalUpdated}`);
                if (modalBoxCancel) {
                  modalBoxCancel.textContent = 'Hoàn tất';
                  modalBoxCancel.className = 'px-4 py-2 rounded-xl text-xs font-semibold bg-emerald-600 text-white hover:bg-emerald-500 transition-all';
                }
                await loadActors();
                const q = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
                currentFiltered = actorsState.filter(a => a.name.toLowerCase().includes(q));
                filterAndRender();
              } else {
                if (statusEl) statusEl.textContent = `Đang xử lý... (Tổng cộng đã đồng bộ: ${totalUpdated})`;
              }
            } else {
              throw new Error(json.message);
            }
          } catch (e) {
            addLog(`Gặp lỗi: ${e.message}`);
            isRunning = false;
            if (statusEl) statusEl.textContent = 'Bị lỗi!';
            if (modalBoxCancel) modalBoxCancel.textContent = 'Đóng';
          }
          await new Promise(resolve => setTimeout(resolve, 800));
        }

        if (cancelSync) {
          addLog('Tiến trình bị hủy bởi người dùng.');
          if (statusEl) statusEl.textContent = 'Đã dừng';
          if (modalBoxCancel) modalBoxCancel.textContent = 'Đóng';
          await loadActors();
          const q = document.getElementById('actor-search')?.value.trim().toLowerCase() || '';
          currentFiltered = actorsState.filter(a => a.name.toLowerCase().includes(q));
          filterAndRender();
        }
      }

      function setupBulkSyncButton() {
        const btnSync = document.getElementById('btn-sync-actors');
        if (btnSync) {
          btnSync.onclick = () => {
            if (window.txamodal) {
              window.txamodal.show({
                title: 'Đồng bộ Diễn viên hàng loạt',
                message: 'Hệ thống sẽ quét toàn bộ diễn viên trong cơ sở dữ liệu chưa có TMDB ID hoặc tiểu sử/ảnh đại diện và thực hiện tìm kiếm, đồng bộ thông tin từ TMDB.<br><br>Quá trình này được chia thành nhiều đợt (30 diễn viên/lần) để đảm bảo không bị quá tải. Bạn có muốn bắt đầu không?',
                confirmText: 'Bắt đầu',
                cancelText: 'Hủy',
                onConfirm: () => {
                  const syncHtml = `
                    <div style="display:flex;flex-direction:column;gap:12px;min-width:320px;max-width:500px">
                      <p style="font-size:13px;color:#cbd5e1;font-weight:600" id="sync-status">Đang quét diễn viên cần đồng bộ...</p>
                      <div style="width:100%;height:6px;background:rgba(255,255,255,0.08);border-radius:3px;overflow:hidden">
                        <div id="sync-progress" style="width:10%;height:100%;background:#3b82f6;transition:width 0.4s"></div>
                      </div>
                      <div id="sync-logs" style="max-height:150px;overflow-y:auto;font-family:monospace;font-size:11px;color:#94a3b8;background:rgba(0,0,0,0.3);padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.05);min-height:100px;text-align:left"></div>
                    </div>
                  `;

                  setTimeout(() => {
                    window.txamodal.show({
                      title: 'Đang đồng bộ từ TMDB',
                      message: syncHtml,
                      confirmText: '',
                      cancelText: 'Dừng / Hủy',
                      onCancel: () => {
                        cancelSync = true;
                      }
                    });
                    
                    setTimeout(runBulkSyncLoop, 100);
                  }, 100);
                }
              });
            }
          };
        }
      }

      // Init
      initActors();
      document.addEventListener('astro:page-load', initActors);
    })();
  </script>
</AdminLayout>
