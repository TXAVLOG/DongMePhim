        btnWht.className = 'px-5 py-3 text-xs font-black uppercase tracking-wider border-b-2 border-transparent text-zinc-400 hover:text-white focus:outline-none cursor-pointer flex items-center gap-2';
        panelReq.classList.remove('hidden');
        panelWht.classList.add('hidden');
      } else {
