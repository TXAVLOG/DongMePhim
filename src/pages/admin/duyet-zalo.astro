    // Setup bộ giải mã token thủ công
    function initTokenDecryptor() {
      const decryptInput = document.getElementById('decrypt-token-input');
      const btnDecrypt = document.getElementById('btn-decrypt-token');
      const resultBox = document.getElementById('decrypt-result-box');
      const resultDevice = document.getElementById('decrypt-result-device');
      const resultIpLoc = document.getElementById('decrypt-result-ip-loc');
      const btnCloseDecrypt = document.getElementById('btn-close-decrypt-result');

      btnDecrypt?.addEventListener('click', () => {
        const val = decryptInput?.value.trim() || '';
        if (!val) {
          if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập mã token cần giải mã!', 'warning');
          return;
        }

        let rawToken = val;
        if (rawToken.startsWith('tk_')) {
          rawToken = rawToken.substring(3);
        }

        const decrypted = TxaCipher.decrypt(rawToken, CRYPTO_KEY);
        if (decrypted.startsWith('Lỗi giải mã') || decrypted === 'Lỗi giải mã') {
          if (window.showGlobalToast) window.showGlobalToast('Token không hợp lệ hoặc sai định dạng mã hóa!', 'error');
          if (resultBox) resultBox.classList.add('hidden');
          return;
        }

        if (resultBox && resultDevice && resultIpLoc) {
          resultBox.classList.remove('hidden');
          
          const parts = decrypted.split(' - IP: ');
          if (parts.length >= 2) {
            resultDevice.textContent = friendlyUserAgent(parts[0]);
            const locInfo = parts[1];
            if (locInfo.includes(' | ')) {
              const locParts = locInfo.split(' | ');
              const ip = locParts[0];
              const city = locParts.find(p => p.startsWith('City:'))?.replace('City:', '').trim() || '';
              const region = locParts.find(p => p.startsWith('Region:'))?.replace('Region:', '').trim() || '';
              const country = locParts.find(p => p.startsWith('Country:'))?.replace('Country:', '').trim() || '';
              const loc = locParts.find(p => p.startsWith('Loc:'))?.replace('Loc:', '').trim() || '';
              const org = locParts.find(p => p.startsWith('Org:'))?.replace('Org:', '').trim() || '';
              const timezone = locParts.find(p => p.startsWith('Timezone:'))?.replace('Timezone:', '').trim() || '';
              
              resultIpLoc.innerHTML = `
                <div class="space-y-1 text-xs">
                  <div><strong>IP:</strong> <span class="text-emerald-400 font-mono font-bold">${ip}</span></div>
                  <div><strong>Vị trí:</strong> <span class="text-zinc-200 font-bold">${city ? city + ', ' : ''}${region ? region + ', ' : ''}${country}</span></div>
                  ${loc ? `<div><strong>Tọa độ 🗺️:</strong> <a href="https://www.google.com/maps?q=${loc}" target="_blank" class="text-primary hover:underline font-mono">${loc}</a></div>` : ''}
                  ${org ? `<div><strong>Nhà mạng 🏢:</strong> <span class="text-zinc-300">${org}</span></div>` : ''}
                  ${timezone ? `<div><strong>Múi giờ ⏰:</strong> <span class="text-zinc-300">${timezone}</span></div>` : ''}
                </div>
              `;
            } else {
              resultIpLoc.textContent = `IP: ${locInfo}`;
            }
          } else {
            resultDevice.textContent = friendlyUserAgent(decrypted);
            resultIpLoc.textContent = 'Không trích xuất được địa chỉ IP và vị trí.';
          }
          if (window.showGlobalToast) window.showGlobalToast('Giải mã thông tin Token thành công!', 'success');
        }
      });

      btnCloseDecrypt?.addEventListener('click', () => {
        if (resultBox) resultBox.classList.add('hidden');
        if (decryptInput) decryptInput.value = '';
      });
    }

    // Statistics and real-time polling logic
    let refreshIntervalId = null;

    function updateStatsUI() {
      const pending = requestsData.filter(r => r.status === 'pending').length;
      const approved = requestsData.filter(r => r.status === 'approved').length;
      const rejected = requestsData.filter(r => r.status === 'rejected').length;
      const total = requestsData.length;
      const whitelist = whitelistData.length;

      const elPending = document.getElementById('stat-pending');
      const elApproved = document.getElementById('stat-approved');
      const elRejected = document.getElementById('stat-rejected');
      const elTotal = document.getElementById('stat-total');
      const elWhitelist = document.getElementById('stat-whitelist');

      if (elPending) elPending.textContent = pending;
      if (elApproved) elApproved.textContent = approved;
      if (elRejected) elRejected.textContent = rejected;
      if (elTotal) elTotal.textContent = total;
      if (elWhitelist) elWhitelist.textContent = whitelist;
    }

    async function refreshZaloData() {
      const tbody = document.getElementById('request-table-body');
      if (!tbody) {
        if (refreshIntervalId) {
          clearInterval(refreshIntervalId);
          refreshIntervalId = null;
        }
        return;
      }

      if (providerType === 'supabase') {
        try {
          const res = await fetch('/api/admin/zalo-action');
          if (res.ok) {
            const result = await res.json();
            if (result.status === 'success' && result.data && Array.isArray(result.data.requests)) {
              requestsData = result.data.requests;
            }
          }
          
          const resBypass = await fetch('/api/admin/zalo-bypass');
          if (resBypass.ok) {
            const resultBypass = await resBypass.json();
            if (resultBypass.status === 'success' && resultBypass.data && Array.isArray(resultBypass.data.bypasses)) {
              whitelistData = resultBypass.data.bypasses;
            }
          }
        } catch (e) {
          console.error("Loi khi tai du lieu Zalo:", e);
        }
      } else {
        requestsData = JSON.parse(localStorage.getItem('txa_zalo_access') || '[]');
        whitelistData = JSON.parse(localStorage.getItem('txa_zalo_bypass') || '[]');
      }
      
      updateStatsUI();

      const searchInput = document.getElementById('request-search');
      renderRequests(searchInput ? searchInput.value : '');

      const whitelistSearchInput = document.getElementById('whitelist-search');
      renderWhitelist(whitelistSearchInput ? whitelistSearchInput.value : '');
    }

    function startRealTimePolling() {
      if (refreshIntervalId) {
        clearInterval(refreshIntervalId);
      }
      refreshIntervalId = setInterval(refreshZaloData, 5000);
    }

    // Khởi chạy
    function init() {
      loadData();
      updateStatsUI();

      const urlParams = new URLSearchParams(window.location.search);
      const initialSearch = urlParams.get('search') || urlParams.get('q') || '';
      const requestSearchInput = document.getElementById('request-search');
      if (initialSearch && requestSearchInput) {
        requestSearchInput.value = initialSearch;
      }

      renderRequests(initialSearch);
      renderWhitelist();
      initTokenDecryptor();
      
      // Auto highlight active nav item
      const navItem = document.getElementById('nav-zalo');
      if (navItem) {
        navItem.className = 'flex items-center gap-3 px-4 py-2.5 bg-primary/10 text-primary rounded-lg transition-all duration-200';
      }

      startRealTimePolling();
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
