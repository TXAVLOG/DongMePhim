---
import AdminLayout from "@layouts/AdminLayout.astro";
import { ZaloService } from "@services/ZaloService";

// Fetch data server-side if database provider is supabase
const serverRequests = await ZaloService.getAllZaloAccessRequests();
const serverBypasses = await ZaloService.getZaloBypasses();

const providerType = import.meta.env.PUBLIC_DATA_PROVIDER || 'supabase';
---

<AdminLayout title="Quản trị duyệt cổng Zalo & Whitelist">
  <div class="w-full mt-4 pb-10">
    <!-- Top Header -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
      <div>
        <h1 class="font-headline-lg text-3xl tracking-tight text-white font-bold flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-3xl">verified</span>
          Quản lý Phê Duyệt Zalo
        </h1>
        <p class="text-zinc-400 text-sm mt-1">
          Duyệt yêu cầu truy cập từ nhóm Zalo và quản lý danh sách Whitelist Bypass
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <button
          id="btn-refresh-zalo"
          class="w-10 h-10 flex items-center justify-center rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-primary hover:border-primary/50 transition-all cursor-pointer"
        >
          <span class="material-symbols-outlined">refresh</span>
        </button>
      </div>
    </header>

    <!-- Tabs Navigation -->
    <div class="flex border-b border-zinc-800 bg-zinc-900/10 px-4 mb-6">
      <button
        id="tab-btn-requests"
        class="px-5 py-3 text-xs font-black uppercase tracking-wider border-b-2 border-primary text-primary focus:outline-none cursor-pointer flex items-center gap-2"
      >
        <span class="material-symbols-outlined text-sm">assignment_ind</span>
        Yêu cầu duyệt Zalo
      </button>
      <button
        id="tab-btn-whitelist"
        class="px-5 py-3 text-xs font-black uppercase tracking-wider border-b-2 border-transparent text-zinc-400 hover:text-white focus:outline-none cursor-pointer flex items-center gap-2"
      >
        <span class="material-symbols-outlined text-sm">badge</span>
        Whitelist Bypass
      </button>
    </div>



    <!-- Real-time Statistics Grid -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
      <div class="glass-panel p-4 rounded-2xl border border-zinc-800 bg-zinc-950/20 relative overflow-hidden group hover:border-yellow-500/30 transition-all duration-300">
        <div class="absolute -right-6 -top-6 w-16 h-16 bg-yellow-500/5 rounded-full blur-xl"></div>
        <span class="text-[10px] text-zinc-500 font-black uppercase tracking-wider block text-left">Đang chờ duyệt</span>
        <div class="flex items-baseline gap-2 mt-2">
          <span class="text-2xl font-black text-yellow-400" id="stat-pending">0</span>
          <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-ping"></span>
        </div>
      </div>
      
      <div class="glass-panel p-4 rounded-2xl border border-zinc-800 bg-zinc-950/20 relative overflow-hidden group hover:border-emerald-500/30 transition-all duration-300">
        <div class="absolute -right-6 -top-6 w-16 h-16 bg-emerald-500/5 rounded-full blur-xl"></div>
        <span class="text-[10px] text-zinc-500 font-black uppercase tracking-wider block text-left">Đã phê duyệt</span>
        <div class="flex items-baseline gap-2 mt-2">
          <span class="text-2xl font-black text-emerald-400" id="stat-approved">0</span>
        </div>
      </div>
      
      <div class="glass-panel p-4 rounded-2xl border border-zinc-800 bg-zinc-950/20 relative overflow-hidden group hover:border-rose-500/30 transition-all duration-300">
        <div class="absolute -right-6 -top-6 w-16 h-16 bg-rose-500/5 rounded-full blur-xl"></div>
        <span class="text-[10px] text-zinc-500 font-black uppercase tracking-wider block text-left">Bị từ chối</span>
        <div class="flex items-baseline gap-2 mt-2">
          <span class="text-2xl font-black text-rose-400" id="stat-rejected">0</span>
        </div>
      </div>

      <div class="glass-panel p-4 rounded-2xl border border-zinc-800 bg-zinc-950/20 relative overflow-hidden group hover:border-primary/30 transition-all duration-300">
        <div class="absolute -right-6 -top-6 w-16 h-16 bg-primary/5 rounded-full blur-xl"></div>
        <span class="text-[10px] text-zinc-500 font-black uppercase tracking-wider block text-left">Tổng yêu cầu</span>
        <div class="flex items-baseline gap-2 mt-2">
          <span class="text-2xl font-black text-white" id="stat-total">0</span>
        </div>
      </div>

      <div class="glass-panel p-4 rounded-2xl border border-zinc-800 bg-zinc-950/20 relative overflow-hidden group col-span-2 md:col-span-1 hover:border-purple-500/30 transition-all duration-300">
        <div class="absolute -right-6 -top-6 w-16 h-16 bg-purple-500/5 rounded-full blur-xl"></div>
        <span class="text-[10px] text-zinc-500 font-black uppercase tracking-wider block text-left">Whitelist Bypass</span>
        <div class="flex items-baseline gap-2 mt-2">
          <span class="text-2xl font-black text-purple-400" id="stat-whitelist">0</span>
        </div>
      </div>
    </div>

    <!-- Main Content Panels -->
    <div class="w-full">
      <!-- 1. PANEL: REQUESTS -->
      <div id="panel-requests" class="space-y-6">
        <!-- Công cụ giải mã Token (TxaCipher) -->
        <div class="glass-panel rounded-2xl border border-zinc-800 p-6 bg-zinc-950/20 shadow-2xl relative overflow-hidden">
          <div class="absolute -right-16 -top-16 w-36 h-36 bg-purple-500/5 rounded-full blur-3xl pointer-events-none"></div>
          <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
            <div class="space-y-1 w-full md:max-w-xl text-left">
              <h3 class="text-xs font-black text-primary uppercase tracking-wider flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm">key</span>
                Công cụ giải mã Token (TxaCipher)
              </h3>
              <p class="text-zinc-400 text-[11px] leading-relaxed">
                Dán mã trình duyệt <code class="bg-zinc-900 px-1.5 py-0.5 rounded text-[10px] font-mono text-purple-400">tk_...</code> để giải mã nhanh thông tin trình duyệt, địa chỉ IP và vị trí của yêu cầu.
              </p>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto">
              <input
                id="decrypt-token-input"
                class="flex-grow md:w-72 bg-zinc-950 h-10 px-4 rounded-xl border border-zinc-800 focus:border-primary focus:ring-1 focus:ring-primary outline-none text-xs text-white placeholder-zinc-500 transition-all"
                placeholder="Nhập mã token (tk_...)"
                type="text"
              />
              <button
                id="btn-decrypt-token"
                class="px-5 h-10 bg-primary text-slate-950 hover:brightness-110 font-black text-xs uppercase tracking-wider rounded-xl transition-all cursor-pointer border-none flex items-center gap-1.5 shrink-0"
              >
                <span class="material-symbols-outlined text-sm">lock_open</span>
                Giải mã
              </button>
            </div>
          </div>
          
          <!-- Decrypt Result Output -->
          <div id="decrypt-result-box" class="hidden mt-4 p-4 bg-zinc-950 border border-zinc-800 rounded-xl relative animate-[fadeIn_0.3s]">
            <button
              id="btn-close-decrypt-result"
              type="button"
              class="absolute top-3 right-3 text-zinc-500 hover:text-white transition-colors cursor-pointer text-sm p-1 bg-transparent border-none"
            >
              <span class="material-symbols-outlined text-base">close</span>
            </button>
            <h4 class="text-[10px] font-black text-primary uppercase tracking-wider mb-2 flex items-center gap-1">
              <span class="material-symbols-outlined text-xs">info</span>
              Kết quả giải mã Token:
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
              <div class="p-3 bg-zinc-900/30 border border-zinc-850 rounded-xl">
                <span class="text-[9px] text-zinc-500 font-black uppercase tracking-wider block mb-1">Thiết bị / Trình duyệt</span>
                <p id="decrypt-result-device" class="text-xs text-zinc-200 font-bold break-words">-</p>
              </div>
              <div class="p-3 bg-zinc-900/30 border border-zinc-850 rounded-xl">
                <span class="text-[9px] text-zinc-500 font-black uppercase tracking-wider block mb-1">IP & Vị trí chi tiết</span>
                <p id="decrypt-result-ip-loc" class="text-xs text-emerald-400 font-bold break-words">-</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Search & Bulk actions bar -->
        <div class="glass-panel rounded-2xl border border-zinc-800 p-4 flex flex-col md:flex-row gap-4 items-center justify-between">
          <div class="relative w-full md:max-w-xs">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 text-lg">search</span>
            <input
              id="request-search"
              class="w-full bg-zinc-950 h-10 pl-10 pr-4 rounded-xl border border-zinc-800 focus:border-primary focus:ring-1 focus:ring-primary outline-none text-xs text-white placeholder-zinc-500 transition-all"
              placeholder="Tìm kiếm biệt danh Zalo..."
              type="text"
            />
          </div>

          <!-- Bulk actions buttons -->
          <div class="flex flex-wrap items-center gap-2 w-full md:w-auto justify-end">
            <span class="text-[10px] text-zinc-500 font-bold uppercase mr-2" id="bulk-select-count">Đã chọn 0</span>
            <button
              id="btn-bulk-approve"
              disabled
              class="px-3.5 py-2 bg-emerald-500/10 border border-emerald-500/25 hover:bg-emerald-500/20 text-emerald-400 text-[10px] font-black uppercase rounded-lg transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1"
            >
              <span class="material-symbols-outlined text-xs">check_circle</span> Duyệt hàng loạt
            </button>
            <button
              id="btn-bulk-reject"
              disabled
              class="px-3.5 py-2 bg-amber-500/10 border border-amber-500/25 hover:bg-amber-500/20 text-amber-400 text-[10px] font-black uppercase rounded-lg transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1"
            >
              <span class="material-symbols-outlined text-xs">cancel</span> Từ chối hàng loạt
            </button>
            <button
              id="btn-bulk-delete"
              disabled
              class="px-3.5 py-2 bg-rose-500/10 border border-rose-500/25 hover:bg-rose-500/20 text-rose-400 text-[10px] font-black uppercase rounded-lg transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1"
            >
              <span class="material-symbols-outlined text-xs">delete</span> Xóa hàng loạt
            </button>
          </div>
        </div>

        <!-- Request Table -->
        <div class="glass-panel rounded-2xl border border-zinc-800 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-zinc-950/60 border-b border-zinc-800 text-[10px] text-zinc-400 font-black uppercase tracking-wider">
                  <th class="p-4 w-12 text-center">
                    <input type="checkbox" id="check-all-requests" class="w-4 h-4 accent-primary rounded bg-zinc-900 border-zinc-800" />
                  </th>
                  <th class="p-4">Biệt danh Zalo</th>
                  <th class="p-4">Thông tin IP & Thiết bị</th>
                  <th class="p-4">Tài khoản liên kết</th>
                  <th class="p-4 w-32">Trạng thái</th>
                  <th class="p-4 w-36">Thời gian gửi</th>
                  <th class="p-4 w-48 text-right">Thao tác</th>
                </tr>
              </thead>
              <tbody id="request-table-body" class="divide-y divide-zinc-800/60 text-xs">
                <!-- Chèn động ở client-side -->
                <tr>
                  <td colspan="7" class="p-12 text-center text-zinc-500 italic">Đang tải danh sách yêu cầu...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 2. PANEL: WHITELIST -->
      <div id="panel-whitelist" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Form thêm whitelist bypass (4 cols) -->
        <div class="lg:col-span-4 glass-panel rounded-2xl border border-zinc-800 p-6 space-y-4">
          <h3 class="text-sm font-black text-white uppercase tracking-wider border-b border-zinc-800 pb-3">Thêm Whitelist Mới</h3>
          
          <form id="form-add-whitelist" class="space-y-4">
            <div class="space-y-2">
              <label class="block text-[10px] font-black uppercase tracking-wider text-zinc-500">Loại Whitelist</label>
              <select
                id="whitelist-type"
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-primary transition-all font-bold"
              >
                <option value="nickname">Biệt danh Zalo (Nickname)</option>
                <option value="token">Token trình duyệt (Browser Token)</option>
                <option value="ip">Địa chỉ IP (IP Address)</option>
                <option value="user">Tài khoản (Username/Email)</option>
              </select>
            </div>

            <div class="space-y-2">
              <label class="block text-[10px] font-black uppercase tracking-wider text-zinc-500">Giá trị bypass</label>
              <input
                type="text"
                id="whitelist-value"
                placeholder="Nhập giá trị cần bypass..."
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-primary transition-all font-bold"
                required
              />
              <p class="text-[9px] text-zinc-500 leading-normal" id="whitelist-help-text">
                Khớp chính xác nickname Zalo đã khai báo để tự động mở cổng không cần duyệt.
              </p>
            </div>

            <div class="space-y-2">
              <label class="block text-[10px] font-black uppercase tracking-wider text-zinc-500">Mô tả / Ghi chú</label>
              <textarea
                id="whitelist-desc"
                placeholder="Ghi chú người dùng hoặc lý do bypass..."
                rows="2"
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-primary transition-all font-bold"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3 bg-primary text-slate-950 hover:brightness-110 rounded-xl font-black text-xs uppercase tracking-widest transition-all cursor-pointer border-none flex items-center justify-center gap-1.5 shadow-md"
            >
              <span class="material-symbols-outlined text-sm">person_add</span>
              Thêm Whitelist
            </button>
          </form>
        </div>

        <!-- Table whitelist (8 cols) -->
        <div class="lg:col-span-8 space-y-4">
          <div class="glass-panel rounded-2xl border border-zinc-800 p-4 flex justify-between items-center">
            <div class="relative w-full max-w-xs">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 text-lg">search</span>
              <input
                id="whitelist-search"
                class="w-full bg-zinc-950 h-10 pl-10 pr-4 rounded-xl border border-zinc-800 focus:border-primary focus:ring-1 focus:ring-primary outline-none text-xs text-white placeholder-zinc-500 transition-all"
                placeholder="Tìm kiếm whitelist..."
                type="text"
              />
            </div>
            <span class="text-[10px] text-zinc-400 font-bold uppercase px-3 py-1.5 bg-zinc-900 border border-zinc-800 rounded-lg" id="whitelist-count-badge">
              0 Whitelist
            </span>
          </div>

          <div class="glass-panel rounded-2xl border border-zinc-800 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-zinc-950/60 border-b border-zinc-800 text-[10px] text-zinc-400 font-black uppercase tracking-wider">
                    <th class="p-4 w-32">Loại</th>
                    <th class="p-4">Giá trị bypass</th>
                    <th class="p-4">Mô tả / Ghi chú</th>
                    <th class="p-4 w-36">Ngày tạo</th>
                    <th class="p-4 w-24 text-right">Hành động</th>
                  </tr>
                </thead>
                <tbody id="whitelist-table-body" class="divide-y divide-zinc-800/60 text-xs">
                  <tr>
                    <td colspan="5" class="p-12 text-center text-zinc-500 italic">Đang tải danh sách whitelist...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


</AdminLayout>

<script is:inline define:vars={{ serverRequests, serverBypasses, providerType }}>
  (function() {
    const CRYPTO_KEY = "phimtxadinhvaikk";
    const TxaCipher = {
      decrypt(encodedText, key) {
        try {
          let str = encodedText.replace(/-/g, '+').replace(/_/g, '/');
          while (str.length % 4) str += '=';
          const text = atob(str);
          let utf8Text = '';
          for (let i = 0; i < text.length; i++) {
            const charCode = text.charCodeAt(i);
            const keyChar = key.charCodeAt(i % key.length);
            const decryptedChar = charCode ^ keyChar;
            utf8Text += String.fromCharCode(decryptedChar);
          }
          return decodeURIComponent(escape(utf8Text));
        } catch (e) {
          return 'Lỗi giải mã';
        }
      }
    };

    let activeTab = 'requests';
    let requestsData = [];
    let whitelistData = [];

    // Helper: Giải mã/phân tích UserAgent thô thành tên thiết bị thân thiện
    function friendlyUserAgent(ua) {
      if (!ua) return 'Không rõ thiết bị';
      
      let os = 'Unknown OS';
      let browser = 'Unknown Browser';
      
      if (ua.includes('Windows')) os = 'Windows';
      else if (ua.includes('Macintosh') || ua.includes('Mac OS')) os = 'macOS';
      else if (ua.includes('iPhone')) os = 'iPhone';
      else if (ua.includes('iPad')) os = 'iPad';
      else if (ua.includes('Android')) os = 'Android';
      else if (ua.includes('Linux')) os = 'Linux';
      
      if (ua.includes('Chrome') || ua.includes('CriOS')) browser = 'Chrome';
      else if (ua.includes('Firefox')) browser = 'Firefox';
      else if (ua.includes('Safari') && !ua.includes('Chrome')) browser = 'Safari';
      else if (ua.includes('Edge')) browser = 'Edge';
      else if (ua.includes('Opera')) browser = 'Opera';
      else if (ua.includes('Zalo')) browser = 'Zalo App';
      
      let suffix = '';
      const match = ua.match(/\[Screen:\s*([^\s\]]+)\s*\|\s*Lang:\s*([^\s\]]+)\]/);
      if (match) {
        suffix = ` [Màn: ${match[1]} | ${match[2]}]`;
      }
      
      return `${browser} (${os})${suffix}`;
    }

    // Nạp dữ liệu (Supabase vs LocalStorage)
    function loadData() {
      if (providerType === 'supabase') {
        requestsData = serverRequests || [];
        whitelistData = serverBypasses || [];
      } else {
        // LocalStorage fallback
        requestsData = JSON.parse(localStorage.getItem('txa_zalo_access') || '[]');
        whitelistData = JSON.parse(localStorage.getItem('txa_zalo_bypass') || '[]');
      }
    }

    // Render danh sách yêu cầu Zalo
    function renderRequests(searchQuery = '') {
      const tbody = document.getElementById('request-table-body');
      if (!tbody) return;

      const filtered = requestsData.filter(item => {
        const name = (item.nickname || '').toLowerCase();
        const token = (item.token || '').toLowerCase();
        const query = searchQuery.toLowerCase();
        return name.includes(query) || token.includes(query);
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="p-12 text-center text-zinc-500 italic">
              Không có yêu cầu duyệt nào phù hợp.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(item => {
        const id = item.id || item.token;
        const nickname = item.nickname || 'Không tên';
        
        // Giải mã token thiết bị để lấy IP và location chi tiết
        let decryptedInfo = '';
        if (item.token && item.token.startsWith('tk_')) {
          const rawToken = item.token.substring(3);
          const dec = TxaCipher.decrypt(rawToken, CRYPTO_KEY);
          if (!dec.startsWith('Lỗi giải mã')) {
            decryptedInfo = dec;
          }
        }

        let displayDevice = friendlyUserAgent(item.userAgent || item.user_agent);
        let displayLocation = item.ip || 'Không rõ IP';

        if (decryptedInfo) {
          const parts = decryptedInfo.split(' - IP: ');
          if (parts.length >= 2) {
            displayDevice = friendlyUserAgent(parts[0]);
            const locInfo = parts[1];
            if (locInfo.includes(' | ')) {
              const locParts = locInfo.split(' | ');
              const ip = locParts[0];
              const city = locParts.find(p => p.startsWith('City:'))?.replace('City:', '').trim() || '';
              const country = locParts.find(p => p.startsWith('Country:'))?.replace('Country:', '').trim() || '';
              const org = locParts.find(p => p.startsWith('Org:'))?.replace('Org:', '').trim() || '';
              
              let locText = `IP: ${ip}`;
              if (city || country) {
                locText += ` - ${city || ''} (${country || ''})`;
              }
              if (org) {
                locText += ` | 🏢 ${org}`;
              }
              displayLocation = locText;
            } else {
              let ipRaw = locInfo;
              ipRaw = ipRaw.replace(/\s*-\s*/g, ' ').replace(/\s+/g, ' ').trim();
              const ipParts = ipRaw.split(' ');
              const ip = ipParts[0];
              const country = ipParts[ipParts.length - 1];
              if (country && country !== ip && country.length === 2) {
                displayLocation = `IP: ${ip} (${country})`;
              } else {
                displayLocation = `IP: ${ipRaw}`;
              }
            }
          } else {
            displayDevice = friendlyUserAgent(decryptedInfo);
            displayLocation = decryptedInfo;
          }
        }
        
        const email = item.email || '<span class="text-zinc-600">Ẩn danh</span>';
        
        let statusBadge = '';
        if (item.status === 'approved') {
          statusBadge = `<span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 text-[10px] font-bold">Đã duyệt</span>`;
        } else if (item.status === 'rejected') {
          statusBadge = `<span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/25 text-[10px] font-bold">Từ chối</span>`;
        } else {
          statusBadge = `<span class="px-2 py-0.5 rounded bg-yellow-500/10 text-yellow-400 border border-yellow-500/25 text-[10px] font-bold">Chờ duyệt</span>`;
        }

        const date = item.createdAt || item.created_at ? new Date(item.createdAt || item.created_at).toLocaleString('vi-VN') : 'Không rõ';

        return `
