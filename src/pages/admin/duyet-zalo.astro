    // Bulk actions
    async function handleBulkAction(action) {
      const checkedBoxes = document.querySelectorAll('.request-row-check:checked');
      const ids = Array.from(checkedBoxes).map(el => el.getAttribute('data-id'));
      if (ids.length === 0) return;

      const performAction = async () => {
        if (providerType === 'supabase') {
          try {
            const res = await fetch('/api/admin/zalo-action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ids, action })
            });
            const result = await res.json();
            if (res.ok) {
              if (window.txatoast) window.txatoast.success(result.message || 'Cập nhật hàng loạt thành công');
              else if (window.showGlobalToast) window.showGlobalToast(result.message || 'Cập nhật hàng loạt thành công', 'success');
              
              if (action === 'delete_bulk') {
                requestsData = requestsData.filter(x => !ids.includes(x.id));
              } else {
                const targetStatus = action === 'approve_bulk' ? 'approved' : 'rejected';
                requestsData.forEach(x => {
                  if (ids.includes(x.id)) x.status = targetStatus;
                });
              }
              renderRequests();
              // Reset checkbox
              const mainCheck = document.getElementById('check-all-requests');
              if (mainCheck) mainCheck.checked = false;
              checkSelection();
            } else {
              if (window.txatoast) window.txatoast.error(result.message || 'Lỗi xử lý');
              else if (window.showGlobalToast) window.showGlobalToast(result.message || 'Lỗi xử lý', 'error');
            }
          } catch (e) {
            if (window.txatoast) window.txatoast.error('Lỗi kết nối API');
            else if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API', 'error');
          }
        } else {
          // Local mode bulk
          let list = JSON.parse(localStorage.getItem('txa_zalo_access') || '[]');
          if (action === 'delete_bulk') {
            list = list.filter(x => !ids.includes(x.id || x.token));
          } else {
            const targetStatus = action === 'approve_bulk' ? 'approved' : 'rejected';
            list.forEach(x => {
              if (ids.includes(x.id || x.token)) {
                x.status = targetStatus;
                x.updatedAt = new Date().toISOString();
              }
            });
          }
          localStorage.setItem('txa_zalo_access', JSON.stringify(list));
          if (window.txatoast) window.txatoast.success('Đã cập nhật hàng loạt thành công!');
          else if (window.showGlobalToast) window.showGlobalToast('Đã cập nhật hàng loạt Local!', 'success');
          requestsData = list;
          renderRequests();
          const mainCheck = document.getElementById('check-all-requests');
          if (mainCheck) mainCheck.checked = false;
          checkSelection();
        }
      };

      if (action === 'delete_bulk') {
        if (window.txamodal) {
          window.txamodal.show({
            title: 'Xóa loạt yêu cầu',
            message: `Bạn có chắc chắn muốn xóa ${ids.length} yêu cầu đã chọn?`,
            type: 'danger',
            confirmText: 'Xóa hàng loạt',
            cancelText: 'Hủy bỏ',
            onConfirm: performAction
          });
        } else if (confirm(`Xóa ${ids.length} yêu cầu?`)) {
          performAction();
        }
      } else {
        performAction();
      }
    }

    document.getElementById('btn-bulk-approve')?.addEventListener('click', () => handleBulkAction('approve_bulk'));
    document.getElementById('btn-bulk-reject')?.addEventListener('click', () => handleBulkAction('reject_bulk'));
    document.getElementById('btn-bulk-delete')?.addEventListener('click', () => handleBulkAction('delete_bulk'));

