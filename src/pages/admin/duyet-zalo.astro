    // Copy to clipboard
    window.copyToClipboard = function(text, btn) {
      navigator.clipboard.writeText(text).then(() => {
        const icon = btn.querySelector('span');
        const oldIcon = icon.textContent;
        icon.textContent = 'check';
        icon.classList.add('text-emerald-400');
        if (window.showGlobalToast) window.showGlobalToast('Đã copy mã token', 'success');
        setTimeout(() => {
          icon.textContent = oldIcon;
          icon.classList.remove('text-emerald-400');
        }, 2000);
      });
    };

    // Render Whitelist Bypass
    function renderWhitelist(searchQuery = '') {
      const tbody = document.getElementById('whitelist-table-body');
      const badge = document.getElementById('whitelist-count-badge');
      if (!tbody) return;

      const filtered = whitelistData.filter(item => {
        const val = (item.value || '').toLowerCase();
        const desc = (item.description || '').toLowerCase();
        const query = searchQuery.toLowerCase();
        return val.includes(query) || desc.includes(query);
      });

      if (badge) badge.textContent = `${filtered.length} Whitelist`;

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="p-12 text-center text-zinc-500 italic">
              Không có đối tượng Whitelist nào phù hợp.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(item => {
        let typeBadge = '';
        if (item.type === 'token') {
          typeBadge = `<span class="px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 font-bold text-[9px] uppercase">Token</span>`;
        } else if (item.type === 'ip') {
          typeBadge = `<span class="px-1.5 py-0.5 rounded bg-teal-500/10 text-teal-400 border border-teal-500/20 font-bold text-[9px] uppercase">IP Address</span>`;
        } else if (item.type === 'user') {
          typeBadge = `<span class="px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20 font-bold text-[9px] uppercase">Tài khoản</span>`;
        } else {
          typeBadge = `<span class="px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-400 border border-zinc-700/50 font-bold text-[9px] uppercase">Nickname</span>`;
        }

        const date = item.createdAt || item.created_at ? new Date(item.createdAt || item.created_at).toLocaleDateString('vi-VN') : 'Không rõ';

        return `
          <tr class="hover:bg-white/[0.02] transition-colors border-b border-zinc-800/40">
            <td class="p-4">${typeBadge}</td>
            <td class="p-4 font-bold text-white font-mono select-all">${item.value}</td>
            <td class="p-4 text-zinc-400">${item.description || '<span class="text-zinc-600 italic">Không có</span>'}</td>
            <td class="p-4 text-zinc-500 font-mono text-[10px]">${date}</td>
            <td class="p-4 text-right">
              <button onclick="deleteBypass('${item.id}')" class="px-2.5 py-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded text-[10px] font-bold transition-all cursor-pointer border border-rose-500/20">
                Xóa
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Toggle tabs
