        if (providerType === 'supabase') {
          try {
            const res = await fetch('/api/admin/zalo-action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, action: 'delete' })
            });
            const result = await res.json();
            if (res.ok) {
              if (window.txatoast) window.txatoast.success(result.message || 'Xóa thành công');
