    // Cập nhật trạng thái duyệt đơn lẻ
    window.updateStatus = async function(id, status) {
      const statusText = status === 'approved' ? 'Phê duyệt thành công! Thành viên có thể vào xem phim.' : 'Đã từ chối yêu cầu truy cập.';
      if (providerType === 'supabase') {
        try {
          const res = await fetch('/api/admin/zalo-action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, action: status })
          });
          const result = await res.json();
          if (res.ok) {
            if (window.txatoast) window.txatoast.success(result.message || statusText);
            else if (window.showGlobalToast) window.showGlobalToast(result.message || statusText, 'success');
            // Cập nhật client-side state
            const target = requestsData.find(x => x.id === id);
            if (target) target.status = status;
            renderRequests(document.getElementById('request-search')?.value || '');
          } else {
            if (window.txatoast) window.txatoast.error(result.message || 'Lỗi xử lý');
            else if (window.showGlobalToast) window.showGlobalToast(result.message || 'Lỗi xử lý', 'error');
          }
        } catch (e) {
          if (window.txatoast) window.txatoast.error('Lỗi kết nối API');
          else if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API', 'error');
        }
      } else {
        // Local mode
        const list = JSON.parse(localStorage.getItem('txa_zalo_access') || '[]');
        const target = list.find(x => x.id === id || x.token === id);
        if (target) {
          target.status = status;
          target.updatedAt = new Date().toISOString();
          localStorage.setItem('txa_zalo_access', JSON.stringify(list));
          if (window.txatoast) window.txatoast.success(statusText);
          else if (window.showGlobalToast) window.showGlobalToast('Cập nhật trạng thái Local thành công!', 'success');
          requestsData = list;
          renderRequests(document.getElementById('request-search')?.value || '');
        }
      }
    };

    // Xóa yêu cầu duyệt đơn lẻ
    window.deleteRequest = async function(id) {
