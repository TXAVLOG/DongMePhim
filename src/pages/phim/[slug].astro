          </div>

          <!-- Hệ thống Tab điều hướng -->
          <div class="space-y-6">
            <div class="border-b border-glass-stroke">
              <div class="flex gap-6 md:gap-8 overflow-x-auto pb-px hide-scrollbar" id="detail-tabs">
                <button data-tab="tab-episodes" class="detail-tab-btn pb-3 text-sm font-bold transition-all border-b-2 border-primary text-primary cursor-pointer shrink-0">
                  {isSingleMovie ? 'Các bản chiếu' : 'Tập phim'}
                </button>
                <button data-tab="tab-gallery" class="detail-tab-btn pb-3 text-sm font-bold text-on-surface-variant hover:text-white transition-all cursor-pointer shrink-0">
