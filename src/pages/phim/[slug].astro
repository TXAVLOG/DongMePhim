              <span class="text-xs font-bold text-on-surface-variant">Chọn mức điểm đánh giá phim của bạn:</span>
              <div class="flex gap-1" id="rating-stars-input">
                <span data-star="1" class="material-symbols-outlined text-gray-500 hover:text-amber-400 cursor-pointer transition-colors text-lg">star</span>
                <span data-star="2" class="material-symbols-outlined text-gray-500 hover:text-amber-400 cursor-pointer transition-colors text-lg">star</span>
                <span data-star="3" class="material-symbols-outlined text-gray-500 hover:text-amber-400 cursor-pointer transition-colors text-lg">star</span>
                <span data-star="4" class="material-symbols-outlined text-gray-500 hover:text-amber-400 cursor-pointer transition-colors text-lg">star</span>
                <span data-star="5" class="material-symbols-outlined text-gray-500 hover:text-amber-400 cursor-pointer transition-colors text-lg">star</span>
              </div>
            </div>

            <!-- Ô nhập liệu bình luận -->
            <div class="space-y-3 bg-white/[0.02] border border-glass-stroke/30 rounded-xl p-4">
              <div class="relative">
                <textarea id="comment-textarea" placeholder="Viết bình luận của bạn tại đây..." rows="3" class="w-full bg-black/40 border border-white/[0.06] rounded-xl p-3 pr-14 text-xs text-white placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/30 transition-all outline-none resize-none"></textarea>
                <span class="absolute bottom-3 right-3 text-[9px] text-zinc-600 font-bold font-mono" id="char-counter">0 / 1000</span>
              </div>
              
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <label class="flex items-center gap-2 cursor-pointer group">
                    <div class="relative flex items-center justify-center shrink-0">
                      <input type="checkbox" id="comment-anonymous" class="peer sr-only" />
                      <div class="h-4 w-4 rounded border border-white/10 bg-white/5 transition-all peer-checked:bg-primary peer-checked:border-primary peer-checked:shadow-sm peer-checked:shadow-primary/30"></div>
                      <span class="material-symbols-outlined absolute text-[12px] text-white opacity-0 peer-checked:opacity-100 transition-opacity">check</span>
                    </div>
                    <span class="text-[10px] font-bold text-zinc-500 group-hover:text-zinc-300 transition-colors select-none">Ẩn danh</span>
