    function applyServerLocks() {
      // 1. Phim Bộ server buttons
      const serverBtns = document.querySelectorAll('.server-btn');
      serverBtns.forEach(btn => {
        const srvName = btn.getAttribute('data-server-name') || btn.textContent.trim();
        const isLocked = !isAdmin && !allowedServers.some(s => s.toLowerCase() === srvName.toLowerCase());
        if (isLocked) {
          if (!btn.querySelector('.lock-badge')) {
            const originalText = btn.getAttribute('data-server-name') || btn.textContent.trim();
            btn.innerHTML = `
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-[12px] text-amber-400 lock-badge" style="font-variation-settings: 'FILL' 1">lock</span>
                ${originalText}
              </span>
            `;
          }
        }
      });

      // 2. Phim Lẻ watch buttons
