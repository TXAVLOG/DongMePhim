    const checkUserVIP = async () => {
      const siteSettings = (window as any).TXA_SITE_SETTINGS || {};
      const packages: any[] = siteSettings.packages || [];
      const localUser = (window as any).APP_USER;

      if (localUser) {
        isAdmin = localUser.role === 'admin';
        const userPkg = packages.find((p: any) => p.id === localUser.package) || packages.find((p: any) => p.title === localUser.package);
        userPkgId = userPkg ? userPkg.id : 'free';
        
        if (userPkg) {
          allowedServers = [...(userPkg.permissions?.allowed_servers || [])];
          const userPrice = userPkg.price || 0;
          packages.forEach((p: any) => {
            if (p.price <= userPrice && p.permissions?.allowed_servers) {
              p.permissions.allowed_servers.forEach((srv: string) => {
                if (!allowedServers.some((s: string) => s.toLowerCase() === srv.toLowerCase())) {
                  allowedServers.push(srv);
                }
              });
            }
          });
        }
      }

      const username = localUser?.username || localStorage.getItem('tlogged_in_as');
      if (username) {
        try {
          const res = await fetch(`/api/auth/me?username=${encodeURIComponent(username)}`);
          if (res.ok) {
            const data = (await res.json()) as any;
            const userDb = data?.data;
            if (userDb) {
              isAdmin = userDb.role === 'admin';
              const userPkg = packages.find((p: any) => p.id === userDb.package) || packages.find((p: any) => p.title === userDb.package);
              userPkgId = userPkg ? userPkg.id : 'free';
              
              if (userPkg) {
                allowedServers = [...(userPkg.permissions?.allowed_servers || [])];
                const userPrice = userPkg.price || 0;
                packages.forEach((p: any) => {
                  if (p.price <= userPrice && p.permissions?.allowed_servers) {
                    p.permissions.allowed_servers.forEach((srv: string) => {
                      if (!allowedServers.some((s: string) => s.toLowerCase() === srv.toLowerCase())) {
                        allowedServers.push(srv);
                      }
                    });
                  }
                });
              }
            }
          }
        } catch(e) {
          console.error(e);
        }
      }
      
      if (allowedServers.length === 0) {
        const freePkg = packages.find((p: any) => p.id === 'free');
        allowedServers = freePkg?.permissions?.allowed_servers || ["Vietsub", "Thuyết Minh", "Lồng Tiếng"];
      }

      applyServerLocks();
      await syncWatchHistory();
    };

    // Run checkUserVIP on load
    checkUserVIP();

    // Set Server Buttons Click listeners using event delegation
    const serverSelector = document.getElementById('server-selector-container');
    if (serverSelector) {
      serverSelector.addEventListener('click', (e: any) => {
        const btn = e.target.closest('.server-btn');
        if (!btn) return;
        const idx = parseInt(btn.getAttribute('data-server-idx') || '0');
        const srvName = btn.getAttribute('data-server-name') || '';
        
        const isLocked = !isAdmin && !allowedServers.some(s => s.toLowerCase() === srvName.toLowerCase());
        if (isLocked) {
          showServerLockedModal();
          return;
        }

        const btns = serverSelector.querySelectorAll('.server-btn');
        btns.forEach((b: any) => {
          b.classList.remove('bg-primary', 'text-on-primary', 'shadow-md');
          b.classList.add('bg-surface', 'border', 'border-glass-stroke', 'text-on-surface-variant', 'hover:border-primary', 'hover:text-primary');
        });
        btn.classList.add('bg-primary', 'text-on-primary', 'shadow-md');
        btn.classList.remove('bg-surface', 'border', 'border-glass-stroke', 'text-on-surface-variant', 'hover:border-primary', 'hover:text-primary');
        
        renderEpisodes(idx);
