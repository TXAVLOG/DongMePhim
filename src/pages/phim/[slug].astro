            <!-- Tab Panels -->
            <div id="tab-panels-container" class="space-y-6">
              
              <!-- Tab 1: Tập Phim -->
              <div id="tab-episodes" class="detail-tab-panel space-y-4">
                
                {servers.length > 0 && servers[0].serverData.length > 0 && (
                  <div>
                    {isSingleMovie ? (
                      // Bố cục card server cho Phim Lẻ
                      <div class="space-y-4">
                        <h3 class="text-white font-title-md font-bold text-sm tracking-wider uppercase mb-3">Các bản chiếu</h3>
                        <div id="movie-servers-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                          {cleanedServers.map((srv: any, idx: number) => (
                            <div class="glass-card bg-surface-container-high/40 border border-glass-stroke rounded-2xl overflow-hidden flex transition-all duration-350 hover:border-primary/30 hover:scale-[1.01]">
                              <div class="flex-1 p-4 flex flex-col justify-between min-w-0 bg-gradient-to-r from-black/30 to-transparent">
                                <div class="space-y-1">
                                  <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[14px] text-secondary">subtitles</span>
                                    <span class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">{srv.cleanServerName}</span>
                                  </div>
