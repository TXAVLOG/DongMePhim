        e.preventDefault();
        showServerLockedModal();
      }
    });

    // 5. Auth Checks for Action Buttons & Tools
    const checkLogin = () => {
      return document.cookie.includes('txa_gate_passed');
    };

    const requireLogin = (action: () => void) => {
      if (!checkLogin()) {
        if (window.showGlobalToast) window.showGlobalToast('Vui lòng đăng nhập để thực hiện chức năng này!', 'error');
        setTimeout(() => {
          if (window.openLoginModal) window.openLoginModal();
        }, 800);
        return false;
      }
      action();
      return true;
    };

    // Watchlist & Favorites Database Integration
    const username = (window as any).APP_USER?.username || localStorage.getItem('tlogged_in_as');
    let userFavorites: string[] = [];
    let userPlaylist: string[] = [];

    const favBtn = document.getElementById('btn-favorite-action');
    const heartIcon = document.getElementById('heart-icon');
    const playlistBtn = document.getElementById('btn-playlist-action');
    const bookmarkIcon = document.getElementById('bookmark-icon');

    const updateFavIcon = () => {
      if (!heartIcon) return;
      const isFav = userFavorites.includes(movieSlug);
      if (isFav) {
        heartIcon.classList.add('text-red-500');
        heartIcon.textContent = 'favorite';
      } else {
        heartIcon.classList.remove('text-red-500');
        heartIcon.textContent = 'favorite';
      }
      const favTooltip = favBtn?.querySelector('.txatooltip');
      if (favTooltip) {
        favTooltip.textContent = isFav ? 'Bỏ yêu thích' : 'Yêu thích';
      }
    };

    const updatePlaylistIcon = () => {
      if (!bookmarkIcon) return;
      const isInPlaylist = userPlaylist.includes(movieSlug);
      if (isInPlaylist) {
        bookmarkIcon.classList.add('text-primary');
        bookmarkIcon.textContent = 'bookmark';
      } else {
        bookmarkIcon.classList.remove('text-primary');
        bookmarkIcon.textContent = 'bookmark_add';
      }
      const playlistTooltip = playlistBtn?.querySelector('.txatooltip');
      if (playlistTooltip) {
        playlistTooltip.textContent = isInPlaylist ? 'Xóa khỏi DS phát' : 'Thêm vào DS phát';
      }
    };

    const loadWatchListData = async () => {
      if (!username) {
        userFavorites = JSON.parse(localStorage.getItem('tfavorites') || '[]');
        userPlaylist = JSON.parse(localStorage.getItem('tplaylist') || '[]');
        updateFavIcon();
        updatePlaylistIcon();
        return;
      }
      try {
        const res = await fetch(`/api/user/watchlist?username=${encodeURIComponent(username)}`);
        if (res.ok) {
          const result: any = await res.json();
          if (result && result.status === 'success' && result.data) {
            userFavorites = result.data.favorites || [];
            userPlaylist = result.data.playlist || [];
          }
        }
      } catch (e) {
        console.warn('Failed to fetch watchlist from server:', e);
        userFavorites = JSON.parse(localStorage.getItem('tfavorites') || '[]');
        userPlaylist = JSON.parse(localStorage.getItem('tplaylist') || '[]');
      }
      updateFavIcon();
      updatePlaylistIcon();
    };

    loadWatchListData();

    if (favBtn) {
      favBtn.addEventListener('click', () => {
        requireLogin(async () => {
          const isFav = userFavorites.includes(movieSlug);
          if (!username) {
            const idx = userFavorites.indexOf(movieSlug);
            if (idx === -1) {
              userFavorites.push(movieSlug);
              if (window.showGlobalToast) window.showGlobalToast('Đã thêm phim vào danh sách Yêu thích!', 'success');
            } else {
              userFavorites.splice(idx, 1);
              if (window.showGlobalToast) window.showGlobalToast('Đã xóa phim khỏi danh sách Yêu thích!', 'success');
            }
            localStorage.setItem('tfavorites', JSON.stringify(userFavorites));
            updateFavIcon();
            return;
          }
          
          try {
            if (isFav) {
              const res = await fetch(`/api/user/watchlist?username=${encodeURIComponent(username)}&slug=${encodeURIComponent(movieSlug)}&type=favorite`, {
                method: 'DELETE'
              });
              if (res.ok) {
                userFavorites = userFavorites.filter(x => x !== movieSlug);
                if (window.showGlobalToast) window.showGlobalToast('Đã xóa phim khỏi danh sách Yêu thích!', 'success');
              }
            } else {
              const res = await fetch('/api/user/watchlist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, slug: movieSlug, type: 'favorite' })
              });
              if (res.ok) {
                userFavorites.push(movieSlug);
                if (window.showGlobalToast) window.showGlobalToast('Đã thêm phim vào danh sách Yêu thích!', 'success');
              }
            }
          } catch (e) {
            console.warn(e);
          }
          updateFavIcon();
        });
      });
    }

    if (playlistBtn) {
      playlistBtn.addEventListener('click', () => {
        requireLogin(async () => {
          const isInPlaylist = userPlaylist.includes(movieSlug);
          if (!username) {
            const idx = userPlaylist.indexOf(movieSlug);
            if (idx === -1) {
              userPlaylist.push(movieSlug);
              if (window.showGlobalToast) window.showGlobalToast('Đã lưu phim vào Danh sách phát!', 'success');
            } else {
              userPlaylist.splice(idx, 1);
              if (window.showGlobalToast) window.showGlobalToast('Đã gỡ phim khỏi Danh sách phát!', 'success');
            }
            localStorage.setItem('tplaylist', JSON.stringify(userPlaylist));
            updatePlaylistIcon();
            return;
          }

          try {
            if (isInPlaylist) {
              const res = await fetch(`/api/user/watchlist?username=${encodeURIComponent(username)}&slug=${encodeURIComponent(movieSlug)}&type=playlist`, {
                method: 'DELETE'
              });
              if (res.ok) {
                userPlaylist = userPlaylist.filter(x => x !== movieSlug);
                if (window.showGlobalToast) window.showGlobalToast('Đã gỡ phim khỏi Danh sách phát!', 'success');
              }
            } else {
              const res = await fetch('/api/user/watchlist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, slug: movieSlug, type: 'playlist' })
              });
              if (res.ok) {
                userPlaylist.push(movieSlug);
                if (window.showGlobalToast) window.showGlobalToast('Đã lưu phim vào Danh sách phát!', 'success');
              }
            }
          } catch (e) {
            console.warn(e);
          }
          updatePlaylistIcon();
        });
      });
    }

    // Action Share
    const shareBtn = document.getElementById('btn-share-action');
    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href)
          .then(() => {
            if (window.showGlobalToast) window.showGlobalToast('Đã sao chép liên kết chia sẻ phim!', 'success');
          })
          .catch(() => {
            if (window.showGlobalToast) window.showGlobalToast('Không thể sao chép liên kết!', 'error');
          });
      });
    }

    // 6. Local interactive Comments Section
    const initialComments = [
      {
        id: 1,
        author: "Phong Phạm",
        avatar: "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=80&h=80&q=80",
        content: "Dàn diễn viên diễn rất hay và hợp vai, cốt truyện kịch tính nhiều cú twist bất ngờ. Mọi người nhất định phải xem nha!",
        time: "10 ngày trước",
        likes: 24,
        dislikes: 2,
        replies: [
          {
            author: "Thanh Bình",
            content: "Đúng thế bạn ơi, tập cuối đỉnh thật sự luôn ấy.",
            time: "9 ngày trước"
          }
        ]
      },
      {
        id: 2,
        author: "Minh Thư",
        avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=80&h=80&q=80",
        content: "Phim xem rất cảm động, màu phim và nhạc phim đỉnh của chóp luôn. Vote 5 sao!",
        time: "3 ngày trước",
        likes: 12,
        dislikes: 0,
        replies: []
      }
    ];

    interface CommentReply {
      author: string;
      content: string;
      time: string;
    }

    interface MovieComment {
      id: any;
      author: string;
      avatar: string;
      content: string;
      time: string;
      likes: number;
      dislikes: number;
      replies: CommentReply[];
    }

    let comments: MovieComment[] = [];
    let currentReplyToId: any | null = null;
    let selectedRatingStar = 0;

    const commentsListContainer = document.getElementById('comments-list');
    const commentsCountEl = document.getElementById('comments-count');
    const commentTextarea = document.getElementById('comment-textarea') as HTMLTextAreaElement | null;
    const charCounter = document.getElementById('char-counter');
    const submitCommentBtn = document.getElementById('btn-submit-comment');
    const commentAnonCheck = document.getElementById('comment-anonymous') as HTMLInputElement | null;
    
    const btnShowComments = document.getElementById('btn-show-comments');
    const btnShowRating = document.getElementById('btn-show-rating');
    const ratingContainer = document.getElementById('rating-input-container');
    const ratingStars = document.querySelectorAll('#rating-stars-input span');
    
    const replyToLbl = document.getElementById('reply-to-lbl');
    const cancelReplyBtn = document.getElementById('cancel-reply-btn');

    // Rating: load existing user rating + display
    let currentUserRating = 0;
    let isRatingSubmitting = false;

    const fetchRating = async () => {
      try {
        const username = (window.APP_USER?.username || localStorage.getItem('tlogged_in_as') || '').trim();
        let url = `/api/user/rating?slug=${encodeURIComponent(movieSlug)}`;
        if (username) url += `&username=${encodeURIComponent(username)}`;
        const res = await fetch(url);
        if (res.ok) {
          const data = await res.json();
          if (data.status === 'success') {
            const r = data.data;
            const ratingDisplay = document.getElementById('average-rating-display');
            const reviewsDisplay = document.getElementById('reviews-count-display');
            if (ratingDisplay) ratingDisplay.textContent = String(r.averageRating || '--');
            if (reviewsDisplay) reviewsDisplay.textContent = String(r.totalRatings || 0);
            currentUserRating = r.userRating || 0;
            if (currentUserRating > 0) {
              selectedRatingStar = currentUserRating;
              ratingStars.forEach((s, i) => {
                if (i < currentUserRating) {
                  s.classList.add('text-amber-400');
                  s.classList.remove('text-gray-500');
                  s.classList.remove('hover:text-amber-400');
                } else {
                  s.classList.remove('text-amber-400');
                  s.classList.add('text-gray-500');
                }
              });
            }
          }
        }
      } catch (e) {
        console.error('Lỗi tải rating:', e);
      }
    };

    // Rating star handler - click = submit directly
    ratingStars.forEach(star => {
      star.addEventListener('click', async () => {
        if (isRatingSubmitting) return;
        const val = parseInt(star.getAttribute('data-star') || '0');
        if (currentUserRating > 0) {
          if (window.showGlobalToast) window.showGlobalToast('Bạn đã đánh giá phim này!', 'info');
          return;
        }
        if (requireLogin) {
          requireLogin(async () => {
            const username = (window.APP_USER?.username || localStorage.getItem('tlogged_in_as') || '').trim();
            if (!username) {
              if (window.showGlobalToast) window.showGlobalToast('Vui lòng đăng nhập để đánh giá!', 'error');
              return;
            }
            isRatingSubmitting = true;
            try {
              const res = await fetch('/api/user/rating', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  username,
                  slug: movieSlug,
                  rating: val
                })
              });
              if (res.ok) {
                const result = await res.json();
                if (result.status === 'success') {
                  currentUserRating = val;
                  selectedRatingStar = val;
                  ratingStars.forEach((s, i) => {
                    if (i < val) {
                      s.classList.add('text-amber-400');
                      s.classList.remove('text-gray-500');
                    } else {
                      s.classList.remove('text-amber-400');
                      s.classList.add('text-gray-500');
                    }
                  });
                  const r = result.data;
                  const ratingDisplay = document.getElementById('average-rating-display');
                  const reviewsDisplay = document.getElementById('reviews-count-display');
                  if (ratingDisplay) ratingDisplay.textContent = String(r.averageRating || '--');
                  if (reviewsDisplay) reviewsDisplay.textContent = String(r.totalRatings || 0);
                  if (window.showGlobalToast) window.showGlobalToast('Đã đánh giá phim!', 'success');
                }
              }
            } catch (e) {
              console.error(e);
              if (window.showGlobalToast) window.showGlobalToast('Lỗi khi đánh giá phim', 'error');
            } finally {
              isRatingSubmitting = false;
            }
          });
        }
      });
    });

    if (btnShowRating && ratingContainer) {
      btnShowRating.addEventListener('click', () => {
        if (currentUserRating > 0) {
          if (window.showGlobalToast) window.showGlobalToast(`Bạn đã đánh giá ${currentUserRating} sao!`, 'info');
          ratingContainer.classList.toggle('hidden');
          btnShowRating.classList.toggle('bg-primary/20');
          btnShowRating.classList.toggle('text-primary');
          return;
        }
        requireLogin(() => {
          ratingContainer.classList.toggle('hidden');
          btnShowRating.classList.toggle('bg-primary/20');
          btnShowRating.classList.toggle('text-primary');
        });
      });
    }

    if (btnShowComments) {
      btnShowComments.addEventListener('click', () => {
        if (ratingContainer) ratingContainer.classList.add('hidden');
        if (btnShowRating) {
          btnShowRating.classList.remove('bg-primary/20', 'text-primary');
        }
      });
    }

    // Load rating on page load
    fetchRating();

    // Track page view
    fetch('/api/movies/view', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug: movieSlug })
    }).catch(() => {});

    // Textarea char counter
    if (commentTextarea && charCounter) {
      commentTextarea.addEventListener('input', () => {
        const len = commentTextarea.value.length;
        charCounter.textContent = `${len} / 1000`;
        if (len > 1000) {
          charCounter.classList.add('text-red-400');
        } else {
          charCounter.classList.remove('text-red-400');
        }
      });
    }

    const formatDate = (isoStr: string) => {
      if (!isoStr) return "Vừa xong";
      try {
        const d = new Date(isoStr);
        const diffMs = Date.now() - d.getTime();
        const diffMin = Math.floor(diffMs / 60000);
        if (diffMin < 1) return "Vừa xong";
        if (diffMin < 60) return `${diffMin} phút trước`;
        const diffHour = Math.floor(diffMin / 60);
        if (diffHour < 24) return `${diffHour} giờ trước`;
        return d.toLocaleDateString('vi-VN', { hour: '2-digit', minute: '2-digit' });
      } catch (e) {
        return "Vừa xong";
      }
    };

    // Render comments list
    const renderComments = () => {
      if (!commentsListContainer || !commentsCountEl) return;
      
      commentsCountEl.textContent = String(comments.length);

      const currentUser = window.APP_USER || {};
      const currentUserName = (currentUser.name || currentUser.username || '').toLowerCase().trim();
      const isAdmin = currentUser.role === 'admin';

      const getEpisodeLink = (epName: string, svName: string) => {
        if (!epName || !servers) return null;
        let svIdx = 0;
        if (svName) {
          const foundSv = servers.findIndex(s => s.serverName === svName);
          if (foundSv !== -1) svIdx = foundSv;
        }
        const server = servers[svIdx];
        if (!server || !server.serverData) return null;
        const ep = server.serverData.find((e: any) => e.name === epName);
        if (ep) {
          return `/xem/${movieSlug}?ep=${ep.slug}&sv=${svIdx}`;
        }
        return null;
      };

      const getInitials = (name: string) => {
        return name.split(' ').map((n: string) => n[0]).slice(0, 2).join('').toUpperCase();
      };

      const avatarColors = ['#8b5cf6', '#ec4899', '#f59e0b', '#10b981', '#3b82f6', '#ef4444', '#14b8a6', '#f97316'];

      const renderMenu = (commentId: string, author: string, authorRole: string) => {
        const authorLower = author.toLowerCase().trim();
        const isOwner = currentUserName === authorLower;
        let items: string[] = [];

        if (isAdmin) {
          items = [
            `<button onclick="window.deleteComment('${commentId}')" class="w-full text-left px-3 py-1.5 text-[10px] text-rose-400 hover:bg-white/5 font-bold flex items-center gap-2"><span class="material-symbols-outlined text-[12px]">delete</span>Xoá bình luận</button>`,
            `<button onclick="window.toggleSpoiler('${commentId}')" class="w-full text-left px-3 py-1.5 text-[10px] text-amber-400 hover:bg-white/5 font-bold flex items-center gap-2"><span class="material-symbols-outlined text-[12px]">visibility_off</span>Spoiler</button>`,
            `<button onclick="window.reportComment('${commentId}')" class="w-full text-left px-3 py-1.5 text-[10px] text-zinc-400 hover:bg-white/5 font-bold flex items-center gap-2"><span class="material-symbols-outlined text-[12px]">report</span>Báo cáo</button>`
          ].join('');
        } else if (isOwner) {
          items = [
            `<button onclick="window.deleteComment('${commentId}')" class="w-full text-left px-3 py-1.5 text-[10px] text-rose-400 hover:bg-white/5 font-bold flex items-center gap-2"><span class="material-symbols-outlined text-[12px]">delete</span>Xoá</button>`,
            `<button onclick="window.toggleSpoiler('${commentId}')" class="w-full text-left px-3 py-1.5 text-[10px] text-amber-400 hover:bg-white/5 font-bold flex items-center gap-2"><span class="material-symbols-outlined text-[12px]">visibility_off</span>Spoiler</button>`
          ].join('');
        } else {
          items = [
            `<button onclick="window.reportComment('${commentId}')" class="w-full text-left px-3 py-1.5 text-[10px] text-zinc-400 hover:bg-white/5 font-bold flex items-center gap-2"><span class="material-symbols-outlined text-[12px]">report</span>Báo cáo</button>`,
            `<button onclick="window.toggleSpoiler('${commentId}')" class="w-full text-left px-3 py-1.5 text-[10px] text-amber-400 hover:bg-white/5 font-bold flex items-center gap-2"><span class="material-symbols-outlined text-[12px]">visibility_off</span>Spoiler</button>`
          ].join('');
        }

        return `
          <div class="relative comment-menu-container">
            <button onclick="event.stopPropagation(); this.nextElementSibling.classList.toggle('hidden')" class="text-zinc-500 hover:text-white transition-colors cursor-pointer p-0.5 bg-transparent border-none">
              <span class="material-symbols-outlined text-[14px]">more_vert</span>
            </button>
            <div class="hidden absolute right-0 top-6 z-50 w-44 bg-zinc-900 border border-zinc-700/50 rounded-xl shadow-2xl shadow-black/50 backdrop-blur-xl overflow-hidden py-1 comment-menu-dropdown">
              ${items}
            </div>
          </div>
        `;
      };

      const renderAvatar = (author: string, avatarUrl: string, size: string = 'w-7 h-7', textSize: string = 'text-[9px]') => {
        if (avatarUrl) {
          return `<img src="${avatarUrl}" alt="${author}" class="${size} rounded-full object-cover border border-glass-stroke shrink-0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" /><div class="${size} rounded-full shrink-0 items-center justify-center hidden ${textSize} font-bold text-white select-none" style="background:${avatarColors[author.length % avatarColors.length]}">${getInitials(author)}</div>`;
        }
        return `<div class="${size} rounded-full shrink-0 flex items-center justify-center ${textSize} font-bold text-white select-none" style="background:${avatarColors[author.length % avatarColors.length]}">${getInitials(author)}</div>`;
      };

      let html = '';
      comments.forEach((c: any) => {
        let repliesHtml = '';
        if (c.replies && c.replies.length > 0) {
          c.replies.forEach((rep: any) => {
            const isRepAdmin = rep.role === 'admin';
            const repGenderBadge = rep.gender === 'male' ? '<span class="text-[7px] bg-blue-500/20 text-blue-400 border border-blue-500/30 px-1.2 py-0.2 rounded font-bold">♂</span>' :
                                   rep.gender === 'female' ? '<span class="text-[7px] bg-pink-500/20 text-pink-400 border border-pink-500/30 px-1.2 py-0.2 rounded font-bold">♀</span>' : '';

            repliesHtml += `
              <div class="mt-2 pl-3 border-l-2 border-white/5 hover:border-white/10 transition-colors">
                <div class="flex items-center gap-2 flex-wrap">
                  ${renderAvatar(rep.author, rep.avatar || '', 'w-5 h-5', 'text-[8px]')}
                  <span class="text-[10px] font-bold ${isRepAdmin ? 'text-pink-400' : 'text-white'}">${rep.author}</span>
                  ${repGenderBadge}
                  <span class="text-[8px] text-zinc-500 font-medium">${rep.time}</span>
                </div>
                <p class="text-[11px] text-zinc-400 pl-7 leading-relaxed mt-0.5">${rep.content}</p>
              </div>
            `;
          });
        }

        const isCommentAdmin = c.role === 'admin';
        const genderBadge = c.gender === 'male' ? '<span class="text-[8px] bg-blue-500/20 text-blue-400 border border-blue-500/30 px-1 py-0.2 rounded font-bold">♂</span>' :
                            c.gender === 'female' ? '<span class="text-[8px] bg-pink-500/20 text-pink-400 border border-pink-500/30 px-1 py-0.2 rounded font-bold">♀</span>' :
                            c.gender === 'other' ? '<span class="text-[8px] bg-zinc-800 text-zinc-400 border border-zinc-700 px-1 py-0.2 rounded font-bold">∞</span>' : '';

        let epBadgeHtml = '';
        if (c.episodeName) {
          const isSingleMovie = movieType === 'movie';
          const epLabel = isSingleMovie 
            ? `${c.episodeName} - ${c.serverName || 'Server VIP'}`
            : `${c.episodeName} - ${movieSeasons}`;
          const epLink = getEpisodeLink(c.episodeName, c.serverName);
          
          if (epLink) {
            epBadgeHtml = `
              <a href="${epLink}" class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-primary/10 border border-primary/20 text-primary hover:bg-primary/20 transition-all flex items-center gap-0.5 cursor-pointer no-underline select-none">
                <span class="material-symbols-outlined text-[10px]">play_circle</span>
                ${epLabel}
              </a>
            `;
          } else {
            epBadgeHtml = `
              <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-white/5 border border-glass-stroke/50 text-zinc-400 flex items-center gap-0.5 select-none">
                <span class="material-symbols-outlined text-[10px]">play_circle</span>
                ${epLabel}
              </span>
            `;
          }
        }

        html += `
          <div class="p-4 bg-white/[0.02] border border-glass-stroke rounded-xl hover:bg-white/[0.04] hover:border-primary/15 transition-all duration-200 space-y-2 group">
            <div class="flex items-start gap-3">
              ${renderAvatar(c.author, c.avatar)}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h4 class="text-xs font-bold ${isCommentAdmin ? 'text-pink-400' : 'text-white'}">${c.author}</h4>
                  ${isCommentAdmin ? '<span class="bg-pink-500/20 text-pink-400 border border-pink-500/30 rounded px-1 py-0.2 text-[7px] font-bold uppercase tracking-wider">Admin</span>' : ''}
                  ${genderBadge}
                  <span class="text-[9px] text-zinc-500 font-medium">${c.time}</span>
                  ${epBadgeHtml}
                </div>

                <p class="text-xs text-zinc-300 leading-relaxed mt-1.5">${c.content}</p>

                <div class="flex items-center gap-3 mt-2">
                  <button class="flex items-center gap-1 text-[10px] text-zinc-500 hover:text-primary transition-colors cursor-pointer bg-transparent border-none p-0" onclick="window.likeComment('${c.id}')">
                    <span class="material-symbols-outlined text-[13px]">thumb_up</span>
                    <span class="font-bold">${c.likes}</span>
                  </button>
                  <button class="flex items-center gap-1 text-[10px] text-zinc-500 hover:text-red-400 transition-colors cursor-pointer bg-transparent border-none p-0" onclick="window.dislikeComment('${c.id}')">
                    <span class="material-symbols-outlined text-[13px]">thumb_down</span>
                    <span class="font-bold">${c.dislikes}</span>
                  </button>
                  <button class="flex items-center gap-1 text-[10px] text-zinc-500 hover:text-primary transition-colors cursor-pointer bg-transparent border-none p-0" onclick="window.setReplyTo('${c.id}')">
                    <span class="material-symbols-outlined text-[12px]">reply</span>
                    <span class="font-bold">Trả lời</span>
                  </button>
                  ${renderMenu(c.id, c.author, c.role)}
                </div>

                <div class="mt-2 space-y-1" id="replies-box-${c.id}">
                  ${repliesHtml}
                </div>
              </div>
            </div>
          </div>
        `;
      });

      commentsListContainer.innerHTML = html || '<p class="text-xs text-on-surface-variant py-4 text-center">Chưa có bình luận nào. Hãy gửi bình luận đầu tiên nhé!</p>';

      // Close dropdowns on outside click
      document.querySelectorAll('.comment-menu-container').forEach(container => {
        container.addEventListener('click', (e) => e.stopPropagation());
      });
    };

    // Global click to close all comment menus
    if (!window._commentMenuInit) {
      window._commentMenuInit = true;
      document.addEventListener('click', () => {
        document.querySelectorAll('.comment-menu-dropdown').forEach(d => d.classList.add('hidden'));
      });
    }

    window.deleteComment = async (commentId: string) => {
      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', commentId })
        });
        if (res.ok) {
          const result = await res.json();
          if (result.status === 'success') {
            comments = comments.filter((c: any) => c.id !== commentId);
            renderComments();
            if (window.showGlobalToast) window.showGlobalToast('Đã xoá bình luận!', 'success');
          }
        }
      } catch (e) {
        console.error(e);
        if (window.showGlobalToast) window.showGlobalToast('Lỗi khi xoá bình luận', 'error');
      }
    };

    window.toggleSpoiler = async (commentId: string) => {
      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'toggle_spoiler', commentId })
        });
        if (res.ok) {
          const result = await res.json();
          if (result.status === 'success') {
            if (window.showGlobalToast) window.showGlobalToast('Đã cập nhật tag spoiler!', 'success');
          }
        }
      } catch (e) {
        console.error(e);
        if (window.showGlobalToast) window.showGlobalToast('Lỗi khi cập nhật spoiler', 'error');
      }
    };

    window.reportComment = async (commentId: string) => {
      if (window.showGlobalToast) window.showGlobalToast('Đã báo cáo bình luận đến quản trị viên!', 'info');
    };

    const loadComments = async () => {
      try {
        const res = await fetch(`/api/comments?slug=${encodeURIComponent(movieSlug)}`);
        if (res.ok) {
          const result: any = await res.json();
          if (result && result.status === 'success' && Array.isArray(result.data)) {
            comments = result.data.map((c: any) => ({
              id: c.id,
              author: c.author,
              avatar: c.avatar || '',
              content: c.content,
              time: formatDate(c.createdAt),
              likes: c.likes || 0,
              dislikes: 0,
              package: c.package || 'Free',
              gender: c.gender || 'other',
              role: c.role || 'user',
              episodeName: c.episodeName || '',
              serverName: c.serverName || '',
              replies: (c.replies || []).map((rep: any) => ({
                author: rep.author,
                content: rep.content,
                time: formatDate(rep.createdAt),
                package: rep.package || 'Free',
                gender: rep.gender || 'other',
                role: rep.role || 'user',
                avatar: rep.avatar || ''
              }))
            }));
            renderComments();
          }
        }
      } catch (e) {
        console.error("Lỗi khi tải bình luận từ Supabase:", e);
      }
    };

    // Make utility functions global for inline button calls
    (window as any).likeComment = async (id: any) => {
      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'like', commentId: id })
        });
        if (res.ok) {
          const result: any = await res.json();
          if (result && result.status === 'success' && result.data) {
            const target = comments.find((c: MovieComment) => c.id === id);
            if (target) {
              target.likes = result.data.likes;
              renderComments();
            }
          }
        }
      } catch (e) {
        console.error(e);
      }
    };

    (window as any).dislikeComment = (id: any) => {
      const target = comments.find((c: MovieComment) => c.id === id);
      if (target) {
        target.dislikes++;
        renderComments();
      }
    };

    (window as any).setReplyTo = (id: any) => {
      currentReplyToId = id;
      if (replyToLbl && commentTextarea) {
        replyToLbl.classList.remove('hidden');
        commentTextarea.placeholder = `Trả lời bình luận của bạn viết tại đây...`;
        commentTextarea.focus();
      }
    };

    if (cancelReplyBtn) {
      cancelReplyBtn.addEventListener('click', (e) => {
        e.preventDefault();
        currentReplyToId = null;
        if (replyToLbl && commentTextarea) {
          replyToLbl.classList.add('hidden');
          commentTextarea.placeholder = `Viết bình luận của bạn tại đây...`;
        }
      });
    }

    // Initial load
    loadComments();

    // Comment submission handler
    if (submitCommentBtn && commentTextarea) {
      submitCommentBtn.addEventListener('click', () => {
        requireLogin(async () => {
          const text = commentTextarea.value.trim();
          if (!text) {
            if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập nội dung bình luận!', 'error');
            return;
          }
          if (text.length > 1000) {
            if (window.showGlobalToast) window.showGlobalToast('Bình luận vượt quá giới hạn 1000 ký tự!', 'error');
            return;
          }

          const loggedInUserStr = localStorage.getItem('tlogged_in_as');
          let authorName = (window.APP_USER ? window.APP_USER.name || window.APP_USER.username : null) || loggedInUserStr || "Ẩn danh";

          const isAnon = commentAnonCheck ? commentAnonCheck.checked : false;
          const author = isAnon ? "Ẩn danh" : authorName;
          
          if (currentReplyToId !== null) {
            try {
              const res = await fetch('/api/comments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  action: 'reply',
                  commentId: currentReplyToId,
                  replyAuthor: author,
                  replyContent: text
                })
              });
              if (res.ok) {
                const result: any = await res.json();
                if (result && result.status === 'success' && result.data) {
                  const parent = comments.find((c: MovieComment) => c.id === currentReplyToId);
                  if (parent) {
                    if (!parent.replies) parent.replies = [];
                    const replyUser = window.APP_USER || {};
                    parent.replies.push({
                      author: result.data.author,
                      content: result.data.content,
                      time: "Vừa xong",
                      package: replyUser.package || 'Free',
                      gender: replyUser.gender || 'other',
                      role: replyUser.role || 'user',
                      avatar: replyUser.avatar || ''
                    });
                    renderComments();
                    if (window.showGlobalToast) window.showGlobalToast('Đã gửi trả lời bình luận thành công!', 'success');
                  }
                }
              }
            } catch (e) {
              console.error(e);
            }
            // Reset reply context
            currentReplyToId = null;
            if (replyToLbl) replyToLbl.classList.add('hidden');
            commentTextarea.placeholder = `Viết bình luận của bạn tại đây...`;
          } else {
            try {
              const res = await fetch('/api/comments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  slug: movieSlug,
                  author: author,
                  content: text
                })
              });
              if (res.ok) {
                const result: any = await res.json();
                if (result && result.status === 'success' && result.data) {
                  const newComment = {
                    id: result.data.id,
                    author: result.data.author,
                    avatar: result.data.avatar || '',
                    content: result.data.content,
                    time: "Vừa xong",
                    likes: 0,
                    dislikes: 0,
                    package: result.data.package || 'Free',
                    gender: result.data.gender || 'other',
                    role: result.data.role || 'user',
                    replies: []
                  };
                  comments.unshift(newComment);
                  renderComments();
                  if (window.showGlobalToast) window.showGlobalToast('Đã đăng bình luận thành công!', 'success');
                }
              }
            } catch (e) {
              console.error(e);
            }
          }

          // Reset text and save
          commentTextarea.value = '';
          if (charCounter) charCounter.textContent = '0 / 1000';
          if (commentAnonCheck) commentAnonCheck.checked = false;
          
          // Reset stars if rated
          if (selectedRatingStar > 0) {
            selectedRatingStar = 0;
            ratingStars.forEach(s => {
              s.classList.remove('text-amber-400');
              s.classList.add('text-gray-500');
            });
            if (ratingContainer) ratingContainer.classList.add('hidden');
            if (btnShowRating) btnShowRating.classList.remove('bg-primary/20', 'text-primary');
          }
        });
      });
    }

    // 7. Localize broadcast schedule time dynamically to user timezone
    const noticeEl = document.getElementById('broadcastScheduleNotice');
    if (noticeEl) {
      const name = noticeEl.getAttribute('data-name');
      const dateStr = noticeEl.getAttribute('data-date');
      const timeStr = noticeEl.getAttribute('data-time');
      const notice = noticeEl.getAttribute('data-notice');

      if (dateStr) {
        let isoStr = `${dateStr}T00:00:00+07:00`;
        if (timeStr) {
          const parts = timeStr.split(':');
          if (parts.length === 2) {
            isoStr = `${dateStr}T${timeStr}:00+07:00`;
          } else {
            isoStr = `${dateStr}T${timeStr}+07:00`;
          }
        }
        try {
          const d = new Date(isoStr);
          const localHours = String(d.getHours()).padStart(2, '0');
          const localMinutes = String(d.getMinutes()).padStart(2, '0');
          const localDay = String(d.getDate()).padStart(2, '0');
          const localMonth = String(d.getMonth() + 1).padStart(2, '0');
          const localYear = d.getFullYear();

          const formattedDate = `${localDay}-${localMonth}-${localYear}`;
          const formattedTime = timeStr ? `${localHours}:${localMinutes}` : '';
          const localText = timeStr ? `${formattedTime} ngày ${formattedDate}` : `ngày ${formattedDate}`;

          if (name) {
            noticeEl.textContent = `${name} sẽ phát sóng lúc ${localText}. Hãy đón xem nhé!`;
          } else if (notice) {
            noticeEl.textContent = notice;
          } else {
            noticeEl.textContent = `Tập tiếp theo sẽ phát sóng lúc ${localText}. Hãy đón xem nhé!`;
          }
        } catch (e) {
          console.error("Error formatting local time:", e);
        }
      }
    }

    // 8. Countdown timer logic for broadcast schedule
    const countdownEl = document.getElementById('broadcastCountdown');
    if (countdownEl) {
      const targetStr = countdownEl.getAttribute('data-target');
      const timerEl = document.getElementById('countdownTimer');
      
      if (targetStr && timerEl) {
        const targetDate = new Date(targetStr).getTime();
        let wasPositive = (targetDate - Date.now()) > 0;
        let hasReloaded = false;
        
        const updateCountdown = () => {
          const now = Date.now();
          const diff = targetDate - now;
          
          if (diff > 0) {
            wasPositive = true;
          }
          
          if (diff <= 0) {
            timerEl.textContent = "Đã phát sóng!";
            clearInterval(countdownInterval);
            // Only reload if the countdown was actively running (not already past on mount)
            if (wasPositive && !hasReloaded) {
              hasReloaded = true;
              setTimeout(() => {
                window.location.reload();
              }, 2500);
            }
            return;
          }
          
          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((diff % (1000 * 60)) / 1000);
          
          let displayStr = '';
          if (days > 0) displayStr += `${days.toString().padStart(2, '0')}d `;
          displayStr += `${hours.toString().padStart(2, '0')}h : ${minutes.toString().padStart(2, '0')}m : ${seconds.toString().padStart(2, '0')}s`;
          
          timerEl.textContent = displayStr;
        };
        
        updateCountdown();
        const countdownInterval = setInterval(updateCountdown, 1000);
      }
    }
  });
</script>
