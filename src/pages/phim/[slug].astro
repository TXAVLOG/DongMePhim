    <script id="movie-banner" type="application/json" set:html={JSON.stringify(movie.bannerUrl)}></script>
    <script id="movie-poster" type="application/json" set:html={JSON.stringify(movie.posterUrl)}></script>
    <script id="movie-type" type="application/json" set:html={JSON.stringify(movie.type)}></script>
