          const stored = localStorage.getItem('tsettings');
          const parsed = stored ? JSON.parse(stored) : {};
          parsed.isCompact = isCompact;
          localStorage.setItem('tsettings', JSON.stringify(parsed));
        } catch (e) {
          console.warn('Error saving tsettings:', e);
