                <button id="btn-submit-comment" class="bg-primary text-on-primary hover:bg-primary/80 font-bold text-[11px] px-5 py-2 rounded-xl transition-all cursor-pointer flex items-center gap-1.5 active:scale-95 shadow-lg shadow-primary/20">
