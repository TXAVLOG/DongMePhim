    const toggleBtn = document.getElementById('toggle-compact-detail');
    const toggleCircle = document.getElementById('toggle-compact-circle');
    
    // Helper: Bind events to episode list page tabs
    function bindTabEvents() {
      if (!tabsContainer || !episodesContainer) return;
      const tabs = tabsContainer.querySelectorAll('.episode-tab');
      const episodes = episodesContainer.querySelectorAll('.episode-item');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const tabIdx = parseInt(tab.getAttribute('data-tab-idx') || '0');
          
          tabs.forEach(t => {
            t.classList.remove('bg-secondary', 'text-on-secondary', 'active-tab');
            t.classList.add('bg-surface', 'border', 'border-glass-stroke', 'text-on-surface-variant');
          });
          tab.classList.add('bg-secondary', 'text-on-secondary', 'active-tab');
          tab.classList.remove('bg-surface', 'border', 'border-glass-stroke', 'text-on-surface-variant');
          
          episodes.forEach(ep => {
            const epOwner = parseInt(ep.getAttribute('data-tab-owner') || '0');
            if (epOwner === tabIdx) {
              ep.classList.remove('hidden');
              ep.classList.add('flex');
            } else {
              ep.classList.add('hidden');
              ep.classList.remove('flex');
            }
          });
        });
      });
    }

    // Dynamic Render Episodes List
    function renderEpisodes(serverIdx: number, targetEpSlug?: string) {
      if (!episodesContainer || !tabsContainer || !servers[serverIdx]) return;
      
      activeServerIdx = serverIdx;
      const currentServer = servers[serverIdx];
      const episodesList = currentServer.serverData || [];
      const totalEps = episodesList.length;
      const epsPerTab = totalEps >= 100 ? 100 : 25;

      let targetIdx = 0;
      if (targetEpSlug) {
        const found = episodesList.findIndex((ep: any) => ep.slug === targetEpSlug);
        if (found !== -1) {
          targetIdx = found;
          activeEpisodeSlug = targetEpSlug;
        }
      }
      
      const activeTabIdx = Math.floor(targetIdx / epsPerTab);

      // Adjust container classes for Compact vs Thumbnail view
      if (isCompact) {
        episodesContainer.className = "grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-2.5 max-h-[300px] overflow-y-auto pr-2 custom-scrollbar";
      } else {
        episodesContainer.className = "grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar";
      }

      // Render Pagination Tabs
      if (totalEps > epsPerTab) {
        const totalTabs = Math.ceil(totalEps / epsPerTab);
        let tabsHtml = '';
        for (let i = 0; i < totalTabs; i++) {
          const isActive = i === activeTabIdx;
          tabsHtml += `
            <button 
              data-tab-idx="${i}"
              class="episode-tab shrink-0 px-3.5 py-1 rounded-lg text-[10px] font-bold transition-all cursor-pointer ${
                isActive 
                  ? 'bg-secondary text-on-secondary active-tab' 
                  : 'bg-surface border border-glass-stroke text-on-surface-variant hover:border-secondary hover:text-secondary'
              }"
            >
              ${i * epsPerTab + 1} - ${Math.min((i + 1) * epsPerTab, totalEps)}
            </button>
          `;
        }
        tabsContainer.innerHTML = tabsHtml;
        tabsContainer.classList.remove('hidden');
      } else {
        tabsContainer.innerHTML = '';
        tabsContainer.classList.add('hidden');
      }

      // Render Episodes Grid
      let epsHtml = '';
      episodesList.forEach((ep: any, idx: number) => {
        const tabOwner = Math.floor(idx / epsPerTab);
        const isTarget = ep.slug === activeEpisodeSlug && serverIdx === activeServerIdx;
        const isHidden = tabOwner !== activeTabIdx;

        if (isCompact) {
          epsHtml += `
            <a 
              href="/xem/${movieSlug}?ep=${ep.slug}&sv=${serverIdx}"
              data-ep-idx="${idx}"
              data-tab-owner="${tabOwner}"
              data-ep-slug="${ep.slug}"
              class="episode-item w-full py-3 rounded-xl text-xs font-bold transition-all cursor-pointer items-center justify-center gap-1.5 border ${
                isHidden ? 'hidden' : 'flex'
              } ${
                isTarget 
                  ? 'bg-primary/20 border border-primary text-primary hover:bg-primary/30' 
                  : 'bg-zinc-900/60 border-glass-stroke text-on-surface hover:bg-white/5 hover:border-white/15'
              }"
            >
              <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1">play_arrow</span>
              <span>${ep.name}</span>
            </a>
          `;
        } else {
          const thumb = ep.thumbUrl || ep.thumb || ep.thumbnail || ep.image || movieBanner || moviePoster || '/logo.png';
          epsHtml += `
            <a 
              href="/xem/${movieSlug}?ep=${ep.slug}&sv=${serverIdx}"
              data-ep-idx="${idx}"
              data-tab-owner="${tabOwner}"
              data-ep-slug="${ep.slug}"
              class="episode-item flex-col gap-2 cursor-pointer group ${
                isHidden ? 'hidden' : 'flex'
              }"
            >
              <div class="relative aspect-[16/9] rounded-xl overflow-hidden border-2 transition-all duration-200 ${
                isTarget ? 'border-amber-400 shadow-[0_0_15px_rgba(251,191,36,0.35)] scale-[1.01]' : 'border-glass-stroke group-hover:border-white/40'
              }">
                <img src="${thumb}" alt="${ep.name}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                
                <!-- Hover Play Button Overlay -->
                <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                  <div class="w-10 h-10 rounded-full border-2 border-white bg-black/35 flex items-center justify-center text-white shadow-lg transform scale-90 group-hover:scale-100 transition-all duration-200">
                    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1">play_arrow</span>
                  </div>
                </div>
              </div>
              <span class="text-[11px] font-bold transition-colors ${isTarget ? 'text-amber-400' : 'text-zinc-400 group-hover:text-amber-400'}">${ep.name}</span>
            </a>
          `;
        }
      });
      episodesContainer.innerHTML = epsHtml;

      bindTabEvents();
    }

    function updateToggleUI() {
      if (!toggleBtn || !toggleCircle) return;
      if (isCompact) {
        toggleBtn.classList.remove('bg-zinc-800');
        toggleBtn.classList.add('bg-amber-400');
        toggleCircle.classList.add('translate-x-3.5');
      } else {
        toggleBtn.classList.remove('bg-amber-400');
        toggleBtn.classList.add('bg-zinc-800');
        toggleCircle.classList.remove('translate-x-3.5');
      }
    }
    
    updateToggleUI();
    renderEpisodes(activeServerIdx, activeEpisodeSlug);
    
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        isCompact = !isCompact;
