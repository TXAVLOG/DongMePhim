                <button class="px-3.5 py-1 bg-surface border border-glass-stroke text-on-surface-variant rounded-lg text-[10px] font-bold hover:text-white cursor-pointer transition-colors active:scale-95" id="btn-show-rating">Đánh giá</button>
              </div>
