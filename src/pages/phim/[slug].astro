---
import MainLayout from '@layouts/MainLayout.astro';
import { MovieService } from '@services/MovieService';
import type { Movie } from '@apptypes/movie';
import { Button } from '@components/ui/Button';
import NotFound from '@components/ui/NotFound.astro';
import { supabase } from '@lib/supabase';

const { slug } = Astro.params;

let movie = null;
if (slug && slug !== 'undefined' && slug !== 'null') {
  movie = await MovieService.getMovieBySlug(slug);
}

if (!movie) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

// Ensure the page is never cached so that release schedule date/time checks are always fresh
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');

// Logic for episode pagination & filtering unreleased episodes
const rawServers = movie ? (movie.episodes || []) : [];
let servers = [];
let nextAiringEpisode = null;

if (movie && rawServers.length > 0) {
  // Check the first server episodes schedule
  const firstServer = rawServers[0];
  const allEps = firstServer.serverData || [];
  
  let firstUnreleasedIdx = -1;
  
  // Hide unreleased episodes only if status is "ongoing"
  if (movie.status === 'ongoing') {
    const nowTime = Date.now();
    for (let i = 0; i < allEps.length; i++) {
      const ep = allEps[i];
      if (ep.airDate) {
        let airDateTimeStr = `${ep.airDate}T00:00:00+07:00`;
        if (ep.airTime) {
          const parts = ep.airTime.split(':');
          if (parts.length === 2) {
            airDateTimeStr = `${ep.airDate}T${ep.airTime}:00+07:00`;
          } else {
            airDateTimeStr = `${ep.airDate}T${ep.airTime}+07:00`;
          }
        }
        try {
          const airDateObj = new Date(airDateTimeStr);
          if (nowTime < airDateObj.getTime()) {
            firstUnreleasedIdx = i;
            break;
          }
        } catch (e) {
          console.error('Error parsing air date:', e);
        }
      }
    }
  }

  if (firstUnreleasedIdx !== -1) {
    // Found first unreleased episode
    nextAiringEpisode = allEps[firstUnreleasedIdx];
    
    // Slice serverData to hide unreleased episodes
    servers = rawServers.map((server: any) => ({
      serverName: server.serverName,
      serverData: (server.serverData || []).slice(0, firstUnreleasedIdx)
    }));
  } else {
    servers = rawServers;
  }
} else {
  servers = rawServers;
}

// Check if broadcast schedule has passed
let isScheduleActive = false;
if (movie && movie.broadcastSchedule && movie.broadcastSchedule.nextDate) {
  let targetDateTimeStr = `${movie.broadcastSchedule.nextDate}T00:00:00+07:00`;
  if (movie.broadcastSchedule.nextTime) {
    const parts = movie.broadcastSchedule.nextTime.split(':');
    if (parts.length === 2) {
      targetDateTimeStr = `${movie.broadcastSchedule.nextDate}T${movie.broadcastSchedule.nextTime}:00+07:00`;
    } else {
      targetDateTimeStr = `${movie.broadcastSchedule.nextDate}T${movie.broadcastSchedule.nextTime}+07:00`;
    }
  }
  try {
    const targetDate = new Date(targetDateTimeStr).getTime();
    isScheduleActive = Date.now() < targetDate;
  } catch (e) {
    isScheduleActive = true;
  }
}

// Check if next airing episode has passed
let isNextEpisodeActive = false;
if (nextAiringEpisode && nextAiringEpisode.airDate) {
  let targetDateTimeStr = `${nextAiringEpisode.airDate}T00:00:00+07:00`;
  if (nextAiringEpisode.airTime) {
    const parts = nextAiringEpisode.airTime.split(':');
    if (parts.length === 2) {
      targetDateTimeStr = `${nextAiringEpisode.airDate}T${nextAiringEpisode.airTime}:00+07:00`;
    } else {
      targetDateTimeStr = `${nextAiringEpisode.airDate}T${nextAiringEpisode.airTime}+07:00`;
    }
  }
  try {
    const targetDate = new Date(targetDateTimeStr).getTime();
    isNextEpisodeActive = Date.now() < targetDate;
  } catch (e) {
    isNextEpisodeActive = true;
  }
}


const totalEps = servers.length > 0 ? (servers[0].serverData.length) : 0;
const episodesPerTab = totalEps >= 100 ? 100 : 25;

// Xác định phim lẻ linh hoạt
const isSingleMovie = movie ? (
  movie.type === 'movie' ||
  (movie as any).type === 'single' ||
  movie.episodeTotal === '1' ||
  movie.episodeCurrent === 'Full' ||
  (servers.length > 0 && servers[0].serverData.length === 1 && movie.status === 'completed')
) : false;

// Làm sạch tên server cho Phim Lẻ "Các bản chiếu"
let subCount = 0, tmCount = 0, ltCount = 0, fallbackCount = 0;
const cleanedServers = servers.map((srv: any) => {
  const nl = srv.serverName.toLowerCase();
  let cleanName = '';
  if (nl.includes('vietsub') || nl.includes('phụ đề') || nl.includes('sub')) {
    subCount++; cleanName = `Phụ đề #${subCount}`;
  } else if (nl.includes('thuyết minh') || nl.includes('thuyet minh')) {
    tmCount++; cleanName = `Thuyết minh #${tmCount}`;
  } else if (nl.includes('lồng tiếng') || nl.includes('long tieng')) {
    ltCount++; cleanName = `Lồng tiếng #${ltCount}`;
  } else {
    fallbackCount++; cleanName = `${srv.serverName} #${fallbackCount}`;
  }
  return { ...srv, cleanServerName: cleanName };
});

// Tải ảnh hậu trường từ TMDB qua proxy nội bộ
let backdrops: string[] = [];
if (movie) {
  try {
    const kkRes = await fetch(`https://phimapi.com/phim/${slug}`);
    if (kkRes.ok) {
      const kkData = await kkRes.json() as any;
      const tmdbId = kkData?.movie?.tmdb?.id;
      const tmdbType = kkData?.movie?.tmdb?.type || 'movie';
      if (tmdbId) {
        const tmdbApiKey = '211be8d45c0d31404f644ecdcf9caad5';
        const tmdbUrl = `https://api.tmdb.org/3/${tmdbType}/${tmdbId}/images?api_key=${tmdbApiKey}`;
        const tmdbRes = await fetch(tmdbUrl, {
          headers: {
            'Accept': 'application/json',
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
          }
        });
        if (tmdbRes.ok) {
          const tmdbImages = await tmdbRes.json() as any;
          if (tmdbImages && Array.isArray(tmdbImages.backdrops)) {
            backdrops = tmdbImages.backdrops
              .slice(0, 9)
              .map((img: any) => `https://image.tmdb.org/t/p/w780${img.file_path}`);
          }
        }
      }
    }
  } catch (e) {
    console.warn('Không thể tải ảnh hậu trường từ TMDB:', e);
  }
}
// Fallback nếu không lấy được ảnh từ TMDB
if (backdrops.length === 0 && movie) {
  backdrops = [movie.bannerUrl, movie.posterUrl, movie.bannerUrl].filter(Boolean) as string[];
}

// Fetch all movies to group seasons/parts of the same series
const allMovies = await MovieService.getMovies();
let relatedParts: Movie[] = [];
if (movie) {
  relatedParts = allMovies.filter((m: Movie) => {
    const normalize = (title: string) => {
      return title
        .toLowerCase()
        .replace(/(?:phần|ss|season|part|tập|phim|bộ)\s*\d+/gi, '')
        .replace(/\s+\d+$/g, '')
        .trim();
    };
    const baseTitle = normalize(movie.title);
    const mBaseTitle = normalize(m.title);
    return baseTitle.length > 2 && mBaseTitle === baseTitle;
  }).sort((a: Movie, b: Movie) => {
    return a.releaseYear - b.releaseYear || a.title.localeCompare(b.title);
  });
}

// Fetch related movies for the recommendations tab
const relatedMovies = movie ? await MovieService.getRelatedMovies(movie.id) : [];

// Fetch actor details for this movie if available
const slugify = (text: string) => {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[đĐ]/g, 'd')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
};

let castActors = [];
if (movie && movie.actors && movie.actors.length > 0) {
  const isSupabase = import.meta.env.PUBLIC_DATA_PROVIDER === 'supabase';
  if (isSupabase) {
    try {
      // 1. Query actors by movie relation
      const { data: movieActorRefs } = await supabase
        .from('movie_actors')
        .select('actor_id')
        .eq('movie_id', movie.id);
      
      let dbActors = [];
      if (movieActorRefs && movieActorRefs.length > 0) {
        const actorIds = movieActorRefs.map(ref => ref.actor_id);
        const { data } = await supabase
          .from('actors')
          .select('*')
          .in('id', actorIds);
        dbActors = data || [];
      }

      // 2. Also try fetching actors whose slug matches the slugified names in movie.actors, in case relations are missing
      const slugsToFetch = movie.actors.map((actorName: string) => slugify(actorName));
      const { data: dbActorsBySlug } = await supabase
        .from('actors')
        .select('*')
        .in('slug', slugsToFetch);
      
      // Combine them
      const allDbActors = [...dbActors];
      if (dbActorsBySlug) {
        dbActorsBySlug.forEach(a => {
          if (!allDbActors.some(x => x.id === a.id)) {
            allDbActors.push(a);
          }
        });
      }

      // Create maps for lookup: by name and by slug
      const dbActorBySlugMap = new Map(allDbActors.map(a => [a.slug.toLowerCase().trim(), a]));
      const dbActorByNameMap = new Map(allDbActors.map(a => [a.name.toLowerCase().trim(), a]));
      
      castActors = movie.actors.map((actorName: string) => {
        const nameKey = actorName.toLowerCase().trim();
        const slugKey = slugify(actorName).toLowerCase().trim();
        
        const dbActor = dbActorByNameMap.get(nameKey) || dbActorBySlugMap.get(slugKey);
        
        return {
          name: dbActor ? dbActor.name : actorName,
          slug: dbActor ? dbActor.slug : slugify(actorName),
          avatarUrl: dbActor ? dbActor.avatar_url : '/logo-decoy.png'
        };
      });
    } catch (e) {
      console.error('Error fetching movie cast from Supabase:', e);
      castActors = movie.actors.map((actorName: string) => ({
        name: actorName,
        slug: slugify(actorName),
        avatarUrl: '/logo-decoy.png'
      }));
    }
  } else {
    castActors = movie.actors.map((actorName: string) => ({
      name: actorName,
      slug: slugify(actorName),
      avatarUrl: '/logo-decoy.png'
    }));
  }
}
---

{movie ? (
  <MainLayout title={`${movie.title}`}>
    <!-- Background Hero Banner -->
    <div class="absolute top-0 left-0 w-full h-[35vh] md:h-[45vh] overflow-hidden z-0">
      <img id="movie-banner-img" src={movie.bannerUrl || movie.posterUrl} alt="Banner" class="w-full h-full object-cover opacity-20 blur-[1px]" />
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0A0A0B]/60 to-[#0A0A0B]"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0B] via-transparent to-[#0A0A0B]"></div>
    </div>

    <main class="max-w-container-max mx-auto px-gutter pt-24 md:pt-36 pb-16 relative z-10 space-y-8">
      
      <!-- Lịch phát sóng phim (nếu có) - Nổi bật ở đầu trang -->
      {(nextAiringEpisode && isNextEpisodeActive) ? (
        <div class="p-4 bg-gradient-to-r from-primary-container/20 via-primary-container/10 to-transparent border border-primary/20 rounded-2xl text-xs text-white flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-lg relative overflow-hidden" id="broadcastScheduleBadge">
          <div class="flex items-center gap-3 relative z-10">
            <div class="bg-primary/20 w-10 h-10 rounded-full flex items-center justify-center border border-primary/20 shrink-0">
              <span class="material-symbols-outlined text-xl text-primary">notifications</span>
            </div>
            <div>
              <span class="font-bold text-[13px] leading-tight block text-on-surface" id="broadcastScheduleNotice" data-name={nextAiringEpisode.name} data-date={nextAiringEpisode.airDate} data-time={nextAiringEpisode.airTime}>
                {nextAiringEpisode.name} sẽ phát sóng ngày {
                  (() => {
                    if (!nextAiringEpisode.airDate) return '';
                    const parts = nextAiringEpisode.airDate.split('-');
                    return parts.length === 3 ? `${parts[2]}-${parts[1]}-${parts[0]}` : nextAiringEpisode.airDate;
                  })()
                }. Hãy đón xem nhé!
              </span>
            </div>
          </div>
          
          {nextAiringEpisode.airTime && (
            <div class="bg-zinc-900/60 backdrop-blur-md px-4 py-2 rounded-xl border border-glass-stroke shrink-0 relative z-10 flex flex-col items-start sm:items-end justify-center" id="broadcastCountdown" data-target={nextAiringEpisode.airTime.split(':').length === 2 ? `${nextAiringEpisode.airDate}T${nextAiringEpisode.airTime}:00+07:00` : `${nextAiringEpisode.airDate}T${nextAiringEpisode.airTime}+07:00`}>
              <span class="text-[9px] text-on-surface-variant block uppercase font-bold tracking-wider mb-0.5">Đếm ngược phát sóng</span>
              <span class="font-mono text-[13px] font-black text-primary" id="countdownTimer">--:--:--</span>
            </div>
          )}
        </div>
      ) : (
        movie.broadcastSchedule && isScheduleActive && (movie.broadcastSchedule.notice || movie.broadcastSchedule.nextDate) && (

          <div class="p-4 bg-gradient-to-r from-primary-container/20 via-primary-container/10 to-transparent border border-primary/20 rounded-2xl text-xs text-white flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-lg relative overflow-hidden" id="broadcastScheduleBadge">
            <div class="flex items-center gap-3 relative z-10">
              <div class="bg-primary/20 w-10 h-10 rounded-full flex items-center justify-center border border-primary/20 shrink-0">
                <span class="material-symbols-outlined text-xl text-primary">notifications</span>
              </div>
              <div>
                <span class="font-bold text-[13px] leading-tight block text-on-surface" id="broadcastScheduleNotice" data-notice={movie.broadcastSchedule.notice} data-date={movie.broadcastSchedule.nextDate} data-time={movie.broadcastSchedule.nextTime}>
                  {movie.broadcastSchedule.notice || `Tập tiếp theo sẽ phát sóng ngày ${
                    (() => {
                      if (!movie.broadcastSchedule?.nextDate) return '';
                      const parts = movie.broadcastSchedule.nextDate.split('-');
                      return parts.length === 3 ? `${parts[2]}-${parts[1]}-${parts[0]}` : movie.broadcastSchedule.nextDate;
                    })()
                  }.`}
                </span>
              </div>
            </div>
            
            {movie.broadcastSchedule.nextTime && movie.broadcastSchedule.nextDate && (
              <div class="bg-zinc-900/60 backdrop-blur-md px-4 py-2 rounded-xl border border-glass-stroke shrink-0 relative z-10 flex flex-col items-start sm:items-end justify-center" id="broadcastCountdown" data-target={movie.broadcastSchedule.nextTime.split(':').length === 2 ? `${movie.broadcastSchedule.nextDate}T${movie.broadcastSchedule.nextTime}:00+07:00` : `${movie.broadcastSchedule.nextDate}T${movie.broadcastSchedule.nextTime}+07:00`}>
                <span class="text-[9px] text-on-surface-variant block uppercase font-bold tracking-wider mb-0.5">Đếm ngược phát sóng</span>
                <span class="font-mono text-[13px] font-black text-primary" id="countdownTimer">--:--:--</span>
              </div>
            )}
          </div>
        )
      )}

      <!-- Lưới hai cột hiển thị chi tiết phim -->
      <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-8">
        
        <!-- Cột trái: Ảnh Poster & Mô tả chung -->
        <div class="space-y-6">
          <div class="aspect-[2/3] w-full max-w-[280px] mx-auto rounded-2xl overflow-hidden shadow-2xl border border-glass-stroke relative group">
            <img id="movie-poster-img" src={movie.posterUrl} alt={movie.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-550" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
          </div>

          <div class="text-center lg:text-left space-y-2">
            <h1 id="movie-title-display" class="text-2xl md:text-3xl font-display-hero font-bold text-white leading-tight">{movie.title}</h1>
            <p id="movie-original-title-display" class="text-sm text-on-surface-variant font-medium">{movie.originalTitle || ''}</p>
          </div>

          <!-- Nút thu gọn / mở rộng thông tin phim cho mobile -->
          <button id="toggle-mobile-info" class="lg:hidden w-full flex items-center justify-between py-3 px-4 bg-white/5 border border-glass-stroke rounded-xl text-xs font-bold text-on-surface-variant hover:text-white transition-colors cursor-pointer">
            <span>Thông tin phim</span>
            <span class="material-symbols-outlined transition-transform duration-300" id="mobile-info-chevron">keyboard_arrow_down</span>
          </button>

          <div id="mobile-info-content" class="hidden lg:block space-y-5">
            <!-- Badges -->
            <div id="movie-badges-container" class="flex flex-wrap gap-2 justify-center lg:justify-start">
              {movie.imdbScore && (
                <span class="border border-amber-400/40 text-amber-400 bg-amber-400/5 text-[10px] font-bold px-2.5 py-0.5 rounded-md flex items-center gap-1 select-none">
                  IMDb {movie.imdbScore}
                </span>
              )}
              
              {movie.ageRating && (
                <span class="bg-primary text-slate-950 border border-primary text-[10px] font-black px-2.5 py-0.5 rounded-md select-none">
                  {movie.ageRating}
                </span>
              )}

              {movie.releaseYear && (
                <span class="border border-secondary/40 text-secondary bg-secondary/5 text-[10px] font-bold px-2.5 py-0.5 rounded-md select-none">
                  {movie.releaseYear}
                </span>
              )}

              <span class="border border-primary/40 text-primary bg-primary/5 text-[10px] font-bold px-2.5 py-0.5 rounded-md select-none">
                {movie.seasons || (movie.type === 'movie' ? 'Bản Điện Ảnh' : 'Phần 1')}
              </span>

              {movie.quality && (
                <span class="border border-secondary/40 text-secondary bg-secondary/5 text-[10px] font-bold px-2.5 py-0.5 rounded-md select-none">
                  {movie.quality}
                </span>
              )}

              {movie.lang && (
                <span class="border border-primary/40 text-primary bg-primary/5 text-[10px] font-bold px-2.5 py-0.5 rounded-md select-none">
                  {movie.lang}
                </span>
              )}
            </div>

            <!-- Genres -->
            <div id="movie-genres-container" class="flex flex-wrap gap-1.5 justify-center lg:justify-start">
              {movie.genres?.map((g: string) => (
                <span class="bg-white/5 border border-glass-stroke text-[10px] text-on-surface-variant px-2.5 py-1 rounded-full font-medium hover:border-primary/40 hover:text-primary transition-colors cursor-pointer">{g}</span>
              ))}
            </div>

            <!-- Trạng thái hoàn thành/đang chiếu -->
            <div class="flex justify-center lg:justify-start pt-1">
              {movie.status === 'completed' ? (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-[10px] font-bold rounded-xl shadow-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  Hoàn tất ({totalEps}/{totalEps})
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-500/10 border border-blue-500/25 text-blue-400 text-[10px] font-bold rounded-xl shadow-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
                  Đang chiếu (Tập {totalEps})
                </span>
              )}
            </div>

            <!-- Tóm tắt phim -->
            <div class="space-y-2">
              <h4 class="text-xs font-black uppercase tracking-widest text-primary">Giới thiệu</h4>
              <div id="movie-description-display" class="text-xs text-on-surface-variant leading-relaxed txaformat" set:html={movie.description}></div>
            </div>

            <!-- Bảng thông tin chi tiết -->
            <div class="border-t border-glass-stroke pt-4 space-y-2">
              <div class="flex justify-between text-xs py-1">
                <span class="text-on-surface-variant font-medium">Thời lượng:</span>
                <span id="movie-duration-display" class="text-white font-semibold">
                  {movie.durationMinutes ? (movie.durationMinutes.toString().includes('phút') ? movie.durationMinutes : `${movie.durationMinutes} phút`) : 'Đang cập nhật'}
                </span>
              </div>
              <div class="flex justify-between text-xs py-1">
                <span class="text-on-surface-variant font-medium">Quốc gia:</span>
                <span id="movie-country-display" class="text-white font-semibold">{movie.category || 'Nước ngoài'}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Cột phải: Khu vực Tương tác, Lịch chiếu, Tabs tập phim & Bình luận -->
        <div class="space-y-6">
          
          <!-- Thanh công cụ hành động (Action Bar) -->
          <div class="glass-card bg-surface-card border border-glass-stroke rounded-2xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-xl">
            <!-- Nút chính "Xem Ngay" & Nút phụ -->
            <div class="flex flex-wrap items-center gap-3">
              {totalEps > 0 ? (
                <>
                  <a href={`/xem/${movie.slug}?ep=tap-1`} id="btn-watch-now">
                    <Button className="rounded-full bg-gradient-to-br from-primary-container to-secondary-container hover:brightness-110 text-white font-bold px-7 py-3 gap-2 text-sm shadow-[0_4px_20px_rgba(124,58,237,0.25)] flex items-center active:scale-95 transition-all">
                      <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                      Xem Ngay
                    </Button>
                  </a>
                  {movie.trailerUrl && (
                    <button id="btn-watch-trailer" data-trailer-url={movie.trailerUrl} class="rounded-full glass-card border border-glass-stroke text-white font-bold px-7 py-3 gap-2 text-sm flex items-center active:scale-95 hover:bg-white/10 transition-all cursor-pointer">
                      <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 0;">movie</span>
                      Xem Trailer
                    </button>
                  )}
                </>
              ) : (
                movie.trailerUrl && (
                  <button id="btn-watch-trailer" data-trailer-url={movie.trailerUrl} class="rounded-full bg-gradient-to-br from-primary-container to-secondary-container hover:brightness-110 text-white font-bold px-7 py-3 gap-2 text-sm shadow-[0_4px_20px_rgba(124,58,237,0.25)] flex items-center active:scale-95 transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 0;">movie</span>
                    Xem Trailer
                  </button>
                )
              )}

              <div class="flex items-center gap-1.5">
                <button class="relative group p-2.5 rounded-full border border-glass-stroke text-on-surface-variant hover:text-primary hover:border-primary/40 transition-colors cursor-pointer" id="btn-favorite-action">
                  <span class="material-symbols-outlined text-lg" id="heart-icon">favorite</span>
                  <div class="txatooltip absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap pointer-events-none text-[10px]">Yêu thích</div>
                </button>

