<style>
  /* Custom Scrollbar for Episode List */
  .custom-scrollbar::-webkit-scrollbar {
    width: 5px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.15);
  }
  
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  declare global {
    interface Window {
      showGlobalToast?: (msg: string, type: string) => void;
      openLoginModal: () => void;
      txamodal?: any;
    }
  }

  document.addEventListener('astro:page-load', () => {
    // Check elements
    const serversDataEl = document.getElementById('servers-data');
    const movieSlugEl = document.getElementById('movie-slug');
    const movieTitleEl = document.getElementById('movie-title');
    if (!serversDataEl || !movieSlugEl || !movieTitleEl) return;

    let servers: any[] = [];
    try { servers = JSON.parse(serversDataEl.textContent || '[]'); } catch (e) { return; }
    const movieSlug = JSON.parse(movieSlugEl.textContent || '""');
    const movieTitle = JSON.parse(movieTitleEl.textContent || '""');
    const movieTypeEl = document.getElementById('movie-type');
    const movieSeasonsEl = document.getElementById('movie-seasons');
    const movieType = movieTypeEl ? JSON.parse(movieTypeEl.textContent || '"movie"') : 'movie';
    const movieSeasons = movieSeasonsEl ? JSON.parse(movieSeasonsEl.textContent || '"Phần 1"') : 'Phần 1';

    function getYouTubeEmbedUrl(url: string) {
      if (!url) return '';
      if (url.includes('<iframe') || url.includes('src=')) {
        const srcMatch = url.match(/src=["']([^"']+)["']/i);
        if (srcMatch && srcMatch[1]) {
          url = srcMatch[1];
        }
      }
      let videoId = '';
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
      const match = url.match(regExp);
      if (match && match[2].length === 11) {
        videoId = match[2];
      } else {
        const trimmed = url.trim();
        if (trimmed.length === 11 && !trimmed.includes('/') && !trimmed.includes('.')) {
          videoId = trimmed;
        } else if (url.includes('/embed/')) {
          const parts = url.split('/embed/');
          if (parts[1]) {
            videoId = parts[1].split('?')[0];
          }
        }
      }
      return videoId ? `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1` : url.replace('youtube.com', 'youtube-nocookie.com');
    }

    // Trailer Modal Button Event Listener
    const watchTrailerBtn = document.getElementById('btn-watch-trailer');
    if (watchTrailerBtn) {
      watchTrailerBtn.addEventListener('click', () => {
        const trailerUrl = watchTrailerBtn.getAttribute('data-trailer-url');
        if (trailerUrl) {
          const embedUrl = getYouTubeEmbedUrl(trailerUrl);
          if (embedUrl) {
            const contentHtml = `
              <div class="relative w-full aspect-video bg-black rounded-xl overflow-hidden shadow-2xl border border-white/5">
                <iframe 
                  src="${embedUrl}" 
                  class="absolute top-0 left-0 w-full h-full border-0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                  allowfullscreen
                  referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
              </div>
            `;
            if (window.txamodal) {
              window.txamodal.show({
                title: 'Trailer - ' + movieTitle,
                content: contentHtml,
                confirmText: 'Đóng'
              });
            }
          }
        }
      });
    }

    // 1. Mobile Info Toggler
    const toggleMobileBtn = document.getElementById('toggle-mobile-info');
    const mobileContent = document.getElementById('mobile-info-content');
    const mobileChevron = document.getElementById('mobile-info-chevron');
    if (toggleMobileBtn && mobileContent && mobileChevron) {
      toggleMobileBtn.addEventListener('click', () => {
        mobileContent.classList.toggle('hidden');
        mobileChevron.classList.toggle('rotate-180');
      });
    }

    // 2. Interactive Navigation Tabs
    const tabButtons = document.querySelectorAll('.detail-tab-btn');
    const tabPanels = document.querySelectorAll('.detail-tab-panel');
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        
        tabButtons.forEach(b => {
          b.classList.remove('border-b-2', 'border-primary', 'text-primary');
          b.classList.add('text-on-surface-variant', 'hover:text-white');
        });
