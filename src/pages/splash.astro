---
// src/pages/splash.astro
import '@styles/index.css';
import { ClientRouter } from 'astro:transitions';
---

<!DOCTYPE html>
<html class="dark" lang="vi">
<head>
    <ClientRouter />
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>DongPhim | Experience Cinema</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    
    <!-- We import our global styles which includes tailwind -->
    <style>
        :root {
            --neon-blue: #00e3fd;
            --neon-pink: #d2bbff;
            --bg-noir: #050505;
        }

        body {
            background-color: var(--bg-noir);
            margin: 0;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--neon-blue) 0%, var(--neon-pink) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-fill-color: transparent;
        }

        .bokeh-container {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
        }

        .bokeh {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.15;
            animation: float 20s infinite alternate ease-in-out;
        }

        @keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(10%, 15%) scale(1.1); }
            100% { transform: translate(-5%, 5%) scale(0.9); }
        }

        .progress-shimmer {
            background: linear-gradient(
                90deg,
                rgba(255, 255, 255, 0) 0%,
                rgba(255, 255, 255, 0.4) 50%,
                rgba(255, 255, 255, 0) 100%
            );
            background-size: 200% 100%;
            animation: shimmer 2s infinite linear;
        }

        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        .glass-loading-bar {
            background: rgba(255, 255, 255, 0.03);
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
        }

        .entrance-anim {
            animation: fadeInScale 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        @keyframes fadeInScale {
            0% { opacity: 0; transform: scale(0.95) translateY(10px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }
    </style>

</head>
<body class="bg-[#050505] min-h-screen flex items-center justify-center relative select-none overflow-hidden" style="opacity: 1; transition: opacity 0.8s ease-out;">
    <!-- Atmospheric Bokeh Layer -->
    <div class="bokeh-container">
        <div class="bokeh w-[500px] h-[500px] bg-primary/20 top-[-10%] left-[-5%]"></div>
        <div class="bokeh w-[600px] h-[600px] bg-secondary-fixed-dim/10 bottom-[-20%] right-[-10%]" style="animation-delay: -5s;"></div>
        <div class="bokeh w-[400px] h-[400px] bg-primary-container/10 top-[40%] right-[10%]" style="animation-delay: -2s;"></div>
    </div>
    
    <!-- Main Content Canvas -->
    <main class="relative z-10 flex flex-col items-center entrance-anim px-8 text-center">
        <!-- Brand Identity Group -->
        <div class="mb-12">
            <!-- Logo GIF -->
            <div class="mb-4 inline-flex items-center justify-center">
                <img src="/logo-icon.gif" alt="DongPhim Logo" class="h-16 w-auto" />
            </div>
            <!-- Logo with Premium Gradient -->
            <h1 class="font-display-hero text-5xl tracking-tighter leading-none mb-2 font-bold">
                <span class="gradient-text">DongPhim</span>
            </h1>
            <!-- Tagline -->
            <p class="font-label-caps text-xs text-on-surface-variant/60 tracking-[0.3em] font-bold">
                BEYOND CINEMA
            </p>
        </div>
        
        <!-- Sleek Glass Loading Cluster -->
        <div class="w-full max-w-[280px] space-y-6">
            <!-- Loading Track -->
            <div class="h-[2px] w-full glass-loading-bar overflow-hidden rounded-full relative">
                <!-- Glowing Progress Indicator -->
                <div class="absolute top-0 left-0 h-full bg-gradient-to-r from-secondary-container to-primary-container transition-all duration-300 ease-out shadow-[0_0_15px_rgba(0,227,253,0.5)]" id="progress-bar" style="width: 0%;">
                    <div class="absolute inset-0 progress-shimmer opacity-30"></div>
                </div>
            </div>
            <!-- Context Metadata -->
            <div class="flex justify-between items-center font-label-caps text-[10px] font-bold text-on-surface-variant/40">
                <span class="transition-opacity duration-300" id="loading-status">INITIALIZING...</span>
                <span class="" id="percent-text">0%</span>
            </div>
        </div>
    </main>

    <!-- Interactive Background Decoration (Subtle Grain) -->
    <div class="fixed inset-0 pointer-events-none opacity-[0.03] mix-blend-overlay bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"></div>

    <script>
        import { navigate } from 'astro:transitions/client';

        const runLoader = () => {
            const progressBar = document.getElementById('progress-bar');
            const percentText = document.getElementById('percent-text');
            const statusLabel = document.getElementById('loading-status');
            
            if (!progressBar) return; // Not on splash page

            let progress = 0;
            const statuses = [
                "ESTABLISHING SECURE CONNECTION",
                "OPTIMIZING CINEMATIC BUFFER",
                "LOADING NEON INTERFACE",
                "PREPARING YOUR EXPERIENCE"
            ];

            const updateLoading = () => {
                if (progress < 100) {
                    const increment = Math.random() * 2 + 0.5;
                    progress = Math.min(progress + increment, 100);
                    
                    if (progressBar) progressBar.style.width = `${progress}%`;
                    if (percentText) percentText.textContent = `${Math.floor(progress)}%`;

                    if (statusLabel) {
                        if (progress < 25) statusLabel.textContent = statuses[0];
                        else if (progress < 50) statusLabel.textContent = statuses[1];
                        else if (progress < 75) statusLabel.textContent = statuses[2];
                        else statusLabel.textContent = statuses[3];
                    }

                    requestAnimationFrame(updateLoading);
                } else {
                    if (statusLabel) {
                        statusLabel.textContent = "WELCOME TO DONGPHIM";
                        statusLabel.classList.add('text-secondary', 'font-bold');
                    }
                    
                    setTimeout(() => {
                        document.body.style.opacity = '0';
                        setTimeout(() => {
                            navigate('/tphim');
                        }, 800);
                    }, 500);
                }
            };

            setTimeout(updateLoading, 800);
        };

        // Run on first load and subsequent transitions
        document.addEventListener('astro:page-load', runLoader);

        // Atmospheric Bokeh Mouse Interaction
        document.addEventListener('mousemove', (e) => {
            const moveX = (e.clientX - window.innerWidth / 2) * 0.01;
            const moveY = (e.clientY - window.innerHeight / 2) * 0.01;
            
            document.querySelectorAll('.bokeh').forEach(bokeh => {
                (bokeh as HTMLElement).style.transform = `translate(${moveX}px, ${moveY}px)`;
            });
        });
    </script>
</body>
</html>
