---
import MainLayout from '@layouts/MainLayout.astro';
import { SettingService } from '@services/SettingService';

const serverSettings = await SettingService.getSettings();
---

<MainLayout title="Tổng kết đơn hàng & Thanh toán">
  <main class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 space-y-8 min-h-[80vh]">
    
    <!-- Header -->
    <div class="border-b border-glass-stroke pb-6 flex items-center gap-4">
      <a href="/nang-cap" class="p-2.5 bg-white/5 hover:bg-white/10 rounded-full text-zinc-400 hover:text-white transition-all">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div>
        <h1 class="font-display-hero text-3xl text-white font-bold tracking-tight">Tổng kết đơn hàng</h1>
        <p class="text-on-surface-variant text-xs mt-1 font-body-main">Kiểm tra thông tin chi tiết gói cước và chọn phương thức thanh toán.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Order Details & Pricing Table -->
      <div class="lg:col-span-7 space-y-6">
        <div class="glass-panel border border-glass-stroke rounded-3xl p-6 md:p-8 space-y-6 relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <span class="px-3 py-1 bg-primary/10 text-primary border border-primary/20 rounded-full text-[10px] font-black uppercase tracking-wider">THÔNG TIN GÓI DỊCH VỤ</span>
              <h2 id="summary-pkg-title" class="text-2xl font-black text-white mt-3">Đang tải...</h2>
              <p id="summary-pkg-cycle" class="text-xs text-zinc-400 mt-1 font-body-main hidden">Chu kỳ: Hàng tháng</p>
            </div>
            <div class="p-3 bg-surface-container-high rounded-2xl">
              <span class="material-symbols-outlined text-primary text-3xl">workspace_premium</span>
            </div>
          </div>

          <!-- Dynamic Duration / Cycle Selection Box -->
          <div id="summary-duration-wrapper" class="border-t border-glass-stroke/40 pt-4 space-y-3">
            <label class="text-[11px] text-primary font-bold uppercase tracking-wider flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm text-amber-400">schedule</span>
              Chọn thời hạn mua gói (Số tháng / 1 năm / Tùy chỉnh):
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-2" id="duration-selector-grid">
              <!-- Rendered dynamically -->
            </div>
            
            <!-- Custom Duration Input Container -->
            <div id="custom-duration-box" class="hidden mt-3 p-3 bg-zinc-900/90 border border-glass-stroke rounded-2xl flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <label class="text-xs font-bold text-zinc-300 whitespace-nowrap">Nhập số tháng mua:</label>
                <input type="number" id="custom-months-input" min="1" max="120" value="1" class="w-20 bg-black/50 border border-glass-stroke focus:border-primary px-3 py-1.5 rounded-xl text-white font-mono font-bold text-center text-sm focus:outline-none" />
              </div>
              <div class="text-xs font-bold text-amber-400 flex items-center gap-1.5 bg-amber-500/10 border border-amber-500/20 px-3 py-1.5 rounded-xl">
                <span class="material-symbols-outlined text-sm">timelapse</span>
                <span id="custom-months-formatted">1 tháng</span>
              </div>
            </div>
          </div>

          <!-- Package Details List -->
          <div class="border-t border-glass-stroke/40 pt-4 space-y-2.5 text-xs text-zinc-300" id="summary-features-container">
            <!-- Features populated dynamically -->
          </div>

          <!-- Email recipient input for Bypass Key packages -->
          <div id="bypass-email-wrapper" class="hidden border-t border-glass-stroke/40 pt-4 space-y-2">
            <label class="text-[11px] text-primary font-bold uppercase tracking-wider flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm">mail</span>
              Email nhận mã Key Bypass Zalo (Bắt buộc)
            </label>
            <input type="email" id="summary-recipient-email" placeholder="Ví dụ: name@example.com" class="w-full bg-zinc-900 border border-glass-stroke focus:border-primary rounded-xl px-4 py-3 text-xs text-white focus:outline-none transition-all" />
            <p class="text-[10px] text-zinc-500 font-body-main">Mã Key DP 8 ký tự sẽ được gửi tự động về địa chỉ email này ngay sau khi thanh toán thành công.</p>
          </div>

          <!-- Promo Code Input Container -->
          <div class="border-t border-glass-stroke/40 pt-4 space-y-2">
            <label class="text-[11px] font-bold text-zinc-300 uppercase tracking-wider flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm text-purple-400">confirmation_number</span>
              Mã giảm giá / Khuyến mãi (Voucher)
            </label>

            <!-- Input state (shown by default) -->
            <div id="promo-input-container" class="flex gap-2">
              <input type="text" id="promo-code-input" placeholder="Ví dụ: TX-KM100" class="flex-1 bg-zinc-900 border border-glass-stroke focus:border-purple-500 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none uppercase font-mono font-bold" />
              <button type="button" id="btn-apply-promo" class="px-4 py-2.5 bg-purple-600/20 hover:bg-purple-600/30 text-purple-400 border border-purple-500/30 rounded-xl font-bold text-xs transition-all cursor-pointer flex items-center gap-1">
                <span>Áp dụng</span>
              </button>
            </div>

            <!-- Ticket transform state (hidden by default) -->
            <div id="promo-ticket-container" class="hidden relative bg-gradient-to-r from-purple-950/60 to-indigo-950/60 border border-purple-500/40 rounded-xl p-3 flex items-center justify-between shadow-lg">
              <div class="flex items-center gap-2.5">
                <div class="p-2 bg-purple-500/20 rounded-lg text-purple-300">
                  <span class="material-symbols-outlined text-lg">local_activity</span>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span id="ticket-code-text" class="font-mono font-black text-purple-300 text-sm uppercase tracking-wide">KM100</span>
                    <span id="ticket-badge-text" class="px-2 py-0.5 bg-purple-500/20 text-purple-300 border border-purple-500/30 rounded text-[9px] font-bold uppercase">Giảm 100%</span>
                  </div>
                  <p id="ticket-desc-text" class="text-[10px] text-zinc-400 font-body-main mt-0.5">Đã áp dụng ưu đãi vào tổng tiền thanh toán</p>
                </div>
              </div>
              <button type="button" id="btn-remove-promo" class="p-1.5 bg-white/5 hover:bg-red-500/20 text-zinc-400 hover:text-red-400 rounded-lg transition-all cursor-pointer" data-txatooltip="Bỏ mã giảm giá">
                <span class="material-symbols-outlined text-sm">close</span>
              </button>
            </div>
          </div>

          <!-- Invoice Price Calculation Table -->
          <div class="border-t border-glass-stroke/40 pt-6 space-y-3 text-xs">
            <div class="flex justify-between items-center text-zinc-400">
              <span>Giá gốc dịch vụ (Tạm tính)</span>
              <span id="summary-subtotal-val" class="font-mono font-semibold text-white">0đ</span>
            </div>
            <div id="summary-discount-row" class="hidden flex justify-between items-center text-emerald-400">
              <div>
                <span class="font-bold block">Khuyến mãi</span>
                <span id="summary-discount-subtext" class="text-[10px] text-zinc-400 font-normal block">-</span>
              </div>
              <span id="summary-discount-val" class="font-mono font-black text-sm">-0đ</span>
            </div>
            <div class="flex justify-between items-center text-zinc-400">
              <span class="flex items-center gap-1">
                <span>Thuế giá trị gia tăng</span>
                <span id="summary-vat-badge" class="px-1.5 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded text-[9px] font-bold">VAT 8%</span>
              </span>
              <span id="summary-vat-val" class="font-mono font-semibold text-white">0đ</span>
            </div>
            <div class="border-t border-glass-stroke/30 pt-3 flex justify-between items-center text-sm font-bold">
              <span class="text-white uppercase tracking-wider font-label-caps">TỔNG CỘNG THANH TOÁN</span>
              <span id="summary-total-val" class="text-xl font-black text-primary font-mono">0đ</span>
            </div>
            <p class="text-[10px] text-zinc-500 text-right font-body-main italic">* Giá hiển thị đã bao gồm đầy đủ thuế VAT theo quy định.</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Payment Method Selection & Submit -->
      <div class="lg:col-span-5 space-y-6">
        <div class="glass-panel border border-glass-stroke rounded-3xl p-6 md:p-8 space-y-6">
          <div>
            <h3 class="text-base font-bold text-white uppercase tracking-wider">CHỌN PHƯƠNG THỨC THANH TOÁN</h3>
            <p class="text-xs text-zinc-400 mt-1 font-body-main">Vui lòng chọn cổng thanh toán tiện lợi nhất cho bạn.</p>
          </div>

          <div id="payment-methods-list" class="space-y-3">
            <!-- Rendered dynamically -->
          </div>

          <button id="btn-submit-checkout" class="w-full py-4 rounded-xl font-black text-xs text-slate-950 bg-primary hover:brightness-110 active:scale-95 transition-all cursor-pointer shadow-lg shadow-primary/20 flex items-center justify-center gap-2 uppercase tracking-wider border-none">
            <span>Xác nhận & Thanh toán</span>
            <span class="material-symbols-outlined text-base font-bold">arrow_forward</span>
          </button>
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<script is:inline define:vars={{ serverSettings }}>
  (function() {
    let loadedSettings = serverSettings || {};
    let selectedPackage = null;
    let selectedMethod = 'manual';
    let selectedCycle = 'monthly';
    let subtotal = 0;
    let vatAmount = 0;
    let totalAmount = 0;
    let vatRate = 8;
    let appliedPromo = null;

    const urlParams = new URLSearchParams(window.location.search);
    const pkgId = urlParams.get('packageId') || 'vip';
    selectedCycle = urlParams.get('cycle') || 'monthly';

    function getWatchedCount() {
      try {
        const stored = localStorage.getItem('thistory');
        if (!stored) return 0;
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed)) return parsed.length;
        if (typeof parsed === 'object' && parsed !== null) return Object.keys(parsed).length;
      } catch(e) {}
      return 0;
    }

    function getBypassDynamicPrice(basePrice = 49000) {
      const count = getWatchedCount();
      const welcomeDiscount = 20000; // Ưu đãi chào mừng giảm ngay 20k cho người dùng mới
      const countDiscount = count * 3000;
      const totalDiscount = Math.min(basePrice - 10000, welcomeDiscount + countDiscount);
      return Math.max(10000, basePrice - totalDiscount);
    }

    function formatMonthsToYearsAndMonths(months) {
      months = parseInt(months) || 1;
      if (months < 1) months = 1;
      if (months < 12) {
        return `${months} tháng`;
      }
      const years = Math.floor(months / 12);
      const remMonths = months % 12;
      if (remMonths === 0) {
        return `${years} năm`;
      }
      return `${years} năm ${remMonths} tháng`;
    }

    async function initOrderSummary() {
      const payments = loadedSettings.payments || {};
      vatRate = payments.vat_rate !== undefined ? Number(payments.vat_rate) : 8;
      const packages = loadedSettings.packages || [];

      // Find package
      selectedPackage = packages.find(p => p.id === pkgId) || packages.find(p => p.title.toLowerCase().includes(pkgId.toLowerCase()));

      if (!selectedPackage && (pkgId.includes('bypass') || pkgId.includes('zalo'))) {
        selectedPackage = {
          id: 'bypass_zalo',
          title: 'Gói Key Bypass Duyệt Zalo (15 Thiết bị)',
          price: 49000,
          annual_price: 399000,
          features: [
            'Tự động duyệt Zalo 100% ngay lập tức',
            'Cấp mã Key 8 ký tự độc lập (Dạng DPxxxxxx)',
            'Sử dụng trên tối đa 15 trình duyệt/thiết bị khác nhau',
            'Không cần đợi Admin phê duyệt thủ công'
          ]
        };
      }

      if (!selectedPackage) {
        selectedPackage = packages.find(p => p.id === 'vip') || { title: 'Gói VIP', price: 69000, features: [] };
      }

      if (selectedPackage && selectedPackage.enabled === false) {
        if (window.showGlobalToast) window.showGlobalToast('Gói cước này hiện tại đang tạm dừng cung cấp!', 'error');
        setTimeout(() => window.location.href = '/nang-cap', 1500);
        return;
      }

      // Populate package info
      document.getElementById('summary-pkg-title').textContent = selectedPackage.title;

      const featContainer = document.getElementById('summary-features-container');
      if (featContainer && selectedPackage.features) {
        featContainer.innerHTML = selectedPackage.features.map(f => `
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-emerald-400 text-base">check_circle</span>
            <span>${f}</span>
          </div>
        `).join('');
      }

      // Check if bypass key package to show email input & dynamic price note
      const isBypassPkg = (selectedPackage.id && selectedPackage.id.includes('bypass')) || selectedPackage.title.toLowerCase().includes('bypass') || selectedPackage.title.toLowerCase().includes('zalo');
      const emailWrapper = document.getElementById('bypass-email-wrapper');
      if (emailWrapper) {
        if (isBypassPkg) {
          emailWrapper.classList.remove('hidden');
          const savedEmail = urlParams.get('email') || sessionStorage.getItem('txa_saved_email') || (window.APP_USER ? window.APP_USER.email : '') || '';
          const emailInput = document.getElementById('summary-recipient-email');
          if (emailInput && savedEmail) emailInput.value = savedEmail;

          const watchedCount = getWatchedCount();
          if (watchedCount > 0 && featContainer) {
            const monthlyDiscounted = getBypassDynamicPrice(selectedPackage.price);
            const discountNote = document.createElement('div');
            discountNote.id = 'bypass-discount-note';
            discountNote.className = 'flex items-center gap-2 text-purple-300 bg-purple-500/10 border border-purple-500/20 p-2.5 rounded-xl font-bold mt-2';
            discountNote.innerHTML = `<span class="material-symbols-outlined text-amber-400 text-base">workspace_premium</span><span>Ưu đãi tri ân máy bạn đã xem ${watchedCount} phim: Giảm gốc theo tháng còn ${monthlyDiscounted.toLocaleString('vi-VN')}đ/tháng</span>`;
            featContainer.appendChild(discountNote);
          }
        } else {
          emailWrapper.classList.add('hidden');
        }
      }

      // Setup custom input listener
      const customInput = document.getElementById('custom-months-input');
      if (customInput) {
        customInput.addEventListener('input', function() {
          recalculatePrice();
        });
      }

      // Render Duration / Cycle selection buttons
      renderDurationOptions();

      // Setup Promo Code handlers
      setupPromoCodeHandlers();

      // Calculate initial Price & VAT
      recalculatePrice();

      // Render Payment Methods
      renderPaymentMethods(payments);
    }

    function setupPromoCodeHandlers() {
      const applyBtn = document.getElementById('btn-apply-promo');
      const removeBtn = document.getElementById('btn-remove-promo');
      const promoInput = document.getElementById('promo-code-input');

      if (applyBtn && promoInput) {
        applyBtn.addEventListener('click', async () => {
          let code = promoInput.value.trim().toUpperCase();
          if (!code) {
            if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập mã giảm giá!', 'error');
            return;
          }

          if (!code.startsWith('TX-')) {
            if (window.showGlobalToast) window.showGlobalToast('Định dạng mã không hợp lệ! Mã giảm giá phải bắt đầu bằng TX- (Ví dụ: TX-KM100)', 'error');
            return;
          }

          applyBtn.disabled = true;
          applyBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">autorenew</span>';

          const username = (window.APP_USER ? window.APP_USER.username : null) || 'guest';
          try {
            const res = await fetch('/api/user/verify-promo', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                code: code,
                packageTitle: selectedPackage ? selectedPackage.title : '',
                username: username,
                currentPrice: totalAmount
              })
            });
            const result = await res.json();

            if (res.ok && result.status === 'success') {
              appliedPromo = {
                code: code,
                discountAmount: result.data.discountAmount,
                discountType: result.data.discountType,
                discountValue: result.data.discountValue
              };

              if (window.showGlobalToast) window.showGlobalToast('Áp dụng mã giảm giá thành công!', 'success');
              
              // Transform input to Ticket UI
              document.getElementById('promo-input-container')?.classList.add('hidden');
              const ticketBox = document.getElementById('promo-ticket-container');
              if (ticketBox) {
                document.getElementById('ticket-code-text').textContent = code;
                document.getElementById('ticket-badge-text').textContent = result.data.discountType === 'percent' ? `Giảm ${result.data.discountValue}%` : `Giảm ${result.data.discountValue.toLocaleString('vi-VN')}đ`;
                ticketBox.classList.remove('hidden');
              }

              recalculatePrice();
            } else {
              if (window.showGlobalToast) window.showGlobalToast(result.message || 'Mã không hợp lệ!', 'error');
            }
          } catch (e) {
            if (window.showGlobalToast) window.showGlobalToast('Lỗi kiểm tra mã giảm giá!', 'error');
          } finally {
            applyBtn.disabled = false;
            applyBtn.innerHTML = '<span>Áp dụng</span>';
          }
        });
      }

      if (removeBtn) {
        removeBtn.addEventListener('click', () => {
          if (window.txamodal) {
            window.txamodal.show({
              title: '🎟️ Bỏ sử dụng mã giảm giá?',
              content: '<p class="text-xs text-zinc-300 pt-2">Bạn có chắc chắn muốn bỏ áp dụng mã giảm giá này cho đơn hàng?</p>',
              confirmText: 'Bỏ mã',
              cancelText: 'Giữ lại',
              onConfirm: () => {
                appliedPromo = null;
                document.getElementById('promo-ticket-container')?.classList.add('hidden');
                document.getElementById('promo-input-container')?.classList.remove('hidden');
                if (promoInput) promoInput.value = '';
                recalculatePrice();
                if (window.showGlobalToast) window.showGlobalToast('Đã bỏ mã giảm giá.', 'info');
              }
            });
          } else {
            appliedPromo = null;
            document.getElementById('promo-ticket-container')?.classList.add('hidden');
            document.getElementById('promo-input-container')?.classList.remove('hidden');
            if (promoInput) promoInput.value = '';
            recalculatePrice();
          }
        });
      }

      // Tự động điền và áp dụng mã giảm giá nếu người dùng đi qua link có tham số ?promo=... hoặc &promo=... (hoặc ?coupon=...)
      const urlPromo = urlParams.get('promo') || urlParams.get('coupon');
      if (urlPromo && promoInput && applyBtn) {
        let cleanUrlPromo = urlPromo.trim().toUpperCase();
        if (!cleanUrlPromo.startsWith('TX-')) {
          cleanUrlPromo = 'TX-' + cleanUrlPromo;
        }
        promoInput.value = cleanUrlPromo;
        setTimeout(() => {
          applyBtn.click();
        }, 300);
      }
    }

    function renderDurationOptions() {
      const grid = document.getElementById('duration-selector-grid');
      if (!grid) return;

      const cycles = [
        { id: 'monthly', label: '1 Tháng', months: 1, badge: '' },
        { id: '3months', label: '3 Tháng', months: 3, badge: '' },
        { id: '6months', label: '6 Tháng', months: 6, badge: 'Giảm 5%' },
        { id: 'annual', label: '1 Năm (12T)', months: 12, badge: 'Giảm 9%' },
        { id: 'custom', label: 'Tùy chỉnh', months: 0, badge: 'Nhập tháng' }
      ];

      grid.innerHTML = cycles.map(c => {
        const isSelected = c.id === selectedCycle;
        const activeClass = isSelected ? 'border-primary bg-primary/10 text-white font-black shadow-lg shadow-primary/20' : 'border-glass-stroke bg-white/5 text-zinc-400 hover:bg-white/10 hover:text-white font-medium';
        return `
          <button type="button" onclick="selectCycleOption('${c.id}')" class="p-2.5 rounded-2xl border ${activeClass} flex flex-col items-center justify-center gap-1 transition-all cursor-pointer relative overflow-hidden text-center">
            ${c.badge ? `<span class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[7px] font-black px-1.5 py-0.5 rounded-bl">${c.badge}</span>` : ''}
            <span class="text-[11px] uppercase tracking-wider font-label-caps mt-1">${c.label}</span>
          </button>
        `;
      }).join('');

      const customBox = document.getElementById('custom-duration-box');
      if (customBox) {
        if (selectedCycle === 'custom') {
          customBox.classList.remove('hidden');
          customBox.classList.add('flex');
        } else {
          customBox.classList.add('hidden');
          customBox.classList.remove('flex');
        }
      }
    }

    window.selectCycleOption = function(cId) {
      selectedCycle = cId;
      renderDurationOptions();
      recalculatePrice();
    };

    function recalculatePrice() {
      const isBypassPkg = (selectedPackage.id && selectedPackage.id.includes('bypass')) || selectedPackage.title.toLowerCase().includes('bypass') || selectedPackage.title.toLowerCase().includes('zalo');
      
      let baseMonthlyPrice = selectedPackage.price;
      if (isBypassPkg) {
        baseMonthlyPrice = getBypassDynamicPrice(baseMonthlyPrice);
      }

      let numMonths = 1;
      if (selectedCycle === 'monthly') numMonths = 1;
      else if (selectedCycle === '3months') numMonths = 3;
      else if (selectedCycle === '6months') numMonths = 6;
      else if (selectedCycle === 'annual') numMonths = 12;
      else if (selectedCycle === 'custom') {
        const input = document.getElementById('custom-months-input');
        numMonths = parseInt(input ? input.value : 1) || 1;
        if (numMonths < 1) numMonths = 1;
      }

      let discountRate = 0;
      if (numMonths >= 12) {
        discountRate = 0.09; // 1 năm giảm 9%
      } else if (numMonths >= 6) {
        discountRate = 0.05; // 6 tháng giảm 5%
      }

      const formattedEl = document.getElementById('custom-months-formatted');
      if (formattedEl) {
        const timeStr = formatMonthsToYearsAndMonths(numMonths);
        const discStr = discountRate > 0 ? ` (Giảm ${(discountRate * 100).toFixed(0)}%)` : '';
        formattedEl.textContent = `${timeStr}${discStr}`;
      }

      const rawOriginalMonthlyPrice = selectedPackage.price;
      const rawOriginalTotal = rawOriginalMonthlyPrice * numMonths;
      const rawOriginalSubtotal = Math.round(rawOriginalTotal / (1 + vatRate / 100));

      let calcTotal = Math.round(baseMonthlyPrice * numMonths * (1 - discountRate));

      // Calculate promo discount if applied
      let promoDiscountVal = 0;
      if (appliedPromo) {
        if (appliedPromo.discountType === 'percent') {
          promoDiscountVal = Math.round((calcTotal * appliedPromo.discountValue) / 100);
        } else {
          promoDiscountVal = appliedPromo.discountValue;
        }
        if (promoDiscountVal > calcTotal) promoDiscountVal = calcTotal;
      }

      const finalTotalBeforeVat = Math.max(0, calcTotal - promoDiscountVal);
      totalAmount = Math.round(finalTotalBeforeVat);
      subtotal = Math.round(totalAmount / (1 + vatRate / 100));
      vatAmount = totalAmount - subtotal;

      const fmt = num => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(num);

      const subtotalEl = document.getElementById('summary-subtotal-val');
      if (subtotalEl) {
        if (rawOriginalSubtotal > subtotal) {
          subtotalEl.innerHTML = `<span class="line-through text-zinc-500 mr-2 font-normal">${fmt(rawOriginalSubtotal)}</span><span class="text-white font-semibold">${fmt(subtotal)}</span>`;
        } else {
          subtotalEl.innerHTML = `<span class="font-semibold text-white">${fmt(subtotal)}</span>`;
        }
      }

      // Display Promo Discount Row in breakdown table
      const discountRow = document.getElementById('summary-discount-row');
      if (discountRow) {
        if (appliedPromo && promoDiscountVal > 0) {
          discountRow.classList.remove('hidden');
          const subtext = appliedPromo.discountType === 'percent' ? `giảm ${appliedPromo.discountValue}% trong ${formatMonthsToYearsAndMonths(numMonths)}` : `giảm trực tiếp ${fmt(appliedPromo.discountValue)}`;
          document.getElementById('summary-discount-subtext').textContent = subtext;
          document.getElementById('summary-discount-val').textContent = `-${fmt(promoDiscountVal)}`;
        } else {
          discountRow.classList.add('hidden');
        }
      }

      document.getElementById('summary-vat-badge').textContent = `VAT ${vatRate}%`;
      document.getElementById('summary-vat-val').textContent = fmt(vatAmount);

      const totalEl = document.getElementById('summary-total-val');
      if (totalEl) {
        if (rawOriginalTotal > totalAmount) {
          totalEl.innerHTML = `<span class="line-through text-zinc-500 text-sm font-semibold mr-2 font-mono">${fmt(rawOriginalTotal)}</span><span class="text-xl font-black text-primary font-mono">${fmt(totalAmount)}</span>`;
        } else {
          totalEl.innerHTML = `<span class="text-xl font-black text-primary font-mono">${fmt(totalAmount)}</span>`;
        }
      }
    }

    function renderPaymentMethods(payments) {
      const listContainer = document.getElementById('payment-methods-list');
      if (!listContainer) return;

      const methods = [];
      if (payments.manual_enable ?? true) methods.push({ id: 'manual', label: 'Chuyển khoản VietQR (Thủ công)', icon: 'qr_code_scanner' });
      if (payments.sepay_enable ?? true) methods.push({ id: 'sepay', label: 'Cổng SePay Tự Động', icon: 'bolt' });
      if (payments.payos_enable) methods.push({ id: 'payos', label: 'Cổng PayOS', icon: 'credit_card' });
      if (payments.vnpay_enable) methods.push({ id: 'vnpay', label: 'Cổng VNPAY', icon: 'account_balance_wallet' });
      if (payments.stripe_enable) methods.push({ id: 'stripe', label: 'Cổng Thẻ Quốc Tế Stripe', icon: 'credit_card' });

      if (methods.length === 0) {
        methods.push({ id: 'manual', label: 'Chuyển khoản VietQR', icon: 'qr_code_scanner' });
      }

      selectedMethod = methods[0].id;

      listContainer.innerHTML = methods.map(m => {
        const isChecked = m.id === selectedMethod ? 'checked' : '';
        const borderClass = m.id === selectedMethod ? 'border-primary bg-primary/5' : 'border-glass-stroke bg-white/5 hover:bg-white/10';
        return `
          <label onclick="selectPaymentMethod('${m.id}')" class="flex items-center justify-between p-4 rounded-2xl border ${borderClass} cursor-pointer transition-all">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-xl">${m.icon}</span>
              <span class="text-xs font-bold text-white">${m.label}</span>
            </div>
            <input type="radio" name="payment_method_choice" value="${m.id}" ${isChecked} class="accent-primary w-4 h-4 cursor-pointer" />
          </label>
        `;
      }).join('');
    }

    window.selectPaymentMethod = function(id) {
      selectedMethod = id;
      const labels = document.querySelectorAll('#payment-methods-list label');
      labels.forEach(lbl => {
        const radio = lbl.querySelector('input');
        if (radio.value === id) {
          radio.checked = true;
          lbl.className = 'flex items-center justify-between p-4 rounded-2xl border border-primary bg-primary/5 cursor-pointer transition-all';
        } else {
          radio.checked = false;
          lbl.className = 'flex items-center justify-between p-4 rounded-2xl border border-glass-stroke bg-white/5 hover:bg-white/10 cursor-pointer transition-all';
        }
      });
    };

    // Submit handler
    const submitBtn = document.getElementById('btn-submit-checkout');
    if (submitBtn) {
      submitBtn.onclick = async function() {
        const isBypassPkg = (selectedPackage.id && selectedPackage.id.includes('bypass')) || selectedPackage.title.toLowerCase().includes('bypass') || selectedPackage.title.toLowerCase().includes('zalo');
        let recipientEmail = '';

        if (isBypassPkg) {
          const emailInput = document.getElementById('summary-recipient-email');
          recipientEmail = emailInput ? emailInput.value.trim() : '';
          if (!recipientEmail || !recipientEmail.includes('@')) {
            if (window.showGlobalToast) window.showGlobalToast('Vui lòng nhập đúng địa chỉ Email nhận mã Key Bypass Zalo!', 'error');
            return;
          }
        } else {
          recipientEmail = (window.APP_USER ? window.APP_USER.email : '') || '';
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner animate-spin"></i> <span>Đang xử lý...</span>';

        // Fetch location & device info from ipinfo.io
        let clientInfo = '';
        try {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 2200);
          const ipRes = await fetch('https://ipinfo.io/json', { signal: controller.signal });
          clearTimeout(timeoutId);
          let ipData = null;
          if (ipRes.ok) ipData = await ipRes.json();

          const ua = navigator.userAgent;
          let os = 'Unknown OS';
          let browser = 'Unknown Browser';
          if (ua.includes('Windows')) os = 'Windows';
          else if (ua.includes('Macintosh') || ua.includes('Mac OS')) os = 'macOS';
          else if (ua.includes('iPhone')) os = 'iPhone';
          else if (ua.includes('iPad')) os = 'iPad';
          else if (ua.includes('Android')) os = 'Android';
          else if (ua.includes('Linux')) os = 'Linux';

          if (ua.includes('Chrome') || ua.includes('CriOS')) browser = 'Chrome';
          else if (ua.includes('Firefox')) browser = 'Firefox';
          else if (ua.includes('Safari') && !ua.includes('Chrome')) browser = 'Safari';
          else if (ua.includes('Edge')) browser = 'Edge';
          else if (ua.includes('Zalo')) browser = 'Zalo App';

          clientInfo = `${browser} (${os}) [Màn: ${window.screen.width}x${window.screen.height}]`;
          if (ipData) {
            clientInfo += ` | IP: ${ipData.ip || ''} - ${ipData.city || ''}, ${ipData.region || ''} (${ipData.country || ''}) | Org: ${ipData.org || ''}`;
          }
        } catch (e) {}

        let finalCycleStr = selectedCycle;
        if (selectedCycle === 'custom') {
          const input = document.getElementById('custom-months-input');
          const m = parseInt(input ? input.value : 1) || 1;
          finalCycleStr = `custom_${m}_months`;
        }

        const username = (window.APP_USER ? window.APP_USER.username : null) || 'guest_' + Math.random().toString(36).substring(2, 8);
        const txid = 'TXA' + Math.random().toString(36).substring(2, 10).toUpperCase();

        // Save initial pending payment record with clientInfo and promoCode
        try {
          await fetch('/api/user/payments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              txid: txid,
              username: username,
              email: recipientEmail,
              packageTitle: selectedPackage.title,
              price: totalAmount,
              cycle: finalCycleStr,
              method: selectedMethod,
              status: 'pending',
              promoCode: appliedPromo ? appliedPromo.code : null,
              note: clientInfo
            })
          });
        } catch (e) {}

        const encodedInfo = encodeURIComponent(clientInfo);
        const payments = loadedSettings.payments || {};
        if (selectedMethod === 'manual') {
          window.location.href = `/checkout/manual?txid=${txid}&packageTitle=${encodeURIComponent(selectedPackage.title)}&price=${totalAmount}&cycle=${finalCycleStr}&email=${encodeURIComponent(recipientEmail)}&clientInfo=${encodedInfo}`;
        } else if (selectedMethod === 'sepay') {
          const integrationType = payments.sepay_integration_type || 'vietqr';
          if (integrationType === 'gateway') {
            const bankName = payments.sepay_bank_name || payments.manual_bank_name || 'MBBank';
            const accountNo = payments.sepay_account_no || payments.manual_account_no || '0000000000';
            window.location.href = `https://pay.sepay.vn/checkout?acc=${encodeURIComponent(accountNo)}&bank=${encodeURIComponent(bankName)}&amount=${totalAmount}&des=${encodeURIComponent(txid)}`;
          } else {
            window.location.href = `/checkout/sepay?txid=${txid}&packageTitle=${encodeURIComponent(selectedPackage.title)}&price=${totalAmount}&cycle=${finalCycleStr}&email=${encodeURIComponent(recipientEmail)}&clientInfo=${encodedInfo}`;
          }
        } else {
          window.location.href = `/checkout/gateway?method=${selectedMethod}&txid=${txid}&packageTitle=${encodeURIComponent(selectedPackage.title)}&price=${totalAmount}&cycle=${finalCycleStr}&email=${encodeURIComponent(recipientEmail)}&clientInfo=${encodedInfo}`;
        }
      };
    }

    initOrderSummary();
  })();
</script>
