---
import MainLayout from '@layouts/MainLayout.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
---

<MainLayout title="Thanh toán thành công">
  <main class="max-w-md mx-auto px-4 py-8 pt-24 min-h-[80vh] flex flex-col justify-center relative overflow-hidden" id="success-main">
    
    <!-- Canvas for dynamic confetti -->
    <div id="confetti-container" class="absolute inset-0 pointer-events-none z-0"></div>

    <!-- Success Card -->
    <div class="glass-panel border border-emerald-500/20 rounded-3xl p-8 relative overflow-hidden bg-gradient-to-br from-zinc-950 via-zinc-950 to-emerald-950/10 shadow-[0_0_50px_rgba(16,185,129,0.08)] text-center space-y-6 z-10">
      
      <!-- Icon & Title -->
      <div class="flex flex-col items-center gap-3">
        <div class="w-16 h-16 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
          <span class="material-symbols-outlined text-4xl animate-bounce font-bold">check_circle</span>
        </div>
        <h2 class="text-2xl font-black text-white" id="success-title">Thanh toán thành công!</h2>
        <p class="text-xs text-emerald-400 font-semibold uppercase tracking-wider">Cảm ơn bạn đã lựa chọn dịch vụ</p>
      </div>

      <!-- Key Code Box (hidden by default, shown if keyCode is returned) -->
      <div id="bypass-key-container" class="hidden bg-violet-500/10 border border-violet-500/30 rounded-2xl p-5 text-center space-y-3 relative overflow-hidden animate-[pulse_3s_infinite] my-4">
        <div class="absolute -right-8 -top-8 w-16 h-16 bg-violet-500/10 rounded-full blur-xl pointer-events-none"></div>
        <p class="text-[10px] text-violet-400 font-black uppercase tracking-widest">MÃ KEY BYPASS ZALO CỦA BẠN</p>
        <div class="flex items-center justify-between gap-3 bg-zinc-950/60 border border-violet-500/20 rounded-xl px-4 py-3">
          <span id="bypass-key-val" class="font-mono text-lg font-black text-white tracking-[0.15em] select-all">-</span>
          <button id="btn-copy-key" class="p-2 bg-violet-600 hover:bg-violet-500 text-white rounded-lg active:scale-90 transition-all flex items-center justify-center cursor-pointer border-none shadow-[0_0_15px_rgba(124,58,237,0.3)]">
            <span class="material-symbols-outlined text-base font-bold" id="copy-icon">content_copy</span>
          </button>
        </div>
        <p class="text-[9px] text-zinc-400 leading-relaxed">
          Vui lòng sao chép mã Key và nhập vào phần xác thực ở cổng kiểm soát nhóm Zalo. Mã Key cũng đã được gửi về email của bạn.
        </p>
      </div>

      <!-- Transaction details box -->
      <div class="bg-white/5 border border-glass-stroke/40 rounded-2xl p-5 text-left text-xs space-y-3">
        <h3 class="font-bold text-zinc-400 uppercase tracking-wider text-[9px] border-b border-glass-stroke pb-2">CHI TIẾT THANH TOÁN</h3>
        
        <div class="flex justify-between">
          <span class="text-zinc-500">Mã giao dịch:</span>
          <span class="font-mono font-bold text-white" id="tx-id-val">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-500">Gói cước:</span>
          <span class="font-bold text-white text-right" id="tx-pkg-title">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-500">Kỳ hạn:</span>
          <span class="font-bold text-zinc-300" id="tx-cycle-val">-</span>
        </div>
        <div class="flex justify-between border-t border-glass-stroke/40 pt-2.5">
          <span class="text-zinc-400 font-bold">Tổng thanh toán:</span>
          <span class="text-base font-black text-primary" id="tx-price-val">-</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col gap-3 pt-4">
        <a id="view-invoice-link" href="#" class="w-full py-3.5 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold rounded-xl text-xs active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-sm">receipt_long</span>
          Xem hóa đơn & xuất PDF
        </a>
        <a href="/tphim" class="w-full py-3.5 bg-gradient-to-r from-primary to-secondary hover:brightness-110 text-slate-950 font-black rounded-xl text-xs active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-sm font-bold">home</span>
          Quay lại Trang Chủ
        </a>
      </div>

      <p class="text-[10px] text-zinc-500 leading-normal font-body-main">VIP của bạn đã hoạt động ngay lập tức. Hãy thử mở lại bất kỳ bộ phim nào để kiểm nghiệm chất lượng 4K UHD.</p>

    </div>

  </main>
</MainLayout>

<script is:inline>
  (function() {
    async function initSuccessPage() {
      const urlParams = new URLSearchParams(window.location.search);
      const txid = urlParams.get('txid') || urlParams.get('session_id') || 'TXA' + Math.random().toString(36).substring(2, 10).toUpperCase();
      let cycle = urlParams.get('cycle');
      let price = Number(urlParams.get('price'));
      let packageId = urlParams.get('packageId') || '';
      let packageTitle = urlParams.get('packageTitle') || '';
      let keyCode = null;

      try {
        const resLog = await fetch(`/api/user/payments?txid=${encodeURIComponent(txid)}`);
        if (resLog.ok) {
          const logData = await resLog.json();
          if (logData.data) {
            if (!packageTitle && logData.data.packageTitle) packageTitle = logData.data.packageTitle;
            if (!cycle && logData.data.cycle) cycle = logData.data.cycle;
            if (!price && logData.data.price) price = Number(logData.data.price);
            if (logData.data.keyCode) keyCode = logData.data.keyCode;
          }
        }
      } catch (e) {}

      cycle = cycle || 'monthly';
      price = price || 69000;
      if (!packageTitle) packageTitle = 'Gói Dịch Vụ VIP';

      function getCycleDays(c) {
        if (!c || c === 'monthly') return 30;
        if (c === 'annual') return 365;
        if (c === '6months') return 180;
        if (c === '3months') return 90;
        if (c.startsWith('custom_')) {
          const parts = c.split('_');
          const months = parseInt(parts[1]) || 1;
          return months * 30;
        }
        return 30;
      }

      function formatCycleLabel(c) {
        if (!c || c === 'monthly') return 'Hàng tháng';
        if (c === 'annual') return 'Hàng năm';
        if (c === '6months') return '6 tháng';
        if (c === '3months') return '3 tháng';
        if (c.startsWith('custom_')) {
          const parts = c.split('_');
          return `${parts[1] || 1} tháng`;
        }
        return 'Hàng tháng';
      }

      // Populate details
      document.getElementById('tx-id-val').textContent = txid;
      const pkgTitleEl = document.getElementById('tx-pkg-title');
      if (pkgTitleEl) pkgTitleEl.textContent = packageTitle;

      const titleEl = document.getElementById('success-title');
      if (titleEl) {
        if (packageTitle.toLowerCase().includes('bypass') || packageTitle.toLowerCase().includes('zalo') || packageTitle.toLowerCase().includes('key')) {
          titleEl.textContent = 'Nhận mã Key Bypass Zalo thành công!';
        } else {
          titleEl.textContent = 'Nâng cấp VIP thành công!';
        }
      }

      document.getElementById('tx-cycle-val').textContent = formatCycleLabel(cycle);
      document.getElementById('tx-price-val').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price);
      
      // Update view invoice link
      document.getElementById('view-invoice-link').setAttribute('href', `/invoices/${txid}`);

      // Sync with database
      try {
        const resMe = await fetch(`/api/auth/me?username=${encodeURIComponent(window.APP_USER ? window.APP_USER.username : 'anonymous')}`);
        let userEmail = '';
        if (resMe.ok) {
          const resMeData = await resMe.json();
          userEmail = resMeData.data?.email || '';
        }

        // 1. Post payment transaction log
        const postRes = await fetch('/api/user/payments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            txid: txid,
            username: window.APP_USER ? window.APP_USER.username : 'anonymous',
            email: userEmail,
            packageTitle: packageTitle,
            price: price,
            cycle: cycle,
            method: urlParams.get('method') || 'online',
            status: 'approved',
            receiptImg: ''
          })
        });
        if (postRes.ok) {
          const postData = await postRes.json();
          if (postData.data && postData.data.keyCode) {
            keyCode = postData.data.keyCode;
          }
        }

        // 2. Update user subscription package details
        const cycleDays = getCycleDays(cycle);
        const expiryDate = new Date(Date.now() + 3600 * 1000 * 24 * cycleDays).toISOString();
        const targetPackage = packageId || packageTitle || 'vip';
        
        await fetch('/api/admin/members', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'edit',
            username: window.APP_USER ? window.APP_USER.username : 'anonymous',
            package: targetPackage,
            joinDate: new Date().toISOString(),
            expiryDate: expiryDate,
            status: 'active'
          })
        });

        // 3. Keep in localStorage for client auth-bypassing layout checking
        localStorage.setItem('txa_user_subscription', JSON.stringify({
          username: window.APP_USER ? window.APP_USER.username : 'anonymous',
          tier: targetPackage,
          status: 'active',
          price: price,
          cycle: cycle,
          expiry: expiryDate,
          updatedAt: new Date().toISOString()
        }));

      } catch (err) {
        console.error('Error syncing payment results with server:', err);
      }

      // Display key code if available
      const keyContainer = document.getElementById('bypass-key-container');
      const keyValEl = document.getElementById('bypass-key-val');
      if (keyCode && keyContainer && keyValEl) {
        keyValEl.textContent = keyCode;
        keyContainer.classList.remove('hidden');

        // Copy key handler
        const btnCopy = document.getElementById('btn-copy-key');
        const copyIcon = document.getElementById('copy-icon');
        if (btnCopy) {
          btnCopy.onclick = async () => {
            try {
              await navigator.clipboard.writeText(keyCode);
              
              // Copy button feedback animation
              btnCopy.classList.add('bg-emerald-600', 'hover:bg-emerald-500', 'scale-105');
              btnCopy.classList.remove('bg-violet-600', 'hover:bg-violet-500');
              if (copyIcon) copyIcon.textContent = 'check';

              if (window.showGlobalToast) {
                window.showGlobalToast('Đã sao chép mã Key Bypass Zalo thành công!', 'success');
              } else if (window.showToast) {
                window.showToast('Đã sao chép mã Key Bypass Zalo thành công!', 'success');
              } else {
                alert('Đã sao chép mã Key: ' + keyCode);
              }

              setTimeout(() => {
                btnCopy.classList.remove('bg-emerald-600', 'hover:bg-emerald-500', 'scale-105');
                btnCopy.classList.add('bg-violet-600', 'hover:bg-violet-500');
                if (copyIcon) copyIcon.textContent = 'content_copy';
              }, 2000);
            } catch (err) {
              console.error('Lỗi sao chép:', err);
            }
          };
        }
      }

      // Spark Confetti
      spawnConfetti();
    }

    function spawnConfetti() {
      const container = document.getElementById('confetti-container');
      if (!container) return;
      
      container.innerHTML = '';
      
      const colors = ['#a78bfa', '#06b6d4', '#10b981', '#fbbf24', '#f43f5e'];
      
      for (let i = 0; i < 80; i++) {
        const particle = document.createElement('div');
        const color = colors[Math.floor(Math.random() * colors.length)];
        const size = Math.random() * 8 + 4;
        const left = Math.random() * 100;
        const delay = Math.random() * 3;
        const duration = Math.random() * 2 + 2;
        
        particle.style.cssText = `
          position: absolute;
          top: -20px;
          left: ${left}%;
          width: ${size}px;
          height: ${size}px;
          background-color: ${color};
          border-radius: 50%;
          opacity: ${Math.random()};
          transform: rotate(${Math.random() * 360}deg);
          animation: drop ${duration}s linear ${delay}s infinite;
        `;
        
        container.appendChild(particle);
      }
    }

    // Add CSS Keyframe animation dynamically
    const style = document.createElement('style');
    style.textContent = `
      @keyframes drop {
        0% {
          top: -20px;
          transform: translateY(0) rotate(0deg);
          opacity: 1;
        }
        100% {
          top: 100%;
          transform: translateY(100vh) rotate(720deg);
          opacity: 0;
        }
      }
    `;
    document.head.appendChild(style);

    initSuccessPage();
    document.addEventListener('astro:page-load', initSuccessPage);
  })();
</script>

