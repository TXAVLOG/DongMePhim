---
import MainLayout from '@layouts/MainLayout.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
---

<MainLayout title="Thanh toán thành công">
  <main class="max-w-md mx-auto px-4 py-8 pt-24 min-h-[80vh] flex flex-col justify-center relative overflow-hidden" id="success-main">
    
    <!-- Canvas for dynamic confetti -->
    <div id="confetti-container" class="absolute inset-0 pointer-events-none z-0"></div>

    <!-- Success Card -->
    <div class="glass-panel border border-emerald-500/20 rounded-3xl p-8 relative overflow-hidden bg-gradient-to-br from-zinc-950 via-zinc-950 to-emerald-950/10 shadow-[0_0_50px_rgba(16,185,129,0.08)] text-center space-y-6 z-10">
      
      <!-- Icon & Title -->
      <div class="flex flex-col items-center gap-3">
        <div class="w-16 h-16 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
          <span class="material-symbols-outlined text-4xl animate-bounce font-bold">check_circle</span>
        </div>
        <h2 class="text-2xl font-black text-white" id="success-title">Thanh toán thành công!</h2>
        <p class="text-xs text-emerald-400 font-semibold uppercase tracking-wider">Cảm ơn bạn đã lựa chọn dịch vụ</p>
      </div>

      <!-- Transaction details box -->
      <div class="bg-white/5 border border-glass-stroke/40 rounded-2xl p-5 text-left text-xs space-y-3">
        <h3 class="font-bold text-zinc-400 uppercase tracking-wider text-[9px] border-b border-glass-stroke pb-2">CHI TIẾT THANH TOÁN</h3>
        
        <div class="flex justify-between">
          <span class="text-zinc-500">Mã giao dịch:</span>
          <span class="font-mono font-bold text-white" id="tx-id-val">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-500">Gói cước:</span>
          <span class="font-bold text-white text-right" id="tx-pkg-title">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-500">Kỳ hạn:</span>
          <span class="font-bold text-zinc-300" id="tx-cycle-val">-</span>
        </div>
        <div class="flex justify-between border-t border-glass-stroke/40 pt-2.5">
          <span class="text-zinc-400 font-bold">Tổng thanh toán:</span>
          <span class="text-base font-black text-primary" id="tx-price-val">-</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col gap-3 pt-4">
        <a id="view-invoice-link" href="#" class="w-full py-3.5 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold rounded-xl text-xs active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-sm">receipt_long</span>
          Xem hóa đơn & xuất PDF
        </a>
        <a href="/tphim" class="w-full py-3.5 bg-gradient-to-r from-primary to-secondary hover:brightness-110 text-slate-950 font-black rounded-xl text-xs active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-sm font-bold">home</span>
          Quay lại Trang Chủ
        </a>
      </div>

      <p class="text-[10px] text-zinc-500 leading-normal font-body-main">VIP của bạn đã hoạt động ngay lập tức. Hãy thử mở lại bất kỳ bộ phim nào để kiểm nghiệm chất lượng 4K UHD.</p>

    </div>

  </main>
</MainLayout>

<script is:inline>
  (function() {
    async function initSuccessPage() {
      const urlParams = new URLSearchParams(window.location.search);
      const txid = urlParams.get('txid') || urlParams.get('session_id') || 'TXA' + Math.random().toString(36).substring(2, 10).toUpperCase();
      const cycle = urlParams.get('cycle') || 'monthly';
      const price = Number(urlParams.get('price')) || 69000;
      const packageId = urlParams.get('packageId') || '';
      let packageTitle = urlParams.get('packageTitle') || '';
      const username = (window.APP_USER ? window.APP_USER.username : null) || 'anonymous';

      if (!packageTitle) {
        try {
          const resLog = await fetch(`/api/user/payments?txid=${encodeURIComponent(txid)}`);
          if (resLog.ok) {
            const logData = await resLog.json();
            if (logData.data && logData.data.packageTitle) {
              packageTitle = logData.data.packageTitle;
            }
          }
        } catch (e) {}
      }
      if (!packageTitle) packageTitle = 'Gói Dịch Vụ VIP';

      // Populate details
      document.getElementById('tx-id-val').textContent = txid;
      const pkgTitleEl = document.getElementById('tx-pkg-title');
      if (pkgTitleEl) pkgTitleEl.textContent = packageTitle;

      const titleEl = document.getElementById('success-title');
      if (titleEl) {
        if (packageTitle.toLowerCase().includes('bypass') || packageTitle.toLowerCase().includes('zalo') || packageTitle.toLowerCase().includes('key')) {
          titleEl.textContent = 'Nhận mã Key Bypass Zalo thành công!';
        } else {
          titleEl.textContent = 'Nâng cấp VIP thành công!';
        }
      }

      document.getElementById('tx-cycle-val').textContent = cycle === 'annual' ? 'Hàng năm' : (cycle === '6months' ? '6 tháng' : (cycle === '3months' ? '3 tháng' : 'Hàng tháng'));
      document.getElementById('tx-price-val').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price);
      
      // Update view invoice link
      document.getElementById('view-invoice-link').setAttribute('href', `/invoices/${txid}`);

      // Sync with database
      try {
        const resMe = await fetch(`/api/auth/me?username=${encodeURIComponent(username)}`);
        let userEmail = '';
        if (resMe.ok) {
          const resMeData = await resMe.json();
          userEmail = resMeData.data?.email || '';
        }

        // 1. Post payment transaction log
        await fetch('/api/user/payments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            txid: txid,
            username: username,
            email: userEmail,
            packageTitle: packageTitle,
            price: price,
            cycle: cycle,
            method: urlParams.get('method') || 'online',
            status: 'approved',
            receiptImg: ''
          })
        });

        // 2. Update user subscription package details (only if packageId is provided)
        const cycleDays = cycle === 'annual' ? 365 : 30;
        const expiryDate = new Date(Date.now() + 3600 * 1000 * 24 * cycleDays).toISOString();
        if (packageId) {
          await fetch('/api/admin/members', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'edit',
              username: username,
              package: packageId,
              joinDate: new Date().toISOString(),
              expiryDate: expiryDate,
              status: 'active'
            })
          });
        }

        // 3. Keep in localStorage for client auth-bypassing layout checking
        localStorage.setItem('txa_user_subscription', JSON.stringify({
          username: username,
            tier: packageTitle || packageId,
          status: 'active',
          price: price,
          cycle: cycle,
          expiry: expiryDate,
          updatedAt: new Date().toISOString()
        }));

      } catch (err) {
        console.error('Error syncing payment results with server:', err);
      }

      // Spark Confetti
      spawnConfetti();
    }

    function spawnConfetti() {
      const container = document.getElementById('confetti-container');
      if (!container) return;
      
      container.innerHTML = '';
      
      const colors = ['#a78bfa', '#06b6d4', '#10b981', '#fbbf24', '#f43f5e'];
      
      for (let i = 0; i < 80; i++) {
        const particle = document.createElement('div');
        const color = colors[Math.floor(Math.random() * colors.length)];
        const size = Math.random() * 8 + 4;
        const left = Math.random() * 100;
        const delay = Math.random() * 3;
        const duration = Math.random() * 2 + 2;
        
        particle.style.cssText = `
          position: absolute;
          top: -20px;
          left: ${left}%;
          width: ${size}px;
          height: ${size}px;
          background-color: ${color};
          border-radius: 50%;
          opacity: ${Math.random()};
          transform: rotate(${Math.random() * 360}deg);
          animation: drop ${duration}s linear ${delay}s infinite;
        `;
        
        container.appendChild(particle);
      }
    }

    // Add CSS Keyframe animation dynamically
    const style = document.createElement('style');
    style.textContent = `
      @keyframes drop {
        0% {
          top: -20px;
          transform: translateY(0) rotate(0deg);
          opacity: 1;
        }
        100% {
          top: 100%;
          transform: translateY(100vh) rotate(720deg);
          opacity: 0;
        }
      }
    `;
    document.head.appendChild(style);

    initSuccessPage();
    document.addEventListener('astro:page-load', initSuccessPage);
  })();
</script>

