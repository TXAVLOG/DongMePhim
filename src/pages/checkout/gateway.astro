---
import MainLayout from '@layouts/MainLayout.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
---

<MainLayout title="Cổng thanh toán Sandbox">
  <main class="max-w-md mx-auto px-4 py-8 pt-24 min-h-[80vh] flex flex-col justify-center">
    
    <!-- Sandbox Brand Card -->
    <div class="glass-panel border border-yellow-500/20 rounded-3xl p-8 relative overflow-hidden bg-gradient-to-br from-zinc-950 via-zinc-950 to-yellow-950/10 shadow-[0_0_50px_rgba(234,179,8,0.05)] text-center space-y-6">
      
      <!-- Warning header -->
      <div class="flex flex-col items-center gap-2">
        <span class="material-symbols-outlined text-yellow-500 text-5xl animate-bounce">sandbox</span>
        <h2 class="text-xl font-black text-white">Payment Sandbox Gateway</h2>
        <p class="text-xs text-yellow-500 font-bold uppercase tracking-wider">Môi trường giả lập thử nghiệm</p>
      </div>

      <!-- Transaction details box -->
      <div class="bg-white/5 border border-glass-stroke/40 rounded-2xl p-5 text-left text-xs space-y-3.5">
        <h3 class="font-bold text-zinc-400 uppercase tracking-wider text-[9px] border-b border-glass-stroke pb-2">THÔNG TIN GIAO DỊCH</h3>
        
        <div class="flex justify-between">
          <span class="text-zinc-500">Sản phẩm:</span>
          <span class="font-bold text-white" id="tx-product">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-500">Chu kỳ:</span>
          <span class="font-bold text-white" id="tx-cycle">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-500">Cổng thanh toán:</span>
          <span class="font-mono font-bold text-primary" id="tx-method">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-500">Tài khoản mua:</span>
          <span class="font-bold text-white" id="tx-user">-</span>
        </div>
        <div class="flex justify-between border-t border-glass-stroke/40 pt-3">
          <span class="text-zinc-400 font-bold">Số tiền:</span>
          <span class="text-lg font-black text-primary" id="tx-price">-</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col gap-3 pt-4">
        <button id="sim-success-btn" class="w-full py-4 bg-gradient-to-r from-emerald-500 to-teal-400 hover:brightness-110 text-slate-950 font-black rounded-xl text-xs active:scale-95 transition-all cursor-pointer shadow-lg shadow-emerald-500/20">
          Xác nhận thanh toán (Simulate Success)
        </button>
        <button id="sim-failed-btn" class="w-full py-4 border border-rose-500/30 hover:bg-rose-500/10 text-rose-400 font-bold rounded-xl text-xs active:scale-95 transition-all cursor-pointer">
          Hủy bỏ giao dịch (Simulate Failed)
        </button>
      </div>

      <p class="text-[10px] text-zinc-500 leading-normal font-body-main">Giao dịch trong môi trường này hoàn toàn miễn phí và chỉ ghi nhận thay đổi trạng thái tài khoản trên cơ sở dữ liệu trình duyệt cục bộ.</p>

    </div>

  </main>
</MainLayout>

<script is:inline>
  (function() {
    function initSandboxGateway() {
      const urlParams = new URLSearchParams(window.location.search);
      const method = urlParams.get('method') || 'stripe';
      const cycle = urlParams.get('cycle') || 'monthly';
      const price = Number(urlParams.get('price')) || 69000;
      const packageId = urlParams.get('packageId') || '';
      const packageTitle = urlParams.get('packageTitle') || '';
      const username = (window.APP_USER ? window.APP_USER.username : null) || 'anonymous';

      // Populate details
      document.getElementById('tx-product').textContent = packageTitle;
      document.getElementById('tx-cycle').textContent = cycle === 'annual' ? 'Hàng năm' : 'Hàng tháng';
      document.getElementById('tx-method').textContent = method.toUpperCase();
      document.getElementById('tx-user').textContent = username;
      document.getElementById('tx-price').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price);

      // Handle Success
      const successBtn = document.getElementById('sim-success-btn');
      successBtn.onclick = async function() {
        const txid = 'TXA' + Math.random().toString(36).substring(2, 10).toUpperCase();

        try {
          const resMe = await fetch(`/api/auth/me?username=${encodeURIComponent(username)}`);
          let userEmail = '';
          if (resMe.ok) {
            const resMeData = await resMe.json();
            userEmail = resMeData.data?.email || '';
          }

          // 1. Add to payment logs in database
          await fetch('/api/user/payments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              txid: txid,
              username: username,
              email: userEmail,
              packageTitle: packageTitle,
              price: price,
              cycle: cycle,
              method: method,
              status: 'approved',
              receiptImg: ''
            })
          });

          // 2. Set expiry
          const cycleDays = cycle === 'annual' ? 365 : 30;
          const expiryDate = new Date(Date.now() + 3600 * 1000 * 24 * cycleDays).toISOString();

          // 3. Update package in database
          await fetch('/api/admin/members', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'edit',
              username: username,
              package: packageId,
              joinDate: new Date().toISOString(),
              expiryDate: expiryDate,
              status: 'active'
            })
          });

          // 4. Update current user subscription key in localStorage
          localStorage.setItem('txa_user_subscription', JSON.stringify({
            username: username,
            tier: packageTitle,
            status: 'active',
            price: price,
            cycle: cycle,
            expiry: expiryDate,
            updatedAt: new Date().toISOString()
          }));

        } catch (e) {
          console.error('Error simulating sandbox checkout success:', e);
        }

        // Redirect to success page
        window.location.href = `/checkout/success?method=${method}&cycle=${cycle}&price=${price}&txid=${txid}&packageId=${encodeURIComponent(packageId)}&packageTitle=${encodeURIComponent(packageTitle)}`;
      };

      // Handle Failed
      const failedBtn = document.getElementById('sim-failed-btn');
      failedBtn.onclick = function() {
        window.location.href = `/checkout/failed?method=${method}&user=${username}`;
      };
    }

    initSandboxGateway();
    document.addEventListener('astro:page-load', initSandboxGateway);
  })();
</script>

