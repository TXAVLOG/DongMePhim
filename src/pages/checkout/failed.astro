---
import MainLayout from '@layouts/MainLayout.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
---

<MainLayout title="Thanh toán thất bại">
  <main class="max-w-md mx-auto px-4 py-8 pt-24 min-h-[80vh] flex flex-col justify-center">
    
    <!-- Failed Card -->
    <div class="glass-panel border border-rose-500/20 rounded-3xl p-8 relative overflow-hidden bg-gradient-to-br from-zinc-950 via-zinc-950 to-rose-950/10 shadow-[0_0_50px_rgba(244,63,94,0.08)] text-center space-y-6">
      
      <!-- Icon & Title -->
      <div class="flex flex-col items-center gap-3">
        <div class="w-16 h-16 rounded-full bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-500">
          <span class="material-symbols-outlined text-4xl animate-pulse font-bold">cancel</span>
        </div>
        <h2 class="text-2xl font-black text-white">Thanh toán thất bại!</h2>
        <p class="text-xs text-rose-400 font-semibold uppercase tracking-wider">Giao dịch đã bị từ chối hoặc hủy bỏ</p>
      </div>

      <!-- Detail Box -->
      <div class="bg-white/5 border border-glass-stroke/40 rounded-2xl p-5 text-left text-xs space-y-3.5">
        <h3 class="font-bold text-zinc-400 uppercase tracking-wider text-[9px] border-b border-glass-stroke pb-2">CHI TIẾT LỖI</h3>
        
        <div class="flex justify-between">
          <span class="text-zinc-500">Cổng thanh toán:</span>
          <span class="font-mono font-bold text-white" id="failed-method-val">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-500">Lý do thất bại:</span>
          <span class="font-bold text-rose-400">Huỷ bỏ bởi người dùng / Thử nghiệm Sandbox thất bại</span>
        </div>
        <div class="flex justify-between border-t border-glass-stroke/40 pt-3">
          <span class="text-zinc-500">Người dùng:</span>
          <span class="font-bold text-zinc-300" id="failed-user-val">-</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col gap-3 pt-4">
        <a href="/nang-cap" class="w-full py-3.5 bg-gradient-to-r from-primary to-secondary hover:brightness-110 text-slate-950 font-black rounded-xl text-xs active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-sm font-bold">payments</span>
          Thử thanh toán lại
        </a>
        <a href="/tphim" class="w-full py-3.5 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold rounded-xl text-xs active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-sm">home</span>
          Quay lại Trang Chủ
        </a>
      </div>

      <p class="text-[10px] text-zinc-500 leading-normal font-body-main">Nếu tài khoản ngân hàng của bạn đã bị trừ tiền mà tài khoản VIP vẫn chưa được kích hoạt, vui lòng liên hệ bộ phận hỗ trợ khách hàng để được đối soát nhanh.</p>

    </div>

  </main>
</MainLayout>

<script is:inline>
  (function() {
    function initFailedPage() {
      const urlParams = new URLSearchParams(window.location.search);
      const method = urlParams.get('method') || 'online';
      const username = urlParams.get('user') || (window.APP_USER ? window.APP_USER.username : null) || 'anonymous';

      document.getElementById('failed-method-val').textContent = method.toUpperCase();
      document.getElementById('failed-user-val').textContent = username;
    }

    initFailedPage();
    document.addEventListener('astro:page-load', initFailedPage);
  })();
</script>

