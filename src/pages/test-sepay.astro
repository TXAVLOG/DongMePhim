---
import MainLayout from '@layouts/MainLayout.astro';
---

<MainLayout title="Kiểm tra Cổng SePay PG">
  <main class="max-w-md mx-auto px-4 py-16 pt-32 text-center space-y-6">
    <div class="glass-panel p-8 rounded-3xl border border-glass-stroke space-y-6 bg-zinc-950/80">
      <div class="w-16 h-16 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mx-auto">
        <span class="material-symbols-outlined text-3xl">payments</span>
      </div>
      <div>
        <h1 class="text-xl font-black text-white uppercase tracking-wider">Test Cổng SePay PG</h1>
        <p class="text-xs text-zinc-400 mt-2">Bấm nút bên dưới để thử nghiệm gửi đơn hàng test (10.000đ) sang cổng pay.sepay.vn với chữ ký vừa cập nhật.</p>
      </div>

      <button id="btn-test-sepay" class="w-full py-4 bg-primary text-slate-950 font-black text-xs uppercase tracking-widest rounded-xl hover:brightness-110 active:scale-95 transition-all cursor-pointer border-none shadow-lg shadow-primary/20">
        Gửi giao dịch test SePay
      </button>
    </div>
  </main>
</MainLayout>

<script is:inline>
  document.getElementById('btn-test-sepay')?.addEventListener('click', async function() {
    const btn = this;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-base">autorenew</span> <span>Đang khởi tạo...</span>';
    try {
      const txid = 'TXATEST' + Math.random().toString(36).substring(2, 8).toUpperCase();
      const res = await fetch('/api/payment/sepay-init', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ txid: txid, totalAmount: 10000, packageTitle: 'Test VIP' })
      });
      const result = await res.json();
      if (res.ok && result.data) {
        const { checkoutUrl, fields } = result.data;
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = checkoutUrl;
        for (const [key, value] of Object.entries(fields)) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = key;
          input.value = String(value);
          form.appendChild(input);
        }
        document.body.appendChild(form);
        form.submit();
      } else {
        alert('Lỗi: ' + (result.message || 'Không thể tạo đơn test'));
        btn.disabled = false;
        btn.innerHTML = '<span>Gửi giao dịch test SePay</span>';
      }
    } catch(e) {
      alert('Lỗi kết nối API');
      btn.disabled = false;
      btn.innerHTML = '<span>Gửi giao dịch test SePay</span>';
    }
  });
</script>
