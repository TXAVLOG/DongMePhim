---
import MainLayout from '@layouts/MainLayout.astro';
import UpgradeRequired from '@components/ui/UpgradeRequired.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
---

<MainLayout title={`Xem Chung Phim | ${settings.general.site_name}`}>
  <main class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 pb-20 min-h-[80vh] flex flex-col justify-center">
    
    <!-- Loading indicator -->
    <div id="xem-chung-loading" class="flex flex-col items-center justify-center p-20 text-center">
      <div class="w-12 h-12 border-4 border-primary/20 border-t-primary rounded-full animate-spin mb-4"></div>
      <p class="text-sm text-zinc-400 font-body-main">Đang kiểm tra quyền truy cập...</p>
    </div>

    <!-- Guest view (Requires login) -->
    <div id="xem-chung-guest" class="hidden flex-col items-center justify-center text-center shadow-2xl glass-panel border border-glass-stroke rounded-3xl p-12 max-w-xl mx-auto">
      <div class="w-20 h-20 rounded-full bg-primary/10 flex items-center justify-center mb-6 border border-primary/20 shadow-[0_0_30px_rgba(124,58,237,0.15)]">
        <span class="material-symbols-outlined text-primary text-4xl">lock</span>
      </div>
      <h2 class="text-2xl text-white font-title-md mb-2">Yêu cầu đăng nhập</h2>
      <p class="text-zinc-400 max-w-md mx-auto mb-8 font-body-main">Vui lòng đăng nhập vào tài khoản để tham gia phòng xem chung với bạn bè.</p>
      <button onclick="window.dispatchEvent(new Event('open-login-modal'))" class="px-8 py-3.5 rounded-full text-white font-bold bg-gradient-to-br from-primary-container to-secondary-container shadow-lg hover:brightness-110 active:scale-95 transition-all cursor-pointer">
        Đăng nhập ngay
      </button>
    </div>

    <!-- Blocked view (Requires upgrade) -->
    <div id="xem-chung-blocked" class="hidden">
      <!-- Will render UpgradeRequired widget dynamically -->
      <div id="upgrade-widget-wrapper"></div>
    </div>

    <!-- Authorized view (Features in development) -->
    <div id="xem-chung-allowed" class="hidden flex-col items-center justify-center text-center shadow-2xl glass-panel border border-glass-stroke rounded-3xl p-12 max-w-2xl mx-auto relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-secondary/5 via-transparent to-primary/5 pointer-events-none"></div>
      
      <div class="w-20 h-20 rounded-full bg-secondary/10 border border-secondary/20 flex items-center justify-center mb-6 shadow-[0_0_40px_rgba(236,72,153,0.2)] animate-pulse">
        <span class="material-symbols-outlined text-secondary text-4xl" style="font-variation-settings: 'FILL' 1;">groups</span>
      </div>
      
      <h2 class="text-3xl font-black text-white tracking-tight mb-3">Tính năng Xem Chung Phim (Watch Together)</h2>
      <p class="text-xs text-zinc-500 font-bold uppercase tracking-wider font-label-caps mb-6 px-3 py-1 bg-secondary/10 border border-secondary/20 rounded-full inline-block">Đang phát triển</p>
      
      <p class="text-sm text-zinc-400 max-w-lg mx-auto mb-8 font-body-main leading-relaxed">
        Phòng chiếu phim trực tuyến kết nối bạn bè từ xa. Bạn sẽ có thể trò chuyện, đàm thoại thoại, và cùng đồng bộ trình phát phim thời gian thực với những người thân yêu.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 items-center justify-center w-full">
        <a href="/" class="w-full sm:w-auto px-8 py-3 bg-white/5 border border-glass-stroke text-white font-bold rounded-xl text-xs hover:bg-white/10 active:scale-95 transition-all cursor-pointer">
          Quay lại trang chủ
        </a>
        <button onclick="window.showGlobalToast ? window.showGlobalToast('Hệ thống đang hoàn thiện tính năng!', 'info') : alert('Đang hoàn thiện tính năng')" class="w-full sm:w-auto px-8 py-3 bg-secondary text-slate-950 font-black rounded-xl text-xs hover:brightness-110 active:scale-95 transition-all cursor-pointer">
          Tạo phòng ngay
        </button>
      </div>
    </div>

  </main>
</MainLayout>

<!-- Client-side access gating logic -->
<script is:inline>
  (function() {
    async function checkAccess() {
      const loadingEl = document.getElementById('xem-chung-loading');
      const guestEl = document.getElementById('xem-chung-guest');
      const blockedEl = document.getElementById('xem-chung-blocked');
      const allowedEl = document.getElementById('xem-chung-allowed');
      const wrapperEl = document.getElementById('upgrade-widget-wrapper');

      const isLoggedIn = document.cookie.includes('txa_gate_passed');
      
      if (!isLoggedIn) {
        loadingEl.style.display = 'none';
        guestEl.style.display = 'flex';
        blockedEl.style.display = 'none';
        allowedEl.style.display = 'none';
        return;
      }

      try {
        // Fetch settings dynamically to get current package definitions or use cached global settings
        let packages = [];
        if (window.TXA_SITE_SETTINGS) {
          packages = window.TXA_SITE_SETTINGS.packages || [];
        } else {
          const settingsRes = await fetch('/api/admin/settings');
          if (!settingsRes.ok) throw new Error();
          const settingsData = await settingsRes.json();
          packages = settingsData?.data?.packages || [];
        }

        // Fetch current user details
        const username = (window.APP_USER ? window.APP_USER.username : null) || '';
        const userRes = await fetch(`/api/auth/me?username=${encodeURIComponent(username)}`);
        if (!userRes.ok) throw new Error();
        const userData = await userRes.json();
        const user = userData?.data || {};

        const userPackageName = user.package || 'free';
        
        // Find matching package rules
        const userPkg = packages.find((p: any) => p.id === userPackageName) || packages.find((p: any) => p.title === userPackageName);
        const userPkgId = userPkg ? userPkg.id : 'free';
        const pkgDef = userPkg || packages.find(p => p.id === 'free') || {
          permissions: { watch_together: false }
        };

        loadingEl.style.display = 'none';
        guestEl.style.display = 'none';

        if (pkgDef.permissions && pkgDef.permissions.watch_together) {
          // Allowed!
          allowedEl.style.display = 'flex';
          blockedEl.style.display = 'none';
        } else {
          // Blocked! Render UpgradeRequired template HTML dynamically
          blockedEl.style.display = 'block';
          allowedEl.style.display = 'none';
          
          if (wrapperEl) {
            wrapperEl.innerHTML = `
              <div class="flex flex-col items-center justify-center p-8 md:p-12 text-center glass-panel rounded-3xl border border-glass-stroke max-w-xl mx-auto my-8 relative overflow-hidden shadow-[0_0_50px_rgba(139,92,246,0.1)]">
                <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none"></div>
                <div class="relative w-20 h-20 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center mb-6 shadow-[0_0_30px_rgba(124,58,237,0.2)] animate-pulse">
                  <span class="material-symbols-outlined text-primary text-4xl" style="font-variation-settings: 'FILL' 1;">lock</span>
                </div>
                <h3 class="text-2xl font-black text-white tracking-tight mb-3">Tính năng Xem Chung</h3>
                <p class="text-sm text-zinc-400 font-body-main leading-relaxed max-w-md mb-6">
                  Tính năng xem phim chung thời gian thực với bạn bè chỉ mở khóa cho các gói cước VIP nâng cao. Vui lòng nâng cấp gói để trải nghiệm dịch vụ.
                </p>
                <div class="mb-8 px-4 py-2 bg-white/5 border border-glass-stroke/50 rounded-xl inline-block">
                  <p class="text-xs text-zinc-400 font-body-main">
                    Gói hiện tại của bạn: <span class="package-style-${userPkgId} not-italic font-bold">${userPackageName}</span>
                  </p>
                </div>
                <a href="/nang-cap" class="px-8 py-3.5 bg-gradient-to-r from-primary to-secondary text-slate-950 font-black rounded-xl text-xs hover:brightness-110 active:scale-95 transition-all shadow-lg shadow-primary/20 flex items-center gap-2 cursor-pointer border-none uppercase tracking-wider">
                  <span class="material-symbols-outlined text-sm font-black">workspace_premium</span>
                  Nâng cấp gói ngay
                </a>
              </div>
            `;
          }
        }
      } catch (err) {
        console.error('Error during access check:', err);
        // Fallback: show guest/standard block
        loadingEl.style.display = 'none';
        guestEl.style.display = 'flex';
      }
    }

    checkAccess();
    document.addEventListener('astro:page-load', checkAccess);
  })();
</script>

