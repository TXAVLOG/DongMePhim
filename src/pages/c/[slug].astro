---
import MainLayout from '@layouts/MainLayout.astro';
import Card from '@components/ui/Card.astro';
import { MovieService } from '@services/MovieService';
import { HOMEPAGE_CATEGORIES, getHomepageCategories } from '@data/categories';
import NotFound from '@components/ui/NotFound.astro';
import { TxaMovieRanker } from '../../backend/utils/txaMovieRanker';

const { slug } = Astro.params;

// Find the category definition
const category = HOMEPAGE_CATEGORIES.find(c => c.slug === slug);

let movies: any[] = [];
if (category) {
  const homepageMappings = await getHomepageCategories();
  const assignedSlugs = homepageMappings[category.slug] || [];
  
  if (category.slug === 'top-anime-he') {
    const animeAll = await MovieService.getMovies({ limit: 300, sortBy: 'updatedAt' });
    const configuredMovies = assignedSlugs
      .map(slug => animeAll.find((m: any) => m.slug === slug))
      .filter(Boolean);
      
    const isAnimeMovie = (m: any) => {
      if (!m) return false;
      const title = (m.title || '').toLowerCase();
      const desc = (m.description || '').toLowerCase();
      const country = (m.country || '').toLowerCase();
      const genres = Array.isArray(m.genres) ? m.genres.map((g: any) => g.toLowerCase()) : [];
      
      const isAnimation = m.type === 'hoathinh' || genres.includes('hoạt hình') || genres.includes('anime');
      if (!isAnimation) return false;
      
      const hasAnimeKeywords = genres.includes('anime') || 
                               country.includes('nhật bản') || 
                               country.includes('japan') || 
                               title.includes('anime') || 
                               desc.includes('anime');
                               
      return hasAnimeKeywords;
    };

    const otherAnime = animeAll.filter((m: any) => isAnimeMovie(m) && !assignedSlugs.includes(m.slug));
    const sortedOtherAnime = TxaMovieRanker.sortMovies(otherAnime);
    movies = [...configuredMovies, ...sortedOtherAnime].slice(0, 15);
  } else if (category.slug === 'top-10-phim-le') {
    const leAll = await MovieService.getMovies({ limit: 300, sortBy: 'updatedAt' });
    const configuredMovies = assignedSlugs
      .map(slug => leAll.find((m: any) => m.slug === slug))
      .filter(Boolean);
    const otherMovies = leAll.filter((m: any) => m.type === 'movie' && !assignedSlugs.includes(m.slug));
    const sortedOther = TxaMovieRanker.sortMovies(otherMovies);
    movies = [...configuredMovies, ...sortedOther].slice(0, 10);
  } else if (category.slug === 'top-10-phim-bo') {
    const boAll = await MovieService.getMovies({ limit: 300, sortBy: 'updatedAt' });
    const configuredMovies = assignedSlugs
      .map(slug => boAll.find((m: any) => m.slug === slug))
      .filter(Boolean);
    const otherMovies = boAll.filter((m: any) => m.type === 'series' && !assignedSlugs.includes(m.slug));
    const sortedOther = TxaMovieRanker.sortMovies(otherMovies);
    movies = [...configuredMovies, ...sortedOther].slice(0, 10);
  } else if (category.slug === 'phim-dien-anh-moi') {
    // Tự động phân loại phim điện ảnh mới nhất (lấy từ top 100 phim mới nhất để lọc)
    const latestMovies = await MovieService.getMovies({ limit: 100, sortBy: 'updatedAt' });
    movies = latestMovies
      .filter((m: any) => m.type === 'movie')
      .sort((a: any, b: any) => {
        const aIsChieuRap = a.genres && a.genres.some((g: string) => g.toLowerCase().includes('chiếu rạp'));
        const bIsChieuRap = b.genres && b.genres.some((g: string) => g.toLowerCase().includes('chiếu rạp'));
        if (aIsChieuRap && !bIsChieuRap) return -1;
        if (!aIsChieuRap && bIsChieuRap) return 1;
        
        const yearDiff = (b.releaseYear || 0) - (a.releaseYear || 0);
        if (yearDiff !== 0) return yearDiff;
        
        return new Date(b.updatedAt || 0).getTime() - new Date(a.updatedAt || 0).getTime();
      });
  } else if (category.slug === 'dahk-o-cho-nay-nay') {
    const allMovies = await MovieService.getMovies({ limit: 200, sortBy: 'updatedAt' });
    movies = allMovies.filter((m: any) => 
      m.type === 'movie' && 
      (m.category === 'Hồng Kông' || m.category === 'TVB' || (Array.isArray(m.genres) && (m.genres.includes('Hồng Kông') || m.genres.includes('TVB'))))
    );
  } else if (category.slug === 'toi-so-con-nguoi-em-roi-do') {
    const allMovies = await MovieService.getMovies({ limit: 200, sortBy: 'updatedAt' });
    movies = allMovies.filter((m: any) => 
      Array.isArray(m.genres) && m.genres.some((g: string) => {
        const lower = (g || '').toLowerCase();
        return lower.includes('kinh dị') || lower.includes('ma') || lower.includes('thriller') || lower.includes('horror');
      })
    );
  } else if (category.slug === 'phim-thai-new') {
    const allMovies = await MovieService.getMovies({ limit: 200, sortBy: 'updatedAt' });
    movies = allMovies.filter((m: any) => 
      m.category === 'Thái Lan' || (Array.isArray(m.genres) && m.genres.some((g: string) => (g || '').toLowerCase().includes('thái')))
    );
  } else if (category.slug === 'chau-tinh-tri-xem-la-cuoi') {
    const allMovies = await MovieService.getMovies({ limit: 200, sortBy: 'updatedAt' });
    movies = allMovies.filter((m: any) => 
      Array.isArray(m.actors) && m.actors.some((a: any) => {
        const lower = (typeof a === 'string' ? a : (a && a.name ? a.name : '')).toLowerCase();
        return lower.includes('châu tinh trì') || lower.includes('stephen chow');
      })
    );
  } else if (category.slug === 'viet-nam') {
    const allVietNam = await MovieService.getMovies({ category: 'Việt Nam' });
    const configuredMovies = assignedSlugs
      .map(slug => allVietNam.find((m: any) => m.slug === slug))
      .filter(Boolean);
    const otherMovies = allVietNam.filter((m: any) => !assignedSlugs.includes(m.slug));
    const sortedOther = TxaMovieRanker.sortMovies(otherMovies);
    movies = [...configuredMovies, ...sortedOther];
  } else {
    // Chỉ truy vấn các slugs được chỉ định
    const assignedMovies = assignedSlugs.length > 0 ? await MovieService.getMovies({ slugs: assignedSlugs }) : [];
    movies = [...assignedMovies].sort((a, b) => assignedSlugs.indexOf(a.slug) - assignedSlugs.indexOf(b.slug));

    // Fallback nếu không có phim gán thủ công
    if (movies.length === 0) {
      if (category.slug === 'huyen-thoai-co-tich') {
        const allMovies = await MovieService.getMovies({ limit: 200, sortBy: 'updatedAt' });
        movies = allMovies.filter((m: any) =>
          Array.isArray(m.genres) && m.genres.some((g: string) => {
            const lower = (g || '').toLowerCase();
            return lower.includes('thần thoại') || lower.includes('cổ tích') || lower.includes('thần tiên') || lower.includes('mythology') || lower.includes('fantasy');
          })
        );
      } else if (category.slug === 'thanh-xuan-hoc-duong') {
        const allMovies = await MovieService.getMovies({ limit: 200, sortBy: 'updatedAt' });
        movies = allMovies.filter((m: any) =>
          Array.isArray(m.genres) && m.genres.some((g: string) => {
            const lower = (g || '').toLowerCase();
            return lower.includes('học đường') || lower.includes('tuổi trẻ') || lower.includes('học sinh') || lower.includes('school') || lower.includes('tuổi thanh xuân');
          })
        );
      }
    }
  }
}
---

{category ? (
  <MainLayout 
    title={category.title}
    description={category.description}
    image={movies[0]?.posterUrl}
  >
    <main class="max-w-container-max mx-auto px-gutter pt-24 md:pt-32 pb-16 space-y-8 min-h-[70vh]">
      <!-- Header -->
      <div class="space-y-2 border-b border-glass-stroke/50 pb-6 text-left">
        <div class="flex items-center gap-2 text-zinc-500 text-xs">
          <a href="/tphim" class="hover:text-primary transition-colors">Trang chủ</a>
          <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          <span class="text-zinc-300 font-bold">{category.title}</span>
        </div>
        <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight font-outfit uppercase">
          {category.title}
        </h1>
        {category.description && (
          <p class="text-xs md:text-sm text-on-surface-variant font-medium font-sans">
            {category.description}
          </p>
        )}
      </div>

      <!-- Grid list -->
      {movies.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-gutter">
          {movies.map(movie => (
            <Card
              title={movie.title}
              slug={movie.slug}
              poster={movie.posterUrl}
              year={movie.releaseYear}
              quality={movie.quality}
              status={movie.status === 'completed' ? 'Hoàn thành' : 'Đang chiếu'}
              aspect="aspect-[2/3]"
              movie={movie}
            />
          ))}
        </div>
      ) : (
        <div class="py-16 text-center space-y-4 bg-white/[0.02] border border-dashed border-white/5 rounded-3xl">
          <span class="material-symbols-outlined text-4xl text-zinc-600 animate-pulse">movie</span>
          <p class="text-xs text-zinc-500 font-outfit">Danh mục này hiện tại chưa có phim nào.</p>
        </div>
      )}
    </main>
  </MainLayout>
) : (
  <MainLayout title="Không tìm thấy danh mục">
    <NotFound />
  </MainLayout>
)}
