---
import MainLayout from '@layouts/MainLayout.astro';
import { MovieService } from '@services/MovieService';
import { slugify } from '../../backend/utils/categoryHelper';
import { supabase } from '@lib/supabase';

const standardCountries = ["Trung Quốc", "Hàn Quốc", "Nhật Bản", "Âu Mỹ", "Hồng Kông", "Đài Loan", "Thái Lan", "Việt Nam", "TVB", "Ấn Độ"];

let uniqueCountries = standardCountries;
let countryCounts: Record<string, number> = {};

const isSupabase = import.meta.env.PUBLIC_DATA_PROVIDER === 'supabase';
if (isSupabase) {
  try {
    const { data: dbCountries } = await supabase.from('view_country_counts').select('*');
    if (dbCountries) {
      const dbCountryNames = dbCountries.map(c => c.country);
      uniqueCountries = [...new Set([...standardCountries, ...dbCountryNames])];
      dbCountries.forEach(c => {
        countryCounts[c.country] = c.count;
      });
    }
  } catch (e) {
    console.error("Lỗi khi tải quốc gia từ Supabase view:", e);
  }
} else {
  const movies = await MovieService.getMovies();
  const dynamicCountries = movies.map((m: any) => m.category).filter(Boolean);
  uniqueCountries = [...new Set([...standardCountries, ...dynamicCountries])] as string[];
  uniqueCountries.forEach(country => {
    const slug = slugify(country);
    countryCounts[country] = movies.filter((m: any) => m.category === country || (slugify(m.category || '') === slug) || (Array.isArray(m.genres) && m.genres.some((g: any) => slugify(g) === slug))).length;
  });
}

const countryGradients = [
  'from-blue-500/20 via-indigo-500/20 to-violet-500/10',
  'from-pink-500/20 via-purple-500/20 to-indigo-500/10',
  'from-cyan-500/20 via-teal-500/20 to-emerald-500/10',
  'from-amber-500/20 via-orange-500/20 to-red-500/10',
  'from-rose-500/20 via-pink-500/20 to-fuchsia-500/10'
];
---

<MainLayout title="Tất Cả Quốc Gia">
  <main class="max-w-container-max mx-auto px-gutter py-section-gap pt-32 min-h-[70vh]">
    <!-- Breadcrumb & Header -->
    <div class="mb-10 border-b border-glass-stroke pb-6">
      <nav class="flex text-on-surface-variant text-sm mb-4" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/tphim" class="inline-flex items-center hover:text-primary transition-colors">
              <span class="material-symbols-outlined text-sm mr-1">home</span>
              Trang Chủ
            </a>
          </li>
          <li>
            <div class="flex items-center">
              <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
              <span class="text-on-surface ml-1 md:ml-2">Quốc Gia</span>
            </div>
          </li>
        </ol>
      </nav>
      
      <h1 class="font-display-hero text-4xl md:text-5xl text-primary font-bold flex items-center gap-3">
        Quốc Gia & Lãnh Thổ
        <span class="material-symbols-outlined text-4xl">public</span>
      </h1>
      <p class="text-on-surface-variant mt-2 max-w-2xl">
        Khám phá thế giới phim phong phú được chia theo từng quốc gia sản xuất phim điện ảnh nổi tiếng.
      </p>
    </div>

    <!-- Countries Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
      {uniqueCountries.map((country, idx) => {
        const slug = slugify(country);
        const gradient = countryGradients[idx % countryGradients.length];
        const count = countryCounts[country] || 0;
        return (
          <a href={`/quoc-gia/${slug}`} class={`group relative overflow-hidden rounded-2xl border border-glass-stroke p-6 bg-gradient-to-br ${gradient} hover:scale-[1.03] hover:border-primary/40 transition-all duration-300 shadow-xl cursor-pointer flex flex-col justify-between h-40`}>
            <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-white/5 rounded-full blur-2xl group-hover:bg-white/10 transition-colors"></div>
            <div>
              <span class="material-symbols-outlined text-3xl text-primary group-hover:scale-110 transition-transform">flag</span>
              <h3 class="text-xl font-bold text-white mt-3 group-hover:text-primary transition-colors">{country}</h3>
            </div>
            <span class="text-xs text-on-surface-variant font-medium">{count} bộ phim</span>
          </a>
        );
      })}
    </div>
  </main>
</MainLayout>
