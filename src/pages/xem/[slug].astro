---
import MainLayout from '@layouts/MainLayout.astro';
import { WatchContainer } from '@components/player/WatchContainer.tsx';
import { MovieService } from '@services/MovieService';
import { SettingService } from '@services/SettingService';
import NotFound from '@components/ui/NotFound.astro';
import { supabase } from '@lib/supabase';
import type { Movie } from '@apptypes/movie';
import { TxaSchedule } from '@lib/TxaSchedule';

const { slug } = Astro.params;

let movie = null;
if (slug && slug !== 'undefined' && slug !== 'null') {
  movie = await MovieService.getMovieBySlug(slug);
}

if (!movie) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

// Ensure the page is never cached so that release schedule date/time checks are always fresh
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');

const settings = await SettingService.getSettings();

// Get initial server and episode parameters from query string
const epSlug = Astro.url.searchParams.get('ep') || undefined;
const svParam = Astro.url.searchParams.get('sv');
const tsParam = Astro.url.searchParams.get('ts');

// Resolve the name of the requested server from the original (unsorted) database list
let requestedServerName: string | undefined = undefined;
if (movie && movie.episodes) {
  if (tsParam) {
    requestedServerName = tsParam;
  } else if (svParam) {
    const parsed = parseInt(svParam);
    if (!isNaN(parsed) && parsed >= 0 && parsed < movie.episodes.length) {
      requestedServerName = movie.episodes[parsed].serverName;
    }
  }
}

// Filter episodes based on airing schedule
let filteredMovie = movie;
let nextAiringEpisode = null;
let isUnreleased = false;
let unreleasedEpisode = null;

if (movie && movie.episodes && movie.episodes.length > 0) {
  // Sort servers in descending order of episode count so that the server with the most episodes is first
  movie.episodes.sort((a: any, b: any) => {
    const aLen = (a.serverData || a.server_data || []).length;
    const bLen = (b.serverData || b.server_data || []).length;
    return bLen - aLen;
  });
  const rawServers = movie.episodes;
  const firstServer = rawServers[0];
  const allEps = firstServer.serverData || [];
  
  let firstUnreleasedIdx = -1;
  
  // Hide unreleased episodes only if status is "ongoing"
  if (movie.status === 'ongoing') {
    for (let i = 0; i < allEps.length; i++) {
      const ep = allEps[i];
      if (TxaSchedule.isEpisodeUnreleased(ep.name || '', i, allEps, movie.broadcastSchedule)) {
        firstUnreleasedIdx = i;
        break;
      }
    }
  }

  // Check if user is trying to access an unreleased episode
  if (firstUnreleasedIdx !== -1) {
    nextAiringEpisode = allEps[firstUnreleasedIdx];
    
    // Find target episode by slug
    let targetEpIdx = 0;
    if (epSlug) {
      targetEpIdx = allEps.findIndex((e: any) => e.slug === epSlug);
    }
    
    if (targetEpIdx >= firstUnreleasedIdx && targetEpIdx !== -1) {
      isUnreleased = true;
      unreleasedEpisode = allEps[targetEpIdx];
    }
    
    // Hide unreleased episodes from listing
    const filteredServers = rawServers.map((server: any) => ({
      serverName: server.serverName,
      serverData: (server.serverData || []).slice(0, firstUnreleasedIdx)
    }));
    
    filteredMovie = {
      ...movie,
      episodes: filteredServers
    };
  }
}

let svIdx = 0;
if (filteredMovie && filteredMovie.episodes) {
  if (requestedServerName) {
    const idx = filteredMovie.episodes.findIndex(
      (s: any) => s.serverName.toLowerCase().trim() === requestedServerName.toLowerCase().trim() ||
           s.serverName.toLowerCase().includes(requestedServerName.toLowerCase().trim()) ||
           requestedServerName.toLowerCase().trim().includes(s.serverName.toLowerCase())
    );
    if (idx !== -1) {
      svIdx = idx;
    } else {
      // Fallback if not found by name
      const parsed = parseInt(requestedServerName);
      if (!isNaN(parsed) && parsed >= 0 && parsed < filteredMovie.episodes.length) {
        svIdx = parsed;
      }
    }
  } else {
    // Prioritize the server with the most episodes
    let maxEps = -1;
    for (let i = 0; i < filteredMovie.episodes.length; i++) {
      const epCount = (filteredMovie.episodes[i].serverData || []).length;
      if (epCount > maxEps) {
        maxEps = epCount;
        svIdx = i;
      }
    }
  }
}

// Fetch related movies
const relatedMovies = movie ? await MovieService.getRelatedMovies(movie.id) : [];

// Fetch related seasons/parts of the same series
let relatedParts: Movie[] = [];
if (movie) {
  const getBaseTitle = (t: string) => {
    let cleaned = t
      .replace(/\s*(?:\(\s*)?(?:phần|ss|season|part|tập|phim|bộ)\s*\d+(?:\s*\))?/gi, '')
      .replace(/\s*-\s*$/, '')
      .trim();
    if (/.*\D\s+\d+$/i.test(cleaned)) {
      cleaned = cleaned.replace(/\s+\d+$/g, '').trim();
    }
    return cleaned;
  };
  const baseTitle = getBaseTitle(movie.title);
  
  const isSupabase = (import.meta.env.PUBLIC_DATA_PROVIDER || 'supabase') === 'supabase';
  let candidateMovies: Movie[] = [];

  if (isSupabase) {
    try {
      const selectFields = 'id, title, original_title, slug, description, poster_url, banner_url, release_year, duration_minutes, type, status, episode_current, episode_total, quality, lang, imdb_score, views, country, genres, updated_at, broadcast_schedule, actors, directors, seasons, trailer_url';
      const { data: dbCandidates } = await supabase
        .from('movies')
        .select(selectFields)
        .ilike('title', `%${baseTitle}%`);
        
      if (dbCandidates) {
        candidateMovies = dbCandidates.map((m: any) => ({
          id: m.id,
          title: m.title,
          originalTitle: m.original_title,
          slug: m.slug,
          description: m.description || '',
          posterUrl: m.poster_url || '',
          bannerUrl: m.banner_url || m.poster_url || '',
          releaseYear: m.release_year || 2024,
          durationMinutes: m.duration_minutes || '45 phút/tập',
          type: m.type,
          status: m.status,
          episodeCurrent: m.episode_current || '1',
          episodeTotal: m.episode_total || '1',
          quality: m.quality || 'FHD',
          lang: m.lang || 'Vietsub',
          imdbScore: Number(m.imdb_score) || 8.0,
          views: Number(m.views) || 0,
          category: m.country || 'Khác',
          genres: Array.isArray(m.genres) ? m.genres : [],
          updatedAt: m.updated_at || new Date().toISOString(),
          seasons: m.seasons || undefined
        }));
      }
    } catch (e) {
      console.error("Error fetching related parts from Supabase:", e);
    }
  } else {
    candidateMovies = await MovieService.getMovies();
  }

  const normalize = (t: string) => {
    let cleaned = t
      .toLowerCase()
      .replace(/\s*(?:\(\s*)?(?:phần|ss|season|part|tập|phim|bộ)\s*\d+(?:\s*\))?/gi, '')
      .replace(/\s*-\s*$/, '')
      .trim();
    if (/.*\D\s+\d+$/i.test(cleaned)) {
      cleaned = cleaned.replace(/\s+\d+$/g, '').trim();
    }
    return cleaned;
  };
  const targetBase = normalize(movie.title);

  relatedParts = candidateMovies.filter((m: Movie) => {
    const mBaseTitle = normalize(m.title);
    return targetBase.length > 2 && mBaseTitle === targetBase;
  }).sort((a: Movie, b: Movie) => {
    return a.releaseYear - b.releaseYear || a.title.localeCompare(b.title);
  });
}
---

{movie ? (
  <MainLayout title={`Xem Phim: ${movie.title} | ${settings.general.site_name}`}>
    <div class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 pb-20 w-full flex-1">
      <!-- Sub Navigation matching the requested mockup design -->
      <div class="flex items-center gap-3 mb-6">
        <a href={`/phim/${movie.slug}`} class="flex items-center justify-center w-9 h-9 rounded-full bg-white/5 border border-glass-stroke hover:bg-white/10 hover:border-white/20 transition-all duration-300 active:scale-95 group" data-txatooltip="Quay lại trang chi tiết phim">
          <span class="material-symbols-outlined text-white text-[20px] transition-transform duration-300 group-hover:-translate-x-0.5" style="font-variation-settings: 'FILL' 0, 'wght' 600;">chevron_left</span>
        </a>
        <h1 class="text-lg md:text-xl font-outfit font-bold text-white tracking-tight flex items-center gap-2">
          <span class="text-white/60 font-normal">Xem phim</span>
          <span>{movie.title}</span>
        </h1>
      </div>

      <!-- Dropdown Chọn Phần phim khác (Seasons Dropdown) -->
      {relatedParts.length > 1 && (
        <div id="movie-seasons-dropdown-wrapper" class="mb-6">
          <div class="glass-card bg-surface-card border border-glass-stroke rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-md">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-base">layers</span>
              <span class="text-xs font-bold text-white">Xem các phần phim khác của tác phẩm:</span>
            </div>
            <div class="relative min-w-[200px]">
              <select id="seasons-redirect-select" class="w-full bg-zinc-900 border border-glass-stroke rounded-xl py-2 px-3 text-xs text-white focus:outline-none focus:border-primary cursor-pointer appearance-none">
                {relatedParts.map(part => (
                  <option value={`/xem/${part.slug}`} selected={part.slug === movie.slug}>
                    {part.title} ({part.seasons || `${part.releaseYear}`})
                  </option>
                ))}
              </select>
              <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 text-xs pointer-events-none">keyboard_arrow_down</span>
            </div>
          </div>
        </div>
      )}

      <WatchContainer 
        client:load 
        movie={filteredMovie!} 
        initialEpisodeSlug={epSlug} 
        initialServerIndex={svIdx} 
        relatedMovies={relatedMovies} 
        isUnreleased={isUnreleased}
        unreleasedEpisode={unreleasedEpisode}
        nextAiringEpisode={nextAiringEpisode}
        siteName={settings.general.site_name}
        siteUrl={settings.general.site_url}
      />
    </div>

    <script>
      // Seasons Dropdown redirects
      const seasonsSelect = document.getElementById('seasons-redirect-select') as HTMLSelectElement | null;
      if (seasonsSelect) {
        seasonsSelect.addEventListener('change', (e: any) => {
          window.location.href = e.target.value;
        });
      }
    </script>
  </MainLayout>
) : (
  <MainLayout title={`Không tìm thấy phim | ${settings.general.site_name}`}>
    <div class="max-w-container-max mx-auto px-gutter pt-24 flex items-center justify-center flex-1">
      <NotFound />
    </div>
  </MainLayout>
)}
