---
import MainLayout from '@layouts/MainLayout.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
---

<MainLayout title={`Lịch sử xem phim | ${settings.general.site_name}`}>
  <main class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 min-h-[70vh] flex flex-col">
    <!-- Header -->
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10 mt-4">
      <div>
        <h1 class="font-display-hero text-3xl md:text-4xl text-primary font-bold mb-2">Lịch sử xem phim</h1>
        <p class="text-on-surface-variant text-sm">Xem lại các bộ phim bạn đang xem dở trên mọi thiết bị.</p>
      </div>
      <button id="clearAllHistoryBtn" class="bg-error/10 hover:bg-error/20 text-error px-5 py-3 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-2 border border-error/20">
        <span class="material-symbols-outlined text-sm">delete_sweep</span>
        Xóa toàn bộ lịch sử
      </button>
    </header>

    <!-- Grid items -->
    <div id="historyGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 flex-1">
      <!-- Sẽ được render bằng JavaScript ở client-side -->
    </div>

    <!-- Empty State -->
    <div id="emptyHistory" class="hidden flex-1 flex flex-col items-center justify-center py-20 text-center text-on-surface-variant">
      <span class="material-symbols-outlined text-7xl opacity-20 mb-4 animate-pulse">history</span>
      <h3 class="text-lg font-bold text-white mb-1">Chưa có lịch sử xem</h3>
      <p class="text-xs max-w-xs mx-auto">Phim bạn đã xem sẽ xuất hiện ở đây để bạn có thể xem tiếp bất cứ lúc nào.</p>
      <a href="/tphim" class="mt-6 inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-on-primary font-bold px-6 py-3 rounded-xl text-xs transition-all shadow-lg shadow-primary/20 cursor-pointer">
        <span class="material-symbols-outlined text-sm">explore</span>
        Khám phá phim ngay
      </a>
    </div>
  </main>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const historyGrid = document.getElementById('historyGrid');
    const emptyHistory = document.getElementById('emptyHistory');
    const clearAllBtn = document.getElementById('clearAllHistoryBtn');

    if (!historyGrid || !emptyHistory || !clearAllBtn) return;

    const username = typeof localStorage !== 'undefined' ? (window.APP_USER ? window.APP_USER.username : null) : null;

    // Helper: Read thistory from localStorage and convert to list for rendering
    function getLocalHistory() {
      try {
        const stored = localStorage.getItem('thistory');
        if (!stored) return [];
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed)) return parsed;
        
        // Nếu là dạng dict { [slug]: { title, posterUrl, updatedAt, episodes: { [epSlug]: { ... } } } }
        const list = [];
        if (parsed && typeof parsed === 'object') {
          Object.keys(parsed).forEach(slug => {
            const item = parsed[slug];
            if (item && item.episodes) {
              // Tìm tập phim mới nhất
              const epKeys = Object.keys(item.episodes);
              let latestEp = null;
              epKeys.forEach(epKey => {
                const ep = item.episodes[epKey];
                if (!latestEp || new Date(ep.updatedAt).getTime() > new Date(latestEp.updatedAt).getTime()) {
                  latestEp = ep;
                }
              });
              if (latestEp) {
                list.push({
                  slug: slug,
                  title: item.title,
                  posterUrl: item.posterUrl,
                  episodeSlug: latestEp.episodeSlug,
                  episodeName: latestEp.episodeName,
                  currentTime: latestEp.currentTime,
                  duration: latestEp.duration,
                  serverIndex: latestEp.serverIndex,
                  updatedAt: latestEp.updatedAt || item.updatedAt,
                  synced: latestEp.synced
                });
              }
            }
          });
        }
        return list;
      } catch (e) {
        return [];
      }
    }

    // Helper: Save thistory to localStorage
    function saveLocalHistory(list) {
      // Khi lưu từ UI mảng phẳng, convert lại sang cấu trúc dict
      const dict = {};
      list.forEach(item => {
        if (item && item.slug) {
          dict[item.slug] = {
            title: item.title,
            posterUrl: item.posterUrl,
            updatedAt: item.updatedAt,
            episodes: {
              [item.episodeSlug || 'default']: {
                episodeSlug: item.episodeSlug,
                episodeName: item.episodeName,
                currentTime: item.currentTime,
                duration: item.duration,
                serverIndex: item.serverIndex,
                serverName: item.serverName || 'Server VIP',
                updatedAt: item.updatedAt,
                synced: item.synced
              }
            }
          };
        }
      });
      localStorage.setItem('thistory', JSON.stringify(dict));
    }

    // Render list
    function renderHistoryList(list) {
      // Sort by updatedAt descending
      list.sort((a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime());

      if (list.length === 0) {
        historyGrid.innerHTML = '';
        historyGrid.classList.add('hidden');
        emptyHistory.classList.remove('hidden');
        clearAllBtn.classList.add('hidden');
        return;
      }

      emptyHistory.classList.add('hidden');
      historyGrid.classList.remove('hidden');
      clearAllBtn.classList.remove('hidden');

      historyGrid.innerHTML = list.map(item => {
        const percent = item.duration > 0 ? Math.min(Math.round((item.currentTime / item.duration) * 100), 100) : 0;
        const watchUrl = `/xem/${item.slug}?ep=${item.episodeSlug}&sv=${item.serverIndex || 0}`;

        // Fallback images
        const poster = item.posterUrl || '/favicon.png';

        return `
          <div class="glass-card bg-surface-card border border-glass-stroke rounded-2xl overflow-hidden flex flex-col shadow-xl transition-all duration-300 hover:border-primary/30 group">
            <!-- Movie Image -->
            <div class="relative aspect-video w-full bg-black/40 overflow-hidden shrink-0">
              <img src="${poster}" alt="${item.title || item.slug}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#141416] via-[#141416]/20 to-transparent"></div>

              <!-- Percent badge -->
              <div class="absolute bottom-3 left-3 bg-primary text-on-primary text-[10px] px-2 py-0.5 rounded font-bold">
                Đã xem ${percent}%
              </div>
            </div>

            <!-- Content Info -->
            <div class="p-5 flex flex-col flex-1 justify-between gap-4">
              <div>
                <h3 class="text-white font-bold text-sm leading-snug line-clamp-1 group-hover:text-primary transition-colors font-outfit" data-txatooltip="${item.title || item.slug}">
                  ${item.title || item.slug}
                </h3>
                <p class="text-xs text-on-surface-variant mt-1.5 flex items-center gap-1 font-medium">
                  <span class="material-symbols-outlined text-xs">play_circle</span>
                  Xem dở: ${item.episodeName || 'Tập phim'}
                </p>
                <div class="text-[10px] text-zinc-500 font-mono mt-1">Cập nhật: ${new Date(item.updatedAt).toLocaleDateString('vi-VN')}</div>
              </div>

              <!-- Progress bar -->
              <div class="w-full bg-surface h-1.5 rounded-full overflow-hidden shrink-0">
                <div class="bg-primary h-full rounded-full" style="width: ${percent}%;"></div>
              </div>

              <!-- Buttons -->
              <div class="flex gap-2 shrink-0 pt-1">
                <a href="${watchUrl}" class="flex-1 flex items-center justify-center gap-1 py-2.5 px-4 bg-primary hover:bg-primary/95 text-on-primary rounded-xl text-xs font-bold transition-all shadow-[0_4px_12px_rgba(124,58,237,0.15)] cursor-pointer">
                  <span class="material-symbols-outlined text-xs font-bold" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                  Xem tiếp
                </a>
                <button onclick="deleteSingleHistory('${item.slug}')" class="w-10 h-10 rounded-xl border border-glass-stroke flex items-center justify-center text-red-400 hover:bg-red-500/10 hover:border-red-500/30 transition-all cursor-pointer" data-txatooltip="Xóa">
                  <span class="material-symbols-outlined text-sm">delete</span>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Delete single history
    window.deleteSingleHistory = function(slug) {
      if (!confirm('Bạn có chắc chắn muốn xóa lịch sử xem của phim này không?')) return;

      if (!username) {
        const list = getLocalHistory();
        const newList = list.filter(x => x.slug !== slug);
        saveLocalHistory(newList);
        renderHistoryList(newList);
        if (window.showGlobalToast) window.showGlobalToast('Đã xóa lịch sử xem thành công!', 'success');
        return;
      }

      if (typeof navigator !== 'undefined' && navigator.onLine) {
        fetch(`/api/user/history?username=${encodeURIComponent(username)}&slug=${encodeURIComponent(slug)}`, { method: 'DELETE' })
          .then(res => {
            if (res.ok) {
              if (window.showGlobalToast) window.showGlobalToast('Đã xóa lịch sử xem thành công!', 'success');
              loadHistoryData();
            }
          })
          .catch(err => console.warn('Failed to delete history on server:', err));
      } else {
        if (window.showGlobalToast) window.showGlobalToast('Không có kết nối mạng để xóa trên máy chủ!', 'error');
      }
    };

    // Clear all history
    clearAllBtn.addEventListener('click', () => {
      if (!confirm('CẢNH BÁO: Bạn có muốn xóa sạch toàn bộ lịch sử xem phim không? Hành động này không thể hoàn tác!')) return;

      if (!username) {
        localStorage.removeItem('thistory');
        renderHistoryList([]);
        if (window.showGlobalToast) window.showGlobalToast('Đã xóa toàn bộ lịch sử xem thành công!', 'success');
        return;
      }

      if (typeof navigator !== 'undefined' && navigator.onLine) {
        fetch(`/api/user/history?username=${encodeURIComponent(username)}`, { method: 'DELETE' })
          .then(res => {
            if (res.ok) {
              if (window.showGlobalToast) window.showGlobalToast('Đã xóa toàn bộ lịch sử xem thành công!', 'success');
              renderHistoryList([]);
            }
          })
          .catch(err => console.warn('Failed to clear history on server:', err));
      } else {
        if (window.showGlobalToast) window.showGlobalToast('Không có kết nối mạng để xóa trên máy chủ!', 'error');
      }
    });

    function loadHistoryData() {
      const localList = getLocalHistory();
      if (!username) {
        renderHistoryList(localList);
        return;
      }

      if (typeof navigator !== 'undefined' && navigator.onLine) {
        fetch(`/api/user/history?username=${encodeURIComponent(username)}`)
          .then(res => res.ok ? res.json() : [])
          .then(onlineList => {
            const list = (Array.isArray(onlineList) && onlineList.length > 0) ? onlineList : localList;
            renderHistoryList(list);
          })
          .catch(err => {
            console.warn('Error fetching online history:', err);
            renderHistoryList(localList);
          });
      } else {
        renderHistoryList(localList);
      }
    }

    loadHistoryData();
  });
</script>

