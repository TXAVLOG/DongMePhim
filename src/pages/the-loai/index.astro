---
import MainLayout from '@layouts/MainLayout.astro';
import { MovieService } from '@services/MovieService';
import { slugify } from '../../backend/utils/categoryHelper';
import { supabase } from '@lib/supabase';

const standardGenres = ["Hành Động", "Tình Cảm", "Kinh Dị", "Hài Hước", "Viễn Tưởng", "Cổ Trang", "Hoạt Hình", "Tâm Lý", "Hình Sự", "Võ Thuật", "Học Đường", "Phiêu Lưu", "Thần Thoại", "Chiến Tranh", "Bí Ẩn", "Kịch Tính", "Trinh Thám", "Lồng Tiếng"];

let uniqueGenres = standardGenres;
let genreCounts: Record<string, number> = {};

const isSupabase = import.meta.env.PUBLIC_DATA_PROVIDER === 'supabase';
if (isSupabase) {
  try {
    const { data: dbGenres } = await supabase.from('view_genre_counts').select('*');
    if (dbGenres) {
      const dbGenreNames = dbGenres.map(g => g.genre);
      uniqueGenres = [...new Set([...standardGenres, ...dbGenreNames])];
      dbGenres.forEach(g => {
        genreCounts[g.genre] = g.count;
      });
    }
  } catch (e) {
    console.error("Lỗi khi tải thể loại từ Supabase view:", e);
  }
} else {
  const movies = await MovieService.getMovies();
  const dynamicGenres = movies.flatMap((m: any) => m.genres || []).filter(Boolean);
  uniqueGenres = [...new Set([...standardGenres, ...dynamicGenres])] as string[];
  uniqueGenres.forEach(genre => {
    const slug = slugify(genre);
    genreCounts[genre] = movies.filter((m: any) => (Array.isArray(m.genres) && m.genres.some((g: any) => slugify(g) === slug)) || slugify(m.category || '') === slug).length;
  });
}

const genreGradients = [
  'from-pink-500/20 via-purple-500/20 to-indigo-500/10',
  'from-cyan-500/20 via-teal-500/20 to-emerald-500/10',
  'from-amber-500/20 via-orange-500/20 to-red-500/10',
  'from-blue-500/20 via-indigo-500/20 to-violet-500/10',
  'from-rose-500/20 via-pink-500/20 to-fuchsia-500/10'
];
---

<MainLayout title="Tất Cả Thể Loại">
  <main class="max-w-container-max mx-auto px-gutter py-section-gap pt-32 min-h-[70vh]">
    <!-- Breadcrumb & Header -->
    <div class="mb-10 border-b border-glass-stroke pb-6">
      <nav class="flex text-on-surface-variant text-sm mb-4" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/tphim" class="inline-flex items-center hover:text-primary transition-colors">
              <span class="material-symbols-outlined text-sm mr-1">home</span>
              Trang Chủ
            </a>
          </li>
          <li>
            <div class="flex items-center">
              <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
              <span class="text-on-surface ml-1 md:ml-2">Thể Loại</span>
            </div>
          </li>
        </ol>
      </nav>
      
      <h1 class="font-display-hero text-4xl md:text-5xl text-primary font-bold flex items-center gap-3">
        Thể Loại Phim
        <span class="material-symbols-outlined text-4xl">grid_view</span>
      </h1>
      <p class="text-on-surface-variant mt-2 max-w-2xl">
        Khám phá thế giới phim phong phú được chia theo từng thể loại nội dung đặc sắc.
      </p>
    </div>

    <!-- Genres Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
      {uniqueGenres.map((genre, idx) => {
        const slug = slugify(genre);
        const gradient = genreGradients[idx % genreGradients.length];
        const count = genreCounts[genre] || 0;
        return (
          <a href={`/the-loai/${slug}`} class={`group relative overflow-hidden rounded-2xl border border-glass-stroke p-6 bg-gradient-to-br ${gradient} hover:scale-[1.03] hover:border-primary/40 transition-all duration-300 shadow-xl cursor-pointer flex flex-col justify-between h-40`}>
            <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-white/5 rounded-full blur-2xl group-hover:bg-white/10 transition-colors"></div>
            <div>
              <span class="material-symbols-outlined text-3xl text-primary group-hover:scale-110 transition-transform">movie_filter</span>
              <h3 class="text-xl font-bold text-white mt-3 group-hover:text-primary transition-colors">{genre}</h3>
            </div>
            <span class="text-xs text-on-surface-variant font-medium">{count} bộ phim</span>
          </a>
        );
      })}
    </div>
  </main>
</MainLayout>
