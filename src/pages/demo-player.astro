---
import MainLayout from '@layouts/MainLayout.astro';
import { TXAPlayer } from '@txa/txaplayer';
import { MovieService } from '@services/MovieService';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
const movie = await MovieService.getMovieBySlug('ke-trom-mat-trang-2');

// Media assets của phim Kẻ Trộm Mặt Trăng 2 (Despicable Me 2)
const url = 'https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Despicable%20Me%202%202013%20UHD%201080p%2010bit%20HDR%20BluRay%20HEVC%20x265%20%5BHindi%20BD%20DTS%205.1%20768kbps%20+%20English%20DDP%207.1%5D%20ESub-JM-4kHdHub/master.m3u8';
const title = movie?.title || 'Kẻ Trộm Mặt Trăng 2 (Despicable Me 2)';
const poster = movie?.bannerUrl || movie?.posterUrl || 'https://image.tmdb.org/t/p/original/u0l8j5Rk2WfOQ99fV8q7NqP1101.jpg';

// Cấu hình danh sách phụ đề song ngữ Việt - Hàn thật của phim
const subtitles = [
  {
    label: 'Tiếng Việt',
    file: 'https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Despicable%20Me%202%202013%20UHD%201080p%2010bit%20HDR%20BluRay%20HEVC%20x265%20%5BHindi%20BD%20DTS%205.1%20768kbps%20+%20English%20DDP%207.1%5D%20ESub-JM-4kHdHub/k%E1%BB%9Bi%20tr%E1%BB%99m%20m%E1%BA%B7t%20tr%C4%83ng%202.vi.srt',
    default: true
  },
  {
    label: 'Korean',
    file: 'https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Despicable%20Me%202%202013%20UHD%201080p%2010bit%20HDR%20BluRay%20HEVC%20x265%20%5BHindi%20BD%20DTS%205.1%20768kbps%20+%20English%20DDP%207.1%5D%20ESub-JM-4kHdHub/k%E1%BB%9Bi%20tr%E1%BB%99m%20m%E1%BA%B7t%20tr%C4%83ng%202.kr.srt'
  }
];
---

<MainLayout title={`Demo Player Song Ngữ: ${title} | ${settings.general.site_name || 'WebFilm'}`}>
  <div class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 pb-20 w-full flex-1">
    <div class="flex items-center gap-3 mb-6">
      <a href="/" class="flex items-center justify-center w-9 h-9 rounded-full bg-white/5 border border-glass-stroke hover:bg-white/10 hover:border-white/20 transition-all duration-300 active:scale-95 group" data-txatooltip="Quay lại trang chủ">
        <span class="material-symbols-outlined text-white text-[20px] transition-transform duration-300 group-hover:-translate-x-0.5" style="font-variation-settings: 'FILL' 0, 'wght' 600;">chevron_left</span>
      </a>
      <h1 class="text-lg md:text-xl font-outfit font-bold text-white tracking-tight flex items-center gap-2">
        <span class="text-white/60 font-normal">Trang Demo Song Ngữ (TXAPlayer)</span>
        <span>{title}</span>
      </h1>
    </div>

    <div class="w-full aspect-video rounded-xl overflow-hidden shadow-2xl relative bg-black border border-glass-stroke">
      <TXAPlayer 
        client:load 
        url={url}
        title={title}
        poster={poster || undefined}
        subtitles={subtitles}
        qualities={[
          { html: '1080p', url: 'https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Despicable%20Me%202%202013%20UHD%201080p%2010bit%20HDR%20BluRay%20HEVC%20x265%20%5BHindi%20BD%20DTS%205.1%20768kbps%20+%20English%20DDP%207.1%5D%20ESub-JM-4kHdHub/1080p/index.m3u8', default: true },
          { html: '720p', url: url },
          { html: '480p', url: url }
        ]}
        onChangeQuality={(item) => {
          console.log('Chất lượng phát: ', item.html);
        }}
        siteName={settings.general.site_name || undefined}
        siteUrl={settings.general.site_url || undefined}
        storyboardUrl="https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Despicable%20Me%202%202013%20UHD%201080p%2010bit%20HDR%20BluRay%20HEVC%20x265%20%5BHindi%20BD%20DTS%205.1%20768kbps%20+%20English%20DDP%207.1%5D%20ESub-JM-4kHdHub/storyboard.vtt"
        timeIntroStart={15}
        timeIntroEnd={90}
        timeOutroStart={4700}
        timeOutroEnd={4850}
        adSettings={settings.ads}
        movieSlug="ke-trom-mat-trang-2"
        episodeSlug="full"
      />
    </div>

    <div class="mt-8 backdrop-blur-md bg-white/5 border border-glass-stroke rounded-2xl p-6 shadow-xl max-w-3xl">
      <h2 class="text-white font-bold font-outfit text-sm mb-3 uppercase tracking-wider flex items-center gap-2">
        <span class="material-symbols-outlined text-[#7c3aed] text-lg">info</span>
        Hướng dẫn kiểm thử song ngữ & Storyboard
      </h2>
      <ul class="text-zinc-400 text-xs space-y-2.5 leading-relaxed font-sans list-disc list-inside">
        <li>Trình phát phát luồng HLS chất lượng cao Kẻ Trộm Mặt Trăng 2 (Despicable Me 2).</li>
        <li>Bật/tắt phụ đề song ngữ bằng trình chọn CC (chọn Tiếng Việt hoặc Korean).</li>
        <li>Di chuột lên thanh tua (seek bar) để kiểm tra <strong class="text-white">ảnh xem trước Storyboard</strong> chính xác (160x90px, lưới 10x10, mỗi 10 giây).</li>
        <li>Đổi các độ phân giải (1080p, 720p, 480p) trong nút răng cưa để kiểm tra đổi chất lượng.</li>
        <li>Tua đến giây thứ <strong class="text-white">15</strong> để test Skip Intro (hoặc bật tự động skip intro).</li>
        <li>Xem video một lát, sau đó tải lại trang để kiểm tra <strong class="text-white">Popup Modal phát tiếp (Resume)</strong>.</li>
      </ul>
    </div>
  </div>
</MainLayout>

