---
import MainLayout from '@layouts/MainLayout.astro';
import { TXAPlayer } from '@components/player/TXAPlayer.tsx';
import { MovieService } from '@services/MovieService';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
const movie = await MovieService.getMovieBySlug('zoey-khac');

// Media assets từ Cloudflare R2 công cộng & nguồn phimapi.com
const url = 'https://v7.kkphimplayer7.com/20260702/1RfvTgea/index.m3u8';
const title = movie?.title || 'Zoey Khác (The Other Zoey)';
const poster = movie?.bannerUrl || movie?.posterUrl || 'https://phimimg.com/upload/vod/20260703-1/bd023455f5743bce0e3280e5fd74599c.jpg';

// Cấu hình danh sách phụ đề song ngữ
const subtitles = [
  {
    label: 'Tiếng Việt',
    file: 'https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Obsession%20(2026)%201080p%20AMZN%20WEB-DL%20x264%20%5BEnglish%20DDP%205.1%5D%20ESub-(KyoGo-4kHdHub)/Obsession.2025.1080p.MA.WEB-DL.DDP5.1.Atmos.H.264%20(SDH).vi.srt',
    default: true
  },
  {
    label: 'English',
    file: 'https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Obsession%20(2026)%201080p%20AMZN%20WEB-DL%20x264%20%5BEnglish%20DDP%205.1%5D%20ESub-(KyoGo-4kHdHub)/Obsession.2025.1080p.MA.WEB-DL.DDP5.1.Atmos.H.264%20(SDH).srt'
  }
];
---

<MainLayout title={`Demo Player Song Ngữ: ${title} | ${settings.general.site_name || 'WebFilm'}`}>
  <div class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 pb-20 w-full flex-1">
    <div class="flex items-center gap-3 mb-6">
      <a href="/" class="flex items-center justify-center w-9 h-9 rounded-full bg-white/5 border border-glass-stroke hover:bg-white/10 hover:border-white/20 transition-all duration-300 active:scale-95 group" data-txatooltip="Quay lại trang chủ">
        <span class="material-symbols-outlined text-white text-[20px] transition-transform duration-300 group-hover:-translate-x-0.5" style="font-variation-settings: 'FILL' 0, 'wght' 600;">chevron_left</span>
      </a>
      <h1 class="text-lg md:text-xl font-outfit font-bold text-white tracking-tight flex items-center gap-2">
        <span class="text-white/60 font-normal">Trang Demo (TXAPlayer)</span>
        <span>{title}</span>
      </h1>
    </div>

    <div class="w-full aspect-video rounded-xl overflow-hidden shadow-2xl relative bg-black border border-glass-stroke">
      <TXAPlayer 
        client:load 
        url={url}
        title={title}
        poster={poster || undefined}
        subtitles={subtitles}
        qualities={[
          { html: 'Auto', url: url, default: true }
        ]}
        onChangeQuality={(item) => {
          console.log('Chất lượng phát: ', item.html);
        }}
        siteName={settings.general.site_name || undefined}
        siteUrl={settings.general.site_url || undefined}
        storyboardUrl="https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Obsession%20(2026)%201080p%20AMZN%20WEB-DL%20x264%20%5BEnglish%20DDP%205.1%5D%20ESub-(KyoGo-4kHdHub)/storyboard.vtt"
      />
    </div>
  </div>
</MainLayout>
