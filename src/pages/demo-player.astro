---
import MainLayout from '@layouts/MainLayout.astro';
import { TXAPlayer } from '@txa/txaplayer';
import { MovieService } from '@services/MovieService';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
const movie = await MovieService.getMovieBySlug('minions-monsters');

// Media assets của phim Minions & Monsters
const url = 'https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Minions.2026.1080p.CAM.x264-DKS/master.m3u8';
const title = movie?.title || 'Minions & Monsters (2026)';
const poster = movie?.bannerUrl || movie?.posterUrl || 'https://image.tmdb.org/t/p/original/uEBBHwJuDfBtVWd2WS7WBOc8kb6.jpg';

// Cấu hình danh sách phụ đề song ngữ Anh - Việt thật của phim
const subtitles = [
  {
    label: 'Tiếng Việt',
    file: 'https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Minions.2026.1080p.CAM.x264-DKS/Minions%20.%20Monsters.2026.CAM-Rip-OnlyFlix.1080p.English.vi.srt',
    default: true
  },
  {
    label: 'English',
    file: 'https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Minions.2026.1080p.CAM.x264-DKS/Minions%20.%20Monsters.2026.CAM-Rip-OnlyFlix.1080p.English.srt'
  }
];
---

<MainLayout title={`Demo Player Song Ngữ: ${title} | ${settings.general.site_name || 'WebFilm'}`}>
  <div class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 pb-20 w-full flex-1">
    <div class="flex items-center gap-3 mb-6">
      <a href="/" class="flex items-center justify-center w-9 h-9 rounded-full bg-white/5 border border-glass-stroke hover:bg-white/10 hover:border-white/20 transition-all duration-300 active:scale-95 group" data-txatooltip="Quay lại trang chủ">
        <span class="material-symbols-outlined text-white text-[20px] transition-transform duration-300 group-hover:-translate-x-0.5" style="font-variation-settings: 'FILL' 0, 'wght' 600;">chevron_left</span>
      </a>
      <h1 class="text-lg md:text-xl font-outfit font-bold text-white tracking-tight flex items-center gap-2">
        <span class="text-white/60 font-normal">Trang Demo Song Ngữ (TXAPlayer)</span>
        <span>{title}</span>
      </h1>
    </div>

    <div class="w-full aspect-video rounded-xl overflow-hidden shadow-2xl relative bg-black border border-glass-stroke">
      <TXAPlayer 
        client:load 
        url={url}
        title={title}
        poster={poster || undefined}
        subtitles={subtitles}
        qualities={[
          { html: 'Auto', url: url, default: true }
        ]}
        onChangeQuality={(item) => {
          console.log('Chất lượng phát: ', item.html);
        }}
        siteName={settings.general.site_name || undefined}
        siteUrl={settings.general.site_url || undefined}
        storyboardUrl="https://pub-23023fab408a4b7aa2786bfde1d472d9.r2.dev/txa_media/Minions.2026.1080p.CAM.x264-DKS/storyboard.vtt"
        timeIntroStart={15}
        timeIntroEnd={50}
        timeOutroStart={250}
        timeOutroEnd={320}
        adSettings={settings.ads}
        movieSlug="minions-monsters"
        episodeSlug="full"
      />
    </div>

    <div class="mt-8 backdrop-blur-md bg-white/5 border border-glass-stroke rounded-2xl p-6 shadow-xl max-w-3xl">
      <h2 class="text-white font-bold font-outfit text-sm mb-3 uppercase tracking-wider flex items-center gap-2">
        <span class="material-symbols-outlined text-[#1e88e5] text-lg">info</span>
        Hướng dẫn kiểm thử song ngữ
      </h2>
      <ul class="text-zinc-400 text-xs space-y-2.5 leading-relaxed font-sans list-disc list-inside">
        <li>Trình phát được tải trực tiếp từ thư viện độc lập <strong class="text-white">@txa/txaplayer</strong>.</li>
        <li>Bật/tắt chế độ <strong class="text-white">Tự động Skip</strong> bằng công tắc iOS ở góc trên bên phải trình phát.</li>
        <li>Tua đến giây thứ <strong class="text-white">15</strong> để test Skip Intro (sẽ hiện nút nếu tắt tự động, hoặc tự tua qua giây 50 nếu bật tự động).</li>
        <li><strong class="text-[#1e88e5]">Tính năng kéo tua chính xác kiểu YouTube</strong>: Nhấp giữ nút kéo trên thanh tiến trình và kéo tay hướng lên trên để mở dải 7 ảnh phân cảnh lân cận, rê chuột trái phải để tua chính xác.</li>
        <li>Click chuột phải vào trình phát để kiểm tra <strong class="text-white">Context Menu tùy chỉnh</strong> bản quyền của trình phát.</li>
        <li>Xem video một lát, sau đó tải lại trang để kiểm tra <strong class="text-white">Popup Modal phát tiếp (Resume)</strong>.</li>
      </ul>
    </div>
  </div>
</MainLayout>
