---
import MainLayout from '@layouts/MainLayout.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
---

<MainLayout title={`Thông tin tài khoản | ${settings.general.site_name}`}>
  <main class="max-w-4xl mx-auto px-6 py-24 md:py-32">
    <div class="glass-panel p-8 md:p-12 rounded-[32px] border border-glass-stroke relative overflow-hidden">
      <div class="absolute inset-0 bg-primary/5 blur-[80px] pointer-events-none"></div>
      
      <div class="relative z-10 space-y-6">
        <header class="border-b border-glass-stroke pb-6">
          <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Thông tin tài khoản</h1>
          <p class="text-zinc-500 text-xs font-bold uppercase tracking-wider mt-2 font-label-caps">Quản lý và xem thông tin tài khoản của bạn</p>
        </header>

        <div id="user-info-content" class="space-y-6 text-zinc-300 text-sm">
          <!-- Loading state -->
          <div id="info-loading" class="py-12 flex flex-col items-center justify-center gap-3">
            <div class="w-8 h-8 rounded-full border-2 border-primary border-t-transparent animate-spin"></div>
            <p class="text-zinc-500 text-xs uppercase font-bold tracking-wider">Đang tải thông tin...</p>
          </div>

          <!-- Logged in state -->
          <div id="info-profile" class="hidden space-y-6">
            <div class="flex flex-col sm:flex-row items-center gap-6 p-6 bg-white/[0.02] border border-white/5 rounded-2xl">
              <div class="relative w-24 h-24 rounded-full overflow-hidden border-2 border-primary shadow-lg shadow-primary/20">
                <img id="info-avatar" src="/logo-decoy.png" class="w-full h-full object-cover" onerror="this.src='/logo-decoy.png';" />
              </div>
              <div class="text-center sm:text-left space-y-2">
                <h2 id="info-name" class="text-xl font-bold text-white"></h2>
                <p id="info-email" class="text-xs text-zinc-400 font-mono"></p>
                <div class="flex flex-wrap gap-2 justify-center sm:justify-start pt-1">
                  <span id="info-package-badge" class="bg-primary/20 text-primary border border-primary/30 rounded-full px-3 py-1 text-[10px] font-bold uppercase"></span>
                  <a href="/goi-dich-vu" id="info-status-badge" class="bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-400 border border-emerald-500/30 rounded-full px-3 py-1 text-[10px] font-bold uppercase active:scale-95 transition-all cursor-pointer no-underline flex items-center justify-center">Kích hoạt</a>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="p-6 bg-white/[0.01] border border-white/5 rounded-2xl space-y-4">
                <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2 border-b border-white/5 pb-3">
                  <span class="material-symbols-outlined text-primary text-sm">assignment_ind</span> Thông tin cá nhân
                </h3>
                <div class="space-y-3">
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Tên tài khoản:</span>
                    <span id="info-username-val" class="font-bold text-xs text-white"></span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Email liên kết:</span>
                    <span id="info-email-val" class="font-bold text-xs text-white font-mono"></span>
                  </div>
                  <div class="flex justify-between py-1">
                    <span class="text-zinc-500 text-xs">Ngày đăng ký:</span>
                    <span id="info-created-val" class="font-bold text-xs text-white"></span>
                  </div>
                </div>
              </div>

              <div class="p-6 bg-white/[0.01] border border-white/5 rounded-2xl space-y-4">
                <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2 border-b border-white/5 pb-3">
                  <span class="material-symbols-outlined text-primary text-sm">workspace_premium</span> Gói dịch vụ hiện tại
                </h3>
                <div class="space-y-3">
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Tên gói:</span>
                    <span id="info-package-val" class="font-bold text-xs text-primary"></span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Quyền hạn:</span>
                    <span id="info-rights-val" class="font-bold text-xs text-white">Xem cơ bản</span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Hạn dùng:</span>
                    <span id="info-expiry-val" class="font-bold text-xs text-zinc-400">Vô thời hạn</span>
                  </div>
                  <div id="info-remaining-container" class="flex justify-between py-1 border-b border-white/[0.02] hidden">
                    <span class="text-zinc-500 text-xs">Còn lại:</span>
                    <span id="info-remaining-val" class="font-bold text-xs text-primary"></span>
                  </div>
                  <div class="pt-2">
                    <a href="/goi-dich-vu" class="w-full flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-primary/20 hover:border-primary/40 bg-primary/5 hover:bg-primary/10 text-primary text-xs font-bold transition-all text-center no-underline cursor-pointer">
                      <span class="material-symbols-outlined text-base">card_membership</span>
                      Quản lý Gói dịch vụ
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Discord Connection Panel -->
            <div id="discord-card" class="p-6 bg-white/[0.01] border border-white/5 rounded-2xl space-y-4">
              <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2 border-b border-white/5 pb-3">
                <span class="material-symbols-outlined text-[#5865F2] text-sm">smart_toy</span> Liên kết Discord Server
              </h3>
              <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="space-y-1 text-left">
                  <p id="discord-status-text" class="text-xs font-semibold text-zinc-400">Trạng thái: Đang tải...</p>
                  <p id="discord-info-sub" class="text-[10px] text-zinc-500 font-medium">Kết nối tài khoản Discord để tự động đồng bộ vai trò, nhận gói VIP, theo dõi lịch chiếu và tham gia sự kiện trên máy chủ.</p>
                </div>
                <div class="shrink-0 flex gap-3">
                  <a href="/connect-discord" id="btn-discord-connect" class="hidden px-5 py-2 bg-[#5865F2] hover:bg-[#4d5bdf] text-white rounded-xl text-xs font-bold transition-all items-center gap-1.5 border-none decoration-none no-underline cursor-pointer">
                    <span class="material-symbols-outlined text-sm">link</span> Liên kết ngay
                  </a>
                  <button type="button" id="btn-discord-disconnect" class="hidden px-5 py-2 bg-red-500/10 border border-red-500/20 text-red-400 rounded-xl text-xs font-bold hover:bg-red-500/20 active:scale-95 transition-all items-center gap-1.5 cursor-pointer border-none">
                    <span class="material-symbols-outlined text-sm">link_off</span> Hủy liên kết
                  </button>
                </div>
              </div>
            </div>

            <!-- Centered Logout Button -->
            <div class="flex justify-center pt-6">
              <button 
                onclick="logout()" 
                class="px-8 py-3 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 hover:border-red-500/50 text-red-400 rounded-xl text-xs font-bold hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer border-none flex items-center gap-2"
              >
                <span class="material-symbols-outlined text-[18px]">logout</span>
                Đăng xuất tài khoản
              </button>
            </div>
          </div>

          <!-- Unauthenticated state -->
          <div id="info-unauth" class="hidden py-12 flex flex-col items-center justify-center text-center gap-4">
            <span class="material-symbols-outlined text-5xl text-zinc-600">no_accounts</span>
            <div>
              <h3 class="text-base font-bold text-white">Bạn chưa đăng nhập</h3>
              <p class="text-xs text-zinc-500 mt-1 max-w-xs">Vui lòng đăng nhập tài khoản để xem thông tin chi tiết của bạn.</p>
            </div>
            <button onclick="window.showAuthModal ? window.showAuthModal('login') : alert('Vui lòng click đăng nhập ở góc phải màn hình!')" class="px-6 py-2.5 bg-primary text-slate-950 rounded-xl text-xs font-bold hover:brightness-110 active:scale-95 transition-all cursor-pointer border-none flex items-center gap-1.5 shadow-lg shadow-primary/20">
              <span class="material-symbols-outlined text-sm">login</span> Đăng nhập ngay
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const loading = document.getElementById('info-loading');
    const profile = document.getElementById('info-profile');
    const unauth = document.getElementById('info-unauth');

    if (!loading || !profile || !unauth) return;

    // Hide everything first
    loading.classList.remove('hidden');
    profile.classList.add('hidden');
    unauth.classList.add('hidden');

    const checkAuthAndRender = () => {
      const currentUser = window.APP_USER;
      if (!currentUser || !currentUser.username) {
        const isLoggedInCookie = document.cookie.includes('txa_gate_passed=true');
        if (!isLoggedInCookie) {
          loading.classList.add('hidden');
          unauth.classList.remove('hidden');
          return;
        }
      }

      const username = currentUser ? currentUser.username : '';
      if (!username) {
        loading.classList.add('hidden');
        unauth.classList.remove('hidden');
        return;
      }

      fetch(`/api/auth/me?username=${encodeURIComponent(username)}`)
        .then(res => res.ok ? res.json() : null)
        .then(async userData => {
          const userDb = userData?.data;

          // Hydrate settings if missing
          if (!window.TXA_SITE_SETTINGS) {
            try {
              const res = await fetch('/api/admin/settings');
              if (res.ok) {
                const result = await res.json();
                window.TXA_SITE_SETTINGS = result?.data || {};
              }
            } catch (e) {
              console.error('Failed to load settings:', e);
            }
          }

          if (userDb) {
            renderProfile(userDb);
          } else {
            renderProfile({
              username: username,
              email: currentUser.email || username,
              name: currentUser.name || username,
              avatar: currentUser.avatar_url || currentUser.avatar || '',
              package: currentUser.package || 'Free',
              createdAt: currentUser.join_date || new Date().toISOString()
            });
          }
        })
        .catch(() => {
          renderProfile({
            username: username,
            email: currentUser.email || username,
            name: currentUser.name || username,
            avatar: currentUser.avatar_url || currentUser.avatar || '',
            package: currentUser.package || 'Free',
            createdAt: currentUser.join_date || new Date().toISOString()
          });
        });
    };

    const renderProfile = (user) => {
      document.getElementById('info-avatar').src = user.avatar_url || user.avatar || '/logo-decoy.png';
      document.getElementById('info-name').textContent = user.name || user.username || 'Thành viên';
      document.getElementById('info-email').textContent = user.email || 'Chưa liên kết';
      
      const pkgBadge = document.getElementById('info-package-badge');
      const pkgVal = document.getElementById('info-package-val');
      const pkgTitle = user.package || 'Free';
      pkgBadge.textContent = pkgTitle;
      pkgVal.textContent = pkgTitle;
      
      const siteSettings = window.TXA_SITE_SETTINGS || {};
      const packagesList = siteSettings.packages || [];
      const userPkg = packagesList.find(p => p.title?.toLowerCase() === pkgTitle.toLowerCase() || p.id?.toLowerCase() === pkgTitle.toLowerCase());
      
      let rightsText = "Xem cơ bản SD, có quảng cáo";
      let userPkgId = 'free';
      if (userPkg) {
        userPkgId = userPkg.id;
        const perms = userPkg.permissions || {};
        const res = perms.max_resolution || 'SD';
        const ads = perms.bypass_ads ? 'Không quảng cáo' : 'Có quảng cáo';
        rightsText = `${ads}, xem ${res}`;
      }
      
      pkgBadge.className = `text-[10px] font-bold px-3 py-1 rounded-full w-max select-none uppercase package-style-${userPkgId} border border-white/5`;
      pkgVal.className = `font-bold text-xs package-style-${userPkgId}`;
      document.getElementById('info-rights-val').textContent = rightsText;

      document.getElementById('info-username-val').textContent = user.username;
      document.getElementById('info-email-val').textContent = user.email || 'N/A';
      
      const date = new Date(user.join_date || user.createdAt || new Date());
      document.getElementById('info-created-val').textContent = date.toLocaleDateString('vi-VN');

      if (window.infoRemainingInterval) {
        clearInterval(window.infoRemainingInterval);
      }

      if (user.expiry_date || user.expiryDate) {
        const expiry = new Date(user.expiry_date || user.expiryDate);
        document.getElementById('info-expiry-val').textContent = expiry.toLocaleDateString('vi-VN');
        
        const remainingContainer = document.getElementById('info-remaining-container');
        const remainingVal = document.getElementById('info-remaining-val');
        
        if (remainingContainer && remainingVal) {
          const updateCountdown = () => {
            const now = Date.now();
            const diffMs = expiry.getTime() - now;
            if (diffMs <= 0) {
              remainingContainer.classList.add('hidden');
              remainingVal.textContent = '';
              if (window.infoRemainingInterval) clearInterval(window.infoRemainingInterval);
              return;
            }

            const diffSec = Math.floor(diffMs / 1000);
            const diffMin = Math.floor(diffSec / 60);
            const diffHour = Math.floor(diffMin / 60);
            const diffDays = Math.floor(diffHour / 24);

            remainingContainer.classList.remove('hidden');
            if (diffDays >= 30) {
              const months = Math.floor(diffDays / 30);
              const remainingDays = diffDays % 30;
              if (remainingDays > 0) {
                remainingVal.textContent = `${months} tháng ${remainingDays} ngày`;
              } else {
                remainingVal.textContent = `${months} tháng`;
              }
            } else {
              const secs = diffSec % 60;
              const mins = diffMin % 60;
              const hours = diffHour % 24;
              const days = diffDays;
              remainingVal.textContent = `${days} ngày ${hours} giờ ${mins} phút ${secs} giây`;
            }
          };
          
          updateCountdown();
          window.infoRemainingInterval = setInterval(updateCountdown, 1000);
        }
      } else {
        document.getElementById('info-expiry-val').textContent = 'Vô thời hạn';
        const remainingContainer = document.getElementById('info-remaining-container');
        if (remainingContainer) {
          remainingContainer.classList.add('hidden');
        }
      }

      // Kiểm tra trạng thái liên kết Discord
      const statusText = document.getElementById('discord-status-text');
      const connectBtn = document.getElementById('btn-discord-connect');
      const disconnectBtn = document.getElementById('btn-discord-disconnect');

      // Hiển thị toast thông báo kết quả callback nếu có
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('discord_success') && !window.discordToastShown) {
        window.discordToastShown = true;
        if (window.showGlobalToast) window.showGlobalToast('Liên kết tài khoản Discord thành công!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
      }
      if (urlParams.has('discord_error') && !window.discordToastShown) {
        window.discordToastShown = true;
        const err = urlParams.get('discord_error');
        let errMsg = 'Liên kết Discord thất bại!';
        if (err === 'discord_already_linked') errMsg = 'Tài khoản Discord này đã liên kết với tài khoản web khác!';
        else if (err === 'user_already_linked') errMsg = 'Tài khoản website của bạn đã liên kết với tài khoản Discord khác!';
        else if (err === 'not_configured') errMsg = 'Chưa cấu hình thông số kết nối Discord trên hệ thống!';
        if (window.showGlobalToast) window.showGlobalToast(errMsg, 'error');
        window.history.replaceState({}, document.title, window.location.pathname);
      }

      if (statusText && connectBtn && disconnectBtn) {
        fetch('/api/discord/connection')
          .then(res => res.ok ? res.json() : null)
          .then(data => {
            if (data && data.status === 'success' && data.data?.connected) {
              const conn = data.data.connection;
              statusText.innerHTML = `Trạng thái: <span class="text-emerald-400 font-bold">Đã liên kết</span> (<span class="font-mono text-zinc-300 font-bold">${conn.username}</span> - <span class="text-zinc-500 font-mono text-[10px]">${conn.discordId}</span>)`;
              connectBtn.classList.add('hidden');
              disconnectBtn.classList.remove('hidden');
            } else {
              statusText.innerHTML = `Trạng thái: <span class="text-amber-500 font-bold">Chưa liên kết</span>`;
              connectBtn.classList.remove('hidden');
              disconnectBtn.classList.add('hidden');
            }
          })
          .catch(() => {
            statusText.innerHTML = `Trạng thái: <span class="text-red-500 font-bold">Lỗi kiểm tra trạng thái</span>`;
            connectBtn.classList.add('hidden');
            disconnectBtn.classList.add('hidden');
          });

        disconnectBtn.onclick = async () => {
          if (!confirm('Bạn có chắc chắn muốn hủy liên kết tài khoản Discord không? Mọi quyền lợi vai trò VIP/Cấp độ trên Server sẽ bị thu hồi.')) return;
          try {
            const res = await fetch('/api/discord/unlink', { method: 'POST' });
            if (res.ok) {
              const result = await res.json();
              if (result.status === 'success') {
                if (window.showGlobalToast) window.showGlobalToast('Đã hủy liên kết Discord thành công!', 'success');
                statusText.innerHTML = `Trạng thái: <span class="text-amber-500 font-bold">Chưa liên kết</span>`;
                connectBtn.classList.remove('hidden');
                disconnectBtn.classList.add('hidden');
              } else {
                throw new Error(result.message || 'Lỗi server');
              }
            } else {
              throw new Error('Lỗi mạng');
            }
          } catch (e) {
            if (window.showGlobalToast) window.showGlobalToast(`Lỗi hủy liên kết: ${e.message}`, 'error');
          }
        };
      }

      loading.classList.add('hidden');
      profile.classList.remove('hidden');
    };

    // Run auth check
    checkAuthAndRender();
    
    // Listen for auth change
    window.addEventListener('auth-changed', checkAuthAndRender);
  });
</script>
