---
import MainLayout from '@layouts/MainLayout.astro';
import { SettingService } from '@services/SettingService';

const settings = await SettingService.getSettings();
---

<MainLayout title={`Thông tin tài khoản | ${settings.general.site_name}`}>
  <main class="max-w-4xl mx-auto px-6 py-24 md:py-32">
    <div class="glass-panel p-8 md:p-12 rounded-[32px] border border-glass-stroke relative overflow-hidden">
      <div class="absolute inset-0 bg-primary/5 blur-[80px] pointer-events-none"></div>
      
      <div class="relative z-10 space-y-6">
        <header class="border-b border-glass-stroke pb-6">
          <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Thông tin tài khoản</h1>
          <p class="text-zinc-500 text-xs font-bold uppercase tracking-wider mt-2 font-label-caps">Quản lý và xem thông tin tài khoản của bạn</p>
        </header>

        <div id="user-info-content" class="space-y-6 text-zinc-300 text-sm">
          <!-- Loading state -->
          <div id="info-loading" class="py-12 flex flex-col items-center justify-center gap-3">
            <div class="w-8 h-8 rounded-full border-2 border-primary border-t-transparent animate-spin"></div>
            <p class="text-zinc-500 text-xs uppercase font-bold tracking-wider">Đang tải thông tin...</p>
          </div>

          <!-- Logged in state -->
          <div id="info-profile" class="hidden space-y-6">
            <div class="flex flex-col sm:flex-row items-center gap-6 p-6 bg-white/[0.02] border border-white/5 rounded-2xl">
              <div class="relative w-24 h-24 rounded-full overflow-hidden border-2 border-primary shadow-lg shadow-primary/20 cursor-pointer group/avatar" id="avatar-container" title="Thay đổi ảnh đại diện">
                <img id="info-avatar" src="/logo-decoy.png" class="w-full h-full object-cover group-hover/avatar:scale-105 transition-transform" onerror="this.src='/logo-decoy.png';" />
                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover/avatar:opacity-100 flex items-center justify-center transition-opacity">
                  <span class="material-symbols-outlined text-white text-lg">photo_camera</span>
                </div>
              </div>
              <input type="file" id="avatar-file-input" accept="image/*" class="hidden" />
              <div class="text-center sm:text-left space-y-2">
                <h2 id="info-name" class="text-xl font-bold text-white"></h2>
                <p id="info-email" class="text-xs text-zinc-400 font-mono"></p>
                <div class="flex flex-wrap gap-2 justify-center sm:justify-start pt-1">
                  <span id="info-package-badge" class="bg-primary/20 text-primary border border-primary/30 rounded-full px-3 py-1 text-[10px] font-bold uppercase"></span>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="p-6 bg-white/[0.01] border border-white/5 rounded-2xl space-y-4">
                <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2 border-b border-white/5 pb-3">
                  <span class="material-symbols-outlined text-primary text-sm">assignment_ind</span> Thông tin cá nhân
                </h3>
                <div class="space-y-3">
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Tên tài khoản:</span>
                    <span id="info-username-val" class="font-bold text-xs text-white"></span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Email liên kết:</span>
                    <span id="info-email-val" class="font-bold text-xs text-white font-mono"></span>
                  </div>
                  <div class="flex justify-between py-1">
                    <span class="text-zinc-500 text-xs">Ngày đăng ký:</span>
                    <span id="info-created-val" class="font-bold text-xs text-white"></span>
                  </div>
                </div>
              </div>

              <div class="p-6 bg-white/[0.01] border border-white/5 rounded-2xl space-y-4">
                <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2 border-b border-white/5 pb-3">
                  <span class="material-symbols-outlined text-primary text-sm">workspace_premium</span> Gói dịch vụ hiện tại
                </h3>
                <div class="space-y-3">
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Tên gói:</span>
                    <span id="info-package-val" class="font-bold text-xs text-primary"></span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Quyền hạn:</span>
                    <span id="info-rights-val" class="font-bold text-xs text-white">Xem cơ bản</span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-white/[0.02]">
                    <span class="text-zinc-500 text-xs">Hạn dùng:</span>
                    <span id="info-expiry-val" class="font-bold text-xs text-zinc-400">Vô thời hạn</span>
                  </div>
                  <div id="info-remaining-container" class="flex justify-between py-1 border-b border-white/[0.02] hidden">
                    <span class="text-zinc-500 text-xs">Còn lại:</span>
                    <span id="info-remaining-val" class="font-bold text-xs text-primary"></span>
                  </div>
                  <div class="pt-2">
                    <a href="/goi-dich-vu" class="w-full flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-primary/20 hover:border-primary/40 bg-primary/5 hover:bg-primary/10 text-primary text-xs font-bold transition-all text-center no-underline cursor-pointer">
                      <span class="material-symbols-outlined text-base">card_membership</span>
                      Quản lý Gói dịch vụ
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Discord Connection Panel -->
            <div id="discord-card" class="p-6 bg-white/[0.01] border border-white/5 rounded-2xl space-y-4">
              <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2 border-b border-white/5 pb-3">
                <span class="material-symbols-outlined text-[#5865F2] text-sm">smart_toy</span> Liên kết Discord Server
              </h3>
              
              <!-- Loading state for Discord connection -->
              <div id="discord-loading" class="py-4 flex items-center justify-center gap-2">
                <div class="w-4 h-4 rounded-full border border-primary border-t-transparent animate-spin"></div>
                <span class="text-xs text-zinc-500 font-bold uppercase tracking-wider text-[10px]">Đang tải...</span>
              </div>

              <!-- Unconnected UI -->
              <div id="discord-unconnected-ui" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="space-y-1 text-left">
                  <p class="text-xs font-semibold text-amber-500 flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">warning</span> Chưa liên kết
                  </p>
                  <p class="text-[10px] text-zinc-500 font-medium">Kết nối tài khoản Discord để tự động đồng bộ vai trò, nhận gói VIP, theo dõi lịch chiếu và tham gia sự kiện trên máy chủ.</p>
                </div>
                <div class="shrink-0">
                  <a href="/connect-discord" class="px-5 py-2 bg-[#5865F2] hover:bg-[#4d5bdf] text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 border-none decoration-none no-underline cursor-pointer active:scale-95">
                    <span class="material-symbols-outlined text-sm">link</span> Liên kết ngay
                  </a>
                </div>
              </div>

              <!-- Connected UI (Premium Discord Card Layout) -->
              <div id="discord-connected-ui" class="hidden flex flex-col gap-4 p-5 bg-[#5865F2]/5 border border-[#5865F2]/20 rounded-xl relative overflow-hidden text-left">
                <div class="absolute right-0 top-0 translate-x-4 -translate-y-4 text-[#5865F2]/5 pointer-events-none select-none z-0">
                  <svg class="w-24 h-24" viewBox="0 0 127.14 96.36" fill="currentColor">
                    <path d="M107.7,8.07A105.15,105.15,0,0,0,77.26,0a77.19,77.19,0,0,0-3.3,6.83A96.67,96.67,0,0,0,53.22,6.83,77.19,77.19,0,0,0,49.88,0,105.15,105.15,0,0,0,19.44,8.07C-3.66,42.2-9.19,75.39,7.74,95.54a105.74,105.74,0,0,0,32,16.19,79,79,0,0,0,6.72-10.93,68.6,68.6,0,0,1-10.59-5.07c.9-.66,1.76-1.37,2.58-2.1a68.21,68.21,0,0,0,79.8,0c.82.73,1.68,1.44,2.58,2.1a68.86,68.86,0,0,1-10.59,5.07,79.08,79.08,0,0,0,6.72,10.93,105.74,105.74,0,0,0,32-16.19C136.33,75.39,130.8,42.2,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53S36.18,40.36,42.45,40.36,53.9,46,53.9,53,48.72,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.24,60,73.24,53S78.41,40.36,84.69,40.36,96.14,46,96.14,53,91,65.69,84.69,65.69Z"/>
                  </svg>
                </div>
                
                <!-- Top Row: Avatar, Info, Status & Disconnect Button -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 z-10 w-full">
                  <div class="flex items-center gap-3.5 w-full sm:w-auto">
                    <div class="relative w-12 h-12 rounded-full overflow-hidden border border-[#5865F2]/30 shadow-md shadow-[#5865F2]/10 bg-zinc-800 shrink-0">
                      <img id="discord-user-avatar" src="" class="w-full h-full object-cover" />
                    </div>
                    <div class="text-left space-y-0.5">
                      <div class="flex flex-wrap items-center gap-2">
                        <span id="discord-user-name" class="font-bold text-white text-sm"></span>
                        <span id="discord-user-level-badge" class="bg-zinc-500/10 text-zinc-400 border border-zinc-500/20 rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider select-none">Mầm Non</span>
                        <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider flex items-center gap-1 select-none w-max">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                          Đã liên kết
                        </span>
                      </div>
                      <p class="text-zinc-400 text-xs font-mono">ID: <span id="discord-user-id" class="text-zinc-500"></span></p>
                    </div>
                  </div>
                  <div class="shrink-0 w-full sm:w-auto text-right mt-2 sm:mt-0">
                    <button type="button" id="btn-discord-disconnect" class="w-full sm:w-auto px-4 py-2 bg-red-500/10 border border-red-500/20 text-red-400 rounded-xl text-xs font-bold hover:bg-red-500/20 active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer border-none">
                      <span class="material-symbols-outlined text-sm">link_off</span> Hủy liên kết
                    </button>
                  </div>
                </div>

                <!-- Bottom Row: Activity Stats Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mt-2 pt-3 border-t border-white/5 w-full z-10">
                  <div class="bg-white/[0.02] border border-white/5 rounded-xl p-2.5 text-center">
                    <p class="text-[9px] text-zinc-500 font-bold uppercase tracking-wider">Thời gian xem</p>
                    <p id="discord-stat-watch" class="text-xs font-bold text-white mt-0.5">-</p>
                  </div>
                  <div class="bg-white/[0.02] border border-white/5 rounded-xl p-2.5 text-center">
                    <p class="text-[9px] text-zinc-500 font-bold uppercase tracking-wider">Đánh giá phim</p>
                    <p id="discord-stat-ratings" class="text-xs font-bold text-white mt-0.5">-</p>
                  </div>
                  <div class="bg-white/[0.02] border border-white/5 rounded-xl p-2.5 text-center">
                    <p class="text-[9px] text-zinc-500 font-bold uppercase tracking-wider">Bình luận</p>
                    <p id="discord-stat-comments" class="text-xs font-bold text-white mt-0.5">-</p>
                  </div>
                  <div class="bg-white/[0.02] border border-white/5 rounded-xl p-2.5 text-center">
                    <p class="text-[9px] text-zinc-500 font-bold uppercase tracking-wider">Yêu thích</p>
                    <p id="discord-stat-favorites" class="text-xs font-bold text-white mt-0.5">-</p>
                  </div>
                  <div class="bg-white/[0.02] border border-white/5 rounded-xl p-2.5 text-center">
                    <p class="text-[9px] text-zinc-500 font-bold uppercase tracking-wider">Chat Discord</p>
                    <p id="discord-stat-chat" class="text-xs font-bold text-white mt-0.5">-</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Centered Logout Button -->
            <div class="flex justify-center pt-6">
              <button 
                onclick="logout()" 
                class="px-8 py-3 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 hover:border-red-500/50 text-red-400 rounded-xl text-xs font-bold hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer border-none flex items-center gap-2"
              >
                <span class="material-symbols-outlined text-[18px]">logout</span>
                Đăng xuất tài khoản
              </button>
            </div>
          </div>

          <!-- Unauthenticated state -->
          <div id="info-unauth" class="hidden py-12 flex flex-col items-center justify-center text-center gap-4">
            <span class="material-symbols-outlined text-5xl text-zinc-600">no_accounts</span>
            <div>
              <h3 class="text-base font-bold text-white">Bạn chưa đăng nhập</h3>
              <p class="text-xs text-zinc-500 mt-1 max-w-xs">Vui lòng đăng nhập tài khoản để xem thông tin chi tiết của bạn.</p>
            </div>
            <button onclick="window.showAuthModal ? window.showAuthModal('login') : alert('Vui lòng click đăng nhập ở góc phải màn hình!')" class="px-6 py-2.5 bg-primary text-slate-950 rounded-xl text-xs font-bold hover:brightness-110 active:scale-95 transition-all cursor-pointer border-none flex items-center gap-1.5 shadow-lg shadow-primary/20">
              <span class="material-symbols-outlined text-sm">login</span> Đăng nhập ngay
            </button>
          </div>
        </div>
      </div>
    </div>
    <!-- Crop Modal Markup -->
    <div id="crop-modal" class="fixed inset-0 z-[10000] hidden items-center justify-center p-4 bg-black/90 backdrop-blur-md">
      <div class="relative max-w-sm w-full bg-zinc-950 border border-glass-stroke rounded-3xl p-6 shadow-2xl space-y-4">
        <h3 class="text-base font-bold text-white text-center">Cắt ảnh đại diện</h3>
        <p class="text-[10px] text-zinc-400 text-center">Kéo để di chuyển, cuộn chuột hoặc dùng 2 ngón để phóng to/thu nhỏ ảnh.</p>
        
        <div class="relative w-full aspect-square bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden flex items-center justify-center cursor-move" id="crop-area">
          <canvas id="crop-canvas" class="absolute"></canvas>
        </div>
        
        <div class="flex flex-col gap-1.5 pt-2">
          <div class="flex justify-between items-center text-[10px] text-zinc-400 font-bold uppercase">
            <span>Thu phóng ảnh</span>
            <span id="zoom-percentage">100%</span>
          </div>
          <input type="range" id="crop-zoom-slider" min="10" max="400" value="100" class="w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-primary" />
        </div>
        
        <div class="flex gap-3 justify-end pt-2">
          <button type="button" id="btn-cancel-crop" class="px-4 py-2 bg-white/5 border border-glass-stroke text-zinc-400 font-bold rounded-xl text-xs hover:bg-white/10 transition-all cursor-pointer">Hủy</button>
          <button type="button" id="btn-confirm-crop" class="px-5 py-2 bg-primary text-slate-950 font-black rounded-xl text-xs hover:brightness-110 active:scale-95 transition-all cursor-pointer border-none shadow-lg shadow-primary/20">Cắt & Lưu</button>
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const loading = document.getElementById('info-loading');
    const profile = document.getElementById('info-profile');
    const unauth = document.getElementById('info-unauth');

    if (!loading || !profile || !unauth) return;

    // Hide everything first
    loading.classList.remove('hidden');
    profile.classList.add('hidden');
    unauth.classList.add('hidden');

    const checkAuthAndRender = () => {
      const currentUser = window.APP_USER;
      if (!currentUser || !currentUser.username) {
        const isLoggedInCookie = document.cookie.includes('txa_gate_passed=true');
        if (!isLoggedInCookie) {
          loading.classList.add('hidden');
          unauth.classList.remove('hidden');
          return;
        }
      }

      const username = currentUser ? currentUser.username : '';
      if (!username) {
        loading.classList.add('hidden');
        unauth.classList.remove('hidden');
        return;
      }

      fetch(`/api/auth/me?username=${encodeURIComponent(username)}`)
        .then(res => res.ok ? res.json() : null)
        .then(async userData => {
          const userDb = userData?.data;

          // Hydrate settings if missing
          if (!window.TXA_SITE_SETTINGS) {
            try {
              const res = await fetch('/api/admin/settings');
              if (res.ok) {
                const result = await res.json();
                window.TXA_SITE_SETTINGS = result?.data || {};
              }
            } catch (e) {
              console.error('Failed to load settings:', e);
            }
          }

          if (userDb) {
            renderProfile(userDb);
          } else {
            renderProfile({
              username: username,
              email: currentUser.email || username,
              name: currentUser.name || username,
              avatar: currentUser.avatar_url || currentUser.avatar || '',
              package: currentUser.package || 'Free',
              createdAt: currentUser.join_date || new Date().toISOString()
            });
          }
        })
        .catch(() => {
          renderProfile({
            username: username,
            email: currentUser.email || username,
            name: currentUser.name || username,
            avatar: currentUser.avatar_url || currentUser.avatar || '',
            package: currentUser.package || 'Free',
            createdAt: currentUser.join_date || new Date().toISOString()
          });
        });
    };

    const renderProfile = (user) => {
      document.getElementById('info-avatar').src = user.avatar_url || user.avatar || '/logo-decoy.png';
      document.getElementById('info-name').textContent = user.name || user.username || 'Thành viên';
      document.getElementById('info-email').textContent = user.email || 'Chưa liên kết';
      
      const pkgBadge = document.getElementById('info-package-badge');
      const pkgVal = document.getElementById('info-package-val');
      const pkgTitle = user.package || 'Free';
      pkgBadge.textContent = pkgTitle;
      pkgVal.textContent = pkgTitle;
      
      const siteSettings = window.TXA_SITE_SETTINGS || {};
      const packagesList = siteSettings.packages || [];
      const userPkg = packagesList.find(p => p.title?.toLowerCase() === pkgTitle.toLowerCase() || p.id?.toLowerCase() === pkgTitle.toLowerCase());
      
      let rightsText = "Xem cơ bản SD, có quảng cáo";
      let userPkgId = 'free';
      if (userPkg) {
        userPkgId = userPkg.id;
        const perms = userPkg.permissions || {};
        const res = perms.max_resolution || 'SD';
        const ads = perms.bypass_ads ? 'Không quảng cáo' : 'Có quảng cáo';
        rightsText = `${ads}, xem ${res}`;
      }
      
      pkgBadge.className = `text-[10px] font-bold px-3 py-1 rounded-full w-max select-none uppercase package-style-${userPkgId} border border-white/5`;
      pkgVal.className = `font-bold text-xs package-style-${userPkgId}`;
      document.getElementById('info-rights-val').textContent = rightsText;

      document.getElementById('info-username-val').textContent = user.username;
      document.getElementById('info-email-val').textContent = user.email || 'N/A';
      
      const date = new Date(user.join_date || user.createdAt || new Date());
      document.getElementById('info-created-val').textContent = date.toLocaleDateString('vi-VN');

      if (window.infoRemainingInterval) {
        clearInterval(window.infoRemainingInterval);
      }

      if (user.expiry_date || user.expiryDate) {
        const expiry = new Date(user.expiry_date || user.expiryDate);
        document.getElementById('info-expiry-val').textContent = expiry.toLocaleDateString('vi-VN');
        
        const remainingContainer = document.getElementById('info-remaining-container');
        const remainingVal = document.getElementById('info-remaining-val');
        
        if (remainingContainer && remainingVal) {
          const updateCountdown = () => {
            const now = Date.now();
            const diffMs = expiry.getTime() - now;
            if (diffMs <= 0) {
              remainingContainer.classList.add('hidden');
              remainingVal.textContent = '';
              if (window.infoRemainingInterval) clearInterval(window.infoRemainingInterval);
              return;
            }

            const diffSec = Math.floor(diffMs / 1000);
            const diffMin = Math.floor(diffSec / 60);
            const diffHour = Math.floor(diffMin / 60);
            const diffDays = Math.floor(diffHour / 24);

            remainingContainer.classList.remove('hidden');
            if (diffDays >= 30) {
              const months = Math.floor(diffDays / 30);
              const remainingDays = diffDays % 30;
              if (remainingDays > 0) {
                remainingVal.textContent = `${months} tháng ${remainingDays} ngày`;
              } else {
                remainingVal.textContent = `${months} tháng`;
              }
            } else {
              const secs = diffSec % 60;
              const mins = diffMin % 60;
              const hours = diffHour % 24;
              const days = diffDays;
              remainingVal.textContent = `${days} ngày ${hours} giờ ${mins} phút ${secs} giây`;
            }
          };
          
          updateCountdown();
          window.infoRemainingInterval = setInterval(updateCountdown, 1000);
        }
      } else {
        document.getElementById('info-expiry-val').textContent = 'Vô thời hạn';
        const remainingContainer = document.getElementById('info-remaining-container');
        if (remainingContainer) {
          remainingContainer.classList.add('hidden');
        }
      }

      // Kiểm tra trạng thái liên kết Discord
      const discordLoading = document.getElementById('discord-loading');
      const unconnectedUi = document.getElementById('discord-unconnected-ui');
      const connectedUi = document.getElementById('discord-connected-ui');
      const userAvatar = document.getElementById('discord-user-avatar');
      const userName = document.getElementById('discord-user-name');
      const userId = document.getElementById('discord-user-id');
      const disconnectBtn = document.getElementById('btn-discord-disconnect');

      // Hiển thị toast thông báo kết quả callback nếu có
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('discord_success') && !window.discordToastShown) {
        window.discordToastShown = true;
        if (window.showGlobalToast) window.showGlobalToast('Liên kết tài khoản Discord thành công!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
      }
      if (urlParams.has('discord_error') && !window.discordToastShown) {
        window.discordToastShown = true;
        const err = urlParams.get('discord_error');
        let errMsg = 'Liên kết Discord thất bại!';
        if (err === 'discord_already_linked') errMsg = 'Tài khoản Discord này đã liên kết với tài khoản web khác!';
        else if (err === 'user_already_linked') errMsg = 'Tài khoản website của bạn đã liên kết với tài khoản Discord khác!';
        else if (err === 'not_configured') errMsg = 'Chưa cấu hình thông số kết nối Discord trên hệ thống!';
        if (window.showGlobalToast) window.showGlobalToast(errMsg, 'error');
        window.history.replaceState({}, document.title, window.location.pathname);
      }

      // Hide panels initially, show loading
      if (discordLoading) discordLoading.classList.remove('hidden');
      if (unconnectedUi) unconnectedUi.classList.add('hidden');
      if (connectedUi) connectedUi.classList.add('hidden');

      if (discordLoading && unconnectedUi && connectedUi) {
        fetch('/api/discord/connection')
          .then(res => res.ok ? res.json() : null)
          .then(data => {
            discordLoading.classList.add('hidden');
            if (data && data.status === 'success' && data.data?.connected) {
              const conn = data.data.connection;
              if (userName) userName.textContent = conn.username || 'Discord User';
              if (userId) userId.textContent = conn.discordId || 'N/A';
              
              // Set level badge
              const userLevelBadge = document.getElementById('discord-user-level-badge');
              if (userLevelBadge) {
                userLevelBadge.textContent = conn.level || 'Mầm Non';
                if (conn.level === 'Trưởng Lão Cinephile') {
                  userLevelBadge.className = 'bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider select-none';
                } else if (conn.level === 'Cuồng Phim') {
                  userLevelBadge.className = 'bg-purple-500/10 text-purple-400 border border-purple-500/20 rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider select-none';
                } else if (conn.level === 'Mọt Phim') {
                  userLevelBadge.className = 'bg-blue-500/10 text-blue-400 border border-blue-500/20 rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider select-none';
                } else {
                  userLevelBadge.className = 'bg-zinc-500/10 text-zinc-400 border border-zinc-500/20 rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider select-none';
                }
              }

              // Set stats
              const statWatch = document.getElementById('discord-stat-watch');
              const statRatings = document.getElementById('discord-stat-ratings');
              const statComments = document.getElementById('discord-stat-comments');
              const statFavorites = document.getElementById('discord-stat-favorites');
              const statChat = document.getElementById('discord-stat-chat');

              if (statWatch) {
                const totalSeconds = conn.watchTime || 0;
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                if (hours > 0) {
                  statWatch.textContent = `${hours}h ${minutes}m`;
                } else {
                  statWatch.textContent = `${minutes}m`;
                }
              }
              if (statRatings) statRatings.textContent = `${conn.ratingsCount || 0} phim`;
              if (statComments) statComments.textContent = `${conn.commentsCount || 0} lượt`;
              if (statFavorites) statFavorites.textContent = `${conn.favoritesCount || 0} phim`;
              if (statChat) statChat.textContent = `${conn.discordMessageCount || 0} tin`;
              
              // Set avatar URL
              if (userAvatar) {
                if (conn.avatar) {
                  userAvatar.src = `https://cdn.discordapp.com/avatars/${conn.discordId}/${conn.avatar}.png`;
                } else {
                  // Fallback to default Discord avatar (based on discordId modulo 5)
                  const defaultAvatarIndex = conn.discordId ? Number(BigInt(conn.discordId) % 5n) : 0;
                  userAvatar.src = `https://cdn.discordapp.com/embed/avatars/${defaultAvatarIndex}.png`;
                }
                userAvatar.onerror = function() {
                  this.src = 'https://cdn.discordapp.com/embed/avatars/0.png';
                };
              }
              
              connectedUi.classList.remove('hidden');
              unconnectedUi.classList.add('hidden');
            } else {
              connectedUi.classList.add('hidden');
              unconnectedUi.classList.remove('hidden');
            }
          })
          .catch(() => {
            if (discordLoading) discordLoading.classList.add('hidden');
            if (unconnectedUi) unconnectedUi.classList.remove('hidden');
            if (connectedUi) connectedUi.classList.add('hidden');
          });

        if (disconnectBtn) {
          disconnectBtn.onclick = async () => {
            if (!confirm('Bạn có chắc chắn muốn hủy liên kết tài khoản Discord không? Mọi quyền lợi vai trò VIP/Cấp độ trên Server sẽ bị thu hồi.')) return;
            try {
              const res = await fetch('/api/discord/unlink', { method: 'POST' });
              if (res.ok) {
                const result = await res.json();
                if (result.status === 'success') {
                  if (window.showGlobalToast) window.showGlobalToast('Đã hủy liên kết Discord thành công!', 'success');
                  connectedUi.classList.add('hidden');
                  unconnectedUi.classList.remove('hidden');
                } else {
                  throw new Error(result.message || 'Lỗi server');
                }
              } else {
                throw new Error('Lỗi mạng');
              }
            } catch (e) {
              if (window.showGlobalToast) window.showGlobalToast(`Lỗi hủy liên kết: ${e.message}`, 'error');
            }
          };
        }
      }

      loading.classList.add('hidden');
      profile.classList.remove('hidden');
    };

    // Run auth check
    checkAuthAndRender();
    
    // Listen for auth change
    window.addEventListener('auth-changed', checkAuthAndRender);

    // === AVATAR CROP AND UPLOAD FUNCTIONALITY ===
    const avatarContainer = document.getElementById('avatar-container');
    const avatarInput = document.getElementById('avatar-file-input');
    const cropModal = document.getElementById('crop-modal');
    const cropArea = document.getElementById('crop-area');
    const cropCanvas = document.getElementById('crop-canvas');
    const btnCancel = document.getElementById('btn-cancel-crop');
    const btnConfirm = document.getElementById('btn-confirm-crop');
    const zoomSlider = document.getElementById('crop-zoom-slider');
    const zoomText = document.getElementById('zoom-percentage');
    
    if (avatarContainer && avatarInput && cropModal && cropArea && cropCanvas && btnCancel && btnConfirm && zoomSlider && zoomText) {
      let originalImg = null;
      let scale = 1.0;
      let baseScale = 1.0; // The scale where the image fits the crop view
      let posX = 0;
      let posY = 0;
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let initialTouchDist = 0;
      let initialTouchScale = 1.0;
      const ctx = cropCanvas.getContext('2d');
      const viewSize = 320; // 320x320 area
      const circleRadius = 112; // Radius 112 (Diameter 224)
      
      cropCanvas.width = viewSize;
      cropCanvas.height = viewSize;

      avatarContainer.onclick = () => {
        avatarInput.click();
      };

      avatarInput.onchange = (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            // Always show cropping modal for better UX
            originalImg = img;
            baseScale = Math.max(viewSize / img.width, viewSize / img.height);
            scale = baseScale;
            posX = 0;
            posY = 0;
            zoomSlider.value = 100;
            zoomText.textContent = '100%';
            cropModal.classList.remove('hidden');
            cropModal.classList.add('flex');
            drawCrop();
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
      };

      const drawCrop = () => {
        if (!originalImg) return;
        ctx.clearRect(0, 0, viewSize, viewSize);
        
        // 1. Draw image
        const w = originalImg.width * scale;
        const h = originalImg.height * scale;
        const drawX = (viewSize - w) / 2 + posX;
        const drawY = (viewSize - h) / 2 + posY;
        ctx.drawImage(originalImg, drawX, drawY, w, h);
        
        // 2. Draw Dark Overlay with Circular Cutout
        ctx.save();
        ctx.fillStyle = 'rgba(9, 9, 11, 0.7)';
        ctx.beginPath();
        ctx.rect(0, 0, viewSize, viewSize);
        ctx.arc(viewSize / 2, viewSize / 2, circleRadius, 0, Math.PI * 2, true);
        ctx.fill();
        ctx.restore();
        
        // 3. Draw Dashed Circular Border Guide
        ctx.save();
        ctx.strokeStyle = '#a855f7'; // purple-500
        ctx.lineWidth = 2;
        ctx.setLineDash([5, 5]);
        ctx.beginPath();
        ctx.arc(viewSize / 2, viewSize / 2, circleRadius, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      };

      const updateZoom = (newScale) => {
        scale = Math.max(baseScale * 0.1, Math.min(baseScale * 8.0, newScale));
        const percent = Math.round((scale / baseScale) * 100);
        zoomSlider.value = percent;
        zoomText.textContent = `${percent}%`;
        drawCrop();
      };

      // Zoom via Slider
      zoomSlider.oninput = (e) => {
        const percent = parseInt(e.target.value);
        scale = baseScale * (percent / 100);
        zoomText.textContent = `${percent}%`;
        drawCrop();
      };

      // Drag events (Mouse)
      cropArea.onmousedown = (e) => {
        if (!originalImg) return;
        isDragging = true;
        startX = e.clientX - posX;
        startY = e.clientY - posY;
      };

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });

      cropArea.onmousemove = (e) => {
        if (!isDragging || !originalImg) return;
        posX = e.clientX - startX;
        posY = e.clientY - startY;
        drawCrop();
      };

      // Touch events (Mobile support - Single touch drag, Multi-touch pinch zoom)
      cropArea.ontouchstart = (e) => {
        if (!originalImg) return;
        isDragging = true;
        
        if (e.touches.length === 1) {
          const touch = e.touches[0];
          startX = touch.clientX - posX;
          startY = touch.clientY - posY;
        } else if (e.touches.length === 2) {
          // Setup pinch zoom
          initialTouchDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          initialTouchScale = scale;
        }
      };

      cropArea.ontouchmove = (e) => {
        if (!originalImg) return;
        
        if (e.touches.length === 1 && isDragging) {
          const touch = e.touches[0];
          posX = touch.clientX - startX;
          posY = touch.clientY - startY;
          drawCrop();
        } else if (e.touches.length === 2) {
          e.preventDefault();
          const dist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          const factor = dist / initialTouchDist;
          updateZoom(initialTouchScale * factor);
        }
      };

      cropArea.ontouchend = () => {
        isDragging = false;
      };

      // Zoom via Mouse Wheel
      cropArea.onwheel = (e) => {
        if (!originalImg) return;
        e.preventDefault();
        const zoomFactor = 0.05;
        if (e.deltaY < 0) {
          updateZoom(scale + baseScale * zoomFactor);
        } else {
          updateZoom(scale - baseScale * zoomFactor);
        }
      };

      btnCancel.onclick = () => {
        cropModal.classList.remove('flex');
        cropModal.classList.add('hidden');
        avatarInput.value = '';
      };

      btnConfirm.onclick = () => {
        if (!originalImg) return;
        
        // Exact high-quality crop from originalImg using mathematical calculation
        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = 256;
        exportCanvas.height = 256;
        const exportCtx = exportCanvas.getContext('2d');
        
        // View center in view coordinates
        const viewCenter = viewSize / 2;
        
        // Offset of image relative to circle center (which is at viewCenter)
        // Image center is at (viewCenter + posX, viewCenter + posY)
        // Crop circle bounds: [viewCenter - circleRadius, viewCenter - circleRadius, circleRadius*2, circleRadius*2]
        
        // Position of image top-left relative to crop view
        const imgLeft = viewCenter + posX - (originalImg.width * scale) / 2;
        const imgTop = viewCenter + posY - (originalImg.height * scale) / 2;
        
        // Boundaries of crop circle
        const cropLeft = viewCenter - circleRadius;
        const cropTop = viewCenter - circleRadius;
        
        // Source coordinates in the original image coordinate space
        const srcScale = 1.0 / scale;
        const srcX = (cropLeft - imgLeft) * srcScale;
        const srcY = (cropTop - imgTop) * srcScale;
        const srcW = (circleRadius * 2) * srcScale;
        const srcH = (circleRadius * 2) * srcScale;
        
        exportCtx.drawImage(
          originalImg,
          srcX, srcY, srcW, srcH,
          0, 0, 256, 256
        );
        
        const base64Data = exportCanvas.toDataURL('image/jpeg', 0.85);
        
        cropModal.classList.remove('flex');
        cropModal.classList.add('hidden');
        uploadAvatar(base64Data);
      };

      async function uploadAvatar(base64Data) {
        try {
          if (window.showGlobalToast) window.showGlobalToast('Đang tải ảnh lên...', 'info');
          
          const res = await fetch('/api/user/update-avatar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ avatar: base64Data })
          });
          
          const data = await res.json();
          if (res.ok && data?.status === 'success') {
            if (window.showGlobalToast) window.showGlobalToast('Cập nhật ảnh đại diện thành công!', 'success');
            document.getElementById('info-avatar').src = base64Data;
            
            // Sync with current user state
            if (window.APP_USER) {
              window.APP_USER.avatar_url = base64Data;
            }
            if (window.updateHeaderAvatar) {
              window.updateHeaderAvatar(base64Data);
            }
          } else {
            const errMsg = data?.message || 'Không thể cập nhật ảnh đại diện!';
            if (window.showGlobalToast) {
              window.showGlobalToast(errMsg, 'error', 4000);
            } else {
              alert(errMsg);
            }
          }
        } catch (err) {
          console.error(err);
          if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối mạng!', 'error');
        }
      }
    }
  });
</script>
