---
import MainLayout from '../layouts/MainLayout.astro';
import { SettingService } from '../services/SettingService';
import { getPackageIdByTitle } from '../lib/utils';

const settings = await SettingService.getSettings();
const packages = settings.packages || [];

const getDynamicFeaturesObj = (pkg: any) => {
  const p = pkg.permissions || {};
  return [
    { text: `Chất lượng video: ${p.max_resolution || 'SD'}`, status: p.max_resolution === '4K' || p.max_resolution === 'FHD' ? 'success' : 'info' },
    { text: p.bypass_ads ? 'Bỏ qua quảng cáo hoàn toàn' : 'Xem kèm quảng cáo ngẫu nhiên', status: p.bypass_ads ? 'success' : 'warning' },
    { text: `Yêu thích tối đa: ${p.max_playlists || 0} phim`, status: p.max_playlists >= 100 ? 'success' : 'info' },
    { text: p.watch_together ? 'Hỗ trợ tính năng Xem Chung' : 'Không hỗ trợ Xem Chung', status: p.watch_together ? 'success' : 'fail' },
    { text: p.hide_watermark ? 'Không chứa Watermark ẩn' : 'Hiển thị Watermark ẩn', status: p.hide_watermark ? 'success' : 'fail' },
    { text: p.vip_badge ? 'Huy hiệu VIP độc quyền' : 'Không có huy hiệu VIP', status: p.vip_badge ? 'success' : 'fail' },
    { text: `Server phát: ${p.allowed_servers?.length || 0} server hệ thống`, status: p.allowed_servers?.length > 3 ? 'success' : 'info' }
  ];
};

const getNormalizedTitle = (title: string) => {
  return title.replace(/\b(1|12)?\s*(Tháng|Năm|Month|Year|Hàng Tháng|Hàng Năm|Hàng Tuần|Tuần|Hàng Ngày|Ngày|Hàng Quý|Quý|Monthly|Annual|Weekly|Daily|Quarterly|Lifetime)\b/gi, '').trim();
};

const groupedPackages: any[] = [];

// Trước tiên, đưa các gói có cycle "lifetime" hoặc "free" vào groupedPackages
packages.forEach((pkg: any) => {
  if (pkg.cycle === 'lifetime' || pkg.cycle === 'free' || pkg.id === 'free') {
    groupedPackages.push({
      ...pkg,
      normalizedTitle: pkg.title,
      monthlyPrice: pkg.price,
      monthlyId: pkg.id
    });
  }
});

// Duyệt qua các gói có cycle "monthly"
packages.forEach((monthlyPkg: any) => {
  if (monthlyPkg.cycle === 'monthly') {
    const normTitle = getNormalizedTitle(monthlyPkg.title);
    
    // Tìm gói annual tương ứng
    const annualPkg = packages.find((p: any) => 
      p.cycle === 'annual' && getNormalizedTitle(p.title) === normTitle
    );
    
    let savingPercent = 0;
    let originalAnnualPrice = monthlyPkg.price * 12;
    if (annualPkg && annualPkg.price < originalAnnualPrice) {
      savingPercent = Math.round((1 - annualPkg.price / originalAnnualPrice) * 100);
    }
    
    groupedPackages.push({
      ...monthlyPkg,
      title: normTitle,
      normalizedTitle: normTitle,
      monthlyPrice: monthlyPkg.price,
      monthlyId: monthlyPkg.id,
      annualPrice: annualPkg ? annualPkg.price : undefined,
      annualId: annualPkg ? annualPkg.id : undefined,
      savingPercent: savingPercent > 0 ? savingPercent : undefined,
      originalAnnualPrice: originalAnnualPrice
    });
  }
});
---

<MainLayout title="Nâng cấp tài khoản VIP">
  <main class="max-w-container-max mx-auto px-gutter py-section-gap pt-24 space-y-12 min-h-[80vh]">
    
    <!-- Header Section -->
    <div class="text-center space-y-4 max-w-2xl mx-auto">
      <span class="px-3 py-1 bg-primary/10 text-primary border border-primary/20 rounded-full text-[10px] font-black uppercase tracking-widest">PREMIUM MEMBERSHIP</span>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight">Kích hoạt trải nghiệm điện ảnh VIP</h1>
      <p class="text-sm text-zinc-400 font-body-main leading-relaxed">Xem phim không giới hạn, hình ảnh Ultra HD 4K sắc nét và không bao giờ bị quảng cáo làm phiền.</p>
    </div>

    <!-- Guest view (Requires login) -->
    <div class="auth-guest flex flex-col items-center justify-center text-center shadow-2xl glass-panel border border-glass-stroke rounded-3xl p-12 max-w-xl mx-auto">
      <div class="w-20 h-20 rounded-full bg-primary/10 flex items-center justify-center mb-6 border border-primary/20">
        <span class="material-symbols-outlined text-primary text-4xl">lock</span>
      </div>
      <h2 class="text-2xl text-white font-title-md mb-2">Đăng nhập tài khoản</h2>
      <p class="text-on-surface-variant max-w-md mx-auto mb-8 font-body-main">Vui lòng đăng nhập để nâng cấp hoặc gia hạn gói cước thành viên VIP của bạn.</p>
      <button onclick="window.dispatchEvent(new Event('open-login-modal'))" class="px-8 py-3 rounded-full text-white font-bold bg-gradient-to-br from-primary-container to-secondary-container shadow-lg hover:brightness-110 transition-all cursor-pointer">
        Đăng nhập ngay
      </button>
    </div>

    <!-- User View (Logged In) -->
    <div class="auth-user hidden space-y-12">
      
      <!-- Billing Cycle Toggle -->
      <div class="flex items-center justify-center gap-4">
        <span class="text-xs text-zinc-400 font-bold" id="label-monthly">Thanh toán Hàng tháng</span>
        <button id="billing-toggle-btn" class="w-14 h-8 bg-zinc-800 rounded-full p-1 relative transition-colors duration-300 focus:outline-none cursor-pointer">
          <div class="w-6 h-6 bg-primary rounded-full absolute left-1 top-1 transition-transform duration-300 shadow-md shadow-primary/45" id="billing-dot"></div>
        </button>
        <span class="text-xs text-zinc-300 font-bold flex items-center gap-1.5" id="label-annual">
          Thanh toán Hàng năm
          <span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded font-black text-[9px] uppercase tracking-wider font-label-caps">-15% Tiết kiệm</span>
        </span>
      </div>

      <!-- Tailwind Safelist: grid-cols-1 md:grid-cols-1 md:grid-cols-2 md:grid-cols-3 md:grid-cols-4 max-w-md max-w-3xl max-w-5xl max-w-6xl hidden -->

      <!-- Current Package Display -->
      <div class="auth-user hidden text-center px-4 py-2 bg-white/5 border border-glass-stroke/50 rounded-2xl max-w-xs mx-auto mb-8">
        <p class="text-xs text-zinc-400 font-body-main">
          Gói hiện tại của bạn: <em id="current-user-package-display" class="font-bold not-italic">-</em>
        </p>
      </div>

      <!-- Plan Selection Bento Grid -->
      <div 
        id="plans-container" 
        class={`grid grid-cols-1 gap-8 mx-auto ${
          groupedPackages.length === 1 ? 'max-w-md md:grid-cols-1' :
          groupedPackages.length === 2 ? 'max-w-3xl md:grid-cols-2' :
          groupedPackages.length === 3 ? 'max-w-5xl md:grid-cols-3' :
          'max-w-6xl md:grid-cols-3 lg:grid-cols-4'
        }`}
      >
        {groupedPackages.map((pkg) => {
          const isFree = pkg.id === 'free';
          const cardBorderClass = `package-border-${pkg.id}`;
          const cardGlowClass = `package-glow-${pkg.id}`;
          const textClass = `package-style-${pkg.id}`;
          const btnClass = isFree ? 'bg-white/5 text-zinc-400 cursor-not-allowed border-glass-stroke' : `package-btn-${pkg.id} hover:brightness-110 active:scale-95 shadow-lg`;
          const btnText = isFree ? 'Gói cước mặc định' : 'Nâng cấp gói ngay';
          
          return (
            <div 
              class={`glass-panel border rounded-3xl p-8 relative flex flex-col justify-between min-h-[380px] ${cardBorderClass} ${cardGlowClass} transition-all duration-300`} 
              id={`plan-card-${pkg.id}`}
              data-id={pkg.id}
              data-monthly-id={pkg.monthlyId}
              data-monthly-price={pkg.monthlyPrice}
              data-monthly-title={`${pkg.title} 1 Tháng`}
              data-annual-id={pkg.annualId || ''}
              data-annual-price={pkg.annualPrice || ''}
              data-annual-title={`${pkg.title} 1 Năm`}
              data-cycle={pkg.cycle}
              data-has-annual={pkg.annualPrice ? 'true' : 'false'}
              data-saving-percent={pkg.savingPercent || '0'}
              data-original-annual-price={pkg.originalAnnualPrice || '0'}
            >
              {!isFree && pkg.style_type === 'rainbow_effect' && (
                <div class="absolute top-0 right-0 overflow-hidden rounded-tr-3xl">
                  <div class="bg-gradient-to-r from-red-500 via-green-500 to-blue-500 text-black px-6 py-1 rotate-45 translate-x-6 translate-y-3 text-[9px] font-black uppercase tracking-wider font-label-caps shadow-md animate-pulse">
                    HOT
                  </div>
                </div>
              )}
              
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-[10px] text-zinc-500 font-bold uppercase tracking-widest block">
                    {isFree ? 'GÓI CƠ BẢN' : 'GÓI NÂNG CẤP'}
                  </span>
                  {!isFree && pkg.savingPercent && (
                    <span class="saving-badge hidden px-2 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded font-black text-[9px] uppercase tracking-wider font-label-caps">
                      Tiết kiệm {pkg.savingPercent}%
                    </span>
                  )}
                </div>
                <h3 class={`text-2xl font-black mt-1 ${textClass}`}>
                  {pkg.title}
                </h3>
                
                <div class="mt-6 flex flex-col">
                  <div class="flex items-baseline gap-1">
                    <span class="price-val text-4xl font-black text-white">
                      {pkg.price.toLocaleString('vi-VN')}đ
                    </span>
                    <span class="price-unit text-xs text-zinc-400 font-semibold font-body-main">
                      {isFree ? '/ Lifetime' : '/ tháng'}
                    </span>
                  </div>
                  {!isFree && pkg.annualPrice && (
                    <div class="annual-price-details text-[10px] text-zinc-400 mt-1.5 font-medium hidden">
                      Thanh toán theo năm: <span class="line-through text-zinc-500 mr-1 original-annual-price">{pkg.originalAnnualPrice.toLocaleString('vi-VN')}đ</span> <span class="text-emerald-400 actual-annual-price">{pkg.annualPrice.toLocaleString('vi-VN')}đ</span>
                    </div>
                  )}
                </div>

                <ul class="space-y-4 mt-8">
                  {getDynamicFeaturesObj(pkg).map((feat) => {
                    let icon = 'check_circle';
                    let iconColor = 'text-emerald-400';
                    if (feat.status === 'fail') {
                      icon = 'cancel';
                      iconColor = 'text-zinc-600';
                    } else if (feat.status === 'warning') {
                      icon = 'error';
                      iconColor = 'text-amber-500';
                    } else if (feat.status === 'info') {
                      icon = 'info';
                      iconColor = 'text-sky-400';
                    }
                    return (
                      <li class="flex items-start gap-2.5 text-xs text-zinc-300">
                        <span class={`material-symbols-outlined ${iconColor} text-sm font-bold`}>{icon}</span>
                        <span>{feat.text}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
              
              <button 
                id={isFree ? undefined : `upgrade-btn-${pkg.id}`}
                class={`w-full upgrade-action-btn py-3.5 rounded-xl mt-8 text-xs font-black transition-all cursor-pointer ${btnClass}`}
                disabled={isFree}
                onclick={isFree ? undefined : `triggerPlanSelection('${pkg.id}')`}
              >
                {btnText}
              </button>
            </div>
          );
        })}
      </div>

      <!-- Feature Comparison Table -->
      <div class="max-w-4xl mx-auto space-y-6 pt-6">
        <h3 class="text-xl font-bold text-white text-center">Bảng so sánh tính năng</h3>
        
        <div class="overflow-hidden border border-glass-stroke rounded-2xl">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-zinc-950/50 border-b border-glass-stroke">
                <th class="px-6 py-4 text-zinc-500 font-bold uppercase tracking-wider">Tính năng</th>
                {groupedPackages.map((pkg) => (
                  <th class="px-6 py-4 text-zinc-500 font-bold uppercase tracking-wider text-center">
                    <span class={pkg.style_type === 'rainbow_effect' ? `package-style-${pkg.id}` : ''} style={pkg.style_type === 'custom_color' && pkg.custom_color ? `color: ${pkg.custom_color}` : ''}>
                      {pkg.title}
                    </span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-glass-stroke/40">
              <tr class="hover:bg-white/5 transition-colors">
                <td class="px-6 py-4 text-zinc-300 font-medium">Chất lượng tối đa</td>
                {groupedPackages.map((pkg) => (
                  <td class="px-6 py-4 text-center text-zinc-200 font-bold">
                    {pkg.permissions?.max_resolution || 'SD'}
                  </td>
                ))}
              </tr>
              <tr class="hover:bg-white/5 transition-colors">
                <td class="px-6 py-4 text-zinc-300 font-medium">Quảng cáo trình phát</td>
                {groupedPackages.map((pkg) => (
                  <td class="px-6 py-4 text-center">
                    {pkg.permissions?.bypass_ads ? (
                      <span class="text-emerald-400 font-bold">Bỏ qua QC</span>
                    ) : (
                      <span class="text-zinc-500">Có quảng cáo</span>
                    )}
                  </td>
                ))}
              </tr>
              <tr class="hover:bg-white/5 transition-colors">
                <td class="px-6 py-4 text-zinc-300 font-medium">Tính năng Xem Chung</td>
                {groupedPackages.map((pkg) => (
                  <td class="px-6 py-4 text-center">
                    {pkg.permissions?.watch_together ? (
                      <span class="material-symbols-outlined text-emerald-400 text-sm">check_circle</span>
                    ) : (
                      <span class="material-symbols-outlined text-zinc-600 text-sm">cancel</span>
                    )}
                  </td>
                ))}
              </tr>
              <tr class="hover:bg-white/5 transition-colors">
                <td class="px-6 py-4 text-zinc-300 font-medium">Ẩn Watermark ẩn danh</td>
                {groupedPackages.map((pkg) => (
                  <td class="px-6 py-4 text-center">
                    {pkg.permissions?.hide_watermark ? (
                      <span class="material-symbols-outlined text-emerald-400 text-sm">check_circle</span>
                    ) : (
                      <span class="material-symbols-outlined text-zinc-600 text-sm">cancel</span>
                    )}
                  </td>
                ))}
              </tr>
              <tr class="hover:bg-white/5 transition-colors">
                <td class="px-6 py-4 text-zinc-300 font-medium">Huy hiệu VIP</td>
                {groupedPackages.map((pkg) => (
                  <td class="px-6 py-4 text-center">
                    {pkg.permissions?.vip_badge ? (
                      <span class="material-symbols-outlined text-emerald-400 text-sm">check_circle</span>
                    ) : (
                      <span class="material-symbols-outlined text-zinc-600 text-sm">cancel</span>
                    )}
                  </td>
                ))}
              </tr>
              <tr class="hover:bg-white/5 transition-colors">
                <td class="px-6 py-4 text-zinc-300 font-medium">Giới hạn Watchlist</td>
                {groupedPackages.map((pkg) => (
                  <td class="px-6 py-4 text-center text-zinc-200">
                    {pkg.permissions?.max_playlists || 0} phim
                  </td>
                ))}
              </tr>
              <tr class="hover:bg-white/5 transition-colors">
                <td class="px-6 py-4 text-zinc-300 font-medium">Số lượng Server khả dụng</td>
                {groupedPackages.map((pkg) => (
                  <td class="px-6 py-4 text-center text-zinc-200 font-mono">
                    {pkg.permissions?.allowed_servers?.length || 0}
                  </td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- SePay Automated Transfer Portal Section (Initially Hidden) -->
    <div id="sepay-transfer-portal" class="hidden space-y-6 w-full max-w-2xl mx-auto py-2 text-left bg-transparent">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <!-- QR Code Column -->
        <div class="md:col-span-5 flex flex-col items-center gap-3">
          <div class="p-3 bg-white rounded-2xl flex items-center justify-center border border-zinc-200 shadow-xl w-[260px] h-[260px] md:w-[220px] md:h-[220px] cursor-zoom-in transition-transform hover:scale-[1.02] mx-auto">
            <img id="sepay-vietqr-img" src="" class="w-full h-full object-contain" alt="VietQR Pay" />
          </div>
          <span class="text-[10px] text-zinc-400 font-semibold tracking-wider flex items-center gap-1 uppercase">
            <span class="w-2.5 h-2.5 bg-emerald-400 rounded-full animate-ping"></span>
            Quét mã để trả tiền nhanh
          </span>
        </div>

        <!-- Bank Details Column -->
        <div class="md:col-span-7 space-y-3.5 text-xs">
          <h4 class="font-bold text-zinc-500 uppercase tracking-wider text-[10px]">THÔNG TIN TÀI KHOẢN</h4>
          
          <div class="space-y-2">
            <!-- Bank name -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Ngân hàng</span>
                <p id="sepay-bank-name-val" class="font-bold text-white mt-0.5">-</p>
              </div>
            </div>
            
            <!-- Account number -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Số tài khoản</span>
                <p id="sepay-bank-no-val" class="font-mono font-bold text-white text-sm mt-0.5">-</p>
              </div>
              <button onclick="copyField('sepay-bank-no-val')" class="p-2 bg-white/5 hover:bg-white/10 rounded-lg text-primary transition-colors cursor-pointer border-none flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">content_copy</span>
              </button>
            </div>

            <!-- Account Name -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Chủ tài khoản</span>
                <p id="sepay-bank-accname-val" class="font-bold text-white uppercase mt-0.5">-</p>
              </div>
            </div>

            <!-- Amount -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Số tiền cần chuyển</span>
                <p id="sepay-bank-amount-val" class="font-bold text-primary text-sm mt-0.5">-</p>
              </div>
              <button onclick="copyRawField('sepay-bank-amount-val')" class="p-2 bg-white/5 hover:bg-white/10 rounded-lg text-primary transition-colors cursor-pointer border-none flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">content_copy</span>
              </button>
            </div>

            <!-- Memo Message -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Nội dung chuyển khoản (Bắt buộc ghi đúng)</span>
                <p id="sepay-bank-memo-val" class="font-bold text-white tracking-wide mt-0.5 font-mono uppercase text-sm">-</p>
              </div>
              <button onclick="copyField('sepay-bank-memo-val')" class="p-2 bg-white/5 hover:bg-white/10 rounded-lg text-primary transition-colors cursor-pointer border-none flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">content_copy</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Status Indicator -->
      <div class="bg-primary/5 border border-primary/20 rounded-2xl p-5 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full border-2 border-primary border-t-transparent animate-spin shrink-0"></div>
          <div>
            <h5 class="text-xs font-bold text-white">Đang chờ hệ thống tự động nhận diện..</h5>
            <p class="text-[10px] text-zinc-400 mt-0.5 font-body-main">Giao dịch được đối soát tự động mỗi 5 giây qua SePay. Quý khách vui lòng không đóng trình duyệt.</p>
          </div>
        </div>
        <div class="flex gap-2 items-center">
          <div id="sepay-sandbox-btn-container" class="hidden"></div>
          <button id="check-sepay-now-btn" class="px-4 py-2 bg-primary hover:brightness-110 active:scale-95 text-slate-950 font-bold rounded-xl text-xs transition-all cursor-pointer border-none shadow-md">
            Kiểm tra ngay
          </button>
        </div>
      </div>
    </div>

    <!-- Manual Transfer Portal Section (Initially Hidden) -->
    <div id="manual-transfer-portal" class="hidden space-y-6 w-full max-w-2xl mx-auto py-2 text-left bg-transparent">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <!-- QR Code Column -->
        <div class="md:col-span-5 flex flex-col items-center gap-3">
          <div class="p-3 bg-white rounded-2xl flex items-center justify-center border border-zinc-200 shadow-xl w-[260px] h-[260px] md:w-[220px] md:h-[220px] cursor-zoom-in transition-transform hover:scale-[1.02] mx-auto">
            <img id="vietqr-img" src="" class="w-full h-full object-contain" alt="VietQR Pay" />
          </div>
          <span class="text-[10px] text-zinc-400 font-semibold tracking-wider flex items-center gap-1 uppercase">
            <span class="w-2.5 h-2.5 bg-emerald-400 rounded-full animate-ping"></span>
            Quét mã để trả tiền nhanh
          </span>
        </div>

        <!-- Bank Details Column -->
        <div class="md:col-span-7 space-y-3.5 text-xs">
          <h4 class="font-bold text-zinc-500 uppercase tracking-wider text-[10px]">THÔNG TIN TÀI KHOẢN</h4>
          
          <div class="space-y-2">
            <!-- Bank name -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Ngân hàng</span>
                <p id="bank-name-val" class="font-bold text-white mt-0.5">-</p>
              </div>
            </div>
            
            <!-- Account number -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Số tài khoản</span>
                <p id="bank-no-val" class="font-mono font-bold text-white text-sm mt-0.5">-</p>
              </div>
              <button onclick="copyField('bank-no-val')" class="p-2 bg-white/5 hover:bg-white/10 rounded-lg text-primary transition-colors cursor-pointer border-none flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">content_copy</span>
              </button>
            </div>

            <!-- Account Name -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Chủ tài khoản</span>
                <p id="bank-accname-val" class="font-bold text-white uppercase mt-0.5">-</p>
              </div>
            </div>

            <!-- Amount -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Số tiền cần chuyển</span>
                <p id="bank-amount-val" class="font-bold text-primary text-sm mt-0.5">-</p>
              </div>
              <button onclick="copyRawField('bank-amount-val')" class="p-2 bg-white/5 hover:bg-white/10 rounded-lg text-primary transition-colors cursor-pointer border-none flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">content_copy</span>
              </button>
            </div>

            <!-- Memo Message -->
            <div class="flex justify-between items-center bg-white/5 border border-glass-stroke/40 rounded-xl px-4 py-2.5">
              <div>
                <span class="text-zinc-500 text-[9px] uppercase font-bold tracking-wider">Nội dung chuyển khoản (Bắt buộc ghi đúng)</span>
                <p id="bank-memo-val" class="font-bold text-white tracking-wide mt-0.5 font-mono uppercase text-sm">-</p>
              </div>
              <button onclick="copyField('bank-memo-val')" class="p-2 bg-white/5 hover:bg-white/10 rounded-lg text-primary transition-colors cursor-pointer border-none flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">content_copy</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Receipt Upload Form -->
      <form id="receipt-upload-form" class="space-y-4 pt-6 border-t border-glass-stroke/50">
        <h4 class="font-bold text-zinc-300 text-xs flex items-center gap-2">
          <span class="material-symbols-outlined text-sm text-primary">cloud_upload</span>
          Nộp minh chứng giao dịch chuyển khoản thành công
        </h4>
        <p class="text-[11px] text-zinc-500 leading-relaxed font-body-main">Vui lòng chụp ảnh biên lai/hóa đơn chuyển khoản thành công và tải lên dưới đây để ban quản trị đối soát kích hoạt gói VIP của bạn nhanh nhất (1-5 phút).</p>
        
        <div class="flex flex-col sm:flex-row gap-4 items-center">
          <div class="w-full flex-1">
            <input type="file" id="receipt-file-input" accept="image/*" class="hidden" required />
            <div onclick="document.getElementById('receipt-file-input').click()" class="w-full h-24 border-2 border-dashed border-glass-stroke hover:border-primary/50 bg-white/5 rounded-2xl flex flex-col items-center justify-center gap-1.5 cursor-pointer transition-all p-3" id="file-dropzone">
              <span class="material-symbols-outlined text-zinc-500 text-xl" id="dropzone-icon">image</span>
              <span class="text-[10px] text-zinc-400 font-bold" id="dropzone-text">Chọn ảnh hóa đơn...</span>
            </div>
          </div>
          
          <button type="submit" class="w-full sm:w-auto px-8 py-4 bg-primary text-slate-950 font-black rounded-xl text-xs hover:brightness-110 active:scale-95 transition-all cursor-pointer h-24 shadow-lg shadow-primary/20 flex items-center justify-center shrink-0 border-none">
            Gửi yêu cầu duyệt gói
          </button>
        </div>
      </form>
    </div>

    <!-- QR Code Lightbox -->
    <div id="qr-lightbox" class="fixed inset-0 z-[100000] hidden bg-black/85 backdrop-blur-sm items-center justify-center opacity-0 transition-opacity duration-300 ease-out cursor-zoom-out">
      <div class="relative max-w-[90vw] max-h-[90vh] scale-90 transition-transform duration-300 ease-out" id="qr-lightbox-content">
        <img id="qr-lightbox-img" src="" class="max-w-[450px] max-h-[450px] w-full h-full object-contain rounded-3xl p-6 bg-white border border-zinc-800 shadow-2xl" />
        <button class="absolute top-4 right-4 text-zinc-500 hover:text-zinc-800 transition-colors w-8 h-8 flex items-center justify-center rounded-full bg-zinc-100 shadow-md border border-zinc-200 cursor-pointer" id="qr-lightbox-close">
          <span class="material-symbols-outlined text-xl">close</span>
        </button>
      </div>
    </div>

    <style>
      .fly-animation {
        pointer-events: none;
        transition: all 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
      }
      .dropzone-active {
        border-color: #10b981 !important;
        background-color: rgba(16, 185, 129, 0.08) !important;
        transform: scale(1.02);
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
      }
    </style>
  </main>
</MainLayout>

<div id="nangcap-page-data" data-packages={JSON.stringify(packages)} class="hidden"></div>

<script is:inline>
  (function() {
    let billingCycle = 'monthly'; // 'monthly' or 'annual'
    let loadedSettings = {};
    let userPackagePrice = 0;
    
    async function fetchSettings() {
      try {
        const res = await fetch('/api/admin/settings');
        if (res.ok) {
          const result = await res.json();
          loadedSettings = result?.data || {};
        }
      } catch (e) {
        console.error('Failed to load settings:', e);
      }
    }

    async function initUpgradePage() {
      const isLoggedIn = document.cookie.includes('txa_gate_passed');
      const guest = document.querySelector('.auth-guest');
      const user = document.querySelector('.auth-user');

      if (!isLoggedIn) {
        guest?.classList.remove('hidden');
        user?.classList.add('hidden');
        return;
      }

      guest?.classList.add('hidden');
      user?.classList.remove('hidden');

      await fetchSettings();

      // Bind Billing Cycle Toggle
      const toggleBtn = document.getElementById('billing-toggle-btn');
      const dot = document.getElementById('billing-dot');
      const labelMonthly = document.getElementById('label-monthly');
      const labelAnnual = document.getElementById('label-annual');

      function updatePrices() {
        const isMonthly = billingCycle === 'monthly';
        if (isMonthly) {
          dot?.classList.remove('translate-x-6');
          dot?.classList.add('translate-x-0');
          labelMonthly?.classList.add('text-white');
          labelMonthly?.classList.remove('text-zinc-400');
          labelAnnual?.classList.add('text-zinc-400');
          labelAnnual?.classList.remove('text-white');
        } else {
          dot?.classList.remove('translate-x-0');
          dot?.classList.add('translate-x-6');
          labelMonthly?.classList.remove('text-white');
          labelMonthly?.classList.add('text-zinc-400');
          labelAnnual?.classList.remove('text-zinc-400');
          labelAnnual?.classList.add('text-white');
        }

        // Cập nhật giá trị và hiển thị trên card
        const plansContainer = document.getElementById('plans-container');
        const cards = plansContainer ? plansContainer.querySelectorAll('[id^="plan-card-"]') : [];
        let visibleCount = 0;

        cards.forEach(card => {
          const hasAnnual = card.getAttribute('data-has-annual') === 'true';
          const isFree = card.getAttribute('data-id') === 'free';

          if (isFree) {
            card.classList.remove('hidden');
            visibleCount++;
            return;
          }

          if (isMonthly) {
            card.classList.remove('hidden');
            visibleCount++;

            const monthlyPrice = parseInt(card.getAttribute('data-monthly-price') || '0');
            const priceValEl = card.querySelector('.price-val');
            const priceUnitEl = card.querySelector('.price-unit');
            const savingBadge = card.querySelector('.saving-badge');
            const annualDetails = card.querySelector('.annual-price-details');

            if (priceValEl) priceValEl.textContent = monthlyPrice.toLocaleString('vi-VN') + 'đ';
            if (priceUnitEl) priceUnitEl.textContent = '/ tháng';
            if (savingBadge) savingBadge.classList.add('hidden');
            if (annualDetails) annualDetails.classList.add('hidden');
          } else {
            if (hasAnnual) {
              card.classList.remove('hidden');
              visibleCount++;

              const annualPrice = parseInt(card.getAttribute('data-annual-price') || '0');
              const monthlyEquivalent = Math.round(annualPrice / 12);
              const priceValEl = card.querySelector('.price-val');
              const priceUnitEl = card.querySelector('.price-unit');
              const savingBadge = card.querySelector('.saving-badge');
              const annualDetails = card.querySelector('.annual-price-details');

              if (priceValEl) priceValEl.textContent = monthlyEquivalent.toLocaleString('vi-VN') + 'đ';
              if (priceUnitEl) priceUnitEl.textContent = '/ tháng';
              
              const savingPercent = parseInt(card.getAttribute('data-saving-percent') || '0');
              if (savingPercent > 0) {
                if (savingBadge) {
                  savingBadge.classList.remove('hidden');
                  savingBadge.textContent = `Tiết kiệm ${savingPercent}%`;
                }
                if (annualDetails) annualDetails.classList.remove('hidden');
              } else {
                if (savingBadge) savingBadge.classList.add('hidden');
                if (annualDetails) annualDetails.classList.add('hidden');
              }
            } else {
              card.classList.add('hidden');
            }
          }
        });

        // Adjust column count dynamically for symmetry
        if (plansContainer) {
          plansContainer.classList.remove('md:grid-cols-1', 'md:grid-cols-2', 'md:grid-cols-3', 'md:grid-cols-4', 'max-w-md', 'max-w-3xl', 'max-w-5xl', 'max-w-6xl');
          if (visibleCount === 1) {
            plansContainer.classList.add('md:grid-cols-1', 'max-w-md');
          } else if (visibleCount === 2) {
            plansContainer.classList.add('md:grid-cols-2', 'max-w-3xl');
          } else {
            plansContainer.classList.add('md:grid-cols-3', 'max-w-5xl');
          }
        }
      }

      // Initial cycle styles
      updatePrices();

      if (toggleBtn) {
        toggleBtn.onclick = function() {
          billingCycle = billingCycle === 'monthly' ? 'annual' : 'monthly';
          updatePrices();
        };
      }

      // Resolve package display & current plan highlights
      const username = localStorage.getItem('tlogged_in_as') || '';
      const pageDataEl = document.getElementById('nangcap-page-data');
      const packages = pageDataEl ? JSON.parse(pageDataEl.dataset.packages || '[]') : [];

      try {
        const userRes = await fetch(`/api/auth/me?username=${encodeURIComponent(username)}`);
        if (userRes.ok) {
          const userData = await userRes.json();
          const userObj = userData?.data || {};
          const userPackage = userObj.package || 'Free';
          const userPkg = packages.find(p => p.title === userPackage);
          const userPkgId = userPkg ? userPkg.id : 'free';
          
          userPackagePrice = userPkg ? userPkg.price : 0;
          
          const currentPkgDisplay = document.getElementById('current-user-package-display');
          if (currentPkgDisplay) {
            currentPkgDisplay.innerHTML = `<em class="package-style-${userPkgId} font-bold font-body-main">${userPackage}</em>`;
          }

          // Highlight user's current card
          const plansContainer = document.getElementById('plans-container');
          const cards = plansContainer ? plansContainer.querySelectorAll('[id^="plan-card-"]') : [];
          let targetCardId = userPkgId;
          
          if (userPkgId !== 'free') {
            const matchedCard = Array.from(cards).find(c => 
              c.getAttribute('data-monthly-id') === userPkgId || 
              c.getAttribute('data-annual-id') === userPkgId
            );
            if (matchedCard) {
              targetCardId = matchedCard.getAttribute('data-id');
            }
          }

          const currentCard = document.getElementById(`plan-card-${targetCardId}`);
          if (currentCard) {
            currentCard.classList.add('ring-2', 'ring-primary/80', 'scale-[1.02]');
            
            // Add a badge "Gói của bạn" inside the card if not already added
            if (!currentCard.querySelector('.user-package-badge')) {
              const headerDiv = currentCard.querySelector('div');
              if (headerDiv) {
                const badge = document.createElement('span');
                badge.className = 'user-package-badge ml-2 px-2 py-0.5 bg-primary/20 text-primary border border-primary/30 rounded font-black text-[9px] uppercase tracking-wider font-label-caps inline-block align-middle';
                badge.textContent = 'Gói của bạn';
                const h3 = headerDiv.querySelector('h3');
                if (h3) {
                  h3.appendChild(badge);
                }
              }
            }

            // Disable button
            const btn = currentCard.querySelector('.upgrade-action-btn');
            if (btn) {
              btn.disabled = true;
              btn.textContent = 'Đang sử dụng';
              btn.className = 'w-full upgrade-action-btn py-3.5 rounded-xl mt-8 text-xs font-black transition-all cursor-not-allowed bg-zinc-800 text-zinc-500 border border-zinc-700/50';
              btn.removeAttribute('onclick');
            }
          }
        }
      } catch (e) {
        console.error('Failed to load user details:', e);
      }
    }

    // Expose selectPlan globally
    window.selectPlan = function(packageId, packageTitle, price) {
      const pageDataEl = document.getElementById('nangcap-page-data');
      const packages = pageDataEl ? JSON.parse(pageDataEl.dataset.packages || '[]') : [];
      const targetPkg = packages.find(p => p.id === packageId) || {};
      const targetPrice = targetPkg.price || price;

      if (userPackagePrice > targetPrice) {
        if (window.txamodal) {
          window.txamodal.show({
            title: 'Cảnh báo hạ cấp gói cước',
            message: `
              <div class="flex flex-col gap-3">
                <p class="text-xs text-zinc-300 leading-relaxed font-body-main">Gói cước hiện tại của bạn có giá trị cao hơn gói bạn đang chọn. Nếu hạ cấp gói, các quyền lợi VIP cũ sẽ bị hủy bỏ ngay lập tức và thay thế bằng các quyền lợi của gói mới.</p>
                <p class="text-xs text-amber-400 font-bold">Bạn có chắc chắn muốn tiếp tục hạ cấp gói cước?</p>
              </div>
            `,
            type: 'warning',
            confirmText: 'Tiếp tục',
            cancelText: 'Hủy',
            onConfirm: () => {
              openPaymentSelector(packageId, packageTitle, targetPrice, targetPkg);
            }
          });
        }
        return;
      }

      openPaymentSelector(packageId, packageTitle, targetPrice, targetPkg);
    };

    window.triggerPlanSelection = function(cardId) {
      const card = document.getElementById(`plan-card-${cardId}`);
      if (!card) return;

      const isMonthly = billingCycle === 'monthly';
      const isFree = cardId === 'free';

      if (isFree) return;

      if (isMonthly) {
        const id = card.getAttribute('data-monthly-id');
        const title = card.getAttribute('data-monthly-title');
        const price = parseInt(card.getAttribute('data-monthly-price') || '0');
        selectPlan(id, title, price);
      } else {
        const id = card.getAttribute('data-annual-id');
        const title = card.getAttribute('data-annual-title');
        const price = parseInt(card.getAttribute('data-annual-price') || '0');
        selectPlan(id, title, price);
      }
    };

    function openPaymentSelector(packageId, packageTitle, price, targetPkg) {
      const payments = loadedSettings.payments || {};
      const isSandbox = payments.sandbox_mode ?? true;

      // Collect available payment methods
      const methods = [];
      if (payments.manual_enable) methods.push({ id: 'manual', label: 'Chuyển khoản VietQR' });
      if (payments.payos_enable) methods.push({ id: 'payos', label: 'Cổng PayOS' });
      if (payments.stripe_enable) methods.push({ id: 'stripe', label: 'Cổng Stripe (Quốc tế)' });
      if (payments.paypal_enable) methods.push({ id: 'paypal', label: 'Cổng PayPal' });
      if (payments.sepay_enable) methods.push({ id: 'sepay', label: 'Cổng SePay' });
      if (payments.vnpay_enable) methods.push({ id: 'vnpay', label: 'Cổng VNPAY' });

      if (methods.length === 0) {
        if (window.showGlobalToast) window.showGlobalToast('Không có cổng thanh toán nào hoạt động.', 'error');
        return;
      }

      const cycle = targetPkg.cycle || 'monthly';
      const cycleLabelStr = cycle === 'annual' ? 'Hàng năm' : cycle === 'monthly' ? 'Hàng tháng' : 'Vô thời hạn';

      const modalHtml = `
        <div class="flex flex-col gap-4">
          <p class="text-xs text-zinc-400">Chọn phương thức thanh toán phù hợp dưới đây:</p>
          <div class="flex flex-col gap-2.5">
            ${methods.map(m => `
              <button onclick="processPaymentSelect('${m.id}', ${price}, '${cycle}', '${packageId}', '${encodeURIComponent(packageTitle)}')" class="w-full p-4 rounded-xl border border-glass-stroke hover:border-primary/50 bg-white/5 hover:bg-white/10 text-left font-bold text-white text-xs flex justify-between items-center transition-all cursor-pointer">
                <span class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-primary text-base">credit_card</span>
                  ${m.label}
                </span>
                <span class="material-symbols-outlined text-zinc-500 text-sm">chevron_right</span>
              </button>
            `).join('')}
          </div>
          ${isSandbox ? '<div class="text-[10px] text-yellow-500 font-bold bg-yellow-500/10 border border-yellow-500/20 rounded p-2 text-center">Chế độ Sandbox (Giả lập) đang được Admin kích hoạt. Các cổng tự động sẽ đi qua trang mô phỏng.</div>' : ''}
        </div>
      `;

      if (window.txamodal) {
        window.txamodal.show({
          title: `Thanh toán gói ${packageTitle} (${cycleLabelStr})`,
          content: modalHtml,
          type: 'info',
          confirmText: '',
          cancelText: 'Đóng',
          onConfirm: () => {}
        });
      }
    }

    // Expose select gateway globally
    window.processPaymentSelect = async function(method, price, cycle, packageId, packageTitleEncoded) {
      if (window.txamodal) {
        // Trigger modal closing
        const modal = document.getElementById('txa-global-modal');
        if (modal) {
          modal.classList.add('opacity-0');
          setTimeout(() => { modal.classList.add('hidden'); modal.classList.remove('flex'); }, 200);
          document.body.style.overflow = '';
        }
      }

      const payments = loadedSettings.payments || {};
      const isSandbox = payments.sandbox_mode ?? true;
      const username = localStorage.getItem('tlogged_in_as') || 'anonymous';
      const packageTitle = decodeURIComponent(packageTitleEncoded);

      if (isSandbox && method !== 'manual' && method !== 'sepay') {
        window.location.href = `/checkout/gateway?method=${method}&cycle=${cycle}&price=${price}&packageTitle=${encodeURIComponent(packageTitle)}`;
        return;
      }

      if (method === 'sepay') {
        const txid = 'TXA' + Math.random().toString(36).substring(2, 10).toUpperCase();
        const memo = `TXA_UP_${txid}`;

        if (payments.sepay_integration_type === 'gateway') {
          if (window.showGlobalToast) window.showGlobalToast('Đang chuyển hướng đến cổng thanh toán SePay...', 'info');
          
          // Create pending payment log in the database
          (async () => {
            try {
              const resMe = await fetch(`/api/auth/me?username=${encodeURIComponent(username)}`);
              let userEmail = '';
              if (resMe.ok) {
                const resMeData = await resMe.json();
                userEmail = resMeData.data?.email || '';
              }
              await fetch('/api/user/payments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  txid,
                  username,
                  email: userEmail,
                  packageTitle,
                  price,
                  cycle,
                  method: 'sepay',
                  status: 'pending'
                })
              });

              // Redirect to SePay checkout gateway
              const successUrl = `${window.location.origin}/checkout/success?method=sepay&cycle=${cycle}&price=${price}&txid=${txid}`;
              const failUrl = `${window.location.origin}/checkout/failed?method=sepay&user=${encodeURIComponent(username)}`;
              const gatewayUrl = `https://pay.sepay.vn/checkout?account_id=${payments.sepay_bank_account_id}&amount=${price}&memo=${memo}&success_url=${encodeURIComponent(successUrl)}&cancel_url=${encodeURIComponent(failUrl)}`;
              window.location.href = gatewayUrl;
            } catch (err) {
              console.error('Lỗi khởi tạo giao dịch SePay Gateway:', err);
              if (window.showGlobalToast) window.showGlobalToast('Lỗi khởi tạo giao dịch. Vui lòng thử lại!', 'error');
            }
          })();
          return;
        }

        // Fallback to 'vietqr' (Direct on-site display)
        const sepayPortal = document.getElementById('sepay-transfer-portal');
        if (sepayPortal) {
          sepayPortal.classList.remove('hidden');

          document.getElementById('sepay-bank-name-val').textContent = payments.sepay_bank_name || 'MB Bank';
          document.getElementById('sepay-bank-no-val').textContent = payments.sepay_account_no || '-';
          document.getElementById('sepay-bank-accname-val').textContent = payments.sepay_account_name || '-';
          document.getElementById('sepay-bank-amount-val').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price);
          document.getElementById('sepay-bank-memo-val').textContent = memo;

          // Save package details for form submission
          sepayPortal.dataset.selectedPackageId = packageId;
          sepayPortal.dataset.selectedPackageTitle = packageTitle;
          sepayPortal.dataset.selectedPrice = price;
          sepayPortal.dataset.txid = txid;

          const qrUrl = `https://img.vietqr.io/image/${payments.sepay_bank_name || 'MB'}-${payments.sepay_account_no}-compact.png?amount=${price}&addInfo=${encodeURIComponent(memo)}&accountName=${encodeURIComponent(payments.sepay_account_name || '')}`;
          document.getElementById('sepay-vietqr-img').setAttribute('src', qrUrl);

          // Inject sandbox info banner if sandbox mode is active
          const sandboxBtnContainer = document.getElementById('sepay-sandbox-btn-container');
          if (isSandbox && sandboxBtnContainer) {
            sandboxBtnContainer.classList.remove('hidden');
            sandboxBtnContainer.innerHTML = `
              <div class="flex items-center gap-2 px-4 py-2.5 bg-yellow-500/10 border border-yellow-500/30 rounded-xl text-xs text-yellow-400 font-bold">
                <span class="material-symbols-outlined text-sm shrink-0">science</span>
                <span>Sandbox Mode — Thực hiện chuyển khoản thử trong môi trường <a href="https://my.sepay.vn" target="_blank" class="underline text-yellow-300">SePay Sandbox</a> với nội dung: <span class="font-mono text-white">TXA_UP_${txid}</span></span>
              </div>
            `;
          } else if (sandboxBtnContainer) {
            sandboxBtnContainer.classList.add('hidden');
            sandboxBtnContainer.innerHTML = '';
          }

          // Create pending payment log in the database
          (async () => {
            try {
              const resMe = await fetch(`/api/auth/me?username=${encodeURIComponent(username)}`);
              let userEmail = '';
              if (resMe.ok) {
                const resMeData = await resMe.json();
                userEmail = resMeData.data?.email || '';
              }
              await fetch('/api/user/payments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  txid,
                  username,
                  email: userEmail,
                  packageTitle,
                  price,
                  cycle,
                  method: 'sepay',
                  status: 'pending'
                })
              });
            } catch (err) {
              console.error('Lỗi khởi tạo giao dịch SePay:', err);
            }
          })();

          // Start active polling (works for both sandbox + live — polls /api/payment/sepay-verify)
          startSePayPolling(txid, 'upgrade', price, packageTitle, cycle);

          // Show in txamodal
          if (window.txamodal) {
            window.txamodal.show({
              title: 'Thanh toán tự động qua SePay (VietQR)',
              content: sepayPortal,
              confirmText: '',
              cancelText: 'Đóng',
              onClose: () => {
                if (sepayPollInterval) {
                  clearInterval(sepayPollInterval);
                  sepayPollInterval = null;
                }
              }
            });
          }
        }
      } else if (method === 'manual') {
        const manualPortal = document.getElementById('manual-transfer-portal');
        if (manualPortal) {
          manualPortal.classList.remove('hidden');
          const txid = 'TXA' + Math.random().toString(36).substring(2, 10).toUpperCase();
          const memo = `TXA_UP_${txid}`;

          document.getElementById('bank-name-val').textContent = payments.manual_bank_name || 'MB Bank';
          document.getElementById('bank-no-val').textContent = payments.manual_account_no || '-';
          document.getElementById('bank-accname-val').textContent = payments.manual_account_name || '-';
          document.getElementById('bank-amount-val').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price);
          document.getElementById('bank-memo-val').textContent = memo;

          // Save package details for form submission
          manualPortal.dataset.selectedPackageId = packageId;
          manualPortal.dataset.selectedPackageTitle = packageTitle;
          manualPortal.dataset.selectedPrice = price;
          manualPortal.dataset.txid = txid;

          const qrUrl = `https://img.vietqr.io/image/${payments.manual_bank_name}-${payments.manual_account_no}-compact.png?amount=${price}&addInfo=${encodeURIComponent(memo)}&accountName=${encodeURIComponent(payments.manual_account_name)}`;
          document.getElementById('vietqr-img').setAttribute('src', qrUrl);

          // Show in txamodal
          if (window.txamodal) {
            window.txamodal.show({
              title: 'Chuyển khoản thủ công VietQR',
              content: manualPortal,
              confirmText: '',
              cancelText: 'Đóng'
            });
          }
        }
      } else if (method === 'stripe') {
        if (window.showGlobalToast) window.showGlobalToast('Đang kết nối tới Stripe...', 'info');
        try {
          const res = await fetch('/api/payment/stripe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ price, cycle, username, packageTitle })
          });
          const data = await res.json();
          if (res.ok && data.url) {
            window.location.href = data.url;
          } else {
            if (window.showGlobalToast) window.showGlobalToast(data.error || 'Lỗi khởi tạo Stripe.', 'error');
          }
        } catch (e) {
          if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API Stripe.', 'error');
        }
      } else if (method === 'payos') {
        if (window.showGlobalToast) window.showGlobalToast('Đang kết nối tới PayOS...', 'info');
        try {
          const res = await fetch('/api/payment/payos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ price, cycle, username, packageTitle })
          });
          const data = await res.json();
          if (res.ok && data.checkoutUrl) {
            window.location.href = data.checkoutUrl;
          } else {
            if (window.showGlobalToast) window.showGlobalToast(data.error || 'Lỗi khởi tạo PayOS.', 'error');
          }
        } catch (e) {
          if (window.showGlobalToast) window.showGlobalToast('Lỗi kết nối API PayOS.', 'error');
        }
      } else {
        if (window.txamodal) {
          window.txamodal.show({
            title: 'Cổng thanh toán đang bảo trì',
            message: `Cổng ${method.toUpperCase()} trong chế độ Thật đang được bảo trì tích hợp. Vui lòng chọn <strong>Chuyển khoản VietQR</strong> hoặc thử lại sau!`,
            type: 'info',
            confirmText: 'Đóng',
            cancelText: '',
            onConfirm: () => {}
          });
        }
      }
    };

    window.copyField = function(id) {
      const text = document.getElementById(id)?.textContent;
      if (text) {
        navigator.clipboard.writeText(text);
        if (window.showGlobalToast) window.showGlobalToast('Đã sao chép vào bộ nhớ tạm!', 'success', 1500);
      }
    };
    
    window.copyRawField = function(id) {
      const textStr = document.getElementById(id)?.textContent;
      if (textStr) {
        const cleanedVal = textStr.replace(/[^0-9]/g, '');
        navigator.clipboard.writeText(cleanedVal);
        if (window.showGlobalToast) window.showGlobalToast('Đã sao chép số tiền!', 'success', 1500);
      }
    };

    function setupQRLightbox() {
      const lightbox = document.getElementById('qr-lightbox');
      const lightboxImg = document.getElementById('qr-lightbox-img');
      const lightboxContent = document.getElementById('qr-lightbox-content');
      const lightboxClose = document.getElementById('qr-lightbox-close');
      
      if (!lightbox || !lightboxImg || !lightboxContent) return;
      
      const openLightbox = (src) => {
        lightboxImg.src = src;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        setTimeout(() => {
          lightbox.classList.add('opacity-100');
          lightbox.classList.remove('opacity-0');
          lightboxContent.classList.add('scale-100');
          lightboxContent.classList.remove('scale-90');
        }, 10);
      };
      
      const closeLightbox = () => {
        lightbox.classList.add('opacity-0');
        lightbox.classList.remove('opacity-100');
        lightboxContent.classList.add('scale-90');
        lightboxContent.classList.remove('scale-100');
        setTimeout(() => {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
        }, 300);
      };
      
      document.querySelectorAll('#sepay-vietqr-img, #vietqr-img').forEach(img => {
        img.addEventListener('click', (e) => {
          if (img.getAttribute('src')) {
            openLightbox(img.getAttribute('src'));
          }
        });
      });
      
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      
      if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
      
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
          closeLightbox();
        }
      });
    }

    function setupReceiptForms() {
      const fileInput = document.getElementById('receipt-file-input');
      const dropzone = document.getElementById('file-dropzone');

      if (!fileInput || !dropzone) return;

      const resetDropzoneUI = () => {
        dropzone.classList.remove('dropzone-active');
        dropzone.innerHTML = `
          <span class="material-symbols-outlined text-zinc-500 text-xl" id="dropzone-icon">image</span>
          <span class="text-[10px] text-zinc-400 font-bold" id="dropzone-text">Chọn ảnh hóa đơn...</span>
        `;
        dropzone.style.borderColor = '';
      };

      const handleFileSelect = (file) => {
        const validTypes = ['image/png', 'image/jpeg', 'image/jpg'];
        const fileExt = file.name.split('.').pop().toLowerCase();
        const validExts = ['png', 'jpg', 'jpeg'];
        
        if (!validTypes.includes(file.type) && !validExts.includes(fileExt)) {
          if (window.showGlobalToast) window.showGlobalToast('Chỉ hỗ trợ định dạng ảnh .png, .jpg, .jpeg!', 'error');
          resetDropzoneUI();
          fileInput.value = '';
          return;
        }

        if (file.size > 15 * 1024 * 1024) {
          if (window.showGlobalToast) window.showGlobalToast('Dung lượng ảnh tối đa là 15MB!', 'error');
          resetDropzoneUI();
          fileInput.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
          dropzone.innerHTML = `
            <div class="flex flex-col items-center justify-center gap-2 w-full h-full py-2 pointer-events-none">
              <span class="text-[10px] text-zinc-300 font-bold truncate max-w-[90%]">${file.name}</span>
              <img src="${e.target.result}" class="h-16 max-w-[80%] object-contain rounded-lg border border-white/10 shadow-md" />
            </div>
          `;
          dropzone.style.borderColor = '#10b981';
        };
        reader.readAsDataURL(file);
      };

      fileInput.onchange = function() {
        if (this.files && this.files[0]) {
          handleFileSelect(this.files[0]);
        }
      };

      if (window.innerWidth > 768) {
        ['dragenter', 'dragover'].forEach(eventName => {
          dropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.add('dropzone-active');
            
            const txt = dropzone.querySelector('#dropzone-text');
            const icon = dropzone.querySelector('#dropzone-icon');
            if (txt) txt.textContent = 'Thả ảnh hóa đơn tại đây...';
            if (icon) icon.textContent = 'upload_file';
          }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
          dropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.remove('dropzone-active');
            if (eventName === 'dragleave' && !fileInput.files[0]) {
              resetDropzoneUI();
            }
          }, false);
        });

        dropzone.addEventListener('drop', (e) => {
          const dt = e.dataTransfer;
          const files = dt.files;
          
          if (!files || files.length === 0) return;
          
          if (files.length > 1) {
            if (window.showGlobalToast) window.showGlobalToast('Chỉ được chọn tối đa 1 ảnh minh chứng.', 'error');
            resetDropzoneUI();
            return;
          }
          
          const file = files[0];
          
          const rect = dropzone.getBoundingClientRect();
          const targetX = rect.left + rect.width / 2;
          const targetY = rect.top + rect.height / 2;
          
          const flyImg = document.createElement('img');
          flyImg.src = URL.createObjectURL(file);
          flyImg.className = 'fixed object-cover rounded-lg shadow-2xl border border-white/20 z-[100000] fly-animation';
          flyImg.style.width = '70px';
          flyImg.style.height = '70px';
          flyImg.style.left = `${e.clientX - 35}px`;
          flyImg.style.top = `${e.clientY - 35}px`;
          flyImg.style.transform = 'scale(1)';
          flyImg.style.opacity = '1';
          document.body.appendChild(flyImg);
          
          flyImg.offsetHeight;
          
          flyImg.style.left = `${targetX - 35}px`;
          flyImg.style.top = `${targetY - 35}px`;
          flyImg.style.transform = 'scale(0.1) rotate(15deg)';
          flyImg.style.opacity = '0';
          
          setTimeout(() => {
            flyImg.remove();
            
            const fileTransfer = new DataTransfer();
            fileTransfer.items.add(file);
            fileInput.files = fileTransfer.files;
            
            fileInput.dispatchEvent(new Event('change'));
          }, 600);
        });
      }

      const form = document.getElementById('receipt-upload-form');
      form?.addEventListener('submit', function(e) {
        e.preventDefault();

        const file = fileInput.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onloadend = async function() {
          const receiptImgBase64 = reader.result;
          const username = localStorage.getItem('tlogged_in_as') || 'anonymous';
          const manualPortal = document.getElementById('manual-transfer-portal');
          
          const selectedPkgId = manualPortal?.dataset.selectedPackageId || 'vip_1m';
          const selectedPkgTitle = manualPortal?.dataset.selectedPackageTitle || 'Premium VIP';
          const selectedPrice = parseInt(manualPortal?.dataset.selectedPrice || '0');
          const txid = manualPortal?.dataset.txid || ('TXA' + Math.random().toString(36).substring(2, 10).toUpperCase());

          try {
            if (window.showGlobalToast) window.showGlobalToast('Đang gửi biên lai thanh toán...', 'info');
            
            const resMe = await fetch(`/api/auth/me?username=${encodeURIComponent(username)}`);
            let userEmail = '';
            if (resMe.ok) {
              const resMeData = await resMe.json();
              userEmail = resMeData.data?.email || '';
            }

            const res = await fetch('/api/user/payments', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                txid: txid,
                username: username,
                email: userEmail,
                packageTitle: selectedPkgTitle,
                price: selectedPrice,
                cycle: billingCycle,
                method: 'manual',
                receiptImg: receiptImgBase64,
                status: 'pending'
              })
            });

            if (res.ok) {
              if (window.showGlobalToast) window.showGlobalToast('Đã gửi yêu cầu thanh toán thành công!', 'success');
              
              // Đóng modal
              document.getElementById('txa-modal-close')?.click();
              
              // Reset dropzone
              resetDropzoneUI();
              fileInput.value = '';

              setTimeout(() => {
                window.location.href = '/goi-dich-vu';
              }, 1500);
            } else {
              throw new Error('Lỗi gửi biên lai thanh toán.');
            }
          } catch (err) {
            console.error(err);
            if (window.showGlobalToast) window.showGlobalToast('Lỗi khi gửi biên lai. Vui lòng thử lại!', 'error');
          }
        };
        reader.readAsDataURL(file);
      });
    }

    let sepayPollInterval = null;

    function startSePayPolling(txid, actionType, price, packageTitle, cycle) {
      if (sepayPollInterval) clearInterval(sepayPollInterval);
      
      const checkPayment = async (silent = true) => {
        try {
          const res = await fetch('/api/payment/sepay-verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ txid, actionType })
          });
          const data = await res.json();
          if (res.ok && data.data && data.data.success) {
            clearInterval(sepayPollInterval);
            sepayPollInterval = null;
            
            if (window.showGlobalToast) window.showGlobalToast('Thanh toán thành công qua SePay!', 'success');
            
            // Đóng modal
            document.getElementById('txa-modal-close')?.click();

            setTimeout(() => {
              window.location.href = `/checkout/success?method=sepay&cycle=${cycle}&price=${price}&txid=${txid}`;
            }, 1500);
          } else if (!silent) {
            if (window.showGlobalToast) window.showGlobalToast(data.message || 'Hệ thống chưa nhận được giao dịch. Quý khách vui lòng đợi trong giây lát.', 'info');
          }
        } catch (e) {
          console.error('Lỗi khi đối soát tự động:', e);
        }
      };

      // Poll every 5 seconds
      sepayPollInterval = setInterval(() => checkPayment(true), 5000);

      // Handle Manual check button
      const checkBtn = document.getElementById('check-sepay-now-btn');
      if (checkBtn) {
        checkBtn.onclick = function() {
          checkPayment(false);
        };
      }
    }

    document.addEventListener('astro:before-preparation', () => {
      if (sepayPollInterval) {
        clearInterval(sepayPollInterval);
        sepayPollInterval = null;
      }
    });

    initUpgradePage();
    setupReceiptForms();
    setupQRLightbox();

    document.addEventListener('astro:page-load', () => {
      initUpgradePage();
      setupReceiptForms();
      setupQRLightbox();
    });
  })();
</script>
