---
interface Props {
  name: string;
  slug: string;
  gradient: string;
  icon: string;
  description?: string;
  labelText?: string;
}

const { 
  name, 
  slug, 
  gradient, 
  icon, 
  description = '', 
  labelText = 'Khám phá ngay' 
} = Astro.props;
---

<a 
  href={slug.startsWith('/') ? slug : `/c/${slug}`} 
  class={`relative flex flex-col justify-between p-6 rounded-2xl overflow-hidden group border border-white/10 shadow-xl transition-all duration-300 active:scale-98 cursor-pointer h-32 md:h-36`}
>
  <!-- Background Gradient & Overlay -->
  <div class={`absolute inset-0 bg-gradient-to-br ${gradient} opacity-90 group-hover:scale-105 transition-transform duration-500`}></div>
  <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

  <!-- Content Top: Icon & Description -->
  <div class="relative z-10 flex justify-between items-start">
    <div class="w-10 h-10 rounded-xl bg-white/20 backdrop-blur-md border border-white/20 flex items-center justify-center text-white shadow-inner group-hover:rotate-12 transition-transform duration-300">
      <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">{icon}</span>
    </div>
    {description && (
      <p class="text-white/80 text-[10px] leading-snug max-w-[65%] line-clamp-2 text-right hidden sm:block font-medium">
        {description}
      </p>
    )}
  </div>

  <!-- Content Bottom: Name & Action link -->
  <div class="relative z-10 flex justify-between items-end">
    <div>
      <h3 class="font-title-md text-base md:text-lg font-extrabold text-white leading-tight tracking-tight drop-shadow-md">
        {name}
      </h3>
      <span class="text-[9px] font-label-caps text-white/80 group-hover:text-white group-hover:underline transition-all mt-1 inline-block">
        {labelText}
      </span>
    </div>
    <span class="material-symbols-outlined text-white/85 group-hover:translate-x-1 transition-transform text-lg">
      chevron_right
    </span>
  </a>
