                }, 1000);
              } else {
                if (window.txatoast) window.txatoast.success('📩 Gửi yêu cầu thành công! Vui lòng chờ phê duyệt.');
                else if (window.showGlobalToast) window.showGlobalToast('Gửi yêu cầu thành công! Vui lòng chờ phê duyệt.', 'success');
                localStorage.setItem('zalo_access_status', 'pending');
                closeZaloModal();
                updateZaloUI('pending');
                startZaloPolling();
              }
            } else {
              if (window.txatoast) window.txatoast.error(data.message || 'Đăng ký thất bại!');
              else if (window.showGlobalToast) window.showGlobalToast(data.message || 'Đăng ký thất bại', 'error');
