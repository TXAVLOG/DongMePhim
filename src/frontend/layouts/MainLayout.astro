    <script is:inline>
      // ═══════════════════════════════════════════════════════════════
      // PWA Install Prompt System
      // ═══════════════════════════════════════════════════════════════
      (function() {
        let deferredPrompt = null;
        
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredPrompt = e;
          
          if (sessionStorage.getItem('pwa_install_dismissed') === 'true') {
            return;
          }
          
          const banner = document.getElementById('pwa-install-banner');
          if (banner) {
            banner.classList.remove('hidden');
          }
        });
        
        function wirePwaInstall() {
          const banner = document.getElementById('pwa-install-banner');
          const installBtn = document.getElementById('pwa-install-btn');
          const closeBtn = document.getElementById('pwa-install-close');
          
          if (installBtn && !installBtn.dataset.wired) {
            installBtn.dataset.wired = 'true';
            installBtn.addEventListener('click', async () => {
              if (!deferredPrompt) return;
              deferredPrompt.prompt();
              const { outcome } = await deferredPrompt.userChoice;
              console.log(`[PWA] User response to the install prompt: ${outcome}`);
              deferredPrompt = null;
              if (banner) banner.classList.add('hidden');
            });
          }
          
          if (closeBtn && !closeBtn.dataset.wired) {
            closeBtn.dataset.wired = 'true';
            closeBtn.addEventListener('click', () => {
              if (banner) banner.classList.add('hidden');
              sessionStorage.setItem('pwa_install_dismissed', 'true');
            });
          }
        }
        
        document.addEventListener('astro:page-load', () => {
          wirePwaInstall();
          const banner = document.getElementById('pwa-install-banner');
          if (banner && !deferredPrompt) {
            banner.classList.add('hidden');
          }
        });
        
        window.addEventListener('appinstalled', (evt) => {
          console.log('[PWA] App was installed successfully.');
          const banner = document.getElementById('pwa-install-banner');
          if (banner) banner.classList.add('hidden');
        });
      })();

      // ═══════════════════════════════════════════════════════════════
      // AdBlock Detection System
      // Detects AdBlockers using a decoy element + fetch trap.
      // Only shows modal for FREE tier users.
      // Sets window.TXA_ADBLOCK_DETECTED = true|false globally.
      // ═══════════════════════════════════════════════════════════════
      (function() {
