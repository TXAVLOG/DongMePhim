---
import '@styles/index.css';
import { SettingService } from '@services/SettingService';
import { MovieService } from '@services/MovieService';
import { ClientRouter } from 'astro:transitions';
import Txatooltip from '@components/ui/txatooltip.astro';
import Txaicon from '@components/ui/txaicon.astro';
import { verifySession } from '@lib/auth';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHome?: boolean;
  useTransition?: boolean;
}

const settings = await SettingService.getSettings();
const publicSettings = {
  general: {
    site_name: settings.general?.site_name,
    site_url: settings.general?.site_url,
    site_description: settings.general?.site_description,
    site_keywords: settings.general?.site_keywords,
    maintenance_enable: settings.general?.maintenance_enable,
    maintenance_message: settings.general?.maintenance_message,
    maintenance_end_time: settings.general?.maintenance_end_time,
    api_encrypt_enable: settings.general?.api_encrypt_enable,
    api_encrypt_pass: settings.general?.api_encrypt_pass,
    google_verification: settings.general?.google_verification,
    bing_verification: settings.general?.bing_verification,
    meta_robots: settings.general?.meta_robots,
    og_image_default: settings.general?.og_image_default,
    schema_business_name: settings.general?.schema_business_name,
    schema_logo_url: settings.general?.schema_logo_url,
  },
  ads: settings.ads,
  social: settings.social,
  packages: settings.packages
};
const packages = settings.packages || [];
const bypassPackage = packages.find((p: any) => p.id === 'bypass_zalo' || p.id.includes('bypass'));
const isBypassPackageEnabled = bypassPackage ? bypassPackage.enabled !== false : true;

let packageStyles = `
  .package-style-free {
    background-color: #27272a !important;
    color: #a1a1aa !important;
    border: 1px solid #3f3f46 !important;
  }
`;
packages.forEach((pkg: any) => {
  if (pkg.style_type === 'rainbow_effect') {
    packageStyles += `
      .package-style-${pkg.id} {
        background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8f00ff);
        background-size: 400% 400%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbow-text-animation 6s ease infinite;
        font-weight: bold;
      }
      .package-border-${pkg.id} {
        position: relative;
        border-color: transparent !important;
      }
      .package-border-${pkg.id}::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 2px;
        background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8f00ff);
        background-size: 400% 400%;
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
        animation: rainbow-text-animation 6s ease infinite;
      }
      .package-glow-${pkg.id} {
        animation: rainbow-glow-animation 6s ease infinite;
      }
      .package-btn-${pkg.id} {
        background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8f00ff) !important;
        background-size: 400% 400%;
        color: #000 !important;
        font-weight: 900 !important;
        animation: rainbow-text-animation 6s ease infinite;
        box-shadow: 0 0 20px rgba(139, 92, 246, 0.4) !important;
      }
    `;
  } else if (pkg.style_type === 'custom_color' && pkg.custom_color) {
    packageStyles += `
      .package-style-${pkg.id} {
        color: ${pkg.custom_color} !important;
        font-weight: bold;
      }
      .package-border-${pkg.id} {
        border-color: ${pkg.custom_color} !important;
      }
      .package-glow-${pkg.id} {
        box-shadow: 0 0 25px ${pkg.custom_color}4d !important;
      }
      .package-btn-${pkg.id} {
        background-color: ${pkg.custom_color} !important;
        color: #000 !important;
        box-shadow: 0 4px 14px ${pkg.custom_color}4d !important;
      }
    `;
  }
});

const currentPath = Astro.url.pathname;
const isStaticPolicyPage = currentPath === '/bao-mat' || currentPath === '/dieu-khoan' || currentPath === '/lien-he' || currentPath === '/ve-chung-toi';
const isSmtpConfigured = !!(settings.smtp?.smtp_host && settings.smtp?.smtp_user && settings.smtp?.smtp_pass);
const popularMovies = isStaticPolicyPage ? [] : await MovieService.getMovies({ limit: 12 });

const userAgent = Astro.request.headers.get('user-agent') || '';
const isBot = /googlebot|google-adwords|adsbot|bingbot|yandexbot|baiduspider|facebookexternalhit|twitterbot|telegram|discord|whatsapp|zalo|messenger|rogerbot|linkedinbot|embedly|quora\slink\spreview|showyoubot|outbrain|pinterest\/0\.|pinterestbot|slackbot|vkShare|W3C_Validator/i.test(userAgent);

const rawDecoyEnable = settings.general?.decoy_enable ?? true;
const rawZaloLockEnable = settings.general?.zalo_lock_enable ?? true;

const decoyEnable = isBot ? false : rawDecoyEnable;
const zaloLockEnable = isBot ? false : rawZaloLockEnable;
const decoyPasscode = settings.general?.decoy_passcode || 'phimtxadinhvai';
const zaloGroupUrl = settings.social?.social_zalo_group_url || 'https://zalo.me/g/nc4aaozaxnr5fszvnxdb';

let initialGateClass = 'gate-decoy';
if (!decoyEnable) {
  if (zaloLockEnable) {
    initialGateClass = 'gate-zalo';
  } else {
    initialGateClass = 'gate-passed';
  }
}

const siteUrl = settings.general?.site_url || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

const { 
  title, 
  description = settings.general.site_description, 
  image,
  isHome = false,
  useTransition = true
} = Astro.props;

const defaultTitle = `${settings.general.site_name} - Trải nghiệm điện ảnh đỉnh cao`;
const titleTemplate = settings.general.site_title_template || "%title% | %site_name%";
const pageTitle = isHome 
  ? defaultTitle 
  : (title ? titleTemplate.replace('%title%', title).replace('%site_name%', settings.general.site_name) : defaultTitle);

const ogImage = image && image !== "/favicon.png"
  ? image 
  : (settings.general.og_image_default || "/favicon.png");

const socialLinks = [];
if (settings.social?.social_fb_enable && settings.social?.social_fb_url) {
  socialLinks.push({ platform: "Facebook", url: settings.social.social_fb_url, icon: "facebook" });
}
if (settings.social?.social_fb_group_enable && settings.social?.social_fb_group_url) {
  socialLinks.push({ platform: "Facebook Group", url: settings.social.social_fb_group_url, icon: "facebook-group" });
}
if (settings.social?.social_telegram_enable && settings.social?.social_telegram_url) {
  socialLinks.push({ platform: "Telegram", url: settings.social.social_telegram_url, icon: "telegram" });
}
if (settings.social?.social_tiktok_enable && settings.social?.social_tiktok_url) {
  socialLinks.push({ platform: "TikTok", url: settings.social.social_tiktok_url, icon: "tiktok" });
}
if (settings.social?.social_zalo_group_enable && settings.social?.social_zalo_group_url) {
  socialLinks.push({ platform: "Zalo Group", url: settings.social.social_zalo_group_url, icon: "zalo" });
}

const { countries: uniqueCountries, genres: uniqueGenres } = await MovieService.getGenresAndCountries();

const slugify = (text: string) => {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[đĐ]/g, 'd')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
};

const isActive = (path: string) => {
  if (path === '/tphim') {
    return currentPath === '/tphim';
  }
  return currentPath.startsWith(path);
};

// Fetch current user session
const currentUser = await verifySession(Astro.request, Astro.cookies);
const userObj = currentUser as any;
const isAdmin = userObj && (userObj.role === 'admin' || userObj.roles === 'admin');
const isImpersonating = userObj && !!userObj.adminId;
---

<!DOCTYPE html>
<html lang="vi" class={`dark ${initialGateClass}`}>
  <head>
    {useTransition && <ClientRouter />}
    <script define:vars={{ 
      apiEncryptEnable: settings.general?.api_encrypt_enable ?? false, 
      apiEncryptPass: settings.general?.api_encrypt_pass || 'tphimx',
      settings: publicSettings,
      currentUser
    }}>
      window.TXA_API_CONFIG = {
        encryptEnable: apiEncryptEnable,
        encryptPass: apiEncryptPass
      };
      window.TXA_SITE_SETTINGS = settings;
      window.APP_USER = currentUser;
    </script>
    <script is:inline>
      // Helper function to decrypt AES-256-GCM client-side
      async function clientTxaDecrypt(encoded, passphrase) {
        try {
          let base64 = encoded.replace(/-/g, '+').replace(/_/g, '/');
          while (base64.length % 4) {
            base64 += '=';
          }
          const binaryStr = atob(base64);
          const raw = new Uint8Array(binaryStr.length);
          for (let i = 0; i < binaryStr.length; i++) {
            raw[i] = binaryStr.charCodeAt(i);
          }

          const SALT_LEN = 16;
          const IV_LEN = 12;

          const salt = raw.slice(0, SALT_LEN);
          const iv = raw.slice(SALT_LEN, SALT_LEN + IV_LEN);
          const cipherData = raw.slice(SALT_LEN + IV_LEN);

          const encoder = new TextEncoder();
          const baseKey = await window.crypto.subtle.importKey(
            'raw',
            encoder.encode(passphrase),
            'PBKDF2',
            false,
            ['deriveKey']
          );

          const key = await window.crypto.subtle.deriveKey(
            {
              name: 'PBKDF2',
              salt: salt,
              iterations: 1000,
              hash: 'SHA-256'
            },
            baseKey,
            { name: 'AES-GCM', length: 256 },
            false,
            ['decrypt']
          );

          const decryptedBuffer = await window.crypto.subtle.decrypt(
            { name: 'AES-GCM', iv: iv },
            key,
            cipherData
          );

          const decoder = new TextDecoder();
          return decoder.decode(decryptedBuffer);
        } catch (e) {
          console.error("Client-side decryption error! Details:", e);
          console.error("Passphrase used:", passphrase);
          console.error("Ciphertext preview:", encoded ? (encoded.substring(0, 60) + "...") : "none");
          console.error("Ciphertext length:", encoded ? encoded.length : 0);
          throw e;
        }
      }

      // Read configuration from server-injected config
      function getTxaApiConfig() {
        if (window.TXA_API_CONFIG) {
          return window.TXA_API_CONFIG;
        }
        return { encryptEnable: false, encryptPass: 'tphimx' };
      }

      // Monkey patch fetch
      (function() {
        if (window.__txa_fetch_patched) return;
        window.__txa_fetch_patched = true;
        const originalFetch = window.fetch;
        window.fetch = async function(...args) {
          const res = await originalFetch(...args);
          const isEncrypted = res.headers.get('X-TXA-Encrypted') === '1';
          if (isEncrypted) {
            try {
              const clone = res.clone();
              const json = await clone.json();
              const config = getTxaApiConfig();
              if (json && json.d && json.v === 1) {
                const passphrase = config.encryptPass || 'tphimx';
                const decryptedText = await clientTxaDecrypt(json.d, passphrase);
                const decryptedJson = JSON.parse(decryptedText);
                return new Response(JSON.stringify(decryptedJson), {
                  status: res.status,
                  statusText: res.statusText,
                  headers: new Headers({
                    ...Object.fromEntries(res.headers.entries()),
                    'Content-Type': 'application/json',
                    'X-TXA-Encrypted': '0'
                  })
                });
              }
            } catch (e) {
              console.error("Client-side fetch automatic decryption failed! Details:", e);
              console.error("Endpoint:", args[0]);
            }
          }
          return res;
        };
      })();

      function applyTheme() {
        document.documentElement.classList.add('dark');
        window.localStorage.setItem('theme', 'dark');
      }
      function hydrateSettings() {
        // All settings are now rendered server-side using Supabase. No client-side hydration from localStorage is needed.
      }
      applyTheme();
      hydrateSettings();

      // Click pop-under ad handler
      (function() {
        if (window.txa_click_ad_registered) return;
        window.txa_click_ad_registered = true;
        let clickCount = 0;
        let randomThreshold = 0;

        function getAdSettings() {
          const settings = window.TXA_SITE_SETTINGS || {};
          return settings.ads || { click_ad_enable: false, click_ad_code: '', click_ad_threshold: 5 };
        }

        function initRandomThreshold(threshold) {
          const base = parseInt(threshold) || 5;
          const min = Math.max(1, base - 2);
          const max = base + 2;
          randomThreshold = Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function checkUserBypassAds() {
          const user = window.APP_USER;
          if (!user) return false;
          try {
            const userPackage = user.package || 'Free';
            const siteSettings = window.TXA_SITE_SETTINGS || {};
            const packages = siteSettings.packages || [];
            const userPkg = packages.find(p => p.title === userPackage || p.id === userPackage || p.id === (userPackage.toLowerCase()));
            if (userPkg && userPkg.permissions) {
              if (userPkg.permissions.bypass_ads || userPkg.permissions.ads_only_in_player) {
                return true;
              }
            }
          } catch(e) {}
          return false;
        }

        document.addEventListener('click', function(e) {
          const ads = getAdSettings();
          if (!ads.click_ad_enable || !ads.click_ad_code) return;
          if (checkUserBypassAds()) return;

          if (!randomThreshold) {
            initRandomThreshold(ads.click_ad_threshold);
          }

          clickCount++;
          if (clickCount >= randomThreshold) {
            clickCount = 0;
            initRandomThreshold(ads.click_ad_threshold);
            try {
              const urls = ads.click_ad_code.split(/[\n,]+/).map(u => u.trim()).filter(Boolean);
              if (urls.length > 0) {
                const url = urls[Math.floor(Math.random() * urls.length)];
                const newWin = window.open(url, '_blank');
                if (newWin) {
                  newWin.blur();
                  window.focus();
                }
              }
            } catch(err) {
              console.error("Popup blocked or failed:", err);
            }
          }
        });
      })();

      function checkMobileApp() {
        if (window.innerWidth <= 540) {
          document.body.classList.add('mobile-app-active');
        } else {
          document.body.classList.remove('mobile-app-active');
        }
      }
      window.addEventListener('resize', checkMobileApp);

      function syncTlogged() {
        if (window.APP_USER) {
          localStorage.setItem('tlogged_in_as', window.APP_USER.username);
        } else {
          localStorage.removeItem('tlogged_in_as');
        }
      }

      function getLocalHistoryDict() {
        try {
          const stored = window.localStorage.getItem('thistory');
          if (!stored) return {};
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed)) {
            const dict = {};
            parsed.forEach(item => {
              if (item && item.slug) {
                const epKey = item.episodeSlug || 'default';
                dict[item.slug] = {
                  title: item.title || '',
                  posterUrl: item.posterUrl || '',
                  updatedAt: item.updatedAt || new Date().toISOString(),
                  episodes: {
                    [epKey]: {
                      episodeSlug: item.episodeSlug || '',
                      episodeName: item.episodeName || '',
                      currentTime: item.currentTime || 0,
                      duration: item.duration || 0,
                      serverIndex: item.serverIndex !== undefined ? item.serverIndex : 0,
                      updatedAt: item.updatedAt || new Date().toISOString(),
                      synced: item.synced || false
                    }
                  }
                };
              }
            });
            return dict;
          }
          return parsed && typeof parsed === 'object' ? parsed : {};
        } catch (e) {
          return {};
        }
      }

      function saveLocalHistoryDict(dict) {
        try {
          window.localStorage.setItem('thistory', JSON.stringify(dict));
        } catch (e) {}
      }

      async function syncAndRewriteWatchLinks() {
        try {
          const user = window.APP_USER;
          let localDict = getLocalHistoryDict();

          // 1. Nếu đã đăng nhập, fetch và gộp lịch sử từ DB
          if (user && user.username) {
            const username = user.username;
            try {
              const res = await fetch(`/api/user/history?username=${encodeURIComponent(username)}`);
              if (res.ok) {
                const dbHistoryList = await res.json();
                if (Array.isArray(dbHistoryList)) {
                  dbHistoryList.forEach(item => {
                    if (item && item.slug && item.episodeSlug) {
                      const localMovie = localDict[item.slug];
                      const localEp = localMovie?.episodes?.[item.episodeSlug];

                      const dbTime = item.updatedAt ? new Date(item.updatedAt).getTime() : 0;
                      const localTime = localEp?.updatedAt ? new Date(localEp.updatedAt).getTime() : 0;

                      if (localEp && !localEp.synced && localTime > dbTime) {
                        // Local mới hơn và chưa được sync lên DB, giữ nguyên để sync lên ở bước sau
                      } else {
                        // DB mới hơn hoặc bằng, cập nhật đè vào local
                        if (!localDict[item.slug]) {
                          localDict[item.slug] = {
                            title: item.title || '',
                            posterUrl: item.posterUrl || '',
                            updatedAt: item.updatedAt || new Date().toISOString(),
                            episodes: {}
                          };
                        }
                        localDict[item.slug].episodes[item.episodeSlug] = {
                          episodeSlug: item.episodeSlug,
                          episodeName: item.episodeName || '',
                          currentTime: item.currentTime || 0,
                          duration: item.duration || 0,
                          serverIndex: item.serverIndex !== undefined ? item.serverIndex : 0,
                          updatedAt: item.updatedAt || new Date().toISOString(),
                          synced: true
                        };

                        const epTime = new Date(item.updatedAt || '').getTime();
                        const parentTime = new Date(localDict[item.slug].updatedAt || '').getTime();
                        if (epTime > parentTime) {
                          localDict[item.slug].updatedAt = item.updatedAt;
                        }
                      }
                    }
                  });
                  saveLocalHistoryDict(localDict);
                }
              }
            } catch (e) {
              console.warn('Failed to fetch online watch history:', e);
            }

            // 2. Sync ngược lại từ local lên DB cho các tập offline chưa được đồng bộ
            if (typeof navigator !== 'undefined' && navigator.onLine) {
              let dbUpdated = false;
              for (const slug of Object.keys(localDict)) {
                const movie = localDict[slug];
                if (!movie || !movie.episodes) continue;
                for (const epKey of Object.keys(movie.episodes)) {
                  const ep = movie.episodes[epKey];
                  if (ep && !ep.synced) {
                    try {
                      const res = await fetch('/api/user/history', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                          username,
                          slug,
                          episodeSlug: ep.episodeSlug,
                          episodeName: ep.episodeName,
                          currentTime: ep.currentTime,
                          duration: ep.duration,
                          serverIndex: ep.serverIndex,
                          serverName: ep.serverName || 'Server VIP',
                          updatedAt: ep.updatedAt
                        })
                      });
                      if (res.ok) {
                        ep.synced = true;
                        dbUpdated = true;
                      }
                    } catch (e) {
                      console.warn(`Failed to sync ep ${epKey} for slug ${slug}:`, e);
                    }
                  }
                }
              }
              if (dbUpdated) {
                saveLocalHistoryDict(localDict);
              }
            }
          }

          // 3. Viết lại các link xem phim (/xem/)
          const anchors = document.querySelectorAll('a');
          anchors.forEach(a => {
            const href = a.getAttribute('href') || '';
            const xemMatch = href.match(/^\/xem\/([^/?#]+)/);
            if (xemMatch) {
              const slug = xemMatch[1];
              const movieObj = localDict[slug];
              if (movieObj && movieObj.episodes) {
                let latestEp = null;
                let maxTime = 0;
                Object.keys(movieObj.episodes).forEach(epKey => {
                  const ep = movieObj.episodes[epKey];
                  if (ep) {
                    const t = ep.updatedAt ? new Date(ep.updatedAt).getTime() : 0;
                    if (t >= maxTime) {
                      maxTime = t;
                      latestEp = ep;
                    }
                  }
                });

                if (latestEp) {
                  const epSlug = latestEp.episodeSlug || '';
                  const svIdx = latestEp.serverIndex !== undefined ? latestEp.serverIndex : 0;
                  const ts = Math.floor(latestEp.currentTime || 0);

                  if (epSlug) {
                    a.setAttribute('href', `/xem/${slug}?ep=${epSlug}&sv=${svIdx}&ts=${ts}`);
                    if (a.textContent && a.textContent.trim().toLowerCase() === 'xem ngay') {
                      const epName = latestEp.episodeName || '';
                      a.innerHTML = `<span class="material-symbols-outlined text-lg">play_arrow</span> Xem tiếp ${epName ? epName : ''}`;
                    }
                  }
                }
              }
            }
          });
        } catch (err) {
          console.error("Error in syncAndRewriteWatchLinks:", err);
        }
      }

      document.addEventListener('astro:after-swap', () => {
        applyTheme();
        hydrateSettings();
        checkMobileApp();
        syncTlogged();
        if (typeof updateAuthState === 'function') updateAuthState();
        syncAndRewriteWatchLinks();
      });
      document.addEventListener('astro:page-load', () => {
        applyTheme();
        hydrateSettings();
        checkMobileApp();
        syncTlogged();
        if (typeof updateAuthState === 'function') updateAuthState();
        syncAndRewriteWatchLinks();
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="keywords" content={settings.general.site_keywords} />
    <meta name="viewport" content="width=device-width" />
    {settings.general.meta_robots && <meta name="robots" content={settings.general.meta_robots} />}
    {settings.general.google_verification && <meta name="google-site-verification" content={settings.general.google_verification} />}
    {settings.general.bing_verification && <meta name="msvalidate.01" content={settings.general.bing_verification} />}
    
    <!-- Favicon Links for Browsers and Search Engines (Bing/Google) -->
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icon-512x512.png" />
    
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#7c3aed" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />

    <!-- Structured Schema.org / JSON-LD Data for Logo & Site Association -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": settings.general.schema_business_name || settings.general.site_name,
      "url": settings.general.site_url,
      "logo": new URL(settings.general.schema_logo_url || '/favicon.png', settings.general.site_url).href,
      "description": description,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${settings.general.site_url}/tim-kiem?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
