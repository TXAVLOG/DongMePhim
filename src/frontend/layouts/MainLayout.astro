      function initOtpInputs() {
        const container = document.getElementById('otp-digits-container');
        if (!container) return;

        const inputs = container.querySelectorAll('.otp-digit-input');
        const hiddenInput = document.getElementById('verify-otp-code');
        if (inputs.length !== 6 || !hiddenInput) return;

        // Function to update hidden input value
        function updateHiddenValue() {
          const code = Array.from(inputs).map(input => input.value).join('');
          hiddenInput.value = code;
          
          // Trigger validation or check validity of form if needed
          const submitBtn = document.getElementById('verify-submit');
          if (submitBtn) {
            if (code.length === 6) {
              submitBtn.disabled = false;
              submitBtn.classList.remove('opacity-55', 'cursor-not-allowed');
              submitBtn.classList.add('hover:brightness-110', 'active:scale-95');
            } else {
              submitBtn.disabled = true;
              submitBtn.classList.add('opacity-55', 'cursor-not-allowed');
              submitBtn.classList.remove('hover:brightness-110', 'active:scale-95');
            }
          }
        }

        inputs.forEach((input, index) => {
          // 1. Input event: auto-advance
          input.addEventListener('input', (e) => {
            const val = input.value;
            // Clean value: keep only digits
            const cleaned = val.replace(/[^0-9]/g, '');
            input.value = cleaned;

            if (cleaned.length > 0) {
              // If we entered a character, focus next input
              if (index < 5) {
                inputs[index + 1].focus();
                inputs[index + 1].select();
              }
            }
            updateHiddenValue();
          });

          // 2. Keydown event: backspace, arrows
          input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace') {
              if (input.value === '') {
                // If current input is empty, focus previous and clear it
                if (index > 0) {
                  inputs[index - 1].focus();
                  inputs[index - 1].value = '';
                  updateHiddenValue();
                }
              } else {
                input.value = '';
                updateHiddenValue();
              }
              e.preventDefault();
            } else if (e.key === 'ArrowLeft') {
              if (index > 0) {
                inputs[index - 1].focus();
                inputs[index - 1].select();
                e.preventDefault();
              }
            } else if (e.key === 'ArrowRight') {
              if (index < 5) {
                inputs[index + 1].focus();
                inputs[index + 1].select();
                e.preventDefault();
              }
            }
          });

          // 3. Paste event: handle full OTP copy-paste
          input.addEventListener('paste', (e) => {
            e.preventDefault();
            const pastedData = (e.clipboardData || window.clipboardData).getData('text');
            const digits = pastedData.replace(/[^0-9]/g, '').substring(0, 6);
            
            for (let i = 0; i < digits.length; i++) {
              if (inputs[i]) {
                inputs[i].value = digits[i];
              }
            }
            // Focus the last filled input or the 6th input
            const focusIndex = Math.min(digits.length, 5);
            if (inputs[focusIndex]) {
              inputs[focusIndex].focus();
            }
            updateHiddenValue();
          });

          // 4. Focus event: auto-select text
          input.addEventListener('focus', () => {
            input.select();
          });
        });

        // Initialize state (clear inputs on start)
        inputs.forEach(input => input.value = '');
        hiddenInput.value = '';
        const submitBtn = document.getElementById('verify-submit');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-55', 'cursor-not-allowed');
          submitBtn.classList.remove('hover:brightness-110', 'active:scale-95');
        }
      }
      window.initOtpInputs = initOtpInputs;

      // Expose globally and call initially
      window.initAuthFormListeners = initAuthFormListeners;
      initAuthFormListeners();
      
      // Auto call on page load if active verification tab is open
      document.addEventListener('astro:page-load', () => {
        const verifyTab = document.getElementById('auth-tab-verify-email');
        if (verifyTab && !verifyTab.classList.contains('hidden')) {
          initOtpInputs();
        }
      });
