            const res = await fetch('/api/auth/zalo-request', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                token: browserToken,
                nickname: nickname,
                email: userEmail,
                bypassKey: bypassKey,
                clientIp: clientIp
              })
            });
            const data = await res.json();
            if (res.ok) {
              if (data.data && data.data.isAutoApproved) {
