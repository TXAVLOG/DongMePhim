        function getUserPackageFromStorage() {
          try {
            const user = window.APP_USER;
            if (!user) return 'Free';
            return user.package || 'Free';
          } catch (e) {
            return 'Free';
          }
        }

        async function checkAdBlock() {
          let detected = false;

          // 1) Decoy DOM element method
          try {
            const decoy = document.createElement('div');
            decoy.className = 'pub_300x250 pub_300x250m pub_728x90 text-ad textAd text_ad text_ads text-ads text-ad-links ad-text adSense adBlock adContent adContainer';
            decoy.setAttribute('aria-hidden', 'true');
            decoy.style.cssText = 'position:absolute;top:-9999px;left:-9999px;width:1px;height:1px;';
            document.body.appendChild(decoy);
            await new Promise(r => setTimeout(r, 80));
            if (!decoy.offsetHeight || decoy.offsetHeight === 0 || 
                window.getComputedStyle(decoy).display === 'none' || 
                window.getComputedStyle(decoy).visibility === 'hidden') {
              detected = true;
            }
            document.body.removeChild(decoy);
          } catch (e) {}

          // 2) Fetch trap to a well-known ad-network endpoint
          if (!detected) {
            try {
              await fetch('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js', {
                method: 'HEAD',
                mode: 'no-cors',
                cache: 'no-store'
              });
            } catch (e) {
              detected = true;
            }
          }

          return detected;
        }

        function showAdBlockModal() {
          // Use txamodal if available, else fallback to basic overlay
          const show = () => {
            if (window.txamodal) {
              window.txamodal.show({
                title: '🚫 Phát hiện chặn Quảng cáo',
                content: `
                  <div class="flex flex-col items-center text-center gap-4 py-2">
                    <div class="w-16 h-16 rounded-full bg-amber-500/20 border border-amber-500/30 flex items-center justify-center mx-auto">
                      <span class="material-symbols-outlined text-3xl text-amber-400">block</span>
                    </div>
                    <p class="text-sm text-zinc-300 leading-relaxed max-w-sm">
                      Xin chào! Hệ thống phát hiện bạn đang sử dụng phần mềm <strong class="text-white">chặn quảng cáo (AdBlock)</strong>.
                      Để duy trì hệ thống máy chủ tốc độ cao và cập nhật phim liên tục hoàn toàn <strong class="text-white">miễn phí</strong>, chúng tôi rất cần sự ủng hộ từ doanh thu quảng cáo.
                    </p>
                    <p class="text-xs text-zinc-500 leading-relaxed max-w-sm mt-1">
                      Mong bạn thông cảm tắt AdBlock hoặc thêm trang web vào danh sách ngoại lệ. Nếu không muốn xem quảng cáo, bạn có thể tham khảo <a href="/nang-cap" class="text-primary underline font-bold">nâng cấp gói VIP</a> nhé!
                    </p>
                  </div>
                `,
                type: 'warning',
                confirmText: 'Tôi đã tắt AdBlock',
                cancelText: 'Đóng',
                onConfirm: async () => {
                  const stillBlocking = await checkAdBlock();
                  if (stillBlocking) {
                    if (window.showGlobalToast) window.showGlobalToast('Vẫn phát hiện AdBlock. Vui lòng tắt và tải lại trang!', 'error');
                  } else {
                    window.TXA_ADBLOCK_DETECTED = false;
                    if (window.showGlobalToast) window.showGlobalToast('Cảm ơn bạn! Hãy tải lại trang để tiếp tục xem phim.', 'success');
                  }
                }
              });
            }
          };

          // Delay slightly to ensure modal system is ready
          if (window.txamodal) {
            show();
          } else {
            setTimeout(show, 1200);
          }
        }

        async function runAdBlockCheck() {
          const settings = window.TXA_SITE_SETTINGS || {};
          const hasAds = settings.ads?.pre_roll_enable || settings.ads?.banner_enable || settings.ads?.click_ad_enable;
          if (!hasAds) return; // No ads configured, no point checking

          const pkgName = getUserPackageFromStorage();
          const packages = settings.packages || [];
          const userPkg = packages.find(p => p.title === pkgName);
          const isFree = !userPkg || !userPkg.permissions?.bypass_ads;
          
          // If user has bypass_ads permission, clear any existing warning
          if (!isFree) {
            sessionStorage.removeItem('txa_adblock_warned');
            window.TXA_ADBLOCK_DETECTED = false;
            return; // Paid user, skip check
          }

          const detected = await checkAdBlock();
          window.TXA_ADBLOCK_DETECTED = detected;

          // If AdBlock is not detected anymore, clear the warning
          if (!detected) {
            sessionStorage.removeItem('txa_adblock_warned');
            return;
          }

          if (detected) {
            // Save in sessionStorage to limit to once per tab
            const alreadyShown = sessionStorage.getItem('txa_adblock_warned');
            if (!alreadyShown) {
              sessionStorage.setItem('txa_adblock_warned', '1');
              showAdBlockModal();
            }
          }
        }

        // Service Worker registration
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js')
              .then((reg) => console.log('[SW] Registered successfully with scope:', reg.scope))
              .catch((err) => console.error('[SW] Registration failed:', err));
          });
        }

        // Offline / Online handler
        let originalTitle = document.title;
        let titleBlinkInterval = null;
        let isCurrentlyOffline = !navigator.onLine;

        function startTitleBlink() {
          if (titleBlinkInterval) clearInterval(titleBlinkInterval);
          let showDot = true;
          originalTitle = document.title.replace(/^🔴\s*/, '');
          titleBlinkInterval = setInterval(() => {
            if (showDot) {
              document.title = '🔴 ' + originalTitle;
            } else {
              document.title = originalTitle;
            }
            showDot = !showDot;
          }, 1000);
        }

        function stopTitleBlink() {
          if (titleBlinkInterval) {
            clearInterval(titleBlinkInterval);
            titleBlinkInterval = null;
          }
          document.title = document.title.replace(/^🔴\s*/, '');
        }

        function updateNetworkStatus() {
          if (!navigator.onLine) {
            if (!isCurrentlyOffline) {
              isCurrentlyOffline = true;
              if (window.showToast) {
                window.showToast('Bạn đã mất kết nối mạng. Một số tính năng có thể không khả dụng.', 'error');
              }
              startTitleBlink();
            }
          } else {
            if (isCurrentlyOffline) {
              isCurrentlyOffline = false;
              if (window.showToast) {
                window.showToast('Đã khôi phục kết nối Internet!', 'success');
              }
              stopTitleBlink();
            }
          }
        }

        window.addEventListener('offline', updateNetworkStatus);
        window.addEventListener('online', updateNetworkStatus);

        // Run on page load
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          runAdBlockCheck();
          if (!navigator.onLine) startTitleBlink();
        } else {
          document.addEventListener('DOMContentLoaded', () => {
            runAdBlockCheck();
            if (!navigator.onLine) startTitleBlink();
          }, { once: true });
        }

        // Re-run on Astro page transitions
        document.addEventListener('astro:page-load', () => {
          // Keep sessionStorage to persist warning across page transitions
          // Only re-check AdBlock state but don't remove warning
          runAdBlockCheck();
          if (!navigator.onLine) {
            startTitleBlink();
          } else {
            stopTitleBlink();
          }
        });
      })();
    </script>
    <script is:inline>
      (function initFooterStats() {
        function getOrCreateSessionId() {
          let sid = sessionStorage.getItem('txa_sid');
          let isNew = false;
          if (!sid) {
            sid = 's_' + Math.random().toString(36).substring(2, 11) + '_' + Date.now();
            sessionStorage.setItem('txa_sid', sid);
            isNew = true;
          }
          return { sid, isNew };
        }

        function txaFormatNumber(num) {
          if (num === null || num === undefined || isNaN(num)) return '0';
          const n = Number(num);
          if (n >= 1000000000) {
            return (n / 1000000000).toFixed(1).replace(/\.0$/, '') + 'B';
          }
          if (n >= 1000000) {
            return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
          }
          if (n >= 10000) {
            return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
          }
          return n.toLocaleString('vi-VN');
        }

        async function pingStats(isInitial) {
          try {
            const { sid, isNew } = getOrCreateSessionId();
            const queryNew = (isInitial && isNew) ? '&new=1' : '';
            const res = await fetch('/api/stats/online?sid=' + encodeURIComponent(sid) + queryNew);
            if (res.ok) {
              const json = await res.json();
              if (json && json.status === 'success' && json.data) {
                const todayEl = document.getElementById('footer-today-visits');
                const totalEl = document.getElementById('footer-total-visits');
                const onlineEl = document.getElementById('footer-online-users');

                if (todayEl) {
                  todayEl.textContent = txaFormatNumber(json.data.todayVisits);
                  todayEl.title = (json.data.todayVisits || 0).toLocaleString('vi-VN');
                }
                if (totalEl) {
                  totalEl.textContent = txaFormatNumber(json.data.totalVisits);
                  totalEl.title = (json.data.totalVisits || 0).toLocaleString('vi-VN');
                }
                if (onlineEl) {
                  onlineEl.textContent = txaFormatNumber(json.data.onlineUsers);
                  onlineEl.title = (json.data.onlineUsers || 0).toLocaleString('vi-VN');
                }
              }
            }
          } catch (e) {
            console.warn('Lỗi đồng bộ stats footer:', e);
          }
        }

        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          pingStats(true);
        } else {
          document.addEventListener('DOMContentLoaded', function() { pingStats(true); });
        }

        setInterval(function() {
          pingStats(false);
        }, 10000);

        document.addEventListener('astro:page-load', function() {
          pingStats(false);
        });
      })();
    </script>
  </body>
</html>

