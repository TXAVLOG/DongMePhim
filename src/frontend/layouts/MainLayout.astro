                updateZaloUI('approved');
                setTimeout(() => {
                  document.documentElement.classList.remove('gate-zalo');
                  document.documentElement.classList.add('gate-passed');
                  if (window.location.pathname !== '/tphim') {
                    window.location.href = '/tphim';
