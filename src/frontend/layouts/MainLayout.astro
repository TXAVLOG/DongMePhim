    <script is:inline>
      (function() {
        function updateZaloModalBypassPrice() {
          const btn = document.getElementById('btn-buy-bypass-modal');
          if (!btn) return;
          try {
            const stored = localStorage.getItem('thistory');
            let count = 0;
            if (stored) {
              const parsed = JSON.parse(stored);
              if (Array.isArray(parsed)) count = parsed.length;
              else if (typeof parsed === 'object' && parsed !== null) count = Object.keys(parsed).length;
            }
            if (count > 0) {
              const basePrice = 49000;
              const discount = Math.min(basePrice - 10000, count * 3000);
              const dynamicPrice = Math.max(10000, basePrice - discount);
              btn.textContent = `Mua Key Bypass ngay (${dynamicPrice.toLocaleString('vi-VN')}đ)`;
              const badge = document.getElementById('zalo-recommendation-badge');
              if (badge) badge.textContent = `Ưu đãi xem ${count} phim`;
            }
          } catch(e) {}
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', updateZaloModalBypassPrice);
        } else {
          updateZaloModalBypassPrice();
        }
      })();
    </script>

