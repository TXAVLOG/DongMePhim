                                <a href="/goi-dich-vu" class="px-4 py-3 text-sm text-primary hover:bg-white/5 transition-colors border-b border-glass-stroke flex items-center gap-2 font-bold"><span class="material-symbols-outlined text-[18px]">card_membership</span> Gói dịch vụ</a>
                                <a href="/lich-su-xem" class="px-4 py-3 text-sm text-on-surface hover:bg-white/5 transition-colors border-b border-glass-stroke flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">history</span> Lịch sử xem</a>
