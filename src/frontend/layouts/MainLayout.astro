      .social-facebook-group:hover {
        background-color: rgba(24, 119, 242, 0.15) !important;
        color: #1877F2 !important;
        border-color: rgba(24, 119, 242, 0.4) !important;
      }
      
      .social-telegram:hover {
        background-color: rgba(38, 165, 228, 0.15) !important;
        color: #26A5E4 !important;
        border-color: rgba(38, 165, 228, 0.4) !important;
      }
      
