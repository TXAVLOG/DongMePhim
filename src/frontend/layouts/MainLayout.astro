              navBtn.className = 'px-5 py-2.5 bg-rose-600 text-white rounded-full text-[10px] font-black uppercase tracking-widest hover:shadow-[0_0_20px_rgba(244,63,94,0.4)] transition-all cursor-pointer border-none';
              navBtn.disabled = false;
            }
            if (mainBtn) {
              mainBtn.innerHTML = '<i class="fas fa-check-circle text-lg animate-pulse"></i> <span>Đã duyệt! Vào xem ngay</span>';
              mainBtn.className = 'w-full sm:w-auto px-8 py-4.5 bg-rose-600 hover:bg-rose-700 text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-[0_0_30px_rgba(244,63,94,0.35)] hover:shadow-[0_0_40px_rgba(244,63,94,0.55)] hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer border-none';
              mainBtn.disabled = false;
            }
          } else {
            if (navBtn) {
              navBtn.textContent = 'Xác thực';
              navBtn.className = 'px-5 py-2.5 bg-gradient-to-r from-purple-600 to-pink-600 rounded-full text-[10px] font-black uppercase tracking-widest hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all cursor-pointer border-none';
              navBtn.disabled = false;
            }
            if (mainBtn) {
              mainBtn.innerHTML = '<i class="fas fa-shield-halved text-lg"></i> <span>Khám phá ngay</span>';
              mainBtn.className = 'w-full sm:w-auto px-8 py-4.5 bg-gradient-to-r from-purple-600 via-purple-600 to-indigo-600 text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-[0_0_30px_rgba(124,58,237,0.25)] hover:shadow-[0_0_40px_rgba(124,58,237,0.45)] hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer border-none';
              mainBtn.disabled = false;
            }
          }
        }

        // Kiểm tra trạng thái khi tải trang
        async function checkZaloStatusOnLoad() {
          if (zaloLockEnable === false) return;
          const status = localStorage.getItem('zalo_access_status');
          
          if (status === 'approved') {
            document.documentElement.classList.add('gate-passed');
            return;
          }

          updateZaloUI(status);

          if (status === 'pending') {
            startZaloPolling();
          }

          // Gọi API đồng bộ trạng thái thực tế từ server
          try {
            const userEmail = (window.APP_USER ? window.APP_USER.username : null) || null;
            const res = await fetch('/api/auth/zalo-status', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                token: browserToken,
                email: userEmail
              })
            });
            const data = await res.json();
            if (res.ok) {
              const currentStatus = data.data ? data.data.status : data.status;
              if (currentStatus) {
                localStorage.setItem('zalo_access_status', currentStatus);
                updateZaloUI(currentStatus);

                if (currentStatus === 'approved') {
                  if (pollingInterval) clearInterval(pollingInterval);
                  document.cookie = "txa_gate_passed=true; path=/; max-age=604800";
                  if (window.showToast) {
                    window.showToast('Yêu cầu truy cập Zalo của bạn đã được phê duyệt thành công!', 'success');
                  }
                  setTimeout(() => {
                    document.documentElement.classList.remove('gate-zalo');
                    document.documentElement.classList.add('gate-passed');
                    if (window.location.pathname !== '/tphim') {
                      window.location.href = '/tphim';
                    }
                  }, 1500);
                } else if (currentStatus === 'pending') {
                  startZaloPolling();
                } else {
                  if (pollingInterval) clearInterval(pollingInterval);
                }
              }
            }
          } catch(e) {}
        }

        // Lắng nghe sự kiện để check status khi load
        initBrowserToken();

        // Logo click bypass ở cổng Zalo
        window.handleZaloLogoClick = function() {
          handleDecoyLogoClick();
        };

      })();
    </script>

