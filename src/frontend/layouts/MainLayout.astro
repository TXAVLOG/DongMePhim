                  encrypted += String.fromCharCode(encryptedChar);
                }
                const b64 = btoa(encrypted);
                return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
              } catch (e) {
                console.error("Loi ma hoa:", e);
                return null;
              }
            }
          };

          try {
            let data = {};
            try {
              // Try fetching from ipinfo.io first (provides richer geo/ISP data)
              const res = await fetch('https://ipinfo.io/json');
              if (res.ok) {
                data = await res.json();
                if (data.ip) localStorage.setItem('txa_client_ip', data.ip);
              } else {
                throw new Error('ipinfo.io failed');
              }
            } catch (e) {
              // Fallback to local API
              const res = await fetch('/api/auth/ip');
              if (res.ok) {
                data = await res.json();
                if (data.ip) localStorage.setItem('txa_client_ip', data.ip);
              }
            }

            const ip = data.ip || 'Unknown IP';
            const city = data.city || '';
            const region = data.region || '';
            const country = data.country || '';
            const loc = data.loc || '';
            const org = data.org || '';
            const timezone = data.timezone || '';
            const screenInfo = `${window.screen.width}x${window.screen.height}`;
            const lang = navigator.language || '';

            // Construct detailed token payload:
            // userAgent [Screen: screenInfo | Lang: lang] - IP: ip | City: city | Region: region | Country: country | Loc: loc | Org: org | Timezone: timezone
            const rawInfo = `${userAgent} [Screen: ${screenInfo} | Lang: ${lang}] - IP: ${ip} | City: ${city} | Region: ${region} | Country: ${country} | Loc: ${loc} | Org: ${org} | Timezone: ${timezone}`;

            const encryptedToken = TxaCipher.encrypt(rawInfo, CRYPTO_KEY);
            if (encryptedToken) {
              return `tk_${encryptedToken}`;
            }
            const hash = md5(rawInfo);
            return `tk_${hash}`;
          } catch (err) {
            console.error('IP fetch failed, local fallback...', err);
            const screenInfo = `${window.screen.width}x${window.screen.height}`;
            const lang = navigator.language || '';
            const rawInfo = `${userAgent} [Screen: ${screenInfo} | Lang: ${lang}] - Local Fallback`;
            const encryptedToken = TxaCipher.encrypt(rawInfo, CRYPTO_KEY);
            if (encryptedToken) {
              return `tk_${encryptedToken}`;
            }
            const uaHash = md5(userAgent);
            const rand = Math.random().toString(36).substring(2, 10);
            return `txanot-noip-${uaHash}-${rand}`;
          }
        }

        let browserToken = localStorage.getItem('zalo_browser_token') || '';

        async function initBrowserToken() {
          if (!browserToken) {
