      <script is:inline>
        (function() {
          const adjustLayout = () => {
            const isMobile = window.innerWidth < 768;
            if (isMobile) {
              document.body.style.paddingTop = '0px';
              document.body.style.paddingBottom = '36px';
              const mobNav = document.getElementById('mobile-top-nav');
              if (mobNav) mobNav.style.top = '0px';
            } else {
              document.body.style.paddingTop = '32px';
              document.body.style.paddingBottom = '0px';
              const mainNav = document.getElementById('main-nav');
              if (mainNav) mainNav.style.top = '32px';
            }
          };
          
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', adjustLayout);
          } else {
            adjustLayout();
          }
          window.addEventListener('resize', adjustLayout);
          document.addEventListener('astro:page-load', adjustLayout);

          document.addEventListener('click', async (e) => {
            const btn = e.target.closest('#revert-admin-btn');
            if (btn) {
              const originalText = btn.textContent;
              try {
                btn.textContent = 'Đang quay lại...';
                btn.disabled = true;
                const res = await fetch('/api/admin/deimpersonate', { method: 'POST' });
                if (res.ok) {
                  window.location.href = '/admin/thanh-vien';
                } else {
                  alert('Lỗi khi khôi phục quyền Admin!');
                  btn.textContent = originalText;
                  btn.disabled = false;
                }
              } catch (err) {
                console.error(err);
                alert('Lỗi kết nối mạng!');
                btn.textContent = originalText;
                btn.disabled = false;
              }
            }
          });
        })();
